/**
 * 环境配置 - 开发/生产环境分离
 *
 * 切换环境：将 ENV_MODE 改为 'development' 或 'production'
 * 说明：uni-app x 在 HBuilderX 中编译，不支持 process.env.NODE_ENV，
 *      需在打包发布前手动切换 ENV_MODE
 *
 * - 接口路径统一前缀 /api，响应格式 { code, message, data }
 * - H5 端使用完整 URL，依赖后端 CORS
 * - App / 小程序端使用完整地址
 */

/** 当前环境：'development' | 'production' */
export const ENV_MODE = 'development'

/** 是否开发环境 */
export const IS_DEV : boolean = ENV_MODE == 'development'

/**
 * 开发环境 API 基础 URL（本地/局域网调试）
 *
 * 域名口径见根仓库 `docs/adr/ADR-0077-域名与主体迁移的双域族.md` 决策 2「API 入口独立成
 * `api.<domain>`」：移动端、门户回源、残值 BFF 都打它。旧域族已于 2026-10-23 硬切退役
 * （A 记录不存在，#1802 实测 DNS 名称不存在），**别再改回去**。
 * 本文件由 `utils/aiDiagnosisSourcesContract.test.js` 的锚点用例断言「不含退役域字面量」，
 * 连注释都不许写回去。
 */
const DEV_API_BASE_URL = 'https://api.gdyidao.cn/api'
/** 生产环境 API 基础 URL（与开发环境同域：ADR-0077 后 API 入口不再按环境分域） */
const PROD_API_BASE_URL = 'https://api.gdyidao.cn/api'

/**
 * API 基础 URL
 * - App / 小程序端使用完整地址
 */
export const API_BASE_URL = IS_DEV ? DEV_API_BASE_URL : PROD_API_BASE_URL

/**
 * 请求超时时间（毫秒）
 * - 远程后端服务器在弱网/慢请求下需要足够缓冲，统一 15 秒
 * - mock 回退由各 API 的 .catch() 处理，不影响体验
 */
export const REQUEST_TIMEOUT = 15000

/**
 * AI 长任务请求超时时间（毫秒）
 *
 * 与服务端**同一口径**（#2298）：后端 `backend/internal/aiassistant/transport.go` 的
 * `aiStreamTimeout = 300 * time.Second` 是流式总时长闸门，客户端必须比它**长** ——
 * 否则服务端还没到自己的闸门、客户端先宣告超时，学员看到的是「超时」而不是服务端那句
 * 可行动的错误（旧值 120000 就是这种「另立一个更短的数」：实测长诊断 8~90 秒，留量本就不足）。
 *
 * 留 30 秒余量，让「服务端超时」这条错误先抵达并带文案。
 * ⚠️ 改后端 `aiStreamTimeout` 时**必须同步改这里**：两处是同一个数的两半，不是两个独立配置。
 *
 * 语义注记：uni-app x 在 App 端把它落到 OkHttp `readTimeout` / iOS `timeoutInterval`，
 * 约束的是**最长静默间隙**（响应头与每次 flush 都会续命），不是 300 秒总时长；
 * mp-weixin 侧文档未定义语义，只能真机确认 —— 见 `docs/design/20261106-移动端长请求超时上限调研.md`。
 */
export const AI_REQUEST_TIMEOUT = 330000

/**
 * 随问图片**单轮上限**（#2299）：与后端 `diagnosisMaxImages` **同值** —— 服务端只收前 3 张，
 * 客户端先拦并给可读提示，不把拒绝留给服务端（票面决策 12）。
 * ⚠️ 改这里必须同步改 `backend/internal/aiassistant/diagnosis_adapter.go`：
 * 跨栈守护 `utils/aiImageLimitParityContract.test.js` 逐字比对这个数与本常量。
 */
export const AI_MAX_IMAGES = 3

/** 是否开启详细日志（仅开发环境） */
export const ENABLE_DEBUG_LOG = IS_DEV