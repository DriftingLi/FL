{
  "name": "forklift-training-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:behavior",
    "test:unit": "jest --config jest.config.unit.js -i",
    "test:behavior": "jest --config jest.config.behavior.js -i",
    "test:unit:local": "jest --config jest.config.unit.js",
    "test:behavior:local": "jest --config jest.config.behavior.js",
    "test:unit:gate": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-finish.ps1 -UnitGate",
    "test:unit:gate:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-finish.ps1 -UnitLocal",
    "test:unit:changed": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-finish.ps1 -Changed",
    "hx:run": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/hx-run.ps1",
    "hx:compile-only": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/hx-run.ps1 -CompileOnly",
    "build:compile": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/compile-check.ps1",
    "build:kotlin-all": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/kotlin-all-check.ps1",
    "build:mp-weixin-check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/mp-weixin-check.ps1",
    "build:mp-weixin-doctor": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/mp-weixin-check.ps1 -Doctor",
    "build:mp-weixin-buildonly": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/mp-weixin-check.ps1 -BuildOnly",
    "probe:mp-weixin-element": "node scripts/mp-weixin-element-probe.mjs",
    "smoke:emulator": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/emulator-smoke.ps1",
    "capture:device": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/device-capture.ps1",
    "connect:device": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/wireless-debug.ps1",
    "setup:android-sdk": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/android-sdk-setup.ps1",
    "dev:finish": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-finish.ps1",
    "dev:finish:dry": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-finish.ps1 -DryRun",
    "dev:finish:distribute": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-finish.ps1 -Distribute",
    "style:loop": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/style-loop.ps1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2"
  }
}
