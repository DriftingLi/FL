<template>
    <view class="app-btn" :class="[
        'app-btn--' + type,
        'app-btn--' + size,
        { 'app-btn--disabled': disabled, 'app-btn--pressed': pressed }
    ]" @click="onClick"
        @touchstart="onPressStart" @touchend="onPressEnd" @touchcancel="onPressEnd">
        <text class="app-btn-text" :class="[
            'app-btn-text--' + type,
            'app-btn-text--' + size
        ]">{{ text }}</text>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'

    const props = withDefaults(defineProps<{
        text ?: string
        type ?: string
        size ?: string
        disabled ?: boolean
    }>(), {
        text: '',
        type: 'primary',
        size: 'large',
        disabled: false
    })

    const emit = defineEmits(['click'])

    function onClick() : void {
        if (!props.disabled) {
            emit('click')
        }
    }

    /* 按压态（#2863）：uvue 原生端不支持 `:active` 伪类（ui-spec §5.10），按压反馈由
     * @touchstart/@touchend 切 class（先例 pages/courses/course-detail.uvue 的 .action-btn-pressed）；
     * 只有 primary 档有按压视觉（§5.3 的 `$primary-grad-pressed-*` 对），故仅在 primary + 未禁用时点亮。 */
    const pressed = ref<boolean>(false)

    function onPressStart() : void {
        if (!props.disabled && props.type == 'primary') {
            pressed.value = true
        }
    }

    function onPressEnd() : void {
        pressed.value = false
    }
</script>

<style lang="scss">
    .app-btn {
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }

    /* Primary（#2509 R2 冲突 8：主 CTA 换血为 #6ECCFD→#0CA2EF 渐变，原型 65 处/16 屏）。
     * uvue 原生端只接受「to 关键字 + 恰好 2 个色值」，实色兜底必须写在 background 之后
     * （gradientSyntaxContract 口径，同 §6.1 模板）。 */
    .app-btn--primary {
        background: linear-gradient(to bottom, $primary-grad-start, $primary-grad-end);
        background-color: $primary-grad-end;
        border-radius: $radius-pill;
    }

    /* 主 CTA 按压态（ui-spec §5.3 的 pressed 对；#2863 接上，此前该对 0 引用）。
     * 原生端只吃「to 关键字 + 恰好 2 色」，实色兜底写在渐变之后（gradientSyntaxContract 口径）。 */
    .app-btn--primary.app-btn--pressed {
        background: linear-gradient(to bottom, $primary-grad-pressed-start, $primary-grad-pressed-end);
        background-color: $primary-grad-pressed-end;
    }

    /* Secondary（#2509 R2 冲突 9：透明底 → $primary-tint 浅蓝底 + 1px 主色边框） */
    .app-btn--secondary {
        background-color: $primary-tint;
        border-width: 1rpx;
        border-style: solid;
        border-color: $primary-color;
        border-radius: $radius-lg;
    }

    /* Danger */
    .app-btn--danger {
        background-color: transparent;
        border-radius: $radius-pill;
    }

    /* Ghost */
    .app-btn--ghost {
        background-color: transparent;
        border-radius: $radius-pill;
    }

    /* Size: large */
    .app-btn--large {
        height: 80rpx;
        padding: 0 $spacing-xl;
    }

    /* Size: medium */
    .app-btn--medium {
        height: 64rpx;
        padding: 0 32rpx;
    }

    /* Size: small */
    .app-btn--small {
        height: 48rpx;
        padding: 0 24rpx;
    }

    /* Disabled */
    .app-btn--disabled {
        opacity: 0.5;
    }

    /* Text: primary */
    .app-btn-text--primary {
        color: $text-color-inverse;
        font-weight: bold;
    }

    /* Text: secondary */
    .app-btn-text--secondary {
        color: $primary-color;
    }

    /* Text: danger */
    .app-btn-text--danger {
        color: $danger-color;
    }

    /* Text: ghost */
    .app-btn-text--ghost {
        color: $text-color-secondary;
    }

    /* Text size: large */
    .app-btn-text--large {
        font-size: $font-size-lg;
    }

    /* Text size: medium */
    .app-btn-text--medium {
        font-size: $font-size-md;
    }

    /* Text size: small */
    .app-btn-text--small {
        font-size: $font-size-sm;
    }
</style>
