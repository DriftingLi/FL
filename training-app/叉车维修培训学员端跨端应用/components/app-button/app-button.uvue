<template>
    <view class="app-btn" :class="[
        'app-btn--' + type,
        'app-btn--' + size,
        { 'app-btn--disabled': disabled }
    ]" @click="onClick">
        <text class="app-btn-text" :class="[
            'app-btn-text--' + type,
            'app-btn-text--' + size
        ]">{{ text }}</text>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        text ?: string
        type ?: string
        size ?: string
        disabled ?: boolean
    }>(), {
        text: '',
        type: 'primary',
        size: 'large',
        disabled: false
    })

    const emit = defineEmits(['click'])

    function onClick() : void {
        if (!props.disabled) {
            emit('click')
        }
    }
</script>

<style lang="scss">
    .app-btn {
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }

    /* Primary（#2509 R2 冲突 8：主 CTA 换血为 #6ECCFD→#0CA2EF 渐变，原型 65 处/16 屏）。
     * uvue 原生端只接受「to 关键字 + 恰好 2 个色值」，实色兜底必须写在 background 之后
     * （gradientSyntaxContract 口径，同 §6.1 模板）。 */
    .app-btn--primary {
        background: linear-gradient(to bottom, $primary-grad-start, $primary-grad-end);
        background-color: $primary-grad-end;
        border-radius: $radius-pill;
    }

    /* Secondary（#2509 R2 冲突 9：透明底 → $primary-tint 浅蓝底 + 1px 主色边框） */
    .app-btn--secondary {
        background-color: $primary-tint;
        border-width: 1rpx;
        border-style: solid;
        border-color: $primary-color;
        border-radius: $radius-lg;
    }

    /* Danger */
    .app-btn--danger {
        background-color: transparent;
        border-radius: $radius-pill;
    }

    /* Ghost */
    .app-btn--ghost {
        background-color: transparent;
        border-radius: $radius-pill;
    }

    /* Size: large */
    .app-btn--large {
        height: 80rpx;
        padding: 0 48rpx;
    }

    /* Size: medium */
    .app-btn--medium {
        height: 64rpx;
        padding: 0 32rpx;
    }

    /* Size: small */
    .app-btn--small {
        height: 48rpx;
        padding: 0 24rpx;
    }

    /* Disabled */
    .app-btn--disabled {
        opacity: 0.5;
    }

    /* Text: primary */
    .app-btn-text--primary {
        color: $text-color-inverse;
        font-weight: bold;
    }

    /* Text: secondary */
    .app-btn-text--secondary {
        color: $primary-color;
    }

    /* Text: danger */
    .app-btn-text--danger {
        color: $danger-color;
    }

    /* Text: ghost */
    .app-btn-text--ghost {
        color: $text-color-secondary;
    }

    /* Text size: large */
    .app-btn-text--large {
        font-size: $font-size-lg;
    }

    /* Text size: medium */
    .app-btn-text--medium {
        font-size: $font-size-md;
    }

    /* Text size: small */
    .app-btn-text--small {
        font-size: $font-size-sm;
    }
</style>
