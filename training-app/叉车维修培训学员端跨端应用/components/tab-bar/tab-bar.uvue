<template>
    <view class="tab-bar" :style="{ paddingBottom: safeAreaBottom + 'px' }">
        <view v-for="(item, idx) in tabs" :key="idx" class="tab-item" @click="onTabClick(item.path, idx)">
            <image class="tab-icon" :src="activeIndex == idx ? item.activeIcon : item.icon" mode="aspectFit" />
            <text :class="['tab-text', { active: activeIndex == idx }]">{{ item.text }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, watch } from 'vue'

    const props = withDefaults(defineProps<{
        activeIndex ?: number
    }>(), {
        activeIndex: 0
    })

    const activeIndex = ref<number>(props.activeIndex)
    const safeAreaBottom = ref<number>(0)

    // UTS 中 watch 第一个参数不支持箭头函数返回 number，需用 ref 直接监听
    watch(props, () => {
        if (props.activeIndex != activeIndex.value) {
            activeIndex.value = props.activeIndex
        }
    })

    const sysInfo = uni.getSystemInfoSync()
    const insets = sysInfo.safeAreaInsets
    if (insets != null) {
        const bottom = insets.bottom
        if (bottom != null && bottom > 0) {
            safeAreaBottom.value = bottom
        }
    }

    type TabItem = {
        key : string
        path : string
        icon : string
        activeIcon : string
        text : string
    }
    const tabs : TabItem[] = [
        { key: 'dashboard', path: '/pages/dashboard/dashboard', icon: '/static/tabbar/home.png', activeIcon: '/static/tabbar/home-active.png', text: '首页' },
        { key: 'courses', path: '/pages/courses/courses', icon: '/static/tabbar/course.png', activeIcon: '/static/tabbar/course-active.png', text: '课程' },
        { key: 'ai', path: '/pages/ai-assistant/ai-assistant', icon: '/static/tabbar/ai.png', activeIcon: '/static/tabbar/ai-active.png', text: 'AI学' },
        { key: 'forum', path: '/pages/forum/forum', icon: '/static/tabbar/forum.png', activeIcon: '/static/tabbar/forum-active.png', text: '交流' },
        { key: 'profile', path: '/pages/profile/profile', icon: '/static/tabbar/profile.png', activeIcon: '/static/tabbar/profile-active.png', text: '我的' },
    ]

    function onTabClick(path : string, idx : number) : void {
        // 点击当前已激活的 tab 时不重复跳转
        if (activeIndex.value == idx) return
        // 未开发页面提示
        if (path.length == 0) {
            uni.showToast({ title: '功能开发中，敬请期待', icon: 'none' })
            return
        }
        // 使用 reLaunch 防止页面栈堆积，保持 Tab 切换的单一页面栈
        uni.reLaunch({ url: path })
    }
</script>

<style>
    .tab-bar {
        flex-direction: row;
        background-color: #ffffff;
        border-top: 1rpx solid #f0f0f0;
        position: relative;
        z-index: 10;
    }

    .tab-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
        padding: 14rpx 0 8rpx;
    }

    .tab-icon {
        width: 44rpx;
        height: 44rpx;
        margin-bottom: 6rpx;
    }

    .tab-text {
        font-size: 20rpx;
        color: #999999;
    }

    .tab-text.active {
        color: #2979ff;
        font-weight: bold;
    }
</style>
