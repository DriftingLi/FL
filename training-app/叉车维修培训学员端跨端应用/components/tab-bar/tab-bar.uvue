<template>
    <view class="tab-bar" :style="{ paddingBottom: safeAreaBottom + 'px' }">
        <view v-for="(item, idx) in tabs" :key="idx" class="tab-item" @click="onTabClick(item.path, idx)">
            <image class="tab-icon" :src="activeIndex == idx ? item.activeIcon : item.icon" mode="aspectFit" />
            <text :class="['tab-text', { active: activeIndex == idx }]">{{ item.text }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, watch, onMounted } from 'vue'

    const props = withDefaults(defineProps<{
        activeIndex ?: number
    }>(), {
        activeIndex: 0
    })

    const activeIndex = ref<number>(props.activeIndex)
    const safeAreaBottom = ref<number>(0)

    // UTS 中 watch 第一个参数不支持箭头函数返回 number，需用 ref 直接监听
    watch(props, () => {
        if (props.activeIndex != activeIndex.value) {
            activeIndex.value = props.activeIndex
        }
    })

    // 底部安全区（手势区）内边距。
    // 原写法只在 setup 读一次 getSystemInfoSync().safeAreaInsets，且**取不到就整段静默跳过** ——
    // 真机实测：该值在首帧可能取不到，于是栏少补一截底部内边距、比原生栏矮（本机型差 43px，
    // 设备 dumpsys navigationBars inset = 48px）。原写法一声不响，属「静默失败」。
    // 现在三段兜底：① setup 读 → ② onMounted 再读（首帧可能未就绪）→ ③ 都没有则用常量。
    // 只用本项目已验证可用的 getSystemInfoSync()（getWindowInfo / screenHeight 本仓无先例，不冒险）。
    // 真机实测：本机型正确值 48px（dumpsys navigationBars bottom=48）。
    // **但首次实例化时该值返回 96（恰好 2×）** —— 实测同一入口路径下：首帧栏顶线 y=2212、
    // 切走再回来 y=2308，整条栏平移 96px，而两态「图标带→文字带」间距都是 35px（与原生栏一致）
    // ⇒ 内容没变，是内边距翻倍。切页后该值才回到 48，故**首次读到的值不可信**。
    // 处置：给该值设上限，超出上限即判为翻倍值并退回真值常量。不无条件采用读数。
    // onMounted 的二次读取保留（能救「首帧取不到」的情形），但挡不住「首帧翻倍」。
    // 定时重读被排除：本仓约定避免 setTimeout/setInterval。
    // **本段是过渡件** —— 手画栏整体在 #911（AI 页走原生路由）被删除，届时一并消失。
    // 该常量身兼两职：① 读不到时的兜底值 ② 可信上限（读数超过它即判为翻倍值）
    const SAFE_AREA_BOTTOM = 48

    function applySafeAreaBottom() : void {
        const insets = uni.getSystemInfoSync().safeAreaInsets
        if (insets != null) {
            const bottom = insets.bottom
            if (bottom != null && bottom > 0 && bottom <= SAFE_AREA_BOTTOM) {
                safeAreaBottom.value = bottom
                return
            }
        }
        safeAreaBottom.value = SAFE_AREA_BOTTOM
    }

    applySafeAreaBottom()

    onMounted(() => {
        applySafeAreaBottom()
    })

    type TabItem = {
        key : string
        path : string
        icon : string
        activeIcon : string
        text : string
    }
    const tabs : TabItem[] = [
        { key: 'dashboard', path: '/pages/dashboard/dashboard', icon: '/static/tabbar/home.png', activeIcon: '/static/tabbar/home-active.png', text: '首页' },
        { key: 'courses', path: '/pages/courses/courses', icon: '/static/tabbar/course.png', activeIcon: '/static/tabbar/course-active.png', text: '课程' },
        { key: 'ai', path: '/pages/ai-assistant/ai-assistant', icon: '/static/tabbar/ai.png', activeIcon: '/static/tabbar/ai-active.png', text: 'AI学' },
        { key: 'forum', path: '/pages/forum/forum', icon: '/static/tabbar/forum.png', activeIcon: '/static/tabbar/forum-active.png', text: '交流' },
        { key: 'profile', path: '/pages/profile/profile', icon: '/static/tabbar/profile.png', activeIcon: '/static/tabbar/profile-active.png', text: '我的' },
    ]

    function onTabClick(path : string, idx : number) : void {
        // 点击当前已激活的 tab 时不重复跳转
        if (activeIndex.value == idx) return
        // 未开发页面提示
        if (path.length == 0) {
            uni.showToast({ title: '功能开发中，敬请期待', icon: 'none' })
            return
        }
        // 使用 reLaunch 防止页面栈堆积，保持 Tab 切换的单一页面栈
        uni.reLaunch({ url: path })
    }
</script>

<style>
    .tab-bar {
        flex-direction: row;
        background-color: #ffffff;
        border-top: 1rpx solid #ababab; /* 过渡件：与原生栏对齐。取 #ababab 依据：原生栏该行实测平均亮度 170.9，1rpx=1.54px × 该色暗度(255-171) ≈ 129 ≈ 等效；原 #f0f0f0（亮度 240）比页面浅蓝底(235.8)还亮、等于没有线。随组件在 #911 删除 */
        position: relative;
        z-index: 10;
    }

    .tab-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
        padding: 14rpx 0 8rpx;
    }

    .tab-icon {
        width: 44rpx;
        height: 44rpx;
        margin-bottom: 6rpx;
    }

    .tab-text {
        font-size: 20rpx;
        color: #999999;
    }

    .tab-text.active {
        color: #239EDD; /* 过渡件：与 pages.json 原生栏 selectedColor 对齐 */
        font-weight: bold;
    }
</style>
