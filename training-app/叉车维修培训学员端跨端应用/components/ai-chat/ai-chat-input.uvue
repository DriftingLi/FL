<template>
	<view class="input-card">
		<!-- 上排：占位符 + 发送 -->
		<view class="input-top">
			<input :value="inputText" class="chat-input" :placeholder="placeholder" confirm-type="send" @input="onInputChange" @confirm="onSend" />
			<text class="send-btn" :class="{ disabled: !sendEnabled || disabled }" @click="onSend">&#10148;</text>
		</view>
		<!-- 下排：模型芯片 + 动作按钮 -->
		<view class="input-bottom">
			<view v-if="showModelBar" class="model-chip" @click="onModelClick">
				<text class="model-logo">&#10022;</text>
				<text class="model-name">{{ modelName }}</text>
				<text v-if="modelDesc.length > 0" class="model-desc">{{ modelDesc }}</text>
				<text v-if="!modelReadonly" class="model-arrow">&#8964;</text>
			</view>
			<view class="action-group">
				<view v-if="showImageButton" class="action-btn" @click="onImageClick">
					<text class="action-icon">&#128206;</text>
					<text v-if="imageCount > 0" class="action-badge">{{ imageCount }}</text>
				</view>
				<view class="action-btn" @click="onVoiceClick">
					<text class="action-icon">&#128266;</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, watch } from 'vue'
	import { canSend } from '../../utils/aiImageQuota'

	const props = withDefaults(defineProps<{
		placeholder?: string
		showModelBar?: boolean
		modelName?: string
		modelDesc?: string
		modelReadonly?: boolean
		disabled?: boolean
		showImageButton?: boolean
		/** 已选待发图片张数（#2299）：>0 时输入框为空也允许发送（纯图轮次） */
		imageCount?: number
		/** 外部塞进输入框的草稿（诊断引导组好句后由页面写入；改它就等于预填输入框） */
		draft?: string
	}>(), {
		placeholder: '提出你想要知道的问题',
		showModelBar: false,
		modelName: '',
		modelDesc: '',
		modelReadonly: false,
		disabled: false,
		showImageButton: false,
		imageCount: 0,
		draft: ''
	})

	// `text-change`：把用户的每一次输入抛给页面（故障码体检要「正在输入」这个信号，#2297）。
	// 不叫 `input`：组件里那个名字属于内层原生输入的冒泡面，同名会分不清是哪个源。
	const emit = defineEmits(['send', 'modelClick', 'imageClick', 'voiceClick', 'text-change'])

	const inputText = ref<string>('')

	// 外部草稿写进来（诊断引导「填入输入框」）：只**预填**、不发送 —— 学员可改完再发
	// （票面判据：可编辑后再发送；替人发出去会把「补一句故障码」这唯一提命中率的手段废掉）。
	const draftText = computed<string>(() : string => {
		const d = props.draft
		if (d == null) return ''
		return d as string
	})

	// Kotlin 侧对 watch 回调参数推不出类型（cannot infer type / unresolved reference），
	// 故显式标注 + 经一个 typed computed 取源（#2296 实测 ④c 抓出）。
	watch(draftText, (v : string) => {
		if (v.length > 0) {
			inputText.value = v
		}
	})

	function onInputChange(e : InputEvent) : void {
		inputText.value = e.detail.value
		// 把「用户正在输入」这件事抛给页面（页面据此决定要不要给故障码体检排一发查询）
		emit('text-change', inputText.value)
	}

	// 发送可用态 = 唯一判据 `canSend`（有字 ∨ 有图）—— 早退与按钮灰态同源，
	// 免得「按钮可点、发出去被 sendInput 早退吞掉」（#2299 验收第 2 条：有图无字也能发）。
	const sendEnabled = computed<boolean>(() : boolean => {
		return canSend(inputText.value, props.imageCount)
	})

	function onSend() : void {
		const text = inputText.value.trim()
		if (!canSend(text, props.imageCount)) return
		emit('send', text)
		inputText.value = ''
	}

	function onModelClick() : void {
		emit('modelClick')
	}

	function onImageClick() : void {
		emit('imageClick')
	}

	function onVoiceClick() : void {
		emit('voiceClick')
	}
</script>

<style>
	.input-card {
		background-color: #ffffff;
		border-radius: 24rpx;
		margin: 12rpx 20rpx;
		padding: 20rpx 20rpx 14rpx 20rpx;
		border: 1rpx solid #eaf2f8;
	}

	.input-top {
		flex-direction: row;
		align-items: flex-start;
	}

	.chat-input {
		flex: 1;
		height: 72rpx;
		font-size: 28rpx;
		color: #333333;
	}

	.send-btn {
		font-size: 40rpx;
		color: #6db8e8;
		padding: 8rpx 4rpx 8rpx 16rpx;
	}

	.send-btn.disabled {
		color: #cfe6f5;
	}

	.input-bottom {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-top: 8rpx;
	}

	.model-chip {
		flex-direction: row;
		align-items: center;
		background-color: #f5f5f5;
		border-radius: 32rpx;
		padding: 10rpx 20rpx;
		flex: 1;
		margin-right: 12rpx;
	}

	.model-logo {
		font-size: 26rpx;
		color: #6e5bff;
		margin-right: 10rpx;
	}

	.model-name {
		font-size: 24rpx;
		color: #666666;
		margin-right: 10rpx;
	}

	.model-desc {
		flex: 1;
		font-size: 20rpx;
		color: #9a9a9a;
	}

	.model-arrow {
		font-size: 22rpx;
		color: #999999;
		margin-left: 8rpx;
	}

	.action-group {
		flex-direction: row;
		align-items: center;
	}

	.action-btn {
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		background-color: #f5f5f5;
		align-items: center;
		justify-content: center;
		margin-left: 12rpx;
	}

	.action-icon {
		font-size: 30rpx;
		color: #8a8a8a;
	}

	.action-badge {
		font-size: 18rpx;
		color: #ffffff;
		background-color: #6db8e8;
		border-radius: 14rpx;
		padding: 0 6rpx;
		margin-left: 2rpx;
	}
</style>