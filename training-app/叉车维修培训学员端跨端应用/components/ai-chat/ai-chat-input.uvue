<template>
	<view class="input-area">
		<view v-if="showModelBar" class="model-bar">
			<view class="model-selector" @click="onModelClick">
				<text class="model-icon">&#9733;</text>
				<text class="model-name">{{ modelName }}</text>
				<text class="model-arrow">&#9662;</text>
			</view>
		</view>
		<view class="input-row">
			<text v-if="showImageButton" class="image-btn" @click="onImageClick">&#128206;</text>
			<view class="input-box">
				<input v-model="inputText" class="chat-input" :placeholder="placeholder" confirm-type="send" @confirm="onSend" />
			</view>
			<text class="send-btn" :class="{ disabled: inputText.length == 0 || disabled }" @click="onSend">&#10148;</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	withDefaults(defineProps<{
		placeholder?: string
		showModelBar?: boolean
		modelName?: string
		disabled?: boolean
		showImageButton?: boolean
	}>(), {
		placeholder: '提出你想要知道的问题',
		showModelBar: false,
		modelName: '',
		disabled: false,
		showImageButton: false
	})

	const emit = defineEmits(['send', 'modelClick', 'imageClick'])

	const inputText = ref<string>('')

	function onSend() : void {
		const text = inputText.value.trim()
		if (text.length == 0) return
		emit('send', text)
		inputText.value = ''
	}

	function onModelClick() : void {
		emit('modelClick')
	}

	function onImageClick() : void {
		emit('imageClick')
	}
</script>

<style>
	.input-area {
		background-color: #ffffff;
		border-top: 1rpx solid #f0f0f0;
		padding: 16rpx 24rpx;
	}

	.model-bar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16rpx;
	}

	.model-selector {
		flex-direction: row;
		align-items: center;
		background-color: #f5f5f5;
		border-radius: 24rpx;
		padding: 10rpx 20rpx;
	}

	.model-icon {
		font-size: 24rpx;
		color: #2979ff;
		margin-right: 8rpx;
	}

	.model-name {
		font-size: 24rpx;
		color: #333333;
		margin-right: 8rpx;
		max-width: 300rpx;
	}

	.model-arrow {
		font-size: 20rpx;
		color: #999999;
	}

	.input-row {
		flex-direction: row;
		align-items: center;
	}

	.input-box {
		flex: 1;
		background-color: #f5f5f5;
		border-radius: 36rpx;
		padding: 0 24rpx;
		margin: 0 12rpx;
	}

	.chat-input {
		height: 72rpx;
		font-size: 28rpx;
		color: #333333;
	}

	.image-btn {
		font-size: 40rpx;
		color: #666666;
		padding: 12rpx;
		margin-right: 8rpx;
	}

	.send-btn {
		font-size: 40rpx;
		color: #2979ff;
		padding: 12rpx;
	}

	.send-btn.disabled {
		color: #cccccc;
	}
</style>
