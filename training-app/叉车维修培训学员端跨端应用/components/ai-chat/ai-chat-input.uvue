<template>
	<view class="input-card" :class="{ active: modelPickerOpen }">
		<!-- 上排：占位符 + 发送（#2520：发送键改原型切图，展开态用深一档的蓝箭头） -->
		<view class="input-top">
			<input :value="inputText" class="chat-input" :placeholder="placeholder" confirm-type="send" @input="onInputChange" @confirm="onSend" />
			<image class="send-img" :class="{ disabled: !sendEnabled || disabled }" :src="modelPickerOpen ? '/static/icons/ai-chat/send-active.png' : '/static/icons/ai-chat/send.png'" mode="aspectFit" @click="onSend" />
		</view>
		<!-- 下排：模型芯片 + 动作按钮（#2520：附件 / 麦克风改原型切图，展开态转蓝） -->
		<view class="input-bottom">
			<view v-if="showModelBar" class="model-chip" @click="onModelClick">
				<text class="model-logo">&#10022;</text>
				<text class="model-name">{{ modelName }}</text>
				<text v-if="modelDesc.length > 0" class="model-desc">{{ modelDesc }}</text>
				<image v-if="!modelReadonly && !modelPickerOpen" class="model-arrow-img" src="/static/icons/ai-chat/chevron-model.png" mode="aspectFit" />
				<text v-if="!modelReadonly && modelPickerOpen" class="model-arrow-up">&#8963;</text>
			</view>
			<view class="action-group">
				<view v-if="showImageButton" class="action-btn" :class="{ active: modelPickerOpen }" @click="onImageClick">
					<image class="action-img" :src="modelPickerOpen ? '/static/icons/ai-chat/paperclip-active.png' : '/static/icons/ai-chat/paperclip.png'" mode="aspectFit" />
					<text v-if="imageCount > 0" class="action-badge">{{ imageCount }}</text>
				</view>
				<view class="action-btn" :class="{ active: modelPickerOpen }" @click="onVoiceClick">
					<image class="action-img" :src="modelPickerOpen ? '/static/icons/ai-chat/mic-active.png' : '/static/icons/ai-chat/mic.png'" mode="aspectFit" />
				</view>
			</view>
		</view>
		<!-- #2520：模型下拉内核（页面经默认插槽塞入 AiChatModelPicker）——放在卡内 ⇒ 展开时整卡向上长，
		     面板落在芯片下方且不遮住芯片（原型 793:1197 的几何）。 -->
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, watch } from 'vue'
	import { canSend } from '../../utils/aiImageQuota'

	const props = withDefaults(defineProps<{
		placeholder?: string
		showModelBar?: boolean
		modelName?: string
		modelDesc?: string
		modelReadonly?: boolean
		disabled?: boolean
		showImageButton?: boolean
		/** 已选待发图片张数（#2299）：>0 时输入框为空也允许发送（纯图轮次） */
		imageCount?: number
		/** 外部塞进输入框的草稿（诊断引导组好句后由页面写入；改它就等于预填输入框） */
		draft?: string
		/** #2520：模型下拉是否展开（驱动芯片箭头方向、发送键与附件图标的蓝态、卡片描边） */
		modelPickerOpen?: boolean
		/**
		 * 清空信号（#2593）：页面切 scope = 换区，输入框里上一区没发出去的字必须一起消失。
		 * 不能只靠 `draft` 置空 —— 学员手打的字从不进 `draft`，`'' → ''` 也不会触发 watch。
		 * 约定：页面每切一次 scope 就 +1，组件见到变化就把内部输入清空。
		 */
		resetSignal?: number
	}>(), {
		placeholder: '提出你想要知道的问题',
		showModelBar: false,
		modelName: '',
		modelDesc: '',
		modelReadonly: false,
		disabled: false,
		showImageButton: false,
		imageCount: 0,
		draft: '',
		resetSignal: 0,
		modelPickerOpen: false
	})

	// `text-change`：把用户的每一次输入抛给页面（故障码体检要「正在输入」这个信号，#2297）。
	// 不叫 `input`：组件里那个名字属于内层原生输入的冒泡面，同名会分不清是哪个源。
	const emit = defineEmits(['send', 'modelClick', 'imageClick', 'voiceClick', 'text-change'])

	const inputText = ref<string>('')

	// 外部草稿写进来（诊断引导「填入输入框」）：只**预填**、不发送 —— 学员可改完再发
	// （票面判据：可编辑后再发送；替人发出去会把「补一句故障码」这唯一提命中率的手段废掉）。
	const draftText = computed<string>(() : string => {
		const d = props.draft
		if (d == null) return ''
		return d as string
	})

	// Kotlin 侧对 watch 回调参数推不出类型（cannot infer type / unresolved reference），
	// 故显式标注 + 经一个 typed computed 取源（#2296 实测 ④c 抓出）。
	//
	// 空串也要写进去（#2593 改）：切 scope 时页面把草稿置空，输入框必须跟着空 ——
	// 旧实现「非空才写」会让上一区的残留文字跟着学员走到新区，看起来像串区。
	watch(draftText, (v : string) => {
		inputText.value = v
	})

	// 清空信号：页面切 scope 时 +1（见 `resetSignal` 契约）。不接在草稿上是因为手打的字不进草稿。
	const resetSignalValue = computed<number>(() : number => {
		const s = props.resetSignal
		if (s == null) return 0
		return s as number
	})

	watch(resetSignalValue, (v : number) => {
		inputText.value = ''
	})

	function onInputChange(e : InputEvent) : void {
		inputText.value = e.detail.value
		// 把「用户正在输入」这件事抛给页面（页面据此决定要不要给故障码体检排一发查询）
		emit('text-change', inputText.value)
	}

	// 发送可用态 = 唯一判据 `canSend`（有字 ∨ 有图）—— 早退与按钮灰态同源，
	// 免得「按钮可点、发出去被 sendInput 早退吞掉」（#2299 验收第 2 条：有图无字也能发）。
	const sendEnabled = computed<boolean>(() : boolean => {
		return canSend(inputText.value, props.imageCount)
	})

	function onSend() : void {
		const text = inputText.value.trim()
		if (!canSend(text, props.imageCount)) return
		emit('send', text)
		inputText.value = ''
	}

	function onModelClick() : void {
		emit('modelClick')
	}

	function onImageClick() : void {
		emit('imageClick')
	}

	function onVoiceClick() : void {
		emit('voiceClick')
	}
</script>

<style lang="scss">
	/* #2520：输入卡按原型 307:6954 / 793:1197 收口 —— 20rpx 圆角、浅描边；下拉展开时描边转主色 */
	.input-card {
		background-color: #ffffff;
		border-radius: 20rpx;
		margin: 12rpx 20rpx;
		padding: 20rpx 24rpx 16rpx 24rpx;
		border: 1rpx solid #e6eef5;
	}

	.input-card.active {
		border-color: $primary-color;
	}

	.input-top {
		flex-direction: row;
		align-items: center;
	}

	.chat-input {
		flex: 1;
		height: 72rpx;
		font-size: 28rpx;
		color: #333333;
	}

	/* 发送键切图（原型 image 33 / 33-0：常态浅蓝、展开态深蓝，40×36rpx = 20×18 CSS ×2） */
	.send-img {
		width: 40rpx;
		height: 36rpx;
		margin-left: 16rpx;
	}

	.send-img.disabled {
		opacity: 0.35;
	}

	.input-bottom {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-top: 8rpx;
	}

	/* 模型芯片：原型为圆角矩形（非胶囊），14rpx 圆角 + 浅灰底 */
	.model-chip {
		flex-direction: row;
		align-items: center;
		background-color: #f5f6f8;
		border-radius: 14rpx;
		padding: 10rpx 18rpx;
		flex: 1;
		margin-right: 12rpx;
	}

	.model-logo {
		font-size: 26rpx;
		color: #6e5bff;
		margin-right: 8rpx;
	}

	.model-name {
		font-size: 24rpx;
		color: #555555;
		margin-right: 8rpx;
	}

	.model-desc {
		flex: 1;
		font-size: 20rpx;
		color: #9a9a9a;
	}

	.model-arrow-img {
		width: 34rpx;
		height: 34rpx;
		margin-left: 8rpx;
	}

	.model-arrow-up {
		font-size: 24rpx;
		color: #999999;
		margin-left: 8rpx;
	}

	.action-group {
		flex-direction: row;
		align-items: center;
	}

	.action-btn {
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		background-color: #f5f6f8;
		align-items: center;
		justify-content: center;
		margin-left: 12rpx;
	}

	/* 下拉展开态：原型里两个圆钮同转浅蓝底 + 蓝图标 */
	.action-btn.active {
		background-color: #e8f4fd;
	}

	.action-img {
		width: 40rpx;
		height: 40rpx;
	}

	.action-badge {
		font-size: 18rpx;
		color: #ffffff;
		background-color: #6db8e8;
		border-radius: 14rpx;
		padding: 0 6rpx;
		margin-left: 2rpx;
	}
</style>