<template>
	<view class="input-card">
		<!-- 上排：占位符 + 发送 -->
		<view class="input-top">
			<input :value="inputText" class="chat-input" :placeholder="placeholder" confirm-type="send" @input="onInputChange" @confirm="onSend" />
			<text class="send-btn" :class="{ disabled: inputText.length == 0 || disabled }" @click="onSend">&#10148;</text>
		</view>
		<!-- 下排：模型芯片 + 动作按钮 -->
		<view class="input-bottom">
			<view v-if="showModelBar" class="model-chip" @click="onModelClick">
				<text class="model-logo">&#10022;</text>
				<text class="model-name">{{ modelName }}</text>
				<text v-if="modelDesc.length > 0" class="model-desc">{{ modelDesc }}</text>
				<text v-if="!modelReadonly" class="model-arrow">&#8964;</text>
			</view>
			<view class="action-group">
				<view v-if="showImageButton" class="action-btn" @click="onImageClick">
					<text class="action-icon">&#128206;</text>
				</view>
				<view class="action-btn" @click="onVoiceClick">
					<text class="action-icon">&#128266;</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, watch } from 'vue'

	withDefaults(defineProps<{
		placeholder?: string
		showModelBar?: boolean
		modelName?: string
		modelDesc?: string
		modelReadonly?: boolean
		disabled?: boolean
		showImageButton?: boolean
		/** 外部塞进输入框的草稿（诊断引导组好句后由页面写入；改它就等于预填输入框） */
		draft?: string
	}>(), {
		placeholder: '提出你想要知道的问题',
		showModelBar: false,
		modelName: '',
		modelDesc: '',
		modelReadonly: false,
		disabled: false,
		showImageButton: false,
		draft: ''
	})

	const emit = defineEmits(['send', 'modelClick', 'imageClick', 'voiceClick'])

	const inputText = ref<string>('')

	// 外部草稿写进来（诊断引导「填入输入框」）：只**预填**、不发送 —— 学员可改完再发
	// （票面判据：可编辑后再发送；替人发出去会把「补一句故障码」这唯一提命中率的手段废掉）。
	watch(() => props.draft, (v) => {
		if (v.length > 0) {
			inputText.value = v
		}
	})

	function onInputChange(e : InputEvent) : void {
		inputText.value = e.detail.value
	}

	function onSend() : void {
		const text = inputText.value.trim()
		if (text.length == 0) return
		emit('send', text)
		inputText.value = ''
	}

	function onModelClick() : void {
		emit('modelClick')
	}

	function onImageClick() : void {
		emit('imageClick')
	}

	function onVoiceClick() : void {
		emit('voiceClick')
	}
</script>

<style>
	.input-card {
		background-color: #ffffff;
		border-radius: 24rpx;
		margin: 12rpx 20rpx;
		padding: 20rpx 20rpx 14rpx 20rpx;
		border: 1rpx solid #eaf2f8;
	}

	.input-top {
		flex-direction: row;
		align-items: flex-start;
	}

	.chat-input {
		flex: 1;
		height: 72rpx;
		font-size: 28rpx;
		color: #333333;
	}

	.send-btn {
		font-size: 40rpx;
		color: #6db8e8;
		padding: 8rpx 4rpx 8rpx 16rpx;
	}

	.send-btn.disabled {
		color: #cfe6f5;
	}

	.input-bottom {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-top: 8rpx;
	}

	.model-chip {
		flex-direction: row;
		align-items: center;
		background-color: #f5f5f5;
		border-radius: 32rpx;
		padding: 10rpx 20rpx;
		flex: 1;
		margin-right: 12rpx;
	}

	.model-logo {
		font-size: 26rpx;
		color: #6e5bff;
		margin-right: 10rpx;
	}

	.model-name {
		font-size: 24rpx;
		color: #666666;
		margin-right: 10rpx;
	}

	.model-desc {
		flex: 1;
		font-size: 20rpx;
		color: #9a9a9a;
	}

	.model-arrow {
		font-size: 22rpx;
		color: #999999;
		margin-left: 8rpx;
	}

	.action-group {
		flex-direction: row;
		align-items: center;
	}

	.action-btn {
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		background-color: #f5f5f5;
		align-items: center;
		justify-content: center;
		margin-left: 12rpx;
	}

	.action-icon {
		font-size: 30rpx;
		color: #8a8a8a;
	}
</style>