<template>
	<view>
		<!-- #1602 归一：页头形态收口到 app-nav-bar（唯一页头件，ADR-0035 禁 fork）。
		     旧的独立形态消失；对页的 API（leftClick / menuClick）原样保留。
		     #2479：一级页标题居中于**屏幕中心** ⇒ 页头第一行右槽必须为空，⋯（右抽屉的唯一
		     可见入口，移动端 ADR-0063 决定 4）下沉到标题栏下方工具栏行（:show-toolbar）。 -->
		<AppNavBar
			title="AI 助手"
			:subtitle="subtitle"
			:transparent="transparent"
			:left-icon="leftIcon"
			:center-title="centerTitle"
			:show-toolbar="true"
			@left-click="onLeftClick"
		>
			<template #toolbar>
				<view class="chat-menu-action" @click="onMenuClick">
					<text class="chat-menu-glyph">⋯</text>
				</view>
			</template>
		</AppNavBar>
	</view>
</template>

<script setup lang="uts">
	import AppNavBar from '../app-nav-bar/app-nav-bar.uvue'

	const props = withDefaults(defineProps<{
		/** 兼容旧调用方的占位（ai-assistant 页仍传 status-bar-height 抽屉用）；页头自身经 useSafeArea 自测 */
		statusBarHeight?: number
		subtitle?: string
		transparent?: boolean
		leftIcon?: string
		/**
		 * 标题恒居中（默认开）。左槽有了 ☰ 之后，§5.1 的「左槽有字 ⇒ 标题左对齐」会把页头
		 * 变成「☰ AI 助手 ⋯」挤在左边；聊天页要的是三段式居中（2026-10-27 裁定）。
		 */
		centerTitle?: boolean
	}>(), {
		statusBarHeight: 0,
		subtitle: '维修助手',
		transparent: true,
		// 左槽 = 「最近对话」会话抽屉的**唯一可见入口**（2026-10-27）。原先默认空串 ⇒
		// AppNavBar 左槽内 text 不渲染 ⇒ 槽 view 零宽零高，`@left-click="toggleSidebarLeft"`
		// 的命中区不存在（抽屉早在 #947 就修好了，却没有任何可点面），会话只能在标题上
		// 「点一下碰巧出来」—— 那正是 #1677 A 的「有动作、无可点面」形态。
		// 字形用 BMP 符号 ☰（U+2630），与本仓先例 recruiter-tab-bar 同源（刻意避开非 BMP 代理对 emoji）。
		leftIcon: '☰',
		centerTitle: true
	})

	const emit = defineEmits(['leftClick', 'menuClick'])

	function onLeftClick() : void {
		emit('leftClick')
	}

	function onMenuClick() : void {
		emit('menuClick')
	}
</script>

<style lang="scss">
	/* #2479：⋯ 落在标题栏下方工具栏行（.nav-bar-toolbar 自身 row + justify-content: flex-end，
	   见 app-nav-bar.uvue）。字形用 BMP 符号 ⋯（U+22EF），同 leftIcon ☰ 的避代理对口径；
	   88rpx 方块 = 44×44 触摸目标下限（<text> 只有文字高，命中区由外层 view 撑足）。 */
	.chat-menu-action {
		width: 88rpx;
		height: 88rpx;
		align-items: center;
		justify-content: center;
	}

	.chat-menu-glyph {
		font-size: 40rpx;
		color: $text-color;
	}
</style>
