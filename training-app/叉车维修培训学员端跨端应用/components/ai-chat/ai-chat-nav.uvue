<template>
	<view class="ai-chat-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
		<view class="nav-content">
			<!-- 左：会话抽屉 -->
			<view class="nav-left" @click="onLeftClick">
				<view class="panel-icon">
					<view class="panel-icon-line"></view>
				</view>
			</view>

			<!-- 中：标题 + 副标题 -->
			<view class="nav-center">
				<view class="nav-title-row">
					<text class="nav-title">AI 助手</text>
				</view>
				<text class="nav-subtitle">维修助手</text>
			</view>

			<!-- 右：菜单入口（原型里的白胶囊是小程序端 chrome，App 端不画）。
			     2026-09-13（issue #947）：真机反馈「点 ⋯ 无反应」，而**左侧同一套写法可用** ⇒
			     把右侧与左侧**对称化**：外层 view 持点击（同 .nav-left），内层给一个**有显式尺寸的盒子**
			     （同 .panel-icon 有显式尺寸），排掉"内层是裸 text、没有命中区"这条可能。
			     根因尚未定案（判别证据未取得），见 #947。 -->
			<view class="nav-right" @click="onMenuClick">
				<view class="nav-more-box">
					<text class="nav-more">&#8943;</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">

	const props = withDefaults(defineProps<{
		statusBarHeight?: number
	}>(), {
		statusBarHeight: 20
	})

	const emit = defineEmits(['leftClick', 'menuClick'])

	function onLeftClick() : void {
		emit('leftClick')
	}

	function onMenuClick() : void {
		emit('menuClick')
	}
</script>

<style>
	.ai-chat-nav {
		background-color: transparent;
	}

	.nav-content {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 8rpx 24rpx 0 24rpx;
	}

	/* 左：面板图标 */
	.nav-left {
		width: 160rpx;
		height: 96rpx;
		align-items: flex-start;
		justify-content: center;
	}

	.panel-icon {
		width: 44rpx;
		height: 36rpx;
		border: 3rpx solid #6b6b6b;
		border-radius: 8rpx;
		flex-direction: row;
		align-items: center;
	}

	.panel-icon-line {
		width: 3rpx;
		height: 24rpx;
		background-color: #6b6b6b;
		margin-left: 9rpx;
	}

	/* 中：标题 */
	.nav-center {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.nav-title-row {
		flex-direction: row;
		align-items: center;
	}

	.nav-title {
		font-size: 34rpx;
		color: #333333;
		font-weight: bold;
	}


	.nav-subtitle {
		font-size: 24rpx;
		color: #65bbe9;
		margin-top: 6rpx;
	}

	/* 右：菜单入口（宽度与左等宽，保证标题居中） */
	.nav-right {
		width: 160rpx;
		height: 96rpx;
		align-items: flex-end;
		justify-content: center;
	}

	/* 与 .panel-icon 对称：内层给显式尺寸，保证存在命中区（#947） */
	.nav-more-box {
		width: 56rpx;
		height: 56rpx;
		align-items: center;
		justify-content: center;
	}

	.nav-more {
		font-size: 40rpx;
		color: #333333;
	}
</style>
