<template>
	<view>
		<!-- #1602 归一：页头形态收口到 app-nav-bar（唯一页头件，ADR-0035 禁 fork）。
		     旧的独立形态消失；对页的 API（leftClick / menuClick）原样保留。 -->
		<AppNavBar
			title="AI 助手"
			:subtitle="subtitle"
			:transparent="transparent"
			:left-icon="leftIcon"
			:right-icons="rightIcons"
			:center-title="centerTitle"
			@left-click="onLeftClick"
			@right-click="onMenuClick"
		/>
	</view>
</template>

<script setup lang="uts">
	import AppNavBar from '../app-nav-bar/app-nav-bar.uvue'

	const props = withDefaults(defineProps<{
		/** 兼容旧调用方的占位（ai-assistant 页仍传 status-bar-height 抽屉用）；页头自身经 useSafeArea 自测 */
		statusBarHeight?: number
		subtitle?: string
		transparent?: boolean
		leftIcon?: string
		/**
		 * 标题恒居中（默认开）。左槽有了 ☰ 之后，§5.1 的「左槽有字 ⇒ 标题左对齐」会把页头
		 * 变成「☰ AI 助手 ⋯」挤在左边；聊天页要的是三段式居中（2026-10-27 裁定）。
		 */
		centerTitle?: boolean
	}>(), {
		statusBarHeight: 0,
		subtitle: '维修助手',
		transparent: true,
		// 左槽 = 「最近对话」会话抽屉的**唯一可见入口**（2026-10-27）。原先默认空串 ⇒
		// AppNavBar 左槽内 text 不渲染 ⇒ 槽 view 零宽零高，`@left-click="toggleSidebarLeft"`
		// 的命中区不存在（抽屉早在 #947 就修好了，却没有任何可点面），会话只能在标题上
		// 「点一下碰巧出来」—— 那正是 #1677 A 的「有动作、无可点面」形态。
		// 字形用 BMP 符号 ☰（U+2630），与本仓先例 recruiter-tab-bar 同源（刻意避开非 BMP 代理对 emoji）。
		leftIcon: '☰',
		centerTitle: true
	})

	/**
	 * 右槽字形（#2412）：右槽只剩「组件画字形（rightIcons）/ 页面注入 #right」两条路径，
	 * 同义的 rightIcon prop 已删除 —— 它在 #1649 被删了渲染分支，传了也不落屏幕。
	 * 单图标也走数组（n = 1）；字形用 BMP 符号 ⋯（U+22EF），同 leftIcon ☰ 的避代理对口径。
	 */
	const rightIcons : string[] = ['⋯']

	const emit = defineEmits(['leftClick', 'menuClick'])

	function onLeftClick() : void {
		emit('leftClick')
	}

	function onMenuClick() : void {
		emit('menuClick')
	}
</script>
