<template>
	<view>
		<!-- #1602 归一：页头形态收口到 app-nav-bar（唯一页头件，ADR-0035 禁 fork）。
		     旧的对页 API（leftClick / menuClick）原样保留。
		     #2479：一级页标题居中于**屏幕中心** ⇒ 页头第一行右槽必须为空。
		     #2786：⋯ 与页头工具栏行一并删除 —— 本页入口面收成「左抽屉单面」（ADR-0009
		     2026-11-23 修订），页头不再承载任何菜单入口，:show-toolbar 也不再传。 -->
		<AppNavBar
			title="基础版 ✨"
			:subtitle="subtitle"
			:subtitle-accent="true"
			:transparent="transparent"
			:left-icon="leftIcon"
			@left-click="onLeftClick"
		>
			<!-- #2520：左槽字形改原型切图（image 36 / 35，灰 / 蓝两态随抽屉开合）。
			     保留 `leftIcon` 非空（页头件按它决定是否上抛 leftClick，见 app-nav-bar）⇒
			     命中区由本插槽的 88rpx 方块撑足。 -->
			<template #left>
				<view class="nav-panel-box">
					<image class="nav-panel-img" :src="drawerOpen ? '/static/icons/ai-chat/panel-active.png' : '/static/icons/ai-chat/panel.png'" mode="aspectFit" />
				</view>
			</template>
		</AppNavBar>
	</view>
</template>

<script setup lang="uts">
	import AppNavBar from '../app-nav-bar/app-nav-bar.uvue'

	const props = withDefaults(defineProps<{
		/** 兼容旧调用方的占位（ai-assistant 页仍传 status-bar-height 抽屉用）；页头自身经 useSafeArea 自测 */
		statusBarHeight?: number
		subtitle?: string
		transparent?: boolean
		leftIcon?: string
		/** #2520：左槽面板图标的两态 —— 抽屉打开时用蓝色版（原型 307:7035） */
		drawerOpen?: boolean
	}>(), {
		statusBarHeight: 0,
		subtitle: '维修助手',
		transparent: true,
		// 左槽 = 「最近对话」会话抽屉的**唯一可见入口**（2026-10-27）。原先默认空串 ⇒
		// AppNavBar 左槽内 text 不渲染 ⇒ 槽 view 零宽零高，`@left-click="toggleSidebarLeft"`
		// 的命中区不存在（抽屉早在 #947 就修好了，却没有任何可点面），会话只能在标题上
		// 「点一下碰巧出来」—— 那正是 #1677 A 的「有动作、无可点面」形态。
		// 字形用 BMP 符号 ☰（U+2630），与本仓先例 recruiter-tab-bar 同源（刻意避开非 BMP 代理对 emoji）。
		// #2520：渲染面改切图插槽，但 prop 仍须非空 —— 页头件按它决定是否上抛 leftClick。
		leftIcon: '☰',
		drawerOpen: false
	})

	const emit = defineEmits(['leftClick'])

	function onLeftClick() : void {
		emit('leftClick')
	}
</script>

<style lang="scss">
	/* #2520：面板图标（原型 image 36 / 35，40rpx = 20px CSS ×2 出图）；外框 88rpx 保证 44×44 命中区 */
	.nav-panel-box {
		width: 88rpx;
		height: 88rpx;
		align-items: center;
		justify-content: center;
	}

	.nav-panel-img {
		width: 40rpx;
		height: 40rpx;
	}
</style>
