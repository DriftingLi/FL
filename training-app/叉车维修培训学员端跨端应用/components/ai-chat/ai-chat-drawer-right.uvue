<template>
	<view v-if="visible" class="drawer-mask" @click="onMaskClick"></view>
	<view v-if="visible" class="drawer drawer-right">
		<view class="drawer-header" :style="{ paddingTop: statusBarHeight + 'px' }">
			<text class="drawer-title">功能菜单</text>
			<text class="drawer-close" @click="onClose">&#10005;</text>
		</view>
		<scroll-view scroll-y class="drawer-body">
			<view v-for="(item, idx) in menuItems" :key="idx" class="menu-item" @click="onAction(item.key)">
				<text class="menu-item-text">{{ item.label }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * ⚠️ `MenuItem` 必须与页面**同一个类型来源**。
	 * 2026-09-13 实测（issue #947）：本文件原来自带一份 `type MenuItem = { key: string; label: string }`，
	 * 而页面用的是 `pages/ai-assistant/ai-assistant-constants.uts` 导出的同名类型 —— 两个结构相同但
	 * **名义不同**的类型编译到 Kotlin 后是两个类，页面把 `MenuItem[]` 传进本组件的 prop 时抛
	 * `java.lang.ClassCastException: MenuItem cannot be cast to MenuItem`（现场栈：本文件第 9 行 v-for），
	 * 右侧抽屉**一渲染就炸、连遮罩都没画出来** ⇒ 真机表现为「点 ⋯ 没有反应」。
	 * 左侧抽屉（`AiChatDrawerLeft`）的类型来自 `types/index`（单一来源）所以不炸 —— 这就是左右不对称的原因。
	 * 守护：`utils/aiChatDrawerContract.test.js`。
	 */
	import type { MenuItem } from '../../pages/ai-assistant/ai-assistant-constants'

	withDefaults(defineProps<{
		visible?: boolean
		menuItems?: MenuItem[]
		statusBarHeight?: number
	}>(), {
		visible: false,
		menuItems: () => [] as MenuItem[],
		statusBarHeight: 20
	})

	const emit = defineEmits(['close', 'action'])

	function onMaskClick() : void {
		emit('close')
	}

	function onClose() : void {
		emit('close')
	}

	function onAction(key : string) : void {
		emit('action', key)
	}
</script>

<style>
	.drawer-mask {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		z-index: 100;
	}

	.drawer {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 70%;
		background-color: #ffffff;
		z-index: 101;
		flex-direction: column;
	}

	.drawer-right {
		/* 2026-09-13（issue #947）：原写法只有 `right: 0`，真机表现为「点 ⋯ 无反应」——
		   而左侧抽屉（`left: 0`）一直可用 ⇒ 补上 `left: 30%`（与 `width: 70%` 一致），用"已证可用"的
		   `left` 锚定。补上之后真机**抽屉正常弹出**（维护者 2026-09-13 18:45 截图确认）。
		   ⚠️ 与 `.nav-more-box` 是同一批修复，二者中**承重者未定**（未单独二分）；实测证明"两者都在"可用。 */
		left: 30%;
		right: 0;
	}

	.drawer-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 24rpx;
		border-bottom: 1rpx solid #f0f0f0;
	}

	.drawer-title {
		font-size: 32rpx;
		font-weight: 600;
		color: #333333;
	}

	.drawer-close {
		font-size: 36rpx;
		color: #999999;
		padding: 8rpx;
	}

	.drawer-body {
		flex: 1;
		padding: 24rpx;
	}

	.menu-item {
		padding: 28rpx 0;
		border-bottom: 1rpx solid #f5f5f5;
	}

	.menu-item-text {
		font-size: 28rpx;
		color: #333333;
	}
</style>
