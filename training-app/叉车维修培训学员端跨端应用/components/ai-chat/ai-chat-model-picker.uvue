<template>
	<!-- #2520：由居中弹窗改为**输入卡内的下拉**（原型 793:1197）——不再自带遮罩；
	     收起由页面层的透明遮罩负责（点面板以外任何地方收起），故面板本身必须压在其上。 -->
	<view v-if="visible" class="model-picker">
		<view class="picker-title">
			<text class="picker-title-text">选择模型</text>
		</view>
		<view v-if="allModels.length == 0" class="picker-empty">
			<text class="picker-empty-text">暂无可用模型</text>
		</view>
		<view v-for="(m, idx) in allModels" :key="idx" class="picker-item" :class="{ active: currentModelId == m.id && currentModelSource != 'custom' }" @click="onSelectModel(m)">
			<text class="picker-item-name" :class="{ 'picker-item-name-active': currentModelId == m.id && currentModelSource != 'custom' }">{{ m.name }}</text>
			<text v-if="m.description && m.description.length > 0" class="picker-item-desc">{{ m.description }}</text>
		</view>
		<view class="picker-action" :class="{ active: currentModelSource == 'custom' }" @click="onCustomClick">
			<text class="picker-action-name">自定义 API Key</text>
			<text class="picker-action-desc">临时输入模型与密钥</text>
		</view>
		<view class="picker-action" @click="onManageClick">
			<text class="picker-action-name">管理自定义模型</text>
			<text class="picker-action-desc">新增 / 编辑 / 删除</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import type { AIModelOption } from '../../types/index'

	const props = withDefaults(defineProps<{
		visible?: boolean
		allModels?: AIModelOption[]
		currentModelId?: number
		currentModelSource?: string
	}>(), {
		visible: false,
		allModels: () => [] as AIModelOption[],
		currentModelId: 0,
		currentModelSource: 'admin'
	})

	const emit = defineEmits<{
		(e: 'close'): void
		(e: 'select', model: AIModelOption): void
		(e: 'custom'): void
		(e: 'manage'): void
	}>()

	function onSelectModel(m : AIModelOption) : void {
		emit('select', m)
	}

	function onCustomClick() : void {
		emit('custom')
	}

	function onManageClick() : void {
		emit('manage')
	}
</script>

<style lang="scss">
	/* #2520：下拉面板（原型 793:1197）—— 白底圆角、落在芯片正下方；宽度约输入卡内容盒的 70%，
	   relative + z-index 让它压在页面层遮罩（z-index 200）之上。 */
	.model-picker {
		position: relative;
		z-index: 201;
		margin-top: 12rpx;
		margin-right: 200rpx;
		background-color: #ffffff;
		border: 1rpx solid #eef1f4;
		border-radius: 16rpx;
		padding: 8rpx 0 4rpx 0;
	}

	/* 容器与文字分成两位：原生端只把 font-size/color/text-align 认给 <text>，落在 <view> 上会被判错并忽略（#1314） */
	.picker-title {
		padding: 8rpx 24rpx 4rpx 24rpx;
	}

	.picker-title-text {
		font-size: 22rpx;
		color: #999999;
	}

	.picker-empty {
		padding: 24rpx;
	}

	.picker-empty-text {
		font-size: 26rpx;
		color: #999999;
	}

	.picker-item {
		padding: 20rpx 24rpx;
	}

	.picker-item.active {
		background-color: #f2f8fd;
	}

	.picker-item-name {
		font-size: 28rpx;
		color: #333333;
	}

	/* 当前选中模型的名称走主色（原型 793:1197 第一条蓝字） */
	.picker-item-name-active {
		color: $primary-color;
	}

	.picker-item-desc {
		font-size: 22rpx;
		color: #999999;
		margin-top: 4rpx;
	}

	.picker-action {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 18rpx 24rpx;
		border-top: 1rpx solid #f5f5f5;
	}

	.picker-action.active {
		background-color: #f2f8fd;
	}

	.picker-action-name {
		font-size: 26rpx;
		color: $primary-color;
	}

	.picker-action-desc {
		font-size: 22rpx;
		color: #999999;
	}
</style>
