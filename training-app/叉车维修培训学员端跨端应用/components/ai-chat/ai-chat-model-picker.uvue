<template>
	<view v-if="visible" class="picker-mask" @click="onMaskClick"></view>
	<view v-if="visible" class="model-picker">
		<view class="picker-title">选择模型</view>
		<view v-if="allModels.length == 0" class="picker-empty">暂无可用模型</view>
		<view v-for="(m, idx) in allModels" :key="idx" class="picker-item" :class="{ active: currentModelId == m.id && currentModelSource != 'custom' }" @click="onSelectModel(m)">
			<text class="picker-item-name">{{ m.name }}</text>
			<text class="picker-item-model">{{ m.model }}</text>
		</view>
		<view class="picker-action" :class="{ active: currentModelSource == 'custom' }" @click="onCustomClick">
			<text class="picker-action-name">自定义 API Key</text>
			<text class="picker-action-desc">临时输入模型与密钥</text>
		</view>
		<view class="picker-action" @click="onManageClick">
			<text class="picker-action-name">管理自定义模型</text>
			<text class="picker-action-desc">新增 / 编辑 / 删除</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import type { AIModelOption } from '../../types/index'

	const props = withDefaults(defineProps<{
		visible?: boolean
		allModels?: AIModelOption[]
		currentModelId?: number
		currentModelSource?: string
	}>(), {
		visible: false,
		allModels: () => [] as AIModelOption[],
		currentModelId: 0,
		currentModelSource: 'admin'
	})

	const emit = defineEmits<{
		(e: 'close'): void
		(e: 'select', model: AIModelOption): void
		(e: 'custom'): void
		(e: 'manage'): void
	}>()

	function onMaskClick() : void {
		emit('close')
	}

	function onSelectModel(m : AIModelOption) : void {
		emit('select', m)
	}

	function onCustomClick() : void {
		emit('custom')
	}

	function onManageClick() : void {
		emit('manage')
	}
</script>

<style>
	.picker-mask {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		z-index: 200;
	}

	.model-picker {
		position: absolute;
		left: 48rpx;
		right: 48rpx;
		top: 30%;
		background-color: #ffffff;
		border-radius: 24rpx;
		padding: 32rpx;
		z-index: 201;
	}

	.picker-title {
		font-size: 32rpx;
		font-weight: 600;
		color: #333333;
		text-align: center;
		margin-bottom: 24rpx;
	}

	.picker-empty {
		text-align: center;
		font-size: 26rpx;
		color: #999999;
		padding: 32rpx 0;
	}

	.picker-item {
		padding: 24rpx;
		border-bottom: 1rpx solid #f5f5f5;
	}

	.picker-item.active {
		background-color: #e3f2fd;
		border-radius: 12rpx;
	}

	.picker-item-name {
		font-size: 28rpx;
		color: #333333;
		font-weight: 500;
	}

	.picker-item-model {
		font-size: 22rpx;
		color: #999999;
		margin-top: 6rpx;
	}

	.picker-action {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 24rpx;
		border-bottom: 1rpx solid #f5f5f5;
	}

	.picker-action.active {
		background-color: #e3f2fd;
		border-radius: 12rpx;
	}

	.picker-action-name {
		font-size: 28rpx;
		color: #2979ff;
		font-weight: 500;
	}

	.picker-action-desc {
		font-size: 22rpx;
		color: #999999;
	}
</style>
