<template>
	<view v-if="images.length > 0 || placeholders.length > 0" class="tray-wrap">
		<view class="tray-row">
			<view v-for="(u, idx) in images" :key="u" class="tray-item" @click="onPreview(idx)">
				<image class="tray-thumb" :src="resolveUrl(u)" mode="aspectFill" :webp="true" />
				<view class="tray-del" @click.stop="onRemove(idx)">
					<text class="tray-del-text">×</text>
				</view>
			</view>
			<view v-for="p in placeholders" :key="p" class="tray-item tray-item-uploading">
				<text class="tray-uploading-text">上传中</text>
			</view>
		</view>
		<text class="tray-count">已选 {{ images.length }}/{{ maxImages }} 张</text>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { resolveFileUrl } from '../../utils/forumDisplay'

	/**
	 * 待发图片托盘（#2299）：缩略图 / 删除 / 点击预览 / 上传中占位 / 名额提示。
	 *
	 * 状态**不在这层**：图与上传中的张数都由页面从 `useAiImagePicker` 传进来 ——
	 * 托盘只是展示与转发，发送后由 picker 的 `clear()` 收空（避免「发完图还挂在输入框上」）。
	 */
	const props = withDefaults(defineProps<{
		images?: string[]
		uploadingCount?: number
		maxImages?: number
	}>(), {
		images: () => [] as string[],
		uploadingCount: 0,
		maxImages: 3
	})

	const emit = defineEmits(['remove', 'preview'])

	/** 上传中占位（用数字数组驱动 v-for：模板块里不写 range() 调用，规避 error18） */
	const placeholders = computed<number[]>(() : number[] => {
		const out : number[] = []
		for (let i = 0; i < props.uploadingCount; i++) {
			out.push(i)
		}
		return out
	})

	/** 模板只调本地名（直调 import 函数会编成 .invoke ⇒ Kotlin error18，见既有先例） */
	function resolveUrl(url : string) : string {
		return resolveFileUrl(url)
	}

	function onRemove(index : number) : void {
		emit('remove', index)
	}

	function onPreview(index : number) : void {
		emit('preview', index)
	}
</script>

<style lang="scss">
	.tray-wrap {
		flex-direction: column;
		padding: 12rpx 20rpx 0 20rpx;
	}

	.tray-row {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.tray-item {
		width: 128rpx;
		height: 128rpx;
		border-radius: 12rpx;
		margin-right: 12rpx;
		margin-bottom: 8rpx;
		position: relative;
		align-items: center;
		justify-content: center;
		background-color: #f5f7fa;
	}

	.tray-thumb {
		width: 128rpx;
		height: 128rpx;
		border-radius: 12rpx;
	}

	.tray-item-uploading {
		border: 1rpx dashed #b9c9d6;
	}

	.tray-uploading-text {
		font-size: 20rpx;
		color: #8a8a8a;
	}

	.tray-del {
		position: absolute;
		right: 0;
		top: 0;
		width: 36rpx;
		height: 36rpx;
		border-radius: 18rpx;
		background-color: #333333;
		align-items: center;
		justify-content: center;
	}

	.tray-del-text {
		font-size: 24rpx;
		color: #ffffff;
		line-height: 36rpx;
	}

	.tray-count {
		font-size: 20rpx;
		color: #9a9a9a;
		margin-bottom: 6rpx;
	}
</style>
