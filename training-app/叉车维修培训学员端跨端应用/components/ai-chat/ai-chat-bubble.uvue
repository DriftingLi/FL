<template>
	<view class="message-row" :class="role">
		<view class="message-bubble">
			<!-- 用户消息：保持纯文本，逐字节不变（#1443 刻意不改这一支，学员自己打进去的原始文本不该被二次解析）。 -->
			<text v-if="role == 'user'" class="message-text">{{ displayContent(content) }}</text>
			<!-- 助手消息：markdown 块渲染（#1443，ADR-0046 决定 6 已回填）。解析在壳层
			     `utils/aiAnswerBody.uts`（唯一真源 parseMarkdown + #1279 展开前置，均不在本处重写）；
			     模板只消费本地 computed —— 直调 import 函数会编成 .invoke()（见脚本注释）。 -->
			<view v-else class="md-body">
				<view v-for="(block, idx) in assistantBlocks" :key="idx" class="md-block">
					<text v-if="block.type == 'heading'" :class="['md-heading', 'md-h' + block.level]">{{ block.text }}</text>
					<view v-else-if="block.type == 'code'" class="md-code-wrap"><text class="md-code">{{ block.text }}</text></view>
					<view v-else-if="block.type == 'list'" class="md-list">
						<view v-for="(item, li) in block.items" :key="li" class="md-list-item">
							<text class="md-list-bullet">&#8226;</text>
							<text class="md-list-text">{{ item }}</text>
						</view>
					</view>
					<view v-else-if="block.type == 'quote'" class="md-quote"><text class="md-quote-text">{{ block.text }}</text></view>
					<view v-else-if="block.type == 'divider'" class="md-divider"></view>
					<text v-else class="md-paragraph">{{ block.text }}</text>
				</view>
			</view>
		</view>
		<!-- 诊断来源资料（#988）：位置对齐 web 的 `#assistant-extra`（回答下方、操作按钮上方）。
		     仅助手消息且有来源才出现；调用方不传 `sources` 时行为与从前完全一致。 -->
		<AiChatSources v-if="role == 'assistant' && sources.length > 0" :sources="sources" />
		<view v-if="showActions" class="message-actions">
			<text class="action-btn" @click="onCopy">&#x1F4CB; 复制</text>
			<text v-if="isLast" class="action-btn" @click="onRetry">&#x1F504; 重试</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import AiChatSources from './ai-chat-sources.uvue'
	import { expandImageMarkers } from '../../utils/aiSourcesDisplay'
	import { aiAnswerBlocks } from '../../utils/aiAnswerBody'
	import type { AiDiagnosisSource, MarkdownBlock } from '../../types/index'

	const props = withDefaults(defineProps<{
		role?: string
		content?: string
		showActions?: boolean
		isLast?: boolean
		sources?: AiDiagnosisSource[]
	}>(), {
		role: 'assistant',
		content: '',
		showActions: false,
		isLast: false,
		sources: () => [] as AiDiagnosisSource[]
	})

	const emit = defineEmits(['copy', 'retry'])

	/**
	 * 用户消息的**本地包装**（#1279）：模板里直调 import 函数会被 uni-app x 编成 `.invoke()`
	 * ⇒ Kotlin `error18 找不到名称 invoke`（全工程守护 = `utils/utsAndroidCompile.test.js` S 组），
	 * 故模板只调本地名；算法本体仍在 `utils/aiSourcesDisplay.uts`，本处不自行解析。
	 */
	function displayContent(value : string) : string {
		return expandImageMarkers(value)
	}

	/**
	 * 助手气泡的渲染块（#1443）：全部口径（#1279 展开前置、论坛档位、降级形状）
	 * 住在唯一壳层 `utils/aiAnswerBody.uts`，本处只包一层本地名供模板消费（.invoke 雷同上）。
	 * 模板的 v-if/v-else 已把用户消息分流出去，这里不再判 role。
	 */
	const assistantBlocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => {
		// 脚本作用域取 props 必须 `props.` 前缀（forum-topic-body 同例）；模板里裸名可用，
		// 但编译到 Kotlin 后脚本里的裸名是 unresolved reference（④c 实测：content 报错）。
		return aiAnswerBlocks(props.content)
	})

	function onCopy() : void {
		emit('copy')
	}

	function onRetry() : void {
		emit('retry')
	}
</script>

<style>
	.message-row {
		flex-direction: column;
		margin-bottom: 20rpx;
	}

	.message-row.user {
		align-items: flex-end;
	}

	.message-row.assistant {
		align-items: flex-start;
	}

	.message-bubble {
		max-width: 600rpx;
		padding: 20rpx 24rpx;
		border-radius: 16rpx;
	}

	.message-row.user .message-bubble {
		background-color: #2979ff;
	}

	.message-row.assistant .message-bubble {
		background-color: #ffffff;
	}

	.message-text {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	.message-row.user .message-text {
		color: #ffffff;
	}

	.message-actions {
		flex-direction: row;
		margin-top: 8rpx;
	}

	.action-btn {
		font-size: 22rpx;
		color: #999999;
		margin-right: 20rpx;
		padding: 4rpx 0;
	}

	/* 助手气泡 markdown 块（#1443）：气泡底 #fff，文字取深色；字号跟 message-text 同基准。 */
	.md-body {
		flex-direction: column;
	}

	.md-block {
		flex-direction: column;
	}

	.md-heading {
		font-size: 30rpx;
		font-weight: bold;
		color: #1a1a1a;
		margin-top: 12rpx;
		margin-bottom: 6rpx;
	}

	.md-h1 { font-size: 36rpx; }
	.md-h2 { font-size: 32rpx; }
	.md-h3 { font-size: 30rpx; }

	.md-paragraph {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	.md-code-wrap {
		background-color: #f5f5f5;
		border-radius: 8rpx;
		padding: 16rpx;
		margin-top: 8rpx;
		margin-bottom: 8rpx;
	}

	.md-code {
		font-size: 24rpx;
		color: #444444;
	}

	.md-list {
		flex-direction: column;
		margin-top: 4rpx;
		margin-bottom: 4rpx;
	}

	.md-list-item {
		flex-direction: row;
		align-items: flex-start;
	}

	.md-list-bullet {
		font-size: 28rpx;
		color: #333333;
		margin-right: 10rpx;
	}

	.md-list-text {
		flex: 1;
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	.md-quote {
		border-left-width: 6rpx;
		border-left-color: #d0d0d0;
		border-left-style: solid;
		padding-left: 16rpx;
		margin-top: 6rpx;
		margin-bottom: 6rpx;
	}

	.md-quote-text {
		font-size: 28rpx;
		color: #666666;
		line-height: 1.6;
	}

	.md-divider {
		height: 1rpx;
		background-color: #e0e0e0;
		margin-top: 12rpx;
		margin-bottom: 12rpx;
	}
</style>
