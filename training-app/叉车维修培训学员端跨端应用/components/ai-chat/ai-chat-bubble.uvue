<template>
	<view class="message-row" :class="role">
		<view class="message-bubble">
			<!-- 用户消息：文字仍保持纯文本、逐字节不变（#1443）；纯图轮次没有文字，故有字才渲染这一行。
			     附图（#2299）：缩略图一行、点开走 `uni.previewImage`；URL 是站内地址，原样当 src 用。 -->
			<text v-if="role == 'user' && messageContent.length > 0" class="message-text">{{ displayContent(messageContent) }}</text>
			<view v-if="role == 'user' && userImages.length > 0" class="user-images">
				<image v-for="(u, idx) in userImages" :key="u" class="user-image" :src="u" mode="aspectFill" @click="onPreviewImage(idx)" />
			</view>
			<!-- 助手消息：markdown 块渲染（#1443，ADR-0046 决定 6 已回填）。解析在壳层
			     `utils/aiAnswerBody.uts`（唯一真源 parseMarkdown + #1279 展开前置，均不在本处重写）；
			     模板只消费本地 computed —— 直调 import 函数会编成 .invoke()（见脚本注释）。 -->
			<view v-if="role != 'user'" class="md-body">
				<view v-for="(block, idx) in assistantBlocks" :key="idx" class="md-block">
					<text v-if="block.type == 'heading'" :class="['md-heading', 'md-h' + block.level]">{{ block.text }}</text>
					<view v-else-if="block.type == 'code'" class="md-code-wrap"><text class="md-code">{{ block.text }}</text></view>
					<view v-else-if="block.type == 'list'" class="md-list">
						<view v-for="(item, li) in block.items" :key="li" class="md-list-item">
							<text class="md-list-bullet">&#8226;</text>
							<text class="md-list-text">{{ item }}</text>
						</view>
					</view>
					<view v-else-if="block.type == 'quote'" class="md-quote"><text class="md-quote-text">{{ block.text }}</text></view>
					<view v-else-if="block.type == 'divider'" class="md-divider"></view>
					<!-- 诊断配图（#2362 / 移动端 ADR 0056）：只有站内代理图会走到这里（壳层已过滤），
					     宽度受气泡约束（widthFix + 100%），点开走全屏预览、同消息可左右翻。 -->
					<image v-else-if="block.type == 'image'" class="md-image" :src="block.text" mode="widthFix"
						@click="onPreviewAssistantImageAt(idx)"></image>
					<text v-else class="md-paragraph">{{ block.text }}</text>
				</view>
			</view>
		</view>
		<!-- 诊断来源资料（#988）：位置对齐 web 的 `#assistant-extra`（回答下方、操作按钮上方）。
		     仅助手消息且有来源才出现；调用方不传 `sources` 时行为与从前完全一致。 -->
		<AiChatSources v-if="role == 'assistant' && messageSources.length > 0" :sources="messageSources" />
		<view v-if="showActions" class="message-actions">
			<text class="action-btn" @click="onCopy">&#x1F4CB; 复制</text>
			<text v-if="isLast" class="action-btn" @click="onRetry">&#x1F504; 重试</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import AiChatSources from './ai-chat-sources.uvue'
	import { expandImageMarkers } from '../../utils/aiSourcesDisplay'
	import { previewImages } from '../../utils/forumDetailDisplay'
	import { aiAnswerBlocks, aiAnswerImageUrls, aiAnswerImageIndexAt } from '../../utils/aiAnswerBody'
	import type { AiDiagnosisSource, MarkdownBlock } from '../../types/index'

	const props = withDefaults(defineProps<{
		role?: string
		content?: string
		showActions?: boolean
		isLast?: boolean
		sources?: AiDiagnosisSource[]
		/** 用户消息附图（#2299）：站内 URL；历史回显与刚发出的同一形状 */
		images?: string[]
	}>(), {
		role: 'assistant',
		content: '',
		showActions: false,
		isLast: false,
		sources: () => [] as AiDiagnosisSource[],
		images: () => [] as string[]
	})

	const emit = defineEmits(['copy', 'retry'])

	/**
	 * 用户消息的**本地包装**（#1279）：模板里直调 import 函数会被 uni-app x 编成 `.invoke()`
	 * ⇒ Kotlin `error18 找不到名称 invoke`（全工程守护 = `utils/utsAndroidCompile.test.js` S 组），
	 * 故模板只调本地名；算法本体仍在 `utils/aiSourcesDisplay.uts`，本处不自行解析。
	 */
	function displayContent(value : string) : string {
		return expandImageMarkers(value)
	}

	/**
	 * 用户附图的**空值归一**：历史消息的 `images` 是 nullable（后端空数组可能落成 null），
	 * 模板直接 `.length` 会在 null 上炸；收敛到这里，其余分支只认数组。
	 */
	const userImages = computed<string[]>(() : string[] => {
		const v = props.images
		if (v == null) return [] as string[]
		return v
	})

	/**
	 * 用户正文的**空值归一**（#2328）：服务端映射走 `toStr` 本应恒为字符串，
	 * 但可空 prop 只要落一次 null，模板里的 `.length` 就会把整帧渲染打断
	 * （症状 = 发了消息不回复）。收敛到这里，模板只认字符串。
	 */
	const messageContent = computed<string>(() : string => {
		const v = props.content
		if (v == null) return ''
		return `${v}`
	})

	/**
	 * 诊断来源的**空值归一**（#2328）：`sources` 确实会是 null —— 历史消息映射
	 * （`api/aiAssistant.uts` 的 `buildSessionMessage`）与发消息时的助手占位消息
	 * 都把它显式填成 null，而 Vue 的 prop default 只对 undefined 生效。
	 * 模板读 `.length` 前必须先过这里。
	 */
	const messageSources = computed<AiDiagnosisSource[]>(() : AiDiagnosisSource[] => {
		const v = props.sources
		if (v == null) return [] as AiDiagnosisSource[]
		return v
	})

	/** 用户附图预览：口径单点在 `utils/forumDetailDisplay.previewImages`，本处只包本地名（.invoke 雷同） */
	function onPreviewImage(index : number) : void {
		previewImages(userImages.value, index)
	}

	/**
	 * 助手气泡的渲染块（#1443）：全部口径（#1279 展开前置、论坛档位、降级形状）
	 * 住在唯一壳层 `utils/aiAnswerBody.uts`，本处只包一层本地名供模板消费（.invoke 雷同上）。
	 * 模板的 v-if 已把用户消息分流出去（#2328：原来是 v-else，被附图分支抢走了，
	 * 用户文字气泡于是多渲染一遍 markdown 正文），这里不再判 role。
	 */
	const assistantBlocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => {
		// 脚本作用域取 props 必须 `props.` 前缀（forum-topic-body 同例）；模板里裸名可用，
		// 但编译到 Kotlin 后脚本里的裸名是 unresolved reference（④c 实测：content 报错）。
		return aiAnswerBlocks(messageContent.value)
	})

	/**
	 * 回答正文的图集（#2362）：渲染与预览共用同一份，口径住在纯函数层
	 * （`utils/aiAnswerBody.aiAnswerImageUrls`，行为面有真执行用例），模板只读本地名。
	 */
	const assistantImageUrls = computed<string[]>(() : string[] => {
		return aiAnswerImageUrls(assistantBlocks.value)
	})

	/** 回答配图预览：按**块序号**换算图集下标（不按 URL 反查），与渲染顺序同源 */
	function onPreviewAssistantImageAt(blockIndex : number) : void {
		previewImages(assistantImageUrls.value, aiAnswerImageIndexAt(assistantBlocks.value, blockIndex))
	}

	function onCopy() : void {
		emit('copy')
	}

	function onRetry() : void {
		emit('retry')
	}
</script>

<style lang="scss">
	.message-row {
		flex-direction: column;
		margin-bottom: 20rpx;
	}

	.message-row.user {
		align-items: flex-end;
	}

	.message-row.assistant {
		align-items: flex-start;
	}

	.message-bubble {
		max-width: 600rpx;
		padding: 20rpx 24rpx;
		border-radius: 16rpx;
	}

	.message-row.user .message-bubble {
		background-color: #2979ff;
	}

	.message-row.assistant .message-bubble {
		background-color: #ffffff;
	}

	.message-text {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	.message-row.user .message-text {
		color: #ffffff;
	}

	.user-images {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 10rpx;
	}

	.user-image {
		width: 156rpx;
		height: 156rpx;
		border-radius: 12rpx;
		margin-right: 10rpx;
		margin-bottom: 8rpx;
	}

	.message-actions {
		flex-direction: row;
		margin-top: 8rpx;
	}

	.action-btn {
		font-size: 22rpx;
		color: #999999;
		margin-right: 20rpx;
		padding: 4rpx 0;
	}

	/* 助手气泡 markdown 块（#1443）：气泡底 #fff，文字取深色；字号跟 message-text 同基准。 */
	.md-body {
		flex-direction: column;
	}

	.md-block {
		flex-direction: column;
	}

	.md-heading {
		font-size: 30rpx;
		font-weight: bold;
		color: #1a1a1a;
		margin-top: 12rpx;
		margin-bottom: 6rpx;
	}

	.md-h1 { font-size: 36rpx; }
	.md-h2 { font-size: 32rpx; }
	.md-h3 { font-size: 30rpx; }

	/* 诊断配图（#2362）：宽度吃满气泡内容宽（widthFix 只定高）。
	   数值取**章节面**那套（chapter-markdown 的 12rpx 圆角 / 上下 16rpx），
	   与精选面的 8rpx/8rpx 是历史差异，不在本票收敛 —— 别再自创第三套数值。 */
	.md-image {
		width: 100%;
		border-radius: 12rpx;
		margin-top: 16rpx;
		margin-bottom: 16rpx;
	}

	.md-paragraph {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	.md-code-wrap {
		background-color: #f5f5f5;
		border-radius: 8rpx;
		padding: 16rpx;
		margin-top: 8rpx;
		margin-bottom: 8rpx;
	}

	.md-code {
		font-size: 24rpx;
		color: #444444;
	}

	.md-list {
		flex-direction: column;
		margin-top: 4rpx;
		margin-bottom: 4rpx;
	}

	.md-list-item {
		flex-direction: row;
		align-items: flex-start;
	}

	.md-list-bullet {
		font-size: 28rpx;
		color: #333333;
		margin-right: 10rpx;
	}

	.md-list-text {
		flex: 1;
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	.md-quote {
		border-left-width: 6rpx;
		border-left-color: #d0d0d0;
		border-left-style: solid;
		padding-left: 16rpx;
		margin-top: 6rpx;
		margin-bottom: 6rpx;
	}

	.md-quote-text {
		font-size: 28rpx;
		color: #666666;
		line-height: 1.6;
	}

	.md-divider {
		height: 1rpx;
		background-color: #e0e0e0;
		margin-top: 12rpx;
		margin-bottom: 12rpx;
	}
</style>
