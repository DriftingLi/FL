<template>
	<view class="message-row" :class="role">
		<view class="message-bubble">
			<!-- 用户消息：文字仍保持纯文本、逐字节不变（#1443）；纯图轮次没有文字，故有字才渲染这一行。
			     附图（#2299）：缩略图一行、点开走 `uni.previewImage`；URL 是站内地址，原样当 src 用。 -->
			<text v-if="role == 'user' && messageContent.length > 0" class="message-text">{{ displayContent(messageContent) }}</text>
			<view v-if="role == 'user' && userImages.length > 0" class="user-images">
				<image v-for="(u, idx) in userImages" :key="u" class="user-image" :src="u" mode="aspectFill" @click="onPreviewImage(idx)" :webp="true" />
			</view>
			<!-- 助手消息：块怎么排一律交给四面共用的 `components/markdown/markdown-blocks.uvue`
			     （#2354 决议 D1：气泡不再自排块）。解析仍在壳层 `utils/aiAnswerBody.uts`
			     （唯一真源 parseMarkdown + #1279 展开前置，均不在本处重写）；模板只消费本地 computed
			     —— 直调 import 函数会编成 .invoke()（见脚本注释）。
			     本票之前这里自带一份 8 条分支的模板与一整套 .md-* 样式，与课程章节面各排各的，
			     于是「一套刻度」在气泡里永远是第二份事实；现在同一段正文换个入口不再换一种疏密。 -->
			<!-- 行内轴 = `plain`（#2366）：块文本交给分词器切成 runs，记号由渲染层吞，
			     与课程章节页 / 论坛 / 内容精选走同一套嵌套 `<text>`；不传这个 prop 就是
			     `none`（直出块文本），`**粗**` 会原样外露。 -->
			<MarkdownBlocks v-if="role != 'user'" :blocks="assistantBlocks" :caps="AI_ANSWER_CAPS"
				inline-axis="plain" @image-click="onPreviewAssistantImageAt" />
		</view>
		<!-- 诊断能力徽章与耗时（#2361）：位置按票面 AC「回答下方」，排在来源折叠件之前。
		     要不要出现由 `utils/aiDiagnosisMeta.uts#metaViewOf` 的 visible 判定（meta 为 null /
		     徽章空集 / 耗时为 0 三种「没有」态都不出空壳），本处只把归一后的 meta 传下去。 -->
		<AiChatBadges v-if="role == 'assistant'" :meta="messageMeta" />
		<!-- 诊断来源资料（#988）：位置对齐 web 的 `#assistant-extra`（回答下方、操作按钮上方）。
		     仅助手消息且有来源才出现；调用方不传 `sources` 时行为与从前完全一致。 -->
		<AiChatSources v-if="role == 'assistant' && messageSources.length > 0" :sources="messageSources" />
		<view v-if="showActions" class="message-actions">
			<text class="action-btn" @click="onCopy">&#x1F4CB; 复制</text>
			<text v-if="isLast" class="action-btn" @click="onRetry">&#x1F504; 重试</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import AiChatSources from './ai-chat-sources.uvue'
	import AiChatBadges from './ai-chat-badges.uvue'
	import MarkdownBlocks from '../markdown/markdown-blocks.uvue'
	import { expandImageMarkers } from '../../utils/aiSourcesDisplay'
	import { previewImages } from '../../utils/forumDetailDisplay'
	import { aiAnswerBlocks, aiAnswerImageUrls, aiAnswerImageIndexAt } from '../../utils/aiAnswerBody'
	import type { AiDiagnosisSource, AiDiagnosisMeta, MarkdownBlock, MarkdownImageClick } from '../../types/index'

	/**
	 * AI 回答面的能力位（#2354 决议 D2）：**八位**，与 `chapter-markdown.uvue` 的 `CHAPTER_CAPS` 同形
	 * （常量写在壳件脚本里，不散进模板字面量）。
	 *
	 * - 与 `SUBSET_MEMBERS_AI_ANSWER` 的差集只有一处：多一个 `paragraph`。它是**段落地板**，
	 *   从来没进过解析器那边的声明表（`markdownContract.test.js` 有一条
	 *   `not.toContain('MEMBER_PARAGRAPH')` 钉着），但公共件的 paragraph 分支靠 `cap('paragraph')`
	 *   开 —— 不传这一位，整条回答只剩标题与列表，正文整体消失。
	 * - `table` 自 #2398 起**传**（移动端 ADR 0061）：解析器那边同批声明了它，两处缺一处表格块
	 *   就静默消失且日志无异常 —— 这正是本票 AC① 要钉的失败模式。
	 * - 这两处天然是**两份事实**（声明表 vs 这里的手写清单），所以 `markdownContract` 套件里
	 *   有一条源守卫钉「每一项 ∈ 声明表 ∪ {paragraph}」，防「AI 档日后加成员而 caps 不跟」。
	 */
	const AI_ANSWER_CAPS : string[] = [
		'heading', 'paragraph', 'code', 'list', 'quote', 'divider', 'image', 'table'
	]

	const props = withDefaults(defineProps<{
		role?: string
		content?: string
		showActions?: boolean
		isLast?: boolean
		sources?: AiDiagnosisSource[]
		/** 用户消息附图（#2299）：站内 URL；历史回显与刚发出的同一形状 */
		images?: string[]
		/**
		 * 诊断能力徽章与耗时（#2361）：仅诊断通道的助手消息会有；当轮与回看落同一字段。
		 *
		 * ⚠️ 这个可空对象 prop **不进 withDefaults**：默认值只对 undefined 生效，父级显式传
		 * null（非诊断轮 / 存量消息）时会绕过它 —— #2328 事故链正是这一条。取值走 `messageMeta`。
		 */
		meta?: AiDiagnosisMeta
	}>(), {
		role: 'assistant',
		content: '',
		showActions: false,
		isLast: false,
		sources: () => [] as AiDiagnosisSource[],
		images: () => [] as string[]
	})

	const emit = defineEmits(['copy', 'retry'])

	/**
	 * 用户消息的**本地包装**（#1279）：模板里直调 import 函数会被 uni-app x 编成 `.invoke()`
	 * ⇒ Kotlin `error18 找不到名称 invoke`（全工程守护 = `utils/utsAndroidCompile.test.js` S 组），
	 * 故模板只调本地名；算法本体仍在 `utils/aiSourcesDisplay.uts`，本处不自行解析。
	 */
	function displayContent(value : string) : string {
		return expandImageMarkers(value)
	}

	/**
	 * 用户附图的**空值归一**：历史消息的 `images` 是 nullable（后端空数组可能落成 null），
	 * 模板直接 `.length` 会在 null 上炸；收敛到这里，其余分支只认数组。
	 */
	const userImages = computed<string[]>(() : string[] => {
		const v = props.images
		if (v == null) return [] as string[]
		return v
	})

	/**
	 * 用户正文的**空值归一**（#2328）：服务端映射走 `toStr` 本应恒为字符串，
	 * 但可空 prop 只要落一次 null，模板里的 `.length` 就会把整帧渲染打断
	 * （症状 = 发了消息不回复）。收敛到这里，模板只认字符串。
	 */
	const messageContent = computed<string>(() : string => {
		const v = props.content
		if (v == null) return ''
		return `${v}`
	})

	/**
	 * 诊断来源的**空值归一**（#2328）：`sources` 确实会是 null —— 历史消息映射
	 * （`api/aiAssistant.uts` 的 `buildSessionMessage`）与发消息时的助手占位消息
	 * 都把它显式填成 null，而 Vue 的 prop default 只对 undefined 生效。
	 * 模板读 `.length` 前必须先过这里。
	 */
	const messageSources = computed<AiDiagnosisSource[]>(() : AiDiagnosisSource[] => {
		const v = props.sources
		if (v == null) return [] as AiDiagnosisSource[]
		return v
	})

	/**
	 * 诊断徽章与耗时的**空值归一**（#2361，同 #2328 的收敛理由）：非诊断轮与存量消息的
	 * meta 为 null，模板若直取成员会打断整帧渲染。这里只判空、不解析 —— 三态与文案
	 * 全部由 `utils/aiDiagnosisMeta.uts#metaViewOf` 决定（纯函数、真执行断言）。
	 */
	const messageMeta = computed<AiDiagnosisMeta | null>(() : AiDiagnosisMeta | null => {
		const v = props.meta
		if (v == null) return null
		// props 成员在 Kotlin 侧被当成 Any ⇒ 显式强转回目标类型（ai-chat-diagnosis-guide 同例，④c 实测）
		return v as AiDiagnosisMeta
	})

	/** 用户附图预览：口径单点在 `utils/forumDetailDisplay.previewImages`，本处只包本地名（.invoke 雷同） */
	function onPreviewImage(index : number) : void {
		previewImages(userImages.value, index)
	}

	/**
	 * 助手气泡的渲染块（#1443）：全部口径（#1279 展开前置、论坛档位、降级形状）
	 * 住在唯一壳层 `utils/aiAnswerBody.uts`，本处只包一层本地名供模板消费（.invoke 雷同上）。
	 * 模板的 v-if 已把用户消息分流出去（#2328：原来是 v-else，被附图分支抢走了，
	 * 用户文字气泡于是多渲染一遍 markdown 正文），这里不再判 role。
	 */
	const assistantBlocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => {
		// 脚本作用域取 props 必须 `props.` 前缀（forum-topic-body 同例）；模板里裸名可用，
		// 但编译到 Kotlin 后脚本里的裸名是 unresolved reference（④c 实测：content 报错）。
		return aiAnswerBlocks(messageContent.value)
	})

	/**
	 * 回答正文的图集（#2362）：渲染与预览共用同一份，口径住在纯函数层
	 * （`utils/aiAnswerBody.aiAnswerImageUrls`，行为面有真执行用例），模板只读本地名。
	 */
	const assistantImageUrls = computed<string[]>(() : string[] => {
		return aiAnswerImageUrls(assistantBlocks.value)
	})

	/**
	 * 回答配图预览：按**块序号**换算图集下标（不按 URL 反查），与渲染顺序同源。
	 *
	 * 载荷自 #2354 起是单对象 `MarkdownImageClick`（公共件的接口，决议 D4）：`index` 是图所在
	 * **块的序号**，由公共件随点击下发。为什么要这么绕 —— 同一张图在同一条回答里出现两次时，
	 * 按 URL 值反查永远命中第一张，预览起点就会错（#2362 明写「不按 URL 反查」）；块序号是唯一
	 * 能分辨「第几次出现」的信息，而它只有渲染方能给出，故必须随事件送出来。
	 */
	function onPreviewAssistantImageAt(payload : MarkdownImageClick) : void {
		previewImages(assistantImageUrls.value, aiAnswerImageIndexAt(assistantBlocks.value, payload.index))
	}

	function onCopy() : void {
		emit('copy')
	}

	function onRetry() : void {
		emit('retry')
	}
</script>

<style lang="scss">
	.message-row {
		flex-direction: column;
		margin-bottom: 20rpx;
	}

	.message-row.user {
		align-items: flex-end;
	}

	.message-row.assistant {
		align-items: flex-start;
	}

	.message-bubble {
		max-width: 600rpx;
		padding: 20rpx 24rpx;
		border-radius: 16rpx;
	}

	.message-row.user .message-bubble {
		background-color: #2979ff;
	}

	.message-row.assistant .message-bubble {
		background-color: #ffffff;
	}

	.message-text {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	.message-row.user .message-text {
		color: #ffffff;
	}

	.user-images {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 10rpx;
	}

	.user-image {
		width: 156rpx;
		height: 156rpx;
		border-radius: 12rpx;
		margin-right: 10rpx;
		margin-bottom: 8rpx;
	}

	.message-actions {
		flex-direction: row;
		margin-top: 8rpx;
	}

	.action-btn {
		font-size: 22rpx;
		color: #999999;
		margin-right: 20rpx;
		padding: 4rpx 0;
	}

	/* 助手气泡的 .md-* 样式自 #2354 起**整段删除**：正文块改由四面共用的
	   `components/markdown/markdown-blocks.uvue` 渲染，字号 / 行高 / 间距 / 配色全部来自
	   `uni.scss` 的 `$md-*` 段（一套刻度只有一处定义）。

	   为什么删而不是留：uni-app x 的样式隔离策略 2.0 + 本仓全部 `.uvue` 均非 `<style scoped>`
	   ⇒ 留着这些同名类（`.md-body` / `.md-block` / `.md-paragraph` / `.md-code` …）就是**死代码**，
	   而且是与公共件**同名**的死代码：哪天有人给公共件补一条样式，会以为这边也有一份。
	   删干净是让「气泡不再有第二份刻度」成为可读出来的事实。

	   保留不动的三样：用户消息的 `.message-text`（#1443 纯文本逐字节不变）、
	   `.message-bubble` 外壳（max-width 600rpx / padding 20rpx 24rpx / 圆角 16rpx）、
	   以及 `.message-actions` —— 本票只换**正文块怎么排**，不碰外壳。 */
</style>
