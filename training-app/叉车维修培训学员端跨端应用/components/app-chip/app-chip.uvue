<template>
    <view class="app-chip" :class="{ 'app-chip--active': active }" @click="onClick">
        <text class="app-chip-text" :class="{ 'app-chip-text--active': active }">{{ text }}</text>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        text ?: string
        active ?: boolean
    }>(), {
        text: '',
        active: false
    })

    const emit = defineEmits(['click'])

    function onClick() : void {
        emit('click')
    }
</script>

<style lang="scss">
    /* 筛选标签（#979）：未选中 = 浅灰底次要字；选中 = 主色实底反白 —— 把色彩留给「当前档位」 */
    .app-chip {
        padding: 16rpx 32rpx;
        border-radius: $radius-pill;
        background-color: $bg-color;
    }

    .app-chip--active {
        background-color: $primary-color;
    }

    .app-chip-text {
        font-size: $font-size-sm;
        color: $text-color-secondary;
    }

    .app-chip-text--active {
        color: $text-color-inverse;
        font-weight: 600;
    }
</style>
