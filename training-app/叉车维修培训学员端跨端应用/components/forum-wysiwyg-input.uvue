<template>
    <!-- 论坛正文的**所见即所得输入区**（#2640 / ADR-0073）：发帖表单与回复浮层共用同一份形态。
         它被当作**输入法**而不是新内容格式 —— 编辑时是真富文本，对外只吐 T1 序列化后的论坛档 Markdown。
         三条边界（ADR-0073「三处共守」）在本组件里的落点：
           · 按钮集 = utils/forumWysiwygInput 的数据（常驻三键 + 二级面板两组），不多一枚论坛档渲染不出的按钮；
           · 序列化 = utils/forumDeltaMarkdown（delta → 论坛档 Markdown + 保真 issues）；
           · 保真提示 = 本组件把 issues 渲染成**持续可见**的一行（不是 toast）。
         图片只有下方单一 `＋` 入口：编辑器侧不提供插入入口，粘进正文的图片在序列化时丢弃并提示（R3）。 -->
    <view class="wysiwyg-input">
        <view class="editor-box">
            <!-- 重建（showEditor=false → true）只用于一条**显式**的恢复路径：粘贴写入失败且正文为空时
                 重建一次编辑器再写（#2658「失败后不可再聚焦」）。其余情况不重建 —— editor 的初始化
                 属性只在挂载时生效，把重建变成隐式副作用会丢正文。 -->
            <editor v-if="showEditor" id="forum-wysiwyg-editor" class="rich-editor"
                :class="isReply ? 'rich-editor-reply' : ''" :read-only="readOnly"
                :placeholder="placeholder" :show-img-size="false" :show-img-toolbar="false"
                :show-img-resize="false" @ready="onEditorReady" @focus="onEditorFocus"
                @blur="onEditorBlur" @input="onEditorInput" @statuschange="onStatusChange" />
        </view>

        <!-- 格式工具条（常驻三键 + 粘贴 + 二级面板）拆成独立件：它只渲染并 emit 动作，
             怎么落地由本组件按 editorCtx 决定（#2658 拆分，行数预算 ADR-0023）。 -->
        <ForumWysiwygToolbar :active-ids="activeIds" @action="onActionTap" @paste="onPasteTap" />

        <!-- 保真检查：序列化时被降级 / 被丢弃的项，**持续可见**（R3）。空串时不渲染。
             宿主可关掉本行自己渲染（#2641 发帖页要把它放到提交按钮附近，AC③）—— 两处只出现一次。 -->
        <text v-if="showFidelityNotice && fidelityNotice.length > 0" class="fidelity-notice">{{ fidelityNotice }}</text>

        <!-- 粘贴结果提示（持续可见直到正文变化）：降级 / 空剪贴板 / 读不到，三种都**不静默** -->
        <text v-if="pasteNotice.length > 0" class="paste-notice">{{ pasteNotice }}</text>

        <!-- 原生粘贴被丢弃后的提示：整行可点，点了就走「粘贴」按钮同一条路径 -->
        <view v-if="pasteHint.length > 0" class="paste-hint-row" @click="onPasteTap">
            <text class="paste-hint-text">{{ pasteHint }}</text>
        </view>

        <!-- 两条功能提示（ui-hints 的明确例外，别当装饰删）：属地披露 + Markdown 边界提示 -->
        <text v-if="showRegionNotice" class="region-notice">{{ regionNotice }}</text>
        <text class="boundary-notice">{{ boundaryNotice }}</text>

        <text v-if="!isReply" class="counter-text">{{ counterText }}</text>

        <!-- 图片区：**单一入口**（一个 `＋` 方块 → 系统选择器）。缩略图 key 用图片 URL 本身
             （上传 URL 是服务端毫秒时间戳命名、逐张串行上传 ⇒ 不会重复）。 -->
        <view v-if="showImages" class="image-row">
            <view v-for="(img, idx) in previewImages" :key="img" class="image-cell">
                <image class="image-thumb" :src="img" mode="aspectFill" @click="onPreviewImage(idx)" :webp="true" />
                <view class="image-remove" @click.stop="onRemoveImage(idx)">
                    <text class="image-remove-text">×</text>
                </view>
            </view>
            <view v-if="imageCount < maxImages" class="image-add" @click="onAddImage">
                <text class="image-add-icon">{{ uploading ? '…' : '＋' }}</text>
                <text v-if="variant != 'reply'" class="image-add-text">{{ uploading ? '上传中' : imageCounter }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed, onUnmounted } from 'vue'
    import { buildMarker, serializeDelta, settleMarkerInsert } from '../utils/forumDeltaMarkdown'
    import { FORUM_MARKDOWN_BOUNDARY_NOTICE, FORUM_REGION_NOTICE } from '../utils/forumDisplay'
    import ForumWysiwygToolbar from './forum-wysiwyg-toolbar.uvue'
    import {
        PASTE_HINT_AFTER_DROP,
        PASTE_HINT_MIN_FOCUS_MS,
        PASTE_NOTICE_DEGRADED,
        PASTE_NOTICE_EMPTY,
        PASTE_NOTICE_INSERT_FAILED,
        PASTE_NOTICE_UNREADABLE,
        normalizePastedText,
        shouldClearPasteNotice,
        shouldOfferPasteHint,
    } from '../utils/forumPaste'
    import {
        RICH_KIND_DIVIDER,
        RICH_KIND_MARKER,
        richActionById,
        richActiveFromDelta,
        richFidelityNotice,
    } from '../utils/forumWysiwygInput'
    import type { RichAction } from '../utils/forumWysiwygInput'

    /** editor 的 id 与 createEditorContextAsync 的 id 必须同值；一页只挂一个本组件（发帖页 / 回复浮层各一页）。 */
    const EDITOR_ID : string = 'forum-wysiwyg-editor'

    /** 两条功能提示的文案**单点**在 utils/forumDisplay（模板不直调 import 函数，先落局部标识）。 */
    const regionNotice : string = FORUM_REGION_NOTICE
    const boundaryNotice : string = FORUM_MARKDOWN_BOUNDARY_NOTICE
    /**
     * 失焦后只读态的最长保持时间（ms）。
     * 只读是为了保住选区让格式按钮生效，但它同时挡住「点编辑器重新聚焦」——
     * 一次被原生层丢弃的粘贴会让编辑器失焦，只读若一直挂着，作者就再也点不进去（#2658）。
     */
    const READONLY_HOLD_MS : number = 800

    const props = withDefaults(defineProps<{
        /** 已选图片的**预览 URL**（父层预解析；原始路径留在父层用于提交） */
        previewImages?: string[]
        /** 已选图片数量（只为限额判据，不读原始路径） */
        imageCount?: number
        /** 该面的图片限额。**必填**：限额唯一来源是 constants/app，组件不持第三个缺省值。 */
        maxImages: number
        /** 'topic'（发帖表单）/ 'reply'（底部回复栏）—— 两处形态差异只在这个 prop 上 */
        variant?: string
        maxlength?: number
        placeholder?: string
        showImages?: boolean
        showRegionNotice?: boolean
        /** 是否由本组件渲染保真提示行。宿主把它挪到别处（如提交按钮附近）时传 false，避免两处重复 */
        showFidelityNotice?: boolean
        uploading?: boolean
    }>(), {
        previewImages: () => [] as string[],
        imageCount: 0,
        variant: 'topic',
        maxlength: 10000,
        placeholder: '',
        showImages: true,
        showRegionNotice: true,
        showFidelityNotice: true,
        uploading: false
    })

    /**
     * 对外只吐两样：序列化后的 markdown 与保真检查结果（票面判据）。
     * 编辑态（delta / 选区 / 点亮）**不出组件** —— 那是输入法的内部状态，不是内容格式。
     */
    const emit = defineEmits<{
        (e: 'update:markdown', value: string): void
        (e: 'update:issues', value: string[]): void
        (e: 'add-image'): void
        (e: 'remove-image', index: number): void
        (e: 'preview-image', index: number): void
        /** 键盘高度（px）。宿主据此重定位（回复浮层的面板 bottom）；组件自身不加偏移，避免双重位移。 */
        (e: 'keyboard-height', height: number): void
    }>()

    const showEditor = ref<boolean>(true)
    /**
     * 失焦后置 true：保住编辑器选区，让「点格式按钮」不因失焦而丢选区。
     * 点按钮时把 format 推到下一个 tick 执行，执行完立刻恢复可编辑（票面判据的绕行路径）。
     */
    const readOnly = ref<boolean>(false)
    /** 点亮集合：**一律由 getContents 的 delta 推导**（statuschange 只是通知，不是事实源） */
    const activeIds = ref<string[]>([])
    const issues = ref<string[]>([])
    const markdownLength = ref<number>(0)
    /** 粘贴结果提示（持续可见直到正文变化）与其设置时刻（用于区分「粘贴自身那次 @input」） */
    const pasteNotice = ref<string>('')
    const pasteNoticeAt = ref<number>(0)
    /** 原生粘贴被丢弃后的提示行（空串 = 不渲染） */
    const pasteHint = ref<string>('')

    let editorCtx : EditorContext | null = null
    /**
     * 最近一次 getContents 拿到的 delta（JSON 串）。
     * 记号动作要在「写之前」的文档上做拼合（#2659：insertText 不删选区，得自己收敛），故必须缓存。
     */
    let lastDeltaJson : string = ''
    /** @某人 在 editor ready 之前点击时的暂存串（onEditorReady 后补写，避免丢失） */
    let pendingMention : string = ''
    /** 「粘贴」在 editor ready 之前点击时的暂存串（onEditorReady 后补写） */
    let pendingPasteText : string = ''
    /** 本次聚焦的起点时刻（判「这次失焦是不是一次粘贴尝试」） */
    let focusAt : number = 0
    /** 重建编辑器只试一次，避免 insertText 持续失败时来回重建 */
    let pasteRebuildTried : boolean = false

    const isReply = computed<boolean>(() : boolean => props.variant == 'reply')
    const fidelityNotice = computed<string>(() : string => richFidelityNotice(issues.value))
    const counterText = computed<string>(() : string => markdownLength.value.toString() + '/' + props.maxlength.toString())
    const imageCounter = computed<string>(() : string => props.imageCount.toString() + '/' + props.maxImages.toString())

    /**
     * 唯一的事实刷新点：getContents → 序列化 → 点亮集合。
     * input / statuschange / 每次按钮动作之后都走这里，于是「点亮」与「产物」永远同源。
     */
    function refreshFromEditor() : void {
        const ctx = editorCtx
        if (ctx == null) return
        ctx.getContents({
            success: (res) => {
                const deltaJson = JSON.stringify(res.delta)
                lastDeltaJson = deltaJson
                const result = serializeDelta(deltaJson)
                markdownLength.value = result.markdown.length
                issues.value = result.issues
                activeIds.value = richActiveFromDelta(deltaJson)
                emit('update:markdown', result.markdown)
                emit('update:issues', result.issues)
            }
        })
    }

    /** 拿到 ctx 后把暂存串写进去（onEditorReady 的 success 回调里调用） */
    function ctx_insertMentionText(ctx : EditorContext, text : string) : void {
        ctx.insertText({
            text: text,
            success: () => { refreshFromEditor() }
        })
    }

    function showPasteNotice(text : string) : void {
        pasteNotice.value = text
        pasteNoticeAt.value = Date.now()
    }

    /**
     * 把归一后的纯文本写进编辑器。
     *
     * 为什么绕开原生粘贴（#2658 根因）：uni-app x 的 editor 没有 paste 钩子，Android 原生层
     * 把 text/html 的 clipdata 整段丢弃（0 字、无 @input、无 statuschange）。insertText 与打字
     * 同一条路径 ⇒ 一定发 @input、一定进序列化，格式按 ADR-0073 修订口径整段降级为纯文本。
     */
    function insertPastedText(text : string) : void {
        const ctx = editorCtx
        if (ctx == null) {
            pendingPasteText = text
            return
        }
        if (readOnly.value) {
            setTimeout(() => {
                readOnly.value = false
                insertPastedText(text)
            }, 0)
            return
        }
        pasteHint.value = ''
        ctx.insertText({
            text: text,
            success: () => {
                pasteRebuildTried = false
                showPasteNotice(PASTE_NOTICE_DEGRADED)
                refreshFromEditor()
            },
            fail: () => {
                // 编辑器被原生层卡住（#2658 的「失败后不可再聚焦」）：正文为空时重建一次再写
                if (markdownLength.value == 0 && !pasteRebuildTried) {
                    pasteRebuildTried = true
                    pendingPasteText = text
                    editorCtx = null
                    showEditor.value = false
                    setTimeout(() => { showEditor.value = true }, 50)
                    return
                }
                showPasteNotice(PASTE_NOTICE_INSERT_FAILED)
            }
        })
    }

    /**
     * 失焦时判断「这次是不是一次被丢弃的粘贴」：正文为空 + 聚焦够久 + 剪贴板里有字。
     * 只提示、不自动插入 —— 自动插入会在「点进编辑器又点走」时凭空多出一段内容。
     */
    function detectDroppedPaste() : void {
        const focusedMs = focusAt > 0 ? Date.now() - focusAt : 0
        focusAt = 0
        if (markdownLength.value > 0) return
        if (focusedMs < PASTE_HINT_MIN_FOCUS_MS) return
        uni.getClipboardData({
            success: (res) => {
                const text = normalizePastedText(res.data)
                if (shouldOfferPasteHint(focusedMs, markdownLength.value, text.length)) {
                    pasteHint.value = PASTE_HINT_AFTER_DROP
                }
            },
            fail: () => {}
        })
    }

    /** 「粘贴」按钮：读剪贴板 → 归一成纯文本 → insertText（与打字同一条 content-change 路径） */
    function onPasteTap() : void {
        uni.getClipboardData({
            success: (res) => {
                const text = normalizePastedText(res.data)
                if (text.length == 0) {
                    showPasteNotice(PASTE_NOTICE_EMPTY)
                    return
                }
                insertPastedText(text)
            },
            fail: () => {
                showPasteNotice(PASTE_NOTICE_UNREADABLE)
            }
        })
    }

    function onEditorReady() : void {
        const options : CreateEditorContextAsyncOptions = {
            id: EDITOR_ID,
            success: (context : EditorContext) => {
                editorCtx = context
                if (pendingMention.length > 0) {
                    const text = pendingMention
                    pendingMention = ''
                    ctx_insertMentionText(context, text)
                }
                if (pendingPasteText.length > 0) {
                    const text = pendingPasteText
                    pendingPasteText = ''
                    context.insertText({
                        text: text,
                        success: () => {
                            showPasteNotice(PASTE_NOTICE_DEGRADED)
                            refreshFromEditor()
                        }
                    })
                }
                refreshFromEditor()
            },
            fail: (_error : UniError) => {}
        }
        uni.createEditorContextAsync(options)
    }

    function onEditorFocus() : void {
        readOnly.value = false
        focusAt = Date.now()
        pasteHint.value = ''
    }

    /**
     * 失焦：短暂置只读保住选区（点格式按钮不丢选区），随后**必须**放开。
     * 只读若一直挂着，一次被原生层丢弃的粘贴就会让编辑器再也点不进去（#2658）。
     */
    function onEditorBlur() : void {
        readOnly.value = true
        setTimeout(() => { readOnly.value = false }, READONLY_HOLD_MS)
        detectDroppedPaste()
    }

    function onEditorInput(_event : UniEditorInputEvent) : void {
        // 粘贴自身那次 @input 不能把刚设的提示清掉（TTL 内不清），之后任何正文变化都清
        if (shouldClearPasteNotice(pasteNoticeAt.value, Date.now())) {
            pasteNotice.value = ''
            pasteNoticeAt.value = 0
        }
        pasteHint.value = ''
        refreshFromEditor()
    }

    /**
     * statuschange 的 detail 是**累积快照**（一次带全部生效格式），且「没收到事件」不等于「没生效」。
     * 故这里不读 detail，只把它当「状态可能变了」的信号，事实仍取 delta。
     */
    function onStatusChange(_event : UniEditorStatusChangeEvent) : void {
        refreshFromEditor()
    }

    function applyAction(action : RichAction) : void {
        const ctx = editorCtx
        if (ctx == null) return
        if (action.kind == RICH_KIND_DIVIDER) {
            ctx.insertDivider({
                success: () => { refreshFromEditor() }
            })
            return
        }
        if (action.kind == RICH_KIND_MARKER) {
            // 记号逃生舱：有选区包裹选区、无选区插可替换模板；一律 insertText，不经 editor 的 link/code 属性。
            // 写之前先把文档快照下来 —— 收敛要靠它反推落点（insertText 不删选区，见 settleMarkerInsert）。
            const preDelta = lastDeltaJson
            ctx.getSelectionText({
                success: (res) => {
                    const selected = res.text
                    const text = buildMarker(action.id, selected)
                    if (text.length == 0) return
                    ctx.insertText({
                        text: text,
                        success: () => { settleMarkerInsert(ctx, preDelta, selected, text, refreshFromEditor) }
                    })
                }
            })
            return
        }
        // format(name, null) 是切换语义（对已应用样式的选区设置会取消样式）
        ctx.format(action.formatName, action.formatValue)
        setTimeout(() => { refreshFromEditor() }, 0)
    }

    function onActionTap(id : string) : void {
        const action = richActionById(id)
        if (action == null) return
        if (readOnly.value) {
            setTimeout(() => {
                applyAction(action)
                readOnly.value = false
            }, 0)
            return
        }
        applyAction(action)
    }

    function onAddImage() : void {
        emit('add-image')
    }

    function onRemoveImage(index : number) : void {
        emit('remove-image', index)
    }

    function onPreviewImage(index : number) : void {
        emit('preview-image', index)
    }

    /**
     * 供宿主写入「@某人」提名字串（#2642）。
     *
     * 为什么是 expose 方法而不是 prop/computed：@某人是由**已经发生的点击**驱动的一次性写入，
     * 不是状态的持续投影 —— 用 prop 驱动会让「点两次同一个人」因值未变而不触发。宿主在点击
     * 回调里取组件实例调本方法，走 editor 的 insertText 逃生舱（与记号同一条路径），插入后
     * 统一经 refreshFromEditor 回流，保真提示与序列化同源。
     *
     * 失焦时序：@某人 点击会让 editor 先 blur（readOnly=true），故与 onActionTap 同款绕行 ——
     * 延迟一个 tick 再 insertText，避免 readOnly 下的写入被吞。
     */
    function insertMention(name : string) : void {
        const ctx = editorCtx
        const text = '@' + name + ' '
        if (ctx == null) {
            pendingMention = text
            return
        }
        if (readOnly.value) {
            setTimeout(() => {
                ctx.insertText({
                    text: text,
                    success: () => { refreshFromEditor() }
                })
                readOnly.value = false
            }, 0)
            return
        }
        ctx.insertText({
            text: text,
            success: () => { refreshFromEditor() }
        })
    }

    defineExpose({ insertMention })

    /**
     * 键盘弹起：只**上报**高度，不在组件内加偏移 —— 回复浮层的面板 bottom 由宿主按同一个值驱动
     * （utils/replyPanelLayout.panelBottomPx），组件再加一份就是双重位移。
     */
    let keyboardAlive = true

    uni.onKeyboardHeightChange((res) => {
        if (keyboardAlive) emit('keyboard-height', res.height)
    })

    onUnmounted(() => {
        // 只关自己的回调：无参 `offKeyboardHeightChange()` 会把**宿主页**自己的监听一起摘掉
        // （forum-detail 的 keyboardTracker 就在同一个页面上），故这里用标志位让回调失效。
        keyboardAlive = false
    })
</script>

<style lang="scss">
    .wysiwyg-input {
        flex-direction: column;
    }

    .editor-box {
        flex-direction: column;
    }

    /* 编辑器本体：只放盒模型与底色。文字类样式（font-size / color）**不能**落在这里 ——
       uvue 只把它们认给 <text>|<button>|<input>|<textarea>，落在 <editor> 上会被判错并忽略
       （机检 utils/uvueFontCarrierContract.test.js）。 */
    .rich-editor {
        height: 400rpx;
        background-color: #f8f9fa;
        border-radius: 12rpx;
        padding: 24rpx;
        border: 1rpx solid #e0e0e0;
    }

    /* 回复栏里比发帖矮一档，别把回复栏顶到半屏 */
    .rich-editor-reply {
        height: 220rpx;
        padding: 16rpx;
    }

    /* ===== 保真检查提示（持续可见，R3）===== */
    .fidelity-notice {
        font-size: 22rpx;
        color: #e6a23c;
        margin-top: 12rpx;
    }

    /* ===== 粘贴结果提示（#2658：降级 / 空剪贴板 / 读不到，三种都不静默）===== */
    .paste-notice {
        font-size: 22rpx;
        color: #e6a23c;
        margin-top: 12rpx;
    }

    /* 原生粘贴被丢弃后的提示行：整行可点，走「粘贴」按钮同一条路径 */
    .paste-hint-row {
        margin-top: 12rpx;
        padding: 12rpx 16rpx;
        border-radius: 12rpx;
        background-color: #fdf6ec;
        border: 1rpx solid #f5dab1;
    }

    .paste-hint-text {
        font-size: 22rpx;
        color: #e6a23c;
    }

    /* ===== 功能提示（两条都是 ui-conventions 的明确例外，别当装饰删）===== */
    .region-notice {
        font-size: 22rpx;
        color: #999999;
        margin-top: 12rpx;
    }

    .boundary-notice {
        font-size: 22rpx;
        color: #999999;
        margin-top: 8rpx;
    }

    .counter-text {
        font-size: 22rpx;
        color: #999999;
        text-align: right;
        margin-top: 8rpx;
    }

    /* ===== 图片区 ===== */
    .image-row {
