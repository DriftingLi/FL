<template>
    <view class="app-tabs">
        <view v-for="(tab, idx) in tabs" :key="idx"
            :class="{ 'app-tab-item': true, 'ml-16': idx > 0, 'app-tab-item--active': activeIndex == idx }" @click="onChange(idx)">
            <text class="app-tab-text" :class="{ 'app-tab-text--active': activeIndex == idx }">{{ tab }}</text>
            <view v-if="activeIndex == idx && style == 'underline'" class="app-tab-underline"></view>
        </view>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        tabs ?: string[]
        activeIndex ?: number
        style ?: string
    }>(), {
        tabs: () => [],
        activeIndex: 0,
        style: 'underline'
    })

    const emit = defineEmits(['change'])

    function onChange(idx : number) : void {
        emit('change', idx)
    }
</script>

<style lang="scss">
    .app-tabs {
        flex-direction: row;
    }

    .app-tab-item {
        flex-direction: column;
        align-items: center;
        padding: 12rpx 0;
    }

    .app-tab-text {
        font-size: $font-size-md;
        color: $text-color-secondary;
    }

    /* #2509 R2 冲突 11：选中文字改深色（原型 322:9139 = #333333 16px w500），色彩让给指示条；
     * 指示条 = 20×4rpx、R=10（$radius-sm 之外的独立几何，故直接写 rpx）。 */
    .app-tab-text--active {
        color: $text-color;
        font-weight: 500;
    }

    .app-tab-underline {
        width: 20rpx;
        height: 4rpx;
        background-color: $segment-indicator;
        border-radius: 2rpx;
        margin-top: 8rpx;
    }

    .ml-16 { margin-left: 16rpx; }
</style>
