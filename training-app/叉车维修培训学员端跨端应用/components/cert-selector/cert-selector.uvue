<template>
    <!-- 证件选择器（共享领域件，#1395）——**内嵌形态唯一**（#2907）
         浮层形态（遮罩 / 状态栏 / 标题栏 / 省份胶囊 / 自带「完成」条）、以及只为它存在的
         embedded / province / showProvince / confirmable / belowNavBar / topInset 六个开关整体退役：
         证件选择只剩「选择学习阶段」整页一条路径，本件不再需要第二个宿主。
         纯选择器：只 emit 选中项，不发请求、不落库（动作时机归页面，#1379 裁定⑥）。 -->
    <view class="cert-selector">
        <!-- 滚动面：吃满宿主给的内容区（页面不再另套一层 scroll-view ⇒ 无双滚动面） -->
        <scroll-view scroll-y class="cert-selector-scroll">
            <view v-for="(group, gIdx) in groups" :key="gIdx" class="cert-selector-section">
                <!-- 分组标题 -->
                <view class="cert-selector-section-header">
                    <view class="cert-selector-section-icon-wrap"
                        :style="{ backgroundColor: group.category === 'skill_level' ? '#E8F5E9' : '#FFF3E0' }">
                        <!-- 票 2730 docx ①：emoji 换成设计稿 3D 图标（技能等级证=叉车，特种作业=扳手） -->
                        <image class="cert-selector-section-icon"
                            :src="group.category === 'skill_level' ? '/static/icons/home/cert-vehicle.png' : '/static/icons/home/cert-tool.png'"></image>
                    </view>
                    <text class="cert-selector-section-title">{{ group.group_name }}</text>
                </view>
                <!-- 胶囊标签（等宽网格：同组胶囊平分一行，与设计稿 324_9793 一致） -->
                <view class="cert-selector-chips">
                    <view v-for="(item, idx) in group.items" :key="idx" class="cert-selector-chip mb-16"
                        :class="{ 'cert-selector-chip--active': currentId === item.id, 'cert-selector-chip--last': idx === group.items.length - 1 }"
                        @click="onSelect(item)">
                        <!-- 单行（特种作业证） -->
                        <view v-if="item.level == null" class="cert-selector-chip-single">
                            <text class="cert-selector-chip-text"
                                :class="{ 'cert-selector-chip-text--active': currentId === item.id }">{{ item.name }}</text>
                        </view>
                        <!-- 双行（技能等级证）：上行等级、下行俗称（设计稿两行都在） -->
                        <view v-else class="cert-selector-chip-double">
                            <text class="cert-selector-chip-level"
                                :class="{ 'cert-selector-chip-text--active': currentId === item.id }">{{ levelNames[item.level!.toString()] }}</text>
                            <text class="cert-selector-chip-desc"
                                :class="{ 'cert-selector-chip-desc--active': currentId === item.id }">{{ levelAlias[item.level!.toString()] }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 热门考证 -->
            <view class="cert-selector-section">
                <view class="cert-selector-hot-header">
                    <text class="cert-selector-hot-title">热门考证</text>
                    <view class="cert-selector-hot-line"></view>
                </view>
                <view class="cert-selector-hot-grid">
                    <view v-for="(item, idx) in hotCertList" :key="idx" class="cert-selector-hot-card"
                        :class="idx > 0 ? 'ml-16' : ''">
                        <!-- 票 2730 docx ①：⭐ emoji 换成设计稿左上角黄色四角星 -->
                        <image class="cert-selector-hot-card-star" src="/static/icons/home/star-hot.png"></image>
                        <text class="cert-selector-hot-card-title">{{ item.title }}</text>
                        <text class="cert-selector-hot-card-desc">{{ item.desc }}</text>
                    </view>
                </view>
            </view>

            <!-- 热门考证详情说明（设计稿里这块是灰底卡片，其余区块直接铺白） -->
            <view class="cert-selector-section cert-selector-detail-card">
                <view v-for="(item, idx) in hotCertDetails" :key="idx" class="cert-selector-detail-item">
                    <view class="cert-selector-detail-title-row">
                        <text class="cert-selector-detail-bullet">✦</text>
                        <text class="cert-selector-detail-title">{{ item.title }}</text>
                    </view>
                    <text class="cert-selector-detail-content">{{ item.content }}</text>
                </view>
            </view>

            <!-- 底部留白 -->
            <view style="height: 48rpx;"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import type { CredentialGroup, CredentialItem } from '../../types/index'

    const props = withDefaults(defineProps<{
        groups? : CredentialGroup[]
        currentId? : number
    }>(), {
        groups: () => [] as CredentialGroup[],
        currentId: 0
    })

    // #2907：emit 收窄为纯选择（close / confirm / provinceTap 随浮层一并退役）
    const emit = defineEmits(['select'])

    // 等级数字转中文（全仓唯一抄本，随组件从 dashboard 搬来，#1395）
    const levelNames : UTSJSONObject = {
        '5': '五级',
        '4': '四级',
        '3': '三级',
        '2': '二级',
        '1': '一级',
    }

    // 等级俗称（设计稿胶囊第二行：五级/初级、四级/中级…；与 levelNames 同源同抄本）
    const levelAlias : UTSJSONObject = {
        '5': '初级',
        '4': '中级',
        '3': '高级',
        '2': '技师',
        '1': '高级技师',
    }

    // ---- 热门考证（静态数据，全仓唯一抄本） ----
    type HotCertItem = {
        title : string
        desc : string
    }

    const hotCertList : HotCertItem[] = [
        { title: '入门组合', desc: '工程机械维修工（初级）+ 叉车N1证' },
        { title: '电动叉车维修优选', desc: '工程机械维修工+N1司机证+低压电工证' },
    ]

    type HotCertDetail = {
        title : string
        content : string
    }

    const hotCertDetails : HotCertDetail[] = [
        {
            title: '1、工程机械机械维修工（初级）',
            content: '叉车证N1代表叉车车辆维修，N1是场内专用机动车辆作业叉车司机上岗证，N1是场内专用机动车辆叉车司机资格证，在早期，叉车证N1可以驾驶任何吨位的叉车。'
        },
        {
            title: '2、叉车N1证',
            content: '叉车证N1代表叉车车辆维修，N1是场内专用机动车辆作业叉车司机上岗证，N1是场内专用机动车辆叉车司机资格证，在早期，叉车证N1可以驾驶任何吨位的叉车。'
        }
    ]

    function onSelect(item : CredentialItem) : void {
        emit('select', item)
    }
</script>

<style lang="scss">
    /* ===== 证件选择器（唯一形态：内嵌在「选择学习阶段」整页里） ===== */
    .cert-selector {
        flex: 1;
        flex-direction: column;
        background-color: #FFFFFF;
    }

    /* 滚动面：高度由宿主的内容区决定（页面级滚动在组件内这一层发生） */
    .cert-selector-scroll {
        flex: 1;
    }

    /* ---- 分组区块（设计稿里区块直接铺白，只有说明块是灰底卡） ---- */
    /* #2906：区块之间 16rpx 太挤，按 24rpx 一档拉开（同页 32rpx 版心让给左右内距） */
    .cert-selector-section {
        margin: 24rpx 32rpx 0;
        background-color: transparent;
    }

    .cert-selector-detail-card {
        margin: 24rpx 32rpx 0;
        padding: 32rpx;
        background-color: $bg-color;
        border-radius: 16rpx;
    }

    .cert-selector-section-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 20rpx;
    }

    .cert-selector-section-icon-wrap {
        width: 48rpx;
        height: 48rpx;
        border-radius: 12rpx;
        align-items: center;
        justify-content: center;
        margin-right: 12rpx;
    }

    /* 票 2730 docx ①：分组图标按 Figma 元数据取（机械臂 20x24 / 叉车 23x24），盒取 48rpx 高 */
    .cert-selector-section-icon {
        width: 48rpx;
        height: 48rpx;
    }

    .cert-selector-section-title {
        font-size: 28rpx;
        font-weight: 600;
        color: #222222;
        flex: 1;
    }

    /* ---- 胶囊标签（等宽网格：同组胶囊平分一行） ---- */
    .cert-selector-chips {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .cert-selector-chip {
        flex: 1;
        margin-right: 16rpx;
        padding: 18rpx 12rpx;
        background-color: $bg-color;
        border-radius: 40rpx;
        align-items: center;
        justify-content: center;
    }

    .cert-selector-chip--last {
        margin-right: 0;
    }

    .cert-selector-chip--active {
        background-color: $primary-tint;
    }

    /* 单行（特种作业证） */
    .cert-selector-chip-single {
        align-items: center;
        justify-content: center;
    }

    .cert-selector-chip-text {
        font-size: 28rpx;
        color: #444444;
    }

    .cert-selector-chip-text--active {
        color: $primary-color;
        font-weight: 600;
    }

    /* 双行（技能等级证） */
    .cert-selector-chip-double {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 100rpx;
    }

    .cert-selector-chip-level {
        font-size: 28rpx;
        font-weight: 600;
        color: #444444;
        margin-bottom: 2rpx;
    }

    .cert-selector-chip-desc {
        font-size: 22rpx;
        color: #888888;
    }

    .cert-selector-chip-desc--active {
        color: $primary-color;
    }

    /* ---- 热门考证标题 ---- */
    /* #2906：标题左对齐，与「特种作业配套上岗证」等板块标题同一条左起线（原居中）。 */
    /* align-self: flex-start 让列容器贴标题文字宽 —— 这是线宽跟随文字的前提，
       缺失时容器被父级 stretch 撑满区块，线里的 width: 100% 就会解析成区块全宽。 */
    .cert-selector-hot-header {
        flex-direction: column;
        align-items: flex-start;
        align-self: flex-start;
        margin-bottom: 20rpx;
    }

    /* #2906：30rpx 不在字号阶梯上（20/24/28/32/36），取 $font-size-lg 与板块标题 $font-size-md 拉开一档 */
    .cert-selector-hot-title {
        font-size: $font-size-lg;
        font-weight: 600;
        color: #222222;
    }

    /* 票 2730 docx ①：Figma 里线宽 20px、在 64px 标题下居中（Rectangle 38 x=22 w=20）⇒ 40rpx */
    /* 票 2827 + #2906：线宽跟标题文字等宽（列容器已由 align-self 贴文字宽），高度保持 6rpx。 */
    .cert-selector-hot-line {
        width: 100%;
        height: 6rpx;
        border-radius: 3rpx;
        background-color: $primary-color;
        margin-top: 8rpx;
    }

    /* ---- 热门考证卡片 ---- */
    .cert-selector-hot-grid {
        flex-direction: row;
    }

    /* 票 2730 docx ①：参考图一 —— 浅蓝→中蓝渐变、大圆角、文字居中、左上角四角星 */
    /* #2906：上下内距统一 32rpx，两张卡的标题/副标题不再被 24rpx 的下内距压扁 */
    .cert-selector-hot-card {
        flex: 1;
        position: relative;
        align-items: center;
        padding: 32rpx 16rpx;
        background: linear-gradient(to bottom right, #6ECCFC, #0FA5F1);
        background-color: #0FA5F1;
        border-radius: 20rpx;
    }

    /* 票 2730 docx ①：Figma 里星 20x20（Frame 337 x=4 y=0）⇒ 40rpx */
    .cert-selector-hot-card-star {
        position: absolute;
        top: 10rpx;
        left: 10rpx;
        width: 40rpx;
        height: 40rpx;
    }

    .cert-selector-hot-card-title {
        font-size: 26rpx;
        font-weight: 600;
        color: #FFFFFF;
        text-align: center;
    }

    .cert-selector-hot-card-desc {
        font-size: 20rpx;
        color: rgba(255, 255, 255, 0.85);
        text-align: center;
        lines: 2;
        text-overflow: ellipsis;
    }

    /* ---- 热门考证详情说明 ---- */
    .cert-selector-detail-item {
        margin-bottom: 20rpx;
    }

    /* uvue 原生端不支持 last-child 伪类；末项收尾由内容区底部留白承担 */

    .cert-selector-detail-title-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 8rpx;
    }

    .cert-selector-detail-bullet {
        font-size: 24rpx;
        color: $primary-color;
        margin-right: 8rpx;
    }

    .cert-selector-detail-title {
        font-size: 26rpx;
        font-weight: 600;
        color: #222222;
    }

    .cert-selector-detail-content {
        font-size: 22rpx;
        color: #666666;
        line-height: 36rpx;
        padding-left: 32rpx;
    }

    /* ---- 间距工具类（替代 gap） ---- */
    .ml-16 { margin-left: 16rpx; }
    .mb-16 { margin-bottom: 16rpx; }
</style>
