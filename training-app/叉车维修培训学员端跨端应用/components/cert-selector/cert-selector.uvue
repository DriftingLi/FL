<template>
    <!-- 证件选择器（共享领域件，#1395）——原 dashboard-cert-dropdown 提升搬家：
         dashboard 证件下拉与引导页 choose-cert 共挂同一件，消灭「同一 UI 抄两份」。
         纯选择器：只 emit 选中项，不发请求、不落库（动作时机是页面的事，#1379 裁定⑥）。
         embedded=true 时为页面内嵌形态（无遮罩/标题/关闭，宿主页面自给导航）；默认仍是下拉浮层。 -->
    <view :class="embedded ? 'cert-selector-embed' : 'cert-dropdown-mask'" :style="{ top: maskTop + 'px' }"
        @click="onMaskTap">
        <view :class="embedded ? 'cert-selector-panel' : 'cert-dropdown'" @click.stop>
            <!-- 状态栏占位（仅浮层形态）：面板现在铺满全屏，标题栏必须让开系统时钟；
                 内嵌形态由宿主页面自己给占位，这里不重复。宿主给了 topInset（面板从页头下方起）时不需要。 -->
            <view v-if="!embedded && !belowNavBar" class="cert-dropdown-statusbar" :style="{ height: statusBarHeight + 'px' }"></view>
            <!-- 标题栏（仅浮层形态；内嵌形态由宿主页面的导航栏承担标题） -->
            <view v-if="!embedded" class="cert-dropdown-header">
                <text class="cert-dropdown-title">选择学习阶段</text>
                <view class="cert-dropdown-close" @click="onClose">
                    <text class="cert-dropdown-close-icon">✕</text>
                </view>
            </view>
            <!-- 报考省份胶囊（仅浮层形态 + 宿主开启）：与 choose-cert 主态同源，
                 浮层即「整页选证态」——省份 + 分组 + 热门考证 + 完成（#2535 设计稿 324_9793） -->
            <view v-if="!embedded && showProvince" class="cert-dropdown-province" @click="onProvinceTap">
                <text class="cert-dropdown-province-pin">📍</text>
                <text class="cert-dropdown-province-label">报考省份：</text>
                <text class="cert-dropdown-province-value">{{ province }}</text>
            </view>
            <!-- 两种形态共用同一个 scroll-view，只换容器 class：浮层限高自滚（max-height），
                 内嵌面 `flex: 1` 吃满宿主给的内容区 ⇒ 不出现「scroll-view 套 scroll-view」的双滚动面。 -->
            <scroll-view scroll-y :class="embedded ? 'cert-selector-scroll' : 'cert-dropdown-scroll'">
                <view v-for="(group, gIdx) in groups" :key="gIdx" class="cert-dropdown-section">
                    <!-- 分组标题 -->
                    <view class="cert-dropdown-section-header">
                        <view class="cert-dropdown-section-icon-wrap"
                            :style="{ backgroundColor: group.category === 'skill_level' ? '#E8F5E9' : '#FFF3E0' }">
                            <text class="cert-dropdown-section-icon">{{ group.icon }}</text>
                        </view>
                        <text class="cert-dropdown-section-title">{{ group.group_name }}</text>
                    </view>
                    <!-- 胶囊标签（等宽网格：同组胶囊平分一行，与设计稿 324_9793 一致） -->
                    <view class="cert-dropdown-chips">
                        <view v-for="(item, idx) in group.items" :key="idx" class="cert-dropdown-chip mb-16"
                            :class="{ 'cert-dropdown-chip--active': currentId === item.id, 'cert-dropdown-chip--last': idx === group.items.length - 1 }"
                            @click="onSelect(item)">
                            <!-- 单行（特种作业证） -->
                            <view v-if="item.level == null" class="cert-dropdown-chip-single">
                                <text class="cert-dropdown-chip-text"
                                    :class="{ 'cert-dropdown-chip-text--active': currentId === item.id }">{{ item.name }}</text>
                            </view>
                            <!-- 双行（技能等级证）：上行等级、下行俗称（设计稿两行都在） -->
                            <view v-else class="cert-dropdown-chip-double">
                                <text class="cert-dropdown-chip-level"
                                    :class="{ 'cert-dropdown-chip-text--active': currentId === item.id }">{{ levelNames[item.level!.toString()] }}</text>
                                <text class="cert-dropdown-chip-desc"
                                    :class="{ 'cert-dropdown-chip-desc--active': currentId === item.id }">{{ levelAlias[item.level!.toString()] }}</text>
                            </view>
                        </view>
                    </view>
                </view>

                <!-- 热门考证 -->
                <view class="cert-dropdown-section">
                    <view class="cert-dropdown-hot-header">
                        <text class="cert-dropdown-hot-title">热门考证</text>
                        <view class="cert-dropdown-hot-line"></view>
                    </view>
                    <view class="cert-dropdown-hot-grid">
                        <view v-for="(item, idx) in hotCertList" :key="idx" class="cert-dropdown-hot-card"
                            :class="idx > 0 ? 'ml-16' : ''">
                            <view class="cert-dropdown-hot-card-header">
                                <text class="cert-dropdown-hot-card-star">⭐</text>
                                <text class="cert-dropdown-hot-card-title">{{ item.title }}</text>
                            </view>
                            <text class="cert-dropdown-hot-card-desc">{{ item.desc }}</text>
                        </view>
                    </view>
                </view>

                <!-- 热门考证详情说明（设计稿里这块是灰底卡片，其余区块直接铺白） -->
                <view class="cert-dropdown-section cert-dropdown-detail-card">
                    <view v-for="(item, idx) in hotCertDetails" :key="idx" class="cert-dropdown-detail-item">
                        <view class="cert-dropdown-detail-title-row">
                            <text class="cert-dropdown-detail-bullet">✦</text>
                            <text class="cert-dropdown-detail-title">{{ item.title }}</text>
                        </view>
                        <text class="cert-dropdown-detail-content">{{ item.content }}</text>
                    </view>
                </view>

                <!-- 底部留白 -->
                <view style="height: 48rpx;"></view>
            </scroll-view>
            <!-- 底部完成条（仅浮层形态 + 宿主开启）：点「完成」才落库，关闭面板不改证件 -->
            <view v-if="!embedded && confirmable" class="cert-dropdown-footer">
                <view class="cert-dropdown-confirm" @click="onConfirm">
                    <text class="cert-dropdown-confirm-text">完成</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import type { CredentialGroup, CredentialItem } from '../../types/index'
    import { computed } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'

    // 浮层形态铺满全屏后，标题栏要让开系统状态栏（内嵌形态由宿主页面的导航栏承担，不消费它）
    const statusBarHeight = useStatusBarHeight()

    const props = withDefaults(defineProps<{
        groups? : CredentialGroup[]
        currentId? : number
        /** 内嵌形态（引导页）：不渲染遮罩/标题栏/关闭，由宿主页面承担导航 */
        embedded? : boolean
        /** 报考省份回显值（仅浮层形态 + showProvince 时渲染） */
        province? : string
        /** 浮层形态是否渲染报考省份胶囊（dashboard 证件面板 = 整页选证态，#2535） */
        showProvince? : boolean
        /** 浮层形态是否渲染底部「完成」条（点完成才落库，关闭不改证件） */
        confirmable? : boolean
        /** 浮层是否从页头下方起（宿主页头保持可见，设计稿 324_9793）。
         *  页头高度 = 状态栏 + 88rpx 导航条；rpx→px 手算（`uni.upx2px` 在 uvue 原生端不可用）。 */
        belowNavBar? : boolean
    }>(), {
        groups: () => [] as CredentialGroup[],
        currentId: 0,
        embedded: false,
        province: '',
        showProvince: false,
        confirmable: false,
        belowNavBar: false
    })

    const maskTop = computed((): number => {
        if (!props.belowNavBar) return 0
        return statusBarHeight.value + Math.round(88 * uni.getSystemInfoSync().windowWidth / 750)
    })

    const emit = defineEmits(['close', 'select', 'confirm', 'provinceTap'])

    // 等级数字转中文（全仓唯一抄本，随组件从 dashboard 搬来，#1395）
    const levelNames : UTSJSONObject = {
        '5': '五级',
        '4': '四级',
        '3': '三级',
        '2': '二级',
        '1': '一级',
    }

    // 等级俗称（设计稿胶囊第二行：五级/初级、四级/中级…；与 levelNames 同源同抄本）
    const levelAlias : UTSJSONObject = {
        '5': '初级',
        '4': '中级',
        '3': '高级',
        '2': '技师',
        '1': '高级技师',
    }

    // ---- 热门考证（静态数据，全仓唯一抄本） ----
    type HotCertItem = {
        title : string
        desc : string
    }

    const hotCertList : HotCertItem[] = [
        { title: '入门组合', desc: '工程机械维修工（初级）+ 叉车N1证' },
        { title: '电动叉车维修优选', desc: '工程机械维修工+N1司机证+低压电工证' },
    ]

    type HotCertDetail = {
        title : string
        content : string
    }

    const hotCertDetails : HotCertDetail[] = [
        {
            title: '1、工程机械机械维修工（初级）',
            content: '叉车证N1代表叉车车辆维修，N1是场内专用机动车辆作业叉车司机上岗证，N1是场内专用机动车辆叉车司机资格证，在早期，叉车证N1可以驾驶任何吨位的叉车。'
        },
        {
            title: '2、叉车N1证',
            content: '叉车证N1代表叉车车辆维修，N1是场内专用机动车辆作业叉车司机上岗证，N1是场内专用机动车辆叉车司机资格证，在早期，叉车证N1可以驾驶任何吨位的叉车。'
        }
    ]

    /** 遮罩点击只在浮层形态生效；内嵌形态根 view 不铺满屏幕，无「点外部关闭」语义 */
    function onMaskTap() : void {
        if (!props.embedded) {
            emit('close')
        }
    }

    function onClose() : void {
        emit('close')
    }

    function onSelect(item : CredentialItem) : void {
        emit('select', item)
    }

    /** 省份胶囊点击：选择逻辑归宿主（本件只回抛事件，不持省份状态） */
    function onProvinceTap() : void {
        emit('provinceTap')
    }

    /** 底部「完成」：只回抛事件，落库时机与失败回滚归宿主（#1379 裁定⑥） */
    function onConfirm() : void {
        emit('confirm')
    }
</script>

<style lang="scss">
    /* ===== 证件选择器（浮层形态 = 原「选择学习阶段」下拉；内嵌形态只换外层壳，条目形态同源） ===== */
    /* 内嵌形态（引导页）：吃满宿主给的内容区，自身不定位、不铺满屏幕 */
    .cert-selector-embed {
        flex: 1;
        flex-direction: column;
    }

    /* 内嵌面板：去灰底/圆角/阴影（宿主页面自己成卡），内容仍按浮层同款分组渲染 */
    .cert-selector-panel {
        flex: 1;
        flex-direction: column;
        background-color: #FFFFFF;
    }

    /* 内嵌滚动面：高度由宿主的内容区决定（页面级滚动在组件内这一层发生） */
    .cert-selector-scroll {
        flex: 1;
    }

    .cert-dropdown-mask {
        /* mp-weixin 组件内 position:fixed 全屏遮罩不绘制（#1671，#1650 取证）：改 absolute
           锚定宿主 .container（页面级 .filter-mask 同构先例）；铺满+遮罩+点击关闭语义不变 */
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 300;
        background-color: rgba(0, 0, 0, 0.4);
        justify-content: flex-start;
    }

    /* ---- 浮层形态：铺满状态栏以下的整屏。原 `max-height: 800rpx` 把面板截在屏高约 48%
       处，下半屏露出被遮罩压暗的首页、卡片切一半 —— 真机回看判为难看（#1401 追加修正） ---- */
    .cert-dropdown-statusbar {
        background-color: #FFFFFF;
    }

    .cert-dropdown {
        flex: 1;
        flex-direction: column;
        background-color: #FFFFFF;
        border-top-left-radius: 28rpx;
        border-top-right-radius: 28rpx;
    }

    .cert-dropdown-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 28rpx 32rpx;
        background-color: #FFFFFF;
    }

    /* ---- 报考省份胶囊（浮层形态 + 宿主开启；与 choose-cert 主态同源） ---- */
    .cert-dropdown-province {
        flex-direction: row;
        align-items: center;
        margin: 0 32rpx 8rpx;
        padding: 14rpx 24rpx;
        background-color: #F0F2F5;
        border-radius: 40rpx;
        align-self: flex-start;
    }

    .cert-dropdown-province-pin {
        font-size: 26rpx;
        margin-right: 8rpx;
    }

    .cert-dropdown-province-label {
        font-size: 26rpx;
        color: #888888;
    }

    .cert-dropdown-province-value {
        font-size: 26rpx;
        color: #222222;
        font-weight: 500;
    }

    .cert-dropdown-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    .cert-dropdown-close {
        width: 48rpx;
        height: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .cert-dropdown-close-icon {
        font-size: 32rpx;
        color: #999999;
    }

    .cert-dropdown-scroll {
        flex: 1;
    }

    /* ---- 分组区块（设计稿里区块直接铺白，只有说明块是灰底卡） ---- */
    .cert-dropdown-section {
        margin: 16rpx 32rpx 0;
        background-color: transparent;
    }

    .cert-dropdown-detail-card {
        margin: 24rpx 32rpx 0;
        padding: 24rpx;
        background-color: $bg-color;
        border-radius: 16rpx;
    }

    .cert-dropdown-section-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 20rpx;
    }

    .cert-dropdown-section-icon-wrap {
        width: 48rpx;
        height: 48rpx;
        border-radius: 12rpx;
        align-items: center;
        justify-content: center;
        margin-right: 12rpx;
    }

    .cert-dropdown-section-icon {
        font-size: 28rpx;
    }

    .cert-dropdown-section-title {
        font-size: 28rpx;
        font-weight: 600;
        color: #222222;
        flex: 1;
    }

    /* ---- 胶囊标签（等宽网格：同组胶囊平分一行） ---- */
    .cert-dropdown-chips {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .cert-dropdown-chip {
        flex: 1;
        margin-right: 16rpx;
        padding: 18rpx 12rpx;
        background-color: $bg-color;
        border-radius: 40rpx;
        align-items: center;
        justify-content: center;
    }

    .cert-dropdown-chip--last {
        margin-right: 0;
    }

    .cert-dropdown-chip--active {
        background-color: $primary-tint;
    }

    /* 单行（特种作业证） */
    .cert-dropdown-chip-single {
        align-items: center;
        justify-content: center;
    }

    .cert-dropdown-chip-text {
        font-size: 28rpx;
        color: #444444;
    }

    .cert-dropdown-chip-text--active {
        color: $primary-color;
        font-weight: 600;
    }

    /* 双行（技能等级证） */
    .cert-dropdown-chip-double {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 100rpx;
    }

    .cert-dropdown-chip-level {
        font-size: 28rpx;
        font-weight: 600;
        color: #444444;
        margin-bottom: 2rpx;
    }

    .cert-dropdown-chip-desc {
        font-size: 22rpx;
        color: #888888;
    }

    .cert-dropdown-chip-desc--active {
        color: $primary-color;
    }

    /* ---- 热门考证标题 ---- */
    .cert-dropdown-hot-header {
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 20rpx;
    }

    .cert-dropdown-hot-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #222222;
    }

    .cert-dropdown-hot-line {
        width: 56rpx;
        height: 6rpx;
        border-radius: 3rpx;
        background-color: $primary-color;
        margin-top: 8rpx;
    }

    /* ---- 热门考证卡片 ---- */
    .cert-dropdown-hot-grid {
        flex-direction: row;
    }

    .cert-dropdown-hot-card {
        flex: 1;
        padding: 20rpx 16rpx;
        background: linear-gradient(to bottom right, $primary-color, #1565C0);
        background-color: #1565C0;
        border-radius: 12rpx;
    }

    .cert-dropdown-hot-card-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 8rpx;
    }

    .cert-dropdown-hot-card-star {
        font-size: 24rpx;
        margin-right: 6rpx;
    }

    .cert-dropdown-hot-card-title {
        flex: 1;
        font-size: 26rpx;
        font-weight: 600;
        color: #FFFFFF;
    }

    .cert-dropdown-hot-card-desc {
        font-size: 20rpx;
        color: rgba(255, 255, 255, 0.85);
        lines: 2;
        text-overflow: ellipsis;
    }

    /* ---- 热门考证详情说明 ---- */
    .cert-dropdown-detail-item {
        margin-bottom: 20rpx;
    }

    /* uvue 原生端不支持 last-child 伪类；末项收尾由内容区底部留白承担 */

    .cert-dropdown-detail-title-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 8rpx;
    }

    .cert-dropdown-detail-bullet {
        font-size: 24rpx;
        color: $primary-color;
        margin-right: 8rpx;
    }

    .cert-dropdown-detail-title {
        font-size: 26rpx;
        font-weight: 600;
        color: #222222;
    }

    .cert-dropdown-detail-content {
        font-size: 22rpx;
        color: #666666;
        line-height: 36rpx;
        padding-left: 32rpx;
    }

    /* ---- 底部完成条（浮层形态 + 宿主开启）：白底压住滚动内容，按钮 96rpx 胶囊 ---- */
    .cert-dropdown-footer {
        padding: 20rpx 32rpx 40rpx;
        background-color: #FFFFFF;
    }

    .cert-dropdown-confirm {
        height: 96rpx;
        border-radius: 48rpx;
        background: linear-gradient(to bottom right, $primary-color, #1565C0);
        background-color: #1565C0;
        align-items: center;
        justify-content: center;
    }

    .cert-dropdown-confirm-text {
        font-size: 32rpx;
        font-weight: 600;
        color: #FFFFFF;
    }

    /* ---- 间距工具类（替代 gap） ---- */
    .ml-16 { margin-left: 16rpx; }
    .mr-16 { margin-right: 16rpx; }
    .mb-16 { margin-bottom: 16rpx; }
</style>
