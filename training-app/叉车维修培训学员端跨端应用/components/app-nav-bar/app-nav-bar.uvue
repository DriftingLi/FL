<template>
    <view class="nav-bar" :class="[navBgClass, { 'nav-bar--transparent': transparent, 'nav-bar--divider': divider }]">
        <view class="status-bar" :class="statusBarBgClass" :style="{ height: safeArea.statusBarHeight + 'px' }"></view>
        <view class="nav-bar-body">
            <view class="nav-bar-side nav-bar-left" :class="{ 'nav-bar-side--front': centerTitle }"
                @click="onLeftClick">
                <text v-if="leftIcon.length > 0" class="nav-bar-icon" :class="titleColorClass">{{ leftIcon }}</text>
            </view>
            <view class="nav-bar-title-block" :class="titleBlockClass" @click="onTitleBlockClick">
                <text v-if="title.length > 0" class="nav-bar-title" :class="titleColorClass">{{ title }}</text>
                <text v-if="subtitle.length > 0" class="nav-bar-subtitle" :class="titleColorClass">{{ subtitle }}</text>
            </view>
            <view v-if="rightIcons.length > 0" class="nav-bar-right" :class="{ 'nav-bar-side--front': centerTitle }"
                :style="rightSlotStyle">
                <view v-for="(icon, idx) in rightIcons" :key="idx" class="nav-bar-right-item"
                    @click="onRightItemClick(idx)">
                    <text class="nav-bar-icon" :class="titleColorClass">{{ icon }}</text>
                </view>
            </view>
            <view v-else class="nav-bar-side nav-bar-right" :class="{ 'nav-bar-side--front': centerTitle }"
                :style="rightSlotStyle" @click="onRightClick">
                <slot name="right"></slot>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import { useSafeArea } from '../../utils/system.uts'

    const props = withDefaults(defineProps<{
        title ?: string
        leftIcon ?: string
        rightIcon ?: string
        /** 多图标右槽（#1602 追加）：与 rightIcon 互斥，rightIcons 优先。 */
        rightIcons ?: string[]
        transparent ?: boolean
        /** 页头套（#1592 双层套的页头层）：'inverse'（N01 蓝底，标题/图标反色）| 'plain'（N02/N03 白底） */
        variant ?: string
        /** 可选副标题（#1602：原 ai-chat-nav 独立形态的唯一差异，归一后以 prop 表达，不 fork） */
        subtitle ?: string
        /** N03 分隔线：border-bottom 1rpx $border-color-light（#1592 白底带分隔线套） */
        divider ?: boolean
        /**
         * 标题恒居中（2026-10-27 AI 助手页头）。默认 false ⇒ 全仓现有调用方零 diff。
         *
         * 为什么需要这个 prop：左槽一有字形，`leftOverlap` 就成立、标题自动切左对齐（§5.1，
         * 那是对「证件名/返回箭头」这类页头定的）。聊天页要的是「☰ | AI 助手 | ⋯」的三段式，
         * 标题必须居中 —— 且必须**脱流**才算真居中：右槽为让开小程序胶囊带了 width + 大段
         * margin-right，标题若留在流内，只能在「左槽 → 右槽」的剩余宽度里居中，视线上必然偏左。
         */
        centerTitle ?: boolean
    }>(), {
        title: '',
        leftIcon: '‹',
        rightIcon: '',
        rightIcons: (): string[] => [],
        transparent: false,
        variant: 'plain',
        subtitle: '',
        divider: false,
        centerTitle: false
    })

    const emit = defineEmits(['leftClick', 'rightClick'])

    const safeArea = useSafeArea()

    const isInverse = computed((): boolean => props.variant == 'inverse')

    // 标题是否被左槽内容顶开（左槽有 icon 且有标题时走左对齐形态；否则居中，§5.1）
    const leftOverlap = computed((): boolean => props.leftIcon.length > 0 && props.title.length > 0)

    /**
     * 标题块形态类（2026-10-27）：`centerTitle` 优先于 §5.1 的 leftOverlap 判定。
     * 两者是互斥语义 —— §5.1 说的是「左槽有字时让位给左槽」，centerTitle 说的是
     * 「左槽有字也要居中，让位靠脱流解决」。先判 centerTitle，避免两条规则打架。
     */
    const titleBlockClass = computed((): string => {
        if (props.centerTitle) {
            return 'nav-bar-title-block--floating-center'
        }
        return leftOverlap.value ? '' : 'nav-bar-title-block--center'
    })

    // 胶囊让位（#1592）：右槽单行定宽，右缘 ≤ 胶囊左边线 − 视觉间隙；放不下由页面移出次要动作。
    // 坐标系修正（#1602 真链路复验发现）：槽在 .nav-bar-body 的内容盒里，内容盒右缘 =
    // 750 − 右padding（与 scss $spacing-md 一致）而非 750 ⇒ 只设 width 会把整槽右推 24rpx，
    // 图标落进胶囊矩形（实测 [532,726] vs 胶囊 [556,730]，违反验收「元素不落胶囊矩形」）。
    // 用 margin-right 把右缘钉回 capsuleLeft − CLEARANCE。非小程序端无胶囊 ⇒ 不设约束。
    const NAV_BODY_PADDING_X = 24 // 与 <style> 里 .nav-bar-body padding 的 $spacing-md 对齐
    const RIGHT_SLOT_CLEARANCE = 24 // 右槽与胶囊的视觉间隙（rpx）；用户复验 16 太贴，加到 24
    const rightSlotStyle = computed((): string => {
        const capsuleLeft = safeArea.value.capsuleLeft
        const w = safeArea.value.rightSlotWidth
        if (w <= 0 || capsuleLeft <= 0) {
            return ''
        }
        const marginRight = Math.max(0, (750 - NAV_BODY_PADDING_X) - (capsuleLeft - RIGHT_SLOT_CLEARANCE))
        return 'width: ' + w + 'rpx; margin-right: ' + marginRight + 'rpx;'
    })

    // 页头套底色（#1592）：N01 $primary-color / N02–N03 $bg-header / N05 transparent（页面自垫）
    const navBgClass = computed((): string => {
        if (props.transparent) {
            return 'nav-bar--bg-transparent'
        }
        if (isInverse.value) {
            return 'nav-bar--bg-primary'
        }
        return 'nav-bar--bg-header'
    })

    // 状态栏占位底色随套走（#1592）
    const statusBarBgClass = computed((): string => {
        if (props.transparent) {
            return 'status-bar--transparent'
        }
        if (isInverse.value) {
            return 'status-bar--primary'
        }
        return 'status-bar--header'
    })

    const titleColorClass = computed((): string => {
        return isInverse.value ? 'nav-bar-inverse-text' : ''
    })

    function onLeftClick() : void {
        emit('leftClick')
    }

    /**
     * 标题块点击（#1677）：**仅左槽空置（leftIcon=''）时**上移到同一条 leftClick 链。
     * 左槽空置时其内 text 无渲染 ⇒ 左槽 view 零宽零高、onLeftClick 命中区不存在，
     * 页面把左入口动作（dashboard 证件切换）挂在 leftClick 上就永远点不动；
     * 标题此时是该入口唯一可见的可点面，故由它代发。左槽有 icon（返回箭头）时
     * 标题是纯展示文字，点击不得触发左动作 —— 否则全仓子页点标题即误返回。
     */
    function onTitleBlockClick() : void {
        if (props.leftIcon.length == 0) {
            emit('leftClick')
        }
    }

    function onRightClick() : void {
        emit('rightClick', -1)
    }

    function onRightItemClick(idx : number) : void {
        emit('rightClick', idx)
    }
</script>

<style lang="scss">
    .nav-bar {
        flex-direction: column;
    }

    .nav-bar--bg-primary {
        background-color: $primary-color;
    }

    .nav-bar--bg-header {
        background-color: $bg-header;
    }

    .nav-bar--bg-transparent,
    .status-bar--transparent {
        background-color: transparent;
    }

    .nav-bar--divider {
        border-bottom: 1rpx solid $border-color-light;
    }

    .status-bar--primary {
        background-color: $primary-color;
    }

    .status-bar--header {
        background-color: $bg-header;
    }

    .nav-bar-body {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        height: 88rpx;
        padding: 0 $spacing-md;
        /* 标题居中形态的定位包含块：centerTitle 时标题块脱流（两侧槽仍在流内、位置不变） */
        position: relative;
    }

    .nav-bar-side {
        flex-direction: row;
        align-items: center;
        /* 与右槽的最小间距：长标题经 ellipsis 收敛，不会顶到图标 */
        margin-right: 24rpx;
    }

    /* 两侧槽抬到脱流标题块之上（仅 centerTitle 时挂上）。
       脱流标题块跨全宽 ⇒ 它会盖住左槽 ☰ 与右槽 ⋯，两处都点不动。本仓无 `pointer-events`
       先例（grep 全仓 0 处），故用 z-index 分层；`position: relative` 只为让 z-index 生效，
       元素仍在流内、位置与尺寸一概不变。 */
    .nav-bar-side--front {
        position: relative;
        z-index: 2;
    }

    .nav-bar-left {
        justify-content: flex-start;
    }

    .nav-bar-right {
        justify-content: flex-end;
    }

    .nav-bar-right-item {
        padding: 0 12rpx;
    }

    .nav-bar-title {
        font-size: $font-size-xl;
        font-weight: bold;
        color: $text-color;
        margin-left: 16rpx;
        /* 长证件名单行收敛（用户复验：标题与图标互相挤） */
        lines: 1;
        text-overflow: ellipsis;
    }

    .nav-bar-title-block {
        flex-direction: column;
        align-items: flex-start;
        margin-left: 16rpx;
        /* #1677：占满 88rpx bar 高（与 .nav-bar-body 同高）+ 内容垂直居中 ——
           视觉与原内容高块居中时逐像素一致，但把左入口标题的命中区从「文字高」
           抬到整条 bar 高（触摸目标 44×44）。左槽空置时标题代发 leftClick（见 onTitleBlockClick）。 */
        height: 88rpx;
        justify-content: center;
    }

    .nav-bar-title-block--center {
        align-items: center;
        margin-left: 0;
    }

    /* 标题恒居中（centerTitle）：脱流 + 两侧**对称内缩**，居中点仍是整条 bar 的中心。
       用 left + width 定宽而不是 left+right 双锚点 —— 后者依赖 uvue 对双锚点拉伸的支持，
       本仓零先例。高度沿用 .nav-bar-title-block 的 88rpx + justify-content:center ⇒ 垂直居中。

       为什么内缩 88rpx 而不是铺满全宽：左槽占 [24rpx, 68rpx]（$spacing-md padding + 44rpx 字形），
       内缩到 88rpx 留 20rpx 余量 ⇒ 标题块**物理上不覆盖左槽**。这是给「点了没反应」留的
       几何兜底：v-if 形态下若某条渲染路径不认 z-index，铺满全宽的透明块会把 ☰ 的命中区
       整个盖掉（不报错、不崩，只是点不动）。内缩对称，所以居中点不变。
       右侧仍会压到右槽的空白段（右槽 [338rpx, 532rpx]，图标在右端），靠 DOM 顺序
       （右槽在标题块之后绘制）+ z-index 兜住，不靠几何。 */
    .nav-bar-title-block--floating-center {
        position: absolute;
        left: 88rpx;
        top: 0;
        width: 574rpx;
        align-items: center;
        margin-left: 0;
        z-index: 1;
    }

    .nav-bar-subtitle {
        font-size: 24rpx;
        color: $text-color-secondary;
        margin-top: 4rpx;
    }

    .nav-bar-icon {
        font-size: 44rpx;
        color: $text-color;
    }

    .nav-bar-inverse-text {
        color: $text-color-inverse;
    }
</style>
