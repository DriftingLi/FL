<template>
    <view class="nav-bar" :class="[navBgClass, { 'nav-bar--transparent': transparent }]">
        <view class="status-bar" :class="statusBarBgClass" :style="{ height: safeArea.statusBarHeight + 'px' }"></view>
        <view class="nav-bar-body">
            <view class="nav-bar-left" @click="onLeftClick">
                <text v-if="leftIcon.length > 0" class="nav-bar-icon" :class="titleColorClass">{{ leftIcon }}</text>
                <view v-if="title.length > 0" class="nav-bar-title-block">
                    <text class="nav-bar-title" :class="titleColorClass">{{ title }}</text>
                    <text v-if="subtitle.length > 0" class="nav-bar-subtitle" :class="titleColorClass">{{ subtitle }}</text>
                </view>
            </view>
            <view v-if="rightIcon.length > 0" class="nav-bar-right" :style="rightSlotStyle" @click="onRightClick">
                <text class="nav-bar-icon" :class="titleColorClass">{{ rightIcon }}</text>
            </view>
            <!-- 多图标右槽（#1602 追加）：dashboard 等页的 🔍🔔🛒 一排；宽度同样按胶囊让位。
                 每个图标独立可点，rightClick 携带索引（-1 = 单图标形态，兼容旧消费方）。 -->
            <view v-else-if="rightIcons.length > 0" class="nav-bar-right" :style="rightSlotStyle">
                <view v-for="(icon, idx) in rightIcons" :key="idx" class="nav-bar-right-item"
                    @click="onRightItemClick(idx)">
                    <text class="nav-bar-icon" :class="titleColorClass">{{ icon }}</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import { useSafeArea } from '../../utils/system.uts'

    const props = withDefaults(defineProps<{
        title ?: string
        leftIcon ?: string
        rightIcon ?: string
        /** 多图标右槽（#1602 追加）：与 rightIcon 互斥，rightIcons 优先。 */
        rightIcons ?: string[]
        transparent ?: boolean
        /** 页头套（#1592 双层套的页头层）：'inverse'（N01 蓝底，标题/图标反色）| 'plain'（N02/N03 白底） */
        variant ?: string
        /** 可选副标题（#1602：原 ai-chat-nav 独立形态的唯一差异，归一后以 prop 表达，不 fork） */
        subtitle ?: string
    }>(), {
        title: '',
        leftIcon: '‹',
        rightIcon: '',
        rightIcons: (): string[] => [],
        transparent: false,
        variant: 'plain',
        subtitle: ''
    })

    const emit = defineEmits(['leftClick', 'rightClick'])

    const safeArea = useSafeArea()

    const isInverse = computed((): boolean => props.variant == 'inverse')

    // 胶囊让位（#1592）：右槽单行定宽，右缘 = 胶囊左边线；放不下由页面移出次要动作。
    // 非小程序端 rightSlotWidth = 0 ⇒ 不设 width 约束。
    const rightSlotStyle = computed((): string => {
        const w = safeArea.value.rightSlotWidth
        if (w <= 0) {
            return ''
        }
        return 'width: ' + w + 'rpx;'
    })

    // 页头套底色（#1592）：N01 $primary-color / N02–N03 $bg-header / N05 transparent（页面自垫）
    const navBgClass = computed((): string => {
        if (props.transparent) {
            return 'nav-bar--bg-transparent'
        }
        if (isInverse.value) {
            return 'nav-bar--bg-primary'
        }
        return 'nav-bar--bg-header'
    })

    // 状态栏占位底色随套走（#1592）
    const statusBarBgClass = computed((): string => {
        if (props.transparent) {
            return 'status-bar--transparent'
        }
        if (isInverse.value) {
            return 'status-bar--primary'
        }
        return 'status-bar--header'
    })

    const titleColorClass = computed((): string => {
        return isInverse.value ? 'nav-bar-inverse-text' : ''
    })

    function onLeftClick() : void {
        emit('leftClick')
    }

    function onRightClick() : void {
        emit('rightClick', -1)
    }

    function onRightItemClick(idx : number) : void {
        emit('rightClick', idx)
    }
</script>

<style lang="scss">
    .nav-bar {
        flex-direction: column;
    }

    .nav-bar--bg-primary {
        background-color: $primary-color;
    }

    .nav-bar--bg-header {
        background-color: $bg-header;
    }

    .nav-bar--bg-transparent,
    .status-bar--transparent {
        background-color: transparent;
    }

    .status-bar--primary {
        background-color: $primary-color;
    }

    .status-bar--header {
        background-color: $bg-header;
    }

    .nav-bar-body {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        height: 88rpx;
        padding: 0 $spacing-md;
    }

    .nav-bar-left {
        flex-direction: row;
        align-items: center;
    }

    .nav-bar-right {
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
    }

    .nav-bar-right-item {
        padding: 0 8rpx;
    }

    .nav-bar-title {
        font-size: $font-size-xl;
        font-weight: bold;
        color: $text-color;
        margin-left: 16rpx;
    }

    .nav-bar-title-block {
        flex-direction: column;
        align-items: flex-start;
    }

    .nav-bar-subtitle {
        font-size: 24rpx;
        color: $text-color-secondary;
        margin-left: 16rpx;
        margin-top: 4rpx;
    }

    .nav-bar-icon {
        font-size: 44rpx;
        color: $text-color;
    }

    .nav-bar-inverse-text {
        color: $text-color-inverse;
    }
</style>
