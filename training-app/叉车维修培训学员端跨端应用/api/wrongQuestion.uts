/**
 * 错题本 API
 * @note 后端返回的错题结构：
 *   items[].question_id = 题目ID
 *   items[].question = { id, type, content, options:{Map}, answer, explanation }
 *   items[].favorited / items[].favorite_id = 收藏状态（后端 JOIN favorite 回填）
 *   需要从嵌套的 question 对象中提取题目信息
 * @note 后端 GET /wrong-questions 支持 type / min_wrong_count / favorited / sort(time_asc)，
 *   不支持 knowledge_point 维度（分组只按题型）
 */
import { get, post } from './request'
import { toNumber, toStr, toBool } from './helpers'
import type { WrongQuestionItem, WrongQuestionListResult, WrongQuestionStats, QuestionOption } from '../types/index'

/** 列表查询条件（对应后端 query 参数，空值不发送） */
export type WrongQuestionQuery = {
    type : string          // 题型筛选（single_choice 等），空为全部
    sort : string          // 'time_asc' = 最早在前；空 = 默认（最近错误时间倒序）
    favorited : boolean    // true = 仅收藏
    minWrongCount : number // >0 = 错误次数 >= N（"错多次"用 2）
}

/**
 * 将后端 options Map 转换为前端 Array<{key, text}>
 */
function buildOptions(raw : any | null) : QuestionOption[] {
	const options : QuestionOption[] = []
	if (raw == null) return options
	const optsMap = raw as UTSJSONObject
	for (const k in optsMap) {
		const opt : QuestionOption = {
			key: k,
			text: toStr(optsMap[k]),
		} as QuestionOption
		options.push(opt)
	}
	return options
}

/**
 * 从 UTSJSONObject 构造 WrongQuestionItem
 * @note 后端把题目信息嵌套在 question 字段中
 */
function buildWrongQuestionItem(obj : UTSJSONObject) : WrongQuestionItem {
	// 从嵌套的 question 对象中提取题目信息
	let questionId = toNumber(obj['question_id'])
	let qType = ''
	let qTitle = ''
	let qOptions : QuestionOption[] = []
	let qCorrectAnswer = ''

	const questionRaw = obj['question']
	if (questionRaw != null) {
		const questionObj = questionRaw as UTSJSONObject
		questionId = toNumber(questionObj['id'])           // 后端 id → question_id
		qType = toStr(questionObj['type'])
		qTitle = toStr(questionObj['content'])              // 后端 content → title
		qOptions = buildOptions(questionObj['options'])
		qCorrectAnswer = toStr(questionObj['answer'])      // 后端 answer → correct_answer
	}

	const item : WrongQuestionItem = {
		question_id: questionId,
		type: qType,
		title: qTitle,
		options: qOptions,
		correct_answer: qCorrectAnswer,
		user_answer: toStr(obj['user_answer']),
		wrong_count: toNumber(obj['wrong_count']),
		created_at: toStr(obj['created_at']),
		favorited: toBool(obj['favorited'], false),
	} as WrongQuestionItem
	return item
}

/** 从 UTSJSONObject 构造 WrongQuestionListResult */
function buildWrongQuestionListResult(obj : UTSJSONObject) : WrongQuestionListResult {
	const items : WrongQuestionItem[] = []
	const itemsRaw = obj['items']
	if (itemsRaw != null) {
		const itemsArray = itemsRaw as Array<UTSJSONObject>
		for (let i = 0; i < itemsArray.length; i++) {
			items.push(buildWrongQuestionItem(itemsArray[i]))
		}
	}
	const result : WrongQuestionListResult = {
		items: items,
		total: toNumber(obj['total']),
		page: toNumber(obj['page']),
		page_size: toNumber(obj['page_size']),
	} as WrongQuestionListResult
	return result
}

/** 从 UTSJSONObject 构造 WrongQuestionStats */
function buildWrongQuestionStats(obj : UTSJSONObject) : WrongQuestionStats {
	const byTypeRaw = obj['by_type']
	let by_type : UTSJSONObject = {}
	if (byTypeRaw != null) {
		by_type = byTypeRaw as UTSJSONObject
	}
	const stats : WrongQuestionStats = {
		total: toNumber(obj['total']),
		by_type: by_type,
		by_knowledge_point: {} as UTSJSONObject,
	} as WrongQuestionStats
	return stats
}

/**
 * 获取错题列表（page/pageSize + 可组合筛选条件）
 */
export function getWrongQuestionsApi(page : number = 1, pageSize : number = 20, query : WrongQuestionQuery | null = null) : Promise<WrongQuestionListResult> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	} as UTSJSONObject
	if (query != null) {
		const q = query as WrongQuestionQuery
		if (q.type.length > 0) {
			params['type'] = q.type
		}
		if (q.sort.length > 0) {
			params['sort'] = q.sort
		}
		if (q.favorited) {
			params['favorited'] = 'true'
		}
		if (q.minWrongCount > 0) {
			params['min_wrong_count'] = q.minWrongCount.toString()
		}
	}
	return get('/wrong-questions', params).then((data : UTSJSONObject) : WrongQuestionListResult => {
		return buildWrongQuestionListResult(data)
	}).catch((e) : WrongQuestionListResult => {
		console.error('[getWrongQuestionsApi] failed:', e)
		let msg = '获取错题列表失败'
		if (e instanceof Error) {
			const errObj = e as Error
			const m = errObj.message
			if (m != null && m.length > 0) {
				msg = msg + ': ' + m
			}
		}
		throw new Error(msg)
	})
}

/**
 * 重做错题
 * @param questionId 题目 ID
 * @param userAnswer 用户答案
 */
export function redoWrongQuestionApi(questionId : number, userAnswer : string) : Promise<UTSJSONObject> {
	const url = '/wrong-questions/' + questionId + '/redo'
	const payload : UTSJSONObject = {
		user_answer: userAnswer
	} as UTSJSONObject
	return post(url, payload)
}

/**
 * 移出错题本
 * @param questionId 题目 ID
 */
export function removeWrongQuestionApi(questionId : number) : Promise<UTSJSONObject> {
	const url = '/wrong-questions/' + questionId + '/remove'
	return post(url, null)
}

/** 获取错题统计 */
export function getWrongQuestionStatsApi() : Promise<WrongQuestionStats> {
	return get('/wrong-questions/stats').then((data : UTSJSONObject) : WrongQuestionStats => {
		return buildWrongQuestionStats(data)
	}).catch((e) : WrongQuestionStats => {
		console.error('[getWrongQuestionStatsApi] failed:', e)
		let msg = '获取错题统计失败'
		if (e instanceof Error) {
			const errObj = e as Error
			const m = errObj.message
			if (m != null && m.length > 0) {
				msg = msg + ': ' + m
			}
		}
		throw new Error(msg)
	})
}
