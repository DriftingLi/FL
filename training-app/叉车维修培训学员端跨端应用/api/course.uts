/**
 * 课程列表
 * @param page 页码，默认 1
 * @param pageSize 每页条数，默认 12
 * @param specialtyId 专业方向 ID 过滤（可选，0 表示全部）
 * @param levelId 课程等级 ID 过滤（可选，0 表示全部）
 */
export function getCourseListApi(page : number = 1, pageSize : number = 12, specialtyId : number = 0, levelId : number = 0) : Promise<CourseListResult> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	}
	if (specialtyId > 0) {
		params['specialty_id'] = specialtyId.toString()
	}
	if (levelId > 0) {
		params['level_id'] = levelId.toString()
	}
	return get('/courses', params).then((data : UTSJSONObject) : CourseListResult => {
		console.log('[getCourseListApi] raw data:', JSON.stringify(data))
		return buildCourseListResult(data)
	}).catch((e) : CourseListResult => {
		console.warn('[getCourseListApi] network failed, using mock data:', e)
		return getMockCourseList()
	})
}

/**
 * 从课程目录树提取专业方向（学员端公开接口）
 * 后端无独立的学员端 /specialties 端点，通过 /catalog/tree 获取后提取
 */
export function getCatalogTreeSpecialties() : Promise<SpecialtyItem[]> {
	return get('/catalog/tree').then((data : UTSJSONObject) : SpecialtyItem[] => {
		console.log('[getCatalogTreeSpecialties] raw data:', JSON.stringify(data))
		const items : SpecialtyItem[] = []
		const raw = data['specialties']
		if (raw != null) {
			const arr = raw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				const node = arr[i]
				const id = toNumber(node['specialty_id'])
				const name = toStr(node['name'])
				if (id > 0 && name.length > 0) {
					items.push({ specialty_id: id, name: name } as SpecialtyItem)
				}
			}
		}
		return items
	}).catch((e) : SpecialtyItem[] => {
		console.warn('[getCatalogTreeSpecialties] failed, using mock data:', e)
		return getMockSpecialties()
	})
}

/**
 * 课程等级列表（公开，仅启用项）
 */
export function getLevelsApi() : Promise<LevelItem[]> {
	return get('/levels').then((data : UTSJSONObject) : LevelItem[] => {
		console.log('[getLevelsApi] raw data:', JSON.stringify(data))
		const items : LevelItem[] = []
		const raw = data['levels']
		if (raw != null) {
			const arr = raw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				items.push(buildLevelItem(arr[i]))
			}
		}
		return items
	}).catch((e) : LevelItem[] => {
		console.warn('[getLevelsApi] network failed, using mock data:', e)
		return getMockLevels()
	})
}

/**
 * 课程详情（含章节列表 + 学习进度）
 * @param courseId 课程 ID
 */
export function getCourseDetailApi(courseId : number) : Promise<CourseDetail> {
	return get('/course/' + courseId).then((data : UTSJSONObject) : CourseDetail => {
		console.log('[getCourseDetailApi] raw data:', JSON.stringify(data))
		return buildCourseDetail(data)
	}).catch((e) : CourseDetail => {
		console.warn('[getCourseDetailApi] network failed, using mock data:', e)
		return getMockCourseDetail(courseId)
	})
}

/**
 * 章节详情（含图文内容、附件、上/下章导航、学习状态）
 * @param courseId 课程 ID
 * @param chapterId 章节 ID
 */
export function getChapterDetailApi(courseId : number, chapterId : number) : Promise<ChapterDetail> {
	return get('/course/' + courseId + '/chapter/' + chapterId).then((data : UTSJSONObject) : ChapterDetail => {
		return buildChapterDetail(data)
	}).catch((e) : ChapterDetail => {
		console.warn('[getChapterDetailApi] network failed:', e)
		// 返回空章节详情，UI 显示"加载失败"
		return {
			chapter_id: 0,
			title: '',
			content: '',
			files: [] as ChapterFile[],
			previous_chapter_id: 0,
			next_chapter_id: 0,
			study_status: '',
			duration: 0,
		} as ChapterDetail
	})
}

/**
 * 更新学习进度
 * @param courseId 课程 ID
 * @param chapterId 当前学习章节 ID
 * @param duration 本次学习时长（分钟）
 */
export function updateCourseProgressApi(courseId : number, chapterId : number, duration : number) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		chapter_id: chapterId,
		duration: duration,
	} as UTSJSONObject
	return post('/course/' + courseId + '/progress', payload)
}

// ========== 标签 ==========

/** 从 UTSJSONObject 构造 TagItem */
function buildTagItem(obj : UTSJSONObject) : TagItem {
	return {
		id: toNumber(obj['id']),
		code: toStr(obj['code']),
		name: toStr(obj['name']),
		description: toStr(obj['description']),
		sort_order: toNumber(obj['sort_order']),
		status: toNumber(obj['status']),
		question_count: toNumber(obj['question_count']),
	} as TagItem
}

/** 题库标签列表（仅启用项，含已发布题目数） */
export function getTagsApi() : Promise<TagItem[]> {
	return get('/tags').then((data : UTSJSONObject) : TagItem[] => {
		const items : TagItem[] = []
		// data 可能是数组或 { tags: [...] }
		let listRaw = data['tags']
		if (listRaw == null) {
			listRaw = data['list']
		}
		if (listRaw != null) {
			const arr = listRaw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				items.push(buildTagItem(arr[i]))
			}
		} else {
			// 可能直接是数组
			const arr = data as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				items.push(buildTagItem(arr[i]))
			}
		}
		return items
	})
}