/**
 * 课程列表
 *
 * ## 证件分区为什么必须显式传（#1107）
 *
 * `/api/courses` 挂在 `courses.go` 自己的 group 上、该 group 的 `CredentialScoped` 在**公开访问**的
 * 课程 group 上（`backend/internal/api/courses.go:31`、公开路由 `:34`），而 `CredentialScoped` 的兜底
 * 分支要求 `roleOf(c) == student`（`backend/internal/middleware/credential_scope.go:42`）
 * —— 公开面拿不到角色 ⇒ **兜底永不生效**，不传 `credential_id` 就是「全证件不分区」。
 * 根仓已把这条例外登记进 ADR-0056 §2（并给这两类例外决策落点；Web 端在 `api/client.ts` 的注释与
 * `api/__tests__/credentialScopeContract.spec.ts` 的冻结清单里登记，见 #1106）。移动端口径表见
 * `docs/agents/credential-scope.md`，守护见 `utils/credentialScopeContract.test.js`。
 *
 * @param page 页码，默认 1
 * @param pageSize 每页条数，默认 12
 * @param specialtyId 专业方向 ID 过滤（可选，0 表示全部）
 * @param levelId 课程等级 ID 过滤（可选，0 表示全部）
 * @param credentialId 当前证件 ID（>0 才下发；0 = 未声明，与服务端 nil 语义一致）
 */
export function getCourseListApi(page : number = 1, pageSize : number = 12, specialtyId : number = 0, levelId : number = 0, credentialId : number = 0) : Promise<CourseListResult> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	}
	if (specialtyId > 0) {
		params['specialty_id'] = specialtyId.toString()
	}
	if (levelId > 0) {
		params['level_id'] = levelId.toString()
	}
	if (credentialId > 0) {
		params['credential_id'] = credentialId.toString()
	}
	return getMapped<CourseListResult>('/courses', params, (data : UTSJSONObject) : CourseListResult => {
		console.log('[getCourseListApi] raw data:', JSON.stringify(data))
		return buildCourseListResult(data)
	}).catch((e) : CourseListResult => {
		console.warn('[getCourseListApi] network failed, using mock data:', e)
		return getMockCourseList()
	})
}

/** 从 /catalog/tree 响应中提取专业方向列表（学员端无独立 /specialties 端点） */
function buildSpecialtyListFromCatalog(obj : UTSJSONObject) : SpecialtyItem[] {
	const items : SpecialtyItem[] = []
	const raw = obj['specialties']
	if (raw != null) {
		const arr = raw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			const node = arr[i]
			const id = toNumber(node['specialty_id'])
			const name = toStr(node['name'])
			if (id > 0 && name.length > 0) {
				items.push({ specialty_id: id, name: name } as SpecialtyItem)
			}
		}
	}
	return items
}

/**
 * 从课程目录树提取专业方向（学员端公开接口）
 * 后端无独立的学员端 /specialties 端点，通过 /catalog/tree 获取后提取
 *
 * 证件分区：`/api/catalog/tree` **未挂** `CredentialScoped`，handler 自读 query
 * （`backend/internal/api/training_catalog.go:105`），传 `credential_id` 只分区**课程节点**
 * —— `service.getCatalogTree` 的专业方向列表与等级列表恒为全量启用项
 * （`backend/internal/service/training_catalog_service.go:456-475`）。本函数**只消费 `specialties`**
 * （全局共享字典），故**不传证件**：传了也是 no-op。要改成消费课程节点时才需要补参数，
 * 届时回来登记 `docs/agents/credential-scope.md`。
 */
export function getCatalogTreeSpecialties() : Promise<SpecialtyItem[]> {
	return getMapped<SpecialtyItem[]>('/catalog/tree', null, (data : UTSJSONObject) : SpecialtyItem[] => {
		console.log('[getCatalogTreeSpecialties] raw data:', JSON.stringify(data))
		return buildSpecialtyListFromCatalog(data)
	}).catch((e) : SpecialtyItem[] => {
		console.warn('[getCatalogTreeSpecialties] failed, using mock data:', e)
		return getMockSpecialties()
	})
}

/** 从 /levels 响应中提取课程等级列表 */
function buildLevelList(obj : UTSJSONObject) : LevelItem[] {
	const items : LevelItem[] = []
	const raw = obj['levels']
	if (raw != null) {
		const arr = raw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			items.push(buildLevelItem(arr[i]))
		}
	}
	return items
}

/**
 * 课程等级列表（公开，仅启用项）
 */
export function getLevelsApi() : Promise<LevelItem[]> {
	return getMapped<LevelItem[]>('/levels', null, (data : UTSJSONObject) : LevelItem[] => {
		console.log('[getLevelsApi] raw data:', JSON.stringify(data))
		return buildLevelList(data)
	}).catch((e) : LevelItem[] => {
		console.warn('[getLevelsApi] network failed, using mock data:', e)
		return getMockLevels()
	})
}

/**
 * 课程详情（含章节列表 + 学习进度）
 * @param courseId 课程 ID
 */
export function getCourseDetailApi(courseId : number) : Promise<CourseDetail> {
	return getMapped<CourseDetail>('/course/' + courseId, null, (data : UTSJSONObject) : CourseDetail => {
		console.log('[getCourseDetailApi] raw data:', JSON.stringify(data))
		return buildCourseDetail(data)
	}).catch((e) : CourseDetail => {
		console.warn('[getCourseDetailApi] network failed, using mock data:', e)
		return getMockCourseDetail(courseId)
	})
}

/**
 * 章节详情（含图文内容、附件、上/下章导航、学习状态）
 * @param courseId 课程 ID
 * @param chapterId 章节 ID
 * @note #1268：**本函数不再 catch**。原先它把所有错误折成 `chapter_id: 0` 的空详情，
 *       页面据此显示「章节内容加载失败 + 重试」—— 而未兑换的付费章节后端返回 **404**
 *       （第十四波 ADR-0062：正文与幻灯片开始鉴权，按「章节不存在」返回、不泄漏存在性），
 *       那是「未解锁」不是「加载失败」，重试必然再 404 ⇒ 死胡同。现在错误一律向上抛，
 *       由调用方经 `isChapterNotFound()` 分流（照 `getResumeApi()` 的 #1204 先例：api 层不 catch）。
 * @note 空详情回退是**整体删除**而不是只对 404 例外：网络失败时它也落到页面同一个分支
 *       （`detail == null` 与 `chapter_id == 0` 走一条 UI），删掉零行为变更，且不留「一条错误两条路」的歧义。
 */
export function getChapterDetailApi(courseId : number, chapterId : number) : Promise<ChapterDetail> {
	return getMapped<ChapterDetail>('/course/' + courseId + '/chapter/' + chapterId, null, (data : UTSJSONObject) : ChapterDetail => {
		return buildChapterDetail(data)
	})
}

/**
 * 判断错误是否为「章节不存在 / 未解锁」（后端 `GET /course/:id/chapter/:id` 对未兑换的付费章节返回 404）。
 *
 * 这是该语义的**唯一判定出口** —— 与 `api/resume.uts` 的 `isResumeNotFound()` 同款（#1204：
 * 判定不许在调用方各复制一份，也不许按后端中文文案匹配，文案一改语义就静默改变）。
 *
 * @param e `.catch` 收到的错误对象（类型未知，`any | null`）：非 Error 一律判 false。
 */
export function isChapterNotFound(e : any | null) : boolean {
	// 404 由 `api/request.uts` 用消息前缀承载（读写两端共用同一常量，见 NOT_FOUND_MESSAGE_PREFIX 注释）
	return errMsg(e, '').startsWith(NOT_FOUND_MESSAGE_PREFIX)
}


/**
 * 更新学习进度
 * @param courseId 课程 ID
 * @param chapterId 当前学习章节 ID
 * @param duration 本次学习时长（分钟）
 * @param completed 是否显式标记本章完成（#1111）
 * @note 保持裸 post 透传：后端只回确认型载荷、无领域 DTO 可映射，按 T03/T06 口径
 *   「void / 确认型透传不硬套 identity map」，本函数是本域白名单内唯一 raw 出口。
 * @note `completed` 对应后端 StudyProgressInput.Completed（已由 courses.go 接收 →
 *   course_service.go 置章节 progress=100）。web 端自 ADR-0017 起一直走这条显式完成路径，
 *   移动端此前**从不发送**该字段 ⇒ 章节永远攒不到完成、课程进度恒 0（#1111）。
 *   不传时保持原行为（只报时长），故本参数对既有调用方向后兼容。
 */
export function updateCourseProgressApi(courseId : number, chapterId : number, duration : number, completed : boolean = false) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		chapter_id: chapterId,
		duration: duration,
	} as UTSJSONObject
	if (completed) {
		payload['completed'] = true
	}
	return post('/course/' + courseId + '/progress', payload)
}

// ========== 标签 ==========

/** 从 UTSJSONObject 构造 TagItem */
function buildTagItem(obj : UTSJSONObject) : TagItem {
	return {
		id: toNumber(obj['id']),
		code: toStr(obj['code']),
		name: toStr(obj['name']),
		description: toStr(obj['description']),
		sort_order: toNumber(obj['sort_order']),
		status: toNumber(obj['status']),
		question_count: toNumber(obj['question_count']),
	} as TagItem
}

/** 从 UTSJSONObject 构造题库标签列表（兼容 { tags } / { list } / 直接数组三种形态） */
function buildTagList(obj : UTSJSONObject) : TagItem[] {
	const items : TagItem[] = []
	let listRaw = obj['tags']
	if (listRaw == null) {
		listRaw = obj['list']
	}
	if (listRaw != null) {
		const arr = listRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			items.push(buildTagItem(arr[i]))
		}
	} else {
		// 可能直接是数组
		const arr = obj as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			items.push(buildTagItem(arr[i]))
		}
	}
	return items
}

/**
 * 题库标签列表（仅启用项，含已发布题目数）
 *
 * 证件分区：`/api/tags` 是**公开路由**且**未挂** `CredentialScoped`，handler 用
 * `queryIDPtr(c, "credential_id")` **自读 query**（`backend/internal/api/training_catalog.go:143`）
 * ⇒ 显式传参是它唯一的分区通道，未传 = 不分区。`question_count` 与**抽题池**同口径
 * （`service.ListQuestionTags` 的 #702 注释）：不传时标签题数是全证件计数，
 * 与学员实际能抽到的题量对不上 —— 故「标签练习」消费面必须传当前证件。
 *
 * @param credentialId 当前证件 ID（>0 才下发；0 = 未声明，不分区）
 */
export function getTagsApi(credentialId : number = 0) : Promise<TagItem[]> {
	let params : UTSJSONObject | null = null
	if (credentialId > 0) {
		params = { credential_id: credentialId.toString() } as UTSJSONObject
	}
	return getMapped<TagItem[]>('/tags', params, (data : UTSJSONObject) : TagItem[] => {
		return buildTagList(data)
	})
}

