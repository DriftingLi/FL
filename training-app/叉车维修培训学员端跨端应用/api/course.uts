/**
 * 课程模块 API
 * - 课程列表（公开，支持按专业方向/课程等级过滤）
 * - 专业方向 / 课程等级 筛选选项（公开）
 * - 课程详情（需要 Token）
 * - 章节幻灯片（公开）
 * - 更新学习进度（需要 Token）
 *
 * @note 后端实际返回的字段名与前端类型定义不同：
 *   列表：后端返回 { courses: [...], pages }，前端类型用 { items: [...], page_size }
 *   课程：后端返回 { name, cover_image }，前端类型用 { title, cover_url }
 *   详情：后端返回 { course_info: {...}, progress }，前端类型用 { course_id, progress_pct }
 *   buildXxx 函数负责字段映射转换
 *
 * @note 出口家族（T08 手术收紧；ADR-0007「api 契约收紧」，T01 #639 出入口）：
 *   本域除 updateCourseProgressApi 外的全部请求都经 getMapped<T> mapper-callback 出口，
 *   映射函数一律箭头包裹 build*（守护规则 M 禁「裸 builder 引用作 mapper」）；
 *   params 仍沿用手动 query 序列化、请求形态未变（getMapped 的 URL 构造段与历史 get 逐字一致）。
 * @note 唯一裸出口 = updateCourseProgressApi（确认型透传、无 DTO 可映射），理由见其函数注释，
 *   并由 utils/coursesContract.test.js 的白名单锁死「未误加 DTO」。
 * @note catch-mock 静默回退保持 T02 试点的既有决策（utils/mallPilotContract.test.js 锁定
 *   getMockCourseList 保留）；退役回退属「改口径」，T08 本票不做。
 *   ⚠️ 例外一处（#1268 已按 ADR-0007「掩盖面」判据退役）：`getChapterDetailApi` 的 `.catch`
 *   已删除 —— 它把后端的 404（未兑换的付费章节 = 鉴权收回）折成 `chapter_id:0` 空详情，
 *   正是「把真实缺口伪装成正常首屏」的形态。其余 4 处回退原样保留，计数由 coursesContract 钉。
 */
import { getMapped, post, NOT_FOUND_MESSAGE_PREFIX } from './request'
import { toNumber, toStr, errMsg } from './helpers'
import type { CourseListResult, CourseDetail, CourseItem, ChapterItem, ChapterDetail, ChapterFile, SpecialtyItem, LevelItem, TagItem, CoursePrereq } from '../types/index'



/**
 * 从 UTSJSONObject 构造 CourseItem
 * @note 后端字段 name → 前端 title，cover_image → cover_url
 *       后端无 chapter_count 字段，默认 0
 */
function buildCourseItem(obj : UTSJSONObject) : CourseItem {
	const item : CourseItem = {
		course_id: toNumber(obj['course_id']),
		title: toStr(obj['name']),           // 后端 name → 前端 title
		description: toStr(obj['description']),
		cover_url: toStr(obj['cover_image']), // 后端 cover_image → 前端 cover_url
		duration: toNumber(obj['duration']),
		chapter_count: toNumber(obj['chapter_count']), // 后端不返回此字段，默认 0
		specialty_id: toNumber(obj['specialty_id']),
		level_id: toNumber(obj['level_id']),
	} as CourseItem
	return item
}

/** 从 UTSJSONObject 构造 ChapterItem */
function buildChapterItem(obj : UTSJSONObject) : ChapterItem {
	const item : ChapterItem = {
		chapter_id: toNumber(obj['chapter_id']),
		title: toStr(obj['title']),
		order_num: toNumber(obj['order_num']),
		duration: toNumber(obj['duration']),
	} as ChapterItem
	return item
}

/** 从 UTSJSONObject 构造 ChapterFile */
function buildChapterFile(obj : UTSJSONObject) : ChapterFile {
	const f : ChapterFile = {
		file_id: toNumber(obj['file_id']),
		file_name: toStr(obj['file_name'], toStr(obj['name'], '附件')),
		file_url: toStr(obj['file_url'], toStr(obj['url'], '')),
		content_type: toStr(obj['content_type'], toStr(obj['type'], 'document')),
	} as ChapterFile
	return f
}

/** 从 UTSJSONObject 构造 ChapterDetail */
function buildChapterDetail(obj : UTSJSONObject) : ChapterDetail {
	const files : ChapterFile[] = []
	const filesRaw = obj['files']
	if (filesRaw != null) {
		const arr = filesRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			files.push(buildChapterFile(arr[i]))
		}
	}
	const detail : ChapterDetail = {
		chapter_id: toNumber(obj['chapter_id']),
		title: toStr(obj['title']),
		content: toStr(obj['content']),
		files: files,
		previous_chapter_id: toNumber(obj['previous_chapter_id']),
		next_chapter_id: toNumber(obj['next_chapter_id']),
		study_status: toStr(obj['study_status']),
		duration: toNumber(obj['duration']),
	} as ChapterDetail
	return detail
}

/**
 * 从 UTSJSONObject 构造 CoursePrereq
 */
function buildCoursePrereq(obj : UTSJSONObject) : CoursePrereq {
	return {
		course_id: toNumber(obj['course_id']),
		name: toStr(obj['name']),
	} as CoursePrereq
}

/**
 * 从 UTSJSONObject 构造 CourseDetail
 * @note 后端返回 { course_info: {...}, chapters: [...], progress: 33.0, is_enrolled, completed_chapters }
 *       course_info 内嵌 specialty: {name}, level: {name}, certificate_template: {name, validity_days},
 *       prerequisites: [{course_id, name}], theory_hours, practice_hours
 */
function buildCourseDetail(obj : UTSJSONObject) : CourseDetail {
	const chapters : ChapterItem[] = []
	const chaptersRaw = obj['chapters']
	if (chaptersRaw != null) {
		const chaptersArray = chaptersRaw as Array<UTSJSONObject>
		for (let i = 0; i < chaptersArray.length; i++) {
			chapters.push(buildChapterItem(chaptersArray[i]))
		}
	}

	// 后端把课程信息嵌套在 course_info 字段中
	let courseInfo = obj['course_info']
	let courseId : number = 0
	let courseTitle : string = ''
	let courseDesc : string = ''
	let courseCover : string = ''
	let courseDuration : number = 0
	let courseSpecialtyId : number = 0
	let courseLevelId : number = 0
	let specialtyName : string = ''
	let levelName : string = ''
	let theoryHours : number = 0
	let practiceHours : number = 0
	let certificateName : string = ''
	let certificateValidityDays : number = 0
	let prerequisites : CoursePrereq[] = []

	if (courseInfo != null) {
		const infoObj = courseInfo as UTSJSONObject
		courseId = toNumber(infoObj['course_id'])
		courseTitle = toStr(infoObj['name'])
		courseDesc = toStr(infoObj['description'])
		courseCover = toStr(infoObj['cover_image'])
		courseDuration = toNumber(infoObj['duration'])
		courseSpecialtyId = toNumber(infoObj['specialty_id'])
		courseLevelId = toNumber(infoObj['level_id'])
		theoryHours = toNumber(infoObj['theory_hours'])
		practiceHours = toNumber(infoObj['practice_hours'])

		// 嵌套 specialty 对象
		const specialtyRaw = infoObj['specialty']
		if (specialtyRaw != null) {
			const specObj = specialtyRaw as UTSJSONObject
			specialtyName = toStr(specObj['name'])
			if (courseSpecialtyId == 0) courseSpecialtyId = toNumber(specObj['specialty_id'])
		}

		// 嵌套 level 对象
		const levelRaw = infoObj['level']
		if (levelRaw != null) {
			const lvObj = levelRaw as UTSJSONObject
			levelName = toStr(lvObj['name'])
			if (courseLevelId == 0) courseLevelId = toNumber(lvObj['level_id'])
		}

		// 嵌套 certificate_template 对象
		const certRaw = infoObj['certificate_template']
		if (certRaw != null) {
			const certObj = certRaw as UTSJSONObject
			certificateName = toStr(certObj['name'])
			certificateValidityDays = toNumber(certObj['validity_days'])
		}

		// 前置课程列表
		const prereqRaw = infoObj['prerequisites']
		if (prereqRaw != null) {
			const prereqArr = prereqRaw as Array<UTSJSONObject>
			for (let i = 0; i < prereqArr.length; i++) {
				prerequisites.push(buildCoursePrereq(prereqArr[i]))
			}
		}
	} else {
		courseId = toNumber(obj['course_id'])
		courseTitle = toStr(obj['name'])
		courseDesc = toStr(obj['description'])
		courseCover = toStr(obj['cover_image'])
		courseDuration = toNumber(obj['duration'])
		courseSpecialtyId = toNumber(obj['specialty_id'])
		courseLevelId = toNumber(obj['level_id'])
	}

	// 后端 progress → 前端 progress_pct
	const progressPct = toNumber(obj['progress'])
	// 是否已报名
	const isEnrolled = obj['is_enrolled'] == true
	// 已完成章节数
	const completedChapters = toNumber(obj['completed_chapters'])

	const detail : CourseDetail = {
		course_id: courseId,
		title: courseTitle,
		description: courseDesc,
		cover_url: courseCover,
		duration: courseDuration,
		chapters: chapters,
		progress_pct: progressPct,
		specialty_id: courseSpecialtyId,
		level_id: courseLevelId,
		specialty_name: specialtyName,
		level_name: levelName,
		theory_hours: theoryHours,
		practice_hours: practiceHours,
		certificate_name: certificateName,
		certificate_validity_days: certificateValidityDays,
		is_enrolled: isEnrolled,
		completed_chapters: completedChapters,
		prerequisites: prerequisites,
	} as CourseDetail
	return detail
}

/**
 * 从 UTSJSONObject 构造 CourseListResult
 * @note 后端返回 { courses: [...], total, page, pages }
 *       前端类型用 { items: [...], total, page, page_size }
 */
function buildCourseListResult(obj : UTSJSONObject) : CourseListResult {
	const items : CourseItem[] = []
	// 后端用 "courses" 字段，兼容 "items" 字段
	let listRaw = obj['courses']
	if (listRaw == null) {
		listRaw = obj['items']
	}
	if (listRaw != null) {
		const itemsArray = listRaw as Array<UTSJSONObject>
		for (let i = 0; i < itemsArray.length; i++) {
			items.push(buildCourseItem(itemsArray[i]))
		}
	}
	const result : CourseListResult = {
		items: items,
		total: toNumber(obj['total']),
		page: toNumber(obj['page']),
		// 后端返回 "pages"（总页数），前端用 "page_size"（每页条数）
		// 后端不返回 page_size，用 items 长度推算
		page_size: toNumber(obj['page_size'], items.length > 0 ? items.length : 12),
	} as CourseListResult
	return result
}

/** 从 UTSJSONObject 构造 SpecialtyItem */
function buildSpecialtyItem(obj : UTSJSONObject) : SpecialtyItem {
	const item : SpecialtyItem = {
		specialty_id: toNumber(obj['specialty_id']),
		name: toStr(obj['name']),
	} as SpecialtyItem
	return item
}

/** 从 UTSJSONObject 构造 LevelItem */
function buildLevelItem(obj : UTSJSONObject) : LevelItem {
	const item : LevelItem = {
		level_id: toNumber(obj['level_id']),
		name: toStr(obj['name']),
	} as LevelItem
	return item
}

