/**
 * 课程模块 API
 * - 课程列表（公开）
 * - 课程详情（需要 Token）
 * - 章节幻灯片（公开）
 * - 更新学习进度（需要 Token）
 *
 * @note 后端实际返回的字段名与前端类型定义不同：
 *   列表：后端返回 { courses: [...], pages }，前端类型用 { items: [...], page_size }
 *   课程：后端返回 { name, cover_image }，前端类型用 { title, cover_url }
 *   详情：后端返回 { course_info: {...}, progress }，前端类型用 { course_id, progress_pct }
 *   buildXxx 函数负责字段映射转换
 */
import { get, post } from './request'
import type { CourseListResult, CourseDetail, CourseItem, ChapterItem, ChapterDetail, ChapterFile, CourseCategory } from '../types/index'

/** 安全转换为 number */
function toNumber(v : any | null, defaultVal : number = 0) : number {
	if (v == null) return defaultVal
	const s = `${v}`
	const n = parseFloat(s)
	if (isNaN(n)) return defaultVal
	return n
}

/** 安全转换为 string */
function toStr(v : any | null, defaultVal : string = '') : string {
	if (v == null) return defaultVal
	return `${v}`
}

/**
 * 从 UTSJSONObject 构造 CourseItem
 * @note 后端字段 name → 前端 title，cover_image → cover_url
 *       后端无 chapter_count 字段，默认 0
 */
function buildCourseItem(obj : UTSJSONObject) : CourseItem {
	const item : CourseItem = {
		course_id: toNumber(obj['course_id']),
		title: toStr(obj['name']),           // 后端 name → 前端 title
		category: toStr(obj['category']),
		description: toStr(obj['description']),
		cover_url: toStr(obj['cover_image']), // 后端 cover_image → 前端 cover_url
		duration: toNumber(obj['duration']),
		chapter_count: toNumber(obj['chapter_count']), // 后端不返回此字段，默认 0
		price: toNumber(obj['price']),
		buyers: toNumber(obj['buyers']),
	} as CourseItem
	return item
}

/** 从 UTSJSONObject 构造 ChapterItem */
function buildChapterItem(obj : UTSJSONObject) : ChapterItem {
	const item : ChapterItem = {
		chapter_id: toNumber(obj['chapter_id']),
		title: toStr(obj['title']),
		order_num: toNumber(obj['order_num']),
		duration: toNumber(obj['duration']),
	} as ChapterItem
	return item
}

/** 从 UTSJSONObject 构造 ChapterFile */
function buildChapterFile(obj : UTSJSONObject) : ChapterFile {
	const f : ChapterFile = {
		file_id: toNumber(obj['file_id']),
		file_name: toStr(obj['file_name'], toStr(obj['name'], '附件')),
		file_url: toStr(obj['file_url'], toStr(obj['url'], '')),
		content_type: toStr(obj['content_type'], toStr(obj['type'], 'document')),
	} as ChapterFile
	return f
}

/** 从 UTSJSONObject 构造 ChapterDetail */
function buildChapterDetail(obj : UTSJSONObject) : ChapterDetail {
	const files : ChapterFile[] = []
	const filesRaw = obj['files']
	if (filesRaw != null) {
		const arr = filesRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			files.push(buildChapterFile(arr[i]))
		}
	}
	const detail : ChapterDetail = {
		chapter_id: toNumber(obj['chapter_id']),
		title: toStr(obj['title']),
		content: toStr(obj['content']),
		files: files,
		previous_chapter_id: toNumber(obj['previous_chapter_id']),
		next_chapter_id: toNumber(obj['next_chapter_id']),
		study_status: toStr(obj['study_status']),
		duration: toNumber(obj['duration']),
	} as ChapterDetail
	return detail
}

/**
 * 从 UTSJSONObject 构造 CourseDetail
 * @note 后端返回 { course_info: {...}, chapters: [...], progress: 33.0 }
 *       前端类型用 { course_id, title, chapters, progress_pct }
 */
function buildCourseDetail(obj : UTSJSONObject) : CourseDetail {
	const chapters : ChapterItem[] = []
	const chaptersRaw = obj['chapters']
	if (chaptersRaw != null) {
		const chaptersArray = chaptersRaw as Array<UTSJSONObject>
		for (let i = 0; i < chaptersArray.length; i++) {
			chapters.push(buildChapterItem(chaptersArray[i]))
		}
	}

	// 后端把课程信息嵌套在 course_info 字段中
	let courseInfo = obj['course_info']
	let courseId : number = 0
	let courseTitle : string = ''
	let courseDesc : string = ''
	let courseCategory : string = ''
	let courseCover : string = ''
	let courseDuration : number = 0
	if (courseInfo != null) {
		const infoObj = courseInfo as UTSJSONObject
		courseId = toNumber(infoObj['course_id'])
		courseTitle = toStr(infoObj['name'])            // 后端 name → 前端 title
		courseDesc = toStr(infoObj['description'])
		courseCategory = toStr(infoObj['category'])
		courseCover = toStr(infoObj['cover_image'])     // 后端 cover_image → 前端 cover_url
		courseDuration = toNumber(infoObj['duration'])
	} else {
		// 兼容：某些接口可能直接返回顶层字段
		courseId = toNumber(obj['course_id'])
		courseTitle = toStr(obj['name'])
		courseDesc = toStr(obj['description'])
		courseCategory = toStr(obj['category'])
		courseCover = toStr(obj['cover_image'])
		courseDuration = toNumber(obj['duration'])
	}

	// 后端 progress → 前端 progress_pct
	const progressPct = toNumber(obj['progress'])

	const detail : CourseDetail = {
		course_id: courseId,
		title: courseTitle,
		description: courseDesc,
		category: courseCategory,
		cover_url: courseCover,
		duration: courseDuration,
		chapters: chapters,
		progress_pct: progressPct,
	} as CourseDetail
	return detail
}

/**
 * 从 UTSJSONObject 构造 CourseListResult
 * @note 后端返回 { courses: [...], total, page, pages }
 *       前端类型用 { items: [...], total, page, page_size }
 */
function buildCourseListResult(obj : UTSJSONObject) : CourseListResult {
	const items : CourseItem[] = []
	// 后端用 "courses" 字段，兼容 "items" 字段
	let listRaw = obj['courses']
	if (listRaw == null) {
		listRaw = obj['items']
	}
	if (listRaw != null) {
		const itemsArray = listRaw as Array<UTSJSONObject>
		for (let i = 0; i < itemsArray.length; i++) {
			items.push(buildCourseItem(itemsArray[i]))
		}
	}
	const result : CourseListResult = {
		items: items,
		total: toNumber(obj['total']),
		page: toNumber(obj['page']),
		// 后端返回 "pages"（总页数），前端用 "page_size"（每页条数）
		// 后端不返回 page_size，用 items 长度推算
		page_size: toNumber(obj['page_size'], items.length > 0 ? items.length : 12),
	} as CourseListResult
	return result
}

/** mock 课程分类（网络不可用时回退） */
function getMockCourseCategories() : CourseCategory[] {
	return [
		{ id: 0, name: '全部', value: '' } as CourseCategory,
		{ id: 1, name: '基础理论', value: 'theory' } as CourseCategory,
		{ id: 2, name: '安全规范', value: 'safety' } as CourseCategory,
		{ id: 3, name: '实操技能', value: 'practice' } as CourseCategory,
		{ id: 4, name: '进阶提升', value: 'advanced' } as CourseCategory,
	]
}

/** 获取课程分类列表（动态，从后端获取） */
export function getCourseCategoriesApi() : Promise<CourseCategory[]> {
	return get('/course/categories').then((data : UTSJSONObject) : CourseCategory[] => {
		const list : CourseCategory[] = []
		// 后端可能返回数组或 { categories: [...] } 对象
		let catsRaw = data['categories']
		if (catsRaw == null) {
			// 尝试直接将 data 作为数组处理
			if (data != null) {
				// 检查 data 是否为数组
				const arr = data as Array<UTSJSONObject>
				if (arr != null && arr.length > 0) {
					for (let i = 0; i < arr.length; i++) {
						const obj = arr[i]
						list.push({
							id: toNumber(obj['id'], i),
							name: toStr(obj['name']),
							value: toStr(obj['value'], toStr(obj['code'], toStr(obj['key']))),
						} as CourseCategory)
					}
				}
			}
		} else {
			const arr = catsRaw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				const obj = arr[i]
				list.push({
					id: toNumber(obj['id'], i),
					name: toStr(obj['name']),
					value: toStr(obj['value'], toStr(obj['code'], toStr(obj['key']))),
				} as CourseCategory)
			}
		}
		
		// 确保"全部"分类始终在首位
		const allCategory = { id: 0, name: '全部', value: '' } as CourseCategory
		if (list.length == 0) {
			list.push(allCategory)
		} else if (list[0].value != '') {
			list.splice(0, 0, allCategory)
		}
		
		return list
	}).catch((e) : CourseCategory[] => {
		console.warn('[getCourseCategoriesApi] network failed, using mock data:', e)
		return getMockCourseCategories()
	})
}

