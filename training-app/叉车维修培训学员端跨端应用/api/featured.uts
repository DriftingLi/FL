/**
 * 内容精选 API（公开，无需登录）
 *
 * 接口：
 *   GET  /api/featured-contents               精选列表（分页+分类过滤）
 *   GET  /api/featured-content/:id             精选详情（含相关/上下篇）
 *   POST /api/featured-content/:id/view        浏览计数 +1
 */
import { getMapped, post } from './request'
import { decodePage } from './envelope'
import type { Page } from './envelope'
import { toNumber, toStr } from './helpers'
import type { FeaturedContentItem, FeaturedContentDetail } from '../types/index'



function buildFeaturedItem(obj : UTSJSONObject) : FeaturedContentItem {
	return {
		content_id: toNumber(obj['content_id'], toNumber(obj['id'])),
		title: toStr(obj['title']),
		category: toStr(obj['category']),
		category_label: toStr(obj['category_label']),
		summary: toStr(obj['summary']),
		cover_image: toStr(obj['cover_image']),
		source: toStr(obj['source']),
		status: toStr(obj['status']),
		sort_order: toNumber(obj['sort_order']),
		view_count: toNumber(obj['view_count']),
		published_at: toStr(obj['published_at']),
		created_at: toStr(obj['created_at']),
	} as FeaturedContentItem
}

/** 精选详情映射（T05 手术 #643：收紧至 getMapped 出口，响应字段读取逐行不变） */
function buildFeaturedDetailResult(data : UTSJSONObject) : FeaturedContentDetail {
	const base = buildFeaturedItem(data)
	let prev : FeaturedContentItem | null = null
	let next : FeaturedContentItem | null = null
	const prevRaw = data['prev']
	const nextRaw = data['next']
	if (prevRaw != null) {
		prev = buildFeaturedItem(prevRaw as UTSJSONObject)
	}
	if (nextRaw != null) {
		next = buildFeaturedItem(nextRaw as UTSJSONObject)
	}
	const related : FeaturedContentItem[] = []
	const relatedRaw = data['related']
	if (relatedRaw != null) {
		const arr = relatedRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			related.push(buildFeaturedItem(arr[i]))
		}
	}
	return {
		content_id: base.content_id,
		title: base.title,
		category: base.category,
		category_label: base.category_label,
		summary: base.summary,
		cover_image: base.cover_image,
		source: base.source,
		status: base.status,
		sort_order: base.sort_order,
		view_count: base.view_count,
		published_at: base.published_at,
		created_at: base.created_at,
		content: toStr(data['content']),
		related: related,
		prev: prev,
		next: next,
	} as FeaturedContentDetail
}

/**
 * 精选列表
 * @param page 页码
 * @param pageSize 每页条数
 * @param category 分类过滤（可选，单值：#2063 边界不加多值参数）
 * @param sort 排序（可选）：'latest' 按发布时间 / 'hot' 按浏览量；空串不传（后端缺省 latest）
 */
export function getFeaturedContentsApi(page : number = 1, pageSize : number = 10, category : string = '', sort : string = '') : Promise<Page<FeaturedContentItem>> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	} as UTSJSONObject
	if (category.length > 0) {
		params['category'] = category
	}
	// 排序透传（#1940）：后端 handler.go 早已支持 sort=latest|hot，此前消费侧没传 ⇒ 原型的
	// 「最新资讯 / 热点关注」两个 chip 只能退回缺省值。空串不传，保持既有调用方的行为不变。
	if (sort.length > 0) {
		params['sort'] = sort
	}
	// 装载走信封归一出口 `decodePage`（ADR-0037 PR-B）：数组键 `items`，分页字段只认 total
	return getMapped<Page<FeaturedContentItem>>('/featured-contents', params, (data : UTSJSONObject) : Page<FeaturedContentItem> => decodePage<FeaturedContentItem>(data, '/featured-contents', page, pageSize, (obj : UTSJSONObject) : FeaturedContentItem => buildFeaturedItem(obj), ['items']))
}
/**
 * 精选详情
 * @param contentId 内容 ID
 */
export function getFeaturedContentDetailApi(contentId : number) : Promise<FeaturedContentDetail> {
	return getMapped<FeaturedContentDetail>('/featured-content/' + contentId.toString(), null, (data : UTSJSONObject) : FeaturedContentDetail => buildFeaturedDetailResult(data))
}

/**
 * 浏览计数 +1
 * @param contentId 内容 ID
 */
export function viewFeaturedContentApi(contentId : number) : Promise<void> {
	return post('/featured-content/' + contentId.toString() + '/view').then(() : void => {
		// 无返回数据
	})
}