/**
 * 简历模块 API（对齐后端 JobCardDTO / JobCardInput 契约）
 *
 * T09 resume 手术（parent #647 / ADR-0007）：DTO 出口收敛到 mapper-callback 家族
 * （`getMapped` / `requestMapped`，T01 出口），拆包后的 `data` 一律经本文件的 `build*` 手动映射，
 * 页面层只消费显式 DTO（ADR-0003 手动 JSON 映射同构）。
 * 刻意保留裸透传的三类（白名单，理由在各自函数上）：multipart 上传（无 mapped 便捷面）、
 * void 语义删除（#1198 端点已定，行为与错误传播逐字不变）。
 */
import { getMapped, requestMapped, del, uploadFile } from './request'
import type { RequestOptions } from './request'
import { toStr, toNumber, toBool, errMsg } from './helpers'
import type { ResumeData, SaveResumeParams, ResumeExperience, ResumeCertification, PositionItem } from '../types/index'

// ========== 内部构建函数 ==========

function buildExperience(obj : UTSJSONObject) : ResumeExperience {
	return {
		company: toStr(obj['company']),
		role: toStr(obj['role']),
		start_month: toStr(obj['start_month']),
		end_month: toStr(obj['end_month']),
		desc: toStr(obj['desc']),
	}
}

function buildCertification(obj : UTSJSONObject) : ResumeCertification {
	const imgList : string[] = []
	const imgRaw = obj['image_urls']
	if (imgRaw != null) {
		try {
			const arr = imgRaw as Array<any>
			for (let i = 0; i < arr.length; i++) {
				imgList.push(toStr(arr[i]))
			}
		} catch (_e) {}
	}
	return {
		credential_id: toNumber(obj['credential_id']),
		cert_no: toStr(obj['cert_no']),
		expire_date: toStr(obj['expire_date']),
		image_urls: imgList,
	}
}

function buildResumeData(obj : UTSJSONObject) : ResumeData {
	const expList : ResumeExperience[] = []
	const expRaw = obj['resume_experiences']
	if (expRaw != null) {
		try {
			const arr = expRaw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				expList.push(buildExperience(arr[i]))
			}
		} catch (_e) {}
	}

	const certList : ResumeCertification[] = []
	const certRaw = obj['resume_certifications']
	if (certRaw != null) {
		try {
			const arr = certRaw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				certList.push(buildCertification(arr[i]))
			}
		} catch (_e) {}
	}

	const regionList : string[] = []
	const regionRaw = obj['expected_regions']
	if (regionRaw != null) {
		try {
			const arr = regionRaw as Array<any>
			for (let i = 0; i < arr.length; i++) {
				regionList.push(toStr(arr[i]))
			}
		} catch (_e) {}
	}

	const photoList : string[] = []
	const photoRaw = obj['photos']
	if (photoRaw != null) {
		try {
			const arr = photoRaw as Array<any>
			for (let i = 0; i < arr.length; i++) {
				photoList.push(toStr(arr[i]))
			}
		} catch (_e) {}
	}

	return {
		real_name: toStr(obj['real_name']),
		contact_phone: toStr(obj['contact_phone']),
		wechat: toStr(obj['wechat']),
		region: toStr(obj['region']),
		expected_position_id: toNumber(obj['expected_position_id']),
		expected_position_extra: toStr(obj['expected_position_extra']),
		expected_regions: regionList,
		salary_min: toNumber(obj['salary_min']),
		salary_max: toNumber(obj['salary_max']),
		salary_negotiable: toBool(obj['salary_negotiable']),
		available_in: toStr(obj['available_in']),
		job_nature: toStr(obj['job_nature']),
		experience_years: toNumber(obj['experience_years']),
		self_intro: toStr(obj['self_intro']),
		resume_experiences: expList,
		resume_certifications: certList,
		resume_file_url: toStr(obj['resume_file_url']),
		photos: photoList,
		visibility: toStr(obj['visibility']),
		created_at: toStr(obj['created_at']),
		updated_at: toStr(obj['updated_at']),
	}
}

function buildSavePayload(p : SaveResumeParams) : UTSJSONObject {
	const expArr : UTSJSONObject[] = []
	for (let i = 0; i < p.resume_experiences.length; i++) {
		const e = p.resume_experiences[i]
		expArr.push({
			company: e.company,
			role: e.role,
			start_month: e.start_month,
			end_month: e.end_month,
			desc: e.desc,
		} as UTSJSONObject)
	}

	const certArr : UTSJSONObject[] = []
	for (let i = 0; i < p.resume_certifications.length; i++) {
		const c = p.resume_certifications[i]
		certArr.push({
			credential_id: c.credential_id,
			cert_no: c.cert_no,
			expire_date: c.expire_date,
		} as UTSJSONObject)
	}

	const body : UTSJSONObject = {
		real_name: p.real_name,
		contact_phone: p.contact_phone,
		wechat: p.wechat,
		region: p.region,
		expected_position_extra: p.expected_position_extra,
		salary_negotiable: p.salary_negotiable,
		available_in: p.available_in,
		job_nature: p.job_nature,
		experience_years: p.experience_years,
		self_intro: p.self_intro,
		resume_experiences: expArr,
		resume_certifications: certArr,
		resume_file_url: p.resume_file_url,
		visibility: p.visibility,
	}

	if (p.expected_position_id > 0) {
		body['expected_position_id'] = p.expected_position_id
	} else {
		body['expected_position_id'] = null
	}

	if (p.salary_min > 0) {
		body['salary_min'] = p.salary_min
	} else {
		body['salary_min'] = null
	}

	if (p.salary_max > 0) {
		body['salary_max'] = p.salary_max
	} else {
		body['salary_max'] = null
	}

	// expected_regions / photos 由后端以 json.RawMessage 接收，
	// 直接提交数组（勿 JSON.stringify，否则后端按字符串解析 JSONB 数组会失败）。
	// 整页 upsert：空数组也显式提交 []，否则键被省略会让后端保留旧值而无法清空。
	body['expected_regions'] = p.expected_regions

	body['photos'] = p.photos

	return body
}

/** 岗位字典映射（GET /positions 的 data.positions） */
function buildPositionList(data : UTSJSONObject) : PositionItem[] {
	const list : PositionItem[] = []
	const raw = data['positions']
	if (raw != null) {
		try {
			const arr = raw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				list.push({
					position_id: toNumber(arr[i]['position_id']),
					code: toStr(arr[i]['code']),
					name: toStr(arr[i]['name']),
				})
			}
		} catch (_e) {}
	}
	return list
}

// ========== 对外 API 函数 ==========

/**
 * 获取我的简历
 * GET /resume
 * 已建 → ResumeData；未建（404）→ Error（消息逐字保持，含 '不存在' / '404' 判据）
 * @note `RESUME_NOT_FOUND` 语义与调用方的 notfound 判据是既有形态，本票逐字搬迁不改（缺陷另记 issue）
 */
export function getResumeApi() : Promise<ResumeData> {
	const opts : RequestOptions = { url: '/resume', silent: true } as RequestOptions
	return getMapped<ResumeData>('/resume', null, (data : UTSJSONObject) : ResumeData => buildResumeData(data), opts).catch((e) : ResumeData => {
		const msg = errMsg(e, '')
		if (msg.indexOf('不存在') >= 0 || msg.indexOf('404') >= 0) {
			throw new Error('RESUME_NOT_FOUND: 简历不存在')
		}
		throw new Error(msg)
	})
}

/**
 * 保存简历（PUT /resume 整页 upsert）
 * @returns 服务端返回的最新简历数据
 * @note 走 `requestMapped` + `opts.method` 赋值：与既有 `put()` 逐字同通路（同一 opts.data / method 形态）
 */
export function saveResumeApi(params : SaveResumeParams) : Promise<ResumeData> {
	// silent: 由调用方统一提示保存结果，避免 request 层与页面双重 toast
	const opts : RequestOptions = { url: '/resume', silent: true } as RequestOptions
	opts.method = 'PUT'
	opts.data = buildSavePayload(params)
	return requestMapped<ResumeData>(opts, (data : UTSJSONObject) : ResumeData => buildResumeData(data))
}

/**
 * 切换简历公开状态
 * PUT /resume/visibility
 * @param visibility - "open" 公开 / "hidden" 隐藏
 */
export function setVisibilityApi(visibility : string) : Promise<string> {
	const opts : RequestOptions = { url: '/resume/visibility', silent: true } as RequestOptions
	opts.method = 'PUT'
	opts.data = { visibility: visibility } as UTSJSONObject
	return requestMapped<string>(opts, (data : UTSJSONObject) : string => toStr(data['visibility']))
}

/**
 * 获取简历被查看次数
 * GET /resume/view-stats
 * @note 本函数在移动端**当前零消费**（调用面见契约测试的零消费白名单），保留出口不改消费面
 */
export function getViewStatsApi() : Promise<number> {
	const opts : RequestOptions = { url: '/resume/view-stats', silent: true } as RequestOptions
	return getMapped<number>('/resume/view-stats', null, (data : UTSJSONObject) : number => toNumber(data['count']), opts)
}

/**
 * 获取岗位字典
 * GET /positions
 */
export function getPositionsApi() : Promise<PositionItem[]> {
	const opts : RequestOptions = { url: '/positions', silent: true } as RequestOptions
	return getMapped<PositionItem[]>('/positions', null, (data : UTSJSONObject) : PositionItem[] => buildPositionList(data), opts)
}

/**
 * 上传工作照
 * POST /resume/image (multipart/form-data)
 * @note 裸 `uploadFile` 白名单：mapper-callback 家族没有 multipart 出口，请求形态（表单字段名）不得改
 */
export function uploadWorkPhotoApi(filePath : string) : Promise<string> {
	return uploadFile('/resume/image', filePath, 'file').then((data : UTSJSONObject) : string => {
		return toStr(data['url'])
	})
}

/**
 * 上传简历 PDF
 * POST /resume/pdf (multipart/form-data)
 * @note 裸 `uploadFile` 白名单：同上，multipart 无 mapped 便捷面
 */
export function uploadResumePdfApi(filePath : string) : Promise<string> {
	return uploadFile('/resume/pdf', filePath, 'file').then((data : UTSJSONObject) : string => {
		return toStr(data['url'])
	})
}

/**
 * 删除附件简历（PDF）
 * DELETE /resume/pdf
 * @param type - **仅为兼容既有调用方保留**（唯一调用点 `pages/resume/resume-attach.uvue` 传 'pdf'）。
 *               后端没有 `DELETE /resume/attachment`，也没有删除工作照的端点（工作照只能 POST /image 覆盖）
 *               ⇒ 非 'pdf' 的取值一律按 PDF 处理。
 * @note #1198：本行此前打的是 `DELETE /resume/attachment` —— 一个不存在的端点，真机必 404，
 *             且 404 时调用方的 `.then()` 不执行（本地附件状态清不掉、服务端 PDF 也从未删除）。
 * @note 裸 `del` 白名单：void 语义（无返回体可映射），且端点与调用点由 #1198 的
 *       `resumeAttachmentContract` 逐字钉住 —— 改形态会让那条跨栈守护失配
 */
export function deleteAttachmentApi(type : string) : Promise<void> {
	const opts : RequestOptions = { url: '/resume/pdf' } as RequestOptions
	return del('/resume/pdf', opts).then(() : void => {
		// 删除成功
	})
}
