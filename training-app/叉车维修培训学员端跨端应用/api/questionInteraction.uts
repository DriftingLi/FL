/**
 * 题目互动模块 API
 * - 评论列表 / 发表评论 / 删除评论
 * - 考点标签
 * - 个人笔记 CRUD
 */
import { del, getMapped, postMapped, putMapped } from './request'
import { toNumber, toStr, toBool } from './helpers'
import { decodeList, decodePage } from './envelope'
import type { QuestionComment, CommentListResult, QuestionNote, KnowledgeTag } from '../types/index'




/** 从 UTSJSONObject 构造 QuestionComment */
function buildComment(obj : UTSJSONObject) : QuestionComment {
	return {
		id: toNumber(obj['id']),
		question_id: toNumber(obj['question_id']),
		user_id: toNumber(obj['user_id']),
		username: toStr(obj['username']),
		avatar_url: toStr(obj['avatar_url']),
		content: toStr(obj['content']),
		created_at: toStr(obj['created_at']),
		can_delete: toBool(obj['can_delete']),
	} as QuestionComment
}

/** 从 UTSJSONObject 构造 QuestionNote */
function buildNote(obj : UTSJSONObject) : QuestionNote {
	const rawId = obj['id']
	return {
		id: rawId != null ? toNumber(rawId) : null,
		question_id: toNumber(obj['question_id']),
		content: toStr(obj['content']),
		updated_at: toStr(obj['updated_at']),
	} as QuestionNote
}

/** 从 UTSJSONObject 构造 KnowledgeTag */
function buildKnowledgeTag(obj : UTSJSONObject) : KnowledgeTag {
	return {
		id: toNumber(obj['id']),
		code: toStr(obj['code']),
		name: toStr(obj['name']),
	} as KnowledgeTag
}

// ========== 评论 ==========

/**
 * 获取题目评论列表
 * @note 端点本身不分页（后端一次性返回全部评论），故 `decodePage` 的 `page` / `pageSize`
 *       传占位值 1 / 0，只借它的「数组键 + total」解码面；`hasMore` 不消费。
 */
export function getCommentsApi(questionId : number) : Promise<CommentListResult> {
	const url = `/questions/${questionId}/comments`
	// 装载走信封归一出口 `decodePage`（ADR-0037 PR-D）：原 `data['list'] ?? data['items']` 的手写回退链
	// 收敛为模块默认键序 `['items','list']`（与同文件 getKnowledgeApi 的 PR-B 口径一致）
	return getMapped<CommentListResult>(url, null, (data : UTSJSONObject) : CommentListResult => {
		const paged = decodePage<QuestionComment>(data, url, 1, 0, (obj : UTSJSONObject) : QuestionComment => buildComment(obj))
		return {
			items: paged.items,
			total: paged.total,
		} as CommentListResult
	})
}

/** 发表评论 */
export function createCommentApi(questionId : number, content : string) : Promise<QuestionComment> {
	const payload : UTSJSONObject = { content: content } as UTSJSONObject
	return postMapped<QuestionComment>(`/questions/${questionId}/comments`, payload, (data : UTSJSONObject) : QuestionComment => buildComment(data))
}

/**
 * 删除评论（仅本人可删）
 * @param commentId 评论 ID
 */
export function deleteCommentApi(commentId : number) : Promise<UTSJSONObject> {
	const url = '/questions/comments/' + commentId
	return del(url)
}

// ========== 考点标签 ==========

/** 获取题目考点标签列表 */
export function getKnowledgeApi(questionId : number) : Promise<KnowledgeTag[]> {
	const url = '/questions/' + questionId + '/knowledge'
	// 装载走信封归一出口 `decodeList`（ADR-0037 PR-B）：原 `data['list'] ?? data['items']` 的回退链
	// 收敛为模块默认键序 `['items','list']`
	return getMapped<KnowledgeTag[]>(url, null, (data : UTSJSONObject) : KnowledgeTag[] => decodeList<KnowledgeTag>(data, url, (obj : UTSJSONObject) : KnowledgeTag => buildKnowledgeTag(obj)))
}
// ========== 笔记 ==========

/** 获取个人笔记（无笔记时返回空内容） */
export function getNoteApi(questionId : number) : Promise<QuestionNote> {
	return getMapped<QuestionNote>(`/questions/${questionId}/note`, null, (data : UTSJSONObject) : QuestionNote => buildNote(data))
}

/** 保存笔记（upsert：首次创建，之后更新） */
export function saveNoteApi(questionId : number, content : string) : Promise<QuestionNote> {
	const payload : UTSJSONObject = { content: content } as UTSJSONObject
	return putMapped<QuestionNote>(`/questions/${questionId}/note`, payload, (data : UTSJSONObject) : QuestionNote => buildNote(data))
}

/** 删除笔记 */
export function deleteNoteApi(questionId : number) : Promise<void> {
	return del(`/questions/${questionId}/note`).then(() : void => {})
}
