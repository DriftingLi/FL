/**
 * 证件切换 API
 * GET  /api/me/credential  → 获取当前证件（返回 { credential: {...} | null }）
 * PUT  /api/me/credential  → 切换当前证件（返回 { credential: {...} }）
 *
 * @note 接口域名：training.gccsmile.com（与学员端一致）
 */
import { get, patch } from './request'
import { toNumber, toStr } from './helpers'
import type { CredentialItem, CredentialGroup, CredentialSwitchResult } from '../types/index'

// training 域名下的证件接口（与 www 域名不同）
const TRAINING_API_BASE = 'https://training.gccsmile.com/api'



/**
 * 从 UTSJSONObject 构造 CredentialItem
 * 后端字段：id(number), code, name, category, description, level, sort_order, status, created_at, updated_at
 * @note level 可空（特种作业证无等级，后端返回 null），禁止 as number 强转——Kotlin 下 null 强转即 NPE
 */
function buildCredentialItem(obj : UTSJSONObject) : CredentialItem {
    let level : number | null = null
    const levelRaw = obj['level']
    if (levelRaw != null) {
        level = toNumber(levelRaw)
    }
    return {
        id: toNumber(obj['id']),
        code: toStr(obj['code']),
        name: toStr(obj['name']),
        category: toStr(obj['category']),
        description: toStr(obj['description']),
        level: level,
        sort_order: toNumber(obj['sort_order']),
        status: toNumber(obj['status']),
        created_at: toStr(obj['created_at']),
        updated_at: toStr(obj['updated_at']),
    } as CredentialItem
}

/** 分组名称映射 */
const categoryNameMap : UTSJSONObject = {
    'special_operation': '特种作业配套上岗证',
    'skill_level': '工程机械维修工（叉车维修方向技能等级证）',
}

/** 分组图标映射 */
const categoryIconMap : UTSJSONObject = {
    'special_operation': '🔧',
    'skill_level': '🚜',
}

/**
 * Mock 证件列表（下拉选择器用）
 * 后端 GET /me/credential 只返回当前证件，不返回完整列表
 * 完整证件列表需要通过此 mock 或其他接口获取
 *
 * @note ID 和 code 必须与后端一致：
 *   special_operation: 1=forklift_n1, 2=low_voltage_electrician, 3=welder
 *   skill_level: 4=maintenance_L5, 5=maintenance_L4, 6=maintenance_L3, 7=maintenance_L2, 8=maintenance_L1
 */
function getMockCredentialList() : CredentialItem[] {
    return [
        // 特种作业上岗证
        { id: 1, code: 'forklift_n1', name: '叉车司机N1证', category: 'special_operation', description: '场内专用机动车辆作业-叉车司机N1', level: null, sort_order: 1, status: 1, created_at: '', updated_at: '' } as CredentialItem,
        { id: 2, code: 'low_voltage_electrician', name: '低压电工证', category: 'special_operation', description: '特种作业-低压电工', level: null, sort_order: 2, status: 1, created_at: '', updated_at: '' } as CredentialItem,
        { id: 3, code: 'welder', name: '焊工证', category: 'special_operation', description: '特种作业-熔化焊接与热切割作业', level: null, sort_order: 3, status: 1, created_at: '', updated_at: '' } as CredentialItem,
        // 技能等级证
        { id: 4, code: 'maintenance_L5', name: '工程机械维修工（叉车维修方向）五级', category: 'skill_level', description: '职业技能等级 五级/初级工', level: 5, sort_order: 4, status: 1, created_at: '', updated_at: '' } as CredentialItem,
        { id: 5, code: 'maintenance_L4', name: '工程机械维修工（叉车维修方向）四级', category: 'skill_level', description: '职业技能等级 四级/中级工', level: 4, sort_order: 5, status: 1, created_at: '', updated_at: '' } as CredentialItem,
        { id: 6, code: 'maintenance_L3', name: '工程机械维修工（叉车维修方向）三级', category: 'skill_level', description: '职业技能等级 三级/高级工', level: 3, sort_order: 6, status: 1, created_at: '', updated_at: '' } as CredentialItem,
        { id: 7, code: 'maintenance_L2', name: '工程机械维修工（叉车维修方向）二级', category: 'skill_level', description: '职业技能等级 二级/技师', level: 2, sort_order: 7, status: 1, created_at: '', updated_at: '' } as CredentialItem,
        { id: 8, code: 'maintenance_L1', name: '工程机械维修工（叉车维修方向）一级', category: 'skill_level', description: '职业技能等级 一级/高级技师', level: 1, sort_order: 8, status: 1, created_at: '', updated_at: '' } as CredentialItem,
    ]
}

/** 将证件列表按 category 分组 */
function groupCredentials(items : CredentialItem[]) : CredentialGroup[] {
    const groupOrder : string[] = []
    const groupItems0 : CredentialItem[] = []
    const groupItems1 : CredentialItem[] = []
    const groupMapKeys : string[] = []

    for (let i = 0; i < items.length; i++) {
        const item = items[i]
        const cat = item.category
        let found = false
        for (let k = 0; k < groupMapKeys.length; k++) {
            if (groupMapKeys[k] == cat) {
                found = true
                break
            }
        }
        if (!found) {
            groupMapKeys.push(cat)
            groupOrder.push(cat)
        }
    }

    const groups : CredentialGroup[] = []
    for (let i = 0; i < groupOrder.length; i++) {
        const cat = groupOrder[i]
        const catItems : CredentialItem[] = []
        for (let j = 0; j < items.length; j++) {
            if (items[j].category == cat) {
                catItems.push(items[j])
            }
        }
        const nameRaw = categoryNameMap[cat]
        const name = nameRaw != null ? nameRaw as string : cat
        const iconRaw = categoryIconMap[cat]
        const icon = iconRaw != null ? iconRaw as string : '📋'
        groups.push({
            group_name: name,
            icon: icon,
            category: cat,
            items: catItems,
        } as CredentialGroup)
    }
    return groups
}

// ====== 对外接口 ======

/** 获取当前选中的证件 */
export function getCurrentCredentialApi() : Promise<CredentialItem | null> {
    return get(TRAINING_API_BASE + '/me/credential').then((data : UTSJSONObject) : CredentialItem | null => {
        const credRaw = data['credential']
        if (credRaw != null) {
            return buildCredentialItem(credRaw as UTSJSONObject)
        }
        // API 返回 null，尝试从本地存储恢复
        const savedCode = uni.getStorageSync('selected_cert') as string
        if (savedCode.length > 0) {
            const list = getMockCredentialList()
            for (let i = 0; i < list.length; i++) {
                if (list[i].code == savedCode) {
                    return list[i]
                }
            }
        }
        return null
    }).catch((e) : CredentialItem | null => {
        console.warn('[getCurrentCredentialApi] failed:', e)
        // API 失败，回退到本地存储
        const savedCode = uni.getStorageSync('selected_cert') as string
        if (savedCode.length > 0) {
            const list = getMockCredentialList()
            for (let i = 0; i < list.length; i++) {
                if (list[i].code == savedCode) {
                    return list[i]
                }
            }
        }
        return null
    })
}

/** 获取所有可用证件（按分组组织） */
export function getAllCredentialsApi() : Promise<CredentialGroup[]> {
    // 目前后端 GET /me/credential 只返回当前证件
    // 完整列表从 mock 数据获取，后续如有 /credentials 接口再替换
    return Promise.resolve(groupCredentials(getMockCredentialList()))
}

/** 切换证件 */
export function switchCredentialApi(credentialId : number) : Promise<CredentialSwitchResult> {
    const body : UTSJSONObject = { credential_id: credentialId }
    return patch(TRAINING_API_BASE + '/me/credential', body).then((data : UTSJSONObject) : CredentialSwitchResult => {
        const credRaw = data['credential']
        let credential : CredentialItem | null = null
        if (credRaw != null) {
            credential = buildCredentialItem(credRaw as UTSJSONObject)
        }
        return {
            success: credential != null,
            credential: credential,
        } as CredentialSwitchResult
    }).catch((e) : CredentialSwitchResult => {
        // 后端未实现时，从 mock 列表中查找并模拟切换成功
        console.warn('[switchCredentialApi] failed, using local fallback:', e)
        const list = getMockCredentialList()
        for (let i = 0; i < list.length; i++) {
            if (list[i].id == credentialId) {
                return {
                    success: true,
                    credential: list[i],
                } as CredentialSwitchResult
            }
        }
        return {
            success: false,
            credential: null,
        } as CredentialSwitchResult
    })
}
