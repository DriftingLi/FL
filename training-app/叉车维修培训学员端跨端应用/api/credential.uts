/**
 * 证件切换 API
 * GET   /api/me/credential        → 获取当前证件（返回 { credential: {...} | null }）
 * PATCH /api/me/credential        → 切换当前证件（返回 { credential: {...} }）
 * GET   /api/credentials/grouped  → 证件列表（按类别分组，仅启用项）#1349 起为列表唯一真源
 *
 * @note 接口域名：training.gccsmile.com（与学员端一致）
 */
import { getMapped, requestMapped } from './request'
import type { RequestOptions } from './request'
import { toNumber, toNumberOrNull, toStr } from './helpers'
import type { CredentialItem, CredentialGroup, CredentialSwitchResult } from '../types/index'

// training 域名下的证件接口（与 www 域名不同）
const TRAINING_API_BASE = 'https://training.gccsmile.com/api'



/**
 * 从 UTSJSONObject 构造 CredentialItem
 * 后端字段：id(number), code, name, category, description, level, sort_order, status, created_at, updated_at
 */
function buildCredentialItem(obj : UTSJSONObject) : CredentialItem {
    return {
        id: toNumber(obj['id']),
        code: toStr(obj['code']),
        name: toStr(obj['name']),
        category: toStr(obj['category']),
        description: toStr(obj['description']),
        level: toNumberOrNull(obj['level']),
        sort_order: toNumber(obj['sort_order']),
        status: toNumber(obj['status']),
        created_at: toStr(obj['created_at']),
        updated_at: toStr(obj['updated_at']),
    } as CredentialItem
}

/** 分组名称映射 */
const categoryNameMap : UTSJSONObject = {
    'special_operation': '特种作业配套上岗证',
    'skill_level': '工程机械维修工（叉车维修方向技能等级证）',
}

/** 分组图标映射 */
const categoryIconMap : UTSJSONObject = {
    'special_operation': '🔧',
    'skill_level': '🚜',
}

/**
 * 分组遍历序（#1349）：固定 special_operation → skill_level。
 * 后端 `GroupedCredentialsDTO` 的响应键序按 JSON 键字母序冻结（skill_level 在前，
 * `training_catalog_types.go:160-166` 的 shape-lock），而下拉分组头的既有展示序是特种作业在前
 * —— 本票只切数据源，不附带 UI 变化，故展示序由客户端定、不跟响应键序。
 * 后端只有这两桶（`ListGroupedCredentials` 把非 skill_level 全落 special_operation）；
 * 将来扩桶需要同步这里，并在 `credentialGroupedBehavior.test.js` 重议归组口径。
 */
const groupOrder : string[] = ['special_operation', 'skill_level']

/**
 * 后端 grouped 响应 → CredentialGroup[]
 * 缺键或空桶都**不出组**（后端空集也回 `[]`，不能渲染出一张没有条目的分组头）。
 */
function buildCredentialGroups(data : UTSJSONObject) : CredentialGroup[] {
    const groups : CredentialGroup[] = []
    for (let i = 0; i < groupOrder.length; i++) {
        const cat = groupOrder[i]
        const raw = data[cat]
        if (raw != null) {
            const arr = raw as Array<UTSJSONObject>
            if (arr.length > 0) {
                const items : CredentialItem[] = []
                for (let j = 0; j < arr.length; j++) {
                    items.push(buildCredentialItem(arr[j]))
                }
                const nameRaw = categoryNameMap[cat]
                const name = nameRaw != null ? nameRaw as string : cat
                const iconRaw = categoryIconMap[cat]
                const icon = iconRaw != null ? iconRaw as string : '📋'
                groups.push({
                    group_name: name,
                    icon: icon,
                    category: cat,
                    items: items,
                } as CredentialGroup)
            }
        }
    }
    return groups
}

/**
 * 当前证件的「上一次后端确认值」缓存（#1349，替代原硬编码 mock 字典的离线回退）
 *
 * 原回退查的是 `getMockCredentialList()`：那张表的 id 靠注释约定「必须与后端一致」，
 * 后端字典一漂移（新增 / 停用 / 重编号）就会把过期 id 当真相供出去。改存**后端真正回显过**的
 * id + name：只缓存真源给过的值，不猜。两键都写字符串（跨端 `getStorageSync` 读回 number
 * 的形态不可靠）。写入点在使用方（`use-dashboard-credential.uts` 与引导页 `onConfirm`，#1395）——
 * 不在本层折进 `getCurrentCredentialApi` 的返回里，否则调用方会把缓存项误当后端回显去显示。
 */
export function readCurrentCredentialCache() : CredentialItem | null {
    const name = uni.getStorageSync('selected_cert_name') as string
    if (name.length == 0) {
        return null
    }
    return buildCachedCredentialItem(toNumber(uni.getStorageSync('selected_cert_id') as string), name)
}

export function writeCurrentCredentialCache(credential : CredentialItem | null) : void {
    if (credential == null) {
        // 后端确认「无当前证件」⇒ 缓存两键一起清空：下次网络失败时不得供出上一个证件
        // （#1395：原第三键 selected_cert 的清空写随键退役删除 —— 全仓读 0，存量残留不迁移）
        uni.setStorageSync('selected_cert_id', '')
        uni.setStorageSync('selected_cert_name', '')
        return
    }
    uni.setStorageSync('selected_cert_id', credential.id.toString())
    uni.setStorageSync('selected_cert_name', credential.name)
}

/** 缓存项：只有 id + name（页面消费的正是这两个字段），code 留空 —— 不猜后端编码 */
function buildCachedCredentialItem(id : number, name : string) : CredentialItem {
    return {
        id: id,
        code: '',
        name: name,
        category: '',
        description: '',
        level: null,
        sort_order: 0,
        status: 1,
        created_at: '',
        updated_at: '',
    } as CredentialItem
}

// ====== 对外接口 ======

/** 获取当前选中的证件 */
export function getCurrentCredentialApi() : Promise<CredentialItem | null> {
    return getMapped<CredentialItem | null>(TRAINING_API_BASE + '/me/credential', null, (data : UTSJSONObject) : CredentialItem | null => {
        const credRaw = data['credential']
        if (credRaw != null) {
            return buildCredentialItem(credRaw as UTSJSONObject)
        }
        // 后端确认「未选择证件」⇒ 如实返回 null。离线回退不在本层做（#1349）：
        // 回退读的是 readCurrentCredentialCache()，而它的写入点在使用方 —— 若在此折进返回值，
        // 调用方会把缓存项误当后端回显（缓存项 code 为空，不能当后端确认值消费）。
        return null
    }).catch((e) : CredentialItem | null => {
        // GET 面的「读不到」不当业务失败上抛（#643 原语义保留，交使用方走回退）；
        // 但不再查硬编码字典（#1349：那张表与后端字典漂移 ⇒ 供出后端不存在的证件）
        console.warn('[getCurrentCredentialApi] failed:', e)
        return null
    })
}

/** 获取所有可用证件（按分组组织） */
export function getAllCredentialsApi() : Promise<CredentialGroup[]> {
    // 列表真源 = 后端 GET /api/credentials/grouped（`training_catalog.go:39`，仅启用项、按 sort_order）。
    // 原 `Promise.resolve(groupCredentials(getMockCredentialList()))` 的硬编码字典已整删：
    // 后端一漂移（新增 / 停用 / 重编号）它就静默供出后端没有的证件，切换直接吃 400
    // —— #1346 去掉 `.catch` 兜底后，这条不一致从静默变成用户可见，本票把源头切掉。
    // 失败上抛、不兜假列表（同 #1346 对 switchCredentialApi 的口径），交页面呈现。
    return getMapped<CredentialGroup[]>(TRAINING_API_BASE + '/credentials/grouped', null, (data : UTSJSONObject) : CredentialGroup[] => buildCredentialGroups(data))
}

/** 切换证件（T05 手术 #643：收紧至 requestMapped 出口；PATCH 经 opts 同通路，请求形态与 patch() 逐字一致） */
export function switchCredentialApi(credentialId : number) : Promise<CredentialSwitchResult> {
    const body : UTSJSONObject = { credential_id: credentialId }
    const opts : RequestOptions = { url: TRAINING_API_BASE + '/me/credential' } as RequestOptions
    opts.method = 'PATCH'
    opts.data = body
    // 后端 PATCH /api/me/credential 已实现（training_catalog.go SetCurrentCredential）⇒ 失败
    // （网络 / 500 / 证件校验拒绝）必须上抛，交页面 catch 显示「切换失败」并回滚乐观更新。
    // 不再用 mock 兜成 success:true —— 那是 #643「后端未实现」时代的离线兜底，前提已失效（#1346）。
    return requestMapped<CredentialSwitchResult>(opts, (data : UTSJSONObject) : CredentialSwitchResult => {
        const credRaw = data['credential']
        let credential : CredentialItem | null = null
        if (credRaw != null) {
            credential = buildCredentialItem(credRaw as UTSJSONObject)
        }
        return {
            success: credential != null,
            credential: credential,
        } as CredentialSwitchResult
    })
}
