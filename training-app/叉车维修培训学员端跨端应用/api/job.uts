/**
 * 职位相关 API
 *
 * ## 出口收紧（#652 T14）
 *
 * 两个有载荷的 GET 出口（详情 / 列表）由裸 `get(...).then(...)` 收紧至 mapper-callback
 * 便捷面 `getMapped<T>`（#639 出口家族）：请求形态与字段读取逐行不变，只是出口签名带 DTO、
 * 映射从内联 `.then` 收敛到 `buildJobPosting`（此前详情与列表各复制一份同形映射，一并去重）。
 * DTO 类型迁至 `types/job.uts`（经 `types/index` 消费），本文件只留映射与出口。
 *
 * 留裸 `post` 的两条（void 透传，按 ADR-0007「两问判据」）：`reportJobApi` / `applyJobApi`
 * 后端无 data 载荷、调用方只 await 成败，硬套 identity map 属过度设计 ⇒ 保持原 `post` 通路。
 */
import { getMapped, post } from './request'
import type { JobPosting, JobListParams, JobListResult, ReportReason } from '../types/index'

/** 预设举报原因列表 */
export const REPORT_REASONS : ReportReason[] = [
    { key: 'fake', label: '虚假信息' },
    { key: 'illegal', label: '违法内容' },
    { key: 'harassment', label: '骚扰信息' },
    { key: 'other', label: '其他' },
]

/** 从 UTSJSONObject 构造 JobPosting（详情与列表共用；字段读取与收紧前逐行一致） */
function buildJobPosting(obj : UTSJSONObject) : JobPosting {
    return {
        id: obj['id'] as number,
        title: (obj['title'] as string) ?? '',
        region: (obj['region'] as string) ?? '',
        salary_min: obj['salary_min'] != null ? obj['salary_min'] as number : null,
        salary_max: obj['salary_max'] != null ? obj['salary_max'] as number : null,
        salary_text: (obj['salary_text'] as string) ?? '',
        experience_req: (obj['experience_req'] as string) ?? '',
        description: (obj['description'] as string) ?? '',
        specialty_id: obj['specialty_id'] != null ? obj['specialty_id'] as number : null,
        published_at: (obj['published_at'] as string) ?? '',
        company_name: (obj['company_name'] as string) ?? '',
        status: (obj['status'] as string) ?? 'open',
        forced_offline: (obj['forced_offline'] as boolean) ?? false,
        apply_state: (obj['apply_state'] as string) ?? '',
        cooldown_days: obj['cooldown_days'] != null ? obj['cooldown_days'] as number : null,
    } as JobPosting
}

/** 从 UTSJSONObject 构造 JobListResult（items 逐条走 buildJobPosting，total 直读） */
function buildJobListResult(data : UTSJSONObject) : JobListResult {
    const itemsRaw = (data['items'] as UTSJSONObject[]) ?? []
    const items : JobPosting[] = itemsRaw.map((obj : UTSJSONObject) : JobPosting => buildJobPosting(obj))
    return {
        items: items,
        total: data['total'] as number,
    } as JobListResult
}

/**
 * 获取职位详情
 * @param jobId 职位 ID
 */
export function getJobDetailApi(jobId : number) : Promise<JobPosting> {
    return getMapped<JobPosting>('/jobs/' + jobId, null, (data : UTSJSONObject) : JobPosting => buildJobPosting(data))
}

/**
 * 举报职位
 * @param jobId 职位 ID
 * @param reason 举报原因（1-500 字）
 */
export function reportJobApi(jobId : number, reason : string) : Promise<void> {
    const url = '/jobs/' + jobId + '/report'
    const payload : UTSJSONObject = { reason: reason } as UTSJSONObject
    return post(url, payload).then(() : void => {
        // 举报成功，无返回数据
    })
}

/**
 * 投递职位
 * @param jobId 职位 ID
 */
export function applyJobApi(jobId : number) : Promise<void> {
    const url = '/jobs/' + jobId + '/apply'
    return post(url).then(() : void => {
        // 投递成功，无返回数据
    })
}

/**
 * 职位广场列表（学员侧，仅 open 且未强制下架）
 * @param params 查询参数（可选）
 */
export function getJobListApi(params : JobListParams = {}) : Promise<JobListResult> {
    const query : UTSJSONObject = {} as UTSJSONObject
    if (params.page != null && params.page! > 0) query['page'] = params.page!.toString()
    if (params.page_size != null && params.page_size! > 0) query['page_size'] = params.page_size!.toString()
    if (params.specialty_id != null && params.specialty_id! > 0) query['specialty_id'] = params.specialty_id!.toString()
    if (params.region != null && params.region!.length > 0) query['region'] = params.region!
    if (params.salary_min != null) query['salary_min'] = params.salary_min!.toString()
    if (params.salary_max != null) query['salary_max'] = params.salary_max!.toString()
    if (params.experience != null && params.experience!.length > 0) query['experience'] = params.experience!

    const qsParts : string[] = []
    for (const k in query) {
        qsParts.push(encodeURIComponent(k) + '=' + encodeURIComponent(query[k] as string))
    }
    const qs = qsParts.join('&')
    const url = '/jobs' + (qs.length > 0 ? '?' + qs : '')

    return getMapped<JobListResult>(url, null, (data : UTSJSONObject) : JobListResult => buildJobListResult(data))
}
