/**
 * 课程考核 API
 * @note 后端返回的题目字段与前端类型不同：
 *   后端 question_text → 前端 title
 *   后端 options 是 Map{A:"text"} → 前端是 Array[{key,text}]
 *   后端 answer → 前端无对应（ExamQuestion 不含答案）
 */
import { get, post } from './request'
import type { ExamQuestion, QuestionOption, ExamSubmitParams, ExamResult } from '../types/index'

/** 安全转换为 number */
function toNumber(v : any | null, defaultVal : number = 0) : number {
	if (v == null) return defaultVal
	const s = `${v}`
	const n = parseFloat(s)
	if (isNaN(n)) return defaultVal
	return n
}

/** 安全转换为 string */
function toStr(v : any | null, defaultVal : string = '') : string {
	if (v == null) return defaultVal
	return `${v}`
}

/** 安全转换为 boolean */
function toBool(v : any | null, defaultVal : boolean = false) : boolean {
	if (v == null) return defaultVal
	const s = `${v}`
	return s == 'true' || s == '1'
}

/**
 * 将后端 options Map 转换为前端 Array<{key, text}>
 * 后端格式：{"A": "选项A", "B": "选项B"}
 */
function buildOptions(raw : any | null) : QuestionOption[] {
	const options : QuestionOption[] = []
	if (raw == null) return options
	const optsMap = raw as UTSJSONObject
	for (const k in optsMap) {
		const opt : QuestionOption = {
			key: k,
			text: toStr(optsMap[k]),
		} as QuestionOption
		options.push(opt)
	}
	return options
}

/** 从 UTSJSONObject 构造 ExamQuestion */
function buildExamQuestion(obj : UTSJSONObject) : ExamQuestion {
	const q : ExamQuestion = {
		question_id: toNumber(obj['question_id']),
		type: toStr(obj['type']),
		title: toStr(obj['question_text']),   // 后端 question_text → 前端 title
		options: buildOptions(obj['options']),
		score: toNumber(obj['score']),
	} as ExamQuestion
	return q
}

/** 从 UTSJSONObject 构造 ExamResult */
function buildExamResult(obj : UTSJSONObject) : ExamResult {
	const details : UTSJSONObject[] = []
	const detailsRaw = obj['details']
	if (detailsRaw != null) {
		const detailsArray = detailsRaw as Array<UTSJSONObject>
		for (let i = 0; i < detailsArray.length; i++) {
			details.push(detailsArray[i])
		}
	}
	const result : ExamResult = {
		score: toNumber(obj['score']),
		total_score: toNumber(obj['total_score']),
		passed: toBool(obj['passed']),
		details: details,
	} as ExamResult
	return result
}

/**
 * 获取考核题目
 * @param courseId 课程 ID
 * @note 后端返回 { questions: [...], total_score, total_questions }
 */
export function getExamQuestionsApi(courseId : number) : Promise<ExamQuestion[]> {
	const url = '/exam/' + courseId
	return get(url).then((data : UTSJSONObject) : ExamQuestion[] => {
		console.log('[getExamQuestionsApi] raw data:', JSON.stringify(data))
		const questions : ExamQuestion[] = []
		let listRaw = data['questions']
		if (listRaw == null) {
			listRaw = data['items']
		}
		if (listRaw != null) {
			const arr = listRaw as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				questions.push(buildExamQuestion(arr[i]))
			}
		}
		return questions
	}).catch((e) : ExamQuestion[] => {
		console.error('[getExamQuestionsApi] failed:', e)
		let msg = '获取考核题目失败'
		if (e instanceof Error) {
			const errObj = e as Error
			const m = errObj.message
			if (m != null && m.length > 0) {
				msg = msg + ': ' + m
			}
		}
		throw new Error(msg)
	})
}

/**
 * 提交考核
 * @param courseId 课程 ID
 * @param answers 答案对象 { 题号: 答案 }
 */
export function submitExamApi(courseId : number, answers : UTSJSONObject) : Promise<UTSJSONObject> {
	const url = '/exam/' + courseId + '/submit'
	const payload : UTSJSONObject = {
		answers: answers
	} as UTSJSONObject
	return post(url, payload)
}

/**
 * 获取最近考核结果
 * @param courseId 课程 ID
 */
export function getExamResultApi(courseId : number) : Promise<UTSJSONObject> {
	const url = '/exam/' + courseId + '/result'
	return get(url)
}

/** 获取考核历史 */
export function getExamHistoryApi() : Promise<UTSJSONObject> {
	return get('/exam/history')
}
