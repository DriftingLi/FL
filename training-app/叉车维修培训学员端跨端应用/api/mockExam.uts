/**
 * 模拟考试 API
 * @note 后端返回的题目使用 questionToDict 格式：
 *   id → question_id, content → title, options 是 Map → Array
 */
import { get, post } from './request'
import type { MockExamStartParams, MockExamInfo, MockExamSaveParams, MockExamResult, MockExamResultDetail, MockExamHistoryItem, MockExamHistoryResult, ExamQuestion, QuestionOption } from '../types/index'

/** 安全转换为 number */
function toNumber(v : any | null, defaultVal : number = 0) : number {
	if (v == null) return defaultVal
	const s = `${v}`
	const n = parseFloat(s)
	if (isNaN(n)) return defaultVal
	return n
}

/** 安全转换为 string */
function toStr(v : any | null, defaultVal : string = '') : string {
	if (v == null) return defaultVal
	return `${v}`
}

/** 安全转换为 boolean */
function toBool(v : any | null, defaultVal : boolean = false) : boolean {
	if (v == null) return defaultVal
	const s = `${v}`
	return s == 'true' || s == '1'
}

/**
 * 将后端 options Map 转换为前端 Array<{key, text}>
 */
function buildOptions(raw : any | null) : QuestionOption[] {
	const options : QuestionOption[] = []
	if (raw == null) return options
	const optsMap = raw as UTSJSONObject
	for (const k in optsMap) {
		const opt : QuestionOption = {
			key: k,
			text: toStr(optsMap[k]),
		} as QuestionOption
		options.push(opt)
	}
	return options
}

/** 从 UTSJSONObject 构造 ExamQuestion */
function buildExamQuestion(obj : UTSJSONObject) : ExamQuestion {
	const q : ExamQuestion = {
		question_id: toNumber(obj['id']),              // 后端 id → 前端 question_id
		type: toStr(obj['type']),
		title: toStr(obj['content']),                  // 后端 content → 前端 title
		options: buildOptions(obj['options']),
		score: toNumber(obj['score']),
	} as ExamQuestion
	return q
}

/** 从 UTSJSONObject 构造 MockExamInfo */
function buildMockExamInfo(obj : UTSJSONObject) : MockExamInfo {
	const questions : ExamQuestion[] = []
	const questionsRaw = obj['questions']
	if (questionsRaw != null) {
		const questionsArray = questionsRaw as Array<UTSJSONObject>
		for (let i = 0; i < questionsArray.length; i++) {
			questions.push(buildExamQuestion(questionsArray[i]))
		}
	}
	const info : MockExamInfo = {
		mock_exam_id: toNumber(obj['mock_exam_id']),
		questions: questions,
		duration: toNumber(obj['duration']),
		remaining_time: toNumber(obj['remaining_time']),
	} as MockExamInfo
	return info
}

/** 从 UTSJSONObject 构造 MockExamResultDetail（单题） */
function buildMockExamResultDetail(obj : UTSJSONObject) : MockExamResultDetail {
	const detail : MockExamResultDetail = {
		question_id: toNumber(obj['question_id'], toNumber(obj['id'])),
		title: toStr(obj['title'], toStr(obj['content'], toStr(obj['question_text']))),
		type: toStr(obj['type']),
		user_answer: toStr(obj['user_answer'], toStr(obj['answer'])),
		correct_answer: toStr(obj['correct_answer'], toStr(obj['correct'])),
		is_correct: toBool(obj['is_correct'], toBool(obj['correct'])),
	} as MockExamResultDetail
	return detail
}

/** 从 UTSJSONObject 构造 MockExamResult */
function buildMockExamResult(obj : UTSJSONObject) : MockExamResult {
	const details : MockExamResultDetail[] = []
	const detailsRaw = obj['details']
	if (detailsRaw != null) {
		const detailsArray = detailsRaw as Array<UTSJSONObject>
		for (let i = 0; i < detailsArray.length; i++) {
			details.push(buildMockExamResultDetail(detailsArray[i]))
		}
	}
	const result : MockExamResult = {
		mock_exam_id: toNumber(obj['mock_exam_id'], toNumber(obj['exam_id'])),
		score: toNumber(obj['score']),
		total_score: toNumber(obj['total_score'], toNumber(obj['full_score'])),
		passed: toBool(obj['passed'], toBool(obj['is_passed'])),
		correct_count: toNumber(obj['correct_count'], toNumber(obj['correct'])),
		total_questions: toNumber(obj['total_questions'], toNumber(obj['question_count'])),
		used_time: toNumber(obj['used_time'], toNumber(obj['duration'])),
		details: details,
	} as MockExamResult
	return result
}

/** 从 UTSJSONObject 构造 MockExamHistoryItem */
function buildMockExamHistoryItem(obj : UTSJSONObject) : MockExamHistoryItem {
	const item : MockExamHistoryItem = {
		mock_exam_id: toNumber(obj['mock_exam_id'], toNumber(obj['exam_id'], toNumber(obj['id']))),
		score: toNumber(obj['score']),
		total_score: toNumber(obj['total_score'], toNumber(obj['full_score'])),
		passed: toBool(obj['passed'], toBool(obj['is_passed'])),
		correct_count: toNumber(obj['correct_count'], toNumber(obj['correct'])),
		total_questions: toNumber(obj['total_questions'], toNumber(obj['question_count'])),
		duration: toNumber(obj['duration']),
		used_time: toNumber(obj['used_time'], toNumber(obj['time_used'])),
		status: toStr(obj['status'], 'completed'),
		created_at: toStr(obj['created_at'], toStr(obj['start_time'])),
		completed_at: toStr(obj['completed_at'], toStr(obj['end_time'], toStr(obj['submit_time']))),
	} as MockExamHistoryItem
	return item
}

/** 从 UTSJSONObject 构造 MockExamHistoryResult */
function buildMockExamHistoryResult(data : UTSJSONObject) : MockExamHistoryResult {
	const items : MockExamHistoryItem[] = []
	const listRaw = data['items']
	if (listRaw != null) {
		const arr = listRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			items.push(buildMockExamHistoryItem(arr[i]))
		}
	} else {
		// 后端可能用 records / history 字段
		const alt = data['records']
		if (alt != null) {
			const arr = alt as Array<UTSJSONObject>
			for (let i = 0; i < arr.length; i++) {
				items.push(buildMockExamHistoryItem(arr[i]))
			}
		}
	}
	const result : MockExamHistoryResult = {
		items: items,
		total: toNumber(data['total']),
		page: toNumber(data['page'], 1),
		page_size: toNumber(data['page_size'], 10),
	} as MockExamHistoryResult
	return result
}

/** mock 模拟考试题目（网络不可用时回退） */
function getMockMockExamInfo(duration : number) : MockExamInfo {
	const options : QuestionOption[] = [
		{ key: 'A', text: '降低车速，鸣笛示意' } as QuestionOption,
		{ key: 'B', text: '加速通过' } as QuestionOption,
		{ key: 'C', text: '停车检查' } as QuestionOption,
		{ key: 'D', text: '继续作业' } as QuestionOption,
	]
	const questions : ExamQuestion[] = [
		{ question_id: 1, type: 'single', title: '叉车在厂区内行驶时，遇到行人应如何处理？', options: options, score: 2.5 } as ExamQuestion,
		{ question_id: 2, type: 'single', title: '叉车作业前，应检查哪些部位？', options: options, score: 2.5 } as ExamQuestion,
		{ question_id: 3, type: 'single', title: '叉车装卸货物时，货叉应保持什么角度？', options: options, score: 2.5 } as ExamQuestion,
		{ question_id: 4, type: 'single', title: '叉车夜间作业时，照明要求是什么？', options: options, score: 2.5 } as ExamQuestion,
	]
	return {
		mock_exam_id: 9001,
		questions: questions,
		duration: duration,
		remaining_time: duration * 60,
	} as MockExamInfo
}

/**
 * 开始模拟考试
 * @param count 题目数量，默认 0（后端使用默认值 40）
 * @param duration 考试时长（分钟），默认 90
 */
export function startMockExamApi(count : number = 0, duration : number = 90) : Promise<MockExamInfo> {
	const payload : UTSJSONObject = {
		count: count,
		duration: duration
	} as UTSJSONObject
	return post('/mock-exam/start', payload).then((data : UTSJSONObject) : MockExamInfo => {
		console.log('[startMockExamApi] raw data:', JSON.stringify(data))
		return buildMockExamInfo(data)
	}).catch((e) : MockExamInfo => {
		// 网络不可用时回退到 mock 题目，避免用户卡在"正在组卷"loading
		console.warn('[startMockExamApi] network failed, using mock data:', e)
		return getMockMockExamInfo(duration)
	})
}

/**
 * 保存模拟考试进度
 * @param mockExamId 模拟考试 ID
 * @param answers 答案对象
 * @param remainingTime 剩余时间（秒）
 */
export function saveMockExamApi(mockExamId : number, answers : UTSJSONObject, remainingTime : number) : Promise<UTSJSONObject> {
	const url = '/mock-exam/' + mockExamId + '/save'
	const payload : UTSJSONObject = {
		answers: answers,
		remaining_time: remainingTime
	} as UTSJSONObject
	return post(url, payload)
}

/**
 * 恢复模拟考试
 * @param mockExamId 模拟考试 ID
 */
export function resumeMockExamApi(mockExamId : number) : Promise<MockExamInfo> {
	const url = '/mock-exam/' + mockExamId + '/resume'
	return get(url).then((data : UTSJSONObject) : MockExamInfo => {
		console.log('[resumeMockExamApi] raw data:', JSON.stringify(data))
		return buildMockExamInfo(data)
	}).catch((e) : MockExamInfo => {
		console.error('[resumeMockExamApi] failed:', e)
		let msg = '恢复模拟考试失败'
		if (e instanceof Error) {
			const errObj = e as Error
			const m = errObj.message
			if (m != null && m.length > 0) {
				msg = msg + ': ' + m
			}
		}
		throw new Error(msg)
	})
}

/**
 * 交卷
 * @param mockExamId 模拟考试 ID
 */
export function submitMockExamApi(mockExamId : number) : Promise<UTSJSONObject> {
	const url = '/mock-exam/' + mockExamId + '/submit'
	return post(url, null)
}

/**
 * 获取模拟考试成绩
 * @param mockExamId 模拟考试 ID
 */
export function getMockExamResultApi(mockExamId : number) : Promise<MockExamResult> {
	const url = '/mock-exam/' + mockExamId + '/result'
	return get(url).then((data : UTSJSONObject) : MockExamResult => {
		console.log('[getMockExamResultApi] raw data:', JSON.stringify(data))
		return buildMockExamResult(data)
	})
}

/**
 * 获取模拟考试历史
 * @param page 页码，默认 1
 * @param pageSize 每页条数，默认 10
 */
export function getMockExamHistoryApi(page : number = 1, pageSize : number = 10) : Promise<MockExamHistoryResult> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	} as UTSJSONObject
	return get('/mock-exam/history', params).then((data : UTSJSONObject) : MockExamHistoryResult => {
		console.log('[getMockExamHistoryApi] raw data:', JSON.stringify(data))
		return buildMockExamHistoryResult(data)
	}).catch((e) : MockExamHistoryResult => {
		console.warn('[getMockExamHistoryApi] network failed:', e)
		return { items: [] as MockExamHistoryItem[], total: 0, page: page, page_size: pageSize } as MockExamHistoryResult
	})
}
