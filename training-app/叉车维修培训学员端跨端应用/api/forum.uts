/**
 * 论坛 API
 * @note 后端响应已由 request 层自动解包 data 字段
 *
 * 帖子列表实际响应：
 *   { page, pages, topics: [{ id, chapter_id, chapter_title, title, content,
 *     view_count, reply_count, last_reply_at, created_at,
 *     author: { user_id, username, name, nickname, avatar_url }, can_delete }], total }
 *
 * 帖子详情实际响应（推断，含 replies 数组）：
 *   { id, title, content, view_count, reply_count, created_at,
 *     author: {...}, replies: [{ id, content, created_at, author: {...} }] }
 *
 * 回复对象：{ id, content, created_at, author: { user_id, username, name, nickname, avatar_url } }
 */
import { get, post, del, uploadFile } from './request'
import type { ForumTopic, ForumTopicListResult, ForumTopicDetail, ForumReply } from '../types/index'

/** 安全转换为 number */
function toNumber(v : any | null, defaultVal : number = 0) : number {
    if (v == null) return defaultVal
    const s = `${v}`
    const n = parseFloat(s)
    if (isNaN(n)) return defaultVal
    return n
}

/** 安全转换为 string */
function toStr(v : any | null, defaultVal : string = '') : string {
	if (v == null) return defaultVal
	return `${v}`
}

/** 安全转换为 boolean（兼容 boolean / "true" / "1" / 1，避免使用 typeof） */
function toBool(v : any | null, defaultVal : boolean = false) : boolean {
	if (v == null) return defaultVal
	const s = `${v}`.toLowerCase()
	if (s == 'true') return true
	if (s == '1') return true
	return defaultVal
}

/** 从 author 嵌套对象提取作者名（优先 name，其次 nickname，最后 username） */
function extractAuthorName(obj : UTSJSONObject) : string {
    const authorRaw = obj['author']
    if (authorRaw != null) {
        const authorObj = authorRaw as UTSJSONObject
        // 优先 name（非空）
        // const name = authorObj['name']
        // if (name != null) {
        //     const s = toStr(name)
        //     if (s.length > 0) return s
        // }
        // 其次 nickname（非空）
        const nickname = authorObj['nickname']
        if (nickname != null) {
            const s = toStr(nickname)
            if (s.length > 0) return s
        }
        // 最后 username
        const username = authorObj['username']
        if (username != null) return toStr(username)
    }
    // 兼容旧格式 author_name 顶层字段
    const direct = obj['author_name']
    if (direct != null) return toStr(direct)
    return ''
}

/** 从 author 嵌套对象提取作者 ID */
function extractAuthorId(obj : UTSJSONObject) : number {
    const authorRaw = obj['author']
    if (authorRaw != null) {
        const authorObj = authorRaw as UTSJSONObject
        const uid = authorObj['user_id']
        if (uid != null) return toNumber(uid)
        const id = authorObj['id']
        if (id != null) return toNumber(id)
    }
    // 兼容旧格式 author_id 顶层字段
    const direct = obj['author_id']
    if (direct != null) return toNumber(direct)
    return 0
}

/** 从 author 嵌套对象提取作者头像 URL */
function extractAuthorAvatar(obj : UTSJSONObject) : string {
    const authorRaw = obj['author']
    if (authorRaw != null) {
        const authorObj = authorRaw as UTSJSONObject
        const avatar = authorObj['avatar_url']
        if (avatar != null) return toStr(avatar)
    }
    // 兼容旧格式 author_avatar 顶层字段
    const direct = obj['author_avatar']
    if (direct != null) return toStr(direct)
    return ''
}

/** 从对象提取 images 图片 URL 数组（后端字段名同为 images） */
function extractImages(obj : UTSJSONObject) : string[] {
    const images : string[] = []
    const raw = obj['images']
    if (raw != null) {
        const imagesArray = raw as Array<string>
        for (let i = 0; i < imagesArray.length; i++) {
            images.push(toStr(imagesArray[i]))
        }
    }
    return images
}

/** 构造 ForumReply
 *  后端回复对象字段：{ id, content, created_at, author: {...} }
 *  topic_id 后端未必返回，由调用方传入
 */
function buildReply(obj : UTSJSONObject, fallbackTopicId : number = 0) : ForumReply {
	const reply : ForumReply = {
		id: toNumber(obj['id']),
		topic_id: toNumber(obj['topic_id'], fallbackTopicId),
		topic_title: toStr(obj['topic_title']),
		content: toStr(obj['content']),
		images: extractImages(obj),
		author_id: extractAuthorId(obj),
		author_name: extractAuthorName(obj),
		author_avatar: extractAuthorAvatar(obj),
		created_at: toStr(obj['created_at']),
		can_delete: toBool(obj['can_delete']),
	} as ForumReply
	return reply
}

/** 构造 ForumTopic（列表项）
 *  后端字段：view_count / reply_count（非 views_count / replies_count）
 */
function buildTopic(obj : UTSJSONObject) : ForumTopic {
    const topic : ForumTopic = {
        id: toNumber(obj['id']),
        title: toStr(obj['title']),
        content: toStr(obj['content']),
        images: extractImages(obj),
        author_id: extractAuthorId(obj),
        author_name: extractAuthorName(obj),
        author_avatar: extractAuthorAvatar(obj),
        replies_count: toNumber(obj['reply_count']),
        views_count: toNumber(obj['view_count']),
        like_count: toNumber(obj['like_count']),
        liked: toBool(obj['liked']),
        created_at: toStr(obj['created_at']),
    } as ForumTopic
    return topic
}

/** 构造 ForumTopicListResult
 *  后端字段：topics（非 items）、pages（非 page_size）、page、total
 */
function buildTopicListResult(obj : UTSJSONObject) : ForumTopicListResult {
    const items : ForumTopic[] = []
    // 后端用 topics 字段返回帖子数组
    const topicsRaw = obj['topics']
    if (topicsRaw != null) {
        const topicsArray = topicsRaw as Array<UTSJSONObject>
        for (let i = 0; i < topicsArray.length; i++) {
            items.push(buildTopic(topicsArray[i]))
        }
    }
    const result : ForumTopicListResult = {
        items: items,
        total: toNumber(obj['total']),
        page: toNumber(obj['page']),
        page_size: toNumber(obj['pages']),
    } as ForumTopicListResult
    return result
}

/** 构造 ForumTopicDetail（含回复列表）
 *  后端实际响应：{ topic: { id, title, content, view_count, reply_count, ...,
 *    author: {...}, can_delete }, replies: [{ id, content, created_at, author: {...} }] }
 *  注意：帖子信息在 topic 子对象里，replies 在顶层
 */
function buildTopicDetail(obj : UTSJSONObject) : ForumTopicDetail {
    // 帖子主体在 topic 子对象里
    const topicRaw = obj['topic']
    let topicObj : UTSJSONObject = obj
    if (topicRaw != null) {
        topicObj = topicRaw as UTSJSONObject
    }
    const topicId = toNumber(topicObj['id'])

    // 回复列表在顶层 replies
    const replies : ForumReply[] = []
    const repliesRaw = obj['replies']
    if (repliesRaw != null) {
        const repliesArray = repliesRaw as Array<UTSJSONObject>
        for (let i = 0; i < repliesArray.length; i++) {
            replies.push(buildReply(repliesArray[i], topicId))
        }
    }

    const detail : ForumTopicDetail = {
        id: topicId,
        title: toStr(topicObj['title']),
        content: toStr(topicObj['content']),
        images: extractImages(topicObj),
        author_id: extractAuthorId(topicObj),
        author_name: extractAuthorName(topicObj),
        author_avatar: extractAuthorAvatar(topicObj),
        replies_count: toNumber(topicObj['reply_count']),
        views_count: toNumber(topicObj['view_count']),
        like_count: toNumber(topicObj['like_count']),
        liked: toBool(topicObj['liked']),
		created_at: toStr(topicObj['created_at']),
		can_delete: toBool(topicObj['can_delete']),
		replies: replies,
	} as ForumTopicDetail
	return detail
}

/**
 * 获取帖子列表
 * @param page 页码，默认 1
 * @param pageSize 每页条数，默认 10
 * @param scope 范围，默认 general
 */
export function getForumTopicsApi(page : number = 1, pageSize : number = 10, scope : string = 'general') : Promise<ForumTopicListResult> {
    const params : UTSJSONObject = {
        scope: scope,
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return get('/forum/topics', params).then((data : UTSJSONObject) : ForumTopicListResult => {
        console.log('[getForumTopicsApi] raw data:', JSON.stringify(data))
        return buildTopicListResult(data)
    }).catch((e : any | null) : ForumTopicListResult => {
        console.error('[getForumTopicsApi] failed:', e)
        let msg = '获取帖子列表失败'
        if (e instanceof Error) {
            const err = e as Error
            const m = err.message
            if (m != null && m.length > 0) {
                msg = m
            }
        }
        throw new Error(msg)
    })
}

/**
 * 获取帖子详情
 * @param topicId 帖子 ID
 */
export function getForumTopicDetailApi(topicId : number) : Promise<ForumTopicDetail> {
    const url = '/forum/topics/' + topicId
    return get(url).then((data : UTSJSONObject) : ForumTopicDetail => {
        console.log('[getForumTopicDetailApi] raw data:', JSON.stringify(data))
        return buildTopicDetail(data)
    }).catch((e : any | null) : ForumTopicDetail => {
        console.error('[getForumTopicDetailApi] failed:', e)
        let msg = '获取帖子详情失败'
        if (e instanceof Error) {
            const err = e as Error
            const m = err.message
            if (m != null && m.length > 0) {
                msg = m
            }
        }
        throw new Error(msg)
    })
}

/**
 * 上传论坛图片
 * @param filePath 本地图片路径（uni.chooseImage 返回值）
 * @returns 上传成功后的图片 URL（相对或绝对路径，提交发帖/回复时原样回传）
 */
export function uploadForumImageApi(filePath : string) : Promise<string> {
    // 与 auth.uts 同款 3 参调用（UTS 对带默认值参数的第 4/5 位置实参会触发 overload 解析错误，勿传）
    return uploadFile('/forum/upload-image', filePath, 'file').then((data : UTSJSONObject) : string => {
        const url = data['url']
        if (url == null) {
            throw new Error('上传成功但未返回图片地址')
        }
        return toStr(url)
    }).catch((e : any | null) : string => {
        console.error('[uploadForumImageApi] failed:', e)
        let msg = '上传图片失败'
        if (e instanceof Error) {
            const err = e as Error
            const m = err.message
            if (m != null && m.length > 0) {
                msg = m
            }
        }
        throw new Error(msg)
    })
}

/**
 * 发布新帖
 * @param title 标题（1-100 字）
 * @param content 内容（1-10000 字）
 * @param images 图片 URL 数组（最多 9 张，先经 uploadForumImageApi 上传获取）
 */
export function createForumTopicApi(title : string, content : string, images : string[] = []) : Promise<ForumTopic> {
    const payload : UTSJSONObject = {
        title: title,
        content: content,
        images: images,
    } as UTSJSONObject
    return post('/forum/topics', payload).then((data : UTSJSONObject) : ForumTopic => {
        console.log('[createForumTopicApi] raw data:', JSON.stringify(data))
        return buildTopic(data)
    }).catch((e : any | null) : ForumTopic => {
        console.error('[createForumTopicApi] failed:', e)
        let msg = '发布帖子失败'
        if (e instanceof Error) {
            const err = e as Error
            const m = err.message
            if (m != null && m.length > 0) {
                msg = m
            }
        }
        throw new Error(msg)
    })
}

/**
 * 回复帖子
 * @param topicId 帖子 ID
 * @param content 回复内容
 * @param images 图片 URL 数组（最多 3 张，先经 uploadForumImageApi 上传获取）
 */
export function replyForumTopicApi(topicId : number, content : string, images : string[] = []) : Promise<ForumReply> {
    const url = '/forum/topics/' + topicId + '/replies'
    const payload : UTSJSONObject = {
        content: content,
        images: images,
    } as UTSJSONObject
    return post(url, payload).then((data : UTSJSONObject) : ForumReply => {
        console.log('[replyForumTopicApi] raw data:', JSON.stringify(data))
        return buildReply(data, topicId)
    }).catch((e : any | null) : ForumReply => {
        console.error('[replyForumTopicApi] failed:', e)
        let msg = '回复失败'
        if (e instanceof Error) {
            const err = e as Error
            const m = err.message
            if (m != null && m.length > 0) {
                msg = m
            }
        }
        throw new Error(msg)
    })
}

/**
 * 删除帖子（贴主删除自己的帖子）
 * @param topicId 帖子 ID
 */
export function deleteForumTopicApi(topicId : number) : Promise<UTSJSONObject> {
    const url = '/forum/topics/' + topicId
    return del(url)
}

/**
 * 删除回复
 * @param replyId 回复 ID
 */
export function deleteForumReplyApi(replyId : number) : Promise<UTSJSONObject> {
    const url = '/forum/replies/' + replyId
    return del(url)
}

// ===== 新增接口：点赞 / 取消点赞 / 举报 / 我的帖子 / 我的回复 =====

/**
 * 点赞帖子
 * @param topicId 帖子 ID
 */
export function likeTopicApi(topicId : number) : Promise<{liked : boolean, like_count : number}> {
    const url = '/forum/topics/' + topicId + '/like'
    return post(url).then((data : UTSJSONObject) : {liked : boolean, like_count : number} => {
        return {
            liked: toBool(data['liked']),
            like_count: toNumber(data['like_count']),
        }
    })
}

/**
 * 取消点赞帖子
 * @param topicId 帖子 ID
 */
export function unlikeTopicApi(topicId : number) : Promise<{liked : boolean, like_count : number}> {
    const url = '/forum/topics/' + topicId + '/like'
    return del(url).then((data : UTSJSONObject) : {liked : boolean, like_count : number} => {
        return {
            liked: toBool(data['liked']),
            like_count: toNumber(data['like_count']),
        }
    })
}

/**
 * 举报帖子
 * @param topicId 帖子 ID
 * @param reason 举报原因（1-500 字）
 */
export function reportTopicApi(topicId : number, reason : string) : Promise<void> {
    const url = '/forum/topics/' + topicId + '/report'
    const payload : UTSJSONObject = { reason: reason } as UTSJSONObject
    return post(url, payload).then(() : void => {
        // 举报成功，无返回数据
    })
}

/**
 * 举报回复
 * @param replyId 回复 ID
 * @param reason 举报原因（1-500 字）
 */
export function reportReplyApi(replyId : number, reason : string) : Promise<void> {
    const url = '/forum/replies/' + replyId + '/report'
    const payload : UTSJSONObject = { reason: reason } as UTSJSONObject
    return post(url, payload).then(() : void => {
        // 举报成功，无返回数据
    })
}

/**
 * 获取我的帖子列表
 * @param page 页码
 * @param pageSize 每页条数
 */
export function getMyTopicsApi(page : number = 1, pageSize : number = 10) : Promise<ForumTopicListResult> {
    const params : UTSJSONObject = {
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return get('/forum/my-topics', params).then((data : UTSJSONObject) : ForumTopicListResult => {
        return buildTopicListResult(data)
    })
}

/**
 * 获取我的回复列表（含主题标题回填）
 * @param page 页码
 * @param pageSize 每页条数
 */
export function getMyRepliesApi(page : number = 1, pageSize : number = 10) : Promise<{items : ForumReply[], total : number, page : number, page_size : number}> {
    const params : UTSJSONObject = {
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return get('/forum/my-replies', params).then((data : UTSJSONObject) : {items : ForumReply[], total : number, page : number, page_size : number} => {
        const items : ForumReply[] = []
        const repliesRaw = data['replies']
        if (repliesRaw != null) {
            const repliesArray = repliesRaw as Array<UTSJSONObject>
            for (let i = 0; i < repliesArray.length; i++) {
                items.push(buildReply(repliesArray[i]))
            }
        }
        return {
            items: items,
            total: toNumber(data['total']),
            page: toNumber(data['page']),
            page_size: toNumber(data['pages']),
        }
    })
}
