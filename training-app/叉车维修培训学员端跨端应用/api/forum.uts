// ===== 打卡模块 API =====

/**
 * 构造 CheckInResult（从 UTSJSONObject）
 */
function buildCheckInResult(obj : UTSJSONObject) : CheckInResult {
    return {
        checked_in: toBool(obj['checked_in']),
        consecutive_days: toNumber(obj['consecutive_days']),
        points_earned: toNumber(obj['points_earned']),
        total_points: toNumber(obj['total_points']),
    } as CheckInResult
}

/**
 * 构造 CheckInCalendarDay（从 UTSJSONObject）
 */
function buildCheckInCalendarDay(obj : UTSJSONObject) : CheckInCalendarDay {
    // 兼容多种字段名：date / day / check_date
    let dateStr = toStr(obj['date'])
    if (dateStr.length == 0) {
        dateStr = toStr(obj['day'])
    }
    if (dateStr.length == 0) {
        dateStr = toStr(obj['check_date'])
    }
    // 兼容多种字段名：checked / is_checked / signed / check_in
    let isChecked = toBool(obj['checked'])
    if (!isChecked) {
        isChecked = toBool(obj['is_checked'])
    }
    if (!isChecked) {
        isChecked = toBool(obj['signed'])
    }
    if (!isChecked) {
        isChecked = toBool(obj['check_in'])
    }
    return {
        date: dateStr,
        checked: isChecked,
        points: toNumber(obj['points']),
    } as CheckInCalendarDay
}

/**
 * 构造 CheckInCalendarResult（从 UTSJSONObject）
 */
function buildCheckInCalendarResult(obj : UTSJSONObject) : CheckInCalendarResult {
    console.log('[buildCheckInCalendarResult] obj keys:', Object.keys(obj).join(','))
    const days : CheckInCalendarDay[] = []

    // ===== 核心：处理 API 返回的 dates 字符串数组 =====
    // API 格式：{ dates: ["2026-08-21","2026-08-22"], streak: 2, total: 2, today_checked: true }
    // 需要转换为：CheckInCalendarDay[] 格式
    const checkedDates : string[] = []
    const datesRaw = obj['dates']
    if (datesRaw != null) {
        const datesArray = datesRaw as Array<string>
        for (let i = 0; i < datesArray.length; i++) {
            checkedDates.push(toStr(datesArray[i]))
        }
    }

    // 根据年月生成当月所有日期，标记哪些已签到
    const year = toNumber(obj['year'])
    const month = toNumber(obj['month'])
    if (year > 0 && month > 0) {
        const daysInMonth = new Date(year, month, 0).getDate()
        for (let d = 1; d <= daysInMonth; d++) {
            const dateStr = year + '-' + (month < 10 ? '0' + month : '' + month) + '-' + (d < 10 ? '0' + d : '' + d)
            let isChecked = false
            for (let j = 0; j < checkedDates.length; j++) {
                if (checkedDates[j] == dateStr) {
                    isChecked = true
                    break
                }
            }
            days.push({ date: dateStr, checked: isChecked, points: isChecked ? 7 : 0 } as CheckInCalendarDay)
        }
    } else {
        // 没有 year/month 时，仅用 dates 数组构建
        for (let i = 0; i < checkedDates.length; i++) {
            days.push({ date: checkedDates[i], checked: true, points: 7 } as CheckInCalendarDay)
        }
    }

    // ===== 字段映射：streak → consecutive_days, total → total_points =====
    let consecutive = toNumber(obj['streak'])
    if (consecutive == 0) {
        consecutive = toNumber(obj['consecutive_days'])
    }
    let points = toNumber(obj['total'])
    if (points == 0) {
        points = toNumber(obj['total_points'])
    }
    let perDay = toNumber(obj['points_per_day'])
    if (perDay == 0) {
        perDay = 7
    }

    console.log('[buildCheckInCalendarResult] checkedDates:', checkedDates.join(','), 'days count:', days.length, 'streak:', consecutive)

    return {
        year: year > 0 ? year : new Date().getFullYear(),
        month: month > 0 ? month : new Date().getMonth() + 1,
        consecutive_days: consecutive,
        total_points: points,
        points_per_day: perDay,
        days: days,
    } as CheckInCalendarResult
}

/**
 * 每日打卡
 * POST /forum/check-in
 * @returns 打卡结果（连续天数、获得积分、累计积分）
 */
export function checkInApi() : Promise<CheckInResult> {
    return post('/forum/check-in').then((data : UTSJSONObject) : CheckInResult => {
        console.log('[checkInApi] raw data:', JSON.stringify(data))
        return buildCheckInResult(data)
    }).catch((e : any | null) : CheckInResult => {
        console.error('[checkInApi] failed:', e)
        const msg = errMsg(e, '打卡失败')
        throw new Error(msg)
    })
}

/**
 * 获取打卡日历
 * GET /forum/check-in/calendar
 * @param year 年份（可选，默认当前年）
 * @param month 月份（可选，默认当前月）
 * @returns 日历数据（连续签到天数、积分、每日签到状态）
 */
export function getCheckInCalendarApi(year : number = 0, month : number = 0) : Promise<CheckInCalendarResult> {
    const params : UTSJSONObject = {}
    if (year > 0) {
        params['year'] = year.toString()
    }
    if (month > 0) {
        params['month'] = month.toString()
    }
    return get('/forum/check-in/calendar', params).then((data : UTSJSONObject) : CheckInCalendarResult => {
        console.log('[getCheckInCalendarApi] raw data:', JSON.stringify(data))
        return buildCheckInCalendarResult(data)
    }).catch((e : any | null) : CheckInCalendarResult => {
        console.error('[getCheckInCalendarApi] failed:', e)
        const msg = errMsg(e, '获取打卡日历失败')
        throw new Error(msg)
    })
}