    const params : UTSJSONObject = {
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return getMapped<ForumTopicListResult>('/forum/my-observed', params, (data : UTSJSONObject) : ForumTopicListResult => buildTopicListResult(data)).catch((e) : ForumTopicListResult => {
        // 后端未实现时降级为空列表
        return { items: [], total: 0, page: page, page_size: pageSize } as ForumTopicListResult
    })
}

/**
 * 获取我的浏览记录
 * @param page 页码
 * @param pageSize 每页条数
 * @note 后端 GET /forum/my-view-history（#701，按主题去重取最近一次浏览倒序）
 */
export function getMyViewHistoryApi(page : number = 1, pageSize : number = 10) : Promise<ForumTopicListResult> {
    const params : UTSJSONObject = {
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return getMapped<ForumTopicListResult>('/forum/my-view-history', params, (data : UTSJSONObject) : ForumTopicListResult => buildTopicListResult(data)).catch((e) : ForumTopicListResult => {
        // 后端未实现时降级为空列表
        return { items: [], total: 0, page: page, page_size: pageSize } as ForumTopicListResult
    })
}

// ===== 采纳（#366）=====

/**
 * 采纳回复（#747）
 * @param topicId 主题 ID
 * @param replyId 要采纳的回复 ID
 * @note POST /forum/topics/{id}/accept，后端返回更新后的 topic DTO
 */
export function acceptReplyApi(topicId : number, replyId : number) : Promise<ForumTopicDetail> {
    const body : UTSJSONObject = {
        reply_id: replyId,
    } as UTSJSONObject
    return postMapped<ForumTopicDetail>('/forum/topics/' + topicId.toString() + '/accept', body, (data : UTSJSONObject) : ForumTopicDetail => {
        return buildTopicDetail(data)
    })
}

/**
 * 取消采纳（#747）
 * @param topicId 主题 ID
 * @note DELETE /forum/topics/{id}/accept，后端返回更新后的 topic DTO
 */
export function cancelAcceptApi(topicId : number) : Promise<ForumTopicDetail> {
    return requestMapped<ForumTopicDetail>(
        { url: '/forum/topics/' + topicId.toString() + '/accept', method: 'DELETE' } as RequestOptions,
        (data : UTSJSONObject) : ForumTopicDetail => buildTopicDetail(data),
    )
}
