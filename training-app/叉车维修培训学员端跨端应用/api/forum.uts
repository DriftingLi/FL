/**
 * 论坛 API
 * @note 后端响应已由 request 层自动解包 data 字段
 * @note T04 手术（refs #642）：映射出口统一走 mapper-callback 家族
 *       （getMapped/postMapped/requestMapped，#639 出口），catch 参数零 `: any` 注解（守护规则 H 清零）
 * @note T18 拆分（#1218 / ADR-0023 票 B）：DTO 构造层（`build*` / `extract*` 九个函数）拆到
 *       `./forumDto`。本文件只留**请求形态** —— 路由 / 查询参数 / 出口选择与捕获；响应 shape 的
 *       构造在 `api/forumDto.uts`（那边头部写明了后端响应形态）。
 *       拆的理由是 600 行软预算（拆前 654 行）；执法面见 `utils/modules.js` 的 forum 条目。
 */
import { post, del, uploadFile, getMapped, postMapped, requestMapped } from './request'
import type { RequestOptions } from './request'
import { toNumber, toStr, toBool, errMsg } from './helpers'
import type { ForumTopic, ForumTopicListResult, ForumTopicDetail, ForumReply, LikeTopicResult, MyRepliesResult } from '../types/index'
import { buildReply, buildTopic, buildTopicListResult, buildTopicDetail, buildLikeResult } from './forumDto'

/**
 * 获取帖子列表
 * @param page 页码，默认 1
 * @param pageSize 每页条数，默认 10
 * @param scope 范围，默认 general（对应 https://training.gccsmile.com/api/forum/topics?scope=general&sort=latest&order=desc&page=1&page_size=10）
 * @param sort 排序字段，默认 latest
 * @param order 排序方向，默认 desc
 * @param featured 精选过滤（#742 契约，勿改名）：'true' | 'false'，空串表示不过滤
 * @param isExperience 经验认定过滤（ADR-0040 契约，勿改名）：'true' 仅管理端认定的经验帖，空串表示不过滤
 */
export function getForumTopicsApi(page : number = 1, pageSize : number = 10, scope : string = 'general', sort : string = 'latest', order : string = 'desc', category : string = '', status : string = '', featured : string = '', isExperience : string = '') : Promise<ForumTopicListResult> {
    const params : UTSJSONObject = {
        scope: scope,
        sort: sort,
        order: order,
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    // 帖子意图（学员自述，ADR-0040 起只有 discussion|question 两值；'experience' 仅为旧客户端
    // 兼容留在后端白名单里，存量行已降级，发它过滤不出任何行），空为不筛选
    if (category.length > 0) {
        params['category'] = category
    }
    // 问题状态筛选（#707 裁定）：沿用 solved 参数（#367 交付），仅 category=question 时生效
    // resolved（已解决）→ solved=solved；open（进行中）→ solved=unsolved；空为不筛选
    if (status.length > 0 && category === 'question') {
        params['solved'] = status === 'resolved' ? 'solved' : 'unsolved'
    }
    // 精选过滤（#742 批次三，对齐 Web 三 Tab 通用轴）：featured=true|false，空为不传（不过滤）
    if (featured.length > 0) {
        params['featured'] = featured
    }
    // 经验认定过滤（ADR-0040）：经验 Tab 的唯一判据是管理端认定 is_experience，**不是** category
    // （自称不产生事实：category='experience' 的存量行已被迁移降级为 discussion），空为不传
    if (isExperience.length > 0) {
        params['is_experience'] = isExperience
    }
    return getMapped<ForumTopicListResult>('/forum/topics', params, (data : UTSJSONObject) : ForumTopicListResult => {
        console.log('[getForumTopicsApi] raw data:', JSON.stringify(data))
        return buildTopicListResult(data)
    }).catch((e) : ForumTopicListResult => {
        console.error('[getForumTopicsApi] failed:', e)
        const msg = errMsg(e, '获取帖子列表失败')
        throw new Error(msg)
    })
}

/**
 * 获取帖子详情（回复分页读取，ADR-0042）
 * @param topicId 帖子 ID
 * @param sort 排序字段，默认 latest（latest | hot）
 * @param order 排序方向，默认 asc
 * @param page 回复页码，默认 1（**分页是回复列表的唯一读取形态**：不传参数不等于全量）
 * @param pageSize 每页回复数，默认 20
 * @note 被采纳回复由**后端**固定占首页第一条并从排序结果中剔除 ⇒ 有采纳时的首页容量为
 *       pageSize − 1（`total` 含置顶条，与 topic.reply_count 同源）
 */
export function getForumTopicDetailApi(topicId : number, sort : string = 'latest', order : string = 'asc', page : number = 1, pageSize : number = 20) : Promise<ForumTopicDetail> {
    const url = '/forum/topics/' + topicId.toString()
    const params : UTSJSONObject = {
        sort: sort,
        order: order,
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return getMapped<ForumTopicDetail>(url, params, (data : UTSJSONObject) : ForumTopicDetail => {
        console.log('[getForumTopicDetailApi] raw data:', JSON.stringify(data))
        return buildTopicDetail(data)
    }).catch((e) : ForumTopicDetail => {
        console.error('[getForumTopicDetailApi] failed:', e)
        const msg = errMsg(e, '获取帖子详情失败')
        throw new Error(msg)
    })
}

/**
 * 上传论坛图片
 * @param filePath 本地图片路径（uni.chooseImage 返回值）
 * @returns 上传成功后的图片 URL（相对或绝对路径，提交发帖/回复时原样回传）
 */
export function uploadForumImageApi(filePath : string) : Promise<string> {
    // 与 auth.uts 同款 3 参调用（UTS 对带默认值参数的第 4/5 位置实参会触发 overload 解析错误，勿传）
    return uploadFile('/forum/upload-image', filePath, 'file').then((data : UTSJSONObject) : string => {
        const url = data['url']
        if (url == null) {
            throw new Error('上传成功但未返回图片地址')
        }
        return toStr(url)
    }).catch((e) : string => {
        console.error('[uploadForumImageApi] failed:', e)
        const msg = errMsg(e, '上传图片失败')
        throw new Error(msg)
    })
}

/**
 * 发布新帖
 * @param title 标题（1-100 字）
 * @param content 内容（1-10000 字）
 * @param images 图片 URL 数组（最多 9 张，先经 uploadForumImageApi 上传获取）
 * @param category 帖子意图（学员自述，ADR-0040 起只有 discussion / question 两值；
 *                 'experience' 写入后端直接 400——「备考经验」是管理端认定，不是自述类别）
 */
export function createForumTopicApi(title : string, content : string, images : string[] = [], category : string = 'discussion') : Promise<ForumTopic> {
    const payload : UTSJSONObject = {
        title: title,
        content: content,
        images: images,
        category: category,
    } as UTSJSONObject
    return postMapped<ForumTopic>('/forum/topics', payload, (data : UTSJSONObject) : ForumTopic => {
        console.log('[createForumTopicApi] raw data:', JSON.stringify(data))
        return buildTopic(data)
    }).catch((e) : ForumTopic => {
        console.error('[createForumTopicApi] failed:', e)
        const msg = errMsg(e, '发布帖子失败')
        throw new Error(msg)
    })
}

/**
 * 编辑帖子
 * @param topicId 帖子 ID
 * @param title 标题（1-100 字）
 * @param content 内容（1-10000 字）
 * @param images 图片 URL 数组（最多 9 张）
 * @param category 帖子类别（可选）
 * @note 后端 PUT /forum/topics/:id 已落地（#811）：仅作者本人可改，非本人 403；
 *       载荷 title/content/images/category（chapter_id 不在契约内，编辑不迁移章节归属）
 */
export function updateForumTopicApi(topicId : number, title : string, content : string, images : string[] = [], category : string = '') : Promise<ForumTopic> {
    const url = '/forum/topics/' + topicId.toString()
    const payload : UTSJSONObject = {
        title: title,
        content: content,
        images: images,
    } as UTSJSONObject
    if (category.length > 0) {
        payload['category'] = category
    }
    const options : RequestOptions = {
        url: url,
        method: 'PUT',
        data: payload,
    }
    return requestMapped<ForumTopic>(options, (data : UTSJSONObject) : ForumTopic => {
        console.log('[updateForumTopicApi] raw data:', JSON.stringify(data))
        return buildTopic(data)
    }).catch((e) : ForumTopic => {
        console.error('[updateForumTopicApi] failed:', e)
        const msg = errMsg(e, '编辑帖子失败')
        throw new Error(msg)
    })
}

/**
 * 回复帖子
 * @param topicId 帖子 ID
 * @param content 回复内容
 * @param images 图片 URL 数组（最多 3 张，先经 uploadForumImageApi 上传获取）
 */
export function replyForumTopicApi(topicId : number, content : string, images : string[] = []) : Promise<ForumReply> {
    const url = '/forum/topics/' + topicId + '/replies'
    const payload : UTSJSONObject = {
        content: content,
        images: images,
    } as UTSJSONObject
    return postMapped<ForumReply>(url, payload, (data : UTSJSONObject) : ForumReply => {
        console.log('[replyForumTopicApi] raw data:', JSON.stringify(data))
        return buildReply(data, topicId)
    }).catch((e) : ForumReply => {
        console.error('[replyForumTopicApi] failed:', e)
        const msg = errMsg(e, '回复失败')
        throw new Error(msg)
    })
}

/**
 * 删除帖子（贴主删除自己的帖子）
 * @param topicId 帖子 ID
 */
export function deleteForumTopicApi(topicId : number) : Promise<UTSJSONObject> {
    const url = '/forum/topics/' + topicId
    return del(url)
}

/**
 * 删除回复
 * @param replyId 回复 ID
 */
export function deleteForumReplyApi(replyId : number) : Promise<UTSJSONObject> {
    const url = '/forum/replies/' + replyId
    return del(url)
}

// ===== 新增接口：点赞 / 取消点赞 / 举报 / 我的帖子 / 我的回复 =====

/**
 * 点赞帖子
 * @param topicId 帖子 ID
 */
export function likeTopicApi(topicId : number) : Promise<LikeTopicResult> {
    const url = '/forum/topics/' + topicId + '/like'
    return postMapped<LikeTopicResult>(url, null, (data : UTSJSONObject) : LikeTopicResult => buildLikeResult(data))
}

/**
 * 取消点赞帖子
 * @param topicId 帖子 ID
 */
export function unlikeTopicApi(topicId : number) : Promise<LikeTopicResult> {
    const url = '/forum/topics/' + topicId + '/like'
    const options : RequestOptions = {
        url: url,
        method: 'DELETE',
    }
    return requestMapped<LikeTopicResult>(options, (data : UTSJSONObject) : LikeTopicResult => buildLikeResult(data))
}

/**
 * 点赞回复
 * @param replyId 回复 ID
 * 对应 POST /forum/replies/{id}/like（若后端暂未实现，调用将 404，前端已做受控提示）
 */
export function likeReplyApi(replyId : number) : Promise<LikeTopicResult> {
    const url = '/forum/replies/' + replyId + '/like'
    return postMapped<LikeTopicResult>(url, null, (data : UTSJSONObject) : LikeTopicResult => {
        return {
            liked: toBool(data['liked'], true),
            likes_count: toNumber(data['likes_count']),
        } as LikeTopicResult
    })
}

/**
 * 取消点赞回复
 * @param replyId 回复 ID
 * 对应 DELETE /forum/replies/{id}/like
 */
export function unlikeReplyApi(replyId : number) : Promise<LikeTopicResult> {
    const url = '/forum/replies/' + replyId + '/like'
    const options : RequestOptions = {
        url: url,
        method: 'DELETE',
    }
    return requestMapped<LikeTopicResult>(options, (data : UTSJSONObject) : LikeTopicResult => buildLikeResult(data))
}

/**
 * 举报帖子
 * @param topicId 帖子 ID
 * @param reason 举报原因（1-500 字）
 */
export function reportTopicApi(topicId : number, reason : string) : Promise<void> {
    const url = '/forum/topics/' + topicId + '/report'
    const payload : UTSJSONObject = { reason: reason } as UTSJSONObject
    return post(url, payload).then(() : void => {
        // 举报成功，无返回数据
    })
}

/**
 * 举报回复
 * @param replyId 回复 ID
 * @param reason 举报原因（1-500 字）
 */
export function reportReplyApi(replyId : number, reason : string) : Promise<void> {
    const url = '/forum/replies/' + replyId + '/report'
    const payload : UTSJSONObject = { reason: reason } as UTSJSONObject
    return post(url, payload).then(() : void => {
        // 举报成功，无返回数据
    })
}

/**
 * 获取我的帖子列表
 * @param page 页码
 * @param pageSize 每页条数
 */
export function getMyTopicsApi(page : number = 1, pageSize : number = 10) : Promise<ForumTopicListResult> {
    const params : UTSJSONObject = {
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return getMapped<ForumTopicListResult>('/forum/my-topics', params, (data : UTSJSONObject) : ForumTopicListResult => buildTopicListResult(data))
}

/**
 * 获取我的回复列表（含主题标题回填）
 * @param page 页码
 * @param pageSize 每页条数
 */
export function getMyRepliesApi(page : number = 1, pageSize : number = 10) : Promise<MyRepliesResult> {
    const params : UTSJSONObject = {
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return getMapped<MyRepliesResult>('/forum/my-replies', params, (data : UTSJSONObject) : MyRepliesResult => {
        const items : ForumReply[] = []
        const repliesRaw = data['replies']
        if (repliesRaw != null) {
            const repliesArray = repliesRaw as Array<UTSJSONObject>
            for (let i = 0; i < repliesArray.length; i++) {
                items.push(buildReply(repliesArray[i]))
            }
        }
        return {
            items: items,
            total: toNumber(data['total']),
            page: toNumber(data['page']),
            page_size: toNumber(data['pages']),
        } as MyRepliesResult
    })
}

// ===== 个人动态模块 API =====

/**
 * 获取我点赞的帖子列表
 * @param page 页码
 * @param pageSize 每页条数
 * @note 后端 GET /forum/my-liked-topics（#701，响应沿用 my-topics 形态，按点赞时间倒序）
 */
export function getMyLikedTopicsApi(page : number = 1, pageSize : number = 10) : Promise<ForumTopicListResult> {
    const params : UTSJSONObject = {
        page: page.toString(),
        page_size: pageSize.toString(),
    } as UTSJSONObject
    return getMapped<ForumTopicListResult>('/forum/my-liked-topics', params, (data : UTSJSONObject) : ForumTopicListResult => buildTopicListResult(data)).catch((e) : ForumTopicListResult => {
        // 后端未实现时降级为空列表
        return { items: [], total: 0, page: page, page_size: pageSize } as ForumTopicListResult
    })
}

