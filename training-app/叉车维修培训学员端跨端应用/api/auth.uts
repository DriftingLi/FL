/**
 * 认证相关 API
 */
import { get, post, put, del, uploadFile } from './request'
import { toStr } from './helpers'
import type { RequestOptions } from './request'
import type { LoginParams, LoginResult, RegisterParams, EmailRegisterParams, UserInfo, UpdateProfileParams, UploadAvatarResult, ProfileChangeRequest, WechatLoginResult, RefreshTokenResult } from '../types/index'

/**
 * 从 UTSJSONObject 构造 UserInfo
 * @note Android 端无法用 as 把 UTSJSONObject 强转为 type 字面量（Kotlin data class），
 *       必须逐字段手动取值并转换。UTS 中 as 是强类型转换，类型不匹配会抛 ClassCastException。
 */
function buildUserInfo(obj : UTSJSONObject) : UserInfo {
	// 用 try/catch 包裹，捕获类型转换异常并打印具体字段，避免错误信息丢失
	try {
		const user_id = obj['user_id'] as number
		const username = obj['username'] as string
		// 后端新统一用户体系 /auth/login 与 /auth/me 返回名称为 username（旧字段 name 已废弃）
		const nameRaw = obj['name']
		const name : string = nameRaw == null ? username : nameRaw as string
		const role = obj['role'] as string
		const user : UserInfo = {
			user_id: user_id,
			username: username,
			name: name,
			role: role,
		} as UserInfo
		// 兼容两种后端字段名：/auth/me 返回 avatar_url，/auth/wx-login 返回 avatar
		const avatarUrlRaw = obj['avatar_url']
		if (avatarUrlRaw != null && (avatarUrlRaw as string).length > 0) {
			user.avatar_url = avatarUrlRaw as string
		} else {
			const avatarRaw = obj['avatar']
			if (avatarRaw != null && (avatarRaw as string).length > 0) {
				user.avatar_url = avatarRaw as string
			}
		}
		// /auth/me ProfileDTO 的扩展字段（登录响应通常不带，缺失即不设置）
		const accountRaw = obj['account']
		if (accountRaw != null) {
			user.account = accountRaw as string
		}
		const phoneRaw = obj['phone']
		if (phoneRaw != null) {
			user.phone = phoneRaw as string
		}
		const emailRaw = obj['email']
		if (emailRaw != null) {
			user.email = emailRaw as string
		}
		const companyRaw = obj['company']
		if (companyRaw != null) {
			user.company = companyRaw as string
		}
		const hasPwdRaw = obj['has_password']
		if (hasPwdRaw != null) {
			user.has_password = hasPwdRaw as boolean
		}
		// pending_profile_change 非空即存在待审核的资料修改（昵称/头像）
		user.has_pending_change = obj['pending_profile_change'] != null
		return user
	} catch (e) {
		// 打印完整异常对象，便于定位是哪个字段转换失败
		console.error('[buildUserInfo] exception:', e)
		// UTS 中 catch 的 e 可能是任何 Throwable（含 Java 异常），用 instanceof 判断避免 as 强转失败
		let msg = '用户信息构造失败'
		if (e instanceof Error) {
			const errObj = e as Error
			const m = errObj.message
			if (m != null && m.length > 0) {
				msg = msg + ': ' + m
			}
		}
		throw new Error(msg)
	}
}

/** 学员登录（用户名或手机号 + 密码） */
export function loginApi(params : LoginParams) : Promise<LoginResult> {
	// Android 端 uni.request 的 data 必须是 UTSJSONObject，不接受 type 字面量（编译为 Kotlin data class）
	const payload : UTSJSONObject = {
		username: params.username,
		password: params.password
	} as UTSJSONObject
	return post('/auth/login', payload).then((data : UTSJSONObject) : LoginResult => {
		try {
			const token = data['token'] as string
			const refreshToken = toStr(data['refresh_token'], '')
			const user = buildUserInfo(data)
			const result : LoginResult = {
				token: token,
				user: user,
				refresh_token: refreshToken,
			}
			return result
		} catch (e) {
			console.error('[loginApi] parse exception:', e)
			// UTS 中 catch 的 e 可能是任何 Throwable（含 Java 异常），用 instanceof 判断避免 as 强转失败
			let msg = '登录响应解析失败'
			if (e instanceof Error) {
				const errObj = e as Error
				const m = errObj.message
				if (m != null && m.length > 0) {
					msg = msg + ': ' + m
				}
			}
			throw new Error(msg)
		}
	}).catch((e) : LoginResult => {
		console.error('[loginApi] login failed:', e)
		let msg = '登录失败，请检查网络后重试'
		if (e instanceof Error) {
			const errObj = e as Error
			const m = errObj.message
			if (m != null && m.length > 0) {
				msg = msg + ': ' + m
			}
		}
		throw new Error(msg)
	})
}

/** 发送短信验证码（注册用） POST /auth/phone/send-code {phone, purpose:'register'} */
export function sendPhoneCodeApi(phone : string, captchaId : string, captchaValue : string) : Promise<UTSJSONObject> {
	return sendCodeApi(phone, 'phone', 'register', captchaId, captchaValue)
}

/**
 * 学员注册（手机号 + 短信验证码 + 昵称 + 密码） POST /auth/phone/register
 * @note 后端为验证码制注册（/auth/register 不存在），验证码通过后自动登录并返回 token + 用户信息
 * @returns 注册成功即自动登录（与登录同构的 token + user）
 */
export function registerApi(params : RegisterParams) : Promise<LoginResult> {
	// Android 端 uni.request 的 data 不支持 type 字面量对象（Kotlin data class）
	// 必须显式构造 UTSJSONObject
	const payload : UTSJSONObject = {
		phone: params.phone,
		code: params.code,
		nickname: params.nickname,
		password: params.password
	} as UTSJSONObject
	return post('/auth/phone/register', payload).then((data : UTSJSONObject) : LoginResult => {
		const token = data['token'] as string
		const refreshToken = toStr(data['refresh_token'], '')
		const user = buildUserInfo(data)
		return { token: token, user: user, refresh_token: refreshToken } as LoginResult
	})
}

/**
 * 邮箱注册（邮箱 + 验证码 + 昵称 + 密码） POST /auth/email/register
 * @note 与手机号注册同构：验证码通过后自动登录并返回 token + 用户信息；
 *       company 为选填（后端字段名 company）
 * @returns 注册成功即自动登录（与登录同构的 token + user）
 */
export function emailRegisterApi(params : EmailRegisterParams) : Promise<LoginResult> {
	// Android 端 uni.request 的 data 不支持 type 字面量对象（Kotlin data class），
	// 必须显式构造 UTSJSONObject；company 选填，仅在非空时携带
	const payload : UTSJSONObject = {
		email: params.email,
		code: params.code,
		nickname: params.nickname,
		password: params.password
	} as UTSJSONObject
	const company = params.company
	if (company != null && company.length > 0) {
		payload['company'] = company
	}
	return post('/auth/email/register', payload).then((data : UTSJSONObject) : LoginResult => {
		const token = data['token'] as string
		const refreshToken = toStr(data['refresh_token'], '')
		const user = buildUserInfo(data)
		return { token: token, user: user, refresh_token: refreshToken } as LoginResult
	})
}

/**
 * 忘记密码：验证码重置密码（邮箱/手机号） POST /auth/{email|phone}/reset-password
 * @param target 手机号或邮箱
 * @param channel email | phone
 * @param code 验证码（purpose=reset_password 下发）
 * @param password 新密码（6-20 位）
 * @note 重置成功不自动登录（后端返回 data: null），由调用方提示后跳登录页
 */
export function resetPasswordApi(target : string, channel : string, code : string, password : string) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		code: code,
		password: password
	} as UTSJSONObject
	if (channel == 'email') {
		payload['email'] = target
		return post('/auth/email/reset-password', payload)
	}
	payload['phone'] = target
	return post('/auth/phone/reset-password', payload)
}

/**
 * 发送验证码（邮箱/手机号，purpose: register / login）
 * @param target 手机号或邮箱
 * @param channel email | phone
 * @param purpose 用途：register / login
 * @param captchaId 图形验证码 id（GET /captcha 返回，生产环境必填）
 * @param captchaValue 图形验证码答案
 */
export function sendCodeApi(target : string, channel : string, purpose : string, captchaId : string, captchaValue : string) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		purpose: purpose
	} as UTSJSONObject
	if (captchaId.length > 0 && captchaValue.length > 0) {
		payload['captcha_id'] = captchaId
		payload['captcha_value'] = captchaValue
	}
	if (channel == 'email') {
		payload['email'] = target
		return post('/auth/email/send-code', payload)
	}
	payload['phone'] = target
	return post('/auth/phone/send-code', payload)
}

/** 获取图形验证码 GET /captcha（无需鉴权）→ { id, image(base64 data URL) } */
export function getCaptchaApi() : Promise<UTSJSONObject> {
	return get('/captcha')
}

/** 手机号验证码登录 POST /auth/phone/login */
export function phoneLoginApi(phone : string, code : string) : Promise<LoginResult> {
	const payload : UTSJSONObject = {
		phone: phone,
		code: code
	} as UTSJSONObject
	return post('/auth/phone/login', payload).then((data : UTSJSONObject) : LoginResult => {
		const token = data['token'] as string
		const refreshToken = toStr(data['refresh_token'], '')
		const user = buildUserInfo(data)
		return { token: token, user: user, refresh_token: refreshToken } as LoginResult
	})
}

/** 邮箱验证码登录 POST /auth/email/login */
export function emailLoginApi(email : string, code : string) : Promise<LoginResult> {
	const payload : UTSJSONObject = {
		email: email,
		code: code
	} as UTSJSONObject
	return post('/auth/email/login', payload).then((data : UTSJSONObject) : LoginResult => {
		const token = data['token'] as string
		const refreshToken = toStr(data['refresh_token'], '')
		const user = buildUserInfo(data)
		return { token: token, user: user, refresh_token: refreshToken } as LoginResult
	})
}

/** 登出（token SHA256 写入 Redis 黑名单） */
export function logoutApi() : Promise<UTSJSONObject> {
	// 静默请求：退出登录是用户主动行为，后端失败不应弹错误 toast 干扰
	return post('/auth/logout', null, { url: '/auth/logout', silent: true } as RequestOptions)
}


/** 刷新双令牌 POST /auth/refresh */
export function refreshTokenApi(refreshToken : string) : Promise<RefreshTokenResult> {
	const payload : UTSJSONObject = {
		refresh_token: refreshToken,
	} as UTSJSONObject
	return post('/auth/refresh', payload).then((data : UTSJSONObject) : RefreshTokenResult => {
		const result : RefreshTokenResult = {
			token: data['token'] as string,
			refresh_token: data['refresh_token'] as string,
		} as RefreshTokenResult
		return result
	})
}
/** 获取当前用户信息 */
export function getUserInfoApi() : Promise<UserInfo> {
	return get('/auth/me').then((data : UTSJSONObject) : UserInfo => {
		return buildUserInfo(data)
	})
	// 不再 catch 并回退 mock 数据：
	// - 401 由 request 层 handleUnauthorized() 处理（清 storage + 跳登录页），此处直接传播 reject
	// - 网络错误也应传播，由 validateToken() 区分处理（保留登录态 vs 清空）
}

/**
 * 更新个人资料（昵称审核 / 单位直改） PUT /auth/profile
 * @note nickname 提交进入审核流（pending）；company 直接生效不审核
 */
export function updateProfileApi(params : UpdateProfileParams) : Promise<ProfileChangeRequest> {
	const payload : UTSJSONObject = {} as UTSJSONObject
	const nickname = params.nickname
	if (nickname != null && nickname.length > 0) {
		payload['nickname'] = nickname
	}
	const company = params.company
	if (company != null && company.length > 0) {
		payload['company'] = company
	}
	return put('/auth/profile', payload).then((data : UTSJSONObject) : ProfileChangeRequest => {
		return buildReviewRequest(data)
	})
}

/** 从 UTSJSONObject 构造 ProfileChangeRequest（后端审核请求 DTO） */
function buildReviewRequest(obj : UTSJSONObject) : ProfileChangeRequest {
	// UTS 中 as 是强转（Kotlin 级），字段为 null 时 as string 会抛 ClassCastException，
	// 因此对可空字段用显式 null 判断回退默认值（与 buildUserInfo 同风格）
	let id = 0
	const idRaw = obj['id']
	if (idRaw != null) {
		id = idRaw as number
	}
	let user_id = 0
	const uidRaw = obj['user_id']
	if (uidRaw != null) {
		user_id = uidRaw as number
	}
	const username = toStr(obj['username'], '')
	const avatar_url = toStr(obj['avatar_url'], '')
	const field_type = toStr(obj['field_type'], '')
	const old_value = toStr(obj['old_value'], '')
	const new_value = toStr(obj['new_value'], '')
	let status = toStr(obj['status'], 'pending')
	status = status.length > 0 ? status : 'pending'
	const reject_reason = toStr(obj['reject_reason'], '')
	const created_at = toStr(obj['created_at'], '')

	const req : ProfileChangeRequest = {
		id: id,
		user_id: user_id,
		username: username,
		avatar_url: avatar_url,
		field_type: field_type,
		old_value: old_value,
		new_value: new_value,
		status: status,
		reject_reason: reject_reason,
		created_at: created_at,
	} as ProfileChangeRequest
	return req
}


/**
 * 上传头像（multipart/form-data） POST /auth/avatar
 * @param filePath 本地临时文件路径（由 uni.chooseImage 返回）
 * @note 后端 multipart 字段名固定为 file；返回头像修改审核请求（pending），审核通过后生效
 */
export function uploadAvatarApi(filePath : string) : Promise<UploadAvatarResult> {
	return uploadFile('/auth/avatar', filePath, 'file').then((data : UTSJSONObject) : UploadAvatarResult => {
		const result : UploadAvatarResult = {
			request: buildReviewRequest(data)
		} as UploadAvatarResult
		return result
	})
}

/**
 * 小程序微信一键登录 POST /auth/wx-login
 * @param code uni.login({provider: 'weixin'}) 返回的微信临时登录凭证
 * @note 后端拿 code 调 jscode2session 换 openid/unionid：
 *       - 老用户（openid 已绑定）：返回 token + userInfo
 *       - 新用户（openid 未注册）：后端以 openid 为唯一键自动创建账户，返回 token + userInfo + isNew=true
 * @note 完整 URL = API_BASE_URL + '/auth/wx-login'（API_BASE_URL 已包含 /api 前缀）
 * @returns WechatLoginResult：LoginResult + 可选 isNew（true 表示后端刚自动注册的账户）
 */
export function mpWechatLoginApi(code : string) : Promise<WechatLoginResult> {
	const payload : UTSJSONObject = {
		code: code
	} as UTSJSONObject
	return post('/auth/wx-login', payload).then((data : UTSJSONObject) : WechatLoginResult => {
		const token = data['token'] as string
		const refreshToken = toStr(data['refresh_token'], '')
		const user = buildUserInfo(data)
		const result : WechatLoginResult = {
			token: token,
			user: user,
			refresh_token: refreshToken,
		} as WechatLoginResult
		// 透传后端的 isNew 标记：新用户（openid 首次绑定）后端会以 openid 自动建账户并 isNew=true
		const isNewRaw = data['isNew']
		if (isNewRaw != null) {
			result.isNew = isNewRaw as boolean
		}
		return result
	})
}

// ========== 账号绑定修改（JWT） POST /auth/profile/* ==========

/** 发送绑定验证码 POST /auth/profile/send-code（后端契约 {channel, target}，channel: email | phone） */
export function profileSendCodeApi(target : string, channel : string) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		channel: channel,
		target: target
	} as UTSJSONObject
	return post('/auth/profile/send-code', payload)
}

/** 绑定/修改手机号（验证码确认） POST /auth/profile/phone */
export function profileBindPhoneApi(phone : string, code : string) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		phone: phone,
		code: code
	} as UTSJSONObject
	return post('/auth/profile/phone', payload)
}

/** 修改密码：发送短信验证码 POST /auth/profile/password/send-code（无 body，发往已绑定手机号） */
export function changePasswordSendCodeApi() : Promise<UTSJSONObject> {
	return post('/auth/profile/password/send-code', null)
}

/**
 * 修改密码（短信验证码确认） POST /auth/profile/password
 * @note 后端契约为 {code, password}；手机号由 JWT 定位，前端不传
 */
export function changePasswordApi(code : string, newPassword : string) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		code: code,
		password: newPassword
	} as UTSJSONObject
	return post('/auth/profile/password', payload)
}

/** 绑定/修改邮箱（验证码确认） POST /auth/profile/email {email, code} */
export function profileBindEmailApi(email : string, code : string) : Promise<UTSJSONObject> {
	const payload : UTSJSONObject = {
		email: email,
		code: code
	} as UTSJSONObject
	return post('/auth/profile/email', payload)
}

// ========== 登录账号修改与注销（JWT） /auth/account ==========

/** 发送修改登录账号验证码 POST /auth/account/send-code（无 body，发往已绑定手机号） */
export function accountSendCodeApi() : Promise<UTSJSONObject> {
	return post('/auth/account/send-code', null)
}

/**
 * 修改登录账号 PUT /auth/account {account, code}
 * @note 后端成功时重签 JWT（claim 同步新账号，ADR-0012 §5），返回与登录同构的 token + user；
 *       账号格式：4-20 位字母数字下划线
 */
export function updateAccountApi(account : string, code : string) : Promise<LoginResult> {
	const payload : UTSJSONObject = {
		account: account,
		code: code
	} as UTSJSONObject
	return put('/auth/account', payload).then((data : UTSJSONObject) : LoginResult => {
		const token = data['token'] as string
		const refreshToken = toStr(data['refresh_token'], '')
		const user = buildUserInfo(data)
		return { token: token, user: user, refresh_token: refreshToken } as LoginResult
	})
}

/** 注销账号 DELETE /auth/account（硬删，不可恢复；成功后本地需 clearAuthData） */
export function deleteAccountApi() : Promise<UTSJSONObject> {
	return del('/auth/account')
}

