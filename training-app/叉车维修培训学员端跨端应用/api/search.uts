/**
 * 全局搜索 API（ADR-0018 引入 / ADR-0049 定口径）
 *
 * 接口：GET /search（公开访问，无需登录）
 *   keyword       必填，模糊匹配 course/chapter/question/content/topic
 *   type          可选，course | chapter | question | content | topic
 *   page          可选，默认 1
 *   page_size     可选，默认 20
 *   credential_id 可选，显式声明的当前证件（ADR-0047 §4）
 *
 *   缺省返回各分区 top 5 + 总数；指定 type 时按分页返回
 *
 * ## 证件分区为什么必须显式传（#979 M6，2026-09-15 核验）
 *
 * `/api/search` 挂在 `api` 组下，该组**没有** `JWTAuth` / `OptionalAuth`（router.go:89-91），
 * 而 `middleware.CredentialScoped` 的兜底分支要求 `roleOf(c) == student`（credential_scope.go:42）
 * —— 没有 JWT 解析就没有角色 ⇒ **兜底永不生效**。因此不传 `credential_id` 时搜索是
 * 「全证件不分区」，不是「按当前证件」。Web 侧是显式传的（SearchPage.vue），移动端此前漏传。
 *
 * ## 出口收紧（#652 T14）
 *
 * 两个出口由裸 `get(...).then(...)` 收紧至 mapper-callback 便捷面 `getMapped<T>`（#639 出口家族）：
 * 请求形态逐字不变（getMapped 的 query 序列化与 get 同通路），响应字段读取也逐行不变——
 * 变的只是出口签名带 DTO 类型、内联映射收敛为 `buildSearchResult` / `buildSearchPagedResult`
 * 具名函数（与 #643 T05 已收紧域同构：出口一行委托，映射只有一份实现）。
 */
import { getMapped } from './request'
import { toNumber, toStr } from './helpers'
import type { SearchItem, SearchCategoryResult, SearchResult, SearchPagedResult } from '../types/index'



function buildSearchItem(obj : UTSJSONObject) : SearchItem {
	return {
		type: toStr(obj['type']),
		id: toNumber(obj['id']),
		title: toStr(obj['title']),
		cover: toStr(obj['cover']),
		summary: toStr(obj['summary']),
		snippet: toStr(obj['snippet']),
		hit_field: toStr(obj['hit_field']),
		parent_id: toNumber(obj['parent_id']),
	} as SearchItem
}

function buildSearchCategoryResult(obj : UTSJSONObject | null) : SearchCategoryResult {
	if (obj == null) {
		return { items: [] as SearchItem[], total: 0 } as SearchCategoryResult
	}
	const items : SearchItem[] = []
	const itemsRaw = obj['items']
	if (itemsRaw != null) {
		const arr = itemsRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			items.push(buildSearchItem(arr[i]))
		}
	}
	return {
		items: items,
		total: toNumber(obj['total']),
	} as SearchCategoryResult
}

/** 全局搜索结果映射（#652 T14：收紧至 getMapped 出口，响应字段读取逐行不变） */
function buildSearchResult(data : UTSJSONObject, keyword : string) : SearchResult {
	const coursesRaw = data['courses']
	const chaptersRaw = data['chapters']
	const questionsRaw = data['questions']
	const contentsRaw = data['contents']
	const topicsRaw = data['topics']
	return {
		keyword: toStr(data['keyword'], keyword),
		courses: buildSearchCategoryResult(coursesRaw != null ? coursesRaw as UTSJSONObject : null),
		chapters: buildSearchCategoryResult(chaptersRaw != null ? chaptersRaw as UTSJSONObject : null),
		questions: buildSearchCategoryResult(questionsRaw != null ? questionsRaw as UTSJSONObject : null),
		contents: buildSearchCategoryResult(contentsRaw != null ? contentsRaw as UTSJSONObject : null),
		topics: buildSearchCategoryResult(topicsRaw != null ? topicsRaw as UTSJSONObject : null),
	} as SearchResult
}

/** 指定类型分页结果映射（同口径；keyword/type 是回退缺省值，须由出口传入） */
function buildSearchPagedResult(data : UTSJSONObject, keyword : string, type : string) : SearchPagedResult {
	const items : SearchItem[] = []
	const itemsRaw = data['items']
	if (itemsRaw != null) {
		const arr = itemsRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			items.push(buildSearchItem(arr[i]))
		}
	}
	return {
		keyword: toStr(data['keyword'], keyword),
		type: toStr(data['type'], type),
		total: toNumber(data['total']),
		page: toNumber(data['page'], 1),
		pages: toNumber(data['pages']),
		items: items,
	} as SearchPagedResult
}

/** 显式证件参数：>0 才下发（0 表示「未声明」，与服务端 nil 语义一致） */
function withCredential(params : UTSJSONObject, credentialId : number) : UTSJSONObject {
	if (credentialId > 0) {
		params['credential_id'] = credentialId.toString()
	}
	return params
}

/**
 * 全局搜索（全部分区，缺省各分区 top 5）
 * @param keyword 搜索关键词（必填）
 * @param credentialId 当前证件 ID（>0 时下发 credential_id，见文件头「证件分区」）
 */
export function searchAllApi(keyword : string, credentialId : number = 0) : Promise<SearchResult> {
	const params : UTSJSONObject = withCredential({ keyword: keyword } as UTSJSONObject, credentialId)
	return getMapped<SearchResult>('/search', params, (data : UTSJSONObject) : SearchResult => buildSearchResult(data, keyword))
}

/**
 * 指定类型搜索（分页）
 * @param keyword 搜索关键词
 * @param type 类型：course / chapter / question / content / topic
 * @param page 页码
 * @param pageSize 每页条数
 * @param credentialId 当前证件 ID（>0 时下发 credential_id）
 */
export function searchByTypeApi(keyword : string, type : string, page : number = 1, pageSize : number = 20, credentialId : number = 0) : Promise<SearchPagedResult> {
	const params : UTSJSONObject = withCredential({
		keyword: keyword,
		type: type,
		page: page.toString(),
		page_size: pageSize.toString(),
	} as UTSJSONObject, credentialId)
	return getMapped<SearchPagedResult>('/search', params, (data : UTSJSONObject) : SearchPagedResult => buildSearchPagedResult(data, keyword, type))
}
