/**
 * 学员端设备验收域 API（#2743）
 *
 * 契约（后端接口待建，形状先定死；落地时按下列路径实现即可，端上零改动）：
 *   GET  /api/acceptance/tasks?status=pending   待验收列表
 *   GET  /api/acceptance/tasks/:id              验收单详情（task + items）
 *   POST /api/acceptance/tasks/:id/submit       提交逐项结论 + 备注 + 凭证
 *   GET  /api/acceptance/history?page=&page_size= 验收历史（已提交）
 *   POST /api/acceptance/upload                 凭证上传（multipart）
 *
 * ⚠️ **唯一切换点**：`ACCEPTANCE_USE_MOCK`。
 * 后端接口交付前为 `true`：数据源是 `api/acceptanceMock.uts`（端内闭环，可提交、可看历史）。
 * 交付后改成 `false`：同一批函数改走上面的真实 HTTP，页面与 composable 一行不用动。
 *
 * 后端未交付的来路：本仓 `inspection` 域只服务管理端巡检（`/admin/inspection/*`），
 * 学员侧没有任何验收端点 —— 不把巡检接口当验收接口用（两套语义，复用会把权限口径带歪）。
 */
import { getMapped, postMapped, uploadFile } from './request'
import { decodeList, getPaged } from './envelope'
import { toNumber, toStr } from './helpers'
import {
	mockAcceptanceTasks,
	mockAcceptanceDetail,
	mockAcceptanceHistory,
	mockAcceptanceSubmit,
	mockAcceptanceUpload,
} from './acceptanceMock'
import type { Page } from './envelope'
import type {
	AcceptanceTask,
	AcceptanceTaskDetail,
	AcceptanceItem,
	AcceptanceProof,
	AcceptanceSubmitItem,
	AcceptanceSubmitResult,
	AcceptanceHistoryItem,
} from '../types/index'

/** 端内 mock 开关（唯一一处；后端验收接口交付后改为 false） */
export const ACCEPTANCE_USE_MOCK = true

/** 真实接口的路径前缀（mock 关闭后生效） */
const ACCEPTANCE_BASE = '/acceptance'

/** 从 UTSJSONObject 构造 AcceptanceProof（ADR-0003 手动 JSON 映射） */
function buildProof(obj : UTSJSONObject) : AcceptanceProof {
	return {
		url: toStr(obj['url']),
		name: toStr(obj['name']),
		kind: toStr(obj['kind'], 'image'),
	} as AcceptanceProof
}

function buildProofs(raw : any | null) : AcceptanceProof[] {
	const out : AcceptanceProof[] = []
	if (raw == null) return out
	const arr = raw as Array<UTSJSONObject>
	for (let i = 0; i < arr.length; i++) out.push(buildProof(arr[i]))
	return out
}

function buildItem(obj : UTSJSONObject) : AcceptanceItem {
	return {
		id: toNumber(obj['id']),
		name: toStr(obj['name']),
		requirement: toStr(obj['requirement']),
		result: toStr(obj['result']),
		remark: toStr(obj['remark']),
		proofs: buildProofs(obj['proofs']),
	} as AcceptanceItem
}

function buildTask(obj : UTSJSONObject) : AcceptanceTask {
	const submittedRaw : any | null = obj['submitted_at']
	return {
		id: toNumber(obj['id']),
		code: toStr(obj['code']),
		title: toStr(obj['title']),
		course_name: toStr(obj['course_name']),
		instructor: toStr(obj['instructor']),
		deadline: toStr(obj['deadline']),
		status: toStr(obj['status'], 'pending'),
		result: toStr(obj['result']),
		submitted_at: submittedRaw != null ? toStr(submittedRaw) : null,
		item_count: toNumber(obj['item_count']),
		decided_count: toNumber(obj['decided_count']),
		failed_count: toNumber(obj['failed_count']),
	} as AcceptanceTask
}

function buildDetail(obj : UTSJSONObject) : AcceptanceTaskDetail {
	const taskRaw = obj['task']
	const items : AcceptanceItem[] = []
	const itemsRaw = obj['items']
	if (itemsRaw != null) {
		const arr = itemsRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) items.push(buildItem(arr[i]))
	}
	return {
		task: taskRaw != null ? buildTask(taskRaw as UTSJSONObject) : buildTask({} as UTSJSONObject),
		items: items,
	} as AcceptanceTaskDetail
}

function buildHistory(obj : UTSJSONObject) : AcceptanceHistoryItem {
	return {
		id: toNumber(obj['id']),
		code: toStr(obj['code']),
		title: toStr(obj['title']),
		course_name: toStr(obj['course_name']),
		status: toStr(obj['status']),
		result: toStr(obj['result']),
		submitted_at: toStr(obj['submitted_at']),
		item_count: toNumber(obj['item_count']),
		failed_count: toNumber(obj['failed_count']),
	} as AcceptanceHistoryItem
}

/** 待验收列表 */
export function listPendingAcceptanceApi() : Promise<AcceptanceTask[]> {
	if (ACCEPTANCE_USE_MOCK) {
		return Promise.resolve(mockAcceptanceTasks())
	}
	const params : UTSJSONObject = { status: 'pending' } as UTSJSONObject
	const url = ACCEPTANCE_BASE + '/tasks'
	return getMapped<AcceptanceTask[]>(url, params, (data : UTSJSONObject) : AcceptanceTask[] => {
		return decodeList<AcceptanceTask>(data, url, (obj : UTSJSONObject) : AcceptanceTask => buildTask(obj))
	})
}

/** 验收单详情 */
export function getAcceptanceDetailApi(id : number) : Promise<AcceptanceTaskDetail> {
	if (ACCEPTANCE_USE_MOCK) {
		const detail = mockAcceptanceDetail(id)
		if (detail == null) {
			// 不用裸 Promise.reject：Kotlin 侧会推成 UTSPromise<Unit>，与返回类型不符
			return new Promise<AcceptanceTaskDetail>((resolve, reject) => {
				reject(new Error('验收单不存在'))
			})
		}
		return Promise.resolve(detail)
	}
	const url = ACCEPTANCE_BASE + '/tasks/' + id.toString()
	return getMapped<AcceptanceTaskDetail>(url, null, (data : UTSJSONObject) : AcceptanceTaskDetail => {
		return buildDetail(data)
	})
}

/**
 * 提交验收结果
 *
 * @param items 逐项结论载荷（`item_id` / `result` / `remark` / `proofs`），必须与详情里的项一一对应。
 *        端上只提交**已确认**的项，未确认项由 `utils/acceptanceForm.acceptanceValidate` 在提交前拦下。
 */
export function submitAcceptanceApi(taskId : number, items : AcceptanceSubmitItem[]) : Promise<AcceptanceSubmitResult> {
	if (ACCEPTANCE_USE_MOCK) {
		return new Promise<AcceptanceSubmitResult>((resolve, reject) => {
			try {
				resolve(mockAcceptanceSubmit(taskId, items))
			} catch (e) {
				reject(e)
			}
		})
	}
	const payloadItems : UTSJSONObject[] = []
	for (let i = 0; i < items.length; i++) {
		const item = items[i]
		const proofs : UTSJSONObject[] = []
		for (let j = 0; j < item.proofs.length; j++) {
			const p = item.proofs[j]
			proofs.push({ url: p.url, name: p.name, kind: p.kind } as UTSJSONObject)
		}
		payloadItems.push({
			item_id: item.item_id,
			result: item.result,
			remark: item.remark,
			proofs: proofs,
		} as UTSJSONObject)
	}
	const payload : UTSJSONObject = { items: payloadItems } as UTSJSONObject
	const url = ACCEPTANCE_BASE + '/tasks/' + taskId.toString() + '/submit'
	return postMapped<AcceptanceSubmitResult>(url, payload, (data : UTSJSONObject) : AcceptanceSubmitResult => {
		const submittedRaw : any | null = data['submitted_at']
		return {
			task_id: toNumber(data['task_id'], taskId),
			status: toStr(data['status'], 'submitted'),
			result: toStr(data['result']),
			submitted_at: submittedRaw != null ? toStr(submittedRaw) : '',
		} as AcceptanceSubmitResult
	})
}

/** 验收历史（已提交的单据；分页形状与全仓分页站点一致） */
export function listAcceptanceHistoryApi(page : number = 1, pageSize : number = 20) : Promise<Page<AcceptanceHistoryItem>> {
	if (ACCEPTANCE_USE_MOCK) {
		const items = mockAcceptanceHistory()
		return Promise.resolve({
			items: items,
			total: items.length,
			hasMore: false,
		} as Page<AcceptanceHistoryItem>)
	}
	const url = ACCEPTANCE_BASE + '/history'
	return getPaged<AcceptanceHistoryItem>(url, page, pageSize, (obj : UTSJSONObject) : AcceptanceHistoryItem => {
		return buildHistory(obj)
	})
}

/**
 * 上传验收凭证（图片 / 文件共用一个入口，`kind` 由调用方声明）
 *
 * mock 模式原样回本地临时路径（可立即回显）；真实接口走 multipart。
 */
export function uploadAcceptanceProofApi(filePath : string, name : string, kind : string) : Promise<AcceptanceProof> {
	if (ACCEPTANCE_USE_MOCK) {
		return Promise.resolve(mockAcceptanceUpload(filePath, name, kind))
	}
	const formData : UTSJSONObject = { kind: kind } as UTSJSONObject
	const url = ACCEPTANCE_BASE + '/upload'
	return uploadFile(url, filePath, 'file', formData).then((data : UTSJSONObject) : AcceptanceProof => {
		return buildProof(data)
	})
}
