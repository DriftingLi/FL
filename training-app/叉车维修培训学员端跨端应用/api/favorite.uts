/**
 * 收藏模块 API（ADR-0018）
 * - 多态收藏：target_type ∈ course / chapter / question / featured / topic
 * - user + type + id 唯一（幂等）
 *
 * 接口：
 *   GET  /api/favorites                    我的收藏列表（快照回填）
 *   POST /api/favorites                    添加收藏（幂等）
 *   DELETE /api/favorites/:id              取消收藏（仅本人）
 *   GET  /api/favorites/check              检查是否已收藏
 */
import { get, getMapped, post, postMapped, del } from './request'
import { toNumber, toStr } from './helpers'
import { decodePage } from './envelope'
import type { FavoriteItem, FavoriteListResult, FavoriteCheckResult } from '../types/index'



/** 从 UTSJSONObject 构造 FavoriteItem */
function buildFavoriteItem(obj : UTSJSONObject) : FavoriteItem {
	return {
		favorite_id: toNumber(obj['favorite_id'], toNumber(obj['id'])),
		target_type: toStr(obj['target_type']),
		target_id: toNumber(obj['target_id']),
		// 所属课程 ID（#1089）：chapter 落点要 course_id + chapter_id 两键；字段缺失/null ⇒ 0。
		// 走现成 toNumber（`null → 0`），不要 `obj['course_id'] as number` —— 后者在字段缺省时
		// 会抛 Kotlin NullPointerException（同 toNumberOrNull 的注释所述）。
		course_id: toNumber(obj['course_id']),
		title: toStr(obj['title']),
		cover: toStr(obj['cover']),
		created_at: toStr(obj['created_at']),
	} as FavoriteItem
}

/** 从 UTSJSONObject 构造 FavoriteCheckResult */
function buildFavoriteCheckResult(data : UTSJSONObject) : FavoriteCheckResult {
	return {
		favorited: data['favorited'] == true,
		favorite_id: toNumber(data['favorite_id']),
		} as FavoriteCheckResult
}

/**
 * 我的收藏列表
 * @note 具名键站点（后端列表字段为 `favorites`，非 `items`）：数组键显式声明为 keys 一位，
 *       不靠模块默认键序兜底（ADR-0037 PR-D）。PR-F #1666 起 `page` / `page_size` 两字段删除，
 *       分页字段只认 total（消费方按 items 长度 / total 判到底）。
 *       #1737：三参壳 `buildFavoriteListResult` 消亡，装载内联进 mapper 箭头。本出口类型仍是
 *       `FavoriteListResult`（只有 items / total），故走 `decodePage` 短接而非 `getPaged`
 *       （后者出口是 `Page<T>`，唯一按 `FavoriteListResult` 标注的消费方在 .uvue 里，不为它抬门的级）。
 */
export function getFavoritesApi(targetType : string = '', page : number = 1, pageSize : number = 20) : Promise<FavoriteListResult> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	} as UTSJSONObject
	if (targetType.length > 0) {
		params['target_type'] = targetType
	}
	return getMapped<FavoriteListResult>('/favorites', params, (data : UTSJSONObject) : FavoriteListResult => {
		const paged = decodePage<FavoriteItem>(data, '/favorites', page, pageSize, (obj : UTSJSONObject) : FavoriteItem => buildFavoriteItem(obj), ['favorites'])
		return {
			items: paged.items,
			total: paged.total,
		} as FavoriteListResult
	})
}

/**
 * 添加收藏（幂等）
 */
export function addFavoriteApi(targetType : string, targetId : number) : Promise<FavoriteItem> {
	const payload : UTSJSONObject = {
		target_type: targetType,
		target_id: targetId,
	} as UTSJSONObject
	return postMapped<FavoriteItem>('/favorites', payload, (data : UTSJSONObject) : FavoriteItem => buildFavoriteItem(data))
}

/**
 * 取消收藏
 */
export function removeFavoriteApi(favoriteId : number) : Promise<void> {
	return del('/favorites/' + favoriteId.toString()).then(() : void => {
		// 无返回数据
	})
}

/**
 * 检查是否已收藏
 */
export function checkFavoriteApi(targetType : string, targetId : number) : Promise<FavoriteCheckResult> {
	const params : UTSJSONObject = {
		target_type: targetType,
		target_id: targetId.toString(),
	} as UTSJSONObject
	return getMapped<FavoriteCheckResult>('/favorites/check', params, (data : UTSJSONObject) : FavoriteCheckResult => buildFavoriteCheckResult(data))
}