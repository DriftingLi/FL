/**
 * 学习资料 API（ADR-0018）
 * - 资料 = 已发布课程下章节挂载的课件附件（chapter_file 聚合视图）
 *
 * 接口：
 *   GET  /api/materials                      资料列表（可按课程过滤）
 *   GET  /api/materials/:id                  资料详情（含课程/章节回填）
 *   GET  /api/materials/:id/download         下载地址
 *   GET  /api/student/materials              学员可访问资料（同列表别名）
 *
 * 出口收紧（T15 批 B #653）：四条**有响应载荷**的出口全部走 `getMapped<T>`（#639 出口家族），
 * 拆包后的映射真相收在本文件三个私有 `build*`（ADR-0003）⇒ 页面层只消费 DTO，不再出现
 * `UTSJSONObject` 取值。请求形态逐字保持：`getMapped` 与 `get` 是同一条 finalURL 手动 query
 * 序列化 + 同 `opts.url` / `opts.method` 通路，只在拆包后接 mapper。
 * @note 裸出口白名单（T15 批 B #653 登记）：`downloadAndOpenMaterialApi` 是**编排出口**，留裸 ——
 *   它没有自己的响应载荷（组合上一条 download 出口 + `uni.downloadFile` + `uni.openDocument`），
 *   返回 `Promise<string>`（空串=成功，非空=给用户看的失败原因）；mapper 只能映射「拆包后的 data」，
 *   套上去等于把六条失败语义挪进一个永远拿不到 reject 的位置 ⇒ 留裸，映射面已由本文件收齐。
 * @note 三个 DTO 的**家不在本文件**：`MaterialItem` / `MaterialListResult` / `MaterialDownloadInfo`
 *   声明在 `types/course.uts`（资料是 chapter_file 的聚合视图，属课程类型族），经 `types/index` re-export。
 *   #653 票面「域 api 导出显式 DTO」在此按「引用既有共享 DTO」满足：把类型搬进域 api 会同时改
 *   `pages/resources/materials.uvue` 的 import 面（票面要求页面零改动）并拆散课程类型族 ⇒ 不搬。
 * @note catch 参数零 `: any` 注解（守护规则 H，同 forum.uts）
 */
import { getMapped } from './request'
import { toNumber, toStr } from './helpers'
import type { MaterialItem, MaterialListResult, MaterialDownloadInfo } from '../types/index'

function buildMaterialItem(obj : UTSJSONObject) : MaterialItem {
	return {
		file_id: toNumber(obj['file_id'], toNumber(obj['id'])),
		chapter_id: toNumber(obj['chapter_id']),
		chapter_title: toStr(obj['chapter_title']),
		course_id: toNumber(obj['course_id']),
		course_name: toStr(obj['course_name']),
		file_name: toStr(obj['file_name']),
		file_url: toStr(obj['file_url']),
		content_type: toStr(obj['content_type']),
		file_size: toNumber(obj['file_size']),
		created_at: toStr(obj['created_at']),
	} as MaterialItem
}

/** 列表信封 → MaterialListResult（`/materials` 与 `/student/materials` 共用同一后端 DTO） */
function buildMaterialListResult(data : UTSJSONObject) : MaterialListResult {
	const materials : MaterialItem[] = []
	const listRaw = data['materials']
	if (listRaw != null) {
		const arr = listRaw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			materials.push(buildMaterialItem(arr[i]))
		}
	}
	return {
		materials: materials,
		total: toNumber(data['total']),
		page: toNumber(data['page'], 1),
		pages: toNumber(data['pages']),
	} as MaterialListResult
}

/** 下载地址信封 → MaterialDownloadInfo */
function buildMaterialDownloadInfo(data : UTSJSONObject) : MaterialDownloadInfo {
	return {
		file_url: toStr(data['file_url']),
		file_name: toStr(data['file_name']),
	} as MaterialDownloadInfo
}

/**
 * 资料列表
 * @param courseId 可选，按课程过滤
 * @param page 页码
 * @param pageSize 每页条数
 */
export function getMaterialsApi(courseId : number = 0, page : number = 1, pageSize : number = 20) : Promise<MaterialListResult> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	} as UTSJSONObject
	if (courseId > 0) {
		params['course_id'] = courseId.toString()
	}
	return getMapped<MaterialListResult>('/materials', params, (data : UTSJSONObject) : MaterialListResult => buildMaterialListResult(data))
}

/**
 * 资料详情
 * @param materialId 资料 ID（file_id）
 */
export function getMaterialDetailApi(materialId : number) : Promise<MaterialItem> {
	return getMapped<MaterialItem>('/materials/' + materialId.toString(), null, (data : UTSJSONObject) : MaterialItem => buildMaterialItem(data))
}

/**
 * 获取下载地址
 * @param materialId 资料 ID
 */
export function getMaterialDownloadApi(materialId : number) : Promise<MaterialDownloadInfo> {
	return getMapped<MaterialDownloadInfo>('/materials/' + materialId.toString() + '/download', null, (data : UTSJSONObject) : MaterialDownloadInfo => buildMaterialDownloadInfo(data))
}

/**
 * 下载并打开资料（#814）
 * 两步：GET /materials/:id/download 取静态直链 → uni.downloadFile 落地临时文件 → openDocument 打开。
 * @note 下载动作收在 api 层：页面层禁 uni.downloadFile 裸调（先例 utils/profileContract.test.js:216、
 *       utils/dashboardContract.test.js:190 的页面层「零直发请求」口径）
 * @returns 空串 = 成功；非空 = 给用户看的失败原因
 */
export function downloadAndOpenMaterialApi(materialId : number) : Promise<string> {
	return getMaterialDownloadApi(materialId).then((info : MaterialDownloadInfo) : Promise<string> => {
		if (info.file_url.length == 0) {
			return Promise.resolve('资料地址无效')
		}
		// 静态直链含中文/空格，需编码；展开符会触发守护规则 I（UTS 展开会被误判为未定义标识符）
		const encodedURL = encodeURI(info.file_url) ?? ''
		return new Promise<string>((resolve) => {
			uni.downloadFile({
				url: encodedURL,
				success: (res) => {
					if (res.statusCode != 200) {
						resolve('资料下载失败（' + res.statusCode.toString() + '）')
						return
					}
					// 下载成功即打开：失败（如端侧不支持该文件类型）给明确提示，不静默
					uni.openDocument({
						filePath: res.tempFilePath,
						success: () : void => { resolve('') },
						fail: () : void => { resolve('无法打开此文件') }
					})
				},
				fail: (err) => {
					const errMsg = err.errMsg
					if (errMsg != null && errMsg.indexOf('timeout') >= 0) {
						resolve('资料下载超时，请稍后重试')
					} else {
						resolve('资料下载失败，请检查网络后重试')
					}
				}
			})
		})
	}).catch((e) : string => {
		console.error('[downloadAndOpenMaterialApi] failed:', e)
		return '资料下载失败'
	})
}

/**
 * 学员可访问资料（同列表，别名端点）
 */
export function getStudentMaterialsApi(page : number = 1, pageSize : number = 20) : Promise<MaterialListResult> {
	const params : UTSJSONObject = {
		page: page.toString(),
		page_size: pageSize.toString(),
	} as UTSJSONObject
	return getMapped<MaterialListResult>('/student/materials', params, (data : UTSJSONObject) : MaterialListResult => buildMaterialListResult(data))
}
