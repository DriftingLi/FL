/**
 * AI 助手 API
 * - GET  /ai-assistant/models
 * - POST /ai-assistant/chat           流式 SSE（登录可保存会话）
 * - GET/POST/DELETE/PATCH sessions
 * - GET/POST/DELETE user-models
 *
 * @note chat 为 SSE 流：event: delta/done/error + data: {...}
 *       uni.request 不支持增量流式回调，这里整包接收后解析 delta 文本。
 */
import { del, getMapped, postMapped, patchMapped, uploadFile, renewOrExpire, AUTH_EXPIRED_MESSAGE } from './request'
import { toBool, toNumber, toStr } from './helpers'
import { API_BASE_URL, AI_REQUEST_TIMEOUT } from '../config/env'
import { STORAGE_KEY_TOKEN } from '../constants/app'
import { getStorage } from '../utils/storage'
import type {
	AiChatMessage,
	AiModel,
	AiUserModel,
	AiSession,
	AiSessionMessage,
	AiDiagnosisSource,
	AiDiagnosisBadge,
	AiDiagnosisMeta,
	DiagnosisIntentBrand,
	DiagnosisFaq,
	DiagnosisIntents,
	DiagnosisCatalogItem,
	DiagnosisHealth,
	DiagnosisCodeHint,
} from '../types/index'



function buildAiModel(obj : UTSJSONObject) : AiModel {
	return {
		id: toNumber(obj['id'], toNumber(obj['model_id'])),
		name: toStr(obj['name'], toStr(obj['display_name'], '默认模型')),
		model: toStr(obj['model'], toStr(obj['model_name'])),
		source: toStr(obj['source'], toStr(obj['model_source'], 'admin')),
		description: toStr(obj['description']),
	} as AiModel
}

function buildUserModel(obj : UTSJSONObject) : AiUserModel {
	return {
		id: toNumber(obj['id'], toNumber(obj['model_id'])),
		name: toStr(obj['name'], toStr(obj['display_name'], '自定义模型')),
		base_url: toStr(obj['base_url'], toStr(obj['baseUrl'])),
		model: toStr(obj['model'], toStr(obj['model_name'])),
		api_key: toStr(obj['api_key'], toStr(obj['apiKey'])),
		created_at: toStr(obj['created_at']),
	} as AiUserModel
}

export function buildSession(obj : UTSJSONObject) : AiSession {
	return {
		id: toNumber(obj['id'], toNumber(obj['session_id'])),
		title: toStr(obj['title'], '新对话'),
		model_source: toStr(obj['model_source']),
		model_id: toNumber(obj['model_id']),
		created_at: toStr(obj['created_at']),
		updated_at: toStr(obj['updated_at']),
	} as AiSession
}

/**
 * 解析诊断来源资料（**单点**）：SSE `sources` 事件与回看消息 DTO 走同一份实现。
 *
 * 为什么必须单点：两条路的数据同源（后端 `ai_chat_messages.sources` 列与 SSE 透传的是同一个
 * `answer_sources`），形状必须一致；分成两份解析就会出现「当轮有来源、回看没有」这类假差异。
 *
 * metadata 展平（见 `types/ai.uts` 的 `AiDiagnosisSource` 说明）：`metadata` 允许缺失（后端也可能给
 * 空对象），字段逐个兜底；`text` 为空视为坏条目丢弃（空卡片对用户是噪声）。
 */
export function parseDiagnosisSources(arr : Array<UTSJSONObject>) : AiDiagnosisSource[] {
	const out : AiDiagnosisSource[] = []
	for (let i = 0; i < arr.length; i++) {
		const item = arr[i]
		const text = toStr(item['text'])
		if (text.length == 0) continue
		const src : AiDiagnosisSource = {
			id: toStr(item['id']),
			text: text,
		}
		const meta = item['metadata']
		if (meta != null) {
			const m = meta as UTSJSONObject
			const ps = m['page_start']
			if (ps != null) src.page_start = toNumber(ps)
			const pe = m['page_end']
			if (pe != null) src.page_end = toNumber(pe)
			const url = toStr(m['source_url'])
			if (url.length > 0) src.source_url = url
		}
		out.push(src)
	}
	return out
}

/**
 * 解析诊断能力徽章与耗时（**单点**）：当轮 `done.meta` 与回看消息 DTO 走同一份实现（#2361）。
 *
 * 为什么必须单点：两路数据同源（后端 `ai_chat_messages.meta` 列与 SSE `done.meta` 是同一份
 * `DiagnosisMeta`），分成两份解析就会出现「当轮有徽章、回看没有」这类假差异。
 *
 * ⚠️ 两路的**键缺失**不对称：当轮 `done.meta` 带 `omitempty`，可能只有 `elapsed` 没有 `badges`
 * （也可能反过来）；回看 `messages[].meta` 键常在且 `badges` 恒为数组。故这里一律按「缺键即空」
 * 兜底，产出**恒定形状**的 `AiDiagnosisMeta`（badges 恒为数组、elapsed 恒为数值）——
 * 归一后的三态判定在 `utils/aiDiagnosisMeta.uts` 的 `metaViewOf`，两处各司其职。
 */
export function parseDiagnosisMeta(raw : any | null) : AiDiagnosisMeta | null {
	if (raw == null) return null
	const obj = raw as UTSJSONObject
	const badges : AiDiagnosisBadge[] = []
	const rawBadges = obj['badges']
	if (rawBadges != null) {
		const arr = rawBadges as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			const item = arr[i]
			const badge : AiDiagnosisBadge = {
				name: toStr(item['name']),
				emoji: toStr(item['emoji']),
				cls: toStr(item['cls']),
			}
			badges.push(badge)
		}
	}
	const meta : AiDiagnosisMeta = {
		badges: badges,
		elapsed: toNumber(obj['elapsed']),
	}
	return meta
}

function buildSessionMessage(obj : UTSJSONObject) : AiSessionMessage {
	const msg : AiSessionMessage = {
		id: toNumber(obj['id'], toNumber(obj['message_id'])),
		role: toStr(obj['role'], 'assistant'),
		content: toStr(obj['content']),
		created_at: toStr(obj['created_at']),
	}
	// 回看来源（#988）：后端按 ADR-0033 把 sources 存在助手消息行上，该列可为 null（存量消息/非诊断轮）
	const rawSources = obj['sources']
	if (rawSources != null) {
		const list = parseDiagnosisSources(rawSources as Array<UTSJSONObject>)
		if (list.length > 0) msg.sources = list
	}
	// 回看徽章与耗时（#2361）：后端 meta 列对非诊断轮与存量消息为 null ⇒ 有值才写字段，
	// 不写字段（而不是写 null）—— #2328 的事故链正是「optional 被显式填 null」。
	const meta = parseDiagnosisMeta(obj['meta'])
	if (meta != null) msg.meta = meta
	return msg
}

/** 从 data 中提取数组（兼容直接数组 / {key:[]}） */
function extractArray(data : UTSJSONObject, key : string) : Array<UTSJSONObject> {
	const raw = data[key]
	if (raw != null) {
		return raw as Array<UTSJSONObject>
	}
	// data 本身可能就是数组（request 层把 data 解包后若是数组会转成 UTSJSONObject 有问题）
	// 这里再尝试 items/list
	const items = data['items']
	if (items != null) return items as Array<UTSJSONObject>
	const list = data['list']
	if (list != null) return list as Array<UTSJSONObject>
	return [] as Array<UTSJSONObject>
}

/** 可用模型列表（公开） */
export function getAiModelsApi() : Promise<AiModel[]> {
	return getMapped<AiModel[]>('/ai-assistant/models', null, (data : UTSJSONObject) : AiModel[] => {
		const arr = extractArray(data, 'models')
		const out : AiModel[] = []
		for (let i = 0; i < arr.length; i++) {
			out.push(buildAiModel(arr[i]))
		}
		return out
	})
	// 原 `.catch(() => [])` 吞错兜底已删（ADR-0037 ③）：返回空列表会把 outlet 失败
	// （网络 / 401 刷新终态）静默折成「没有可用模型」，维护者排障看不到任何信号。
	// 失败原样上抛，交调用方（ai-assistant / ai-settings 页的 try/catch 已在）呈现。
}

/** 用户自定义模型列表 */
export function getAiUserModelsApi() : Promise<AiUserModel[]> {
	return getMapped<AiUserModel[]>('/ai-assistant/user-models', null, (data : UTSJSONObject) : AiUserModel[] => {
		const arr = extractArray(data, 'models')
		// 兼容 user_models / items
		let list = arr
		if (list.length == 0) {
			const um = data['user_models']
			if (um != null) list = um as Array<UTSJSONObject>
		}
		const out : AiUserModel[] = []
		for (let i = 0; i < list.length; i++) {
			out.push(buildUserModel(list[i]))
		}
		return out
	})
}

/** 保存自定义模型（新建或更新：有 id 时后端若支持则带上） */
export function saveAiUserModelApi(payload : UTSJSONObject) : Promise<AiUserModel> {
	return postMapped<AiUserModel>('/ai-assistant/user-models', payload, (data : UTSJSONObject) : AiUserModel => {
		// 后端可能直接返回模型对象，或包在 model 字段
		const m = data['model']
		if (m != null) {
			return buildUserModel(m as UTSJSONObject)
		}
		return buildUserModel(data)
	})
}

/** 删除自定义模型 */
export function deleteAiUserModelApi(id : number) : Promise<void> {
	return del('/ai-assistant/user-models/' + id).then((_d : UTSJSONObject) : void => { })
}

/**
 * 上传 AI 对话图片（复用 AI 专用 /ai-assistant/upload-image；严禁复用论坛上传端点）
 * @param filePath 本地临时图片路径（uni.chooseImage 返回）
 * @returns 可随消息携带的图片 URL
 */
export function uploadAiImageApi(filePath : string) : Promise<string> {
	return uploadFile('/ai-assistant/upload-image', filePath, 'file').then((data : UTSJSONObject) : string => {
		const url = toStr(data['url'], '')
		return url
	})
}

/**
 * 双模式模型列表（normal / expert 各绑定一个平台模型）
 * @returns { normal?: AiModel|null, expert?: AiModel|null }
 */
export function getAiModesApi() : Promise<UTSJSONObject> {
	return getMapped<UTSJSONObject>('/ai-assistant/modes', null, (data : UTSJSONObject) : UTSJSONObject => {
		const out : UTSJSONObject = {}
		const normal = data['normal']
		if (normal != null) {
			out['normal'] = buildAiModel(normal as UTSJSONObject)
		}
		const expert = data['expert']
		if (expert != null) {
			out['expert'] = buildAiModel(expert as UTSJSONObject)
		}
		return out
	})
}

/**
 * 会话列表（按功能键**分区**）。
 *
 * `featureKey` 为空串 ⇒ **不发** `feature_key` ⇒ 后端落遗留 `ai_assistant` 区
 * （`service.go` 的 `ListSessions`：`featureKey == ""` → `FeatureAIAssistant`），
 * 与从前逐字一致 —— 通用页零回归。非空 ⇒ 只列该功能区会话（专项页）。
 *
 * ⚠️ **不变式（移动端 ADR-0013）：带键必有「列该区」的界面。** 给会话带键却没有任何界面列该区
 * ⇒ 该会话在「最近对话」里永久不可见、不可重开/改名/删除，而对话本身却以该键正常计费与路由
 * （#921 首版实测到的回归）。⇒ 新增带键调用点时，**调用方页面必须真的能列出该区**
 * （专项页的「最近对话」抽屉即该界面；守护见 `utils/aiFeatureEntryWiringContract.test.js` ④ 组）。
 */
export function getAiSessionsApi(featureKey : string) : Promise<AiSession[]> {
	const params : UTSJSONObject = {}
	if (featureKey.length > 0) {
		params['feature_key'] = featureKey
	}
	return getMapped<AiSession[]>('/ai-assistant/sessions', params, (data : UTSJSONObject) : AiSession[] => {
		const arr = extractArray(data, 'sessions')
		const out : AiSession[] = []
		for (let i = 0; i < arr.length; i++) {
			out.push(buildSession(arr[i]))
		}
		return out
	})
}

/**
 * 创建会话（`featureKey` 同 `getAiSessionsApi`：空串 = 不发键 ⇒ 遗留通用区；非空 = 该功能区）。
 *
 * 三个形参**全部必填**（不给 `featureKey` 默认值）：UTS 的默认值编译到 Kotlin 后不生效，
 * 而**默认值会让「忘了传键」静默通过** —— 分区归属是必须显式表态的事，守护按调用点判（ADR-0013）。
 */
export function createAiSessionApi(title : string, modelName : string, featureKey : string) : Promise<AiSession> {
	const payload : UTSJSONObject = { title: title }
	if (modelName.length > 0) {
		payload['model_name'] = modelName
	}
	if (featureKey.length > 0) {
		payload['feature_key'] = featureKey
	}
	return postMapped<AiSession>('/ai-assistant/sessions', payload, (data : UTSJSONObject) : AiSession => {
		const s = data['session']
		if (s != null) return buildSession(s as UTSJSONObject)
		return buildSession(data)
	})
}

/** 重命名会话 */
export function renameAiSessionApi(id : number, title : string) : Promise<AiSession> {
	const payload : UTSJSONObject = { title: title }
	return patchMapped<AiSession>('/ai-assistant/sessions/' + id + '/title', payload, (data : UTSJSONObject) : AiSession => {
		const s = data['session']
		if (s != null) return buildSession(s as UTSJSONObject)
		return buildSession(data)
	})
}

/** 删除会话 */
export function deleteAiSessionApi(id : number) : Promise<void> {
	return del('/ai-assistant/sessions/' + id).then((_d : UTSJSONObject) : void => { })
}

/** 会话消息 */
export function getAiSessionMessagesApi(id : number) : Promise<AiSessionMessage[]> {
	return getMapped<AiSessionMessage[]>('/ai-assistant/sessions/' + id + '/messages', null, (data : UTSJSONObject) : AiSessionMessage[] => {
		const arr = extractArray(data, 'messages')
		const out : AiSessionMessage[] = []
		for (let i = 0; i < arr.length; i++) {
			out.push(buildSessionMessage(arr[i]))
		}
		return out
	})
}

// ===== 智能维修诊断：引导只读面（v2 契约，#2296）=====
//
// 背景：v1 的四个只读端点（brands / models / fault-codes / manual）已随 #2237 硬删，
// 本段是**按 v2 契约重新接上**的那一面（五个 GET 在 #2273 落地，移动端消费归 #2296）。
//
// 三条出站口径（照做，不是自由发挥）：
//   ① **集合恒非空数组** —— 后端已把 `brands` / `faq` / `items` 归一成 `[]`，
//      这里再兜一次：拿不到数组就返回空数组，绝不让调用方去判 null。
//   ② `health` **永远 200**，`ok=false` 表示「上游未配置 / 不可达」—— 那是**业务状态不是错误**，
//      故不抛异常；调用方据此整块留白（不留「点得动、点了就 502」的死入口）。
//   ③ 错误映射在后端：429 透传、其余一律 502 固定文案 ⇒ 这里只把 `message` 交上去，
//      客户端**不拼状态码、不猜上游原文**（ADR-0064 决策 9）。

/** 解析引导品牌（`picker` 缺失/空串一律归一成空串，判档交给 `pickerKindOf`） */
function buildIntentBrand(obj : UTSJSONObject) : DiagnosisIntentBrand {
	return {
		id: toStr(obj['id']),
		name: toStr(obj['name']),
		tagline: toStr(obj['tagline']),
		icon: toStr(obj['icon']),
		cls: toStr(obj['cls']),
		picker: toStr(obj['picker']),
	} as DiagnosisIntentBrand
}

/** 解析目录条目（`systems` / `faults` 的 items） */
function buildCatalogItem(obj : UTSJSONObject) : DiagnosisCatalogItem {
	return {
		id: toStr(obj['id']),
		name: toStr(obj['name']),
		icon: toStr(obj['icon']),
	} as DiagnosisCatalogItem
}

/** 从响应里取数组（缺失即空数组；**不抛**——空集合是合法业务态） */
function asObjectArray(raw : any | null) : Array<UTSJSONObject> {
	if (raw == null) return [] as Array<UTSJSONObject>
	try {
		return raw as Array<UTSJSONObject>
	} catch (_e) {
		return [] as Array<UTSJSONObject>
	}
}

/** 上游健康（`{ok, app_configured}`；永远 200，故失败只可能在传输层） */
export function getDiagnosisHealthApi() : Promise<DiagnosisHealth> {
	return getMapped<DiagnosisHealth>('/ai-assistant/diagnosis/health', null, (data : UTSJSONObject) : DiagnosisHealth => {
		const h : DiagnosisHealth = {
			ok: toBool(data['ok'], false),
			app_configured: toBool(data['app_configured'], false),
		}
		return h
	})
}

/** 品牌与常见问题（`{brands, faq}`，两个集合恒非 null） */
export function getDiagnosisIntentsApi() : Promise<DiagnosisIntents> {
	return getMapped<DiagnosisIntents>('/ai-assistant/diagnosis/intents', null, (data : UTSJSONObject) : DiagnosisIntents => {
		const rawBrands = asObjectArray(data['brands'])
		const brands : DiagnosisIntentBrand[] = []
		for (let i = 0; i < rawBrands.length; i++) {
			const b = buildIntentBrand(rawBrands[i])
			// 没有 id 或没有名字的品牌卡对用户无意义，且点下去也调不动 systems（brand 必填）
			if (b.id.length == 0 || b.name.length == 0) continue
			brands.push(b)
		}
		const rawFaq = asObjectArray(data['faq'])
		const faq : DiagnosisFaq[] = []
		for (let i = 0; i < rawFaq.length; i++) {
			const q = toStr(rawFaq[i]['q'])
			if (q.length == 0) continue
			const f : DiagnosisFaq = { q: q, a: toStr(rawFaq[i]['a']) }
			faq.push(f)
		}
		const out : DiagnosisIntents = { brands: brands, faq: faq }
		return out
	})
}

/**
 * 第二层：系统 / 型号列表（`brand` 必填，缺了后端回 400）。
 *
 * **两档都用这一个端点**（#2310）：中力 14 个系统（带 icon），林德 87 个型号（无 icon）。
 * `faults?brand=`（不带 second）是「品牌根层」，不是型号列表 —— 林德只有 3 条故障项；
 * Web 侧 `DiagnosisGuide.vue` 也是不分档统一调 systems。
 */
export function getDiagnosisSystemsApi(brand : string) : Promise<DiagnosisCatalogItem[]> {
	const params : UTSJSONObject = { brand: brand }
	return getMapped<DiagnosisCatalogItem[]>('/ai-assistant/diagnosis/systems', params, (data : UTSJSONObject) : DiagnosisCatalogItem[] => {
		const raw = asObjectArray(data['items'])
		const out : DiagnosisCatalogItem[] = []
		for (let i = 0; i < raw.length; i++) {
			const it = buildCatalogItem(raw[i])
			if (it.id.length == 0 && it.name.length == 0) continue
			out.push(it)
		}
		return out
	})
}

/**
 * 第三层：现象 / 主题。`second` 传**第二层选中项的 id**（不是 name，传名字会静默回落根层）。
 *
 * 同一个端点两种取法：`second` 为空 = 品牌根层（中力 6 条诉求 / 林德 3 条故障项），
 * 非空 = 该 (品牌, 系统|型号) 下的现象词表 / 林德的检测主题。
 * **品牌根层只用于「品牌根层诉求卡」这一处，不再被当成型号列表**（#2310）。
 */
export function getDiagnosisFaultsApi(brand : string, second : string) : Promise<DiagnosisCatalogItem[]> {
	const params : UTSJSONObject = { brand: brand }
	if (second.length > 0) {
		params['second'] = second
	}
	return getMapped<DiagnosisCatalogItem[]>('/ai-assistant/diagnosis/faults', params, (data : UTSJSONObject) : DiagnosisCatalogItem[] => {
		const raw = asObjectArray(data['items'])
		const out : DiagnosisCatalogItem[] = []
		for (let i = 0; i < raw.length; i++) {
			const it = buildCatalogItem(raw[i])
			if (it.id.length == 0 && it.name.length == 0) continue
			out.push(it)
		}
		return out
	})
}

/** 故障码体检的 wire 形状 → 类型（`samples` 归一成数组：上游对非 format 态给 null/缺字段） */
function buildCodeHint(data : UTSJSONObject) : DiagnosisCodeHint {
	const samples : string[] = []
	const raw = data['samples']
	if (raw != null) {
		const arr = raw as Array<string>
		for (let i = 0; i < arr.length; i++) {
			const s = `${arr[i]}`
			if (s.length > 0) samples.push(s)
		}
	}
	const hint : DiagnosisCodeHint = {
		status: toStr(data['status']),
		message: toStr(data['message']),
		fix: toStr(data['fix']),
		samples: samples,
	}
	return hint
}

/**
 * 故障码实时体检（#2297）：`q` = 输入框当前内容（空 = 还没输入，上游回 `status=none`）。
 *
 * 不打缓存、不复用（后端也不加 Cache-Control）：跟着输入框逐字符变。
 * **失败原样上抛**（ADR-0037 ③）——「静默」是呈现层的事（`useDiagnosisCodeHint` 把失败折成
 * 「这一行不出现」），不是把 errmsg 吞成「没有这个故障码」。
 */
export function checkDiagnosisCodeApi(q : string) : Promise<DiagnosisCodeHint> {
	const params : UTSJSONObject = { q: q }
	return getMapped<DiagnosisCodeHint>('/ai-assistant/diagnosis/code-hint', params, (data : UTSJSONObject) : DiagnosisCodeHint => {
		return buildCodeHint(data)
	})
}

/**
 * 解析 SSE 文本，拼接所有 delta 内容
 * 兼容：
 *   event: delta\ndata: {"content":"x"}\n\n
 *   data: {"delta":"x"}\n\n
 *   data: {"choices":[{"delta":{"content":"x"}}]}\n\n
 */
/** 从 SSE data JSON 中提取增量文本；返回空串表示本行无内容 */
function extractDeltaText(obj : UTSJSONObject) : string {
	const c1 = obj['content']
	if (c1 != null) return toStr(c1)
	const d1 = obj['delta']
	if (d1 != null) {
		// delta 可能是字符串或对象
		const asStr = toStr(d1)
		// 若 toStr 得到 [object Object] 之类则再取 content
		if (asStr.length > 0 && !asStr.startsWith('{') && asStr.indexOf('[object') < 0) {
			// 纯文本 delta
			// 但对象 toStr 通常是 JSON 或 [object]，这里优先尝试对象字段
		}
		try {
			const dObj = d1 as UTSJSONObject
			const dc = dObj['content']
			if (dc != null) return toStr(dc)
		} catch (_e) { }
		if (asStr.length > 0 && asStr.indexOf('[object') < 0 && !asStr.startsWith('{')) {
			return asStr
		}
	}
	const t1 = obj['text']
	if (t1 != null) return toStr(t1)
	const choices = obj['choices']
	if (choices != null) {
		try {
			const arr = choices as Array<UTSJSONObject>
			if (arr.length > 0) {
				const ch0 = arr[0]
				const delta = ch0['delta']
				if (delta != null) {
					const deltaObj = delta as UTSJSONObject
					return toStr(deltaObj['content'])
				}
				const message = ch0['message']
				if (message != null) {
					const mObj = message as UTSJSONObject
					return toStr(mObj['content'])
				}
			}
		} catch (_e) { }
	}
	return ''
}

// ─── 回调式流式对话（兼容后端 message/sources/error/done 事件） ───────────────

/** 流式对话回调 */
export type StreamChatCallbacks = {
	onMessage ?: (chunk : string) => void
	// 诊断来源（#988）：后端仅在 RAG 命中 answer_sources 时发该事件 ⇒ 不是每轮都有，
	// 且**不是**「诊断通道生效」的必要条件（见 #999 收尾评论的更正）。
	onSources ?: (sources : AiDiagnosisSource[]) => void
	onError ?: (msg : string) => void
	/**
	 * 终帧载荷（#2310）：`done` 的 data 可能是 `null`（非诊断功能），故参数可空。
	 * `content` 是终端权威全文，出现时客户端须整体替换已累积的增量正文
	 * （判据 `fullContent != streamed.String()`，见 backend/internal/aiassistant/handler.go）。
	 */
	onDone ?: (data : UTSJSONObject | null) => void
}

/**
 * 三类失败的**可行动**文案（#2298 验收第 3 条）。
 *
 * 判据不是「有错就行」，而是「学员读完知道下一步做什么」：
 * 超时 ⇒ 稍后重试；网络失败 ⇒ 检查网络后重试；服务不可用 ⇒ 稍后重试（不要反复点）。
 * 因此**不把平台原始 `errMsg` 当文案透出**（旧实现里 `request:fail` 这类英文串会直接上屏）。
 */
const STREAM_MSG_TIMEOUT = '回答超时了，请稍后重试'
const STREAM_MSG_NETWORK = '网络连接失败，请检查网络后重试'
const STREAM_MSG_SERVICE_DOWN = '服务暂不可用，请稍后重试'
/** 200 但流里没有 `done` / `error`（应答被截断）：请求已结束、内容却未收口，必须显式收尾 */
const STREAM_MSG_INCOMPLETE = '回答未完整返回，请重试'

/** 触发 onError（若存在） */
function emitStreamError(callbacks : StreamChatCallbacks, msg : string) : void {
	console.error('[streamChat] error:', msg)
	if (callbacks.onError != null) {
		callbacks.onError(msg)
	}
}

/**
 * 简单解析 SSE 文本（兼容后端 message / sources / error / done 事件）
 *
 * @returns 是否见到**终止帧**（`done` 或 `error`）。`uni.request` 是整包回调，
 *          200 也可能只收到半截流（连接中途断、body 为空）—— 那种情况既没有 done 也没有
 *          error，调用方必须自己收尾，否则等待态会一直转（#2298 验收第 5 条）。
 */
function parseStreamSSE(text : string, callbacks : StreamChatCallbacks) : boolean {
	const lines = text.split('\n')
	let event = ''
	let data = ''
	let terminated = false
	for (let i = 0; i < lines.length; i++) {
		const line = lines[i].trim()
		if (line.startsWith('event:')) {
			event = line.substring(6).trim()
		} else if (line.startsWith('data:')) {
			data = line.substring(5).trim()
		} else if (line.length == 0) {
			if (event.length > 0) {
				if (handleStreamSSEEvent(event, data, callbacks)) {
					terminated = true
				}
			}
			event = ''
			data = ''
		}
	}
	if (event.length > 0) {
		if (handleStreamSSEEvent(event, data, callbacks)) {
			terminated = true
		}
	}
	return terminated
}

/** @returns 该事件是否是终止帧（`done` / `error`） */
function handleStreamSSEEvent(event : string, data : string, callbacks : StreamChatCallbacks) : boolean {
	if (event == 'message') {
		try {
			const obj = JSON.parse(data) as UTSJSONObject
			const chunk = obj['content'] as string
			if (chunk != null && chunk.length > 0 && callbacks.onMessage != null) {
				callbacks.onMessage(chunk)
			}
		} catch (e) {
			console.error('[streamChat] parse message error:', e)
		}
	} else if (event == 'sources') {
		// 诊断来源资料（#988；根仓库 ADR-0032/0033）：此前该事件被静默丢弃 ⇒ 回答里的出处看不见。
		try {
			const obj = JSON.parse(data) as UTSJSONObject
			const raw = obj['sources']
			if (raw != null && callbacks.onSources != null) {
				callbacks.onSources(parseDiagnosisSources(raw as Array<UTSJSONObject>))
			}
		} catch (e) {
			console.error('[streamChat] parse sources error:', e)
		}
	} else if (event == 'error') {
		let msg = '对话出错'
		try {
			const obj = JSON.parse(data) as UTSJSONObject
			const m = obj['message']
			if (m != null) {
				msg = m as string
			}
		} catch (e) {}
		emitStreamError(callbacks, msg)
		return true
	} else if (event == 'done') {
		// done 的 data 恒可空：非诊断功能后端直接发 `null`（#2308 §二.3）；
		// 解析失败或不是对象时按「没有载荷」处理，不能把一个坏帧当权威全文。
		let payload : UTSJSONObject | null = null
		if (data.length > 0 && data != 'null') {
			try {
				const obj = JSON.parse(data) as UTSJSONObject
				if (obj != null) {
					payload = obj
				}
			} catch (e) {
				console.error('[streamChat] parse done error:', e)
			}
		}
		if (callbacks.onDone != null) {
			callbacks.onDone(payload)
		}
		return true
	}
	return false
}

/**
 * 流式对话（SSE，回调式）
 * @param params 请求体（UTSJSONObject）
 * @returns 请求对象（支持 abort 时返回之，否则返回 null）
 * @note 401 与普通请求同规则（ADR-0017 / #1704）：先续期、成功则带新 token 重发一次，真失败才走统一登出出口
 */
export function streamChatApi(params : UTSJSONObject, callbacks : StreamChatCallbacks) : any | null {
	return sendStream(params, callbacks, false)
}

/**
 * 发出一次流式请求（401 续期成功后递归重发**一次**）
 *
 * 本模块**不复制** 401 规则：续期与终态全在 `api/request.uts` 的 `renewOrExpire()`
 * （三条 401 出口的单点）。为什么必须走它 —— #1704 收口前这里是「看见 401 就 onError」，
 * 既不刷新也不跳登录页：access 恰好过期时对话报「登录已过期」而页面还停在原地，
 * 与其它接口的登出行为不一致（同一秒内两个接口一个跳走、一个弹错）。
 *
 * @param isRetry 是否已是续期后的重发（true ⇒ 再 401 就是真失效）
 * @note 只有**首次**尝试的 task 会返回给调用方；重发的 task 不返回（本仓无人 abort，
 *       日后若要支持 abort，需把它交回一个可更新的持有者）
 */
function sendStream(params : UTSJSONObject, callbacks : StreamChatCallbacks, isRetry : boolean) : any | null {
	const token = getStorage(STORAGE_KEY_TOKEN)
	const url = API_BASE_URL + '/ai-assistant/chat'

	const header : UTSJSONObject = {
		'Content-Type': 'application/json',
		'Accept': 'text/event-stream',
	}
	if (token.length > 0) {
		header['Authorization'] = `Bearer ${token}`
	}

	const task = uni.request({
		url: url,
		method: 'POST',
		data: params,
		header: header,
		timeout: AI_REQUEST_TIMEOUT,
		success: (res) => {
			const statusCode = res.statusCode
			if (statusCode == 401) {
				// silent=true：文案由 onError 交回对话流，不再叠一层 toast（真失效时页面随即被 reLaunch）
				renewOrExpire(token, !isRetry, true).then((retried : boolean) => {
					if (retried) {
						sendStream(params, callbacks, true)
					} else {
						emitStreamError(callbacks, AUTH_EXPIRED_MESSAGE)
					}
				})
				return
			}
			if (statusCode < 200 || statusCode >= 300) {
				// 服务不可用（5xx）有专门的行动文案；4xx 保留状态码，便于客服定位是哪个入口打错
				let msg = statusCode >= 500 ? STREAM_MSG_SERVICE_DOWN : `请求失败 (${statusCode})`
				try {
					const bodyObj = res.data as UTSJSONObject
					const bm = bodyObj['message']
					if (bm != null && `${bm}`.length > 0) msg = `${bm}`
				} catch (e) {}
				emitStreamError(callbacks, msg)
				return
			}
			let raw = ''
			try {
				const asObj = res.data as UTSJSONObject
				if (asObj != null && (asObj['content'] != null || asObj['message'] != null ||
						asObj['choices'] != null || asObj['data'] != null)) {
					raw = JSON.stringify(res.data)
				} else {
					raw = `${res.data}`
				}
			} catch (e) {
				raw = `${res.data}`
			}
			if (raw.length == 0) {
				raw = `${res.data}`
			}
			// 200 不等于「答完了」：整包解析后必须见到 done / error 才算收口。
			// 截断（无终止帧）时显式收尾，否则等待态一直转 —— 这正是 #2298 验收第 5 条要挡的残留态。
			const terminated = parseStreamSSE(raw, callbacks)
			if (!terminated) {
				emitStreamError(callbacks, STREAM_MSG_INCOMPLETE)
			}
		},
		fail: (err) => {
			// 平台原始 errMsg（`request:fail ...`）只进日志，不上屏：它不是可行动文案（#2298 验收第 3 条）
			console.error('[streamChat] fail:', err.errMsg)
			const errMsg = err.errMsg ?? ''
			const msg = errMsg.indexOf('timeout') >= 0 ? STREAM_MSG_TIMEOUT : STREAM_MSG_NETWORK
			emitStreamError(callbacks, msg)
		},
	})
	if (task != null) {
		return task
	}
	return null
}