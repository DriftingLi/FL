/**
 * 积分模块 API（#709：路由全部对齐后端 points.go 已注册清单，mock 静默回退全部退役）
 *
 * - GET  /points/balance              余额（balance / total_earned / total_spent）
 * - GET  /points/ledger               流水分页（page / page_size / direction=in|out，#512）
 * - GET  /points/tasks                任务中心（todo / claimable / claimed 三态）
 * - POST /points/tasks/{code}/claim   领取任务积分
 * - GET  /points/shop/items           商城在售列表（#2064 后端 / #1942 页面；owned 与兑换同源）
 * - POST /points/shop/{sku}/redeem    商城兑换（AI 专业版走这条；#920）
 * - POST /points/shop/course/{id}/redeem  课程兑换（#1421 / 移动端 ADR-0031）
 *
 * 后端从未注册过的路由不在本文件出现：/points/records 与 /points/course-view 是 #662
 * 实测 404 的幻影路由。旧版靠 api 层 .catch() 回落占位数据把 404 静默盖住（用户永远看到
 * 三条假流水），本票后失败一律沿 Promise 上抛——request 层已统一 toast，页面再呈现
 * 可见错误态与重试入口（同 #408/#409「占位数据不是后端异常的正确呈现」口径）。
 */
import { getMapped, postMapped } from './request'
import type { RequestOptions } from './request'
import { getPaged } from './envelope'
import type { Page } from './envelope'
import { toNumber, toNumberOrNull, toStr, toBool } from './helpers'
import type { PointsBalance, PointsLedgerItem, PointsTaskItem, PointsTasksResult, PointsClaimResult, PointsRedeemResult, ShopItem, ShopItemsResult } from '../types/index'

/** 从 UTSJSONObject 构造 PointsBalance（后端三字段直读，无历史别名回退） */
function buildPointsBalance(obj : UTSJSONObject) : PointsBalance {
	return {
		balance: toNumber(obj['balance']),
		total_earned: toNumber(obj['total_earned']),
		total_spent: toNumber(obj['total_spent']),
	} as PointsBalance
}

/** 从 UTSJSONObject 构造 PointsLedgerItem（expires_at 为 #509 设计位，首版后端恒 null） */
function buildPointsLedgerItem(obj : UTSJSONObject) : PointsLedgerItem {
	const expiresRaw = obj['expires_at']
	return {
		id: toNumber(obj['id']),
		delta: toNumber(obj['delta']),
		reason: toStr(obj['reason']),
		ref_type: toStr(obj['ref_type']),
		ref_id: toStr(obj['ref_id']),
		created_at: toStr(obj['created_at']),
		expires_at: expiresRaw != null ? toStr(expiresRaw) : null,
	} as PointsLedgerItem
}

/** 从 UTSJSONObject 构造 PointsTaskItem */
function buildPointsTaskItem(obj : UTSJSONObject) : PointsTaskItem {
	return {
		code: toStr(obj['code']),
		group: toStr(obj['group']),
		title: toStr(obj['title']),
		desc: toStr(obj['desc']),
		points: toNumber(obj['points']),
		status: toStr(obj['status']),
		progress: toNumber(obj['progress']),
		total: toNumber(obj['total']),
	} as PointsTaskItem
}

/** 从 UTSJSONObject 构造 PointsTasksResult */
function buildPointsTasksResult(obj : UTSJSONObject) : PointsTasksResult {
	const tasks : PointsTaskItem[] = []
	const raw = obj['tasks']
	if (raw != null) {
		const arr = raw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			tasks.push(buildPointsTaskItem(arr[i]))
		}
	}
	return { tasks: tasks } as PointsTasksResult
}

/** 从 UTSJSONObject 构造 PointsClaimResult */
function buildPointsClaimResult(obj : UTSJSONObject) : PointsClaimResult {
	return {
		balance: toNumber(obj['balance']),
		total_earned: toNumber(obj['total_earned']),
		task_status: toStr(obj['task_status']),
	} as PointsClaimResult
}

/** 从 UTSJSONObject 构造 ShopItem（stock 走 toNumberOrNull：null = 不限库存，不能当 0 售罄） */
function buildShopItem(obj : UTSJSONObject) : ShopItem {
	return {
		sku: toStr(obj['sku']),
		title: toStr(obj['title']),
		price: toNumber(obj['price']),
		stock: toNumberOrNull(obj['stock']),
		owned: toBool(obj['owned']),
	} as ShopItem
}

/** 从 UTSJSONObject 构造 ShopItemsResult（items 缺省时按空数组，与后端 nonnil 口径一致） */
function buildShopItemsResult(obj : UTSJSONObject) : ShopItemsResult {
	const out : ShopItem[] = []
	const raw = obj['items']
	if (raw != null) {
		const arr = raw as Array<UTSJSONObject>
		for (let i = 0; i < arr.length; i++) {
			out.push(buildShopItem(arr[i]))
		}
	}
	return { items: out } as ShopItemsResult
}

/** 从 UTSJSONObject 构造 PointsRedeemResult（后端 service.RedeemResult 四字段直读） */
function buildPointsRedeemResult(obj : UTSJSONObject) : PointsRedeemResult {
	return {
		balance: toNumber(obj['balance']),
		total_earned: toNumber(obj['total_earned']),
		sku: toStr(obj['sku']),
		ref_id: toStr(obj['ref_id']),
	} as PointsRedeemResult
}

/**
 * 获取积分余额
 * 失败时 reject（request 层已提示），由调用方呈现错误态。
 * @param silent 静默模式（默认 false）：装饰性预读（如课程详情 CTA 的余额提示）传 true ——
 *   读失败只上抛、不弹全局错误 toast（ADR-0031 决策 3「读不到不得报错挡道」：一行预判提示
 *   不该为浏览课程的用户制造一次他没触发的报错）。权威判定仍在服务端兑换管线，与此无关。
 */
export function getPointsBalanceApi(silent : boolean = false) : Promise<PointsBalance> {
	const opts : RequestOptions = { url: '/points/balance', silent: silent } as RequestOptions
	return getMapped<PointsBalance>('/points/balance', null, (data : UTSJSONObject) : PointsBalance => buildPointsBalance(data), opts)
}

/**
 * 获取积分流水（GET /points/ledger）
 * @param page 页码，从 1 起
 * @param pageSize 每页条数
 * @param direction 收支方向：'' 全部 / 'in' 收入 / 'out' 支出（#512）
 *        后端无「来源」维度筛选，故本参数不接受 source_type 之类幻影条件（#709 待后端清单）
 *
 * PR-F #1666：装载走信封归一出口 `getPaged`（ADR-0037）——数组键 `items`（后端字段名，非 records），
 * 分页字段只认 total；旧 DTO 的 page / pages 两字段随之消亡（消费方按 hasMore 判终止）。
 */
export function getPointsLedgerApi(page : number, pageSize : number, direction : string) : Promise<Page<PointsLedgerItem>> {
	const query : UTSJSONObject = {} as UTSJSONObject
	if (direction != '') {
		query['direction'] = direction
	}
	return getPaged<PointsLedgerItem>('/points/ledger', page, pageSize, (obj : UTSJSONObject) : PointsLedgerItem => buildPointsLedgerItem(obj), query, ['items'])
}

/**
 * 获取积分任务列表（GET /points/tasks，三态由后端按真实行为实时算）
 */
export function getPointsTasksApi() : Promise<PointsTasksResult> {
	return getMapped<PointsTasksResult>('/points/tasks', null, (data : UTSJSONObject) : PointsTasksResult => buildPointsTasksResult(data))
}

/**
 * 领取任务积分（POST /points/tasks/{code}/claim，后端防双领 + 幂等）
 * @param code 任务编码
 */
export function claimPointsTaskApi(code : string) : Promise<PointsClaimResult> {
	const url = '/points/tasks/' + encodeURIComponent(code) + '/claim'
	return postMapped<PointsClaimResult>(url, null, (data : UTSJSONObject) : PointsClaimResult => buildPointsClaimResult(data))
}

/**
 * 商城在售列表（GET /points/shop/items，#2064 后端 / #1942 页面）。
 *
 * 只回 enabled **且在 sku 对账表里登记了权益读者**的行：列表里看得见的项一定能兑，
 * 不会出现「点得动、兑换时报不可兑换」。owned 由服务端按人算（HasEntitlement），
 * 客户端不得用本地状态推断已拥有。空列表是合法结果（返回 []，不是错误）。
 */
export function getShopItemsApi() : Promise<ShopItemsResult> {
	return getMapped<ShopItemsResult>('/points/shop/items', null, (data : UTSJSONObject) : ShopItemsResult => buildShopItemsResult(data))
}

/**
 * 商城兑换（POST /points/shop/{sku}/redeem）——后端兑换单管线唯一入口（#920 复用，不新造机制）。
 *
 * 管线的守卫全在服务端：锁 + 已拥有校验（重复兑换 → 400「已兑换」）+ 余额预检
 * （余额不足 → 400「积分不足」）+ 商品在售校验（下架/不存在 → 400「商品不存在或已下架」）
 * + 幂等键 redeem:{sku}。**客户端不得本地预扣余额或本地写「已解锁」**，
 * 一律以本调用成功为事实（同 #609/#610 的「服务端是事实源」口径）。
 *
 * @param sku 商品 SKU（AI 专业版 = 'ai_pro'）
 */
export function redeemShopItemApi(sku : string) : Promise<PointsRedeemResult> {
	const url = '/points/shop/' + encodeURIComponent(sku) + '/redeem'
	return postMapped<PointsRedeemResult>(url, null, (data : UTSJSONObject) : PointsRedeemResult => buildPointsRedeemResult(data))
}

/**
 * 课程兑换（POST /points/shop/course/{courseId}/redeem，后端 points.go 已注册；
 * 移动端 ADR-0031 决策 1/2 · #1421 接线）。
 *
 * 与 redeemShopItemApi 共用**同一条兑换管线与响应形状**（PointsRedeemResult 四字段）——
 * 守卫全在服务端：锁 + 已拥有校验 + 余额预检 + 课程可兑换校验 + 幂等键（含主体，
 * 「每人每课终身一次」）。业务失败（积分不足 / 已兑换 / 课程不存在）由 `pointsErrStatus`
 * 哨兵映射 HTTP 状态，本动词**原样 reject 后端文案**：客户端不做字符串比对、不本地预扣、
 * 不写「已解锁」—— 扣不扣由服务端裁定，成功后的事实以重拉详情的 entitled 投影为准（决策 4）。
 *
 * @param courseId 课程 ID
 */
export function redeemCoursePointsApi(courseId : number) : Promise<PointsRedeemResult> {
	const url = '/points/shop/course/' + encodeURIComponent(courseId.toString()) + '/redeem'
	return postMapped<PointsRedeemResult>(url, null, (data : UTSJSONObject) : PointsRedeemResult => buildPointsRedeemResult(data))
}
