/**
 * HTTP 请求封装
 * 基于 uni.request，跨 4 端通用
 * - 自动注入 Authorization
 * - 统一解包 ApiResponse<T>（HTTP 状态码 + 业务 code 双重校验）
 * - 401 自动用 refresh_token 刷新并重试一次；**并发 401 共享同一次刷新**
 *   （api/refreshGate.uts 单飞），只有刷新**真的**失败才清空登录态并跳转登录页
 * - X-Silent: 1 头关闭错误 toast
 * - 调试日志仅开发环境输出（ENABLE_DEBUG_LOG），不打印请求头（避免泄漏 token）；
 *   请求体经 `sanitizeForLog` 打码敏感键（password / refresh_token / token / code / api_key / captcha_value）后再入日志（#1398）
 */

import { REQUEST_TIMEOUT, ENABLE_DEBUG_LOG } from '../config/env'
import { STORAGE_KEY_TOKEN, STORAGE_KEY_USER } from '../constants/app'
import { getStorage, removeStorage } from '../utils/storage'
import { isContentUri, buildTempFilePath, UPLOAD_TMP_DIR } from '../utils/uploadPath'
import { isRecruiterActive } from '../utils/authRole'
import { gateRefresh } from './refreshGate'
import {
    HEADER_AUTHORIZATION,
    BEARER_PREFIX,
    buildHeader,
    buildUploadHeader,
    resolveURL,
    showError,
    sanitizeForLog,
    handleStatus,
    networkError,
    withQuery,
    FORBIDDEN_MESSAGE_PREFIX as TRANSPORT_FORBIDDEN_PREFIX,
    NOT_FOUND_MESSAGE_PREFIX as TRANSPORT_NOT_FOUND_PREFIX,
} from './transport'

// 注意：不能在此处 import useAuthStore（会导致循环依赖），改用全局回调

/** 请求方法 */
export type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH'

/**
 * 403 / 404 的**可识别消息前缀**由传输层（`api/transport.uts`）定义，本文件只做**再导出**——
 * 消费方（`api/recruit.uts` 的 `isContactForbidden()`、`api/resume.uts` 的 `isResumeNotFound()`）
 * 继续 `import { … } from './request'`，不必知道它沉到了哪一层。
 *
 * 为什么只再导出、不重新定义字面量：前缀与 `handleStatus` 的写入端必须**同源**，
 * 两处各写一份 `'403:'` 就回到了 #1734 拆之前「单点真源被复制」的老问题。
 */
export const FORBIDDEN_MESSAGE_PREFIX = TRANSPORT_FORBIDDEN_PREFIX
export const NOT_FOUND_MESSAGE_PREFIX = TRANSPORT_NOT_FOUND_PREFIX

/**
 * **401 终态文案** —— 单点真源，不许在别处另写字面量。
 *
 * 三条 401 出口（普通请求 / `uploadFile` / SSE 流）最终都落到 `expireSession()`，提示与
 * reject 的错误消息都由这一个常量给出。分头写字的后果不是「有三句同义话」这么轻：跳转是一致的、
 * 用户看到的句子却不同（#1704 收口前 `streamChatApi` 自带一份，且它既不跳转也不刷新）。
 *
 * 消费方：本文件的 `expireSession()`，以及 `api/aiAssistant.uts` 的 `sendStream()`
 * （SSE 侧把同一句话经 `onError` 交回对话流）。
 */
export const AUTH_EXPIRED_MESSAGE = '登录已过期，请重新登录'


/** 请求配置 */
export type RequestOptions = {
    url : string
    method ?: HttpMethod
    data ?: any | null
    header ?: UTSJSONObject | null
    /** 请求超时，默认使用 REQUEST_TIMEOUT */
    timeout ?: number
    /** 是否静默（不弹错误 toast），默认 false */
    silent ?: boolean
}

/**
 * 取出本次请求**实际发出**的 access token（'' = 未带凭据）
 * 用途：401 刷新去重按「触发这次 401 的那个 token」认人 —— 同一次风暴的迟到成员
 * 带的仍是那个**已被替换掉**的旧 token（#1124 真机日志里它们的 401 相隔可近 1 秒），
 * 若改用「当前 storage 里的 token」或时间盒判定，都会把迟到成员误当成新一次刷新。
 */
function sentTokenOf(reqHeader : UTSJSONObject) : string {
    const raw = reqHeader[HEADER_AUTHORIZATION]
    if (raw == null) return ''
    const s = raw as string
    if (!s.startsWith(BEARER_PREFIX)) return ''
    return s.substring(BEARER_PREFIX.length)
}

/** 防重入标记：避免多个并发 401 触发多次跳转 */
let isHandlingUnauthorized = false

/**
 * 401 终态该把用户送到哪个登录页 —— **按当前身份角色定向**（ADR-0022 ⑤）
 *
 * 招聘者与学员共用 `auth_token` 槽、却是两个独立的登录页：token 失效后必须回到
 * **签发它的那一个**，否则会出现「拿招聘 token 去学员登录页」这种身份错配
 * （招聘者工作区页面的 onLoad 守卫也会因此反复弹回）。
 *
 * 判定读 `utils/authRole.uts`（`auth_active_role`，缺省 = 学员）。
 * 只改这**一个**出口内的目标，不新增 reLaunch 出口 —— `C2` 锁着「跳转只有一个出口」。
 */
function loginPathForActiveRole() : string {
    if (isRecruiterActive()) return '/pages/recruiter/login'
    return '/pages/login/login'
}

/**
 * 清空登录态并跳转登录页
 *
 * ⚠️ 本函数是**全仓唯一**的 reLaunch 出口（`utils/concurrent401RefreshContract.test.js` 的 C2）。
 * 角色差异只能在本函数**内部**分支，不得在别处另开一个 reLaunch。
 */
function handleUnauthorized() {
    // 防重入：并发请求同时 401 时只跳一次
    if (isHandlingUnauthorized) return
    isHandlingUnauthorized = true

    removeStorage(STORAGE_KEY_TOKEN)
    removeStorage(STORAGE_KEY_USER)
    // 证件域三键经回调交回 auth store 清（#1404）：此处抄一份键清单就是第三个「两处各写一份」
    // 的抄写点（单点原则见 ADR-0022 ⑤ 补充约束 / stores/auth.uts 的 clearCredentialStorage）
    if (_unauthorizedCredentialCleanupHandler != null) _unauthorizedCredentialCleanupHandler!()
    // 按角色选目标：招聘者态 → 招聘者登录页；学员态 → 学员登录页（行为不变）
    const target = loginPathForActiveRole()
    // 避免已经在**目标**登录页时还跳一次（`getCurrentPages()` 的 route 不带前导 `/`）
    const targetRoute = target.substring(1)
    const pages = getCurrentPages()
    if (pages.length > 0) {
        const current = pages[pages.length - 1]
        const route = current.route
        if (route != targetRoute) {
            uni.reLaunch({ url: target })
        }
    }

    // 延迟重置标记：等 reLaunch 生效后允许后续 401 再次触发（如用户重新登录后再次过期）
    setTimeout(() => {
        isHandlingUnauthorized = false
    }, 2000)
}

/**
 * 401 终态单点：清登录态 → 跳登录页 → 提示，并返回可 reject 的错误对象
 *
 * ⚠️ 本函数是全仓唯一调用 `handleUnauthorized` 的地方（`utils/concurrent401RefreshContract.test.js` C2），
 * 因此也是全仓唯一「登出 + 跳转」的语义点。三条 401 出口（普通请求 / `uploadFile` / SSE 流）
 * 都经由它，不许别处另写一份 `removeStorage` + `reLaunch`（#1704）。
 */
function expireSession(silent : boolean) : Error {
    handleUnauthorized()
    showError(AUTH_EXPIRED_MESSAGE, silent)
    return new Error(AUTH_EXPIRED_MESSAGE)
}

/** 401 终态：清空登录态并 reject（无法恢复或重试仍 401 时走这里） */
function logoutAndReject(silent : boolean, reject : (e : Error) => void) {
    reject(expireSession(silent))
}

/** 全局 token 刷新回调（由 auth store 注册，避免循环依赖） */
let _refreshTokenHandler : (() => Promise<boolean>) | null = null

/** 注册 token 刷新回调（auth store 初始化时调用） */
export function registerRefreshTokenHandler(handler : () => Promise<boolean>) : void {
    _refreshTokenHandler = handler
}

/**
 * 401 顶出时的证件域清理回调（#1404，与 `registerRefreshTokenHandler` 同款通道）
 *
 * 为什么走回调而不是在 401 出口内直接清：键清单的单点在 `stores/auth.uts`
 * 的 `clearCredentialStorage()`（#1380 / ADR-0022 ⑤ 补充约束），而 `request.uts` 不能
 * import auth store（循环依赖，见文件头）⇒ 在此抄第三份清单等于把单点原则破掉一半。
 * 注册方在未注册时（如未走登录域的裸调用）回调为 null ⇒ 跳过，与刷新回调同一容错形态。
 */
let _unauthorizedCredentialCleanupHandler : (() => void) | null = null

/** 注册 401 顶出的证件域清理回调（auth store 初始化时调用） */
export function registerUnauthorizedCredentialCleanup(handler : () => void) : void {
    _unauthorizedCredentialCleanupHandler = handler
}

/**
 * 尝试用 refresh_token 自动刷新 access token
 * @param forToken 触发这次刷新的请求发出去时带的 access token
 * @returns true=刷新成功，false=刷新**真的**失败（无刷新回调 / 刷新被拒 / 抛错）
 * @note 并发 401 **共享同一次在飞刷新**（api/refreshGate.uts）：
 *       「另一次刷新正在进行」不再被折成 false（#1124 根因 1）
 */
function tryAutoRefresh(forToken : string) : Promise<boolean> {
    if (_refreshTokenHandler == null) return Promise.resolve(false)
    return gateRefresh(_refreshTokenHandler!, forToken)
}

/**
 * 401 续期决策 —— 三条 401 出口（普通请求 / `uploadFile` / SSE 流）共用**同一份**规则
 *
 * 规则只有两种合法终态（ADR-0017）：刷新成功 ⇒ 带新 token **重发一次**；刷新**真的**失败 ⇒ 登出。
 * 把这条规则写三遍就是三处漂移面：#1124 只修了普通请求，#1704 收口前上传与 SSE 各留了一份
 * 「看见 401 就登出」——于是「access 过期但 refresh_token 仍有效」在上传/对话上仍是误判登出。
 *
 * @param forToken 触发这次 401 的请求**实际发出时**带的 access token（并发去重键，见 `api/refreshGate.uts`）
 * @param allowRetry false = 已经重发过 / 刷新接口自身 401 / 无刷新回调 ⇒ 不再尝试，直接终态
 * @param silent 是否静默（不弹 toast；SSE 侧自己把文案交回对话流，避免重复提示）
 * @returns true = 已续期，调用方带新 token 重发一次；false = 已进终态（清态 + 跳登录页 + 提示）
 */
export function renewOrExpire(forToken : string, allowRetry : boolean, silent : boolean) : Promise<boolean> {
    if (!allowRetry) {
        expireSession(silent)
        return Promise.resolve(false)
    }
    // 注意：`false` 只代表刷新**真的**失败（并发者共享同一次在飞刷新，见 tryAutoRefresh）
    return tryAutoRefresh(forToken).then((refreshed : boolean) : boolean => {
        // 刷新成功了但 token 槽是空的 ⇒ 视为失败（曾出现「刷成功却没人把 token 写回去」）
        if (refreshed && getStorage(STORAGE_KEY_TOKEN).length > 0) return true
        expireSession(silent)
        return false
    })
}

/**
 * 发起请求，返回解包后的 data（UTSJSONObject）
 * @throws Error 当网络错误、HTTP 错误或业务 code 非 200/201 时 reject
 * @note Android 端无法用 as 把 UTSJSONObject 强转为 type 字面量（Kotlin data class）
 *       因此统一返回 UTSJSONObject，由调用方手动构造目标类型
 */
export function request<T>(options : RequestOptions) : Promise<UTSJSONObject> {
    return new Promise<UTSJSONObject>((resolve, reject) => {
        const method = options.method ?? 'GET'
        const silent = options.silent ?? false
        const timeout = options.timeout ?? REQUEST_TIMEOUT
        const fullURL = resolveURL(options.url)

        if (ENABLE_DEBUG_LOG) {
            console.log('[request] >>>', method, fullURL, 'data:', sanitizeForLog(options.data))
        }

        // 单次 HTTP 请求；401 刷新成功后带新 token 重试一次
        doSingleRequest(fullURL, method, options.data, buildHeader(options.header, silent), timeout, options, false, resolve, reject)
    })
}

/**
 * mapper-callback 泛型出口：请求成功后将拆包 data 映射为领域 DTO
 * 与手动 JSON 类型映射（ADR-0003）同构：域 api 传入自己的映射函数，
 * 页面层只消费域 api 导出的类型，不再接触 UTSJSONObject
 * @param map 领域映射函数，收到统一信封解析后的 data（对象形态；裸数组已包装为 { list: [...] }）
 * @throws Error 网络错误、HTTP/业务错误由底层 request reject；map 抛出的异常不被捕获，沿 Promise 链 reject
 */
export function requestMapped<T>(options : RequestOptions, map : (data : UTSJSONObject) => T) : Promise<T> {
    return request<UTSJSONObject>(options).then((data : UTSJSONObject) : T => {
        return map(data)
    })
}

/**
 * GET 请求快捷方法（mapper-callback 出口家族）
 * query 序列化走 `api/transport.uts` 的 `withQuery`（#1734 问题 3：此前 getMapped / get /
 * envelope.getPaged 各抄一份逐字同构的 for...in + encodeURIComponent）；拆包后 data 经 map 映射为领域 DTO
 */
export function getMapped<T>(url : string, params : UTSJSONObject | null = null, map : (data : UTSJSONObject) => T, options : RequestOptions | null = null) : Promise<T> {
    const finalURL = withQuery(url, params)
    const opts : RequestOptions = options != null ? options! : { url: finalURL } as RequestOptions
    opts.url = finalURL
    opts.method = 'GET'
    return requestMapped<T>(opts, map)
}

/**
 * POST 请求快捷方法（mapper-callback 出口家族）
 * data 传法与历史 post() 逐字一致（同一 opts.data 通路，防请求形态漂移），
 * 拆包后 data 经 map 映射为领域 DTO
 */
export function postMapped<T>(url : string, data : any | null = null, map : (data : UTSJSONObject) => T, options : RequestOptions | null = null) : Promise<T> {
    const opts : RequestOptions = options != null ? options! : { url: url } as RequestOptions
    opts.url = url
    opts.method = 'POST'
    opts.data = data
    return requestMapped<T>(opts, map)
}


/**
 * PUT 请求快捷方法（mapper-callback 出口家族）
 * 存在的理由（#1734 问题 2）：此前 8 处 PUT/PATCH 全在调用方手搓
 * `opts.method = 'PUT'` + `requestMapped<T>(opts, map)` 的长径，且每处都留一句「出口家族无便捷面」的注释。
 * 与 postMapped 逐字同形（同一 opts.data 通路），只是 method 不同。
 */
export function putMapped<T>(url : string, data : any | null = null, map : (data : UTSJSONObject) => T, options : RequestOptions | null = null) : Promise<T> {
    const opts : RequestOptions = options != null ? options! : { url: url } as RequestOptions
    opts.url = url
    opts.method = 'PUT'
    opts.data = data
    return requestMapped<T>(opts, map)
}

/** PATCH 请求快捷方法（mapper-callback 出口家族）—— 与 putMapped 同形，仅 method 不同 */
export function patchMapped<T>(url : string, data : any | null = null, map : (data : UTSJSONObject) => T, options : RequestOptions | null = null) : Promise<T> {
    const opts : RequestOptions = options != null ? options! : { url: url } as RequestOptions
    opts.url = url
    opts.method = 'PATCH'
    opts.data = data
    return requestMapped<T>(opts, map)
}

/** 单次 HTTP 请求（模块级函数，支持 401 刷新后重试） */
function doSingleRequest(
    url : string,
    method : string,
    data : any | null,
    reqHeader : UTSJSONObject,
    timeout : number,
    options : RequestOptions,
    isRetry : boolean,
    resolve : (value : UTSJSONObject) => void,
    reject : (reason : any) => void
) : void {
    const silent = options.silent ?? false
    uni.request({
        url: url,
        method: method,
        data: data,
        header: reqHeader,
        timeout: timeout,
        success: (res) => {
            if (ENABLE_DEBUG_LOG) {
                console.log('[request] <<<', res.statusCode, url)
            }
            const statusCode = res.statusCode
            let body : UTSJSONObject
            try {
                body = res.data as UTSJSONObject
            } catch (e) {
                const msg = `请求失败 (${statusCode})`
                showError(msg, silent)
                reject(new Error(msg))
                return
            }

            if (handleStatus(statusCode, body, silent, '请求失败', resolve, reject)) return

            // HTTP 401：刷新接口自身 401、重试后仍 401、或无刷新回调 → 直接登出（不再尝试续期）
            if (isRetry || options.url.includes('/auth/refresh') || _refreshTokenHandler == null) {
                logoutAndReject(silent, reject)
                return
            }
            // 401 自动刷新：刷新成功后带新 token 重试一次（规则单点在 renewOrExpire）
            renewOrExpire(sentTokenOf(reqHeader), true, silent).then((retried : boolean) => {
                if (retried) {
                    doSingleRequest(url, method, data, buildHeader(options.header, silent), timeout, options, true, resolve, reject)
                } else {
                    reject(new Error(AUTH_EXPIRED_MESSAGE))
                }
            })
        },
        fail: (err) => {
            console.error('[request] <<< FAIL errMsg=', err.errMsg)
            networkError(err.errMsg, '网络连接失败，请检查网络后重试', '请求超时，请稍后重试', silent, reject)
        },
    })
}

/** GET 请求快捷方法 */
export function get(url : string, params : UTSJSONObject | null = null, options : RequestOptions | null = null) : Promise<UTSJSONObject> {
    const finalURL = withQuery(url, params)
    const opts : RequestOptions = options != null ? options! : { url: finalURL } as RequestOptions
    opts.url = finalURL
    opts.method = 'GET'
    return request<UTSJSONObject>(opts)
}

/** POST 请求快捷方法 */
export function post(url : string, data : any | null = null, options : RequestOptions | null = null) : Promise<UTSJSONObject> {
    const opts : RequestOptions = options != null ? options! : { url: url } as RequestOptions
    opts.url = url
    opts.method = 'POST'
    opts.data = data
    return request<UTSJSONObject>(opts)
}

/** PUT 请求快捷方法 */
export function put(url : string, data : any | null = null, options : RequestOptions | null = null) : Promise<UTSJSONObject> {
    const opts : RequestOptions = options != null ? options! : { url: url } as RequestOptions
    opts.url = url
    opts.method = 'PUT'
    opts.data = data
    return request<UTSJSONObject>(opts)
}

/** DELETE 请求快捷方法 */
export function del(url : string, options : RequestOptions | null = null) : Promise<UTSJSONObject> {
    const opts : RequestOptions = options != null ? options! : { url: url } as RequestOptions
    opts.url = url
    opts.method = 'DELETE'
    return request<UTSJSONObject>(opts)
}

/** PATCH 请求快捷方法 */
export function patch(url : string, data : any | null = null, options : RequestOptions | null = null) : Promise<UTSJSONObject> {
    const opts : RequestOptions = options != null ? options! : { url: url } as RequestOptions
    opts.url = url
    opts.method = 'PATCH'
    opts.data = data
    return request<UTSJSONObject>(opts)
}

// ── 上传前路径正规化（#816 根因修复）──────────────────────────────────────
// 真机证据（Android / 小米文件管理选文件）：
//   [uploadFile] >>> POST .../api/contributions/upload-file filePath=content://com.android.fileexplorer...
//   CursorWindow: Failed to read row 0, column 4294967295 from a window with 1 rows, 2 columns
//   IllegalStateException: Couldn't read row 0, col -1 from CursorWindow
//     at uts.sdk.modules.DCloudUniNetwork.UploadController.getFileInformation(index.kt:873)
// uni.uploadFile 无法用 ContentResolver 正确解析 content://（列名假设与 provider 不符），
// 请求尚未发出即崩在 getFileInformation。对策：先拷成真实文件路径再上传。

/**
 * 当 filePath 为 content:// 时，拷贝到 USER_DATA_PATH/upload-tmp 下的真实文件
 * @returns 真实可传路径
 * @note 非 content://（chooseImage 的 tempFilePath / 小程序 file:// 路径）原样透传，零行为变更
 * @note 所有文件系统 API 与 env 路径常量都锁在 APP-ANDROID 块内：非 Android 平台整段被
 *       编译器剔除，既不参与类型检查也不会运行——避免 H5 / 小程序端出现未实现 API
 */
async function prepareUploadPath(path : string) : Promise<string> {
    if (!isContentUri(path)) return path
    // #ifdef APP-ANDROID
    // uni.env.USER_DATA_PATH 在 HBuilderX 4.71+ 是 `unifile://usr/` 虚拟路径：FileSystemManager
    // 认它，但 uni.uploadFile 的原生层读不到这个 scheme，报 602001 request system error
    // （2026-09-10 真机实测）。统一转成真实绝对路径，文件系统与上传链路都用真路径。
    const basePath = UTSAndroid.convert2AbsFullPath(uni.env.USER_DATA_PATH)
    const destPath = buildTempFilePath(basePath, path, Date.now())
    const manager = uni.getFileSystemManager()
    if (ENABLE_DEBUG_LOG) {
        console.log('[uploadFile] content:// -> 落盘中转', path, '=>', destPath)
    }
    await new Promise<void>((resolve, reject) => {
        // 裸对象字面量：对齐全仓 uni API 调用惯例（不引 uni 命名类型，避免类型名不可解析）
        manager.copyFile({
            srcPath: path,
            destPath: destPath,
            success: (_res : any | null) => {
                resolve()
            },
            fail: (err : any | null) => {
                let failMsg = '系统未授予该文件访问权限'
                if (err != null) {
                    const e = err as UTSJSONObject
                    if (e['errMsg'] != null) {
                        failMsg = e['errMsg']!.toString()
                    }
                }
                reject(new Error('读取所选文件失败：' + failMsg))
            }
        })
    })
    return destPath
    // #endif
    // #ifndef APP-ANDROID
    // 非 Android 平台 chooseFile 返回的已是可访问的真实路径，无需中转
    return path
    // #endif
}

/** 删除中转文件（上传结束即清理，失败也不影响主流程） */
function removeTempFile(path : string) : void {
    // #ifdef APP-ANDROID
    if (path.indexOf('/' + UPLOAD_TMP_DIR + '/') < 0) return
    try {
        uni.getFileSystemManager().unlink({
            filePath: path,
            success: (_res : any | null) => {},
            fail: (_err : any | null) => {}
        })
    } catch (e) {
        // 中转文件残留不影响业务（USER_DATA_PATH 不会被系统清理，仅占少量空间）
    }
    // #endif
}

/**
 * 上传一次（401 时先续期、成功则重发**一次**，与 `doSingleRequest` 同一规则）
 *
 * 为什么独立成模块级函数而不是闭包：续期后要**递归**重发，UTS→Kotlin 对「自引用的局部 lambda」
 * 支持不可靠（`doSingleRequest` 同样是模块级递归）。
 *
 * @param isRetry 是否已是续期后的重发（true ⇒ 再 401 就是真失效，直接终态）
 * @param done 收尾回调（删中转文件）——**只在终态调用**：续期重发期间文件必须还在
 */
function doUpload(
    fullURL : string,
    realPath : string,
    name : string,
    safeFormData : UTSJSONObject,
    silent : boolean,
    timeout : number,
    isRetry : boolean,
    done : () => void,
    resolve : (value : UTSJSONObject) => void,
    reject : (reason : any) => void
) : void {
    // 每次发出都重新取 header：续期重发必须带**新** token（首包 401 之后 token 才会被替换）
    const header = buildUploadHeader(silent)
    if (ENABLE_DEBUG_LOG) {
        console.log('[uploadFile] >>> POST', fullURL, 'filePath=', realPath, 'retry=', isRetry)
    }
    uni.uploadFile({
        url: fullURL,
        filePath: realPath,
        name: name,
        header: header,
        formData: safeFormData,
        timeout: timeout,
        success: (res) => {
            const statusCode = res.statusCode
            // res.data 是字符串，需要 JSON.parse
            let body : UTSJSONObject
            try {
                const parsed = JSON.parse(res.data)
                if (parsed == null) {
                    throw new Error('empty body')
                }
                body = parsed as UTSJSONObject
            } catch (e) {
                const msg = `上传失败 (${statusCode})`
                showError(msg, silent)
                done()
                reject(new Error(msg))
                return
            }

            if (statusCode == 401) {
                // 401 不「见就登出」：先续期，成功则带新 token 重发一次（#1704，规则单点在 renewOrExpire）
                if (isRetry) {
                    done()
                    logoutAndReject(silent, reject)
                    return
                }
                renewOrExpire(sentTokenOf(header), true, silent).then((retried : boolean) => {
                    if (retried) {
                        doUpload(fullURL, realPath, name, safeFormData, silent, timeout, true, done, resolve, reject)
                    } else {
                        done()
                        reject(new Error(AUTH_EXPIRED_MESSAGE))
                    }
                })
                return
            }
            done()
            handleStatus(statusCode, body, silent, '上传失败', resolve, reject)
        },
        fail: (err) => {
            console.error('[uploadFile] <<< FAIL errMsg=', err.errMsg)
            done()
            networkError(err.errMsg, '上传失败，请检查网络后重试', '上传超时，请稍后重试', silent, reject)
        }
    })
}

/**
 * 上传文件（multipart/form-data）
 * @note uni.uploadFile 不走统一 request 封装，需手动注入 Authorization 与解包 ApiResponse
 * @note 入参若为 content:// URI，会先拷成真实文件再传（#816 根因修复）
 * @note 401 与普通请求同规则（ADR-0017 / #1704）：先续期、成功则带新 token 重发一次，真失败才登出
 * @returns 解包后的 data 字段（UTSJSONObject）
 */
export function uploadFile(url : string, filePath : string, name : string = 'file', formData : UTSJSONObject | null = null, options : RequestOptions | null = null) : Promise<UTSJSONObject> {
    return prepareUploadPath(filePath).then((realPath : string) : Promise<UTSJSONObject> => {
        return new Promise<UTSJSONObject>((resolve, reject) => {
            const silent = options?.silent ?? false
            const timeout = options?.timeout ?? REQUEST_TIMEOUT
            const fullURL = resolveURL(url)

            // formData 必须是 UTSJSONObject，null 时传空对象（uni.uploadFile 不接受 undefined）
            const safeFormData : UTSJSONObject = formData != null ? formData! : ({} as UTSJSONObject)

            /** 收尾：中转文件用完即删（无论成功/失败/401；续期重发期间**不删**） */
            const done = () : void => {
                removeTempFile(realPath)
            }

            doUpload(fullURL, realPath, name, safeFormData, silent, timeout, false, done, resolve, reject)
        })
    })
}
