/**
 * 全局常量
 */

/** 存储 key: 登录 token */
export const STORAGE_KEY_TOKEN = 'auth_token'

/** 存储 key: refresh token（用于 access 过期时自动刷新） */
export const STORAGE_KEY_REFRESH_TOKEN = 'auth_refresh_token'

/** 存储 key: 用户信息（JSON 字符串） */
export const STORAGE_KEY_USER = 'auth_user'

/** 存储 key: 登录来源（wechat / phone / email / password） */
export const STORAGE_KEY_LOGIN_PROVIDER = 'auth_login_provider'

/**
 * 存储 key: AI 助手——从自定义模型管理页选中的模型（跨页传递，JSON 字符串）
 * 写入于 custom-models.uvue 的 onSelect，消费并清除于 ai-assistant.uvue 的 onShow
 */
export const STORAGE_KEY_AI_SELECTED_USER_MODEL = 'ai_selected_user_model'

/** 占位入口点击提示文案 */
export const UNAVAILABLE_TOAST = '功能开发中，敬请期待'