/**
 * 全局常量
 */

/** 存储 key: 登录 token */
export const STORAGE_KEY_TOKEN = 'auth_token'

/** 存储 key: refresh token（用于 access 过期时自动刷新） */
export const STORAGE_KEY_REFRESH_TOKEN = 'auth_refresh_token'

/** 存储 key: 用户信息（JSON 字符串） */
export const STORAGE_KEY_USER = 'auth_user'

/** 存储 key: 登录来源（wechat / phone / email / password） */
export const STORAGE_KEY_LOGIN_PROVIDER = 'auth_login_provider'

/** 存储 key: 安全凭据（生物识别回填用，JSON 格式 { u, p, has }） */
export const STORAGE_KEY_CREDENTIALS = 'auth_secure_credentials'

/**
 * 存储 key: 当前身份角色（`student` | `recruiter`）
 *
 * 认证槽只有 token / refresh_token / user / login_provider 四个 key，**没有招聘者槽**
 * ⇒ 招聘者复用 `auth_token`，靠本 key 显式标记「这一槽里的凭据属于谁」（移动端 ADR-0022 ②）。
 * 401 出口据此选跳转目标（ADR-0022 ⑤）。取值一律用 `utils/authRole.uts` 的
 * `getActiveRole()` / `setActiveRole()`，不要在别处直接读写这个字面量。
 */
export const STORAGE_KEY_ACTIVE_ROLE = 'auth_active_role'

/** 身份角色取值：学员（缺省）。未写入本 key 时按它兜底 */
export const ACTIVE_ROLE_STUDENT = 'student'

/** 身份角色取值：招聘者 */
export const ACTIVE_ROLE_RECRUITER = 'recruiter'

/** 存储 key: 在线简历草稿（JSON；后端 /resume 接口就绪前的本地落地） */
export const STORAGE_KEY_RESUME = 'user_resume_draft'

/** 存储 key: 附件简历（JSON：name/size/time；后端上传接口就绪前的本地落地） */
export const STORAGE_KEY_RESUME_ATTACH = 'user_resume_attachment'

/**
 * 存储 key: AI 助手——从自定义模型管理页选中的模型（跨页传递，JSON 字符串）
 * 写入于 custom-models.uvue 的 onSelect，消费并清除于 ai-assistant.uvue 的 onShow
 */
export const STORAGE_KEY_AI_SELECTED_USER_MODEL = 'ai_selected_user_model'

/** 占位入口点击提示文案 */
export const UNAVAILABLE_TOAST = '功能开发中，敬请期待'

/**
 * 论坛图片限额（ADR-0025 P3）：**唯一来源** —— 发帖面 9 张 / 回复面 3 张。
 *
 * 为什么收到这里：加 P3 输入区时同一个数字在三个地方各写了一遍（发帖页、回复 composable、
 * 组件的 prop 缺省值），而限额同时决定「选图 count」「闸门」「toast 文案」三处行为 ——
 * 改一处漏一处就是静默的限流失配。现在：组件**不持**缺省值（`maxImages` 是必填 prop），
 * 两个宿主各取自己那一档，文案从它派生。
 */
export const FORUM_MAX_TOPIC_IMAGES = 9
export const FORUM_MAX_REPLY_IMAGES = 3