<template>
	<view class="ai-page">
		<!-- 自定义导航栏 -->
		<AiChatNav :status-bar-height="statusBarHeight" @left-click="toggleSidebarLeft" @menu-click="toggleSidebarRight" />

		<!-- 主内容区 -->
		<view class="main">
			<scroll-view scroll-y class="pro-scroll" :scroll-into-view="scrollIntoViewId" scroll-with-animation>
				<!-- 专业版档位横幅（#920）：未解锁=橙 +「查看权益」；已解锁=绿 + 只读状态。
				     配色按设计用**实色**（两态实色更干净；不是能力限制 —— #937 真机实测已证伪「本机型不绘制渐变」） -->
				<view class="pro-banner" :class="proUnlocked ? 'pro-banner-unlocked' : ''" @click="openProSheet">
					<text class="pro-banner-title" :class="proUnlocked ? 'pro-title-unlocked' : ''">{{ proBannerTitle }}</text>
					<text class="pro-banner-sub" :class="proUnlocked ? 'pro-sub-unlocked' : ''">{{ proBannerSub }}</text>
					<text class="pro-banner-go" :class="proUnlocked ? 'pro-go-unlocked' : ''">{{ proBannerCta }}</text>
				</view>

				<!-- 功能入口 -->
				<view class="function-grid">
					<view v-for="(item, idx) in functionItems" :key="idx" class="function-item" @click="onFunctionClick(item)">
						<view class="function-icon-box">
							<image v-if="item.iconPath && item.iconPath.length > 0" class="function-icon-img" :src="item.iconPath" mode="aspectFit" />
							<text v-else class="function-icon-emoji">{{ item.icon }}</text>
						</view>
						<text class="function-title">{{ item.title }}</text>
					</view>
				</view>

				<!-- 快捷提示语 -->
				<view class="prompt-list">
					<view v-for="(p, idx) in quickPrompts" :key="idx" class="prompt-card" @click="sendText(p)">
						<text class="prompt-text">{{ p }}</text>
						<text class="prompt-arrow">&#8250;</text>
					</view>
				</view>

				<!-- 聊天消息 -->
				<view v-if="messages.length > 0" class="chat-area">
					<AiChatBubble v-for="(msg, idx) in messages" :key="idx" :role="msg.role" :content="msg.content" :show-actions="msg.role == 'assistant'" :is-last="idx == messages.length - 1" @copy="onCopyText(msg.content)" @retry="onRetry" />
					<view v-if="thinking" class="message-row assistant">
						<view class="message-bubble thinking">
							<text class="message-text">思考中...</text>
						</view>
					</view>
				</view>
				<view id="bottom-anchor"></view>
			</scroll-view>
		</view>

		<!-- 底部输入区（专业版带模型选择器） -->
		<AiChatInput :show-model-bar="proUnlocked" :model-name="currentModelName" :model-readonly="!proUnlocked" :show-image-button="proUnlocked" @send="onInputSend" @model-click="onModelBarClick" @voice-click="onVoiceClick" @image-click="onImageClick" />

		<!-- 左侧会话抽屉 -->
		<AiChatDrawerLeft :visible="sidebarLeft" :sessions="sessions" :current-session-id="currentSession?.id ?? 0" :status-bar-height="statusBarHeight" @close="sidebarLeft = false" @new-chat="onNewChat" @select="onSelectSession" @delete="onDeleteSession" />

		<!-- 右侧菜单抽屉 -->
		<AiChatDrawerRight :visible="sidebarRight" :menu-items="rightMenuItems" :status-bar-height="statusBarHeight" @close="sidebarRight = false" @action="onMenuAction" />

		<!-- 模型选择弹窗 -->
		<AiChatModelPicker :visible="showModelPicker" :all-models="allModels" :current-model-id="currentModelId" :current-model-source="currentModelSource" @close="showModelPicker = false" @select="selectModel" @custom="showCustomForm = true" @manage="goManageModels" />

		<!-- 自定义 API Key 弹窗 -->
		<AiChatCustomForm :visible="showCustomForm" :custom-model="customModel" :custom-base-url="customBaseUrl" :custom-api-key="customApiKey" @close="closeCustomForm" @update:custom-model="onCustomModelUpdate" @update:custom-base-url="onCustomBaseUrlUpdate" @update:custom-api-key="onCustomApiKeyUpdate" @confirm="confirmCustomModel" />

		<!-- 专业版能力清单 / 兑换（半屏 sheet，ADR-0009 决策 4） -->
		<AiChatProSheet :visible="showProSheet" :unlocked="proUnlocked" :price="proPrice" :balance="proBalance" :degraded="proDegraded" :redeeming="proRedeeming" @close="showProSheet = false" @redeem="onRedeemAiPro" @earn="onGoEarnPoints" />
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { ref, computed } from 'vue'
	import { useAuthStore } from '../../stores/auth'
	import {
		getAiModelsApi,
		getAiUserModelsApi,
		loadAiChatSettings,
		saveAiChatSettings,
	} from '../../api/aiAssistant'
	import { useAiChat } from '../../composables/useAiChat'
	import type { ChatBodyBuilder } from '../../composables/useAiChat'
	import { useAiPro } from '../../composables/useAiPro'
	import type { AiModel, AiUserModel, AIModelOption, AiChatMessage, AiSession, AIFunctionItem } from '../../types/index'

	import { STORAGE_KEY_AI_SELECTED_USER_MODEL } from '../../constants/app'
	import { FUNCTION_ITEMS, QUICK_PROMPTS, RIGHT_MENU_ITEMS } from './ai-assistant-constants'
	import type { MenuItem } from './ai-assistant-constants'
	import AiChatNav from '../../components/ai-chat/ai-chat-nav.uvue'
	import AiChatBubble from '../../components/ai-chat/ai-chat-bubble.uvue'
	import AiChatDrawerLeft from '../../components/ai-chat/ai-chat-drawer-left.uvue'
	import AiChatDrawerRight from '../../components/ai-chat/ai-chat-drawer-right.uvue'
	import AiChatInput from '../../components/ai-chat/ai-chat-input.uvue'
	import AiChatModelPicker from '../../components/ai-chat/ai-chat-model-picker.uvue'
	import AiChatCustomForm from '../../components/ai-chat/ai-chat-custom-form.uvue'
	import AiChatProSheet from '../../components/ai-chat/ai-chat-pro-sheet.uvue'


	const auth = useAuthStore()

	// 专业版能力门（#920）：事实源 = 积分商城 SKU「ai_pro」的**已拥有**，由 useAiPro 单点
	// 适配器读出（后端尚未暴露权益读面，适配器用支出流水推导 —— 见 composables/useAiPro.uts
	// 文件头的三条代价声明）。页面只消费 proUnlocked，以下四处共用它，**不得各自另立判据**：
	// ① 输入区模型芯片 / 附件按钮；② 抽屉「自定义模型」菜单项；③ 模型芯片点击；④ 本页档位横幅。
	const {
		proUnlocked,
		proPrice,
		proBalance,
		proDegraded,
		proRedeeming,
		loadAiProState,
		redeemAiPro,
	} = useAiPro()



	// 聊天核心逻辑
	const {
		statusBarHeight,
		sessions,
		currentSession,
		messages,
		inputText,
		thinking,
		scrollIntoViewId,
		sidebarLeft,
		sidebarRight,
		loadSessions,
		loadSession,
		startNewChat,
		onDeleteSession,
		toggleSidebarLeft,
		toggleSidebarRight,
		sendInput,
	} = useAiChat()

	// 视图状态
	const showModelPicker = ref<boolean>(false)
	const showCustomForm = ref<boolean>(false)
	const showProSheet = ref<boolean>(false)
	const customModel = ref<string>('')
	const customBaseUrl = ref<string>('')
	const customApiKey = ref<string>('')

	// 数据（模型）
	const models = ref<AiModel[]>([])
	const userModels = ref<AiUserModel[]>([])
	const currentModelId = ref<number>(0)
	const currentModelSource = ref<string>('admin')

	const allModels = computed<AIModelOption[]>(() : AIModelOption[] => {
		const arr : AIModelOption[] = []
		for (let i = 0; i < models.value.length; i++) {
			const m = models.value[i]
			arr.push({ id: m.id, name: m.name, model: m.model, source: m.source, description: m.description })
		}
		for (let i = 0; i < userModels.value.length; i++) {
			const m = userModels.value[i]
			arr.push({ id: m.id, name: m.name, model: m.model, source: 'user', base_url: m.base_url })
		}
		return arr
	})

	const currentModelName = computed<string>(() : string => {
		if (currentModelSource.value == 'custom') {
			return customModel.value.length > 0 ? customModel.value : '自定义'
		}
		const list = allModels.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id == currentModelId.value) {
				return list[i].name
			}
		}
		return '选择模型'
	})

	// 右侧菜单：未解锁专业版时**不显示**「自定义模型」。
	// 该页属专业版能力（门集合见 ADR 0009），必须与输入区的能力门同一口径 ——
	// 否则未解锁用户仍能从抽屉进入该页（本改动修的正是这条漏网路径）。
	// 用 computed 过滤而非改常量：常量仍描述「专业版全量菜单」，可见性由能力门决定。
	const rightMenuItems = computed<MenuItem[]>(() : MenuItem[] => {
		if (proUnlocked.value) {
			return RIGHT_MENU_ITEMS
		}
		return RIGHT_MENU_ITEMS.filter((m : MenuItem) => m.key != 'custom-models')
	})

	// 功能入口（从常量导入）
	const functionItems = FUNCTION_ITEMS
	const quickPrompts = QUICK_PROMPTS

	// 待发功能键（#921）：宫格点击时置入、**该轮发完即清** —— 它是「这一轮走哪个专项通道」，
	// 不是会话级状态：① 否则点一次「故障咨询」会把之后整段自由对话都钉在诊断通道上；
	// ② 它**不能**从发送入口的早退分支漏出去（见 onInputSend 里「先取走」的位置）。
	// 空串 = 通用对话（后端按通用助手计费）。
	// 只影响**本轮对话**，不影响建会话：会话按功能键分区，而列表不查专项区（见 api/aiAssistant.uts）。
	const pendingFeatureKey = ref<string>('')

	// 档位横幅文案（两态单点；未解锁 = 兑换主曝光位，已解锁 = 只读状态）
	const proBannerTitle = computed<string>(() : string => {
		return proUnlocked.value ? '专业版 · 已解锁' : '解锁专业版'
	})
	const proBannerSub = computed<string>(() : string => {
		if (proUnlocked.value) {
			return '选模型 / 自定义模型 / 发图片 已全部可用'
		}
		return '选模型 / 自定义模型 / 发图片 · 积分兑换解锁'
	})
	const proBannerCta = computed<string>(() : string => {
		return proUnlocked.value ? '已解锁' : '查看权益'
	})

	// 专业版请求体
	const buildBody : ChatBodyBuilder = (history : AiChatMessage[], sessionID : number, featureKey : string) : UTSJSONObject => {
		const params : UTSJSONObject = {
			session_id: sessionID,
			model_source: currentModelSource.value,
			messages: history,
		}
		// 专项功能键（#921）：只带宫格那一轮的键。带键时后端走专项通道（管理端单绑定 +
		// 独立计费声明），不带键落通用对话 —— 空串显式发送，语义与「不发送」等价。
		params['feature_key'] = featureKey
		if (currentModelSource.value == 'admin') {
			params['config_id'] = currentModelId.value
		} else if (currentModelSource.value == 'user') {
			params['user_model_id'] = currentModelId.value
		} else {
			params['custom_api_key'] = customApiKey.value.trim()
			params['custom_base_url'] = customBaseUrl.value.trim()
			params['custom_model'] = customModel.value.trim()
		}
		return params
	}

	// 发送
	function onInputSend(text : string) : void {
		// 功能键**先取走、再清空**：它只属于「这一次点击」。顺序写反（先清后取）会让每轮都送空键、
		// 专项通道静默失效（#999 真机实测：featureKey 恒为 ''，诊断通道从未生效）。
		// 清空必须仍在两条早退守卫**之前**：点宫格时若恰好还没拿到模型（loadModels 未回）就会
		// toast 并 return，键若留在 ref 里，随后那条**无关**的自由提问／快捷提示语会带着
		// fault_diagnosis 走诊断通道（且限免不计费）。
		// 取走即清（不依赖 sendInput 是否真的发出），异常路径也不残留到下一轮。
		const featureKey = pendingFeatureKey.value
		pendingFeatureKey.value = ''
		if (models.value.length == 0 && userModels.value.length == 0 && currentModelSource.value != 'custom') {
			uni.showToast({ title: '暂无可用的 AI 模型', icon: 'none' })
			return
		}
		if (currentModelSource.value == 'custom' && customModel.value.trim().length == 0) {
			uni.showToast({ title: '请先配置自定义模型', icon: 'none' })
			return
		}
		inputText.value = text
		sendInput(currentModelName.value, buildBody, [], featureKey)
	}

	function sendText(text : string) : void {
		inputText.value = text
		onInputSend(text)
	}

	// 消息操作
	function onCopyText(content : string) : void {
		uni.setClipboardData({ data: content, success: () => { uni.showToast({ title: '已复制', icon: 'success' }) } })
	}

	function onVoiceClick() : void {
		uni.showToast({ title: '语音输入开发中', icon: 'none' })
	}

	function onImageClick() : void {
		uni.showToast({ title: '图片发送开发中', icon: 'none' })
	}

	function getLastUserMessage() : string {
		for (let i = messages.value.length - 1; i >= 0; i--) {
			if (messages.value[i].role == 'user') {
				return messages.value[i].content
			}
		}
		return ''
	}

	function onRetry() : void {
		const lastUserMsg = getLastUserMessage()
		if (lastUserMsg.length > 0) {
			inputText.value = lastUserMsg
			onInputSend(lastUserMsg)
		}
	}



	// 专业版横幅：未解锁 → 能力清单 + 所需积分 + 去兑换；已解锁 → 只读状态（同一个 sheet）
	function openProSheet() : void {
		showProSheet.value = true
	}

	// 模型芯片：未解锁时该芯片**不渲染**（`show-model-bar` 由 proUnlocked 决定），
	// 本分支是状态翻转竞态下的兜底 —— 走与横幅同一入口，不在页面另立第二套提示文案
	function onModelBarClick() : void {
		if (!proUnlocked.value) {
			showProSheet.value = true
			return
		}
		showModelPicker.value = true
	}

	// 兑换（服务端单管线）：成功 ⇒ 原地刷新门状态 —— 横幅转「已解锁」，输入区出现模型芯片与附件按钮
	async function onRedeemAiPro() : Promise<void> {
		const res = await redeemAiPro()
		if (res.ok) {
			showProSheet.value = false
			uni.showToast({ title: res.message, icon: 'success' })
			await loadAiProState()
			return
		}
		// 失败不静默（验收标准第 4 条）：request 层已按服务端文案提示，此处兜底一次可读文案
		uni.showToast({ title: res.message.length > 0 ? res.message : '兑换失败，请稍后再试', icon: 'none' })
	}

	// 积分不足 → 去任务中心赚积分；回页时 onShow 重读门状态
	function onGoEarnPoints() : void {
		showProSheet.value = false
		uni.navigateTo({ url: '/pages/points/task-center' })
	}

	// 会话操作
	function onNewChat() : void {
		startNewChat()
		sidebarLeft.value = false
	}

	function onSelectSession(s : AiSession) : void {
		loadSession(s)
	}

	// 右侧菜单操作
	function onMenuAction(key : string) : void {
		sidebarRight.value = false
		if (key == 'new-chat') {
			startNewChat()
		} else if (key == 'settings') {
			uni.navigateTo({ url: '/pages/ai-assistant/ai-settings' })
		} else if (key == 'custom-models') {
			uni.navigateTo({ url: '/pages/ai-assistant/custom-models' })
		} else if (key == 'profile') {
			uni.switchTab({ url: '/pages/profile/profile' })
		}
	}

	// 宫格入口：带专项功能键的那一格（如「故障咨询」→ fault_diagnosis）本轮走专项通道，
	// 未带键的格子行为与从前一致（只发本地 prompt，落通用对话 —— 其余 4 格见 #971）
	function onFunctionClick(item : AIFunctionItem) : void {
		pendingFeatureKey.value = item.featureKey ?? ''
		sendText(item.prompt)
	}

	// 持久化设置
	function persistSettings() : void {
		const s = loadAiChatSettings()
		s.model_source = currentModelSource.value
		s.model_id = currentModelId.value
		if (currentModelSource.value == 'custom') {
			s.model_name = customModel.value.length > 0 ? customModel.value : s.model_name
			s.model = customModel.value
			s.base_url = customBaseUrl.value
			s.api_key = customApiKey.value
			s.model_id = 0
		} else if (currentModelSource.value == 'user') {
			for (let i = 0; i < userModels.value.length; i++) {
				const um = userModels.value[i]
				if (um.id == currentModelId.value) {
					s.model_name = um.name
					s.model = um.model
					s.base_url = um.base_url
					s.api_key = ''
					break
				}
			}
		} else {
			for (let i = 0; i < models.value.length; i++) {
				const pm = models.value[i]
				if (pm.id == currentModelId.value) {
					s.model_name = pm.name
					s.model = pm.model
					break
				}
			}
			s.base_url = ''
			s.api_key = ''
		}
		saveAiChatSettings(s)
	}

	// 模型选择
	function selectModel(m : AIModelOption) : void {
		currentModelId.value = m.id
		let isUser = false
		for (let i = 0; i < userModels.value.length; i++) {
			if (userModels.value[i].id == m.id) {
				isUser = true
				break
			}
		}
		currentModelSource.value = isUser ? 'user' : 'admin'
		showModelPicker.value = false
		persistSettings()
	}

	function selectUserModelById(id : number, name : string) : void {
		for (let i = 0; i < userModels.value.length; i++) {
			if (userModels.value[i].id == id) {
				currentModelId.value = id
				currentModelSource.value = 'user'
				showModelPicker.value = false
				uni.showToast({ title: '已切换：' + name, icon: 'none' })
				persistSettings()
				return
			}
		}
		currentModelId.value = id
		currentModelSource.value = 'user'
		showModelPicker.value = false
		persistSettings()
	}

	function goManageModels() : void {
		showModelPicker.value = false
		uni.navigateTo({ url: '/pages/ai-assistant/custom-models' })
	}

	// 自定义 API Key
	function closeCustomForm() : void {
		showCustomForm.value = false
	}

	function onCustomModelUpdate(value : string) : void {
		customModel.value = value
	}

	function onCustomBaseUrlUpdate(value : string) : void {
		customBaseUrl.value = value
	}

	function onCustomApiKeyUpdate(value : string) : void {
		customApiKey.value = value
	}

	function confirmCustomModel() : void {
		customModel.value = customModel.value.trim()
		customBaseUrl.value = customBaseUrl.value.trim()
		customApiKey.value = customApiKey.value.trim()
		currentModelSource.value = 'custom'
		currentModelId.value = 0
		showCustomForm.value = false
		showModelPicker.value = false
		persistSettings()
	}

	// 水合 & 持久化
	function hydrateFromSettings() : void {
		const saved = loadAiChatSettings()
		const src = saved.model_source
		if (src == 'user') {
			for (let i = 0; i < userModels.value.length; i++) {
				if (userModels.value[i].id == saved.model_id) {
					currentModelId.value = saved.model_id
					currentModelSource.value = 'user'
					return
				}
			}
		} else if (src == 'custom') {
			if (saved.base_url.length > 0 && saved.model.length > 0 && saved.api_key.length > 0) {
				customModel.value = saved.model
				customBaseUrl.value = saved.base_url
				customApiKey.value = saved.api_key
				currentModelSource.value = 'custom'
				currentModelId.value = 0
				return
			}
		} else if (src == 'admin') {
			for (let i = 0; i < models.value.length; i++) {
				if (models.value[i].id == saved.model_id) {
					currentModelId.value = saved.model_id
					currentModelSource.value = 'admin'
					return
				}
			}
		}
		if (models.value.length > 0 && currentModelId.value == 0) {
			currentModelId.value = models.value[0].id
		}
		currentModelSource.value = 'admin'
	}

	// 数据加载
	async function loadModels() : Promise<void> {
		try {
			models.value = await getAiModelsApi()
		} catch (e) {
			console.error('loadModels failed:', e)
			models.value = [] as AiModel[]
		}
		if (auth.isLoggedIn.value) {
			try {
				userModels.value = await getAiUserModelsApi()
			} catch (e) {
				console.error('loadUserModels failed:', e)
				userModels.value = [] as AiUserModel[]
			}
		}
		hydrateFromSettings()
	}

	// 生命周期
	onLoad((options : OnLoadOptions) => {
		const sysInfo = uni.getSystemInfoSync()
		statusBarHeight.value = sysInfo.statusBarHeight

		auth.restoreFromStorage()
		if (!auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}



		loadModels()
		loadSessions()
		// 门状态与模型/会话并行读（失败 fail-closed 为未解锁，不阻塞首屏）
		loadAiProState()
	})

	onShow(() => {
		if (auth.isLoggedIn.value) {
			loadSessions()
		}
		hydrateFromSettings()
		// 已解锁为**粘性**：权益一次兑换永久持有（user_entitlement 无过期列），
		// 不为同一事实在每次回页重复扫流水；未解锁时重读 —— 用户可能刚在任务中心兑换或赚到积分
		if (!proUnlocked.value) {
			loadAiProState()
		}

		const selectedRaw = uni.getStorageSync(STORAGE_KEY_AI_SELECTED_USER_MODEL) as string
		if (selectedRaw.length > 0) {
			uni.removeStorageSync(STORAGE_KEY_AI_SELECTED_USER_MODEL)
			try {
				const sel = JSON.parse(selectedRaw) as UTSJSONObject
				const id = parseFloat(`${sel['id']}`)
				const name = `${sel['name'] ?? ''}`
				selectUserModelById(id, name)
			} catch (e) {
				console.error('[ai-assistant] apply selected model failed:', e)
			}
		}
	})
</script>

