<template>
	<view class="ai-page" :style="{ height: pageHeight + 'px' }">
		<!-- 自定义导航栏 -->
		<AiChatNav :drawer-open="sidebarLeft" @left-click="toggleSidebarLeft" @menu-click="toggleSidebarRight" />

	<!-- 功能入口头部（#998 → #2593 页内 scope）：**移出滚动容器** ⇒ 滑动时天然不丢失（**结构性保证**，不依赖
	     `position: sticky` —— 该属性在本项目 0 处先例、uvue 支持亦无文档）。
	     通用 scope：宫格 + `^ / v` 收起展开（默认展开、不跨会话记忆，维护者 2026-09-15 口径）。
	     专项 scope：宫格收起为「当前区 ⌄」chip（原型 791:750），chip 下拉可换区或回通用对话。
	     代价如实记：头部位于档位横幅**之上**，横幅不再是首屏第一个元素（专项 scope 下无横幅，代价只在通用区）。 -->
		<view class="func-head">
			<view v-if="!isScoped" class="func-head-handle" @click="toggleFunctionHeader">
				<text class="func-head-arrow">{{ functionHeaderCollapsed ? 'v' : '^' }}</text>
			</view>
			<view v-if="!isScoped && !functionHeaderCollapsed" class="function-grid">
				<view v-for="(item, idx) in functionItems" :key="idx" class="function-item" @click="onFunctionClick(item)">
					<view class="function-icon-box">
						<image v-if="item.iconPath && item.iconPath.length > 0" class="function-icon-img" :src="item.iconPath" mode="aspectFit" :webp="true" />
						<text v-else class="function-icon-emoji">{{ item.icon }}</text>
					</view>
					<text class="function-title">{{ item.title }}</text>
					<!-- 限免小签：`freePreview` 是后端功能注册表的**限免声明位**（本格不扣积分），
					     客户端唯一的可见消费面就在宫格上 —— 声明位只写进常量、界面上不显示，
					     学员就看不到「这一格免费」。判定仍只读注册表镜像，页面不另立条件。
					     位置在**标题下方独立一行**：压在图标右上角会与本格橙黄图标同色系黏成一团
					     （② 首帧实测），且「限免」与标题同行必然把长标题挤成两行（见样式处尺寸推论）。 -->
					<view v-if="item.freePreview" class="function-free-badge">
						<text class="function-free-badge-text">限免</text>
					</view>
				</view>
			</view>
			<!-- 专项 scope：宫格让位给 scope chip（原型 791:750 的「故障咨询 ⌄」）。
			     chip 就是「本页会话作用域」的可见面 —— 切它 = 换区 = 重置当前会话并重列该区（ADR-0013）。 -->
			<view v-if="isScoped" class="scope-bar">
				<view class="scope-chip" @click="toggleScopeMenu">
					<text class="scope-chip-text">{{ scopeTitle }}</text>
					<text class="scope-chip-arrow">{{ scopeMenuOpen ? '^' : 'v' }}</text>
				</view>
			</view>
			<view v-if="isScoped && scopeMenuOpen" class="scope-menu">
				<view class="scope-menu-item" @click="onScopeSelect('')">
					<text class="scope-menu-text">通用对话</text>
				</view>
				<view v-for="(item, idx) in functionItems" :key="idx" class="scope-menu-item" @click="onScopeSelect(item.featureKey)">
					<text class="scope-menu-text">{{ item.scopeLabel }}</text>
				</view>
			</view>
		</view>

		<!-- 主内容区 -->
		<view class="main">
			<scroll-view class="pro-scroll" scroll-y="true" :scroll-into-view="scrollIntoViewId" scroll-with-animation>
				<!-- 专业版档位横幅（#920）：未解锁=橙 +「查看权益」；已解锁=绿 + 只读状态。
				     配色按设计用**实色**（两态实色更干净；不是能力限制 —— #937 真机实测已证伪「本机型不绘制渐变」） -->
				<view v-if="!isScoped" class="pro-banner" :class="proUnlocked ? 'pro-banner-unlocked' : ''" @click="openProSheet">
					<text class="pro-banner-title" :class="proUnlocked ? 'pro-title-unlocked' : ''">{{ proBannerTitle }}</text>
					<text class="pro-banner-sub" :class="proUnlocked ? 'pro-sub-unlocked' : ''">{{ proBannerSub }}</text>
					<text class="pro-banner-go" :class="proUnlocked ? 'pro-go-unlocked' : ''">{{ proBannerCta }}</text>
				</view>

				<!-- 诊断空态欢迎区（#2296，随专项 scope 并入 #2593）：品牌快选 + 常见问题。
				     取数失败 / health.ok=false 时 guideVisible 为 false ⇒ **整块不渲染**（不留「点了必失败」的按钮）。 -->
				<view v-if="isDiagnosis && guideVisible && messages.length == 0" class="welcome-area">
					<view class="welcome-brand-row">
						<view v-for="b in brands" :key="b.id" class="welcome-brand" @click="onPickBrandCard(b.id)">
							<text class="welcome-brand-icon">{{ b.icon }}</text>
							<text class="welcome-brand-name">{{ b.name }}</text>
							<text v-if="b.tagline.length > 0" class="welcome-brand-tagline">{{ b.tagline }}</text>
						</view>
					</view>
					<view v-if="faq.length > 0" class="welcome-faq">
						<text class="welcome-faq-title">大家常问</text>
						<view v-for="(f, idx) in faq" :key="idx" class="welcome-faq-row" @click="onPickFaq(f.q)">
							<text class="welcome-faq-q">{{ f.q }}</text>
						</view>
					</view>
				</view>

				<!-- 快捷提示语（通用 scope 专有：专项 scope 有自己的欢迎区） -->
				<view v-if="!isScoped" class="prompt-list">
					<view v-for="(p, idx) in quickPrompts" :key="idx" class="prompt-card" @click="sendText(p)">
						<text class="prompt-text">{{ p }}</text>
						<text class="prompt-arrow">&#8250;</text>
					</view>
				</view>

				<!-- 聊天消息 -->
				<view v-if="messages.length > 0" class="chat-area">
					<AiChatBubble v-for="(msg, idx) in messages" :key="idx" :role="msg.role" :content="msg.content" :sources="msg.sources" :images="msg.images" :meta="msg.meta" :show-actions="msg.role == 'assistant'" :is-last="idx == messages.length - 1" @copy="onCopyText(msg.content)" @retry="onRetry" />
					<view v-if="thinking" class="message-row assistant">
						<view class="message-bubble thinking">
							<text class="message-text">{{ thinkingLabel }}</text>
						</view>
					</view>
				</view>
				<view id="bottom-anchor"></view>
			</scroll-view>
		</view>

		<!-- 模型下拉的收起遮罩（#2520）：透明层只负责「点面板以外的地方收起」。
		     必须放在页面层（与抽屉同一层级）才锚定整页，放进输入卡会随组件父级解析。 -->
		<view v-if="showModelPicker" class="model-mask" @click="showModelPicker = false"></view>

		<!-- 引导入口：只在诊断 scope 且引导数据可用时出现（guideVisible 单一判据） -->
		<view v-if="isDiagnosis && guideVisible" class="guide-entry" @click="openGuide">
			<text class="guide-entry-text">{{ guideEntryLabel }}</text>
		</view>

		<!-- 故障码体检（#2297）：输入框正上方一行，只渲染 known / typo；format / 未收录 / 未输入 / 取数失败
		     都**整行不渲染**（安静不打扰是判据）。点这一行 = 追问句替换进输入框（不自动发送）。 -->
		<view v-if="isDiagnosis && codeHintView.visible" class="code-hint" @click="onCodeHintTap">
			<text :class="codeHintView.kind == 'known' ? 'code-hint-text' : 'code-hint-text code-hint-text-warn'">{{ codeHintView.text }}</text>
			<text v-if="codeHintView.followUp.length > 0" class="code-hint-action">追问 ›</text>
		</view>

		<!-- 待发图片托盘（#2299）：只在诊断 scope、且有内容/上传中出现；发送后由 picker.clear() 收空 -->
		<AiChatImageTray v-if="isDiagnosis" :images="pickImages" :uploading-count="pickUploading" :max-images="aiMaxImages" @remove="onRemoveImage" @preview="onPreviewImage" />

		<!-- 底部输入区（专业版带模型选择器）；专项 scope 下**无模型芯片** —— 专项通道不吃用户自选模型（#998）
		     ⇒ 模型下拉**内联在输入卡里**（#2520，原型 793:1197）。 -->
		<AiChatInput :show-model-bar="proUnlocked && !isScoped" :model-name="currentModelName" :model-readonly="!proUnlocked" :show-image-button="isDiagnosis || proUnlocked" :image-count="pickImages.length" :draft="draftText" :reset-signal="scopeResetSignal" :model-picker-open="showModelPicker" @send="onInputSend" @model-click="onModelBarClick" @voice-click="onVoiceClick" @image-click="onImageClick" @text-change="onDraftInput">
			<!-- 模型选择（三条自带 key 路径都由页面侧过门：#1024 ③④⑤）；专项 scope 下整块不渲染 -->
			<AiChatModelPicker v-if="!isScoped" :visible="showModelPicker" :all-models="allModels" :current-model-id="currentModelId" :current-model-source="currentModelSource" @close="showModelPicker = false" @select="selectModel" @custom="onCustomClick" @manage="goManageModels" />
		</AiChatInput>

		<!-- 诊断引导面板（#2296）：四步状态机与组句在 useDiagnosisGuide，本页只转动作 -->
		<AiChatDiagnosisGuide :visible="guideOpen" :brands="brands" :state="guideState" :second-items="secondItems" :fault-items="faultItems" :second-loading="secondLoading" :fault-loading="faultLoading" :sentence="sentence" @close="closeGuide" @pick-brand="pickBrand" @pick-second="pickSecond" @pick-fault="pickFault" @update-extra="updateExtra" @jump="jumpStep" @confirm="onConfirmSentence" />

		<!-- 左侧会话抽屉 -->
		<AiChatDrawerLeft :visible="sidebarLeft" :sessions="sessions" :current-session-id="currentSessionId" :status-bar-height="statusBarHeight" @close="sidebarLeft = false" @new-chat="onNewChat" @select="onSelectSession" @delete="onDeleteSession" />

		<!-- 右侧菜单抽屉 -->
		<AiChatDrawerRight :visible="sidebarRight" :menu-items="rightMenuItems" :status-bar-height="statusBarHeight" @close="sidebarRight = false" @action="onMenuAction" />

		<!-- 自定义 API Key 弹窗 -->
		<AiChatCustomForm :visible="showCustomForm" :custom-model="customModel" :custom-base-url="customBaseUrl" :custom-api-key="customApiKey" @close="closeCustomForm" @update:custom-model="onCustomModelUpdate" @update:custom-base-url="onCustomBaseUrlUpdate" @update:custom-api-key="onCustomApiKeyUpdate" @confirm="confirmCustomModel" />

		<!-- 专业版能力清单 / 兑换（半屏 sheet，ADR-0009 决策 4） -->
		<AiChatProSheet :visible="showProSheet" :unlocked="proUnlocked" :price="proPrice" :balance="proBalance" :degraded="proDegraded" :redeeming="proRedeeming" @close="showProSheet = false" @redeem="onRedeemAiPro" @earn="onGoEarnPoints" />

	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import { ref, computed, watch } from 'vue'
	import { useAuthStore } from '../../stores/auth'
	import {
		getAiModelsApi,
		getAiUserModelsApi,
		checkDiagnosisCodeApi,
	} from '../../api/aiAssistant'
	import { useAiChat } from '../../composables/useAiChat'
	import {
		loadAiChatSettings,
		saveAiChatSettings,
		normalizeAiChatSettings,
		emptyAiCustomModelInput,
	} from '../../composables/useAiModelSelection'
	import type { ChatBodyBuilder } from '../../composables/useAiChat'
	import { useAiPro } from '../../composables/useAiPro'
	import { useDiagnosisGuide } from '../../composables/useDiagnosisGuide'
	import { useAiImagePicker } from '../../composables/useAiImagePicker'
	import { useDiagnosisCodeHint } from '../../composables/useDiagnosisCodeHint'
	import { canSend } from '../../utils/aiImageQuota'
	import { AI_MAX_IMAGES } from '../../config/env'
	import type { AiModel, AiUserModel, AIModelOption, AiChatMessage, AiSession, AIFunctionItem, DiagnosisCodeHint } from '../../types/index'

	import { STORAGE_KEY_AI_SELECTED_USER_MODEL } from '../../constants/app'
	import { FUNCTION_ITEMS, QUICK_PROMPTS, RIGHT_MENU_ITEMS, isDiagnosisFeature } from './ai-assistant-constants'
	import type { MenuItem } from './ai-assistant-constants'
	import AiChatNav from '../../components/ai-chat/ai-chat-nav.uvue'
	import AiChatBubble from '../../components/ai-chat/ai-chat-bubble.uvue'
	import AiChatDrawerLeft from '../../components/ai-chat/ai-chat-drawer-left.uvue'
	import AiChatDrawerRight from '../../components/ai-chat/ai-chat-drawer-right.uvue'
	import AiChatInput from '../../components/ai-chat/ai-chat-input.uvue'
	import AiChatModelPicker from '../../components/ai-chat/ai-chat-model-picker.uvue'
	import AiChatCustomForm from '../../components/ai-chat/ai-chat-custom-form.uvue'
	import AiChatProSheet from '../../components/ai-chat/ai-chat-pro-sheet.uvue'
	import AiChatDiagnosisGuide from '../../components/ai-chat/ai-chat-diagnosis-guide.uvue'
	import AiChatImageTray from '../../components/ai-chat/ai-chat-image-tray.uvue'


	const auth = useAuthStore()

	// 专业版能力门（#920）：事实源 = 积分商城 SKU「ai_pro」的**已拥有**，由 useAiPro 单点
	// 适配器读出（后端尚未暴露权益读面，适配器用支出流水推导 —— 见 composables/useAiPro.uts
	// 文件头的三条代价声明）。页面只消费 proUnlocked，以下四处共用它，**不得各自另立判据**：
	// ① 输入区模型芯片 / 附件按钮；② 抽屉「自定义模型」菜单项；③ 模型芯片点击；④ 本页档位横幅。
	const {
		proUnlocked,
		proPrice,
		proBalance,
		proDegraded,
		proRedeeming,
		loadAiProState,
		redeemAiPro,
	} = useAiPro()



	// 页内会话作用域（#2593；ADR-0013 2026-11-16 修订）：空串 = 通用区；非空 = 该功能键的专项区。
	// **会话归属 = 本页状态**：宫格点击在本页切 scope（不再推入专项页），list/create 都带这个键，
	// 抽屉（AiChatDrawerLeft）就是「列该区」的那个界面 —— 缺了它，带键会话在「最近对话」里永久不可见
	// （#921 首版实测回归形态）。通用区恒传空串 ⇒ 遗留 `ai_assistant` 区，与从前逐字一致。
	const activeScope = ref<string>('')

	const isScoped = computed<boolean>(() : boolean => activeScope.value.length > 0)

	// 「诊断专有 UI」的**唯一判据**（读注册表 `adapter` 列，ADR-0047 §7）：禁止比较功能键字面量。
	const isDiagnosis = computed<boolean>(() : boolean => isDiagnosisFeature(activeScope.value))

	// scope chip 的文案：通用区不渲染 chip；专项区用清单的短名（fault_diagnosis = 故障咨询，见 scopeLabel）
	const scopeTitle = computed<string>(() : string => {
		for (let i = 0; i < FUNCTION_ITEMS.length; i++) {
			if (FUNCTION_ITEMS[i].featureKey == activeScope.value) {
				return FUNCTION_ITEMS[i].scopeLabel
			}
		}
		return '通用对话'
	})

	// chip 下拉的开合（只影响 chip 自身，不进会话状态）
	const scopeMenuOpen = ref<boolean>(false)
	// 清空信号：切 scope 时 +1，让输入框丢掉上一区没发出去的字（见 ai-chat-input 的 `resetSignal`）
	const scopeResetSignal = ref<number>(0)

	const {
		statusBarHeight,
		sessions,
		currentSession,
		messages,
		inputText,
		thinking,
		statusText,
		scrollIntoViewId,
		sidebarLeft,
		sidebarRight,
		loadSessions,
		loadSession,
		startNewChat,
		onDeleteSession,
		toggleSidebarLeft,
		toggleSidebarRight,
		sendInput,
	} = useAiChat(activeScope)

	// 抽屉的「当前会话 id」：模板里直接写 `currentSession?.id ?? 0` 会让 mp-weixin 产物残留
	// `??`（ES2020），微信上传接口按 ES2019 解析产物，直接拒传（#2419 实测
	// `invalid file: pages/ai-assistant/ai-assistant.js, 1:9427 SyntaxError: Unexpected token ?`）；
	// 模板里改写成三元又过不了 Kotlin 侧 —— `AiSession?` 在这条渲染通路上不智能转换，
	// ④ 编译门实测报 `Only safe (?.) or non-null asserted (!!.) calls are allowed`。
	// 落在 script 里的 computed 两头都满足：Kotlin 侧对局部 val 判空后可智能转换，
	// mp-weixin 产物是三目表达式。
	const currentSessionId = computed<number>(() : number => {
		const s = currentSession.value
		return s == null ? 0 : s.id
	})


	// 等待态（#2298 / #2389）：三件事一块做 ——
	// 1) 已等秒数：等待期间每秒 +1，让「在跑」与「卡住」在界面上可区分（规格决策 17）；
	// 2) 诊断 scope 常亮：微信「切后台 5 秒未结束即 fail interrupted」与 timeout 取值无关，能挡的只有屏息；
	// 3) 计时器跟着等待态关：请求结束（成功 / 失败 / 超时 / 截断）后不能继续跳秒，更不能串到下一轮。
	const thinkingSeconds = ref<number>(0)
	// 文案优先级（#2389）：后端阶段文案 > 已等秒数 > 兜底「思考中...」。
	const thinkingLabel = computed<string>(() : string => {
		if (statusText.value.length > 0) {
			return statusText.value
		}
		if (thinkingSeconds.value <= 0) {
			return '思考中...'
		}
		return '思考中... 已等 ' + thinkingSeconds.value + ' 秒'
	})
	let thinkingTimer : number | null = null
	let keepScreenOnByThinking : boolean = false

	function stopThinkingTimer() : void {
		const t = thinkingTimer
		if (t != null) {
			clearInterval(t)
			thinkingTimer = null
		}
	}

	function restoreScreenOn() : void {
		if (keepScreenOnByThinking) {
			keepScreenOnByThinking = false
			uni.setKeepScreenOn({ keepScreenOn: false })
		}
	}

	watch(thinking, (active : boolean) : void => {
		// 每一轮先收旧计时器：上一轮的 interval 若还在跑，秒数会从上一轮的值接着涨（串轮）
		stopThinkingTimer()
		if (!active) {
			thinkingSeconds.value = 0
			restoreScreenOn()
			return
		}
		thinkingSeconds.value = 0
		if (isDiagnosis.value && !keepScreenOnByThinking) {
			keepScreenOnByThinking = true
			uni.setKeepScreenOn({ keepScreenOn: true })
		}
		thinkingTimer = setInterval(() : void => {
			thinkingSeconds.value = thinkingSeconds.value + 1
		}, 1000)
	})

	// 视图状态
	const showModelPicker = ref<boolean>(false)
	const showCustomForm = ref<boolean>(false)
	const showProSheet = ref<boolean>(false)
	const customModel = ref<string>('')
	const customBaseUrl = ref<string>('')
	const customApiKey = ref<string>('')

	// 数据（模型）
	const models = ref<AiModel[]>([])
	const userModels = ref<AiUserModel[]>([])
	const currentModelId = ref<number>(0)
	const currentModelSource = ref<string>('admin')

	const allModels = computed<AIModelOption[]>(() : AIModelOption[] => {
		const arr : AIModelOption[] = []
		for (let i = 0; i < models.value.length; i++) {
			const m = models.value[i]
			arr.push({ id: m.id, name: m.name, model: m.model, source: m.source, description: m.description })
		}
		// 已保存的自定义模型 = 自带 key 的**使用面**（#1024 ⑤；与设置页 ② 同一能力、同一门）：
		// 未解锁时不进选择器 —— 否则点选即 currentModelSource='user'，等于绕过专业版
		if (proUnlocked.value) {
			for (let i = 0; i < userModels.value.length; i++) {
				const m = userModels.value[i]
				arr.push({ id: m.id, name: m.name, model: m.model, source: 'user', base_url: m.base_url })
			}
		}
		return arr
	})

	const currentModelName = computed<string>(() : string => {
		if (currentModelSource.value == 'custom') {
			return customModel.value.length > 0 ? customModel.value : '自定义'
		}
		const list = allModels.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id == currentModelId.value) {
				return list[i].name
			}
		}
		return '选择模型'
	})

	// 右侧菜单：未解锁专业版时**不显示**「自定义模型」。
	// 该页属专业版能力（门集合见 ADR 0009），必须与输入区的能力门同一口径 ——
	// 否则未解锁用户仍能从抽屉进入该页（本改动修的正是这条漏网路径）。
	// 用 computed 过滤而非改常量：常量仍描述「专业版全量菜单」，可见性由能力门决定。
	const rightMenuItems = computed<MenuItem[]>(() : MenuItem[] => {
		if (proUnlocked.value) {
			return RIGHT_MENU_ITEMS
		}
		return RIGHT_MENU_ITEMS.filter((m : MenuItem) => m.key != 'custom-models')
	})

	// 功能入口（从常量导入）
	const functionItems = FUNCTION_ITEMS
	const quickPrompts = QUICK_PROMPTS

	// 功能入口头部的收起态（#998）：默认展开、**不跨会话记忆**（维护者 2026-09-15 口径）。
	// 宫格已移出滚动容器 ⇒ 收起/展开只改头部自身高度，与滚动位置无关。
	const functionHeaderCollapsed = ref<boolean>(false)

	function toggleFunctionHeader() : void {
		functionHeaderCollapsed.value = !functionHeaderCollapsed.value
	}

	// 根容器高度（#998）：与 ai-settings.uvue 同款，给根节点一个确定高度；onLoad 里赋值。
	const pageHeight = ref<number>(0)

	// 档位横幅文案（两态单点；未解锁 = 兑换主曝光位，已解锁 = 只读状态）
	const proBannerTitle = computed<string>(() : string => {
		return proUnlocked.value ? '专业版 · 已解锁' : '解锁专业版'
	})
	const proBannerSub = computed<string>(() : string => {
		if (proUnlocked.value) {
			return '选模型 / 自定义模型 / 发图片 已全部可用'
		}
		return '选模型 / 自定义模型 / 发图片 · 积分兑换解锁'
	})
	const proBannerCta = computed<string>(() : string => {
		return proUnlocked.value ? '已解锁' : '查看权益'
	})

	// ===== 专项 scope 的诊断面（#2593：ai-feature 页并入本页）=====
	//
	// 取数、留白判定、四步状态机与组句全在 useDiagnosisGuide；本页只做三件事：渲染欢迎区、
	// 把选出来的句子写进输入框、把面板动作转给 composable。

	// 灌进输入框的草稿（引导面板「填入输入框」/ FAQ 快选）：页面级 ref，发送后清空。
	// 为什么不直接改 inputText —— 那是 composable 的内部状态，输入框的 :value 只在挂载时取一次。
	const draftText = ref<string>('')

	// 故障码体检（#2297）：状态 → 文案在纯函数 utils/diagnosisCodeHint.uts（只有 known / typo 可见）；
	// 防抖 / 过期丢弃 / 失败静默在 composable。查询函数由本页注入，便于行为用例注入假取数。
	const { view: codeHintView, onInput: onCodeHintInput, clear: clearCodeHint, dispose: disposeCodeHint } = useDiagnosisCodeHint((q : string) : Promise<DiagnosisCodeHint> => checkDiagnosisCodeApi(q))

	// 随问图片（#2299）：选图 / 逐张上传 / 托盘的状态全在 picker，本页只转发动作。
	// 顶层 ref 才能在模板里自动解包（嵌套在对象里不会），故三个值拆出来一份引用。
	const imagePicker = useAiImagePicker()
	const pickImages = imagePicker.images
	const pickUploading = imagePicker.uploadingCount
	const aiMaxImages = AI_MAX_IMAGES

	const {
		brands,
		faq,
		guideVisible,
		guideOpen,
		state: guideState,
		secondItems,
		faultItems,
		secondLoading,
		faultLoading,
		sentence,
		loadIntents: loadDiagnosisIntents,
		openGuide,
		openGuideWithBrand,
		closeGuide,
		pickBrand,
		pickSecond,
		pickFault,
		updateExtra,
		jumpStep,
	} = useDiagnosisGuide()

	/** 引导入口的胶囊文案：一眼看出当前选到哪一步 */
	const guideEntryLabel = computed<string>(() : string => {
		if (guideState.value.selection.faultName.length > 0) {
			return '引导选问题 · ' + guideState.value.selection.faultName
		}
		return guideOpen.value ? '收起引导' : '引导选问题'
	})

	/**
	 * 按键定位宫格项（fail-closed 的判据源）：清单是移动端手写，键集合与注册表由 parity 契约锁住。
	 * 声明在调用方之前 —— Kotlin 局部函数不支持前向引用（UTS error18）。
	 */
	function findFunctionItem(featureKey : string) : AIFunctionItem | null {
		for (let i = 0; i < FUNCTION_ITEMS.length; i++) {
			if (FUNCTION_ITEMS[i].featureKey == featureKey) {
				return FUNCTION_ITEMS[i]
			}
		}
		return null
	}

	/**
	 * 切 scope = 换区（ADR-0013 2026-11-16 修订**新增的不变式**）：必须重置当前会话与消息，
	 * 并按新 scope 重新列会话。只改 activeScope 而不重置 ⇒ 列表按新区刷新、屏幕上却还挂着上一区的
	 * 消息，学员会在「故障咨询」里看到通用对话的上下文。
	 * 等待中不许切：在跑的那一轮请求体已带旧键，切了会让回复落进错的区。
	 */
	function switchScope(key : string) : void {
		if (thinking.value) {
			uni.showToast({ title: '请等待当前回复完成', icon: 'none' })
			return
		}
		activeScope.value = key
		scopeResetSignal.value = scopeResetSignal.value + 1
		scopeMenuOpen.value = false
		showModelPicker.value = false
		currentSession.value = null
		messages.value = []
		inputText.value = ''
		draftText.value = ''
		clearCodeHint()
		imagePicker.clear()
		loadSessions()
		if (isDiagnosis.value) {
			loadDiagnosisIntents()
		}
	}

	/**
	 * chip 下拉选中：`''` = 回通用对话；其余必须命中清单（fail-closed）—— 未知键既不切换、
	 * 也不复活伪入口（ADR-0009 修订 ② 下线「故障代码查询」的口径：注册表里没有的键就是伪入口）。
	 */
	function onScopeSelect(key : string) : void {
		if (key.length > 0 && findFunctionItem(key) == null) {
			uni.showToast({ title: '功能入口不存在', icon: 'none' })
			return
		}
		if (key == activeScope.value) {
			scopeMenuOpen.value = false
			return
		}
		switchScope(key)
	}

	function toggleScopeMenu() : void {
		scopeMenuOpen.value = !scopeMenuOpen.value
	}

	/**
	 * 请求体：键**恒取本轮 scope**（空串 = 通用区，非空 = 该功能键的区）。
	 *
	 * 通用区与从前逐字一致：送用户自选模型的来源（model_source / config_id / user_model_id / custom_*）。
	 * 专项区**不送**任何模型字段：后端 ResolveChatSettings 的专项分支命中 featureChatKeys 后按管理端
	 * 单绑定解析模型，并**忽略**选择子里的模型来源（ai_config_service.go 原文「防绕过」）⇒ 送了也是死字段；
	 * 而 custom_api_key 是明文密钥，更不该发出去（维护者 2026-09-15 口径：#998）。故 scoped 分支在写模型
	 * 字段**之前**就 return。
	 */
	const buildBody : ChatBodyBuilder = (history : AiChatMessage[], sessionID : number, featureKey : string) : UTSJSONObject => {
		const params : UTSJSONObject = {
			session_id: sessionID,
			messages: history,
		}
		params['feature_key'] = featureKey
		if (featureKey.length > 0) {
			return params
		}
		params['model_source'] = currentModelSource.value
		if (currentModelSource.value == 'admin') {
			params['config_id'] = currentModelId.value
		} else if (currentModelSource.value == 'user') {
			params['user_model_id'] = currentModelId.value
		} else {
			params['custom_api_key'] = customApiKey.value.trim()
			params['custom_base_url'] = customBaseUrl.value.trim()
			params['custom_model'] = customModel.value.trim()
		}
		return params
	}

	/**
	 * 发送：第四参 = 当前 scope（空串 = 通用区，非空 = 该功能键的区）。
	 *
	 * 通用区保留两条模型前置校验（#1044 / #1062 的长期状态文案）；专项区跳过 —— 专项通道的模型
	 * 由管理端单绑定解析，本页在专项 scope 下也**不加载模型列表**（本页仍有列表，但专项区不消费它）。
	 * 有图无字也放行：判定与 sendInput 的早退同源（canSend 单一判据）。
	 */
	function onInputSend(text : string) : void {
		const scoped = activeScope.value.length > 0
		if (!scoped) {
			if (models.value.length == 0 && userModels.value.length == 0 && currentModelSource.value != 'custom') {
				// 平台模型为空是**长期状态**（#1044 裁定「通用对话接受不可用」）⇒ 这句是学员长期看到的文案，
				// 必须指向可执行动作（#1062）。先给对**所有**学员都可走的路径：自定义模型的入口与配置面
				// 都在专业版门内（未解锁时右侧菜单过滤掉 `custom-models`、设置页 user/custom 来源整行不渲染，#1024）
				// ⇒ 只写「去配置自定义模型」对未解锁学员是死路一条，那正是本句要防的回归。
				// 字数上限（①a 真机实测，2026-09-16，Redmi 23049RAD8C / b32d8398）：uni.showToast 的文本区是
				// **两行 × 18 字** —— 首版文案 37 字，末字「型」不渲染（OCR 三帧一致）⇒ 定稿压到 34 字。
				// 改这句时**必须数字数**，别超过 36（留余量），否则线上就是缺字的文案。
				uni.showToast({ title: '平台模型未配置，请联系管理员；专业版可在「对话设置」中配置自定义模型', icon: 'none' })
				return
			}
			if (currentModelSource.value == 'custom' && customModel.value.trim().length == 0) {
				uni.showToast({ title: '请先配置自定义模型', icon: 'none' })
				return
			}
		}
		const picked : string[] = isDiagnosis.value ? pickImages.value : []
		if (!canSend(text, picked.length)) return
		inputText.value = text
		// 发出去之后草稿作废：下一次发送不能把同一句再塞回输入框（否则点两次发送像卡住）
		draftText.value = ''
		// 发送后输入框清空 ⇒ 那一行体检结果必须一起消失（票面 AC：清空输入后提示消失）
		clearCodeHint()
		sendInput(scoped ? scopeTitle.value : currentModelName.value, buildBody, picked, activeScope.value)
		// 图已随本轮发出 ⇒ 待发托盘清空、名额归还
		if (picked.length > 0) {
			imagePicker.clear()
		}
	}

	function sendText(text : string) : void {
		inputText.value = text
		onInputSend(text)
	}

	// 消息操作
	function onCopyText(content : string) : void {
		uni.setClipboardData({ data: content, success: () => { uni.showToast({ title: '已复制', icon: 'success' }) } })
	}

	function onVoiceClick() : void {
		uni.showToast({ title: '语音输入开发中', icon: 'none' })
	}

	// 附件入口（📎）：只在诊断 scope 出现（:show-image-button 同源判据）；其余 scope 保持既有提示
	function onImageClick() : void {
		if (isDiagnosis.value) {
			imagePicker.onAddImage()
			return
		}
		uni.showToast({ title: '图片发送开发中', icon: 'none' })
	}

	function onRemoveImage(index : number) : void {
		imagePicker.onRemoveImage(index)
	}

	function onPreviewImage(index : number) : void {
		imagePicker.onPreviewImage(index)
	}

	function getLastUserMessage() : string {
		for (let i = messages.value.length - 1; i >= 0; i--) {
			if (messages.value[i].role == 'user') {
				return messages.value[i].content
			}
		}
		return ''
	}

	function onRetry() : void {
		const lastUserMsg = getLastUserMessage()
		if (lastUserMsg.length > 0) {
			inputText.value = lastUserMsg
			draftText.value = ''
			clearCodeHint()
			onInputSend(lastUserMsg)
		}
	}



	// 专业版横幅：未解锁 → 能力清单 + 所需积分 + 去兑换；已解锁 → 只读状态（同一个 sheet）
	function openProSheet() : void {
		showProSheet.value = true
	}

	// 模型芯片：未解锁时该芯片**不渲染**（`show-model-bar` 由 proUnlocked 决定），
	// 本分支是状态翻转竞态下的兜底 —— 走与横幅同一入口，不在页面另立第二套提示文案
	function onModelBarClick() : void {
		if (!proUnlocked.value) {
			showProSheet.value = true
			return
		}
		showModelPicker.value = true
	}

	// 兑换（服务端单管线）：成功 ⇒ 原地刷新门状态 —— 横幅转「已解锁」，输入区出现模型芯片与附件按钮
	async function onRedeemAiPro() : Promise<void> {
		const res = await redeemAiPro()
		if (res.ok) {
			showProSheet.value = false
			uni.showToast({ title: res.message, icon: 'success' })
			await loadAiProState()
			return
		}
		// 失败不静默（验收标准第 4 条）：request 层已按服务端文案提示，此处兜底一次可读文案
		uni.showToast({ title: res.message.length > 0 ? res.message : '兑换失败，请稍后再试', icon: 'none' })
	}

	// 积分不足 → 去任务中心赚积分；回页时 onShow 重读门状态
	function onGoEarnPoints() : void {
		showProSheet.value = false
		uni.navigateTo({ url: '/pages/points/task-center' })
	}

	// 会话操作
	function onNewChat() : void {
		startNewChat()
		sidebarLeft.value = false
	}

	function onSelectSession(s : AiSession) : void {
		loadSession(s)
	}

	// 右侧菜单操作
	function onMenuAction(key : string) : void {
		sidebarRight.value = false
		if (key == 'new-chat') {
			startNewChat()
		} else if (key == 'settings') {
			uni.navigateTo({ url: '/pages/ai-assistant/ai-settings' })
		} else if (key == 'custom-models') {
			uni.navigateTo({ url: '/pages/ai-assistant/custom-models' })
		} else if (key == 'profile') {
			uni.switchTab({ url: '/pages/profile/profile' })
		}
	}

	// 宫格点击 = **在本页切 scope**（ADR-0009 2026-11-16 修订 ②）：不再推入专项页。
	// 专项页 pages/ai-assistant/ai-feature 已随本票退役（并入本页的一个 scope），全仓不再有跳转点。
	function onFunctionClick(item : AIFunctionItem) : void {
		switchScope(item.featureKey)
	}

	/**
	 * 输入框每敲一下都进来（诊断 scope 唯一的「正在输入」信号）。
	 * ① 非诊断 scope 一次体检查询都不发（codeHintView 恒不可见）；
	 * ② 顺带把输入镜像进 draftText：输入框由外部草稿驱动，若页面不跟着走，学员删光后再点
	 *    **同一条**提示时 draftText 没有变化 ⇒ 组件里那个 watch 不触发 ⇒ 输入框不回填。
	 */
	function onDraftInput(value : string) : void {
		draftText.value = value
		if (!isDiagnosis.value) return
		onCodeHintInput(value)
	}

	/** 点体检提示行：追问句**替换**输入框内容（不自动发送，学员可改），随后收掉这一行 */
	function onCodeHintTap() : void {
		const followUp = codeHintView.value.followUp
		if (followUp.length == 0) return
		draftText.value = followUp
		clearCodeHint()
	}

	/** 欢迎区点品牌卡：带品牌预选进面板，直接落到第二层 */
	function onPickBrandCard(brandId : string) : void {
		openGuideWithBrand(brandId)
	}

	/** 欢迎区点常见问题：直接填进输入框（FAQ 是现成的一句话，不经引导面） */
	function onPickFaq(question : string) : void {
		draftText.value = question
		// 换了一句话，上一句的体检结果不再是「当前这句」的说明
		clearCodeHint()
	}

	/**
	 * 引导面板「填入输入框」：组好的句子交给输入框，**不自动发送**（票面判据：可编辑后再发送）。
	 * 组句模板的补充说明（故障码 / 时机 / 异响位置）由学员自己写，那是唯一能补回命中率的手段。
	 */
	function onConfirmSentence(text : string) : void {
		draftText.value = text
		clearCodeHint()
		closeGuide()
	}

	// 持久化设置：三 source 归一化规则单源在 composables/useAiModelSelection.uts（#1732）
	function persistSettings() : void {
		const custom = emptyAiCustomModelInput()
		custom.name = customModel.value
		custom.model = customModel.value
		custom.base_url = customBaseUrl.value
		custom.api_key = customApiKey.value
		saveAiChatSettings(normalizeAiChatSettings(
			currentModelSource.value,
			currentModelId.value,
			models.value,
			userModels.value,
			custom,
			loadAiChatSettings(),
		))
	}

	// 模型选择
	function selectModel(m : AIModelOption) : void {
		currentModelId.value = m.id
		let isUser = false
		for (let i = 0; i < userModels.value.length; i++) {
			if (userModels.value[i].id == m.id) {
				isUser = true
				break
			}
		}
		currentModelSource.value = isUser ? 'user' : 'admin'
		showModelPicker.value = false
		persistSettings()
	}

	function selectUserModelById(id : number, name : string) : void {
		for (let i = 0; i < userModels.value.length; i++) {
			if (userModels.value[i].id == id) {
				currentModelId.value = id
				currentModelSource.value = 'user'
				showModelPicker.value = false
				uni.showToast({ title: '已切换：' + name, icon: 'none' })
				persistSettings()
				return
			}
		}
		currentModelId.value = id
		currentModelSource.value = 'user'
		showModelPicker.value = false
		persistSettings()
	}

	// 「管理自定义模型」（#1024 ③）：未解锁时**到不了** custom-models —— 与模型芯片点击
	// （onModelBarClick）走同一入口：关掉选择器、开本页档位 sheet，不静默失败、不留第二套文案。
	function goManageModels() : void {
		showModelPicker.value = false
		if (!proUnlocked.value) {
			showProSheet.value = true
			return
		}
		uni.navigateTo({ url: '/pages/ai-assistant/custom-models' })
	}

	// 自定义 API Key
	// 「自定义 API Key」（#1024 ④）：自带 key 的**配置面**（与设置页 ① 同一能力），同一门同一入口。
	function onCustomClick() : void {
		showModelPicker.value = false
		if (!proUnlocked.value) {
			showProSheet.value = true
			return
		}
		showCustomForm.value = true
	}

	function closeCustomForm() : void {
		showCustomForm.value = false
	}

	function onCustomModelUpdate(value : string) : void {
		customModel.value = value
	}

	function onCustomBaseUrlUpdate(value : string) : void {
		customBaseUrl.value = value
	}

	function onCustomApiKeyUpdate(value : string) : void {
		customApiKey.value = value
	}

	function confirmCustomModel() : void {
		customModel.value = customModel.value.trim()
		customBaseUrl.value = customBaseUrl.value.trim()
		customApiKey.value = customApiKey.value.trim()
		currentModelSource.value = 'custom'
		currentModelId.value = 0
		showCustomForm.value = false
		showModelPicker.value = false
		persistSettings()
	}

	// 水合 & 持久化
	function hydrateFromSettings() : void {
		const saved = loadAiChatSettings()
		const src = saved.model_source
		if (src == 'user') {
			for (let i = 0; i < userModels.value.length; i++) {
				if (userModels.value[i].id == saved.model_id) {
					currentModelId.value = saved.model_id
					currentModelSource.value = 'user'
					return
				}
			}
		} else if (src == 'custom') {
			if (saved.base_url.length > 0 && saved.model.length > 0 && saved.api_key.length > 0) {
				customModel.value = saved.model
				customBaseUrl.value = saved.base_url
				customApiKey.value = saved.api_key
				currentModelSource.value = 'custom'
				currentModelId.value = 0
				return
			}
		} else if (src == 'admin') {
			for (let i = 0; i < models.value.length; i++) {
				if (models.value[i].id == saved.model_id) {
					currentModelId.value = saved.model_id
					currentModelSource.value = 'admin'
					return
				}
			}
		}
		if (models.value.length > 0 && currentModelId.value == 0) {
			currentModelId.value = models.value[0].id
		}
		currentModelSource.value = 'admin'
	}

	/**
	 * 存量回收（#1024）：「自带 key 的来源」（user / custom）是**本地持久态**，而且它是
	 * `buildBody` 真正送上去的东西（user ⇒ `user_model_id`；custom ⇒ 明文 `custom_api_key`）。
	 * 只关「入口」的话，未解锁用户**存量**选中的来源仍在生效 ⇒ 未解锁时强制回收为「平台模型」
	 * 并落盘（与设置页同一口径）。
	 *
	 * 两个前置条件都是异步、先后不定（门状态 / 模型列表）⇒ 各自就绪时都试一次；`proStateSettled`
	 * 保证「未解锁」是**已知结论**而不是初始值 —— `proUnlocked` 初值 false 只是 fail-closed 的
	 * 起点，若在扫描回包前就回收，会把**已解锁用户**的来源误清。
	 */
	const proStateSettled = ref<boolean>(false)
	const modelsHydrated = ref<boolean>(false)

	function tryReclaimLockedSource() : void {
		if (!proStateSettled.value || !modelsHydrated.value) return
		if (proUnlocked.value) return
		const src = currentModelSource.value
		if (src != 'user' && src != 'custom') return
		currentModelSource.value = 'admin'
		currentModelId.value = models.value.length > 0 ? models.value[0].id : 0
		customModel.value = ''
		customBaseUrl.value = ''
		customApiKey.value = ''
		showCustomForm.value = false
		showModelPicker.value = false
		persistSettings()
	}

	/**
	 * 「刚在自定义模型页新增并选用」的信号（本地键）—— **唯一的消费点**：未解锁时不应用
	 * （自带 key 的来源不许带进来），键一律消费掉。门状态未知时不消费（不拿 fail-closed 的
	 * 初值去猜），留给门读完之后的那次调用（`refreshProState`）。
	 * 声明在 `refreshProState` 之前：Kotlin 局部函数不支持前向引用（UTS error18）。
	 */
	function applyPendingSelectedUserModel() : void {
		if (!proStateSettled.value) return
		const selectedRaw = uni.getStorageSync(STORAGE_KEY_AI_SELECTED_USER_MODEL) as string
		if (selectedRaw.length == 0) return
		uni.removeStorageSync(STORAGE_KEY_AI_SELECTED_USER_MODEL)
		if (!proUnlocked.value) return
		try {
			const sel = JSON.parse(selectedRaw) as UTSJSONObject
			const id = parseFloat(`${sel['id']}`)
			const name = `${sel['name'] ?? ''}`
			selectUserModelById(id, name)
		} catch (e) {
			console.error('[ai-assistant] apply selected model failed:', e)
		}
	}

	async function refreshProState() : Promise<void> {
		await loadAiProState()
		proStateSettled.value = true
		tryReclaimLockedSource()
		applyPendingSelectedUserModel()
	}

	// 数据加载
	async function loadModels() : Promise<void> {
		try {
			models.value = await getAiModelsApi()
		} catch (e) {
			console.error('loadModels failed:', e)
			models.value = [] as AiModel[]
		}
		if (auth.isLoggedIn.value) {
			try {
				userModels.value = await getAiUserModelsApi()
			} catch (e) {
				console.error('loadUserModels failed:', e)
				userModels.value = [] as AiUserModel[]
			}
		}
		hydrateFromSettings()
		modelsHydrated.value = true
		tryReclaimLockedSource()
	}

	// 生命周期
	onLoad((options : OnLoadOptions) => {
		const sysInfo = uni.getSystemInfoSync()
		statusBarHeight.value = sysInfo.statusBarHeight
		// 根容器高度（#998）：与 ai-settings.uvue 同款
		pageHeight.value = sysInfo.windowHeight

		auth.restoreFromStorage()
		if (!auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}



		loadModels()
		loadSessions()
		// 门状态与模型/会话并行读（失败 fail-closed 为未解锁，不阻塞首屏）；读完顺带做存量回收
		refreshProState()
	})

	onShow(() => {
		if (auth.isLoggedIn.value) {
			loadSessions()
		}
		hydrateFromSettings()
		// 已解锁为**粘性**：权益一次兑换永久持有（user_entitlement 无过期列），
		// 不为同一事实在每次回页重复扫流水；未解锁时重读 —— 用户可能刚在任务中心兑换或赚到积分
		if (!proUnlocked.value) {
			refreshProState()
		} else {
			proStateSettled.value = true
		}

		// 「刚在自定义模型页新增并选用」的信号：门状态未知时它自己会留着（不消费），
		// 由门读完之后的那次调用（refreshProState → applyPendingSelectedUserModel）消费。
		applyPendingSelectedUserModel()
	})
	/**
	 * 页面卸载：停等待态计时器 / 收屏息 / 取消还没到点的体检计时器
	 * （uni-app x 没有 onUnmounted，页面卸载钩子是 onUnload）。
	 */
	onUnload(() : void => {
		stopThinkingTimer()
		restoreScreenOn()
		disposeCodeHint()
	})
</script>

<style lang="scss">
	.ai-page {
		flex: 1;
		display: flex;
		flex-direction: column;
		/* #2520：原型 307:6954 页底为**上蓝下浅灰的竖向渐变**（此前是平色 #dfeffb）。
		   色值走 token（§1.2 / §1.6 裸 hex 机检）；语法口径见 gradientSyntaxContract（#937）：
		   只写 to 关键字 + 恰好两色、无百分比；实色兜底必须写在 background 简写**之后**。 */
		position: relative;
		background: linear-gradient(to bottom, $gradient-start, $gradient-end);
		background-color: $gradient-end;
	}

	.main {
		flex: 1;
	}

	.pro-scroll {
		flex: 1;
		/* #998：必须 height:0 + flex:1（同 ai-settings.uvue 的 .content-scroll）——只给 flex:1 时
		   滚动容器会长到内容高度（实测背景区域 846rpx > 窗口 771），没有可滚动余量 ⇒ 手势滚不动；
		   而 scroll-into-view 仍会视觉上跳到底部，所以看起来「能滚」。 */
		height: 0;
		padding: 24rpx;
	}

	.function-grid {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 24rpx;
	}

	/* #2520：原型为 4 格收口（第 5 格已下线）；格宽随格数放大，图标与标题间距按原型收紧 */
	.function-item {
		align-items: center;
		width: 23%;
	}

	.function-icon-box {
		width: 84rpx;
		height: 84rpx;
		align-items: center;
		justify-content: center;
		margin-bottom: 10rpx;
	}

	.function-icon-img {
		width: 84rpx;
		height: 84rpx;
	}

	.function-icon-emoji {
		font-size: 68rpx;
	}

	/* 限免小签（`freePreview` 的可见面）：暖色轴与本页「解锁专业版」横幅同一色意（权益/优惠），
	   绿轴在本页已被「已解锁」占用 —— 两态也不该撞色。底/边/字三色直接沿用横幅那三个值
	   （$warning-tint #fff3e0 / #ffd9a8 / #8a4b00），学员不必学第二套橙色语义。
	   形态取「浅底 + 细边 + 小字」而非实色反白：它挂在标题旁属于**标注**，
	   实色胶囊在宫格里视觉重量等同按钮，会把图标压下去。 */
	/*
	 * 位置：标题**下方独立一行**，不再压图标右上角（2026-10-27 B 版裁定）。两条硬理由：
	 *   ① 压在图标上会与本格橙黄图标同色系黏成一团（② 首帧实测，加白描边也只能勉强分开）；
	 *   ② 与标题同行放不下 —— 4 列格宽 23% ≈ 86px（750 设计宽 ÷ 2），「智能维修诊断」6 字
	 *      @24rpx ≈ 72px，同行只剩 14px，「限免」两个汉字（≈24px）必然把标题挤成两行
	 *      （原型实测「智能维修诊 / 断」）。这条是纯尺寸推论，换机型不会变。
	 * 代价如实记：该格比邻格高 ≈ 32rpx，宫格整行高度随最高格走；四格图标仍同基线
	 * （各格内容自顶排列，行高由最高格决定，矮格不会被拉伸居中）。
	 */
	.function-free-badge {
		margin-top: 6rpx;
		height: 26rpx;
		padding: 0 8rpx;
		align-items: center;
		justify-content: center;
		background-color: $warning-tint;
		border: 1rpx solid #ffd9a8;
		border-radius: $radius-pill;
	}

	.function-free-badge-text {
		font-size: $font-size-xs;
		line-height: $font-size-xs;
		font-weight: bold;
		color: #8a4b00;
	}

	.function-title {
		/* #2520：原型功能名 ≈12px CSS（24rpx）；4 格后格宽 ≈86px，6 字标题仍单行 */
		font-size: 24rpx;
		color: #333333;
		text-align: center;
		/* 单行收敛：格宽只够 6 字（86px ≈ 7 字 @24rpx），限免小签再占一行后
		   任何意外换行都会让四格标题基线错开 */
		lines: 1;
	}

	.prompt-list {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	/* #2520：推荐问题卡按原型放宽（卡高 ≈ 100rpx、圆角 20rpx、行距 20rpx） */
	.prompt-card {
		background-color: #ffffff;
		border-radius: $radius-card;
		padding: 32rpx 28rpx;
		margin-bottom: 20rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.prompt-text {
		flex: 1;
		font-size: 28rpx;
		color: #333333;
	}

	.prompt-arrow {
		width: 32rpx;
		flex-shrink: 0;
		font-size: 36rpx;
		line-height: 40rpx;
		text-align: center;
		color: #999999;
		margin-left: 16rpx;
	}

	/* #2520：模型下拉的透明收起层（页面层锚定整页，见模板注释） */
	.model-mask {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 200;
		/* 近乎透明的实色：原型无遮罩压暗，但完全 transparent 的层在部分端上不参与命中 */
		background-color: rgba(0, 0, 0, 0.02);
	}

	.chat-area {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.message-row {
		flex-direction: row;
		margin-bottom: 20rpx;
	}

	.message-row.assistant {
		justify-content: flex-start;
	}

	.message-bubble {
		max-width: 600rpx;
		padding: 20rpx 24rpx;
		border-radius: 16rpx;
		background-color: #ffffff;
	}

	.message-bubble.thinking {
		background-color: #f0f0f0;
	}

	.message-text {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}
	/* 专业版档位横幅（#920）：**实色**配色（按设计；#937 已证伪「本机型不绘制渐变」）；未解锁=橙、已解锁=绿 */
	.pro-banner {
		flex-direction: row;
		align-items: center;
		background-color: #fff3e0;
		border: 1rpx solid #ffd9a8;
		border-radius: 16rpx;
		padding: 20rpx 24rpx;
		margin-bottom: 24rpx;
	}

	/* 已解锁：末尾追加覆盖（特异性天然更高，无需 !important，遵守 R4「变体一律追加覆盖」） */
	.pro-banner.pro-banner-unlocked {
		background-color: #e8f8ee;
		border-color: #b6e3c7;
	}

	.pro-banner-title {
		font-size: 28rpx;
		font-weight: bold;
		color: #8a4b00;
	}

	.pro-title-unlocked {
		color: #1c6b3c;
	}

	.pro-banner-sub {
		flex: 1;
		font-size: 22rpx;
		color: #a97142;
		margin-left: 16rpx;
	}

	.pro-sub-unlocked {
		color: #4a8f68;
	}

	.pro-banner-go {
		font-size: 24rpx;
		color: #ffffff;
		background-color: #ff9800;
		border-radius: 24rpx;
		padding: 8rpx 20rpx;
	}

	.pro-go-unlocked {
		background-color: #2e9e5b;
	}

	/* 功能入口头部（#998）：宫格**移出滚动容器**后的容器，故本块只需处理外观与收起态，
	   不含任何 `position` 定位 —— 「滑动不丢失」由**结构**保证（它在 scroll-view 之外），
	   这正是刻意不选 `position: sticky` 的原因（本项目 0 处先例、uvue 支持无文档）。
	   水平 padding 与 `.pro-scroll` 的 24rpx 对齐，使宫格左右位置与改动前一致。 */
	.func-head {
		/* #2520：不再自带平色底 —— 让页根渐变透上来（原型功能格区与页底同一条渐变） */
		background-color: transparent;
		padding-left: 24rpx;
		padding-right: 24rpx;
	}

	.func-head-handle {
		height: 44rpx;
		align-items: center;
		justify-content: center;
	}

	.func-head-arrow {
		width: 32rpx;
		flex-shrink: 0;
		font-size: 24rpx;
		line-height: 28rpx;
		text-align: center;
		color: #8aa9c0;
	}

	/* ===== scope chip（#2593）：专项 scope 下宫格收起为「当前区 ⌄」 ===== */
	.scope-bar {
		flex-direction: row;
		align-items: center;
		padding-top: 8rpx;
		padding-bottom: 12rpx;
	}

	.scope-chip {
		flex-direction: row;
		align-items: center;
		background-color: #ffffff;
		border: 1rpx solid $border-color-light;
		border-radius: $radius-pill;
		padding: 10rpx 22rpx;
	}

	.scope-chip-text {
		font-size: 26rpx;
		color: $text-color;
	}

	.scope-chip-arrow {
		width: 32rpx;
		flex-shrink: 0;
		font-size: 22rpx;
		line-height: 26rpx;
		text-align: center;
		color: $text-color-placeholder;
		margin-left: 10rpx;
	}

	.scope-menu {
		flex-direction: column;
		background-color: #ffffff;
		border: 1rpx solid $border-color-light;
		border-radius: $radius-md;
		margin-bottom: 16rpx;
		padding-top: 6rpx;
		padding-bottom: 6rpx;
	}

	.scope-menu-item {
		padding: 20rpx 24rpx;
	}

	.scope-menu-text {
		font-size: 26rpx;
		color: $text-color;
	}

	/* ===== 诊断空态欢迎区（#2296，随 scope 并入 #2593）===== */
	.welcome-area {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.welcome-brand-row {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.welcome-brand {
		flex-direction: column;
		border-width: 1rpx;
		border-style: solid;
		border-color: $border-color;
		border-radius: $radius-lg;
		padding: 20rpx;
		margin-right: 16rpx;
		margin-bottom: 16rpx;
		background-color: $card-bg;
		min-width: 300rpx;
	}

	.welcome-brand-icon {
		font-size: 40rpx;
	}

	.welcome-brand-name {
		font-size: 28rpx;
		font-weight: bold;
		color: $text-color;
		margin-top: 8rpx;
	}

	.welcome-brand-tagline {
		font-size: 22rpx;
		color: $text-color-placeholder;
		margin-top: 4rpx;
	}

	.welcome-faq {
		flex-direction: column;
		margin-top: 8rpx;
	}

	.welcome-faq-title {
		font-size: 24rpx;
		color: $text-color-placeholder;
		margin-bottom: 8rpx;
	}

	.welcome-faq-row {
		border-width: 1rpx;
		border-style: solid;
		border-color: $border-color-light;
		border-radius: $radius-md;
		padding: 16rpx 20rpx;
		margin-bottom: 12rpx;
		background-color: $card-bg;
	}

	.welcome-faq-q {
		font-size: 26rpx;
		color: $text-color-secondary;
	}

	/* ===== 引导入口 / 故障码体检行（#2296 / #2297）===== */
	.guide-entry {
		align-items: flex-start;
		padding-left: 24rpx;
		padding-right: 24rpx;
		padding-top: 8rpx;
		padding-bottom: 8rpx;
	}

	.guide-entry-text {
		font-size: 24rpx;
		color: $uni-color-primary;
	}

	.code-hint {
		flex-direction: row;
		align-items: center;
		padding: 12rpx 28rpx;
	}

	/* 文字样式落 <text>（落 <view> 上原生端静默忽略并逐处打 error，见 uvueFontCarrierContract） */
	.code-hint-text {
		flex: 1;
		font-size: 24rpx;
		line-height: 1.5;
		color: $text-color-secondary;
	}

	/* typo 是「你填得不对」，用警示色；known 才用次级文字色 */
	.code-hint-text-warn {
		color: $warning-color;
	}

	.code-hint-action {
		font-size: 24rpx;
		color: $uni-color-primary;
		margin-left: 12rpx;
	}
</style>
