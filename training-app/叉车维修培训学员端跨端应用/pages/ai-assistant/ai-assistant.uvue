<template>
	<view class="container" :style="{ height: windowHeight + 'px' }">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

		<!-- 顶栏：按 Figma 设计稿 76/77 -->
		<view class="header">
			<view class="header-left" @click="onOpenHistory">
				<text class="header-icon">☰</text>
			</view>
			<view class="header-center">
				<view class="version-tabs">
					<text class="version-tab" :class="{ active: version == 'basic' }" @click="switchVersion('basic')">基础版</text>
					<text class="version-tab" :class="{ active: version == 'pro' }" @click="switchVersion('pro')">专业版</text>
				</view>
				<text class="header-title">维修助手</text>
			</view>
			<view class="header-right" @click="onOpenMenu">
				<text class="header-icon">☰</text>
			</view>
		</view>

		<!-- 基础版：新对话 + 最近对话 -->
		<template v-if="version == 'basic'">
			<scroll-view class="basic-scroll" scroll-y="true">
				<view class="basic-panel">
					<view class="new-chat-card" @click="onNewChatFromBasic">
						<text class="new-chat-icon">✉</text>
						<text class="new-chat-text">新对话</text>
					</view>

					<view class="section-card">
						<view class="section-header" @click="recentExpanded = !recentExpanded">
							<view class="section-header-left">
								<text class="section-icon">✉</text>
								<text class="section-title">最近对话</text>
							</view>
							<text class="section-arrow" :class="{ up: recentExpanded }">▼</text>
						</view>
						<view v-if="recentExpanded" class="section-body">
							<view v-if="sessions.length == 0" class="empty-tip">暂无历史对话</view>
							<view v-for="(s, idx) in sessions" :key="idx" class="session-row" @click="onSelectSession(s.id)">
								<text class="session-row-title">{{ s.title }}</text>
								<text class="session-row-del" @click.stop="onDeleteSession(s.id)">×</text>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
		</template>

		<!-- 专业版 -->
		<template v-else>
			<scroll-view class="chat-scroll" scroll-y="true" :scroll-into-view="scrollIntoView" :scroll-with-animation="true">
				<!-- 功能快捷入口 -->
				<view class="function-grid">
					<view v-for="(item, idx) in functionItems" :key="idx" class="function-item" @click="onFunctionClick(item)">
						<view class="function-icon-box">
							<text class="function-icon">{{ item.icon }}</text>
						</view>
						<text class="function-title">{{ item.title }}</text>
					</view>
				</view>

				<!-- 快捷提示语 -->
				<view class="prompt-list">
					<view v-for="(s, idx) in suggestions" :key="idx" class="prompt-card" @click="onSuggest(s)">
						<text class="prompt-text">{{ s }}</text>
						<text class="prompt-arrow">›</text>
					</view>
				</view>

				<!-- 消息列表 -->
				<view class="msg-list">
					<view v-for="(msg, idx) in messages" :key="idx" :id="'msg-' + idx"
						:class="['msg-row', msg.role == 'user' ? 'msg-row-user' : 'msg-row-ai']">
						<view v-if="msg.role != 'user'" class="msg-avatar ai-avatar">
							<text class="msg-avatar-text">AI</text>
						</view>
						<view :class="['msg-bubble', msg.role == 'user' ? 'bubble-user' : 'bubble-ai']">
							<text class="msg-content">{{ msg.content.length > 0 ? msg.content : (sending && idx == messages.length - 1 ? '思考中...' : '') }}</text>
						</view>
					</view>
				</view>
				<view id="msg-bottom" class="scroll-anchor"></view>
			</scroll-view>

			<!-- 输入区 -->
			<view class="input-area">
				<view class="model-bar">
					<view class="model-selector" @click="onOpenSettings">
						<text class="model-icon">★</text>
						<text class="model-name">{{ currentModelName }}</text>
						<text class="model-arrow">▼</text>
					</view>
					<view class="deep-thinking" :class="{ active: deepThinking }" @click="deepThinking = !deepThinking">
						<text class="dt-text">深度思考</text>
					</view>
				</view>
				<view class="input-row">
					<text class="tool-icon" @click="onAttach">📎</text>
					<input class="chat-input" type="text" :value="inputText" :disabled="sending"
						placeholder="提出你想要知道的问题" :maxlength="2000" confirm-type="send"
						@input="onInput" @confirm="onSend" />
					<text class="tool-icon" @click="onVoice">🎤</text>
					<view :class="['send-btn', canSend ? 'send-btn-active' : '']" @click="onSend">
						<text class="send-btn-text">➤</text>
					</view>
				</view>
			</view>
		</template>

		<tab-bar :active-index="2"></tab-bar>

		<!-- 历史会话抽屉 -->
		<view v-if="showHistory" class="drawer-mask" @click="onCloseHistory"></view>
		<view :class="['drawer', 'drawer-left', showHistory ? 'drawer-open' : '']">
			<view class="drawer-header">
				<text class="drawer-title">历史会话</text>
				<view class="drawer-new" @click="onNewChat">
					<text class="drawer-new-text">+ 新对话</text>
				</view>
			</view>
			<scroll-view class="drawer-scroll" scroll-y="true">
				<view v-if="sessions.length == 0" class="drawer-empty">
					<text class="drawer-empty-text">暂无历史会话</text>
				</view>
				<view v-for="(s, idx) in sessions" :key="idx" class="session-item"
					:class="{ 'session-active': s.id == sessionId }" @click="onSelectSession(s.id)">
					<view class="session-main">
						<text class="session-title">{{ s.title }}</text>
						<text class="session-time">{{ formatTime(s.updated_at.length > 0 ? s.updated_at : s.created_at) }}</text>
					</view>
					<text class="session-del" @click.stop="onDeleteSession(s.id)">删除</text>
				</view>
			</scroll-view>
		</view>

		<!-- 右侧菜单抽屉 -->
		<view v-if="showMenu" class="drawer-mask" @click="onCloseMenu"></view>
		<view :class="['drawer', 'drawer-right', showMenu ? 'drawer-open' : '']">
			<view class="drawer-header">
				<text class="drawer-title">功能菜单</text>
				<text class="drawer-close" @click="onCloseMenu">×</text>
			</view>
			<scroll-view class="drawer-scroll" scroll-y="true">
				<view class="menu-item" @click="onMenuNewChat">
					<text class="menu-item-text">新对话</text>
				</view>
				<view class="menu-item" @click="onMenuSwitchVersion">
					<text class="menu-item-text">{{ version == 'basic' ? '切换到专业版' : '切换到基础版' }}</text>
				</view>
				<view class="menu-item" @click="onMenuSettings">
					<text class="menu-item-text">对话设置</text>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import { useStatusBarHeight } from '../../utils/system'
	import {
		chatAiApi,
		loadAiChatSettings,
		getAiSessionsApi,
		createAiSessionApi,
		deleteAiSessionApi,
		getAiSessionMessagesApi,
		getAiModelsApi,
	} from '../../api/aiAssistant'
	import type { AiChatMessage, AiSession, AiChatSettings, AiModel } from '../../types/index'

	const statusBarHeight = useStatusBarHeight()
	const windowHeight = uni.getSystemInfoSync().windowHeight

	const messages = ref<AiChatMessage[]>([])
	const inputText = ref<string>('')
	const sending = ref<boolean>(false)
	const canSend = ref<boolean>(false)
	const scrollIntoView = ref<string>('')
	const sessionId = ref<number>(0)
	const settings = ref<AiChatSettings>(loadAiChatSettings())

	const showHistory = ref<boolean>(false)
	const showMenu = ref<boolean>(false)
	const sessions = ref<AiSession[]>([])

	// 按设计稿新增：版本、深度思考、最近对话展开、平台模型
	const version = ref<'basic' | 'pro'>('pro')
	const deepThinking = ref<boolean>(false)
	const recentExpanded = ref<boolean>(true)
	const platformModels = ref<AiModel[]>([])

	const currentModelName = computed<string>(() : string => {
		if (settings.value.model_source == 'custom') {
			return settings.value.model_name.length > 0 ? settings.value.model_name : '自定义模型'
		}
		return settings.value.model_name.length > 0 ? settings.value.model_name : '选择模型'
	})

	const suggestions : string[] = [
		'如何高效阅读书籍？',
		'帮我写近期的学习汇报',
		'总结这个章节的主要内容',
	]

	type FunctionItem = {
		key : string
		title : string
		icon : string
		prompt : string
	}

	const functionItems : FunctionItem[] = [
		{ key: 'fault-code', title: '故障代码查询', icon: '🔧', prompt: '帮我查询叉车故障代码含义' },
		{ key: 'drawing', title: '图纸识别', icon: '📐', prompt: '请识别这张叉车图纸' },
		{ key: 'exercise', title: '习题解答', icon: '📝', prompt: '请解答这道叉车维修题目' },
		{ key: 'knowledge', title: '维保知识', icon: '📚', prompt: '请介绍叉车维保相关知识' },
	]

	function onInput(e : InputEvent) : void {
		inputText.value = e.detail.value
		canSend.value = inputText.value.trim().length > 0 && !sending.value
	}

	function scrollToBottom() : void {
		scrollIntoView.value = ''
		setTimeout(() => {
			scrollIntoView.value = 'msg-bottom'
		}, 50)
	}

	function onSuggest(text : string) : void {
		inputText.value = text
		canSend.value = true
		onSend()
	}

	function switchVersion(v : 'basic' | 'pro') : void {
		version.value = v
	}

	function onFunctionClick(item : FunctionItem) : void {
		if (item.key == 'drawing') {
			onAttach(item.prompt)
			return
		}
		onSuggest(item.prompt)
	}

	async function ensureSession() : Promise<void> {
		if (sessionId.value > 0) return
		try {
			const s = await createAiSessionApi('新对话')
			sessionId.value = s.id
		} catch (e) {
			console.warn('[ai] create session failed:', e)
		}
	}

	async function onSend() : Promise<void> {
		const text = inputText.value.trim()
		if (text.length == 0 || sending.value) return

		const userMsg : AiChatMessage = { role: 'user', content: text }
		messages.value = messages.value.concat([userMsg])
		inputText.value = ''
		canSend.value = false
		sending.value = true
		scrollToBottom()

		const aiMsg : AiChatMessage = { role: 'assistant', content: '' }
		messages.value = messages.value.concat([aiMsg])
		scrollToBottom()

		try {
			await ensureSession()
			const history : AiChatMessage[] = []
			for (let i = 0; i < messages.value.length; i++) {
				const m = messages.value[i]
				if (m.role == 'assistant' && m.content.length == 0) continue
				history.push({ role: m.role, content: m.content })
			}
			if (history.length == 0 || history[history.length - 1].role != 'user') {
				history.push(userMsg)
			}

			const reply = await chatAiApi(history, settings.value, sessionId.value)
			const updated : AiChatMessage[] = []
			for (let i = 0; i < messages.value.length; i++) {
				if (i == messages.value.length - 1 && messages.value[i].role == 'assistant') {
					updated.push({ role: 'assistant', content: reply })
				} else {
					updated.push(messages.value[i])
				}
			}
			messages.value = updated
		} catch (e) {
			let msg = '对话失败，请稍后重试'
			if (e instanceof Error) {
				const m = (e as Error).message
				if (m != null && m.length > 0) msg = m
			}
			const updated : AiChatMessage[] = []
			for (let i = 0; i < messages.value.length; i++) {
				if (i == messages.value.length - 1 && messages.value[i].role == 'assistant') {
					updated.push({ role: 'assistant', content: '⚠️ ' + msg })
				} else {
					updated.push(messages.value[i])
				}
			}
			messages.value = updated
			uni.showToast({ title: msg.length > 20 ? msg.substring(0, 20) + '...' : msg, icon: 'none' })
		} finally {
			sending.value = false
			canSend.value = inputText.value.trim().length > 0
			scrollToBottom()
		}
	}

	function onOpenSettings() : void {
		uni.navigateTo({ url: '/pages/ai-assistant/ai-settings' })
	}

	function onCloseHistory() : void {
		showHistory.value = false
	}

	async function onOpenHistory() : Promise<void> {
		showHistory.value = true
		try {
			sessions.value = await getAiSessionsApi()
		} catch (e) {
			console.warn('[ai] load sessions failed:', e)
			sessions.value = [] as AiSession[]
		}
	}

	function onOpenMenu() : void {
		showMenu.value = true
	}

	function onCloseMenu() : void {
		showMenu.value = false
	}

	function onNewChat() : void {
		sessionId.value = 0
		messages.value = [] as AiChatMessage[]
		showHistory.value = false
	}

	function onNewChatFromBasic() : void {
		onNewChat()
		version.value = 'pro'
	}

	function onMenuNewChat() : void {
		onNewChat()
		showMenu.value = false
	}

	function onMenuSwitchVersion() : void {
		version.value = version.value == 'basic' ? 'pro' : 'basic'
		showMenu.value = false
	}

	function onMenuSettings() : void {
		showMenu.value = false
		onOpenSettings()
	}

	async function onSelectSession(id : number) : Promise<void> {
		if (id <= 0) return
		sessionId.value = id
		showHistory.value = false
		uni.showLoading({ title: '加载中...', mask: true })
		try {
			const list = await getAiSessionMessagesApi(id)
			const msgs : AiChatMessage[] = []
			for (let i = 0; i < list.length; i++) {
				msgs.push({ role: list[i].role, content: list[i].content })
			}
			messages.value = msgs
			version.value = 'pro'
			scrollToBottom()
		} catch (e) {
			console.error('[ai] load messages failed:', e)
			uni.showToast({ title: '加载会话失败', icon: 'none' })
		} finally {
			uni.hideLoading()
		}
	}

	async function onDeleteSession(id : number) : Promise<void> {
		uni.showModal({
			title: '删除会话',
			content: '确定删除该会话吗？',
			success: async (res) => {
				if (!res.confirm) return
				try {
					await deleteAiSessionApi(id)
					const next : AiSession[] = []
					for (let i = 0; i < sessions.value.length; i++) {
						if (sessions.value[i].id != id) next.push(sessions.value[i])
					}
					sessions.value = next
					if (sessionId.value == id) {
						sessionId.value = 0
						messages.value = [] as AiChatMessage[]
					}
				} catch (e) {
					uni.showToast({ title: '删除失败', icon: 'none' })
				}
			}
		})
	}

	function onAttach(promptText : string = '') : void {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const tempFilePaths = res.tempFilePaths as string[]
				uni.showToast({ title: '已选择图片', icon: 'none' })
				if (promptText.length > 0) {
					onSuggest(promptText + '（已选择图片）')
				}
			},
			fail: () => {
				uni.showToast({ title: '选择图片失败', icon: 'none' })
			}
		})
	}

	function onVoice() : void {
		uni.showModal({
			title: '语音输入',
			content: '当前环境暂不支持语音输入，请使用文字提问',
			showCancel: false,
		})
	}

	function formatTime(s : string) : string {
		if (s.length >= 16) return s.substring(0, 16).replace('T', ' ')
		if (s.length >= 10) return s.substring(0, 10)
		return s
	}

	onShow(() => {
		settings.value = loadAiChatSettings()
		try {
			getAiModelsApi().then((list) => {
				platformModels.value = list
			})
		} catch (_e) { }
	})
</script>

<style>
	.container {
		display: flex;
		flex-direction: column;
		background-color: #f8f8f8;
		position: relative;
	}

	.status-bar {
		background-color: #ffffff;
	}

	/* 顶栏 */
	.header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 16rpx 24rpx;
		background-color: #ffffff;
		border-bottom: 1rpx solid #f0f0f0;
	}

	.header-left,
	.header-right {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}

	.header-icon {
		font-size: 40rpx;
		color: #333333;
	}

	.header-center {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.version-tabs {
		flex-direction: row;
		align-items: center;
		margin-bottom: 4rpx;
	}

	.version-tab {
		font-size: 24rpx;
		color: #999999;
		padding: 4rpx 16rpx;
	}

	.version-tab.active {
		color: #2979ff;
		font-weight: 600;
	}

	.header-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #2979ff;
	}

	/* 基础版 */
	.basic-scroll {
		flex: 1;
		height: 0;
		padding: 24rpx;
	}

	.new-chat-card {
		background-color: #f5f5f5;
		border-radius: 16rpx;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 32rpx;
		margin-bottom: 24rpx;
	}

	.new-chat-icon {
		font-size: 36rpx;
		margin-right: 12rpx;
	}

	.new-chat-text {
		font-size: 30rpx;
		color: #333333;
		font-weight: 500;
	}

	.section-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx;
	}

	.section-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.section-header-left {
		flex-direction: row;
		align-items: center;
	}

	.section-icon {
		font-size: 32rpx;
		margin-right: 12rpx;
	}

	.section-title {
		font-size: 30rpx;
		color: #333333;
		font-weight: 500;
	}

	.section-arrow {
		font-size: 28rpx;
		color: #999999;
	}

	.section-arrow.up {
		transform: rotate(180deg);
	}

	.section-body {
		margin-top: 16rpx;
	}

	.empty-tip {
		text-align: center;
		font-size: 26rpx;
		color: #999999;
		padding: 32rpx 0;
	}

	.session-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 20rpx 0;
		border-bottom: 1rpx solid #f5f5f5;
	}

	.session-row-title {
		flex: 1;
		font-size: 28rpx;
		color: #333333;
	}

	.session-row-del {
		font-size: 32rpx;
		color: #999999;
		padding: 8rpx;
	}

	/* 专业版滚动区 */
	.chat-scroll {
		flex: 1;
		height: 0;
		padding: 24rpx;
	}

	/* 功能入口 */
	.function-grid {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 24rpx;
	}

	.function-item {
		align-items: center;
		width: 22%;
	}

	.function-icon-box {
		width: 96rpx;
		height: 96rpx;
		background-color: #e5e5e5;
		border-radius: 16rpx;
		align-items: center;
		justify-content: center;
		margin-bottom: 12rpx;
	}

	.function-icon {
		font-size: 44rpx;
	}

	.function-title {
		font-size: 24rpx;
		color: #666666;
		text-align: center;
	}

	/* 快捷提示语 */
	.prompt-list {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.prompt-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 28rpx 24rpx;
		margin-bottom: 16rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.prompt-text {
		flex: 1;
		font-size: 28rpx;
		color: #333333;
	}

	.prompt-arrow {
		font-size: 36rpx;
		color: #cccccc;
		margin-left: 16rpx;
	}

	/* 消息列表 */
	.msg-list {
		padding-bottom: 24rpx;
	}

	.msg-row {
		flex-direction: row;
		margin-bottom: 28rpx;
		align-items: flex-start;
	}

	.msg-row-user {
		justify-content: flex-end;
	}

	.msg-row-ai {
		justify-content: flex-start;
	}

	.msg-avatar {
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		align-items: center;
		justify-content: center;
		margin-right: 16rpx;
		flex-shrink: 0;
	}

	.ai-avatar {
		background-color: #2979ff;
	}

	.msg-avatar-text {
		font-size: 22rpx;
		color: #ffffff;
		font-weight: bold;
	}

	.msg-bubble {
		max-width: 520rpx;
		padding: 20rpx 24rpx;
