<template>
	<view class="ai-page">
		<!-- 自定义导航栏 -->
		<view class="custom-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
			<view class="nav-content">
				<text class="nav-icon" @click="toggleSidebarLeft">☰</text>
				<view class="nav-center">
                    <text class="nav-title">维修助手</text>
					<view class="version-tabs">
						<text class="version-tab" @click="goBasic">基础版</text>
						<text class="version-tab active">专业版</text>
					</view>
					
				</view>
				<text class="nav-icon" @click="toggleSidebarRight">▦</text>
			</view>
		</view>

		<!-- 主内容区 -->
		<view class="main">
			<!-- 专业版 -->
			<scroll-view scroll-y class="pro-scroll" :scroll-into-view="scrollIntoViewId" scroll-with-animation>
				<!-- 功能入口 -->
				<view class="function-grid">
					<view v-for="(item, idx) in functionItems" :key="idx" class="function-item" @click="onFunctionClick(item)">
						<view class="function-icon-box">
							<text class="function-icon">{{ item.icon }}</text>
						</view>
						<text class="function-title">{{ item.title }}</text>
					</view>
				</view>

				<!-- 快捷提示语 -->
				<view class="prompt-list">
					<view v-for="(p, idx) in quickPrompts" :key="idx" class="prompt-card" @click="sendText(p)">
						<text class="prompt-text">{{ p }}</text>
						<text class="prompt-arrow">›</text>
					</view>
				</view>

				<!-- 聊天消息 -->
				<view v-if="messages.length > 0" class="chat-area">
					<view v-for="(msg, idx) in messages" :id="'msg-' + idx" :key="idx" class="message-row" :class="msg.role">
						<view class="message-bubble">
							<text class="message-text">{{ msg.content }}</text>
						</view>
					</view>
					<view v-if="thinking" class="message-row assistant">
						<view class="message-bubble thinking">
							<text class="message-text">思考中...</text>
						</view>
					</view>
				</view>
				<view id="bottom-anchor"></view>
			</scroll-view>
		</view>

		<!-- 底部输入区 -->
		<view class="input-area">
			<view class="model-bar">
				<view class="model-selector" @click="showModelPicker = true">
					<text class="model-icon">★</text>
					<text class="model-name">{{ currentModelName }}</text>
					<text class="model-arrow">▾</text>
				</view>
			</view>
			<view class="input-row">
				<text class="tool-icon" @click="chooseImage()">📎</text>
				<view class="input-box">
					<input v-model="inputText" class="chat-input" placeholder="提出你想要知道的问题" confirm-type="send" @confirm="onSend" />
				</view>
				<text class="tool-icon" @click="startVoice">🎙</text>
				<text class="send-btn" :class="{ disabled: inputText.length == 0 }" @click="onSend">➤</text>
			</view>
		</view>

		<!-- 底部导航栏（保持 tab 切换可用） -->
		<TabBar :active-index="2"></TabBar>

		<!-- 左侧会话抽屉 -->
		<view v-if="sidebarLeft" class="drawer-mask" @click="sidebarLeft = false"></view>
		<view v-if="sidebarLeft" class="drawer drawer-left">
			<view class="drawer-header" :style="{ paddingTop: statusBarHeight + 'px' }">
				<text class="drawer-title">最近对话</text>
				<text class="drawer-close" @click="sidebarLeft = false">✕</text>
			</view>
			<scroll-view scroll-y class="drawer-body">
				<view class="drawer-new" @click="startNewChat">
					<text class="drawer-new-icon">+</text>
					<text class="drawer-new-text">新建对话</text>
				</view>
				<view v-if="sessions.length == 0" class="empty-tip">暂无历史对话</view>
				<view v-for="(s, idx) in sessions" :key="idx" class="drawer-item" @click="loadSession(s)">
					<text class="drawer-item-title">{{ s.title }}</text>
					<text class="drawer-item-del" @click.stop="onDeleteSession(s.id)">✕</text>
				</view>
			</scroll-view>
		</view>

		<!-- 右侧菜单抽屉（占位） -->
		<view v-if="sidebarRight" class="drawer-mask" @click="sidebarRight = false"></view>
		<view v-if="sidebarRight" class="drawer drawer-right">
			<view class="drawer-header" :style="{ paddingTop: statusBarHeight + 'px' }">
				<text class="drawer-title">功能菜单</text>
				<text class="drawer-close" @click="sidebarRight = false">✕</text>
			</view>
			<scroll-view scroll-y class="drawer-body">
				<view class="menu-item" @click="startNewChat">
					<text class="menu-item-text">新对话</text>
				</view>
				<view class="menu-item" @click="goBasic">
					<text class="menu-item-text">切换到基础版</text>
				</view>
				<view class="menu-item" @click="goSettings">
					<text class="menu-item-text">对话设置</text>
				</view>
				<view class="menu-item" @click="goManageModels">
					<text class="menu-item-text">自定义模型</text>
				</view>
				<view class="menu-item" @click="goProfile">
					<text class="menu-item-text">个人中心</text>
				</view>
			</scroll-view>
		</view>

		<!-- 模型选择弹窗 -->
		<view v-if="showModelPicker" class="picker-mask" @click="showModelPicker = false"></view>
		<view v-if="showModelPicker" class="model-picker">
			<view class="picker-title">选择模型</view>
			<view v-if="allModels.length == 0" class="picker-empty">暂无可用模型</view>
			<view v-for="(m, idx) in allModels" :key="idx" class="picker-item" :class="{ active: currentModelId == m.id && currentModelSource != 'custom' }" @click="selectModel(m)">
				<text class="picker-item-name">{{ m.name }}</text>
				<text class="picker-item-model">{{ m.model }}</text>
			</view>
			<view class="picker-action" :class="{ active: currentModelSource == 'custom' }" @click="showCustomForm = true">
				<text class="picker-action-name">自定义 API Key</text>
				<text class="picker-action-desc">临时输入模型与密钥</text>
			</view>
			<view class="picker-action" @click="goManageModels">
				<text class="picker-action-name">管理自定义模型</text>
				<text class="picker-action-desc">新增 / 编辑 / 删除</text>
			</view>
		</view>

		<!-- 自定义 API Key 弹窗 -->
		<view v-if="showCustomForm" class="picker-mask" @click="closeCustomForm"></view>
		<view v-if="showCustomForm" class="model-picker">
			<view class="picker-title">使用自定义 API Key</view>
			<view class="custom-hint">仅本次会话有效，不会被保存到服务器。</view>
			<view class="form-item">
				<text class="form-label">模型名</text>
				<input class="form-input" type="text" :value="customModel" placeholder="如：gpt-4o、deepseek-chat" @input="onCustomModelInput" />
			</view>
			<view class="form-item">
				<text class="form-label">Base URL</text>
				<input class="form-input" type="text" :value="customBaseUrl" placeholder="如：https://api.openai.com/v1" @input="onCustomBaseUrlInput" />
			</view>
			<view class="form-item">
				<text class="form-label">API Key</text>
				<input class="form-input" type="text" :password="true" :value="customApiKey" placeholder="sk-..." @input="onCustomApiKeyInput" />
			</view>
			<view class="custom-actions">
				<view class="custom-btn cancel" @click="closeCustomForm">
					<text class="custom-btn-text">取消</text>
				</view>
				<view class="custom-btn primary" @click="confirmCustomModel">
					<text class="custom-btn-text">确认使用</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { ref, computed } from 'vue'
	import { useAuthStore } from '../../stores/auth'
	import {
		getAiModelsApi,
		getAiUserModelsApi,
		loadAiChatSettings,
		saveAiChatSettings,
	} from '../../api/aiAssistant'
	import { useAiChat } from '../../composables/useAiChat'
	import type { ChatBodyBuilder } from '../../composables/useAiChat'
	import type { AiModel, AiUserModel, AIModelOption, AIFunctionItem, AiChatMessage } from '../../types/index'
	import { isProPaid, getVersion, setVersion } from '../../utils/aiPay'
	import { STORAGE_KEY_AI_SELECTED_USER_MODEL } from '../../constants/app'
	import TabBar from '../../components/tab-bar/tab-bar.uvue'

	const auth = useAuthStore()

	// 聊天核心逻辑（基础版/专业版共用，包含会话/消息/输入/侧栏/发送状态与方法）
	const {
		statusBarHeight,
		sessions,
		messages,
		inputText,
		thinking,
		scrollIntoViewId,
		sidebarLeft,
		sidebarRight,
		loadSessions,
		loadSession,
		startNewChat,
		onDeleteSession,
		toggleSidebarLeft,
		toggleSidebarRight,
		sendInput,
	} = useAiChat()

	// 视图状态
	const showModelPicker = ref<boolean>(false)

	// 自定义 API Key 临时使用
	const showCustomForm = ref<boolean>(false)
	const customModel = ref<string>('')
	const customBaseUrl = ref<string>('')
	const customApiKey = ref<string>('')

	// 数据（模型）
	const models = ref<AiModel[]>([])

	const userModels = ref<AiUserModel[]>([])

	const currentModelId = ref<number>(0)
	const currentModelSource = ref<'admin' | 'user' | 'custom'>('admin')
	const allModels = computed<AIModelOption[]>(() : AIModelOption[] => {
		const arr : AIModelOption[] = []
		for (let i = 0; i < models.value.length; i++) {
			const m = models.value[i]
			const item : AIModelOption = {
				id: m.id, name: m.name, model: m.model, source: m.source, description: m.description,
			}
			arr.push(item)
		}
		for (let i = 0; i < userModels.value.length; i++) {
			const m = userModels.value[i]
			const item : AIModelOption = {
				id: m.id, name: m.name, model: m.model, source: 'user', base_url: m.base_url,
			}
			arr.push(item)
		}
		return arr
	})
	const currentModelName = computed<string>(() : string => {
		if (currentModelSource.value == 'custom') {
			return customModel.value.length > 0 ? customModel.value : '自定义'
		}
		const list = allModels.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id == currentModelId.value) {
				return list[i].name
			}
		}
		return '选择模型'
	})

	// 专业版请求体：按 model_source 分支构造（admin / user / custom）
	const buildBody : ChatBodyBuilder = (history : AiChatMessage[], sessionID : number) : UTSJSONObject => {
		const params : UTSJSONObject = {
			session_id: sessionID,
			model_source: currentModelSource.value,
			messages: history,
		}
		if (currentModelSource.value == 'admin') {
			params['config_id'] = currentModelId.value
		} else if (currentModelSource.value == 'user') {
			params['user_model_id'] = currentModelId.value
		} else {
			params['custom_api_key'] = customApiKey.value
			params['custom_base_url'] = customBaseUrl.value
			params['custom_model'] = customModel.value
		}
		return params
	}

	// 发送前校验（专业版需有可用模型或已配置自定义模型），通过后走公共 sendInput
	function onSend() : void {
		if (models.value.length == 0 && userModels.value.length == 0 && currentModelSource.value != 'custom') {
			uni.showToast({ title: '暂无可用的 AI 模型', icon: 'none' })
			return
		}
		if (currentModelSource.value == 'custom' && customModel.value.trim().length == 0) {
			uni.showToast({ title: '请先配置自定义模型', icon: 'none' })
			return
		}
		sendInput(currentModelName.value, buildBody)
	}

	// 功能入口 / 快捷提示语点击：填入输入框并发送
	function sendText(text : string) : void {
		inputText.value = text
		onSend()
	}

	const functionItems : AIFunctionItem[] = [
		{ key: 'fault-code', title: '故障代码查询', icon: '', prompt: '帮我查询叉车故障代码含义' },
		{ key: 'drawing', title: '图纸识别', icon: '', prompt: '请识别这张叉车图纸' },
		{ key: 'exercise', title: '习题解答', icon: '', prompt: '请解答这道叉车维修题目' },
		{ key: 'knowledge', title: '维保知识', icon: '', prompt: '请介绍叉车维保相关知识' },
	]

	const quickPrompts : string[] = [
		'叉车液压系统常见故障有哪些，如何排查？',
		'叉车启动困难可能是什么原因？',
		'叉车日常保养的检查要点有哪些？',
	]


	/**
	 * 把本地'对话设置'(ai_chat_settings)水合到当前模型选择。
	 * 页面任何修改都会立即落盘(persistSettings)，因此'保存的设置 === 最新意图'，
	 * 这里可安全重复水合：冷启动时模型列表未就绪会回落到平台模型，待 loadModels
	 * 完成后再次水合即收敛。各来源都有护栏：保存模型已被删除/字段缺失时自动回落。
	 */
	function hydrateFromSettings() : void {
		const saved = loadAiChatSettings()
		const src = saved.model_source
		if (src == 'user') {
			for (let i = 0; i < userModels.value.length; i++) {
				if (userModels.value[i].id == saved.model_id) {
					currentModelId.value = saved.model_id
					currentModelSource.value = 'user'
					return
				}
			}
		} else if (src == 'custom') {
			if (saved.base_url.length > 0 && saved.model.length > 0 && saved.api_key.length > 0) {
				customModel.value = saved.model
				customBaseUrl.value = saved.base_url
				customApiKey.value = saved.api_key
				currentModelSource.value = 'custom'
				currentModelId.value = 0
				return
			}
		} else if (src == 'admin') {
			for (let i = 0; i < models.value.length; i++) {
				if (models.value[i].id == saved.model_id) {
					currentModelId.value = saved.model_id
					currentModelSource.value = 'admin'
					return
				}
			}
		}
		// 兜底：默认第一个平台模型
		if (models.value.length > 0 && currentModelId.value == 0) {
			currentModelId.value = models.value[0].id
		}
		currentModelSource.value = 'admin'
	}

	// 数据加载
	async function loadModels() : Promise<void> {
		try {
			models.value = await getAiModelsApi()
		} catch (e) {
			console.error('loadModels failed:', e)
			models.value = [] as AiModel[]
		}
		// 登录用户同时加载自定义模型
		if (auth.isLoggedIn.value) {
			try {
				userModels.value = await getAiUserModelsApi()
			} catch (e) {
				console.error('loadUserModels failed:', e)
				userModels.value = [] as AiUserModel[]
			}
		}
		// 平台与自定义模型均加载后，把'对话设置'里保存的选择落地到当前会话
		hydrateFromSettings()
	}

	/** 把当前模型选择落盘到'对话设置'，供重进页面/其它端保持生效 */
	function persistSettings() : void {
		const s = loadAiChatSettings()
		s.model_source = currentModelSource.value
		s.model_id = currentModelId.value
		if (currentModelSource.value == 'custom') {
			s.model_name = customModel.value.length > 0 ? customModel.value : s.model_name
			s.model = customModel.value
			s.base_url = customBaseUrl.value
			s.api_key = customApiKey.value
			s.model_id = 0
		} else if (currentModelSource.value == 'user') {
			// 用用户自定义模型的实际字段覆盖（model 名/base_url）
			for (let i = 0; i < userModels.value.length; i++) {
				const um = userModels.value[i]
				if (um.id == currentModelId.value) {
					s.model_name = um.name
					s.model = um.model
					s.base_url = um.base_url
					s.api_key = '' // 后端按 user_model_id 鉴权，本地不落明文 key
					break
				}
			}
		} else {
			// admin：用平台模型的实际字段覆盖
			for (let i = 0; i < models.value.length; i++) {
				const pm = models.value[i]
				if (pm.id == currentModelId.value) {
					s.model_name = pm.name
					s.model = pm.model
					break
				}
			}
			s.base_url = ''
			s.api_key = ''
		}
		saveAiChatSettings(s)
	}

	function goBasic() : void {
		sidebarRight.value = false
		setVersion('basic')
		uni.reLaunch({ url: '/pages/ai-assistant/ai-basic' })
	}

	function chooseImage(promptText : string = '') : void {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const tempFilePaths = res.tempFilePaths as string[]
				uni.showToast({ title: '图片已选择：' + tempFilePaths[0].substring(tempFilePaths[0].lastIndexOf('/') + 1), icon: 'none' })
				if (promptText.length > 0) {
					sendText(promptText + '（已选择图片）')
				}
			},
			fail: () => {
				uni.showToast({ title: '选择图片失败', icon: 'none' })
			},
		})
	}

	function onFunctionClick(item : AIFunctionItem) : void {
		if (item.key == 'drawing') {
			chooseImage(item.prompt)
			return
		}
		sendText(item.prompt)
	}

	function selectModel(m : AIModelOption) : void {
		currentModelId.value = m.id
		let isUser = false
		for (let i = 0; i < userModels.value.length; i++) {
			if (userModels.value[i].id == m.id) {
				isUser = true
				break
			}
		}
		currentModelSource.value = isUser ? 'user' : 'admin'
		showModelPicker.value = false
		persistSettings()
	}

	function selectUserModelById(id : number, name : string) : void {
		// 从自定义模型管理页选中的模型
		for (let i = 0; i < userModels.value.length; i++) {
			if (userModels.value[i].id == id) {
				currentModelId.value = id
				currentModelSource.value = 'user'
				showModelPicker.value = false
				uni.showToast({ title: '已切换：' + name, icon: 'none' })
				persistSettings()
				return
			}
		}
		// 列表尚未加载时仅记录 id，待加载后匹配
		currentModelId.value = id
		currentModelSource.value = 'user'
		showModelPicker.value = false
		persistSettings()
	}

	function goManageModels() : void {
		showModelPicker.value = false
		uni.navigateTo({ url: '/pages/ai-assistant/custom-models' })
	}

	function closeCustomForm() : void {
		showCustomForm.value = false
	}

	function onCustomModelInput(e : InputEvent) : void {
		customModel.value = e.detail.value
	}
	function onCustomBaseUrlInput(e : InputEvent) : void {
		customBaseUrl.value = e.detail.value
	}
	function onCustomApiKeyInput(e : InputEvent) : void {
		customApiKey.value = e.detail.value
	}

	function confirmCustomModel() : void {
		if (customModel.value.trim().length == 0) {
			uni.showToast({ title: '请输入模型名', icon: 'none' })
			return
		}
		if (customBaseUrl.value.trim().length == 0) {
			uni.showToast({ title: '请输入 Base URL', icon: 'none' })
			return
		}
		if (customApiKey.value.trim().length == 0) {
			uni.showToast({ title: '请输入 API Key', icon: 'none' })
			return
		}
		currentModelSource.value = 'custom'
		currentModelId.value = 0
		showCustomForm.value = false
		showModelPicker.value = false
		persistSettings()
	}

	function startVoice() : void {
		// 语音输入能力占位
		uni.showModal({
			title: '语音输入',
			content: '当前环境暂不支持语音输入，请使用文字提问',
			showCancel: false,
		})
	}

	function goProfile() : void {
		sidebarRight.value = false
		uni.switchTab({ url: '/pages/profile/profile' })
	}

	function goSettings() : void {
		sidebarRight.value = false
		uni.navigateTo({ url: '/pages/ai-assistant/ai-settings' })
	}

	// 生命周期
	onLoad((options : OnLoadOptions) => {
		const sysInfo = uni.getSystemInfoSync()
		statusBarHeight.value = sysInfo.statusBarHeight

		auth.restoreFromStorage()
		if (!auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}

		// 专业版需付费解锁：未付费直接回到版本选择页引导
		if (!isProPaid()) {
			uni.reLaunch({ url: '/pages/ai-assistant/version-select' })
			return
		}

		// 已选基础版（降级状态）则进入基础版页面
		if (getVersion() == 'basic') {
			uni.reLaunch({ url: '/pages/ai-assistant/ai-basic' })
			return
		}

		loadModels()
		loadSessions()
	})

	onShow(() => {
		if (auth.isLoggedIn.value) {
			loadSessions()
		}
		// 从'对话设置/自定义模型'页返回时，让保存的选择也落到当前会话
		hydrateFromSettings()

		// 从自定义模型管理页选择返回时，选中对应模型
		const selectedRaw = uni.getStorageSync(STORAGE_KEY_AI_SELECTED_USER_MODEL) as string
		if (selectedRaw.length > 0) {
			uni.removeStorageSync(STORAGE_KEY_AI_SELECTED_USER_MODEL)
			try {
				const sel = JSON.parse(selectedRaw) as UTSJSONObject
				const id = parseFloat(`${sel['id']}`)
				const name = `${sel['name'] ?? ''}`
				selectUserModelById(id, name)
			} catch (e) {
				console.error('[ai-assistant] apply selected model failed:', e)
			}
		}
	})
</script>

