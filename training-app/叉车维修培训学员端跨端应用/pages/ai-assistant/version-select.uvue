<template>
	<view class="page" :style="{ height: windowHeight + 'px' }">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="header">
			<view class="header-left" @click="onBack">
				<text class="back-icon">‹</text>
			</view>
			<text class="header-title">AI 助手</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="intro">
				<text class="intro-title">选择使用版本</text>
				<text class="intro-desc">基础版免费使用，专业版需付费解锁更多功能</text>
			</view>

			<!-- 基础版卡片（免费，当前默认锁定） -->
			<view class="version-card basic-card" @click="selectBasic">
				<view class="card-top">
					<view class="card-badge badge-basic">基础版</view>
					<view class="card-price free">免费</view>
				</view>
				<view class="card-desc">简洁易用，满足日常问答与最近会话回顾</view>
				<view class="feature-list">
					<view class="feature-row">
						<text class="feature-dot">●</text>
						<text class="feature-text">新对话</text>
					</view>
					<view class="feature-row">
						<text class="feature-dot">●</text>
						<text class="feature-text">最近对话折叠面板</text>
					</view>
					<view class="feature-row">
						<text class="feature-dot">●</text>
						<text class="feature-text">历史会话记录</text>
					</view>
				</view>
				<view class="card-btn btn-basic">
					<text class="btn-text">使用基础版</text>
				</view>
			</view>

			<!-- 专业版卡片（需付费解锁） -->
			<view class="version-card pro-card" @click="openPay">
				<view class="card-top">
					<view class="card-badge badge-pro">专业版</view>
					<view class="card-price">付费解锁</view>
				</view>
				<view class="card-desc">面向维修作业的完整 AI 能力，支持多模型与扩展工具</view>
				<view class="feature-list">
					<view class="feature-row">
						<text class="feature-dot">●</text>
						<text class="feature-text">功能快捷入口（故障代码 / 图纸 / 习题 / 维保）</text>
					</view>
					<view class="feature-row">
						<text class="feature-dot">●</text>
						<text class="feature-text">模型选择与自定义 API Key</text>
					</view>
					<view class="feature-row">
						<text class="feature-dot">●</text>
						<text class="feature-text">深度思考、图片识别、语音输入</text>
					</view>
				</view>
				<view class="card-btn btn-pro">
					<text class="btn-text">立即开通 {{ PRO_PRICE_MONTH }}</text>
				</view>
			</view>
		</scroll-view>

		<!-- mock 付费弹窗 -->
		<view v-if="payVisible" class="pay-mask" @click="closePay"></view>
		<view v-if="payVisible" class="pay-dialog">
			<view class="pay-title">开通专业版</view>
			<view class="pay-sub">解锁全部 AI 能力，一次购买长期有效</view>
			<view class="pay-plan" :class="{ active: payPlan == 'month' }" @click="payPlan = 'month'">
				<view class="plan-left">
					<text class="plan-name">月度会员</text>
					<text class="plan-desc">适合短期使用</text>
				</view>
				<text class="plan-price">{{ PRO_PRICE_MONTH }}</text>
			</view>
			<view class="pay-plan" :class="{ active: payPlan == 'year' }" @click="payPlan = 'year'">
				<view class="plan-left">
					<text class="plan-name">年度会员</text>
					<text class="plan-desc">更划算，推荐</text>
				</view>
				<text class="plan-price">{{ PRO_PRICE_YEAR }}</text>
			</view>
			<view class="pay-actions">
				<view class="pay-btn cancel" @click="closePay">
					<text class="pay-btn-text">取消</text>
				</view>
				<view class="pay-btn primary" @click="confirmPay">
					<text class="pay-btn-text">确认支付</text>
				</view>
			</view>
			<text class="pay-tip">当前为演示环境，支付为模拟操作</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { useStatusBarHeight } from '../../utils/system'
	import { goBack } from '../../utils/navigation'
	import {
		getVersion,
		setVersion,
		isProPaid,
		markProPaid,
		mockPay,
		PRO_PRICE_MONTH,
		PRO_PRICE_YEAR,
	} from '../../utils/aiPay'

	const statusBarHeight = useStatusBarHeight()
	const windowHeight = uni.getSystemInfoSync().windowHeight

	const payVisible = ref<boolean>(false)
	const payPlan = ref<'month' | 'year'>('month')
	const paying = ref<boolean>(false)

	// 作为 tabBar 网关：已选过版本则直接进入对应页面
	onLoad((options : OnLoadOptions) => {
		const v = getVersion()
		if (v == 'basic') {
			uni.reLaunch({ url: '/pages/ai-assistant/ai-basic' })
			return
		}
		if (v == 'pro' && isProPaid()) {
			uni.reLaunch({ url: '/pages/ai-assistant/ai-assistant' })
			return
		}
		// 未选过或未解锁：展示选择页
	})

	function onBack() : void {
		goBack()
	}

	function selectBasic() : void {
		setVersion('basic')
		uni.reLaunch({ url: '/pages/ai-assistant/ai-basic' })
	}

	function openPay() : void {
		payVisible.value = true
	}

	function closePay() : void {
		if (paying.value) return
		payVisible.value = false
	}

	async function confirmPay() : Promise<void> {
		if (paying.value) return
		paying.value = true
		try {
			await mockPay()
			markProPaid()
			setVersion('pro')
			payVisible.value = false
			uni.showToast({ title: '支付成功，已开通专业版', icon: 'success' })
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/ai-assistant/ai-assistant' })
			}, 600)
		} finally {
			paying.value = false
		}
	}
</script>

