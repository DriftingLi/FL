	}

	/* mock 付费弹窗 */
	.pay-mask {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		z-index: 200;
	}

	.pay-dialog {
		position: absolute;
		left: 48rpx;
		right: 48rpx;
		top: 22%;
		background-color: #ffffff;
		border-radius: 24rpx;
		padding: 40rpx 32rpx;
		z-index: 201;
	}

