		color: #333333;
		font-weight: 500;
	}

	.section-arrow {
		font-size: 28rpx;
		color: #999999;
	}

	.section-body {
		margin-top: 16rpx;
	}

	.empty-tip {
		text-align: center;
		font-size: 26rpx;
		color: #999999;
		padding: 32rpx 0;
	}

	.session-preview {
		padding: 16rpx 20rpx;
