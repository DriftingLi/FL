		border-radius: 12rpx;
	}

	.session-preview-text {
		font-size: 26rpx;
		color: #666666;
	}

	/* 聊天区 */
	.pro-scroll {
		flex: 1;
		padding: 24rpx;
	}

	.chat-area {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.message-row {
		flex-direction: row;
		margin-bottom: 20rpx;
	}

	.message-row.user {
		justify-content: flex-end;
	}

	.message-row.assistant {
		justify-content: flex-start;
	}

	.message-bubble {
