<template>
	<view class="ai-page">
		<!-- 自定义导航栏 -->
		<AiChatNav :version="'basic'" :status-bar-height="statusBarHeight" @left-click="toggleSidebarLeft" @menu-click="toggleSidebarRight" @tab-change="onTabChange" />

		<!-- 主内容区 -->
		<view class="main">
			<scroll-view scroll-y class="pro-scroll" :scroll-into-view="scrollIntoViewId" scroll-with-animation>
				<!-- 无对话：欢迎 + 快捷提示语 -->
				<view v-if="messages.length == 0 && !thinking" class="welcome-panel">
					<view class="prompt-list">
						<view v-for="(p, idx) in quickPrompts" :key="idx" class="prompt-card" @click="sendText(p)">
							<text class="prompt-text">{{ p }}</text>
						</view>
					</view>
				</view>

				<!-- 聊天区 -->
				<view v-else class="chat-area">
					<AiChatBubble v-for="(msg, idx) in messages" :key="idx" :role="msg.role" :content="msg.content" :show-actions="msg.role == 'assistant'" :is-last="idx == messages.length - 1" @copy="onCopyText(msg.content)" @retry="onRetry" />
					<view v-if="thinking" class="message-row assistant">
						<view class="message-bubble thinking">
							<text class="message-text">思考中...</text>
						</view>
					</view>
				</view>
				<view id="bottom-anchor"></view>
			</scroll-view>
		</view>

		<!-- 底部输入区 -->
		<AiChatInput :status-bar-height="statusBarHeight" @send="onInputSend" />

		<!-- 底部导航栏 -->
		<TabBar :active-index="2"></TabBar>

		<!-- 左侧会话抽屉 -->
		<AiChatDrawerLeft :visible="sidebarLeft" :sessions="sessions" :current-session-id="currentSession?.id ?? 0" :status-bar-height="statusBarHeight" @close="sidebarLeft = false" @new-chat="onNewChat" @select="onSelectSession" @delete="onDeleteSession" />

		<!-- 右侧功能菜单抽屉 -->
		<AiChatDrawerRight :visible="sidebarRight" :menu-items="rightMenuItems" :status-bar-height="statusBarHeight" @close="sidebarRight = false" @action="onMenuAction" />

		<!-- mock 付费弹窗 -->
		<view v-if="payVisible" class="pay-mask" @click="closePay"></view>
		<view v-if="payVisible" class="pay-dialog">
			<view class="pay-title">开通专业版</view>
			<view class="pay-sub">解锁全部 AI 能力，一次购买长期有效</view>
			<view class="pay-plan" :class="{ active: payPlan == 'month' }" @click="payPlan = 'month'">
				<view class="plan-left">
					<text class="plan-name">月度会员</text>
					<text class="plan-desc">适合短期使用</text>
				</view>
				<text class="plan-price">{{ PRO_PRICE_MONTH }}</text>
			</view>
			<view class="pay-plan" :class="{ active: payPlan == 'year' }" @click="payPlan = 'year'">
				<view class="plan-left">
					<text class="plan-name">年度会员</text>
					<text class="plan-desc">更划算，推荐</text>
				</view>
				<text class="plan-price">{{ PRO_PRICE_YEAR }}</text>
			</view>
			<view class="pay-actions">
				<view class="pay-btn cancel" @click="closePay">
					<text class="pay-btn-text">取消</text>
				</view>
				<view class="pay-btn primary" @click="confirmPay">
					<text class="pay-btn-text">确认支付</text>
				</view>
			</view>
			<text class="pay-tip">当前为演示环境，支付为模拟操作</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { ref } from 'vue'
	import { useAuthStore } from '../../stores/auth'
	import {
		getAiModelsApi,
		loadAiChatSettings,
		saveAiChatSettings,
	} from '../../api/aiAssistant'
	import { useAiChat } from '../../composables/useAiChat'
	import type { ChatBodyBuilder } from '../../composables/useAiChat'
	import type { AiModel, AiChatMessage } from '../../types/index'
	import {
		isProPaid,
		setVersion,
		markProPaid,
		mockPay,
		PRO_PRICE_MONTH,
		PRO_PRICE_YEAR,
	} from '../../utils/aiPay'
	import AiChatNav from '../../components/ai-chat/ai-chat-nav.uvue'
	import AiChatBubble from '../../components/ai-chat/ai-chat-bubble.uvue'
	import AiChatDrawerLeft from '../../components/ai-chat/ai-chat-drawer-left.uvue'
	import AiChatDrawerRight from '../../components/ai-chat/ai-chat-drawer-right.uvue'
	import AiChatInput from '../../components/ai-chat/ai-chat-input.uvue'
	import TabBar from '../../components/tab-bar/tab-bar.uvue'

	const auth = useAuthStore()

	// 聊天核心逻辑
	const {
		statusBarHeight,
		sessions,
		currentSession,
		messages,
		inputText,
		thinking,
		scrollIntoViewId,
		sidebarLeft,
		sidebarRight,
		loadSessions,
		loadSession,
		startNewChat,
		onDeleteSession,
		toggleSidebarLeft,
		toggleSidebarRight,
		sendInput,
	} = useAiChat()

	// mock 付费状态
	const payVisible = ref<boolean>(false)
	const payPlan = ref<'month' | 'year'>('month')
	const paying = ref<boolean>(false)

	// 数据（模型）
	const models = ref<AiModel[]>([])
	const currentModelId = ref<number>(0)

	// 右侧菜单项
	type MenuItem = { key: string; label: string }
	const rightMenuItems : MenuItem[] = [
		{ key: 'switch-pro', label: '切换到专业版' },
		{ key: 'settings', label: '对话设置' },
		{ key: 'custom-models', label: '自定义模型' },
		{ key: 'profile', label: '个人中心' },
	]

	/** 基础版请求体：固定使用平台模型（admin） */
	const buildBody : ChatBodyBuilder = (history : AiChatMessage[], sessionID : number) : UTSJSONObject => {
		const params : UTSJSONObject = {
			session_id: sessionID,
			model_source: 'admin',
			config_id: currentModelId.value,
			messages: history,
		}
		return params
	}

	// 发送前校验
	function onInputSend(text : string) : void {
		if (models.value.length == 0) {
			uni.showToast({ title: '暂无可用的 AI 模型', icon: 'none' })
			return
		}
		inputText.value = text
		sendInput('基础版', buildBody)
	}

	// 快捷提示语点击
	function sendText(text : string) : void {
		inputText.value = text
		onInputSend(text)
	}

	// 消息操作
	function onCopyText(content : string) : void {
		uni.setClipboardData({ data: content, success: () => { uni.showToast({ title: '已复制', icon: 'success' }) } })
	}

	function onRetry() : void {
		uni.showToast({ title: '基础版暂不支持重试', icon: 'none' })
	}

	// 版本切换
	function onTabChange(v : string) : void {
		if (v == 'pro') {
			goPro()
		}
	}

	// 会话操作
	function onNewChat() : void {
		startNewChat()
		sidebarLeft.value = false
	}

	function onSelectSession(s : AiSession) : void {
		loadSession(s)
	}

	// 右侧菜单操作
	function onMenuAction(key : string) : void {
		sidebarRight.value = false
		if (key == 'switch-pro') {
			goPro()
		} else if (key == 'settings') {
			uni.navigateTo({ url: '/pages/ai-assistant/ai-settings' })
		} else if (key == 'custom-models') {
			uni.navigateTo({ url: '/pages/ai-assistant/custom-models' })
		} else if (key == 'profile') {
			uni.switchTab({ url: '/pages/profile/profile' })
		}
	}

	// 快捷提示语
	const quickPrompts : string[] = [
		'叉车液压系统常见故障有哪些，如何排查？',
		'叉车启动困难可能是什么原因？',
		'叉车日常保养的检查要点有哪些？',
	]

	// 数据加载
	async function loadModels() : Promise<void> {
		try {
			const list = await getAiModelsApi()
			models.value = list
			const saved = loadAiChatSettings()
			let applied = false
			if (saved.model_source == 'admin' && saved.model_id > 0) {
				for (let i = 0; i < list.length; i++) {
					if (list[i].id == saved.model_id) {
						currentModelId.value = saved.model_id
						applied = true
						break
					}
				}
			}
			if (!applied && currentModelId.value == 0 && list.length > 0) {
				currentModelId.value = list[0].id
				const s = loadAiChatSettings()
				s.model_source = 'admin'
				s.model_id = currentModelId.value
				if (list[0].name.length > 0) s.model_name = list[0].name
				if (list[0].model.length > 0) s.model = list[0].model
				saveAiChatSettings(s)
			}
		} catch (e) {
			console.error('loadModels failed:', e)
		}
	}

	function openPay() : void {
		payVisible.value = true
	}

	function goPro() : void {
		if (!isProPaid()) {
			openPay()
			return
		}
		setVersion('pro')
		uni.reLaunch({ url: '/pages/ai-assistant/ai-assistant' })
	}

	function closePay() : void {
		if (paying.value) return
		payVisible.value = false
	}

	async function confirmPay() : Promise<void> {
		if (paying.value) return
		paying.value = true
		try {
			await mockPay()
			markProPaid()
			setVersion('pro')
			payVisible.value = false
			uni.showToast({ title: '支付成功，已开通专业版', icon: 'success' })
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/ai-assistant/ai-assistant' })
			}, 600)
		} finally {
			paying.value = false
		}
	}

	// 生命周期
	onLoad((options : OnLoadOptions) => {
		const sysInfo = uni.getSystemInfoSync()
		statusBarHeight.value = sysInfo.statusBarHeight

		auth.restoreFromStorage()
		if (!auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}

		loadModels()
		loadSessions()
	})

	onShow(() => {
		if (auth.isLoggedIn.value) {
			loadSessions()
		}
	})
</script>

<style>
	.ai-page {
		flex: 1;
		background-color: #f8f8f8;
	}

	.main {
		flex: 1;
	}

	.welcome-panel {
		padding: 24rpx;
	}

	.prompt-list {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.prompt-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 28rpx 24rpx;
		margin-bottom: 16rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.prompt-text {
		flex: 1;
		font-size: 28rpx;
		color: #333333;
	}

	.pro-scroll {
		flex: 1;
		padding: 24rpx;
	}

	.chat-area {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.message-row {
		flex-direction: row;
		margin-bottom: 20rpx;
	}

	.message-row.assistant {
		justify-content: flex-start;
	}

	.message-bubble {
		max-width: 600rpx;
		padding: 20rpx 24rpx;
		border-radius: 16rpx;
		background-color: #ffffff;
	}

	.message-bubble.thinking {
		background-color: #f0f0f0;
	}

	.message-text {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	/* mock 付费弹窗 */
	.pay-mask {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		z-index: 200;
	}

	.pay-dialog {
		position: absolute;
		left: 48rpx;
		right: 48rpx;
		top: 22%;
		background-color: #ffffff;
		border-radius: 24rpx;
		padding: 40rpx 32rpx;
		z-index: 201;
	}

	.pay-title {
		font-size: 36rpx;
		font-weight: bold;
		color: #222222;
		text-align: center;
	}

	.pay-sub {
		font-size: 24rpx;
		color: #999999;
		text-align: center;
		margin-top: 12rpx;
		margin-bottom: 32rpx;
	}

	.pay-plan {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		background-color: #f5f6f8;
		border-radius: 16rpx;
		padding: 28rpx 24rpx;
		margin-bottom: 20rpx;
		border: 2rpx solid transparent;
	}

	.pay-plan.active {
		background-color: #e3f2fd;
		border-color: #2979ff;
	}

	.plan-left {
		flex-direction: column;
	}

	.plan-name {
		font-size: 30rpx;
		color: #333333;
		font-weight: 500;
	}

	.plan-desc {
		font-size: 22rpx;
		color: #999999;
		margin-top: 6rpx;
	}

	.plan-price {
		font-size: 32rpx;
		color: #2979ff;
		font-weight: bold;
	}

	.pay-actions {
		flex-direction: row;
		margin-top: 8rpx;
	}

	.pay-btn {
		flex: 1;
		height: 88rpx;
		border-radius: 44rpx;
		align-items: center;
		justify-content: center;
	}

	.pay-btn.cancel {
		background-color: #f0f0f0;
		margin-right: 16rpx;
	}

	.pay-btn.primary {
		background-color: #2979ff;
	}

	.pay-btn-text {
		font-size: 30rpx;
		font-weight: bold;
	}

	.pay-btn.cancel .pay-btn-text {
		color: #333333;
	}

	.pay-btn.primary .pay-btn-text {
		color: #ffffff;
	}

	.pay-tip {
		font-size: 22rpx;
		color: #cccccc;
		text-align: center;
		margin-top: 20rpx;
	}
</style>
