		flex-direction: column;
	}

	.drawer-left {
		left: 0;
	}

	.drawer-right {
		right: 0;
	}

	.drawer-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 24rpx;
		border-bottom: 1rpx solid #f0f0f0;
	}

	.drawer-title {
		font-size: 32rpx;
		font-weight: 600;
