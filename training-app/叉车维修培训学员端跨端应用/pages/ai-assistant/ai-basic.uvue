		color: #333333;
	}

	.prompt-arrow {
		font-size: 36rpx;
		color: #cccccc;
		margin-left: 16rpx;
	}

	.section-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx;
	}

	.section-header {
		flex-direction: row;
		align-items: center;
