	.header-title {
		font-size: 34rpx;
		font-weight: bold;
		color: #222222;
	}

	.chat-scroll {
		flex: 1;
		/* 同通用页 `.pro-scroll`：必须 height:0 + flex:1，只给 flex:1 时滚动容器会长到内容高度、
