<template>
	<view class="page" :style="{ height: pageHeight + 'px' }">
		<app-nav-bar :title="featureTitle" @left-click="onBack" divider>
			<!-- 右：会话抽屉入口（「列该区」的界面，ADR-0013）。内层给**显式尺寸**的盒子 ⇒ 有命中区（#947 血账） -->
			<template #right>
				<view @click="toggleSidebarLeft">
					<view class="panel-icon">
						<view class="panel-icon-line"></view>
					</view>
				</view>
			</template>
		</app-nav-bar>

		<!-- 会话区：本页**没有**宫格、没有档位横幅、没有模型选择器 —— 专项通道由管理端单绑定
		     解析模型（见 buildBody 注释），用户在这一页没有可自选的东西。 -->
		<scroll-view class="chat-scroll" scroll-y="true" :scroll-into-view="scrollIntoViewId" scroll-with-animation>
			<!-- 空态欢迎区（仅诊断页且引导数据可用时渲染）：品牌快选 + 常见问题。
			     取数失败 / health.ok=false 时 guideVisible 为 false ⇒ **整块不渲染**，
			     页面退化为纯文字提问（票面判据：不留「点了必失败」的按钮）。 -->
			<view v-if="isDiagnosis && guideVisible && messages.length == 0" class="welcome-area">
				<view class="welcome-brand-row">
					<view v-for="b in brands" :key="b.id" class="welcome-brand" @click="onPickBrandCard(b.id)">
						<text class="welcome-brand-icon">{{ b.icon }}</text>
						<text class="welcome-brand-name">{{ b.name }}</text>
						<text v-if="b.tagline.length > 0" class="welcome-brand-tagline">{{ b.tagline }}</text>
					</view>
				</view>
				<view v-if="faq.length > 0" class="welcome-faq">
					<text class="welcome-faq-title">大家常问</text>
					<view v-for="(f, idx) in faq" :key="idx" class="welcome-faq-row" @click="onPickFaq(f.q)">
						<text class="welcome-faq-q">{{ f.q }}</text>
					</view>
				</view>
			</view>
			<view v-if="messages.length > 0" class="chat-area">
				<AiChatBubble v-for="(msg, idx) in messages" :key="idx" :role="msg.role" :content="msg.content" :sources="msg.sources" :images="msg.images" :meta="msg.meta" :show-actions="msg.role == 'assistant'" :is-last="idx == messages.length - 1" @copy="onCopyText(msg.content)" @retry="onRetry" />
				<view v-if="thinking" class="message-row assistant">
					<view class="message-bubble thinking">
						<text class="message-text">{{ thinkingLabel }}</text>
					</view>
				</view>
			</view>
			<view id="bottom-anchor"></view>
		</scroll-view>

		<!-- 诊断筛选面板：已随 v1 通道退役下线（后端 #2237 删了 brands/models/fault-codes 三个
		     只读端点，v2 单轨后没有替代数据源）。同 web 侧裁定：宁可本页暂时只保留对话，
		     也不留一个「点了必 404」的中间态。周边只读面按 v2 契约重接归票 2242，
		     本页重适配归票 2244。 -->

		<!-- 引导入口：只在诊断页且引导数据可用时出现（同样是 guideVisible 一个判据） -->
		<view v-if="isDiagnosis && guideVisible" class="guide-entry" @click="openGuide">
			<text class="guide-entry-text">{{ guideEntryLabel }}</text>
		</view>

		<!-- 故障码体检（#2297；口径 2026-11-10 反转，#2403）：输入框正上方一行，只渲染 known / typo；
		     format / 未收录 / 还没输入 / 取数失败都**整行不渲染**（安静不打扰是判据）。
		     format 静默的理由：体检只看长度、不懂句意，页面又支持自由提问 ⇒ 问「维修资料在哪」会被答「码格式不对」。
		     点这一行 = 把追问句替换进输入框（不自动发送），随后收掉。 -->
		<view v-if="isDiagnosis && codeHintView.visible" class="code-hint" @click="onCodeHintTap">
			<text :class="codeHintView.kind == 'known' ? 'code-hint-text' : 'code-hint-text code-hint-text-warn'">{{ codeHintView.text }}</text>
			<text v-if="codeHintView.followUp.length > 0" class="code-hint-action">追问 ›</text>
		</view>

		<!-- 待发图片托盘（#2299）：只在诊断页、且有内容/上传中出现；发送后由 picker.clear() 收空 -->
		<AiChatImageTray v-if="isDiagnosis" :images="pickImages" :uploading-count="pickUploading" :max-images="aiMaxImages" @remove="onRemoveImage" @preview="onPreviewImage" />

		<AiChatInput :draft="draftText" :show-image-button="isDiagnosis" :image-count="pickImages.length" @text-change="onDraftInput" @send="onInputSend" @voice-click="onVoiceClick" @image-click="onImageClick" />

		<AiChatDiagnosisGuide
			:visible="guideOpen"
			:brands="brands"
			:state="guideState"
			:second-items="secondItems"
			:fault-items="faultItems"
			:second-loading="secondLoading"
			:fault-loading="faultLoading"
			:sentence="sentence"
			@close="closeGuide"
			@pick-brand="pickBrand"
			@pick-second="pickSecond"
			@pick-fault="pickFault"
			@update-extra="updateExtra"
			@jump="jumpStep"
			@confirm="onConfirmSentence"
		/>

		<!-- 左侧会话抽屉：本页**只列本功能区**的会话（list/create 都带本页键，见 useAiChat 的 featureScope）。
		     它就是 ADR-0013「带键必有列它的界面」里的那个**界面** —— 缺了它，本页建的会话
		     在通用页「最近对话」里也看不到（#921 首版实测回归形态）。 -->
		<AiChatDrawerLeft :visible="sidebarLeft" :sessions="sessions" :current-session-id="currentSession ? currentSession.id : 0" :status-bar-height="statusBarHeight" @close="sidebarLeft = false" @new-chat="onNewChat" @select="onSelectSession" @delete="onDeleteSession" />
	</view>
</template>

<script setup lang="uts">
	import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { computed, ref, watch } from 'vue'
	import { useAuthStore } from '../../stores/auth'
	import { useAiChat } from '../../composables/useAiChat'
	import type { ChatBodyBuilder } from '../../composables/useAiChat'
	import type { AiChatMessage, AIFunctionItem, AiSession, DiagnosisCodeHint } from '../../types/index'

	import { FUNCTION_ITEMS, isDiagnosisFeature } from './ai-assistant-constants'
	import AiChatBubble from '../../components/ai-chat/ai-chat-bubble.uvue'
	import AiChatDrawerLeft from '../../components/ai-chat/ai-chat-drawer-left.uvue'
	import AiChatInput from '../../components/ai-chat/ai-chat-input.uvue'
	import AiChatDiagnosisGuide from '../../components/ai-chat/ai-chat-diagnosis-guide.uvue'
	import AiChatImageTray from '../../components/ai-chat/ai-chat-image-tray.uvue'
	import { useDiagnosisGuide } from '../../composables/useDiagnosisGuide'
	import { useAiImagePicker } from '../../composables/useAiImagePicker'
	import { canSend } from '../../utils/aiImageQuota'
	import { AI_MAX_IMAGES } from '../../config/env'
	import { useDiagnosisCodeHint } from '../../composables/useDiagnosisCodeHint'
	import { checkDiagnosisCodeApi } from '../../api/aiAssistant'

	/**
	 * 参数化专项页（ADR-0009 2026-09-15 修订 ②）：**1 个页面 + `featureKey` 参数**，形态照 web 的
	 * 一条参数化路由（`frontend/src/config/pages.ts` 的 `AIAssistantFeature` → 同一个
	 * `FeatureChatPage.vue`），**不是 4 个页面文件**。
	 *
	 * 与通用页（`ai-assistant.uvue`）的差别是**结构性**的，不是「同一页换个参数」：
	 * - 通用页**没有任何**「本轮带哪个键」的状态 ⇒ 「键从早退分支漏出去」这一整类缺陷
	 *   （#999 真机实测：先清后取 ⇒ 键恒为空、专项通道从未生效）在新形态下**不可能发生**：
	 *   本页的键是页面级常量，不经过任何轮次边界。
	 * - 本页不读模型列表、不带模型芯片、不做「请先配置自定义模型」前置校验 ——
	 *   专项通道由后端按管理端单绑定解析模型，与「用户自选模型」无关（#998 口径的形态化）。
	 *
	 * 会话归属（ADR-0013，2026-09-16 落地）：本页会话**按功能键真分区** —— 建/列会话都带本页键
	 * （`useAiChat(currentFeatureKey)` 的 `featureScope`），且本页有**列该区**的界面（右上的「最近对话」
	 * 抽屉）⇒ ADR-0013 那条「带键必有列它的界面」的 ⇔ 两向都在本页成立。通用页则恒传空串
	 * （不发键 ⇒ 遗留 `ai_assistant` 区，与从前逐字一致）。
	 * **不得只做一半**：在本页给会话带键却不列该区 ⇒ 会话在通用页也看不到（#921 首版实测回归）。
	 */

	const auth = useAuthStore()

	// 本页的专项功能键与展示名（由入口跳转时的查询参数定位，见 onLoad）。
	// ⚠️ 必须声明在 `useAiChat(...)` **之前**：该键同时是本页的**会话作用域**（list/create 都带它），
	// 而 Kotlin 局部 const 无提升（UTS error18）。
	const currentFeatureKey = ref<string>('')
	const featureTitle = ref<string>('')

	// 会话作用域 = 本页的功能键（传 **ref**、不传值：键在 onLoad 里才定位，传值只会读到初值空串）
	const {
		statusBarHeight,
		sessions,
		currentSession,
		messages,
		inputText,
		thinking,
		statusText,
		scrollIntoViewId,
		sidebarLeft,
		loadSessions,
		loadSession,
		startNewChat,
		onDeleteSession,
		toggleSidebarLeft,
		sendInput,
	} = useAiChat(currentFeatureKey)

	// 根容器高度（同 ai-settings.uvue / 通用页）：给根节点一个确定高度，onLoad 里赋值
	const pageHeight = ref<number>(0)

	// ===== 诊断引导面（#2296）=====
	//
	// 「本页是不是诊断专项页」**只经一个判据函数**：`isDiagnosisFeature`（读注册表 `adapter` 列，
	// ADR-0047 §7）。页面上任何诊断专有的渲染都挂在 `isDiagnosis` 上 —— **禁止**在这里写
	// `featureKey == 'fault_diagnosis'` 之类的字面比较（换一个诊断类功能键就得全页改一遍）。
	//
	// 取数、留白判定、四步状态机与组句全在 `useDiagnosisGuide` 里；本页只做三件事：
	// 渲染欢迎区、把选出来的句子写进输入框、把面板动作转给 composable。
	const isDiagnosis = ref<boolean>(false)

	// ===== 等待态（#2298）=====
	//
	// 只服务一条判据：学员看到的「在等」必须是真的在等。三件事一块做，缺一件都会破：
	// 1) 已等秒数 —— 等待期间每秒 +1，让「在跑」和「卡住」在界面上可区分（规格决策 17）；
	// 2) 诊断页常亮 —— 微信「切后台 5 秒未结束即 fail interrupted」与 timeout 取值无关，
	//    能挡的只有屏息（调研 `docs/design/20261106-移动端长请求超时上限调研.md`）；
	// 3) 计时器跟着等待态关 —— 请求结束（成功 / 失败 / 超时 / 截断）后不能继续跳秒，
	//    更不能串到下一轮（验收第 5 条）。
	const thinkingSeconds = ref<number>(0)
	// 文案优先级（#2389）：后端阶段文案 > 已等秒数 > 兜底「思考中...」。
	// 阶段文案来自 `status` 帧（此前被静默丢弃），让「在等」能说清在等什么。
	const thinkingLabel = computed<string>(() : string => {
		if (statusText.value.length > 0) {
			return statusText.value
		}
		if (thinkingSeconds.value <= 0) {
			return '思考中...'
		}
		return `思考中... 已等 ${thinkingSeconds.value} 秒`
	})
	let thinkingTimer : number | null = null
	let keepScreenOnByThinking : boolean = false

	function stopThinkingTimer() : void {
		const t = thinkingTimer
		if (t != null) {
			clearInterval(t)
			thinkingTimer = null
		}
	}

	function restoreScreenOn() : void {
		if (keepScreenOnByThinking) {
			keepScreenOnByThinking = false
			uni.setKeepScreenOn({ keepScreenOn: false })
		}
	}

	watch(thinking, (active : boolean) : void => {
		// 每一轮先收旧计时器：上一轮的 interval 若还在跑，秒数会从上一轮的值接着涨（串轮）
		stopThinkingTimer()
		if (!active) {
			thinkingSeconds.value = 0
			restoreScreenOn()
			return
		}
		thinkingSeconds.value = 0
		if (isDiagnosis.value && !keepScreenOnByThinking) {
			keepScreenOnByThinking = true
			uni.setKeepScreenOn({ keepScreenOn: true })
		}
		thinkingTimer = setInterval(() : void => {
			thinkingSeconds.value = thinkingSeconds.value + 1
		}, 1000)
	})

	// 离开页面（含返回上一层）就停：uni-app x 没有 Vue 的 onUnmounted，页面卸载钩子是 onUnload
	onUnload(() : void => {
		stopThinkingTimer()
		restoreScreenOn()
	})

	/**
	 * 灌进输入框的草稿（引导面板「填入输入框」用）。
	 *
	 * 为什么不直接改 `inputText`：那个是 `useAiChat` 的内部状态、不是双向绑定到组件上的
	 * —— 组件的 `:value` 只在挂载时取一次，改 `inputText` 页面上**不会变**（这也是
	 * `onRetry` 一直以来的隐性问题：它写 inputText 但发送时立刻清空，看不出差别）。
	 * 草稿做成页面级 ref 并在发送后清空，语义与「预填一格文字」一致。
	 */
	const draftText = ref<string>('')

	/**
	 * 故障码体检（#2297）：输入框正上方那一行。
	 *
	 * 分工：状态 → 文案在纯函数 `utils/diagnosisCodeHint.uts`（有真执行的行为用例；只有 known / typo 可见）；
	 * 防抖 / 过期丢弃 / 失败静默在 `useDiagnosisCodeHint`；本页只做三件事 ——
	 * 把输入框的变化喂进去、渲染那一行、点击回填追问句。
	 *
	 * 查询函数由本页注入（composable 自己不 import API），行为用例才能注入假取数。
	 */
	// 传 lambda 而不是裸函数名：UTS 对「函数值」推断不可靠（error17/error18 一类），包一层最稳
	const { view: codeHintView, onInput: onCodeHintInput, clear: clearCodeHint, dispose: disposeCodeHint } = useDiagnosisCodeHint((q : string) : Promise<DiagnosisCodeHint> => checkDiagnosisCodeApi(q))

	/**
	 * 随问图片（#2299）：选图 / 逐张上传 / 托盘的**状态全在 picker 里**，本页只转发动作。
	 * 顶层 ref 才能在模板里自动解包（嵌套在对象里不会），故三个值拆出来一份引用。
	 */
	const imagePicker = useAiImagePicker()
	const pickImages = imagePicker.images
	const pickUploading = imagePicker.uploadingCount
	const aiMaxImages = AI_MAX_IMAGES

	/**
	 * 输入框每敲一下都进来（本页唯一的「正在输入」信号）。
	 *
	 * ① 非诊断页一次查询都不发（`codeHintView` 恒不可见，喂进去也没有去处）；
	 * ② 顺带把输入内容镜像进 `draftText`：输入框由「外部草稿」驱动，若页面不跟着走，
	 *    学员删光后再点**同一条**提示，`draftText` 没有变化 ⇒ 组件里那个 watch 不触发
	 *    ⇒ 输入框不会回填（同值不触发是 watch 的语义，不是缺陷）。
	 */
	function onDraftInput(value : string) : void {
		draftText.value = value
		if (!isDiagnosis.value) return
		onCodeHintInput(value)
	}

	/** 点提示行：追问句**替换**输入框内容（不自动发送，学员可改），随后收掉这一行 */
	function onCodeHintTap() : void {
		const followUp = codeHintView.value.followUp
		if (followUp.length == 0) return
		draftText.value = followUp
		clearCodeHint()
	}

	const {
		brands,
		faq,
		guideVisible,
		guideOpen,
		state: guideState,
		secondItems,
		faultItems,
		secondLoading,
		faultLoading,
		sentence,
		loadIntents: loadDiagnosisIntents,
		openGuide,
		openGuideWithBrand,
		openGuideWithFault,
		closeGuide,
		pickBrand,
		pickSecond,
		pickFault,
		updateExtra,
		jumpStep,
	} = useDiagnosisGuide()

	/**
	 * 按键定位宫格项。清单是**移动端手写**的（ADR-0009 修订 ② 的配套口径），
	 * 与后端注册表的键集合 / 展示名 / 限免位由 `utils/aiFeatureRegistryParityContract.test.js` 锁一致。
	 * 声明在 onLoad 之前：Kotlin 局部函数不支持前向引用（UTS error18）。
	 */
	function findFunctionItem(featureKey : string) : AIFunctionItem | null {
		for (let i = 0; i < FUNCTION_ITEMS.length; i++) {
			if (FUNCTION_ITEMS[i].featureKey == featureKey) {
				return FUNCTION_ITEMS[i]
			}
		}
		return null
	}

	/**
	 * 专项通道请求体：只送 `session_id` + 历史 + 本轮键。
	 *
	 * **不送** `model_source` / `config_id` / `user_model_id` / `custom_*` —— 后端
	 * `ResolveChatSettings` 的专项分支命中 `featureChatKeys` 后按管理端单绑定解析模型，
	 * 并**忽略**选择子里的模型来源字段（`ai_config_service.go` 原文「防绕过」）⇒ 送了也是死字段，
	 * 而 `custom_api_key` 是明文密钥，更不该发出去（维护者 2026-09-15 口径：#998）。
	 * 键为空时后端落通用对话并照通用对话计费（`aiFeatureChatBilled`），故本页**必须**有键。
	 *
	 * **曾带 `brand` / `model`**（v1 诊断的结构化过滤）：v2 单轨后后端**无消费方**
	 * （`backend/internal/aiassistant/service.go:555` 原文「诊断参数（品牌/车型）在 v2 下没有消费方」），
	 * 且筛选面板已下线（#2262）⇒ 一并删掉，不留恒空的死字段。
	 */
	const buildBody : ChatBodyBuilder = (history : AiChatMessage[], sessionID : number, featureKey : string) : UTSJSONObject => {
		const params : UTSJSONObject = {
			session_id: sessionID,
			messages: history,
		}
		params['feature_key'] = featureKey
		return params
	}

	/** 引导入口的胶囊文案：一眼看出当前选到哪一步 */
	const guideEntryLabel = computed<string>(() : string => {
		if (guideState.value.selection.faultName.length > 0) {
			return '引导选问题 · ' + guideState.value.selection.faultName
		}
		return guideOpen.value ? '收起引导' : '引导选问题'
	})

	/** 欢迎区点品牌卡：带品牌预选进面板，直接落到第二层 */
	function onPickBrandCard(brandId : string) : void {
		openGuideWithBrand(brandId)
	}

	/** 欢迎区点常见问题：直接填进输入框（FAQ 是现成的一句话，不经引导面） */
	function onPickFaq(question : string) : void {
		draftText.value = question
		// 换了一句话，上一句的体检结果不再是「当前这句」的说明
		clearCodeHint()
	}

	/**
	 * 引导面板「填入输入框」：把组好的句子交给输入框，**不自动发送**。
	 *
	 * 票面判据是「输入框出现拼装好的问题句，学员可编辑后再发送」—— 组句模板的注释自己写着
	 * 「补充说明（故障码 / 时机 / 异响位置）由用户自己写，那是唯一能补回一部分命中率的手段」，
	 * 替人发出去就把这唯一手段废了。web 侧是直接发（点完即发），这里是**有意的差异**，见 ADR。
	 */
	function onConfirmSentence(text : string) : void {
		draftText.value = text
		clearCodeHint()
		closeGuide()
	}

	function onBack() : void {
		uni.navigateBack()
	}

	/** 抽屉：新建对话（只清空当前会话；真会话由首轮发送时按本页键创建） */
	function onNewChat() : void {
		startNewChat()
		sidebarLeft.value = false
	}

	/** 抽屉：重开该区的某个历史会话（消息按 session_id 取，与分区无关） */
	function onSelectSession(s : AiSession) : void {
		loadSession(s)
	}

	function onCopyText(content : string) : void {
		uni.setClipboardData({ data: content, success: () => { uni.showToast({ title: '已复制', icon: 'success' }) } })
	}

	function onVoiceClick() : void {
		uni.showToast({ title: '语音输入开发中', icon: 'none' })
	}

	/** 附件入口（📎）：只在诊断页出现；选图只经统一入口 useAiImagePicker */
	function onImageClick() : void {
		if (!isDiagnosis.value) return
		imagePicker.onAddImage()
	}

	function onRemoveImage(index : number) : void {
		imagePicker.onRemoveImage(index)
	}

	function onPreviewImage(index : number) : void {
		imagePicker.onPreviewImage(index)
	}

	function getLastUserMessage() : string {
		for (let i = messages.value.length - 1; i >= 0; i--) {
			if (messages.value[i].role == 'user') {
				return messages.value[i].content
			}
		}
		return ''
	}

	function onRetry() : void {
		const lastUserMsg = getLastUserMessage()
		if (lastUserMsg.length > 0) {
			inputText.value = lastUserMsg
			draftText.value = ''
			clearCodeHint()
			sendInput(featureTitle.value, buildBody, [], currentFeatureKey.value)
		}
	}

	/**
	 * 发送：键**恒定**取自页面状态（不存在「这一轮带哪个键」的判定，也没有可被早退分支跳过的清空）。
	 * 不做模型前置校验：专项通道的模型由管理端单绑定解析，「暂无可用的 AI 模型」这条通用页守卫
	 * 在这里既无需要也无意义（本页压根不加载模型列表）。
	 */
	function onInputSend(text : string) : void {
		// 有图无字也放行（票面验收第 2 条）：判定与 sendInput 的早退同源（`canSend` 单一判据）
		const picked : string[] = pickImages.value
		if (!canSend(text, picked.length)) return
		inputText.value = text
		// 发出去之后草稿作废：下一次发送不能把同一句再塞回输入框（否则点两次发送像卡住）
		draftText.value = ''
		// 发送后输入框清空 ⇒ 那一行体检结果必须一起消失（票面 AC：清空输入后提示消失）
		clearCodeHint()
		sendInput(featureTitle.value, buildBody, picked, currentFeatureKey.value)
		// 图已随本轮发出 ⇒ 待发托盘清空、名额归还
		imagePicker.clear()
	}

	// 生命周期
	onLoad((options : OnLoadOptions) => {
		const sysInfo = uni.getSystemInfoSync()
		statusBarHeight.value = sysInfo.statusBarHeight
		pageHeight.value = sysInfo.windowHeight

		auth.restoreFromStorage()
		if (!auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}

		// 参数定位，**fail-closed**：键必须命中手写清单（与后端注册表锁一致）。
		// 未知/缺失 ⇒ 不进页 —— 注册表里没有键的入口就是「点了走通用对话」的伪入口
		// （ADR-0009 修订 ② 据此下线了「故障代码查询」），不能靠「悄悄退化成通用对话」把它复活。
		const raw = options['featureKey']
		const item = findFunctionItem(raw != null ? `${raw}` : '')
		if (item == null) {
			uni.showToast({ title: '功能入口不存在', icon: 'none' })
			setTimeout(() => { uni.navigateBack() }, 1500)
			return
		}
		currentFeatureKey.value = item.featureKey
		featureTitle.value = item.title
		// 诊断专有判定的**单一入口**（不在这里比较功能键字面量）
		isDiagnosis.value = isDiagnosisFeature(item.featureKey)

		// **定位键之后**再拉本区会话（顺序在此承重：先列后定键会拉到遗留区，抽屉就列错区了）
		loadSessions()

		// 引导数据只在诊断页拉；非诊断页一次请求都不发（guideVisible 恒 false ⇒ 整块不渲染）
		if (isDiagnosis.value) {
			loadDiagnosisIntents()
		}
	})

	/** 页面卸载：取消还没到点的体检计时器，别让它在页面销毁后落地（本仓反模式：裸 setTimeout 不管生命周期） */
	onUnload(() => {
		disposeCodeHint()
	})
</script>

<style lang="scss">
	.page {
		display: flex;
		flex-direction: column;
		background-color: #dfeffb;
	}


	/* 会话抽屉入口：与通用页导航左侧同一套「面板」视觉；内层给**显式尺寸** ⇒ 有命中区（#947 血账） */
	.panel-icon {
		width: 44rpx;
		height: 36rpx;
		border: 3rpx solid #6b6b6b;
		border-radius: 8rpx;
		flex-direction: row;
		align-items: center;
	}

	.panel-icon-line {
		width: 3rpx;
		height: 24rpx;
		background-color: #6b6b6b;
		margin-left: 9rpx;
	}

	.back-icon {
		font-size: 48rpx;
		color: $text-color;
		font-weight: bold;
	}

	.header-title {
		font-size: 34rpx;
		font-weight: bold;
		color: #222222;
	}

	.welcome-area {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.welcome-brand-row {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.welcome-brand {
		flex-direction: column;
		border-width: 1rpx;
		border-style: solid;
		border-color: $border-color;
		border-radius: $radius-lg;
		padding: 20rpx;
		margin-right: 16rpx;
		margin-bottom: 16rpx;
		background-color: $card-bg;
		min-width: 300rpx;
	}

	.welcome-brand-icon {
		font-size: 40rpx;
	}

	.welcome-brand-name {
		font-size: 28rpx;
		font-weight: bold;
		color: $text-color;
		margin-top: 8rpx;
	}

	.welcome-brand-tagline {
		font-size: 22rpx;
		color: $text-color-placeholder;
		margin-top: 4rpx;
	}

	.welcome-faq {
		flex-direction: column;
		margin-top: 8rpx;
	}

	.welcome-faq-title {
		font-size: 24rpx;
		color: $text-color-placeholder;
		margin-bottom: 8rpx;
	}

	.welcome-faq-row {
		border-width: 1rpx;
		border-style: solid;
		border-color: $border-color-light;
		border-radius: $radius-md;
		padding: 16rpx 20rpx;
		margin-bottom: 12rpx;
		background-color: $card-bg;
	}

	.welcome-faq-q {
		font-size: 26rpx;
		color: $text-color-secondary;
	}

	.guide-entry {
		align-items: flex-start;
		padding-left: 24rpx;
		padding-right: 24rpx;
		padding-top: 8rpx;
		padding-bottom: 8rpx;
	}

	.guide-entry-text {
		font-size: 24rpx;
		color: $uni-color-primary;
	}

	/* 故障码体检那一行（#2297）：贴在输入框正上方，整行可点（点 = 追问句填进输入框） */
	.code-hint {
		flex-direction: row;
		align-items: center;
		padding: 12rpx 28rpx;
	}

	/* 文字样式落 <text>（落 <view> 上原生端静默忽略并逐处打 error，见 uvueFontCarrierContract） */
	.code-hint-text {
		flex: 1;
		font-size: 24rpx;
		line-height: 1.5;
		color: $text-color-secondary;
	}

	/* typo 是「你填得不对」，用警示色；known 才用次级文字色 */
	.code-hint-text-warn {
		color: $warning-color;
	}

	.code-hint-action {
		font-size: 24rpx;
		color: $uni-color-primary;
		margin-left: 12rpx;
	}

	.chat-scroll {
		flex: 1;
		/* 同通用页 `.pro-scroll`：必须 height:0 + flex:1，只给 flex:1 时滚动容器会长到内容高度、
		   没有可滚动余量（手势滚不动，但 scroll-into-view 仍会视觉上跳到底部）。 */
		height: 0;
		padding: 24rpx;
	}

	.chat-area {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.message-row {
		flex-direction: row;
		margin-bottom: 20rpx;
	}

	.message-row.assistant {
		justify-content: flex-start;
	}

	.message-bubble {
		max-width: 600rpx;
		padding: 20rpx 24rpx;
		border-radius: 16rpx;
		background-color: $card-bg;
	}

	.message-bubble.thinking {
		background-color: $border-color-light;
	}

	.message-text {
		font-size: 28rpx;
		color: $text-color;
		line-height: 1.6;
	}
</style>