<template>
	<view class="page" :style="{ height: pageHeight + 'px' }">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="header">
			<view class="header-left" @click="onBack">
				<text class="back-icon">&#8249;</text>
			</view>
			<text class="header-title">{{ featureTitle }}</text>
			<!-- 右：会话抽屉入口（「列该区」的界面，ADR-0013）。内层给**显式尺寸**的盒子 ⇒ 有命中区（#947 血账） -->
			<view class="header-right" @click="toggleSidebarLeft">
				<view class="panel-icon">
					<view class="panel-icon-line"></view>
				</view>
			</view>
		</view>

		<!-- 会话区：本页**没有**宫格、没有档位横幅、没有模型选择器 —— 专项通道由管理端单绑定
		     解析模型（见 buildBody 注释），用户在这一页没有可自选的东西。 -->
		<scroll-view class="chat-scroll" scroll-y="true" :scroll-into-view="scrollIntoViewId" scroll-with-animation>
			<view v-if="messages.length > 0" class="chat-area">
				<AiChatBubble v-for="(msg, idx) in messages" :key="idx" :role="msg.role" :content="msg.content" :sources="msg.sources" :show-actions="msg.role == 'assistant'" :is-last="idx == messages.length - 1" @copy="onCopyText(msg.content)" @retry="onRetry" />
				<view v-if="thinking" class="message-row assistant">
					<view class="message-bubble thinking">
						<text class="message-text">思考中...</text>
					</view>
				</view>
			</view>
			<view id="bottom-anchor"></view>
		</scroll-view>

		<!-- 诊断筛选面板：**只对注册表 adapter=diagnosis 的功能渲染**（判据 `isDiagnosisFeature`，
		     不是比较功能键字符串）。品牌/车型联动 + 故障码检索。
		     筛选走**结构化请求字段**（buildBody 带 brand/model），**不是拼进消息文本** ——
		     后端诊断适配器用这两个字段做过滤（缺省 all），文本拼接改不动它们（见 api/aiAssistant.uts 的长注释）。 -->
		<view v-if="isDiagnosis" class="diag-bar">
			<view class="diag-head" @click="onToggleFilter">
				<text class="diag-head-title">筛选</text>
				<text class="diag-head-summary">{{ filterSummaryText() }}</text>
				<text class="diag-head-toggle">{{ filterOpen ? '收起' : '展开' }}</text>
			</view>
			<view v-if="filterOpen" class="diag-panel">
				<!-- 品牌（数据源 /diagnosis/brands；含 value=all 的「全部品牌」项） -->
				<scroll-view class="diag-chips" scroll-x="true">
					<view v-for="(b, idx) in brands" :key="idx" class="filter-chip" :class="{ active: selectedBrand == b.value }" @click="onBrandSelect(b.value)">
						<text class="filter-chip-text" :class="{ active: selectedBrand == b.value }">{{ b.label }}</text>
					</view>
				</scroll-view>
				<!-- 车型（品牌联动：选中品牌后才拉；brand=all 时后端回全量车型，故此处仍可展示） -->
				<scroll-view v-if="models.length > 0" class="diag-chips" scroll-x="true">
					<view v-for="(m, idx) in models" :key="idx" class="filter-chip" :class="{ active: selectedModel == m }" @click="onModelSelect(m)">
						<text class="filter-chip-text" :class="{ active: selectedModel == m }">{{ m }}</text>
					</view>
				</scroll-view>
				<!-- 故障码检索（直连 fault-codes 代理，精确命中秒回；点条目 = 套用该码发一轮） -->
				<view class="diag-search">
					<input v-model="faultKeyword" class="diag-search-input" placeholder="搜索故障码或现象" confirm-type="search" @confirm="onFaultSearch" />
					<text class="diag-search-btn" @click="onFaultSearch">查询</text>
				</view>
				<scroll-view v-if="faultCodes.length > 0" class="diag-faults" scroll-y="true">
					<view v-for="(fc, idx) in faultCodes" :key="idx" class="diag-fault-item" @click="onUseFaultCode(fc)">
						<text class="diag-fault-code">{{ fc.fault_code }}</text>
						<text class="diag-fault-name">{{ fc.fault_name }}</text>
					</view>
					<view v-if="faultTotal > faultCodes.length" class="diag-fault-more" @click="onFaultMore">
						<text class="diag-fault-more-text">加载更多（共 {{ faultTotal }} 条）</text>
					</view>
				</scroll-view>
				<text v-if="faultSearched && faultCodes.length == 0 && !faultLoading" class="diag-fault-empty">没有匹配的故障码</text>
			</view>
		</view>

		<AiChatInput @send="onInputSend" @voice-click="onVoiceClick" />

		<!-- 左侧会话抽屉：本页**只列本功能区**的会话（list/create 都带本页键，见 useAiChat 的 featureScope）。
		     它就是 ADR-0013「带键必有列它的界面」里的那个**界面** —— 缺了它，本页建的会话
		     在通用页「最近对话」里也看不到（#921 首版实测回归形态）。 -->
		<AiChatDrawerLeft :visible="sidebarLeft" :sessions="sessions" :current-session-id="currentSession?.id ?? 0" :status-bar-height="statusBarHeight" @close="sidebarLeft = false" @new-chat="onNewChat" @select="onSelectSession" @delete="onDeleteSession" />
	</view>
</template>

<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { ref, computed } from 'vue'
	import { useAuthStore } from '../../stores/auth'
	import { useAiChat } from '../../composables/useAiChat'
	import type { ChatBodyBuilder } from '../../composables/useAiChat'
	import type { AiChatMessage, AIFunctionItem, AiSession, AiDiagnosisBrandOption, AiDiagnosisFaultCodeItem } from '../../types/index'
	import { getDiagnosisBrandsApi, getDiagnosisModelsApi, getDiagnosisFaultCodesApi } from '../../api/aiAssistant'

	import { FUNCTION_ITEMS, isDiagnosisFeature } from './ai-assistant-constants'
	import AiChatBubble from '../../components/ai-chat/ai-chat-bubble.uvue'
	import AiChatDrawerLeft from '../../components/ai-chat/ai-chat-drawer-left.uvue'
	import AiChatInput from '../../components/ai-chat/ai-chat-input.uvue'

	/**
	 * 参数化专项页（ADR-0009 2026-09-15 修订 ②）：**1 个页面 + `featureKey` 参数**，形态照 web 的
	 * 一条参数化路由（`frontend/src/config/pages.ts` 的 `AIAssistantFeature` → 同一个
	 * `FeatureChatPage.vue`），**不是 4 个页面文件**。
	 *
	 * 与通用页（`ai-assistant.uvue`）的差别是**结构性**的，不是「同一页换个参数」：
	 * - 通用页**没有任何**「本轮带哪个键」的状态 ⇒ 「键从早退分支漏出去」这一整类缺陷
	 *   （#999 真机实测：先清后取 ⇒ 键恒为空、专项通道从未生效）在新形态下**不可能发生**：
	 *   本页的键是页面级常量，不经过任何轮次边界。
	 * - 本页不读模型列表、不带模型芯片、不做「请先配置自定义模型」前置校验 ——
	 *   专项通道由后端按管理端单绑定解析模型，与「用户自选模型」无关（#998 口径的形态化）。
	 *
	 * 会话归属（ADR-0013，2026-09-16 落地）：本页会话**按功能键真分区** —— 建/列会话都带本页键
	 * （`useAiChat(currentFeatureKey)` 的 `featureScope`），且本页有**列该区**的界面（右上的「最近对话」
	 * 抽屉）⇒ ADR-0013 那条「带键必有列它的界面」的 ⇔ 两向都在本页成立。通用页则恒传空串
	 * （不发键 ⇒ 遗留 `ai_assistant` 区，与从前逐字一致）。
	 * **不得只做一半**：在本页给会话带键却不列该区 ⇒ 会话在通用页也看不到（#921 首版实测回归）。
	 */

	const auth = useAuthStore()

	// 本页的专项功能键与展示名（由入口跳转时的查询参数定位，见 onLoad）。
	// ⚠️ 必须声明在 `useAiChat(...)` **之前**：该键同时是本页的**会话作用域**（list/create 都带它），
	// 而 Kotlin 局部 const 无提升（UTS error18）。
	const currentFeatureKey = ref<string>('')
	const featureTitle = ref<string>('')

	// 会话作用域 = 本页的功能键（传 **ref**、不传值：键在 onLoad 里才定位，传值只会读到初值空串）
	const {
		statusBarHeight,
		sessions,
		currentSession,
		messages,
		inputText,
		thinking,
		scrollIntoViewId,
		sidebarLeft,
		loadSessions,
		loadSession,
		startNewChat,
		onDeleteSession,
		toggleSidebarLeft,
		sendInput,
	} = useAiChat(currentFeatureKey)

	// 根容器高度（同 ai-settings.uvue / 通用页）：给根节点一个确定高度，onLoad 里赋值
	const pageHeight = ref<number>(0)

	// ===== 诊断筛选（只对注册表 adapter=diagnosis 的功能启用）=====
	//
	// 判据是**传输适配器**，不是功能键字符串（根仓库 ADR-0047 §7；web 先例 aiFeatures.ts 的
	// isDiagnosisFeature）—— 经 isDiagnosisFeature 单点判定。
	// 数据源是三个只读代理端点（api/aiAssistant.uts 的 getDiagnosis*Api），与「本轮对话」解耦：
	// 面板只负责把选中的品牌/车型写进请求体、把搜到的故障码写进输入框。
	const isDiagnosis = computed(() : boolean => isDiagnosisFeature(currentFeatureKey.value))
	/** 面板默认**折叠**（同 web 诊断页 T2 决定：不撑爆会话空态）；头部常驻并显示当前筛选摘要。 */
	const filterOpen = ref<boolean>(false)
	const brands = ref<AiDiagnosisBrandOption[]>([])
	const models = ref<string[]>([])
	const selectedBrand = ref<string>('')
	const selectedModel = ref<string>('')
	const faultKeyword = ref<string>('')
	const faultCodes = ref<AiDiagnosisFaultCodeItem[]>([])
	const faultTotal = ref<number>(0)
	const faultPage = ref<number>(1)
	const faultLoading = ref<boolean>(false)
	const faultSearched = ref<boolean>(false)

	/** 故障码每页条数（与 web 诊断页的 page_size: 5 一致：首屏一屏读完，不足时给「加载更多」） */
	const DIAG_FAULT_PAGE_SIZE : number = 5

	/**
	 * 按键定位宫格项。清单是**移动端手写**的（ADR-0009 修订 ② 的配套口径），
	 * 与后端注册表的键集合 / 展示名 / 限免位由 `utils/aiFeatureRegistryParityContract.test.js` 锁一致。
	 * 声明在 onLoad 之前：Kotlin 局部函数不支持前向引用（UTS error18）。
	 */
	function findFunctionItem(featureKey : string) : AIFunctionItem | null {
		for (let i = 0; i < FUNCTION_ITEMS.length; i++) {
			if (FUNCTION_ITEMS[i].featureKey == featureKey) {
				return FUNCTION_ITEMS[i]
			}
		}
		return null
	}

	/**
	 * 专项通道请求体：只送 `session_id` + 历史 + 本轮键（**诊断功能另带品牌/车型过滤**）。
	 *
	 * **不送** `model_source` / `config_id` / `user_model_id` / `custom_*` —— 后端
	 * `ResolveChatSettings` 的专项分支命中 `featureChatKeys` 后按管理端单绑定解析模型，
	 * 并**忽略**选择子里的模型来源字段（`ai_config_service.go` 原文「防绕过」）⇒ 送了也是死字段，
	 * 而 `custom_api_key` 是明文密钥，更不该发出去（维护者 2026-09-15 口径：#998）。
	 * 键为空时后端落通用对话并照通用对话计费（`aiFeatureChatBilled`），故本页**必须**有键。
	 *
	 * **诊断功能额外带 `brand` / `model`**（`AIAssistantChatRequest` 的**既有**字段，不是新增契约）：
	 * 后端经 `WithDiagnosisParams` 透传给诊断适配器，适配器再放进外部助手请求体
	 * （`ai_diagnosis_adapter.go:272-278`，**缺省 `brand=all`**）
	 * ⇒ **过滤靠这两个字段，不靠把品牌拼进消息文本**（`frontend/src/api/aiAssistant.ts:93`
	 * 原文「结构化传参，不走文本注入」）。判据用 `isDiagnosisFeature`（读 adapter）而不是
	 * 比较功能键字符串；**非诊断功能一个字段都不多送**。
	 */
	const buildBody : ChatBodyBuilder = (history : AiChatMessage[], sessionID : number, featureKey : string) : UTSJSONObject => {
		const params : UTSJSONObject = {
			session_id: sessionID,
			messages: history,
		}
		params['feature_key'] = featureKey
		if (isDiagnosisFeature(featureKey)) {
			// 'all' 等价于不过滤 ⇒ 不送，让后端缺省值生效（与 web 侧同一判据）
			if (selectedBrand.value.length > 0 && selectedBrand.value != 'all') {
				params['brand'] = selectedBrand.value
			}
			if (selectedModel.value.length > 0) {
				params['model'] = selectedModel.value
			}
		}
		return params
	}

	function onBack() : void {
		uni.navigateBack()
	}

	/** 抽屉：新建对话（只清空当前会话；真会话由首轮发送时按本页键创建） */
	function onNewChat() : void {
		startNewChat()
		sidebarLeft.value = false
	}

	/** 抽屉：重开该区的某个历史会话（消息按 session_id 取，与分区无关） */
	function onSelectSession(s : AiSession) : void {
		loadSession(s)
	}

	function onCopyText(content : string) : void {
		uni.setClipboardData({ data: content, success: () => { uni.showToast({ title: '已复制', icon: 'success' }) } })
	}

	function onVoiceClick() : void {
		uni.showToast({ title: '语音输入开发中', icon: 'none' })
	}

	function getLastUserMessage() : string {
		for (let i = messages.value.length - 1; i >= 0; i--) {
			if (messages.value[i].role == 'user') {
				return messages.value[i].content
			}
		}
		return ''
	}

	function onRetry() : void {
		const lastUserMsg = getLastUserMessage()
		if (lastUserMsg.length > 0) {
			inputText.value = lastUserMsg
			sendInput(featureTitle.value, buildBody, [], currentFeatureKey.value)
		}
	}

	/**
	 * 发送：键**恒定**取自页面状态（不存在「这一轮带哪个键」的判定，也没有可被早退分支跳过的清空）。
	 * 不做模型前置校验：专项通道的模型由管理端单绑定解析，「暂无可用的 AI 模型」这条通用页守卫
	 * 在这里既无需要也无意义（本页压根不加载模型列表）。
	 */
	function onInputSend(text : string) : void {
		inputText.value = text
		sendInput(featureTitle.value, buildBody, [], currentFeatureKey.value)
	}

	// ===== 诊断筛选：交互与数据 =====
	// 声明位置：整块落在 `buildBody` **之后** —— Kotlin 局部函数无前向引用（onUseFaultCode 要用
	// buildBody），见 mobile AGENTS.md 的 UTS error18 坑位。

	function onToggleFilter() : void {
		filterOpen.value = !filterOpen.value
	}

	/** 品牌 value → 展示名（清单来自 /diagnosis/brands；查不到时回退 value 本身） */
	function brandLabelOf(brandValue : string) : string {
		for (let i = 0; i < brands.value.length; i++) {
			if (brands.value[i].value == brandValue) {
				return brands.value[i].label
			}
		}
		return brandValue
	}

	/** 折叠态头部摘要：未选品牌即「全部品牌」（后端缺省就是 all） */
	function filterSummaryText() : string {
		const parts : string[] = []
		if (selectedBrand.value.length > 0 && selectedBrand.value != 'all') {
			parts.push(brandLabelOf(selectedBrand.value))
		}
		if (selectedModel.value.length > 0) {
			parts.push(selectedModel.value)
		}
		if (parts.length == 0) {
			return '全部品牌'
		}
		return parts.join(' / ')
	}

	/** 拉品牌清单：失败静默（数据源不可用时保持空面板，自由诊断不受影响 —— 同 web 侧降级口径） */
	async function loadBrands() : Promise<void> {
		try {
			brands.value = await getDiagnosisBrandsApi()
		} catch (e) {
			brands.value = []
		}
	}

	/** 选品牌 ⇒ 清车型并联动拉该品牌车型（同 web 的 onBrandChange）；选「全部」不发请求。 */
	async function onBrandSelect(brandValue : string) : Promise<void> {
		selectedBrand.value = brandValue
		selectedModel.value = ''
		models.value = []
		if (brandValue.length == 0 || brandValue == 'all') {
			return
		}
		try {
			models.value = await getDiagnosisModelsApi(brandValue)
		} catch (e) {
			models.value = []
		}
	}

	/** 选车型（最后一级筛选；同 web 的 onModelChange：选完收起面板，把画面还给会话） */
	function onModelSelect(model : string) : void {
		selectedModel.value = model
		filterOpen.value = false
	}

	/** 故障码查询：page<=1 覆盖、>1 追加（「加载更多」）；失败静默（输入框仍可自由发起诊断）。 */
	async function loadFaultCodes(page : number) : Promise<void> {
		if (faultLoading.value) {
			return
		}
		faultLoading.value = true
		try {
			const data = await getDiagnosisFaultCodesApi(selectedBrand.value, faultKeyword.value.trim(), page, DIAG_FAULT_PAGE_SIZE)
			if (page <= 1) {
				faultCodes.value = data.items
			} else {
				for (let i = 0; i < data.items.length; i++) {
					faultCodes.value.push(data.items[i])
				}
			}
			faultTotal.value = data.total
			faultPage.value = page
			faultSearched.value = true
		} catch (e) {
			if (page <= 1) {
				faultCodes.value = []
			}
			faultSearched.value = true
		}
		faultLoading.value = false
	}

	function onFaultSearch() : void {
		loadFaultCodes(1)
	}

	function onFaultMore() : void {
		loadFaultCodes(faultPage.value + 1)
	}

	/** 套用故障码：填进输入框并立即发一轮（与 web 的 useFaultCode 同款）。 */
	function onUseFaultCode(item : AiDiagnosisFaultCodeItem) : void {
		inputText.value = `故障码 ${item.fault_code}（${item.fault_name}），怎么处理？`
		sendInput(featureTitle.value, buildBody, [], currentFeatureKey.value)
	}

	// 生命周期
	onLoad((options : OnLoadOptions) => {
		const sysInfo = uni.getSystemInfoSync()
		statusBarHeight.value = sysInfo.statusBarHeight
		pageHeight.value = sysInfo.windowHeight

		auth.restoreFromStorage()
		if (!auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}

		// 参数定位，**fail-closed**：键必须命中手写清单（与后端注册表锁一致）。
		// 未知/缺失 ⇒ 不进页 —— 注册表里没有键的入口就是「点了走通用对话」的伪入口
		// （ADR-0009 修订 ② 据此下线了「故障代码查询」），不能靠「悄悄退化成通用对话」把它复活。
		const raw = options['featureKey']
		const item = findFunctionItem(raw != null ? `${raw}` : '')
		if (item == null) {
			uni.showToast({ title: '功能入口不存在', icon: 'none' })
			setTimeout(() => { uni.navigateBack() }, 1500)
			return
		}
		currentFeatureKey.value = item.featureKey
		featureTitle.value = item.title

		// **定位键之后**再拉本区会话（顺序在此承重：先列后定键会拉到遗留区，抽屉就列错区了）
		loadSessions()

		// 诊断功能：进页拉一次品牌清单（全量、无级联依赖）。判据经 isDiagnosis（读 adapter），
		// **不比较功能键字符串** ⇒ 以后新增诊断类功能只需在清单里把 adapter 写成 diagnosis。
		if (isDiagnosis.value) {
			loadBrands()
		}
	})
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		background-color: #dfeffb;
	}

	.status-bar {
		background-color: #ffffff;
	}

	.header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 16rpx 24rpx;
		background-color: #ffffff;
		border-bottom: 1rpx solid #f0f0f0;
	}

	.header-left,
	.header-right {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}

	/* 会话抽屉入口：与通用页导航左侧同一套「面板」视觉；内层给**显式尺寸** ⇒ 有命中区（#947 血账） */
	.panel-icon {
		width: 44rpx;
		height: 36rpx;
		border: 3rpx solid #6b6b6b;
