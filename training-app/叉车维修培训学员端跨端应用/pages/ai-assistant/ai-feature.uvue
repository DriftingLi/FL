	}

	.diag-search-btn {
		font-size: 26rpx;
		color: #6db8e8;
		padding-left: 20rpx;
	}

	/* 故障码结果列表：固定高度（uvue 不支持 max-height 百分比，且滚动容器必须有确定高度） */
	.diag-faults {
