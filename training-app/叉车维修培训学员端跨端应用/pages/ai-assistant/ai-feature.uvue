	}

	.message-text {
		font-size: 28rpx;
		color: #333333;
		line-height: 1.6;
	}

	/* ===== 诊断筛选面板（仅 adapter=diagnosis 的功能渲染）=====
	   样式沿用本仓筛选栏惯例（先例 pages/featured/featured-list.uvue）：横滑 chip 行 +
	   `.filter-chip` / `.filter-chip-text` 的 active 双类；active 类直接落在 text 上，
	   不用 `.a .b` 后代选择器（uvue 支持但有运行时损耗，见 mobile AGENTS.md）。 */
	.diag-bar {
		background-color: #ffffff;
		border-top: 1rpx solid #f0f0f0;
		padding: 12rpx 24rpx;
	}

	.diag-head {
		flex-direction: row;
		align-items: center;
	}

	.diag-head-title {
		font-size: 26rpx;
		color: #333333;
		font-weight: bold;
		margin-right: 16rpx;
	}

	.diag-head-summary {
		flex: 1;
		font-size: 24rpx;
		color: #6db8e8;
	}

	.diag-head-toggle {
		font-size: 24rpx;
		color: #999999;
		padding-left: 16rpx;
	}

	.diag-panel {
		margin-top: 12rpx;
	}

	/* 横滑行：靠 flex-direction: row + 子项 flex-shrink: 0 撑出溢出；勿加 white-space（uvue 只在 <text> / <button> 上支持它，见 AGENTS.md） */
	.diag-chips {
		flex-direction: row;
		align-items: center;
		margin-bottom: 12rpx;
	}

	.filter-chip {
		padding: 10rpx 24rpx;
		border-radius: 32rpx;
		background-color: #f5f5f5;
		margin-right: 12rpx;
		flex-shrink: 0;
	}

	.filter-chip.active {
		background-color: #6db8e8;
	}

	.filter-chip-text {
		font-size: 24rpx;
		color: #666666;
	}

	.filter-chip-text.active {
		color: #ffffff;
	}

	.diag-search {
		flex-direction: row;
		align-items: center;
		background-color: #f5f5f5;
		border-radius: 32rpx;
		padding: 4rpx 20rpx;
