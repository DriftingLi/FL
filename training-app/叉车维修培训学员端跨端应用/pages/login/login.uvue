<template>
    <scroll-view scroll-y class="login-page">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部品牌区 -->
        <view class="header">
            <view class="logo-box">
                <image src="/static/logo.png" mode="aspectFit" style="width: 200rpx; height: 160rpx;"></image>
            </view>
            <text class="app-title">叉车维修培训系统</text>
        </view>

        <view class="form">
            <!-- ===== 账号密码登录（默认） ===== -->
            <template v-if="mode == 'password'">
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" type="text" placeholder="用户名或手机号" :maxlength="50" :value="username"
                            @input="onUsernameInput" @confirm="onConfirm" />
                    </view>
                </view>
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" :password="!passwordVisible" placeholder="请输入密码" :maxlength="32" :value="password"
                            @input="onPasswordInput" @confirm="onConfirm" />
                        <text class="pwd-toggle" @click="togglePasswordVisible">{{ passwordVisible ? '隐藏' : '显示' }}</text>
                    </view>
                </view>
                <!-- 快捷登录入口：有已存凭据 + 设备支持时才展示（生物验证 → 静默续登，ADR-0004） -->
                <view class="form-item biometric-row" v-if="showedStored && biometric.isSupported.value">
                    <text class="biometric-link" @click="onQuickLogin">{{ quickLoginLabel }}</text>
                </view>
            </template>

            <!-- ===== 手机号验证码登录 ===== -->
            <template v-else-if="mode == 'phone'">
                <view class="form-item">
                    <view class="input-wrap">
                        <text class="input-prefix">+86</text>
                        <input class="input-base" type="number" placeholder="请输入手机号" :maxlength="11" :value="phone"
                            @input="onPhoneInput" @confirm="onConfirm" />
                    </view>
                </view>
                <view class="form-item code-row">
                    <view class="code-input-wrap">
                        <view class="input-wrap">
                            <input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
                                :value="phoneCode" @input="onPhoneCodeInput" @confirm="onConfirm" />
                        </view>
                    </view>
                    <button class="code-btn" :class="{ 'code-btn-disabled': sendingCode || countdown > 0 }"
                        :disabled="sendingCode || countdown > 0" @click="onSendCode('phone')">
                        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
                    </button>
                </view>
                <view class="form-item captcha-row">
                    <view class="input-wrap captcha-input-wrap">
                        <input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
                            :value="captchaValue" @input="onCaptchaInput" />
                    </view>
                    <view class="captcha-img captcha-fail-box" v-if="captchaFailed" @click="refreshCaptcha">
                        <text class="captcha-fail-text">加载失败 点击重试</text>
                    </view>
                    <image class="captcha-img" v-else :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
                </view>
                <view class="form-item hint" v-if="codeHint.length > 0">
                    <text class="hint-text">{{ codeHint }}</text>
                </view>
            </template>

            <!-- ===== 微信一键登录 ===== -->
            <template v-else-if="mode == 'wechat'">
                <view class="wx-intro"></view>
            </template>

            <!-- ===== 邮箱验证码登录 ===== -->
            <template v-else>
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" type="text" placeholder="请输入邮箱" :maxlength="50" :value="email"
                            @input="onEmailInput" @confirm="onConfirm" />
                    </view>
                </view>
                <view class="form-item code-row">
                    <view class="code-input-wrap">
                        <view class="input-wrap">
                            <input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
                                :value="emailCode" @input="onEmailCodeInput" @confirm="onConfirm" />
                        </view>
                    </view>
                    <button class="code-btn" :class="{ 'code-btn-disabled': sendingCode || countdown > 0 }"
                        :disabled="sendingCode || countdown > 0" @click="onSendCode('email')">
                        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
                    </button>
                </view>
                <view class="form-item captcha-row">
                    <view class="input-wrap captcha-input-wrap">
                        <input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
                            :value="captchaValue" @input="onCaptchaInput" />
                    </view>
                    <view class="captcha-img captcha-fail-box" v-if="captchaFailed" @click="refreshCaptcha">
                        <text class="captcha-fail-text">加载失败 点击重试</text>
                    </view>
                    <image class="captcha-img" v-else :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
                </view>
                <view class="form-item hint" v-if="codeHint.length > 0">
                    <text class="hint-text">{{ codeHint }}</text>
                </view>
            </template>

            <!-- 协议勾选 + 注册引导（手机号/邮箱/微信方式展示） -->
            <view class="form-item agree-row" v-if="mode != 'password'" @click="toggleAgree">
                <view class="checkbox" :class="{ 'checkbox-checked': agreed }">
                    <text v-if="agreed" class="check-mark">✓</text>
                </view>
                <text class="agree-text">同意</text>
                <text class="agree-link" @click.stop="showAgreement('用户协议')">《用户协议》</text>
                <text class="agree-text">和</text>
                <text class="agree-link" @click.stop="showAgreement('用户隐私')">《用户隐私》</text>
                <text class="agree-text">{{ mode == 'email' ? '若邮箱未注册，' : '若手机号未注册，' }}</text>
                <text class="agree-link" @click.stop="goRegister">立即注册</text>
            </view>
            <!-- 登录按钮 -->
            <button class="btn-login" :class="{ 'btn-login-disabled': loading, 'btn-wechat': mode == 'wechat' }"
                :disabled="loading" @click="onSubmit">
                {{ btnText }}
            </button>

            <!-- 记住账号 + 注册引导 + 忘记密码（仅账号密码模式展示） -->
            <view class="form-item register-row" v-if="mode == 'password'">
                <view class="remember-box" @click="toggleRemember">
                    <view class="checkbox" :class="{ 'checkbox-checked': rememberMe }">
                        <text v-if="rememberMe" class="check-mark">✓</text>
                    </view>
                    <text class="register-text">记住密码</text>
                </view>
                <view class="register-links">
                    <text class="register-text">若手机号未注册，</text>
                    <text class="register-link" @click="goRegister">即刻注册</text>
                    <text class="register-sep">·</text>
                    <text class="register-link" @click="goForgotPassword">忘记密码</text>
                </view>
            </view>


        </view>

        <!-- 底部登录方式切换：手机号 / 微信（仅小程序端，App 未配微信 SDK） / 邮箱 -->
        <view class="mode-switch">
            <text class="mode-link" :class="{ 'mode-link-active': mode == 'phone' }" @click="switchMode('phone')">手机验证码</text>
            <!-- #ifdef MP-WEIXIN -->
            <text class="mode-sep">|</text>
            <text class="mode-link" :class="{ 'mode-link-active': mode == 'wechat' }" @click="switchMode('wechat')">微信登录</text>
            <!-- #endif -->
            <text class="mode-sep">|</text>
            <text class="mode-link" :class="{ 'mode-link-active': mode == 'email' }" @click="switchMode('email')">邮箱验证码</text>
        </view>

        <!-- 切回账号密码登录的小入口：仅在非密码模式下显示 -->
        <view class="back-password" v-if="mode != 'password'" @click="switchMode('password')">
            <text class="back-password-link">账号密码登录</text>
        </view>

        <!-- 招聘者入口：纯文字链接，复用既有 link 样式（ADR-0022 ② / ④ 步骤 P1） -->
        <view class="recruiter-entry" @click="goRecruiterLogin">
            <text class="back-password-link">招聘者登录</text>
        </view>
    </scroll-view>
</template>

<script setup lang="uts">
    import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { useBiometric } from '../../composables/useBiometric'
    import { useLoginForm } from './composables/useLoginForm'
    import { useBiometricGate } from './composables/useBiometricGate'

    const auth = useAuthStore()
    // 生物识别实例只有一个：门控 checkSupport 写入的 isSupported 与模板读取的必须是同一份
    const biometric = useBiometric()

    // 表单态（登录方式 / 验证码 / 提交），模板绑定的符号一律解构成本地绑定 ——
    // 模板因此可以**逐字节不变**（UI 像素级冻结的最强证据面），无需 reg.xxx.value 改写
    const {
        statusBarHeight,
        mode,
        phone,
        phoneCode,
        username,
        password,
        passwordVisible,
        rememberMe,
        email,
        emailCode,
        agreed,
        captchaImage,
        captchaValue,
        captchaFailed,
        loading,
        sendingCode,
        countdown,
        codeHint,
        btnText,
        loadCaptcha,
        clearCountdownTimer,
        switchMode,
        toggleAgree,
        togglePasswordVisible,
        showAgreement,
        refreshCaptcha,
        onSendCode,
        onSubmit,
        onConfirm,
        goRegister,
        goForgotPassword,
        goRecruiterLogin,
    } = useLoginForm(biometric)

    // 生物识别门控面（回填 / 快捷登录 / 取消勾选清除），凭据 ref 由表单态注入
    const { showedStored, quickLoginLabel, initBiometricGate, onQuickLogin, toggleRemember } = useBiometricGate(biometric, username, password, rememberMe)

    onLoad((options : OnLoadOptions) => {
        const sysInfo = uni.getSystemInfoSync()
        statusBarHeight.value = sysInfo.statusBarHeight

        auth.restoreFromStorage()
        if (auth.isLoggedIn.value) {
            uni.reLaunch({ url: '/pages/dashboard/dashboard' })
            return
        }
        loadCaptcha()
        initBiometricGate()
    })


    onShow(() => {
        // 从注册页返回时保留已填手机号
    })

    onUnload(() => {
        clearCountdownTimer()
    })

    function onPhoneInput(e : InputEvent) : void {
        phone.value = e.detail.value
    }

    function onPhoneCodeInput(e : InputEvent) : void {
        phoneCode.value = e.detail.value
    }

    function onUsernameInput(e : InputEvent) : void {
        username.value = e.detail.value
    }

    function onPasswordInput(e : InputEvent) : void {
        password.value = e.detail.value
    }

    function onEmailInput(e : InputEvent) : void {
        email.value = e.detail.value
    }

    function onEmailCodeInput(e : InputEvent) : void {
        emailCode.value = e.detail.value
    }

    function onCaptchaInput(e : InputEvent) : void {
        captchaValue.value = e.detail.value
    }
</script>

<style lang="scss">
    .login-page {
        flex: 1;
        background-color: #ffffff;
    }

    .status-bar {
        background-color: #ffffff;
    }

    /* ===== 顶部品牌区 ===== */
    .header {
        align-items: center;
        padding: 70rpx 0 60rpx 0;
    }

    .logo-box {
        position: relative;
        width: 200rpx;
        height: 200rpx;
    }

    .app-title {
        margin-top: 28rpx;
        font-size: 44rpx;
        font-weight: bold;
        color: #333333;
        text-align: center;
    }

    /* ===== 表单区 ===== */
    .form {
        padding: 0 56rpx;
    }

    .form-item {
        margin-bottom: 28rpx;
    }

    /* 灰底圆角输入框 */
    .input-wrap {
        flex-direction: row;
        align-items: center;
        background-color: #F5F6FA;
        border-radius: 16rpx;
        height: 96rpx;
        padding: 0 28rpx;
    }

    .input-prefix {
        font-size: 32rpx;
        color: #333333;
        font-weight: bold;
        margin-right: 16rpx;
        border-right: 2rpx solid #E0E2EA;
        padding-right: 16rpx;
    }

    .input-base {
        flex: 1;
        height: 96rpx;
        border: none;
        background-color: transparent;
        padding: 0;
        font-size: 30rpx;
        color: #333333;
    }

    /* 密码显隐切换 */
    .pwd-toggle {
        font-size: 26rpx;
        color: #999999;
        padding-left: 16rpx;
    }

    /* 验证码行：输入框 + 获取验证码按钮 */
    .code-row {
        flex-direction: row;
        align-items: center;
    }

    .code-input-wrap {
        flex: 1;
        margin-right: 20rpx;
    }

    .code-btn {
        width: 200rpx;
        height: 96rpx;
        line-height: 96rpx;
        padding: 0;
        font-size: 26rpx;
        color: #2979ff;
        background-color: #ffffff;
        border: 2rpx solid #2979ff;
        border-radius: 48rpx;
        text-align: center;
    }

    .code-btn-disabled {
        opacity: 0.5;
    }

    /* 图形验证码行：输入框 + 图片 */
    .captcha-row {
        flex-direction: row;
        align-items: center;
    }

    .captcha-input-wrap {
        flex: 1;
        margin-right: 20rpx;
    }

    .captcha-input {
        font-size: 26rpx;
    }

    .captcha-img {
        width: 180rpx;
        height: 96rpx;
        border-radius: 16rpx;
        background-color: #F5F6FA;
    }

    /* 图形验证码加载失败占位 */
    .captcha-fail-box {
        align-items: center;
        justify-content: center;
    }

    .captcha-fail-text {
        font-size: 22rpx;
        color: #999999;
        text-align: center;
    }

    /* 验证码规则提示 */
    .hint {
        margin-top: -16rpx;
        margin-bottom: 16rpx;
    }

    .hint-text {
        font-size: 22rpx;
        color: #999999;
    }

    /* ===== 微信一键登录展示区 ===== */
    .wx-intro {
        align-items: center;
        padding: 60rpx 0 40rpx 0;
    }

    /* 协议行 */
    .agree-row {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 8rpx;
    }

    .checkbox {
        width: 34rpx;
        height: 34rpx;
        border-radius: 50%;
        border: 2rpx solid #C8CDD8;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        margin-right: 12rpx;
    }

    .checkbox-checked {
        background-color: #2979ff;
        border-color: #2979ff;
    }

    .check-mark {
        font-size: 24rpx;
        color: #ffffff;
    }

    .agree-text {
        font-size: 25rpx;
        color: #666666;
    }

    .agree-link {
        color: #2979ff;
    }

    /* 记住账号 + 注册引导（左侧勾选，右侧链接） */
    .register-row {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-top: -4rpx;
    }

    .remember-box {
        flex-direction: row;
        align-items: center;
    }

    .register-links {
        flex-direction: row;
        align-items: center;
    }

    .register-text {
        font-size: 25rpx;
        color: #666666;
    }

    .register-link {
        color: #2979ff;
    }

    /* 生物识别回填入口 */
    .biometric-row {
        margin-top: -12rpx;
        margin-bottom: 20rpx;
    }

    .biometric-link {
        font-size: 26rpx;
        color: #2979ff;
        border-bottom-width: 1rpx;
        border-bottom-style: solid;
        border-bottom-color: #2979ff;
        padding-bottom: 2rpx;
    }

    .register-sep {
        margin: 0 10rpx;
        color: #C8CDD8;
    }

    /* 登录按钮 */
    .btn-login {
        margin-top: 24rpx;
        width: 100%;
        height: 96rpx;
        line-height: 96rpx;
        border-radius: 48rpx;
        background-color: #2979ff;
        color: #ffffff;
        font-size: 34rpx;
        font-weight: bold;
        text-align: center;
        border: none;
    }

    /* 微信模式下按钮改用微信绿 */
    .btn-login.btn-wechat {
        background-color: #07C160;
    }

    .btn-login-disabled {
        opacity: 0.6;
    }

    /* ===== 底部登录方式切换 ===== */
    .mode-switch {
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 60rpx 0 30rpx 0;
    }

    .mode-link {
        font-size: 28rpx;
        color: #666666;
        padding: 12rpx 20rpx;
    }

    .mode-link-active {
        color: #2979ff;
        font-weight: bold;
    }

    .mode-sep {
        font-size: 28rpx;
        color: #C8CDD8;
    }

    /* ===== 切回账号密码登录入口 ===== */
    .back-password {
        align-items: center;
        padding: 20rpx 0 60rpx 0;
    }

    /* ===== 招聘者入口（纯文字链接，复用 .back-password-link 外观） ===== */
    .recruiter-entry {
        align-items: center;
        padding: 0 0 60rpx 0;
    }

    .back-password-link {
        font-size: 26rpx;
        color: #2979ff;
        border-bottom-width: 1rpx;
        border-bottom-style: solid;
        border-bottom-color: #2979ff;
        padding-bottom: 2rpx;
    }
</style>