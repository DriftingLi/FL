<template>
    <scroll-view scroll-y class="login-page">
        <view class="status-bar" :style="{ height: safeArea.statusBarHeight + 'px' }"></view>

        <!-- 居中品牌区（#2517 截图 1:1）：logo + 标题，无副标题。
             头部段零可点元素——自绘头部无页头件的胶囊让位保护（batch6 N06 负面机检） -->
        <view class="header">
            <view class="logo-box">
                <image class="logo" src="/static/logo.png" mode="aspectFit"></image>
            </view>
            <text class="app-title">叉车维修培训系统</text>
        </view>

        <view class="form">
            <!-- ===== 学员 · 验证码通道（手机 / 邮箱） ===== -->
            <template v-if="role == 'learner' && mode != 'password'">
                <view class="field" v-if="mode == 'phone'">
                    <text class="prefix">+86</text>
                    <input class="field-input" type="number" placeholder="请输入手机号" :maxlength="11" :value="phone"
                        @input="onPhoneInput" @confirm="onConfirm" />
                </view>
                <view class="field" v-else>
                    <input class="field-input" type="text" placeholder="请输入邮箱" :maxlength="50" :value="email"
                        @input="onEmailInput" @confirm="onConfirm" />
                </view>
                <view class="field">
                    <input class="field-input" type="number" placeholder="请输入验证码" :maxlength="6"
                        :value="mode == 'phone' ? phoneCode : emailCode" @input="onCodeInput" @confirm="onConfirm" />
                    <button class="inline-btn" :class="{ 'inline-btn-disabled': sendingCode || countdown > 0 }"
                        :disabled="sendingCode || countdown > 0" @click="onSendCode(mode)">
                        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
                    </button>
                </view>
                <!-- 人机验证：默认收起，点「获取验证码」就地展开（生产强制，config.go:338） -->
                <view class="cap-row" v-if="captchaOpen">
                    <input class="cap-input" type="text" placeholder="输入图形码" :maxlength="4" :value="captchaValue"
                        @input="onCaptchaInput" @confirm="onConfirm" />
                    <view class="cap-img-box cap-fail-box" v-if="captchaFailed" @click="refreshCaptcha">
                        <text class="cap-fail-text">点击重试</text>
                    </view>
                    <image class="cap-img-box" v-else :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" :webp="true" />
                </view>
                <view class="hint" v-if="codeHint.length > 0">
                    <text class="hint-text">{{ codeHint }}</text>
                </view>
            </template>

            <!-- ===== 学员 · 账号密码 ===== -->
            <template v-else-if="role == 'learner'">
                <view class="field">
                    <input class="field-input" type="text" placeholder="用户名或手机号" :maxlength="50" :value="username"
                        @input="onUsernameInput" @confirm="onConfirm" />
                </view>
                <view class="field">
                    <input class="field-input" :password="!passwordVisible" placeholder="请输入密码" :maxlength="32" :value="password"
                        @input="onPasswordInput" @confirm="onConfirm" />
                    <text class="pwd-toggle" @click="togglePasswordVisible">{{ passwordVisible ? '隐藏' : '显示' }}</text>
                </view>
                <!-- 快捷登录入口：有已存凭据 + 设备支持时才展示（生物验证 → 静默续登，ADR-0004） -->
                <view class="biometric-row" v-if="showedStored && biometric.isSupported.value">
                    <text class="biometric-link" @click="onQuickLogin">{{ quickLoginLabel }}</text>
                </view>
                <!-- 记住密码 + 忘记密码 -->
                <view class="meta-row">
                    <view class="remember-box" @click="toggleRemember">
                        <view class="checkbox" :class="{ 'checkbox-checked': rememberMe }">
                            <text v-if="rememberMe" class="check-mark">✓</text>
                        </view>
                        <text class="meta-text">记住密码</text>
                    </view>
                    <text class="meta-link" @click="goForgotPassword">忘记密码</text>
                </view>
                <view class="register-line">
                    <text class="meta-text">若手机号未注册，</text>
                    <text class="meta-link" @click="goRegister">立即注册</text>
                </view>
            </template>

            <!-- ===== 招聘者 · 账号密码（邀约制，走真实 B 端登录接口） ===== -->
            <template v-else>
                <view class="field">
                    <input class="field-input" type="text" placeholder="请输入招聘者账号" :maxlength="50"
                        :value="recruiterAccount" @input="onRecruiterAccountInput" @confirm="onConfirm" />
                </view>
                <view class="field">
                    <input class="field-input" :password="!recruiterPasswordVisible" placeholder="请输入密码" :maxlength="32"
                        :value="recruiterPassword" @input="onRecruiterPasswordInput" @confirm="onConfirm" />
                    <text class="pwd-toggle" @click="toggleRecruiterPasswordVisible">{{ recruiterPasswordVisible ? '隐藏' : '显示' }}</text>
                </view>
                <view class="hint">
                    <text class="hint-text">邀约制账号 · 忘记密码请联系平台管理员</text>
                </view>
            </template>

            <!-- 协议勾选 + 注册引导：仅学员验证码通道（账号密码 / 招聘者不强制）
                 #1478 抽成共享件 components/login-agreement（与着陆页同源同文案） -->
            <LoginAgreement v-if="role == 'learner' && mode != 'password'" :channel="mode" :agreed="agreed"
                :accent="agreementAccent" @toggle="toggleAgree" @agreement="showAgreement" @register="goRegister" />

            <!-- 角色切换（#2517 截图位：登录按钮上方） -->
            <view class="role-row">
                <view class="role-pill" :class="{ 'role-pill-on': role == 'learner' }" @click="switchRole('learner')">
                    <text class="role-text" :class="{ 'role-text-on': role == 'learner' }">学员</text>
                </view>
                <view class="role-pill" :class="{ 'role-pill-on': role == 'recruiter' }" @click="switchRole('recruiter')">
                    <text class="role-text" :class="{ 'role-text-on': role == 'recruiter' }">招聘者</text>
                </view>
            </view>

            <!-- 登录按钮 -->
            <button class="btn-login" :class="{ 'btn-login-disabled': loading }"
                :disabled="loading" @click="onSubmit">
                {{ btnText }}
            </button>

            <!-- 底部三图标：手机 / 微信 / 邮箱（学员侧通道入口，替代原顶部通道 tab） -->
            <view class="icon-row" v-if="role == 'learner'">
                <view class="icon-cell" @click="switchMode('phone')">
                    <view class="icon-circle" :class="{ 'icon-circle-on': mode == 'phone' }">
                        <text class="icon-glyph">📱</text>
                    </view>
                </view>
                <view class="icon-cell" @click="goWechatLanding">
                    <view class="icon-circle icon-circle-wechat">
                        <image class="icon-img" src="/static/wechat-logo.png" mode="aspectFit"></image>
                    </view>
                </view>
                <view class="icon-cell" @click="switchMode('email')">
                    <view class="icon-circle" :class="{ 'icon-circle-on': mode == 'email' }">
                        <text class="icon-glyph">✉</text>
                    </view>
                </view>
            </view>

            <!-- 密码登录 / 验证码登录 小字（生物识别入口的宿主，截图外新增） -->
            <view class="small-row" v-if="role == 'learner'">
                <text class="small-link" @click="togglePasswordMode">{{ mode == 'password' ? '验证码登录' : '密码登录' }}</text>
            </view>
        </view>

        <!-- 底部说明（招聘者入口已上移为角色切换器，不再留文字链） -->
        <view class="footer">
            <view class="footer-line"></view>
            <text class="footer-text">叉车维修培训系统 · 学员端</text>
        </view>
    </scroll-view>
</template>

<script setup lang="uts">
    import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { useBiometric } from '../../composables/useBiometric'
    import { useLoginForm } from './composables/useLoginForm'
    import { useBiometricGate } from './composables/useBiometricGate'
    import { useSafeArea } from '../../utils/system'
    import LoginAgreement from '../../components/login-agreement/login-agreement.uvue'

    const auth = useAuthStore()
    // N06 自垫状态栏：高度取自 utils/system.uts 唯一真源（#1602/#1609），页面不再自行探测
    const safeArea = useSafeArea()
    // 生物识别实例只有一个：门控 checkSupport 写入的 isSupported 与模板读取的必须是同一份
    const biometric = useBiometric()

    // 表单态（角色 / 登录方式 / 验证码 / 提交），模板绑定的符号一律解构成本地绑定
    const {
        role,
        mode,
        phone,
        phoneCode,
        username,
        password,
        passwordVisible,
        rememberMe,
        email,
        emailCode,
        agreed,
        captchaOpen,
        captchaImage,
        captchaValue,
        captchaFailed,
        recruiterAccount,
        recruiterPassword,
        recruiterPasswordVisible,
        agreementAccent,
        loading,
        sendingCode,
        countdown,
        codeHint,
        btnText,
        clearCountdownTimer,
        switchMode,
        switchRole,
        togglePasswordMode,
        toggleAgree,
        togglePasswordVisible,
        toggleRecruiterPasswordVisible,
        showAgreement,
        refreshCaptcha,
        onSendCode,
        onSubmit,
        onConfirm,
        goRegister,
        goForgotPassword,
    } = useLoginForm(biometric)

    // 生物识别门控面（回填 / 快捷登录 / 取消勾选清除），凭据 ref 由表单态注入
    const { showedStored, quickLoginLabel, initBiometricGate, onQuickLogin, toggleRemember } = useBiometricGate(biometric, username, password, rememberMe)

    onLoad((options : OnLoadOptions) => {
        auth.restoreFromStorage()
        if (auth.isLoggedIn.value) {
            uni.reLaunch({ url: '/pages/dashboard/dashboard' })
            return
        }
        // 图形验证码改为延迟加载：点「获取验证码」展开人机验证行时才拉图（#2517）
        initBiometricGate()
    })


    onShow(() => {
        // 从注册页返回时保留已填手机号
    })

    onUnload(() => {
        clearCountdownTimer()
    })

    function onPhoneInput(e : InputEvent) : void {
        phone.value = e.detail.value
    }

    function onCodeInput(e : InputEvent) : void {
        if (mode.value == 'phone') {
            phoneCode.value = e.detail.value
        } else {
            emailCode.value = e.detail.value
        }
    }

    function onUsernameInput(e : InputEvent) : void {
        username.value = e.detail.value
    }

    function onPasswordInput(e : InputEvent) : void {
        password.value = e.detail.value
    }

    function onEmailInput(e : InputEvent) : void {
        email.value = e.detail.value
    }

    function onRecruiterAccountInput(e : InputEvent) : void {
        recruiterAccount.value = e.detail.value
    }

    function onRecruiterPasswordInput(e : InputEvent) : void {
        recruiterPassword.value = e.detail.value
    }

    function onCaptchaInput(e : InputEvent) : void {
        captchaValue.value = e.detail.value
    }

    // 切回欢迎页走 reLaunch：401 顶出场景页面栈里只有登录页自身，navigateBack 无处可回（#1908）
    function goWechatLanding() : void {
        uni.reLaunch({ url: '/pages/index/index' })
    }
</script>

<style lang="scss">
    .login-page { flex: 1; background-color: #ffffff; }

    .status-bar { background-color: $bg-header; }

    /* ===== 居中品牌区（#2517 截图 1:1） ===== */
    .header { align-items: center; padding: 56rpx 48rpx 0 48rpx; }

    /* Logo 托底：浅灰圆角块把彩色标志收成「应用图标」 */
    .logo-box {
        width: 132rpx;
        height: 132rpx;
        border-radius: 32rpx;
        background-color: #F5F7FA;
        align-items: center;
        justify-content: center;
    }

    .logo { width: 96rpx; height: 76rpx; }

    .app-title { margin-top: 24rpx; font-size: 40rpx; font-weight: bold; color: $text-strong; }

    /* ===== 表单区 ===== */
    .form { padding: 56rpx 48rpx 0 48rpx; }

    /* 统一输入框：灰底、104rpx 高、24rpx 圆角 */
    .field {
        flex-direction: row;
        align-items: center;
        height: 104rpx;
        background-color: #F5F7FA;
        border-radius: 24rpx;
        padding: 0 28rpx;
        margin-bottom: 24rpx;
    }

    .field-input {
        flex: 1;
        height: 104rpx;
        border: none;
        background-color: transparent;
        padding: 0;
        font-size: 30rpx;
        color: $text-strong;
    }

    .prefix {
        font-size: 28rpx;
        font-weight: bold;
        color: $text-strong;
        padding-right: 16rpx;
        margin-right: 20rpx;
        border-right: 2rpx solid $border-color;
    }

    .pwd-toggle { font-size: 26rpx; color: $primary-color; padding-left: 16rpx; }

    /* 验证码内嵌按钮：主色浅底胶囊（比白底描边更轻，不抢主按钮） */
    .inline-btn {
        width: 188rpx;
        height: 64rpx;
        line-height: 64rpx;
        padding: 0;
        margin-left: 20rpx;
        font-size: 26rpx;
        color: $primary-color;
        background-color: $primary-tint;
        border: none;
        border-radius: 32rpx;
        text-align: center;
    }

    /* 发送中 / 倒计时：退回中性灰，不再靠整块透明度 */
    .inline-btn-disabled { color: $text-color-placeholder; background-color: #F5F7FA; }

    /* 人机验证就地展开行：输入框在左、码图在右（#2517 裁定 A） */
    .cap-row {
        flex-direction: row;
        align-items: center;
        height: 104rpx;
        background-color: #F5F7FA;
        border-radius: 24rpx;
        padding: 0 28rpx;
        margin-bottom: 24rpx;
    }

    .cap-input {
        flex: 1;
        height: 104rpx;
        border: none;
        background-color: transparent;
        padding: 0;
        font-size: 30rpx;
        color: $text-strong;
    }

    .cap-img-box {
        width: 176rpx;
        height: 72rpx;
        border-radius: 16rpx;
        margin-left: 20rpx;
        background-color: #ffffff;
    }

    .cap-fail-box { align-items: center; justify-content: center; }

    .cap-fail-text { font-size: 20rpx; color: $text-color-placeholder; text-align: center; }

    /* 验证码规则提示 */
    .hint { margin-top: -8rpx; margin-bottom: 8rpx; }

    .hint-text { font-size: 22rpx; color: $text-color-placeholder; }

    /* ===== 账号密码模式的辅助行 ===== */
    .biometric-row { align-items: flex-start; margin-top: -8rpx; margin-bottom: 20rpx; }

    .biometric-link {
        font-size: 26rpx;
        color: $primary-color;
        border-bottom: 1rpx dashed $primary-color;
        padding-bottom: 2rpx;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20rpx;
    }

    .remember-box { flex-direction: row; align-items: center; padding: 30rpx 0; }

    .checkbox {
        width: 34rpx;
        height: 34rpx;
        border-radius: 50%;
        border: 2rpx solid #C8CDD8;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        margin-right: 12rpx;
    }

    .checkbox-checked { background-color: $primary-color; border-color: $primary-color; }

    .check-mark { font-size: 24rpx; color: #ffffff; }

    .meta-text { font-size: 25rpx; color: $text-color-secondary; }

    .meta-link { font-size: 25rpx; color: $primary-color; }

    .register-line { flex-direction: row; align-items: center; margin-bottom: 8rpx; }

    /* ===== 角色切换（学员 / 招聘者，截图位在登录按钮上方） ===== */
    .role-row { flex-direction: row; justify-content: center; margin-top: 8rpx; margin-bottom: 24rpx; }

    .role-pill {
        height: 88rpx;
        padding: 0 40rpx;
        border-radius: 44rpx;
        align-items: center;
        justify-content: center;
        background-color: #F5F7FA;
        margin: 0 12rpx;
    }

    .role-pill-on { background-color: $primary-tint; }

    .role-text { font-size: 26rpx; color: $text-color-secondary; }

    .role-text-on { color: $primary-color; font-weight: bold; }

    /* ===== 主登录按钮 ===== */
    .btn-login {
        margin-top: 16rpx;
        width: 100%;
        height: 108rpx;
        line-height: 108rpx;
        border-radius: 54rpx;
        background-color: $primary-color;
        box-shadow: 0 12rpx 28rpx rgba(35, 158, 221, 0.28);
        color: #ffffff;
        font-size: 32rpx;
        font-weight: bold;
        text-align: center;
        border: none;
    }

    .btn-login-disabled { opacity: 0.6; }

    /* ===== 底部三图标：手机 / 微信 / 邮箱 ===== */
    .icon-row { flex-direction: row; justify-content: center; margin-top: 40rpx; }

    .icon-cell { padding: 8rpx 24rpx; }

    .icon-circle {
        width: 88rpx;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: #F5F7FA;
        align-items: center;
        justify-content: center;
    }

    .icon-circle-on { background-color: $primary-tint; }

    .icon-circle-wechat { background-color: $success-tint; }

    .icon-glyph { font-size: 36rpx; color: $text-color-secondary; }

    .icon-img { width: 44rpx; height: 44rpx; }

    /* ===== 密码登录 / 验证码登录 小字 ===== */
    .small-row { align-items: center; margin-top: 24rpx; }

    .small-link { font-size: 24rpx; color: $primary-color; padding: 16rpx 0; }

    /* ===== 底部说明 ===== */
    .footer { margin-top: 48rpx; padding: 0 48rpx 48rpx 48rpx; }

    /* 分隔线用独立 view（uvue 未验证 border-top-* 支持） */
    .footer-line { height: 2rpx; background-color: $border-color-light; }

    .footer-text { margin-top: 24rpx; font-size: 24rpx; color: $text-color-placeholder; text-align: center; }
</style>
