<template>
    <scroll-view scroll-y class="login-page">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部品牌区 -->
        <view class="header">
            <view class="logo-box">
                <image src="/static/logo.png" mode="aspectFit" style="width: 200rpx; height: 160rpx;"></image>
            </view>
            <text class="app-title">叉车维修培训系统</text>
        </view>

        <view class="form">
            <!-- ===== 账号密码登录（默认） ===== -->
            <template v-if="mode == 'password'">
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" type="text" placeholder="用户名或手机号" :maxlength="50" :value="username"
                            @input="onUsernameInput" @confirm="onConfirm" />
                    </view>
                </view>
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" :password="!passwordVisible" placeholder="请输入密码" :maxlength="32" :value="password"
                            @input="onPasswordInput" @confirm="onConfirm" />
                        <text class="pwd-toggle" @click="togglePasswordVisible">{{ passwordVisible ? '隐藏' : '显示' }}</text>
                    </view>
                </view>
                <!-- 快捷登录入口：有已存凭据 + 设备支持时才展示（生物验证 → 静默续登，ADR-0004） -->
                <view class="form-item biometric-row" v-if="showedStored && biometric.isSupported.value">
                    <text class="biometric-link" @click="onQuickLogin">{{ quickLoginLabel }}</text>
                </view>
            </template>

            <!-- ===== 手机号验证码登录 ===== -->
            <template v-else-if="mode == 'phone'">
                <view class="form-item">
                    <view class="input-wrap">
                        <text class="input-prefix">+86</text>
                        <input class="input-base" type="number" placeholder="请输入手机号" :maxlength="11" :value="phone"
                            @input="onPhoneInput" @confirm="onConfirm" />
                    </view>
                </view>
                <view class="form-item code-row">
                    <view class="code-input-wrap">
                        <view class="input-wrap">
                            <input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
                                :value="phoneCode" @input="onPhoneCodeInput" @confirm="onConfirm" />
                        </view>
                    </view>
                    <button class="code-btn" :class="{ 'code-btn-disabled': sendingCode || countdown > 0 }"
                        :disabled="sendingCode || countdown > 0" @click="onSendCode('phone')">
                        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
                    </button>
                </view>
                <view class="form-item captcha-row">
                    <view class="input-wrap captcha-input-wrap">
                        <input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
                            :value="captchaValue" @input="onCaptchaInput" />
                    </view>
                    <view class="captcha-img captcha-fail-box" v-if="captchaFailed" @click="refreshCaptcha">
                        <text class="captcha-fail-text">加载失败 点击重试</text>
                    </view>
                    <image class="captcha-img" v-else :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
                </view>
                <view class="form-item hint" v-if="codeHint.length > 0">
                    <text class="hint-text">{{ codeHint }}</text>
                </view>
            </template>

            <!-- ===== 微信一键登录 ===== -->
            <template v-else-if="mode == 'wechat'">
                <view class="wx-intro"></view>
            </template>

            <!-- ===== 邮箱验证码登录 ===== -->
            <template v-else>
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" type="text" placeholder="请输入邮箱" :maxlength="50" :value="email"
                            @input="onEmailInput" @confirm="onConfirm" />
                    </view>
                </view>
                <view class="form-item code-row">
                    <view class="code-input-wrap">
                        <view class="input-wrap">
                            <input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
                                :value="emailCode" @input="onEmailCodeInput" @confirm="onConfirm" />
                        </view>
                    </view>
                    <button class="code-btn" :class="{ 'code-btn-disabled': sendingCode || countdown > 0 }"
                        :disabled="sendingCode || countdown > 0" @click="onSendCode('email')">
                        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
                    </button>
                </view>
                <view class="form-item captcha-row">
                    <view class="input-wrap captcha-input-wrap">
                        <input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
                            :value="captchaValue" @input="onCaptchaInput" />
                    </view>
                    <view class="captcha-img captcha-fail-box" v-if="captchaFailed" @click="refreshCaptcha">
                        <text class="captcha-fail-text">加载失败 点击重试</text>
                    </view>
                    <image class="captcha-img" v-else :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
                </view>
                <view class="form-item hint" v-if="codeHint.length > 0">
                    <text class="hint-text">{{ codeHint }}</text>
                </view>
            </template>

            <!-- 协议勾选 + 注册引导（手机号/邮箱/微信方式展示） -->


            <!-- 角色选择：学习者 / 招聘者 -->
            <view class="form-item role-selector">
                <view class="role-btn" :class="{ 'role-btn-active': roleType == 'student' }"
                    @click="switchRole('student')">
                    <text class="role-btn-text" :class="{ 'role-btn-text-active': roleType == 'student' }">学习者</text>
                </view>
                <view class="role-btn" :class="{ 'role-btn-active': roleType == 'recruiter' }"
                    @click="switchRole('recruiter')">
                    <text class="role-btn-text" :class="{ 'role-btn-text-active': roleType == 'recruiter' }">招聘者</text>
                </view>
            </view>
            <view class="form-item agree-row" v-if="mode != 'password'" @click="toggleAgree">
                <view class="checkbox" :class="{ 'checkbox-checked': agreed }">
                    <text v-if="agreed" class="check-mark">✓</text>
                </view>
                <text class="agree-text">同意</text>
                <text class="agree-link" @click.stop="showAgreement('用户协议')">《用户协议》</text>
                <text class="agree-text">和</text>
                <text class="agree-link" @click.stop="showAgreement('用户隐私')">《用户隐私》</text>
                <text class="agree-text">{{ mode == 'email' ? '若邮箱未注册，' : '若手机号未注册，' }}</text>
                <text class="agree-link" @click.stop="goRegister">立即注册</text>
            </view>
            <!-- 登录按钮 -->
            <button class="btn-login" :class="{ 'btn-login-disabled': loading, 'btn-wechat': mode == 'wechat' }"
                :disabled="loading" @click="onSubmit">
                {{ btnText }}
            </button>

            <!-- 记住账号 + 注册引导 + 忘记密码（仅账号密码模式展示） -->
            <view class="form-item register-row" v-if="mode == 'password'">
                <view class="remember-box" @click="toggleRemember">
                    <view class="checkbox" :class="{ 'checkbox-checked': rememberMe }">
                        <text v-if="rememberMe" class="check-mark">✓</text>
                    </view>
                    <text class="register-text">记住密码</text>
                </view>
                <view class="register-links">
                    <text class="register-text">若手机号未注册，</text>
                    <text class="register-link" @click="goRegister">即刻注册</text>
                    <text class="register-sep">·</text>
                    <text class="register-link" @click="goForgotPassword">忘记密码</text>
                </view>
            </view>


        </view>

        <!-- 底部登录方式切换：手机号 / 微信（仅小程序端，App 未配微信 SDK） / 邮箱 -->
        <view class="mode-switch">
            <text class="mode-link" :class="{ 'mode-link-active': mode == 'phone' }" @click="switchMode('phone')">手机验证码</text>
            <!-- #ifdef MP-WEIXIN -->
            <text class="mode-sep">|</text>
            <text class="mode-link" :class="{ 'mode-link-active': mode == 'wechat' }" @click="switchMode('wechat')">微信登录</text>
            <!-- #endif -->
            <text class="mode-sep">|</text>
            <text class="mode-link" :class="{ 'mode-link-active': mode == 'email' }" @click="switchMode('email')">邮箱验证码</text>
        </view>

        <!-- 切回账号密码登录的小入口：仅在非密码模式下显示 -->
        <view class="back-password" v-if="mode != 'password'" @click="switchMode('password')">
            <text class="back-password-link">账号密码登录</text>
        </view>
    </scroll-view>
</template>

<script setup lang="uts">
    import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
    import { ref, computed } from 'vue'
    import { useAuthStore } from '../../stores/auth'
    import { sendCodeApi, getCaptchaApi } from '../../api/auth'
    import { hasStoredCredentials, loadSecureCredentials, loadSecureToken, saveSecureCredentials, saveAccountOnly, loadSavedAccount, clearSecureCredentials } from '../../utils/secureStorage'
    import { useBiometric } from '../../composables/useBiometric'

    const auth = useAuthStore()
    const biometric = useBiometric()

    // 登录方式：password（账号密码，默认） | phone（手机验证码） | wechat（微信一键） | email（邮箱验证码）
    const mode = ref<string>('phone')

    // 用户角色：student（学员）| recruiter（招聘者）
    const roleType = ref<string>('student')

    // 手机号 + 验证码
    const phone = ref<string>('')
    const phoneCode = ref<string>('')
    // 账号 + 密码
    const username = ref<string>('')
    const password = ref<string>('')
    // 密码明文切换 + 记住密码（勾选后保存凭据，下次通过生物识别回填）
    const passwordVisible = ref<boolean>(false)
    const rememberMe = ref<boolean>(false)
    // 生物识别回填入口：有已存凭据且验证通过才展示
    const showedStored = ref<boolean>(false)
    // 邮箱 + 验证码
    const email = ref<string>('')
    const emailCode = ref<string>('')

    // 协议勾选
    const agreed = ref<boolean>(false)

    // 图形验证码（人机验证，生产环境发送短信/邮箱验证码前必填）
    const captchaId = ref<string>('')
    const captchaImage = ref<string>('')
    const captchaValue = ref<string>('')
    const captchaLoading = ref<boolean>(false)
    const captchaFailed = ref<boolean>(false)

    /** 加载图形验证码（进入页面/切换方式/点击图片刷新）；失败展示"点击重试"占位 */
    async function loadCaptcha() : Promise<void> {
        if (captchaLoading.value) return
        captchaLoading.value = true
        try {
            const data = await getCaptchaApi()
            captchaId.value = data['id'] as string
            captchaImage.value = data['image'] as string
            captchaValue.value = ''
            captchaFailed.value = false
        } catch (e) {
            console.error('[login] load captcha failed:', e)
            captchaFailed.value = true
        } finally {
            captchaLoading.value = false
        }
    }

    function refreshCaptcha() : void {
        loadCaptcha()
    }

    const loading = ref<boolean>(false)
    const sendingCode = ref<boolean>(false)
    const countdown = ref<number>(0)
    let countdownTimer : number | null = null

    /** 清理倒计时定时器（局部副本承接：Kotlin 禁止对闭包中修改的 var 智能转换） */
    function clearCountdownTimer() : void {
        const timer = countdownTimer
        if (timer != null) {
            clearInterval(timer)
            countdownTimer = null
        }
    }

    const statusBarHeight = ref<number>(20)

    /**
     * 生物门控初始化（onLoad 异步段，ADR-0004）：
     * 检测支持性 → 孤儿凭据自愈 → 脱敏入口/账号回填。
     * 入口显隐与回填必须等支持性结果确定性返回后再判定，
     * 否则会拿 isSupported 初值 false 把正常凭据误判为孤儿。
     * @note 定义前置（error18：UTS 无函数提升，onLoad 里的调用不能引用后声明的函数）
     */
    async function initBiometricGate() : Promise<void> {
        const support = await biometric.checkSupport()
        // 孤儿凭据自愈：确定性不支持 + 仍存完整凭据 → 降级为仅记住账号（密码密文销毁）
        // definitive=false（API 调用失败）说明支持性未知，不清任何数据
        if (!support.supported && support.definitive && hasStoredCredentials()) {
            const cred = loadSecureCredentials()
            if (cred != null) {
                saveAccountOnly(cred.u)
            }
        }
        if (hasStoredCredentials()) {
            showedStored.value = true
        } else {
            // 凭据降级：生物识别不可用平台/设备仅记住账号（无门控回填），直接回显账号
            const savedAccount = loadSavedAccount()
            if (savedAccount.length > 0) {
                username.value = savedAccount
                rememberMe.value = true
            }
        }
    }

    onLoad((options : OnLoadOptions) => {
        const sysInfo = uni.getSystemInfoSync()
        statusBarHeight.value = sysInfo.statusBarHeight

        auth.restoreFromStorage()
        if (auth.isLoggedIn.value) {
            uni.reLaunch({ url: '/pages/dashboard/dashboard' })
            return
        }
        loadCaptcha()
        initBiometricGate()
    })

    onShow(() => {
        // 从注册页返回时保留已填手机号
    })

    onUnload(() => {
        clearCountdownTimer()
    })

    // 连续输错次数（对齐后端：错误上限 5 次，发新码时清零）
    const wrongAttempts = ref<number>(0)

    function switchMode(m : string) : void {
        if (m == mode.value) return
        mode.value = m
        clearCountdownTimer()
        countdown.value = 0
        wrongAttempts.value = 0
        loadCaptcha()
    }

    function switchRole(role : string) : void {
        roleType.value = role
    }

    function toggleAgree() : void {
        agreed.value = !agreed.value
    }

    function togglePasswordVisible() : void {
        passwordVisible.value = !passwordVisible.value
    }

    /** 取消勾选立即清除已保存的安全凭据 */
    function toggleRemember() : void {
        rememberMe.value = !rememberMe.value
        if (!rememberMe.value) {
            clearSecureCredentials()
            showedStored.value = false
        }
    }

    /** 回填兜底：触发生物识别 → 成功则解密凭据回填表单（快捷登录降级路径复用） */
    async function onBiometricUnlock() : Promise<void> {
        const ok = await biometric.authenticate('验证身份以填充已保存的账号密码')
        if (ok) {
            const cred = loadSecureCredentials()
            if (cred != null) {
                username.value = cred.u
                password.value = cred.p
                rememberMe.value = true
                showedStored.value = false
            } else {
                uni.showToast({ title: '未找到保存的凭据', icon: 'none' })
            }
        } else {
            uni.showToast({ title: '认证未通过', icon: 'none' })
        }
    }

    // 快捷登录进行中（防重入：refresh 是网络请求，连点会重复弹认证框）
    const quickLogging = ref<boolean>(false)

    // 入口文案按设备实际支持的认证方式动态生成（ADR-0004 单入口双轨）
    const quickLoginLabel = computed<string>(() : string => {
        const modes = biometric.supportModes.value
        const hasFacial = modes.indexOf('facial') >= 0
        const hasFinger = modes.indexOf('fingerPrint') >= 0
        if (hasFacial && hasFinger) {
            return '🔐 面容/指纹快捷登录'
        }
        if (hasFacial) {
            return '🔐 面容快捷登录'
        }
        if (hasFinger) {
            return '🔐 指纹快捷登录'
        }
        return '🔐 生物识别快捷登录'
    })

    /**
     * 快捷登录（ADR-0004 增补）：生物验证 → 解密 refresh_token 静默续登 → 直接进 dashboard。
     * 轮换令牌的包络回写在 auth store 内统一完成（tryRefreshToken/quickLogin 两个同步点）。
     * 令牌失效（超 7 天未用/被互踢/后续改密吊销）或无令牌时，降级为回填流程（onBiometricUnlock，
     * 会再次弹认证框确认身份——降级即退出快捷语义，回归门控回填）。
     */
    async function onQuickLogin() : Promise<void> {
        if (quickLogging.value) {
            return
        }
        const ok = await biometric.authenticate('验证身份以快捷登录')
        if (!ok) {
            uni.showToast({ title: '认证未通过', icon: 'none' })
            return
        }
        const rt = loadSecureToken()
        if (rt.length == 0) {
            // 无令牌 = 包络产生于快捷登录上线前（或已降级）：一次密码登录即写入 rt 启用
            uni.showToast({ title: '请先输入密码登录一次，之后可快捷登录', icon: 'none' })
            onBiometricUnlock()
            return
        }
        quickLogging.value = true
        uni.showLoading({ title: '登录中' })
        const newRt = await auth.quickLogin(rt)
        uni.hideLoading()
        quickLogging.value = false
        if (newRt.length > 0) {
            uni.reLaunch({ url: '/pages/dashboard/dashboard' })
        } else {
            uni.showToast({ title: '快捷登录已过期，请验证后登录', icon: 'none' })
            onBiometricUnlock()
        }
    }

    function showAgreement(name : string) : void {
        uni.showToast({ title: name + '详情页建设中', icon: 'none' })
    }

    function startCountdown() : void {
        countdown.value = 60
        clearCountdownTimer()
        countdownTimer = setInterval(() => {
            countdown.value -= 1
            if (countdown.value <= 0) {
                clearCountdownTimer()
            }
        }, 1000) as number
    }

    function validatePhoneNum(p : string) : string {
        if (p.length != 11) return '请输入 11 位手机号'
        if (!p.startsWith('1')) return '手机号格式不正确'
        // if (!/^d{11}$/.test(p)) return '手机号必须为数字'
        return ''
    }

    async function onSendCode(channel : string) : Promise<void> {
        if (sendingCode.value || countdown.value > 0) return
        if (captchaId.value.length == 0 || captchaValue.value.length == 0) {
            uni.showToast({ title: '请先输入图形验证码', icon: 'none' })
            return
        }
        let target = ''
        if (channel == 'phone') {
            const err = validatePhoneNum(phone.value)
            if (err.length > 0) {
                uni.showToast({ title: err, icon: 'none' })
                return
            }
            target = phone.value
        } else {
            const t = email.value.trim()
            if (t.length == 0) {
                uni.showToast({ title: '请输入邮箱', icon: 'none' })
                return
            }
            if (t.indexOf('@') <= 0 || t.indexOf('.') <= 0) {
                uni.showToast({ title: '邮箱格式不正确', icon: 'none' })
                return
            }
            target = t
        }
        sendingCode.value = true
        uni.showLoading({ title: '发送中...', mask: true })
        try {
            await sendCodeApi(target, channel, 'login', captchaId.value, captchaValue.value)
            // 发送成功后刷新图形验证码（答案用后即焚，防止重放）
            wrongAttempts.value = 0
            uni.hideLoading()
            uni.showToast({ title: '验证码已发送，请查收', icon: 'none' })
            startCountdown()
        } catch (e) {
            uni.hideLoading()
            console.error('[login] send code failed:', e)
            let msg = '验证码发送失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
            // 失败后刷新图形验证码：后端校验即消费（无论对错都会删除答案），
            // 不做刷新会留下已失效的旧图，重试必报"图形验证码错误或已过期"，导致无法登录
            loadCaptcha()
        } finally {
            sendingCode.value = false
        }
    }

    function validate() : string {
        if (mode.value == 'phone') {
            const p = phone.value
            const err = validatePhoneNum(p)
            if (err.length > 0) return err
            if (phoneCode.value.length == 0) return '请输入验证码'
            if (phoneCode.value.length != 6) return '请输入 6 位验证码'
            return ''
        }
        if (mode.value == 'password') {
            if (username.value.length == 0) return '请输入用户名或手机号'
            if (password.value.length == 0) return '请输入密码'
            if (password.value.length < 6) return '密码至少 6 位'
            return ''
        }
        // 微信一键登录：无需输入表单，直接通过校验
        if (mode.value == 'wechat') {
            return ''
        }
        const t = email.value.trim()
        if (t.length == 0) return '请输入邮箱'
        if (t.indexOf('@') <= 0 || t.indexOf('.') <= 0) return '邮箱格式不正确'
        if (emailCode.value.length == 0) return '请输入验证码'
        if (emailCode.value.length != 6) return '请输入 6 位验证码'
        return ''
    }

    /**
     * 微信登录成功后跳转：
     * - 新用户（isNew=true）→ 选择证书页面
     * - 老用户 → 直接进入首页
     */
    function afterLoginSuccess(isNew : boolean) : void {
        if (isNew) {
            uni.showToast({ title: '已为您自动注册账号', icon: 'none', duration: 1500 })
            setTimeout(() => {
                uni.reLaunch({ url: '/pages/guide/choose-cert' })
            }, 800)
        } else {
            uni.showToast({ title: '登录成功', icon: 'success', duration: 1000 })
            setTimeout(() => {
                uni.reLaunch({ url: '/pages/dashboard/dashboard' })
            }, 500)
        }
    }

    async function onSubmit() : Promise<void> {
        // 账号密码登录不强制勾选协议（账号已是注册过的用户）
        if (mode.value != 'password') {
            const errAgree = agreed.value == false ? '请先同意用户协议和隐私政策' : ''
            if (errAgree.length > 0) {
                uni.showToast({ title: errAgree, icon: 'none' })
                return
            }
        }
        const err = validate()
        if (err.length > 0) {
            uni.showToast({ title: err, icon: 'none' })
            return
        }

        loading.value = true
        uni.showLoading({ title: '登录中...', mask: true })

        try {
            if (mode.value == 'phone') {
                await auth.loginByCode({
                    target: phone.value,
                    channel: 'phone',
                    code: phoneCode.value,
                })
            } else if (mode.value == 'email') {
                await auth.loginByCode({
                    target: email.value.trim(),
                    channel: 'email',
                    code: emailCode.value,
                })
            } else if (mode.value == 'wechat') {
                // 微信一键登录：uni.login({provider:'weixin'}) → 后端换 token + userInfo
                const result = await auth.loginByWechat()
                uni.hideLoading()
                const isNew = result != null && result.isNew === true
                afterLoginSuccess(isNew)
                loading.value = false
                return
            } else {
                const uname = username.value.trim()
                await auth.login({
                    username: uname,
                    password: password.value,
                })
                if (rememberMe.value && uname.length > 0) {
                    if (biometric.isSupported.value) {
                        // 生物识别可用：账号+密码完整保存，走门控回填
                        saveSecureCredentials(uname, password.value, auth.getRefreshToken())
                    } else {
                        // 凭据降级（ADR-0004 决策 A）：仅记住账号，密码不落盘
                        saveAccountOnly(uname)
                    }
                } else {
                    clearSecureCredentials()
                }
            }
            uni.hideLoading()
            afterLoginSuccess(false)
        } catch (e) {
            uni.hideLoading()
            console.error('[login] failed:', e)
            if (mode.value != 'password' && mode.value != 'wechat') {
                const m = e instanceof Error ? (e as Error).message : ''
                if (m.indexOf('验证码') >= 0) {
                    wrongAttempts.value += 1
                }
            }
            let msg = '登录失败，请重试'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // 验证码提示：说明后端规则 + 实时展示连续输错次数
    const codeHint = computed<string>(() : string => {
        if (wrongAttempts.value >= 5) {
            return '验证码错误次数过多，请点击获取验证码重新发送'
        }
        if (wrongAttempts.value > 0) {
            return '验证码错误，还可再试 ' + (5 - wrongAttempts.value) + ' 次'
        }
        return '6 位数字验证码，5 分钟内有效'
    })

    // 主按钮文字：按模式区分；微信模式下显示"微信一键登录"
    const btnText = computed<string>(() : string => {
        if (loading.value) return '登录中...'
        if (mode.value == 'wechat') return '微信一键登录'
        return '登 录'
    })

    function goRegister() : void {
        uni.navigateTo({ url: '/pages/register/register' })
    }

    function goForgotPassword() : void {
        uni.navigateTo({ url: '/pages/forgot-password/forgot-password' })
    }

    function onConfirm() : void {
        onSubmit()
    }

    function onPhoneInput(e : InputEvent) : void {
        phone.value = e.detail.value
    }

    function onPhoneCodeInput(e : InputEvent) : void {
        phoneCode.value = e.detail.value
    }

    function onUsernameInput(e : InputEvent) : void {
        username.value = e.detail.value
    }

    function onPasswordInput(e : InputEvent) : void {
        password.value = e.detail.value
    }

    function onEmailInput(e : InputEvent) : void {
        email.value = e.detail.value
    }

    function onEmailCodeInput(e : InputEvent) : void {
        emailCode.value = e.detail.value
    }

    function onCaptchaInput(e : InputEvent) : void {
        captchaValue.value = e.detail.value
    }
</script>

