<template>
    <scroll-view scroll-y class="login-page">
        <view class="status-bar" :style="{ height: safeArea.statusBarHeight + 'px' }"></view>

        <!-- 顶部品牌区：左对齐 Logo + 标题（B 方案：收紧纵向留白）
             头部段不放可点元素——自绘头部无页头件的胶囊让位保护（batch6 N06 负面机检），
             招聘者入口因此落到底部，见 .footer -->
        <view class="header">
            <view class="brand">
                <view class="logo-box">
                    <image class="logo" src="/static/logo.png" mode="aspectFit"></image>
                </view>
                <view class="brand-text">
                    <text class="app-title">叉车维修培训系统</text>
                    <text class="app-sub">维修技能 · 残值评估</text>
                </view>
            </view>
        </view>

        <view class="form">
            <!-- 验证码通道切换：分段控件，仅手机号/邮箱验证码模式展示 -->
            <view class="tabs" v-if="mode != 'password'">
                <view class="tab" :class="{ 'tab-on': mode == 'phone' }" @click="switchMode('phone')">
                    <text class="tab-text" :class="{ 'tab-text-active': mode == 'phone' }">手机验证码</text>
                </view>
                <view class="tab" :class="{ 'tab-on': mode == 'email' }" @click="switchMode('email')">
                    <text class="tab-text" :class="{ 'tab-text-active': mode == 'email' }">邮箱验证码</text>
                </view>
            </view>

            <!-- ===== 账号密码登录 ===== -->
            <template v-if="mode == 'password'">
                <view class="field">
                    <input class="field-input" type="text" placeholder="用户名或手机号" :maxlength="50" :value="username"
                        @input="onUsernameInput" @confirm="onConfirm" />
                </view>
                <view class="field">
                    <input class="field-input" :password="!passwordVisible" placeholder="请输入密码" :maxlength="32" :value="password"
                        @input="onPasswordInput" @confirm="onConfirm" />
                    <text class="pwd-toggle" @click="togglePasswordVisible">{{ passwordVisible ? '隐藏' : '显示' }}</text>
                </view>
                <!-- 快捷登录入口：有已存凭据 + 设备支持时才展示（生物验证 → 静默续登，ADR-0004） -->
                <view class="biometric-row" v-if="showedStored && biometric.isSupported.value">
                    <text class="biometric-link" @click="onQuickLogin">{{ quickLoginLabel }}</text>
                </view>
                <!-- 记住密码 + 忘记密码 -->
                <view class="meta-row">
                    <view class="remember-box" @click="toggleRemember">
                        <view class="checkbox" :class="{ 'checkbox-checked': rememberMe }">
                            <text v-if="rememberMe" class="check-mark">✓</text>
                        </view>
                        <text class="meta-text">记住密码</text>
                    </view>
                    <text class="meta-link" @click="goForgotPassword">忘记密码</text>
                </view>
                <view class="register-line">
                    <text class="meta-text">若手机号未注册，</text>
                    <text class="meta-link" @click="goRegister">即刻注册</text>
                </view>
            </template>

            <!-- ===== 手机号验证码登录 ===== -->
            <template v-else-if="mode == 'phone'">
                <view class="field">
                    <text class="prefix">+86</text>
                    <input class="field-input" type="number" placeholder="请输入手机号" :maxlength="11" :value="phone"
                        @input="onPhoneInput" @confirm="onConfirm" />
                </view>
                <view class="field">
                    <input class="field-input" type="number" placeholder="请输入短信验证码" :maxlength="6"
                        :value="phoneCode" @input="onPhoneCodeInput" @confirm="onConfirm" />
                    <button class="inline-btn" :class="{ 'inline-btn-disabled': sendingCode || countdown > 0 }"
                        :disabled="sendingCode || countdown > 0" @click="onSendCode('phone')">
                        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
                    </button>
                </view>
                <view class="field">
                    <input class="field-input" type="text" placeholder="图形验证码" :maxlength="4"
                        :value="captchaValue" @input="onCaptchaInput" />
                    <view class="captcha-box captcha-fail-box" v-if="captchaFailed" @click="refreshCaptcha">
                        <text class="captcha-fail-text">点击重试</text>
                    </view>
                    <image class="captcha-box" v-else :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
                </view>
                <view class="hint" v-if="codeHint.length > 0">
                    <text class="hint-text">{{ codeHint }}</text>
                </view>
            </template>

            <!-- ===== 邮箱验证码登录 ===== -->
            <template v-else>
                <view class="field">
                    <input class="field-input" type="text" placeholder="请输入邮箱" :maxlength="50" :value="email"
                        @input="onEmailInput" @confirm="onConfirm" />
                </view>
                <view class="field">
                    <input class="field-input" type="number" placeholder="请输入邮箱验证码" :maxlength="6"
                        :value="emailCode" @input="onEmailCodeInput" @confirm="onConfirm" />
                    <button class="inline-btn" :class="{ 'inline-btn-disabled': sendingCode || countdown > 0 }"
                        :disabled="sendingCode || countdown > 0" @click="onSendCode('email')">
                        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
                    </button>
                </view>
                <view class="field">
                    <input class="field-input" type="text" placeholder="图形验证码" :maxlength="4"
                        :value="captchaValue" @input="onCaptchaInput" />
                    <view class="captcha-box captcha-fail-box" v-if="captchaFailed" @click="refreshCaptcha">
                        <text class="captcha-fail-text">点击重试</text>
                    </view>
                    <image class="captcha-box" v-else :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
                </view>
                <view class="hint" v-if="codeHint.length > 0">
                    <text class="hint-text">{{ codeHint }}</text>
                </view>
            </template>

            <!-- 协议勾选 + 注册引导（手机号/邮箱方式展示）
                 #1478 抽成共享件 components/login-agreement（与着陆页同源同文案）；
                 「非 password 模式才显示」的门槛条件留在本页，口径由 loginContract 继续执法 -->
            <LoginAgreement v-if="mode != 'password'" :channel="mode" :agreed="agreed" @toggle="toggleAgree" @agreement="showAgreement" @register="goRegister" />
            <!-- 登录按钮 -->
            <button class="btn-login" :class="{ 'btn-login-disabled': loading }"
                :disabled="loading" @click="onSubmit">
                {{ btnText }}
            </button>

            <!-- 其他登录方式：微信一键登录（#1908，纯导航回欢迎页，本页不内嵌微信链路）
                 + 账号密码 / 验证码通道切换（替代原底部 mode-switch 与 back-password 两段入口） -->
            <!-- 其他登录方式左对齐小标题（比居中分隔线更贴合左对齐版式） -->
            <text class="alt-caption">其他登录方式</text>
            <view class="alt-row">
                <view class="alt-cell alt-cell-left">
                    <view class="alt-btn alt-btn-wechat" @click="goWechatLanding">
                        <image class="alt-icon" src="/static/wechat-logo.png" mode="aspectFit"></image>
                        <text class="alt-btn-text alt-btn-text-wechat">微信登录</text>
                    </view>
                </view>
                <view class="alt-cell">
                    <view class="alt-btn alt-btn-plain" v-if="mode != 'password'" @click="switchMode('password')">
                        <text class="alt-btn-text">账号密码登录</text>
                    </view>
                    <view class="alt-btn alt-btn-plain" v-else @click="switchMode('phone')">
                        <text class="alt-btn-text">验证码登录</text>
                    </view>
                </view>
            </view>
        </view>

        <!-- 底部说明 + 招聘者入口（纯文字链接，保持低调；不进头部段） -->
        <view class="footer">
            <view class="footer-line"></view>
            <view class="footer-row">
                <text class="footer-text">叉车维修培训系统 · 学员端</text>
                <view class="footer-link-box" @click="goRecruiterLogin">
                    <text class="footer-link">招聘者登录</text>
                </view>
            </view>
        </view>
    </scroll-view>
</template>

<script setup lang="uts">
    import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { useBiometric } from '../../composables/useBiometric'
    import { useLoginForm } from './composables/useLoginForm'
    import { useBiometricGate } from './composables/useBiometricGate'
    import { useSafeArea } from '../../utils/system'
    import LoginAgreement from '../../components/login-agreement/login-agreement.uvue'

    const auth = useAuthStore()
    // N06 自垫状态栏：高度取自 utils/system.uts 唯一真源（#1602/#1609），页面不再自行探测
    const safeArea = useSafeArea()
    // 生物识别实例只有一个：门控 checkSupport 写入的 isSupported 与模板读取的必须是同一份
    const biometric = useBiometric()

    // 表单态（登录方式 / 验证码 / 提交），模板绑定的符号一律解构成本地绑定 ——
    // 模板因此可以**逐字节不变**（UI 像素级冻结的最强证据面），无需 reg.xxx.value 改写
    const {
        mode,
        phone,
        phoneCode,
        username,
        password,
        passwordVisible,
        rememberMe,
        email,
        emailCode,
        agreed,
        captchaImage,
        captchaValue,
        captchaFailed,
        loading,
        sendingCode,
        countdown,
        codeHint,
        btnText,
        loadCaptcha,
        clearCountdownTimer,
        switchMode,
        toggleAgree,
        togglePasswordVisible,
        showAgreement,
        refreshCaptcha,
        onSendCode,
        onSubmit,
        onConfirm,
        goRegister,
        goForgotPassword,
        goRecruiterLogin,
    } = useLoginForm(biometric)

    // 生物识别门控面（回填 / 快捷登录 / 取消勾选清除），凭据 ref 由表单态注入
    const { showedStored, quickLoginLabel, initBiometricGate, onQuickLogin, toggleRemember } = useBiometricGate(biometric, username, password, rememberMe)

    onLoad((options : OnLoadOptions) => {
        auth.restoreFromStorage()
        if (auth.isLoggedIn.value) {
            uni.reLaunch({ url: '/pages/dashboard/dashboard' })
            return
        }
        loadCaptcha()
        initBiometricGate()
    })


    onShow(() => {
        // 从注册页返回时保留已填手机号
    })

    onUnload(() => {
        clearCountdownTimer()
    })

    function onPhoneInput(e : InputEvent) : void {
        phone.value = e.detail.value
    }

    function onPhoneCodeInput(e : InputEvent) : void {
        phoneCode.value = e.detail.value
    }

    function onUsernameInput(e : InputEvent) : void {
        username.value = e.detail.value
    }

    function onPasswordInput(e : InputEvent) : void {
        password.value = e.detail.value
    }

    function onEmailInput(e : InputEvent) : void {
        email.value = e.detail.value
    }

    function onEmailCodeInput(e : InputEvent) : void {
        emailCode.value = e.detail.value
    }

    function onCaptchaInput(e : InputEvent) : void {
        captchaValue.value = e.detail.value
    }

    // 切回欢迎页走 reLaunch：401 顶出场景页面栈里只有登录页自身，navigateBack 无处可回（#1908）
    function goWechatLanding() : void {
        uni.reLaunch({ url: '/pages/index/index' })
    }
</script>

<style lang="scss">
    .login-page { flex: 1; background-color: #ffffff; }

    .status-bar { background-color: $bg-header; }

    /* ===== 顶部品牌区（左对齐，B 方案） ===== */
    .header { flex-direction: row; align-items: center; padding: 44rpx 48rpx 0 48rpx; }

    .brand { flex-direction: row; align-items: center; }

    /* Logo 托底：浅灰圆角块把彩色标志收成「应用图标」 */
    .logo-box {
        width: 112rpx;
        height: 112rpx;
        border-radius: 28rpx;
        background-color: #F5F7FA;
        align-items: center;
        justify-content: center;
        margin-right: 24rpx;
    }

    .logo { width: 84rpx; height: 66rpx; }

    .brand-text { flex-direction: column; flex: 1; }

    .app-title { font-size: 36rpx; font-weight: bold; color: $text-strong; }

    .app-sub { margin-top: 10rpx; font-size: 22rpx; color: $text-color-placeholder; }

    /* ===== 表单区 ===== */
    .form { padding: 48rpx 48rpx 0 48rpx; }

    /* 验证码通道切换：分段控件（灰底槽 + 白色活动块） */
    .tabs {
        flex-direction: row;
        background-color: #F5F7FA;
        border-radius: 22rpx;
        padding: 8rpx;
        margin-bottom: 32rpx;
    }

    .tab {
        flex: 1;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        height: 76rpx;
        border-radius: 16rpx;
    }

    .tab-on { background-color: #ffffff; box-shadow: 0 2rpx 10rpx rgba(26, 26, 26, 0.08); }

    .tab-text { font-size: 28rpx; color: $text-color-secondary; }

    .tab-text-active { color: $text-strong; font-weight: bold; }

    /* 统一输入框：灰底、104rpx 高、24rpx 圆角 */
    .field {
        flex-direction: row;
        align-items: center;
        height: 104rpx;
        background-color: #F5F7FA;
        border-radius: 24rpx;
        padding: 0 28rpx;
        margin-bottom: 24rpx;
    }

    .field-input {
        flex: 1;
        height: 104rpx;
        border: none;
        background-color: transparent;
        padding: 0;
        font-size: 30rpx;
        color: $text-strong;
    }

    .prefix {
        font-size: 28rpx;
        font-weight: bold;
        color: $text-strong;
        padding-right: 16rpx;
        margin-right: 20rpx;
        border-right: 2rpx solid $border-color;
    }

    .pwd-toggle { font-size: 26rpx; color: #2979FF; padding-left: 16rpx; }

    /* 验证码内嵌按钮：主色浅底胶囊（比白底描边更轻，不抢主按钮） */
    .inline-btn {
        width: 188rpx;
        height: 64rpx;
        line-height: 64rpx;
        padding: 0;
        margin-left: 20rpx;
        font-size: 26rpx;
        color: #2979FF;
        background-color: $primary-tint;
        border: none;
        border-radius: 32rpx;
        text-align: center;
    }

    /* 发送中 / 倒计时：退回中性灰，不再靠整块透明度 */
    .inline-btn-disabled { color: $text-color-placeholder; background-color: #F5F7FA; }

    /* 图形验证码：输入框内右侧图块 */
    .captcha-box {
        width: 176rpx;
        height: 72rpx;
        border-radius: 16rpx;
        margin-left: 20rpx;
        background-color: #ffffff;
    }

    .captcha-fail-box { align-items: center; justify-content: center; }

    .captcha-fail-text { font-size: 20rpx; color: #999999; text-align: center; }

    /* 验证码规则提示 */
    .hint { margin-top: -8rpx; margin-bottom: 8rpx; }

    .hint-text { font-size: 22rpx; color: $text-color-placeholder; }

    /* ===== 账号密码模式的辅助行 ===== */
    .biometric-row { align-items: flex-start; margin-top: -8rpx; margin-bottom: 20rpx; }

    .biometric-link {
        font-size: 26rpx;
        color: #2979FF;
        border-bottom: 1rpx dashed #2979FF;
        padding-bottom: 2rpx;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20rpx;
    }

    .remember-box { flex-direction: row; align-items: center; padding: 30rpx 0; }

    .checkbox {
        width: 34rpx;
        height: 34rpx;
        border-radius: 50%;
        border: 2rpx solid #C8CDD8;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        margin-right: 12rpx;
    }

    .checkbox-checked { background-color: #2979FF; border-color: #2979FF; }

    .check-mark { font-size: 24rpx; color: #ffffff; }

    .meta-text { font-size: 25rpx; color: #666666; }

    .meta-link { font-size: 25rpx; color: #2979FF; }

    .register-line { flex-direction: row; align-items: center; margin-bottom: 8rpx; }

    /* ===== 主登录按钮 ===== */
    .btn-login {
        margin-top: 16rpx;
        width: 100%;
        height: 108rpx;
        line-height: 108rpx;
        border-radius: 54rpx;
        background-color: #2979FF;
        box-shadow: 0 12rpx 28rpx rgba(41, 121, 255, 0.28);
        color: #ffffff;
        font-size: 32rpx;
        font-weight: bold;
        text-align: center;
        border: none;
    }

    .btn-login-disabled { opacity: 0.6; }

    /* ===== 其他登录方式：左对齐小标题 + 并排浅底次级按钮 ===== */
    .alt-caption {
        margin-top: 48rpx;
        margin-bottom: 20rpx;
        font-size: 24rpx;
        color: $text-color-placeholder;
    }

    .alt-row { flex-direction: row; margin-bottom: 8rpx; }

    .alt-cell { flex: 1; }

    .alt-cell-left { margin-right: 20rpx; }

    .alt-btn {
        flex-direction: row;
        align-items: center;
        justify-content: center;
        height: 96rpx;
        border-radius: 48rpx;
    }

    /* 微信品牌绿：浅绿底 + 绿字绿标（#07C160 走 uiHexWhitelist） */
    .alt-btn-wechat { background-color: $success-tint; }

    .alt-icon { width: 38rpx; height: 38rpx; margin-right: 12rpx; }

    .alt-btn-text { font-size: 28rpx; color: $text-color-secondary; }

    .alt-btn-text-wechat { color: #07C160; font-weight: bold; }

    .alt-btn-plain { background-color: #F5F7FA; }

    /* ===== 底部说明 + 招聘者入口 ===== */
    .footer { margin-top: 56rpx; padding: 0 48rpx; }

    /* 分隔线用独立 view（uvue 未验证 border-top-* 支持） */
    .footer-line { height: 2rpx; background-color: $border-color-light; }

    .footer-row { flex-direction: row; align-items: center; justify-content: space-between; }

    .footer-text { font-size: 24rpx; color: $text-color-placeholder; }

    /* 88rpx 高保证 ≥44px 触摸目标 */
    .footer-link-box { height: 88rpx; justify-content: center; padding-left: 32rpx; }

    .footer-link { font-size: 25rpx; color: #2979FF; }
</style>
