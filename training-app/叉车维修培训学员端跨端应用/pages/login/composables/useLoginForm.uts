/**
 * 登录页表单态 composable（T13 login 手术，parent #651 / ADR-0007；#2517 角色切换 + 人机验证延迟展开）
 *
 * 逐字搬自 `pages/login/login.uvue` 的 `<script setup>`：登录方式切换 → 图形验证码 →
 * 验证码发送与倒计时 → 表单校验 → 提交（含「记住密码」的凭据落地）。函数体**零改写**，
 * 唯一变化是 import 的相对层级（多下一层目录）—— 语句形态连字面量都保持原样，
 * 这样 `utils/loginGating.test.js` 的断言面可以整体平移而不降级。
 *
 * uni 生命周期留页面壳层（照 T06/T07/T08 先例：composable 不注册 uni 生命周期）；
 * `InputEvent` 取值包装同样留壳层（本仓 `.uts` 侧无 InputEvent 先例，见 T11 形态决定 ②）。
 *
 * 生物识别门控面（门控回填 / 快捷登录 / 凭据降级 / 孤儿凭据自愈）**不在本文件**，
 * 见同目录 `useBiometricGate.uts`；本文件只把 `username` / `password` / `rememberMe`
 * 三个 ref 交给它写。凭据的读写一律经 `utils/secureStorage` 抽象层，无 storage 直调。
 *
 * #2517 新增（登录页 1:1 还原）：
 * - `role`（learner / recruiter）：同页角色切换，招聘者态走真实 B 端登录
 *   `/api/auth/recruiter-login`（`auth.loginAsRecruiter`）→ reLaunch 现有 `/pages/recruiter/home`；
 *   旧独立招聘者页保留，只服务 401 角色化出口。
 * - `captchaOpen`：人机验证**延迟展开**——默认不占版面，点「获取验证码」就地展开验证行，
 *   通过后发码并收起（生产强制，`backend/internal/config/config.go:338`）。
 */
import { ref, computed } from 'vue'
import type { Ref, ComputedRef } from 'vue'
import { useAuthStore } from '../../../stores/auth'
import { sendCodeApi, getCaptchaApi } from '../../../api/auth'
import { saveSecureCredentials, saveAccountOnly, clearSecureCredentials } from '../../../utils/secureStorage'
// #1478：登录成功出口提为共享件（着陆页与本页一条出口），本页不再自持那份 toast + reLaunch
import { afterLoginSuccess } from '../../../utils/loginOutlet'
// #1478 第 1 轮评审 F2：「详情页建设中」这句 toast 同样提为全仓单点（三页共用，见 utils/agreementNotice）
import { showAgreementNotice } from '../../../utils/agreementNotice'
import type { UseBiometricResult } from '../../../composables/useBiometric'

/**
 * 本 composable 的显式返回类型（Kotlin error18 规避，先例 useRegisterForm / useResumeEdit）。
 * 返回面只暴露被消费的符号（T05 死代码消费面核对口径）：`validate` / `validatePhoneNum` /
 * `startCountdown` / `captchaId` / `wrongAttempts` 页面与门控均不读，故不入面。
 * （`afterLoginSuccess` 原也在此列，#1478 起它已是 `utils/loginOutlet.uts` 的共享出口，
 * 不再是本文件的内部函数 —— 两页都从那里取，全仓不存在第二套登录成功跳转。）
 */
export type UseLoginFormResult = {
    role : Ref<string>
    mode : Ref<string>
    phone : Ref<string>
    phoneCode : Ref<string>
    username : Ref<string>
    password : Ref<string>
    passwordVisible : Ref<boolean>
    rememberMe : Ref<boolean>
    email : Ref<string>
    emailCode : Ref<string>
    agreed : Ref<boolean>
    captchaOpen : Ref<boolean>
    captchaImage : Ref<string>
    captchaValue : Ref<string>
    captchaFailed : Ref<boolean>
    recruiterAccount : Ref<string>
    recruiterPassword : Ref<string>
    recruiterPasswordVisible : Ref<boolean>
    agreementAccent : string
    loading : Ref<boolean>
    sendingCode : Ref<boolean>
    countdown : Ref<number>
    codeHint : ComputedRef<string>
    btnText : ComputedRef<string>
    wechatHighlighted : ComputedRef<boolean>
    refreshCaptcha : () => void
    clearCountdownTimer : () => void
    switchMode : (m : string) => void
    switchRole : (r : string) => void
    togglePasswordMode : () => void
    toggleAgree : () => void
    togglePasswordVisible : () => void
    toggleRecruiterPasswordVisible : () => void
    showAgreement : (name : string) => void
    onSendCode : (channel : string) => Promise<void>
    onSubmit : () => Promise<void>
    onConfirm : () => void
    goRegister : () => void
    goForgotPassword : () => void
}

/**
 * @param biometric 页面壳层持有的唯一生物识别实例（提交时按设备支持性决定「存完整凭据」还是「仅记住账号」）
 */
export function useLoginForm(biometric : UseBiometricResult) : UseLoginFormResult {
    const auth = useAuthStore()

    // 角色：learner（学员，默认） | recruiter（招聘者，邀约制账号密码）
    const role = ref<string>('learner')

    // 登录方式：password（账号密码） | phone（手机验证码，默认） | email（邮箱验证码）
    // （wechat 档已随 #1879 退役：微信一键登录只保留欢迎页主 CTA 一条界面）
    const mode = ref<string>('phone')

    // 手机号 + 验证码
    const phone = ref<string>('')
    const phoneCode = ref<string>('')
    // 账号 + 密码
    const username = ref<string>('')
    const password = ref<string>('')
    // 密码明文切换 + 记住密码（勾选后保存凭据，下次通过生物识别回填）
    const passwordVisible = ref<boolean>(false)
    const rememberMe = ref<boolean>(false)
    // 生物识别回填入口：有已存凭据且验证通过才展示
    const showedStored = ref<boolean>(false)
    // 邮箱 + 验证码
    const email = ref<string>('')
    const emailCode = ref<string>('')

    // 招聘者账号 + 密码（#2517：同页切换，走 /api/auth/recruiter-login）
    const recruiterAccount = ref<string>('')
    const recruiterPassword = ref<string>('')
    const recruiterPasswordVisible = ref<boolean>(false)

    // 协议勾选
    const agreed = ref<boolean>(false)

    // 协议行强调色：共享件默认值保持着陆页现状（#2979FF），本页按主色 token 传入（#2517 裁定 8）
    const agreementAccent : string = '#239EDD'

    // 图形验证码（人机验证，生产环境发送短信/邮箱验证码前必填）
    const captchaId = ref<string>('')
    const captchaImage = ref<string>('')
    const captchaValue = ref<string>('')
    const captchaLoading = ref<boolean>(false)
    const captchaFailed = ref<boolean>(false)
    // 人机验证行是否展开（#2517 延迟展开：默认收起，点「获取验证码」就地展开）
    const captchaOpen = ref<boolean>(false)

    /** 加载图形验证码（展开人机验证行/点击图片刷新）；失败展示"点击重试"占位 */
    async function loadCaptcha() : Promise<void> {
        if (captchaLoading.value) return
        captchaLoading.value = true
        try {
            const data = await getCaptchaApi()
            captchaId.value = data.id
            captchaImage.value = data.image
            captchaValue.value = ''
            captchaFailed.value = false
        } catch (e) {
            console.error('[login] load captcha failed:', e)
            captchaFailed.value = true
        } finally {
            captchaLoading.value = false
        }
    }

    function refreshCaptcha() : void {
        loadCaptcha()
    }

    const loading = ref<boolean>(false)
    const sendingCode = ref<boolean>(false)
    const countdown = ref<number>(0)
    let countdownTimer : number | null = null

    /** 清理倒计时定时器（局部副本承接：Kotlin 禁止对闭包中修改的 var 智能转换） */
    function clearCountdownTimer() : void {
        const timer = countdownTimer
        if (timer != null) {
            clearInterval(timer)
            countdownTimer = null
        }
    }

    // 连续输错次数（对齐后端：错误上限 5 次，发新码时清零）
    const wrongAttempts = ref<number>(0)

    /** 收起人机验证行并清空已填图形码（切通道 / 切角色 / 发码成功后） */
    function closeCaptcha() : void {
        captchaOpen.value = false
        captchaValue.value = ''
    }

    function switchMode(m : string) : void {
        if (m == mode.value) return
        mode.value = m
        clearCountdownTimer()
        countdown.value = 0
        wrongAttempts.value = 0
        closeCaptcha()
    }

    /** 角色切换（学员 / 招聘者）：清倒计时与验证码态，表单值保留（切回不丢已填内容） */
    function switchRole(r : string) : void {
        if (r == role.value) return
        role.value = r
        clearCountdownTimer()
        countdown.value = 0
        wrongAttempts.value = 0
        closeCaptcha()
    }

    /** 密码登录 / 验证码登录 互切（小字入口，生物识别入口的宿主） */
    function togglePasswordMode() : void {
        if (mode.value == 'password') {
            switchMode('phone')
        } else {
            switchMode('password')
        }
    }

    function toggleAgree() : void {
        agreed.value = !agreed.value
    }

    function togglePasswordVisible() : void {
        passwordVisible.value = !passwordVisible.value
    }

    function toggleRecruiterPasswordVisible() : void {
        recruiterPasswordVisible.value = !recruiterPasswordVisible.value
    }

    function showAgreement(name : string) : void {
        showAgreementNotice(name)
    }

    function startCountdown() : void {
        countdown.value = 60
        clearCountdownTimer()
        countdownTimer = setInterval(() => {
            countdown.value -= 1
            if (countdown.value <= 0) {
                clearCountdownTimer()
            }
        }, 1000) as number
    }

    function validatePhoneNum(p : string) : string {
        if (p.length != 11) return '请输入 11 位手机号'
        if (!p.startsWith('1')) return '手机号格式不正确'
        if (!/^\d{11}$/.test(p)) return '手机号必须为数字'
        return ''
    }

    async function onSendCode(channel : string) : Promise<void> {
        if (sendingCode.value || countdown.value > 0) return
        // 人机验证延迟展开（#2517）：首次点击只展开验证行并拉图，不直接发码
        if (!captchaOpen.value) {
            captchaOpen.value = true
            captchaValue.value = ''
            loadCaptcha()
            uni.showToast({ title: '请先完成人机验证', icon: 'none' })
            return
        }
        if (captchaId.value.length == 0 || captchaValue.value.length == 0) {
            uni.showToast({ title: '请先输入图形验证码', icon: 'none' })
            return
        }
        let target = ''
        if (channel == 'phone') {
            const err = validatePhoneNum(phone.value)
            if (err.length > 0) {
                uni.showToast({ title: err, icon: 'none' })
                return
            }
            target = phone.value
        } else {
            const t = email.value.trim()
            if (t.length == 0) {
                uni.showToast({ title: '请输入邮箱', icon: 'none' })
                return
            }
            if (t.indexOf('@') <= 0 || t.indexOf('.') <= 0) {
                uni.showToast({ title: '邮箱格式不正确', icon: 'none' })
                return
            }
            target = t
        }
        sendingCode.value = true
        uni.showLoading({ title: '发送中...', mask: true })
        try {
            await sendCodeApi(target, channel, 'login', captchaId.value, captchaValue.value)
            // 发送成功后刷新图形验证码（答案用后即焚，防止重放）并收起验证行
            wrongAttempts.value = 0
            uni.hideLoading()
            uni.showToast({ title: '验证码已发送，请查收', icon: 'none' })
            closeCaptcha()
            startCountdown()
        } catch (e) {
            uni.hideLoading()
            console.error('[login] send code failed:', e)
            let msg = '验证码发送失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
            // 失败后刷新图形验证码：后端校验即消费（无论对错都会删除答案），
            // 不做刷新会留下已失效的旧图，重试必报"图形验证码错误或已过期"，导致无法登录
            loadCaptcha()
        } finally {
            sendingCode.value = false
        }
    }

    function validate() : string {
        if (mode.value == 'phone') {
            const p = phone.value
            const err = validatePhoneNum(p)
            if (err.length > 0) return err
            if (phoneCode.value.length == 0) return '请输入验证码'
            if (phoneCode.value.length != 6) return '请输入 6 位验证码'
            return ''
        }
        if (mode.value == 'password') {
            if (username.value.length == 0) return '请输入用户名或手机号'
            if (password.value.length == 0) return '请输入密码'
            // 上限 20 对齐后端唯一规则源 service.validatePasswordLength 与注册页；密码框 :maxlength 保持 32（#1262 裁定）
            if (password.value.length < 6 || password.value.length > 20) return '密码长度需为 6-20 位'
            return ''
        }
        const t = email.value.trim()
        if (t.length == 0) return '请输入邮箱'
        if (t.indexOf('@') <= 0 || t.indexOf('.') <= 0) return '邮箱格式不正确'
        if (emailCode.value.length == 0) return '请输入验证码'
        if (emailCode.value.length != 6) return '请输入 6 位验证码'
        return ''
    }

    /**
     * 招聘者登录（#2517）：真实 B 端账号密码 → `/api/auth/recruiter-login`，
     * 成功后 reLaunch 现有招聘者工作台（与旧独立页同一落地页，ADR-0022 ④）。
     */
    async function submitRecruiter() : Promise<void> {
        const acct = recruiterAccount.value.trim()
        if (acct.length == 0) {
            uni.showToast({ title: '请输入招聘者账号', icon: 'none' })
            return
        }
        if (recruiterPassword.value.length == 0) {
            uni.showToast({ title: '请输入密码', icon: 'none' })
            return
        }
        loading.value = true
        uni.showLoading({ title: '登录中...', mask: true })
        try {
            await auth.loginAsRecruiter({
                username: acct,
                password: recruiterPassword.value,
            })
            uni.hideLoading()
            uni.reLaunch({ url: '/pages/recruiter/home' })
        } catch (e) {
            uni.hideLoading()
            console.error('[login] recruiter failed:', e)
            let msg = '登录失败，请重试'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    /**
     * 登录成功后的落地分叉现居 `utils/loginOutlet.uts` 的 `afterLoginSuccess(isNew)` ——
     * 新用户走 choose-cert、老用户进 dashboard 两条分支**逐字未改**（连同两条 toast 文案与
     * 800/500ms 延时），搬走的动机是着陆页要复用同一条出口，而不是在 `pages/index` 再抄一份。
     * #1879 起本文件的微信提交分支退役，phone / email / password 三路共用这一个出口调用点。
     */
    async function onSubmit() : Promise<void> {
        // 招聘者态：独立提交路径（无协议勾选、无验证码、无生物识别凭据）
        if (role.value == 'recruiter') {
            await submitRecruiter()
            return
        }
        // 账号密码登录不强制勾选协议（账号已是注册过的用户）
        if (mode.value != 'password') {
            const errAgree = agreed.value == false ? '请先同意用户协议和隐私政策' : ''
            if (errAgree.length > 0) {
                uni.showToast({ title: errAgree, icon: 'none' })
                return
            }
        }
        const err = validate()
        if (err.length > 0) {
            uni.showToast({ title: err, icon: 'none' })
            return
        }

        loading.value = true
        uni.showLoading({ title: '登录中...', mask: true })

        try {
            if (mode.value == 'phone') {
                await auth.loginByCode({
                    target: phone.value,
                    channel: 'phone',
                    code: phoneCode.value,
                })
            } else if (mode.value == 'email') {
                await auth.loginByCode({
                    target: email.value.trim(),
                    channel: 'email',
                    code: emailCode.value,
                })
            } else {
                const uname = username.value.trim()
                await auth.login({
                    username: uname,
                    password: password.value,
                })
                if (rememberMe.value && uname.length > 0) {
                    if (biometric.isSupported.value) {
                        // 生物识别可用：账号+密码完整保存，走门控回填
                        saveSecureCredentials(uname, password.value, auth.getRefreshToken())
                    } else {
                        // 凭据降级（ADR-0004 决策 A）：仅记住账号，密码不落盘
                        saveAccountOnly(uname)
                    }
                } else {
                    clearSecureCredentials()
                }
            }
            uni.hideLoading()
            afterLoginSuccess(false)
        } catch (e) {
            uni.hideLoading()
            console.error('[login] failed:', e)
            if (mode.value != 'password') {
                const m = e instanceof Error ? (e as Error).message : ''
                if (m.indexOf('验证码') >= 0) {
                    wrongAttempts.value += 1
                }
            }
            let msg = '登录失败，请重试'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // 验证码提示：说明后端规则 + 实时展示连续输错次数
    const codeHint = computed<string>(() : string => {
        if (wrongAttempts.value >= 5) {
            return '验证码错误次数过多，请点击获取验证码重新发送'
        }
        if (wrongAttempts.value > 0) {
            return '验证码错误，还可再试 ' + (5 - wrongAttempts.value) + ' 次'
        }
        return '6 位数字验证码，5 分钟内有效'
    })

    // 主按钮文字：加载中与常态两态
    const btnText = computed<string>(() : string => {
        if (loading.value) return '登录中...'
        return '登 录'
    })

    // 底部三图标的灰/绿两态（设计稿导出位图，落盘 static/icons/login/）：
    // 手机 / 邮箱跟随当前通道切换；微信是导航入口、不是通道，按设计稿常亮品牌绿。
    // 两态路径直接写在模板里（字面量 /static/…）：包内图不吃 webp 属性，
    // utils/imageWebpAttrContract 按「:src 表达式里出现 /static/」判豁免，藏进 computed 会被判漏配。
    // 落盘用 64 色调色板 PNG 而非 webp：小程序 image 的 webp 属性默认 false，且只支持
    // 网络资源、不解析包内 webp（体验版/真机空白，开发者工具是 Chromium 所以看不出来）。
    // 6 个图标合计 webp 3,018 B -> PNG 3,874 B，包体只多 856 B。
    const wechatHighlighted = computed<boolean>(() : boolean => true)

    function goRegister() : void {
        uni.navigateTo({ url: '/pages/register/register' })
    }

    function goForgotPassword() : void {
        uni.navigateTo({ url: '/pages/forgot-password/forgot-password' })
    }

    function onConfirm() : void {
        onSubmit()
    }

    return {
        role,
        mode,
        phone,
        phoneCode,
        username,
        password,
        passwordVisible,
        rememberMe,
        email,
        emailCode,
        agreed,
        captchaOpen,
        captchaImage,
        captchaValue,
        captchaFailed,
        recruiterAccount,
        recruiterPassword,
        recruiterPasswordVisible,
        agreementAccent,
        loading,
        sendingCode,
        countdown,
        codeHint,
        btnText,
        wechatHighlighted,
        refreshCaptcha: () => refreshCaptcha(),
        clearCountdownTimer: () => clearCountdownTimer(),
        switchMode: (m : string) => switchMode(m),
        switchRole: (r : string) => switchRole(r),
        togglePasswordMode: () => togglePasswordMode(),
        toggleAgree: () => toggleAgree(),
        togglePasswordVisible: () => togglePasswordVisible(),
        toggleRecruiterPasswordVisible: () => toggleRecruiterPasswordVisible(),
        showAgreement: (name : string) => showAgreement(name),
        onSendCode: (channel : string) => onSendCode(channel),
        onSubmit: () => onSubmit(),
        onConfirm: () => onConfirm(),
        goRegister: () => goRegister(),
        goForgotPassword: () => goForgotPassword(),
    } as UseLoginFormResult
}
