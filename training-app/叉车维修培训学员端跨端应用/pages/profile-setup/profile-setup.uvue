<template>
    <scroll-view scroll-y class="setup-page">
        <view class="status-bar" :style="{ height: safeArea.statusBarHeight + 'px' }"></view>
        <view class="header">
            <text class="title">完善个人资料</text>
            <text class="subtitle">选择头像和昵称，让同学们认识你</text>
        </view>
        <!-- 头像：仅当头像为空且无待审记录时出现（有值字段不可编辑、不提交） -->
        <view v-if="showAvatar" class="section">
            <text class="section-label">头像</text>
            <!-- 微信登录：用 chooseAvatar 选微信头像 -->
            <button v-if="isWechat" class="avatar-btn-wechat" open-type="chooseAvatar" @chooseavatar="onChooseAvatar">
                <image v-if="avatarUrl.length > 0" class="avatar-img" :src="avatarUrl" mode="aspectFill" :webp="true" />
                <view v-else class="avatar-placeholder">
                    <text class="avatar-icon">💚</text>
                    <text class="avatar-hint">选择微信头像</text>
                </view>
            </button>
            <!-- 其他登录：用相册/拍照 -->
            <view v-else class="avatar-wrap" @click="onChooseImage">
                <image v-if="avatarUrl.length > 0" class="avatar-img" :src="avatarUrl" mode="aspectFill" :webp="true" />
                <view v-else class="avatar-placeholder">
                    <text class="avatar-icon">📷</text>
                    <text class="avatar-hint">点击选择头像</text>
                </view>
            </view>
        </view>
        <!-- 昵称：仅当昵称为空（或仍是后端占位昵称）且无待审记录时出现 -->
        <view v-if="showNickname" class="section">
            <text class="section-label">昵称</text>
            <view class="input-wrap">
                <input class="nickname-input" type="nickname" :value="nickName" @input="onNicknameInput" placeholder="请输入昵称" maxlength="30" />
            </view>
            <text class="input-hint">点击后键盘上方可一键填充微信昵称</text>
        </view>
        <!-- 两半都满 / 都已有待审记录：不再提供填写位 -->
        <view v-if="nothingToFill" class="section">
            <text class="input-hint">资料已完善，无需再次填写</text>
        </view>
        <view class="submit-area">
            <view v-if="!nothingToFill" class="btn-submit" @click="onSubmit">
                <text class="btn-submit-text">{{ submitting ? '提交中...' : '完成' }}</text>
            </view>
            <text class="skip-hint" @click="onSkip">{{ nothingToFill ? '返回' : '稍后完善' }}</text>
        </view>
    </scroll-view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useSafeArea } from '../../utils/system'
    import { useAuthStore } from '../../stores/auth'
    import { uploadAvatarApi, updateProfileApi } from '../../api/auth'
    import { fillTargetsOf, hasFillTargetOf } from '../../utils/wechatProfileFill.uts'
    import {
        submitStepsOf, truncateNickname, isNicknameTooLong,
        exitTargetOf, homeFallbackUrl, submitToastOf, truncateToastOf
    } from './composables/profile-setup-flows.uts'
    import type { FillDraft } from './composables/profile-setup-flows.uts'

    const auth = useAuthStore()
    const safeArea = useSafeArea()
    /** 来源：login = 登录后新用户（出口回 choose-cert）；其余按页面栈回退 */
    const from = ref<string>('')
    const avatarUrl = ref<string>('')
    const avatarFilePath = ref<string>('')
    const nickName = ref<string>('')
    const submitting = ref<boolean>(false)
    /** 重试记忆：已成功的字段不再重做（头像上传成功清临时路径，昵称成功不重提） */
    const avatarDone = ref<boolean>(false)
    const nicknameDone = ref<boolean>(false)

    /** 待填集合（空值判据 + 待审字段不可填，全在 flows） */
    const showAvatar = computed<boolean>(() : boolean => fillTargetsOf(auth.user.value).avatar)
    const showNickname = computed<boolean>(() : boolean => fillTargetsOf(auth.user.value).nickname)
    const nothingToFill = computed<boolean>(() : boolean => !hasFillTargetOf(auth.user.value))

    /** 是否微信登录（决定用 chooseAvatar 还是 chooseImage） */
    const isWechat = computed<boolean>(() : boolean => auth.loginProvider.value == 'wechat')

    onLoad((options : UTSJSONObject) => {
        const f = options['from']
        if (f != null) {
            from.value = `${f}`
        }
    })

    /** 微信头像选择回调（button open-type="chooseAvatar"） */
    function onChooseAvatar(e : any) : void {
        const evt = e as UTSJSONObject
        const detail = evt['detail'] as UTSJSONObject
        if (detail == null) return
        const url = detail['avatarUrl']
        if (url != null && (url as string).length > 0) {
            avatarUrl.value = url as string
            avatarFilePath.value = url as string
        }
    }

    /** 相册/拍照选择头像 */
    function onChooseImage() : void {
        uni.chooseImage({
            count: 1,
            sizeType: ['compressed'],
            sourceType: ['album', 'camera'],
            success: (res) => {
                const paths = res.tempFilePaths
                if (paths.length > 0) {
                    avatarUrl.value = paths[0]
                    avatarFilePath.value = paths[0]
                }
            },
            fail: (err) => {
                console.log('[profile-setup] chooseImage canceled/failed:', err)
            }
        })
    }

    function onNicknameInput(e : any) : void {
        const evt = e as UTSJSONObject
        const detail = evt['detail'] as UTSJSONObject
        if (detail == null) return
        const val = detail['value']
        nickName.value = val != null ? (val as string) : ''
    }

    /** 失败文案：优先用接口错误 message，回退到本步默认文案 */
    function errText(e : any, fallback : string) : string {
        if (e instanceof Error) {
            const m = (e as Error).message
            if (m != null && m.length > 0) return m
        }
        return fallback
    }

    /** 出口：from=login 回 choose-cert；其余回上一页，回不去则首页 */
    function leavePage() : void {
        const target = exitTargetOf(from.value)
        if (target.length > 0) {
            uni.reLaunch({ url: target })
            return
        }
        const pages = getCurrentPages()
        if (pages != null && pages.length > 1) {
            uni.navigateBack()
            return
        }
        uni.reLaunch({ url: homeFallbackUrl() })
    }

    async function onSubmit() : Promise<void> {
        if (submitting.value) return
        const draft = {
            avatarPicked: avatarFilePath.value,
            nicknameInput: nickName.value,
            avatarDone: avatarDone.value,
            nicknameDone: nicknameDone.value,
        } as FillDraft
        const steps = submitStepsOf(auth.user.value, draft)
        if (!steps.uploadAvatar && !steps.submitNickname) {
            uni.showToast({ title: '请先选择头像或填写昵称', icon: 'none' })
            return
        }
        submitting.value = true
        uni.showLoading({ title: '保存中...', mask: true })
        // 昵称超上限：截断后提交并提示（不阻断）
        if (steps.submitNickname && isNicknameTooLong(nickName.value)) {
            nickName.value = truncateNickname(nickName.value)
            uni.showToast({ title: truncateToastOf(), icon: 'none' })
        }
        if (steps.uploadAvatar) {
            try {
                await uploadAvatarApi(avatarFilePath.value)
                avatarDone.value = true
                avatarFilePath.value = ''
            } catch (e) {
                uni.hideLoading()
                uni.showToast({ title: errText(e, '头像上传失败'), icon: 'none' })
                submitting.value = false
                return
            }
        }
        if (steps.submitNickname) {
            const finalNickname = truncateNickname(nickName.value)
            try {
                await updateProfileApi({ nickname: finalNickname })
                nicknameDone.value = true
            } catch (e) {
                uni.hideLoading()
                uni.showToast({ title: errText(e, '昵称保存失败'), icon: 'none' })
                submitting.value = false
                return
            }
        }
        uni.hideLoading()
        submitting.value = false
        const toast = submitToastOf(from.value)
        if (toast.length > 0) {
            uni.showToast({ title: toast, icon: 'none', duration: 2000 })
            setTimeout(() => { leavePage() }, 1500)
            return
        }
        leavePage()
    }

    function onSkip() : void {
        leavePage()
    }
</script>

<style lang="scss">
    .setup-page { flex: 1; background-color: #ffffff; }
    .status-bar { background-color: $bg-header; }
    .header { align-items: center; padding: 80rpx 0 60rpx 0; }
    .title { font-size: 44rpx; font-weight: bold; color: #333333; }
    .subtitle { font-size: 28rpx; color: #999999; margin-top: 16rpx; }
    .section { padding: 0 56rpx; margin-bottom: 48rpx; }
    .section-label { font-size: 28rpx; color: #666666; margin-bottom: 20rpx; }
    .avatar-wrap { align-items: center; }
    .avatar-btn-wechat { width: 200rpx; height: 200rpx; border-radius: 100rpx; overflow: hidden; background-color: #F5F6FA; border: 2rpx dashed #07C160; padding: 0; margin: 0 auto; }
    .avatar-img { width: 200rpx; height: 200rpx; border-radius: 100rpx; }
    .avatar-placeholder { width: 200rpx; height: 200rpx; border-radius: 100rpx; background-color: #F5F6FA; border: 2rpx dashed #C8CDD8; align-items: center; justify-content: center; }
    .avatar-btn-wechat .avatar-placeholder { border-color: #07C160; }
    .avatar-icon { font-size: 60rpx; }
    .avatar-hint { font-size: 22rpx; color: #999999; margin-top: 8rpx; }
    .input-wrap { background-color: #F5F6FA; border-radius: 16rpx; height: 96rpx; padding: 0 28rpx; flex-direction: row; align-items: center; }
    .nickname-input { flex: 1; height: 96rpx; font-size: 30rpx; color: #333333; border: none; background-color: transparent; }
    .input-hint { font-size: 22rpx; color: #BBBBBB; margin-top: 12rpx; }
    .submit-area { padding: 40rpx 56rpx; align-items: center; }
    .btn-submit { width: 100%; height: 96rpx; border-radius: 48rpx; background-color: $primary-color; align-items: center; justify-content: center; }
    .btn-submit-text { font-size: 34rpx; font-weight: bold; color: #ffffff; }
    .btn-disabled { opacity: 0.5; }
    .skip-hint { font-size: 26rpx; color: #999999; margin-top: 32rpx; border-bottom-width: 1rpx; border-bottom-style: solid; border-bottom-color: #999999; padding-bottom: 2rpx; }
</style>
