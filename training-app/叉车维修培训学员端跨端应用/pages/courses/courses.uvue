<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <!-- #1608 批5 N05：手写 .status-bar + .header 收口进 app-nav-bar（transparent，页面自垫渐变底） -->
        <app-nav-bar transparent :left-icon="''" title="课程" />

        <!-- 顶部分类大按钮：资料课 / 课程 -->
        <view class="category-row">
            <view class="category-card" :class="{ 'category-card--active': activeCategory == 'material' }"
                @click="onCategoryTap('material')">
                <text class="category-card-icon">📚</text>
                <text class="category-card-text">资料课</text>
            </view>
            <view class="category-card ml-20" :class="{ 'category-card--active': activeCategory == 'course' }"
                @click="onCategoryTap('course')">
                <text class="category-card-icon">📥</text>
                <text class="category-card-text">课程</text>
            </view>
        </view>

        <!-- 资料课：内容建设中 -->
        <view v-if="activeCategory == 'material'" class="building-section">
            <view class="building-card">
                <text class="building-icon">🚧</text>
                <text class="building-title">{{ currentCertName }} 内容建设中</text>
                <text class="building-desc">资料课内容正在紧锣密鼓地筹备中，敬请期待！</text>
            </view>
        </view>

        <!-- 课程内容区 -->
        <view v-if="activeCategory == 'course'" class="course-section">
            <!-- 分组标题（#2230：原「精品课 / 图书同步精讲」子标签已摘除 —— 点击只换高亮、取数从不发生，见票面） -->
            <view class="section-card">
                <text class="section-card-title">课程</text>
            </view>

            <!-- 免费/付费组（#1951）：走后端布尔参数 paid，付费口径 = 需积分兑换（与详情页 CTA 同源） -->
            <view class="filter-row">
                <view v-for="(tag, idx) in paidTags" :key="idx"
                    :class="{ 'filter-tag': true, 'ml-16': idx > 0, 'filter-tag--active': activePaid == idx }" @click="onPaidTap(idx)">
                    <text class="filter-tag-text" :class="{ 'filter-tag-text--active': activePaid == idx }">{{ tag }}</text>
                </view>
            </view>
            <text class="paid-hint">「积分兑换」= 需用积分解锁的付费课，与课程详情页扣积分为同一口径</text>

            <!-- 课程列表：uvue 原生端页面本身不滚动 ⇒ 内容区必须自持 scroll-view（见 docs/ui-spec.md）。
                 f1ab2648 曾把该容器整段删掉 ⇒ 整页滑不动 + @scrolltolower 分页失效；
                 回归锁见 utils/uvuePageScrollContract.test.js（#1134） -->
            <scroll-view class="course-scroll" scroll-y="true" @scrolltolower="onLoadMore">
                <!-- #1331/#816：失败态与「暂无数据」分开 —— 5xx/断网不伪装成空列表，给可见错误 + 重试位 -->
                <view v-if="loadError && courses.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">课程加载失败，请检查网络后重试</text>
                    <view class="retry-btn" @click="loadCourses(true)">
                        <text class="retry-btn-text">重试</text>
                    </view>
                </view>
                <!-- #2443：空态按当前分组说人话 —— 「积分兑换」组恒空时不能只说「暂无课程数据」，
                     否则用户会以为整站没课（真实原因见 #2435：后端 points_price 无写入通道） -->
                <view v-else-if="courses.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">{{ emptyText }}</text>
                    <text v-if="emptyHint.length > 0" class="empty-hint">{{ emptyHint }}</text>
                </view>
                <view class="course-list">
                    <view v-for="(course, idx) in courses" :key="idx" class="course-item"
                        @click="onCourseClick(course.course_id)">
                        <view class="course-item-badge" :style="{ backgroundColor: getBadgeColor(course) }">
                            <text class="course-item-badge-text">{{ getBadgeText(course) }}</text>
                        </view>
                        <view class="course-item-info">
                            <text class="course-item-title">{{ course.title }}</text>
                            <!-- #2443/#2472：课时数按后端下发的 chapter_count 显示（#2083 起列表已下发；此前兜底成 6 是假数据） -->
                            <text v-if="chapterMetaText(course).length > 0" class="course-item-meta">{{ chapterMetaText(course) }}</text>
                        </view>
                        <!-- #2443：付费课在列表层就标出积分价 —— 兑换入口此前只在详情页，列表看不出哪门要积分 -->
                        <view v-if="hasPointsPrice(course)" class="course-item-price">
                            <text class="course-item-price-text">{{ pointsPriceText(course) }}</text>
                        </view>
                    </view>
                </view>

                <!-- 加载更多 -->
                <view v-if="loading" class="loading-more">
                    <text class="loading-text">加载中...</text>
                </view>
                <view v-if="noMore && courses.length > 0" class="loading-more">
                    <text class="loading-text">没有更多了</text>
                </view>

                <!-- 更多课程按钮 -->
                <view v-if="courses.length > 0" class="more-btn-wrap">
                    <view class="more-btn" @click="onLoadMore">
                        <text class="more-btn-text">更多课程</text>
                    </view>
                </view>
            </scroll-view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import AppNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { getCourseListApi, getCatalogTreeSpecialties, getLevelsApi } from '../../api/course'
    import { getCurrentCredentialApi } from '../../api/credential'
    import type { CourseItem, SpecialtyItem, LevelItem } from '../../types/index'

    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 当前证件（名称 + 分区参数）----
    // `/courses` 是公开路由，服务端 CredentialScoped 兜底永不生效（见 api/course.uts 文件头、
    // docs/agents/credential-scope.md）⇒ 页面必须显式下发当前证件，否则列出的是全证件课程。
    const currentCertName = ref<string>('')
    /** 「浏览指定」证件：随请求下发的分区参数（自解释名，与 Web api/client 半边同口径 #1106） */
    const browseCredentialId = ref<number>(0)
    let credentialRefresh : Promise<void> | null = null

    async function loadBrowseCredential() : Promise<void> {
        try {
            const cred = await getCurrentCredentialApi()
            if (cred != null) {
                currentCertName.value = cred!.name
                browseCredentialId.value = cred!.id
            }
        } catch (e) {
            console.warn('[courses] load credential failed:', e)
        }
    }

    /** 取数前确认证件已解析（onShow 会重置它，以便跟随证件切换） */
    function ensureBrowseCredential() : Promise<void> {
        if (credentialRefresh == null) {
            credentialRefresh = loadBrowseCredential()
        }
        return credentialRefresh!
    }

    // ---- 顶部分类 ----
    const activeCategory = ref<string>('course')

    function onCategoryTap(cat : string) : void {
        activeCategory.value = cat
    }

    // ---- 课程数据 ----
    // 免费/付费组状态（#1951）：端上只说语义，'' = 全部不下发；布尔字面量映射在 api/course.uts 单点完成
    const paidTags : string[] = ['全部', '免费', '积分兑换']
    const paidValues : string[] = ['', 'free', 'paid']
    const activePaid = ref<number>(0)
    /** filter 槽位（'' = 不按热门/精品收窄，本页固定取全量）。
     *  必须带 `: string` 注解 —— 裸写 `''` 字面量在 UTS 里推成 Char，当 String 实参报 §error17 */
    const courseListFilter : string = ''
    const courses = ref<CourseItem[]>([])
    const loading = ref<boolean>(false)
    const page = ref<number>(1)
    const pageSize = 12
    const total = ref<number>(0)
    const noMore = ref<boolean>(false)
    /** #1331：首屏失败标记 —— 失败与「暂无数据」必须分开（#816 口径），失败给可见错误 + 重试位，不伪装成空列表 */
    const loadError = ref<boolean>(false)

    // ---- 空态文案（#2443）----
    // 「积分兑换」组恒空是当前真实状态（后端 points_price 无写入通道，见 #2435 / #2447），
    // 只说「暂无课程数据」会让用户误以为整站没课 ⇒ 按分组给不同文案 + 一句出路。
    const emptyText = computed((): string => {
        if (activePaid.value == 2) return '暂无可兑换课程'
        if (activePaid.value == 1) return '暂无免费课程'
        return '暂无课程数据'
    })

    const emptyHint = computed((): string => {
        if (activePaid.value == 2) return '课程暂未开放积分兑换，可先看「全部」或「免费」'
        return ''
    })

    async function loadCourses(reset : boolean) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loading.value = true
        try {
            await ensureBrowseCredential()
            const result = await getCourseListApi(page.value, pageSize, 0, 0, browseCredentialId.value, courseListFilter, paidValues[activePaid.value])
            loadError.value = false
            if (reset) {
                courses.value = result.items
            } else {
                courses.value = courses.value.concat(result.items)
            }
            total.value = result.total
            if (courses.value.length >= result.total || result.items.length == 0) {
                noMore.value = true
            } else {
                page.value = page.value + 1
            }
        } catch (e) {
            console.error('[courses] load failed:', e)
            loadError.value = true
            uni.showToast({ title: '加载课程失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // ---- 免费/付费组（#1951）----
    // 状态声明在「课程数据」段之前：UTS 按声明顺序解析 setup 作用域里的标识符，
    // 后置声明在 loadCourses 里取会报「找不到名称」（首次实测就踩到，别挪回去）
    function onPaidTap(idx : number) : void {
        // 同组重复点击不重取：paid 是服务端口径 ⇒ 换值必须回第一页重拉，同值则无事可做
        if (activePaid.value == idx) return
        activePaid.value = idx
        loadCourses(true)
    }

    const specialties = ref<SpecialtyItem[]>([])
    const levels = ref<LevelItem[]>([])

    async function loadSpecialties() : Promise<void> {
        try {
            specialties.value = await getCatalogTreeSpecialties()
        } catch (e) {
            // #1331：筛选条失败保持**静默降级**（job-list 同款先例）—— 它是辅助数据，主列表失败态已承载「可见」；
            // 且入口两条 toast 会互相顶掉反而变糊。徽标由 getBadgeText 回退「基础」，重进页即重拉。判据见 ADR-0007 实施回记。
            console.error('[courses] load specialties failed:', e)
        }
    }

    async function loadLevels() : Promise<void> {
        try {
            levels.value = await getLevelsApi()
        } catch (e) {
            // #1331：同 loadSpecialties —— 筛选条失败静默降级（判据见 ADR-0007 实施回记）
            console.error('[courses] load levels failed:', e)
        }
    }

    function getBadgeText(course : CourseItem) : string {
        if (course.level_id > 0) {
            for (let i = 0; i < levels.value.length; i++) {
                if (levels.value[i].level_id == course.level_id) {
                    return levels.value[i].name
                }
            }
        }
        if (course.specialty_id > 0) {
            for (let i = 0; i < specialties.value.length; i++) {
                if (specialties.value[i].specialty_id == course.specialty_id) {
                    return specialties.value[i].name
                }
            }
        }
        // #1087：旧 course.category 已退役（后端 /api/courses 不返回该字段 ⇒ 旧两条分支恒不命中）。
        // 真实数据下 specialty_id / level_id 必有值（backend/internal/service/course_mount_scope.go 强制两者非空），
        // 故此处仅剩 level/specialty 名称查不到时的兜底。
        return '基础'
    }

    function getBadgeColor(course : CourseItem) : string {
        const text = getBadgeText(course)
        if (text == '入门' || text == '冲刺') return '#239EDD'
        if (text == '进阶' || text == '专项') return '#e6a23c'
        return '#909399'
    }

    // ---- 列表行辅助（#2443）----
    /** 课时数按后端下发的 chapter_count 显示（#2083 起列表已下发，0 不显示）；此前兜底成 6 是假数据 */
    function chapterMetaText(course : CourseItem) : string {
        if (course.chapter_count > 0) return '共' + course.chapter_count + '个课时'
        return ''
    }

    /** 付费课判定：points_price 有值且 > 0（与详情页 CTA 同源，见 #1951 / ADR-0031） */
    function hasPointsPrice(course : CourseItem) : boolean {
        const p = course.points_price
        return p != null && p! > 0
    }

    function pointsPriceText(course : CourseItem) : string {
        const p = course.points_price
        if (p == null) return ''
        return p! + ' 积分'
    }

    function onLoadMore() : void {
        loadCourses(false)
    }

    function onCourseClick(courseId : number) : void {
        uni.navigateTo({
            url: '/pages/courses/course-detail?id=' + courseId
        })
    }

    onShow(async () => {
        const prevCredentialId = browseCredentialId.value
        credentialRefresh = loadBrowseCredential()
        await Promise.all([loadSpecialties(), loadLevels()])
        await ensureBrowseCredential()
        // 证件切换 ⇒ 受过滤视图立即按新证件重取（CONTEXT.md「当前证件」：切换立即生效、回到第一页）；
        // 证件未变时保持既有行为（列表非空不重取，避免从课程详情返回时丢掉滚动位置）
        if (browseCredentialId.value != prevCredentialId) {
            loadCourses(true)
        } else if (courses.value.length == 0) {
            loadCourses(true)
        }
    })
</script>

<style lang="scss">
    .container {
        display: flex;
        /* 批5 N05（票1608）：tabBar 渐变页模板（ui-spec §6.1），色值走 token（§1.2） */
        background: linear-gradient(to bottom, $gradient-start, $gradient-end);
        background-color: $gradient-end;
        flex-direction: column;
    }

    /* 批5 N05（票1608）：原页头三件套样式随页头件收口删除 */

    /* ---- 顶部分类大按钮 ---- */
    .category-row {
        flex-direction: row;
        padding: 12rpx 32rpx 16rpx;
    }

    .category-card {
        flex: 1;
        height: 100rpx;
        border-radius: 20rpx;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to bottom right, #60A5FA, #3B82F6);
        background-color: #3B82F6;
        opacity: 0.7;
    }

    .category-card--active {
        opacity: 1;
    }

    .category-card-icon {
        font-size: 36rpx;
        margin-right: 10rpx;
    }

    .category-card-text {
        font-size: 32rpx;
        font-weight: 600;
        color: #ffffff;
    }

    /* ---- 资料课建设中 ---- */
    .building-section {
        flex: 1;
        padding: 32rpx;
        align-items: center;
        justify-content: center;
    }

    .building-card {
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 60rpx 40rpx;
        align-items: center;
        width: 100%;
    }

    .building-icon {
        font-size: 80rpx;
        margin-bottom: 24rpx;
    }

    .building-title {
        font-size: 32rpx;
        font-weight: 600;
        color: #333333;
        margin-bottom: 16rpx;
    }

    .building-desc {
        font-size: 26rpx;
        color: #999999;
        text-align: center;
    }

    /* ---- 课程内容区 ---- */
    .course-section {
        flex: 1;
        flex-direction: column;
    }

    .section-card {
        background-color: #ffffff;
        margin: 0 32rpx 16rpx;
        border-radius: 16rpx;
        padding: 24rpx 28rpx;
    }

    .section-card-title {
        font-size: 32rpx;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 16rpx;
    }

    /* ---- 筛选标签 ---- */
    .filter-row {
        flex-direction: row;
        padding: 0 32rpx 16rpx;
    }

    .filter-tag {
        padding: 8rpx 24rpx;
        border-radius: 20rpx;
        background-color: #ffffff;
        border-width: 1rpx;
        border-color: #e0e0e0;
        border-style: solid;
    }

    .filter-tag--active {
        background-color: #EBF5FF;
        border-color: $primary-color;
    }

    .filter-tag-text {
        font-size: 24rpx;
        color: #666666;
    }

    .filter-tag-text--active {
        color: $primary-color;
    }

    /* 免费/付费组提示（#1951）：文字样式必须落 <text>（红线），落 view 会被静默忽略并逐处报错；
       色取 $text-color-placeholder(#999999) —— 辅助说明灰，不用白名单外的自造灰（§9 机检会判红） */
    .paid-hint {
        font-size: 22rpx;
        color: #999999;
        padding: 0 32rpx 16rpx;
    }

    /* ---- 课程列表 ---- */
    /* flex:1 + height:0 —— 在 flex 列容器里给 scroll-view 定高（f1ab2648 之前 .course-scroll 的同款写法）。
       不设 padding：子块自带内边距（.course-list / .more-btn-wrap），重复设会改变横向留白 */
    .course-scroll {
        flex: 1;
        height: 0;
    }

    .course-list {
        padding: 0 32rpx;
    }

    .course-item {
        flex-direction: row;
        align-items: center;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 28rpx 24rpx;
        margin-bottom: 16rpx;
    }

    .course-item-badge {
        padding: 8rpx 20rpx;
        border-radius: 8rpx;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .course-item-badge-text {
        font-size: 24rpx;
        font-weight: 600;
        color: #ffffff;
    }

    .course-item-info {
        flex: 1;
        flex-direction: column;
    }

    .course-item-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 6rpx;
    }

    .course-item-meta {
        font-size: 24rpx;
        color: #999999;
    }

    /* #2443：付费课积分价签 —— 右端固定，不参与标题挤压 */
    .course-item-price {
        flex-shrink: 0;
        margin-left: 16rpx;
        padding: 6rpx 16rpx;
        border-radius: 8rpx;
        background-color: #EBF5FF;
    }

    .course-item-price-text {
        font-size: 24rpx;
        font-weight: 600;
        color: $primary-color;
    }

    /* ---- 更多课程按钮 ---- */
    .more-btn-wrap {
        align-items: center;
        padding: 24rpx 32rpx 48rpx;
    }

    .more-btn {
        padding: 18rpx 64rpx;
        border-radius: 32rpx;
        border-width: 2rpx;
        border-color: $primary-color;
        border-style: solid;
        background-color: #ffffff;
    }

    .more-btn-text {
        font-size: 28rpx;
        color: $primary-color;
        font-weight: 500;
    }

    /* ---- 空状态 / 加载 ---- */
    .empty-tip {
        align-items: center;
        padding: 80rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    /* #2443：空态出路提示（比主文案小一号；色沿用 $text-color-placeholder(#999999)，不自造灰） */
    .empty-hint {
        font-size: 24rpx;
        color: #999999;
        margin-top: 12rpx;
        text-align: center;
        padding: 0 48rpx;
    }

    /* #1331：失败态重试位（与 course-detail / chapter-view 的 retry-btn 同款形态） */
    .retry-btn {
        background-color: $primary-color;
        border-radius: 32rpx;
        padding: 16rpx 48rpx;
        margin-top: 24rpx;
    }

    .retry-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    .ml-16 { margin-left: 16rpx; }
    .ml-20 { margin-left: 20rpx; }
</style>
