<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部标题 -->
        <view class="header">
            <text class="header-title">课程</text>
        </view>

        <!-- 顶部分类大按钮：资料课 / 课程 -->
        <view class="category-row">
            <view class="category-card" :class="{ 'category-card--active': activeCategory == 'material' }"
                @click="onCategoryTap('material')">
                <text class="category-card-icon">📚</text>
                <text class="category-card-text">资料课</text>
            </view>
            <view class="category-card ml-20" :class="{ 'category-card--active': activeCategory == 'course' }"
                @click="onCategoryTap('course')">
                <text class="category-card-icon">📥</text>
                <text class="category-card-text">课程</text>
            </view>
        </view>

        <!-- 资料课：内容建设中 -->
        <view v-if="activeCategory == 'material'" class="building-section">
            <view class="building-card">
                <text class="building-icon">🚧</text>
                <text class="building-title">{{ currentCertName }} 内容建设中</text>
                <text class="building-desc">资料课内容正在紧锣密鼓地筹备中，敬请期待！</text>
            </view>
        </view>

        <!-- 课程内容区 -->
        <view v-if="activeCategory == 'course'" class="course-section">
            <!-- 子分类标题 + tabs -->
            <view class="section-card">
                <text class="section-card-title">课程</text>
                <view class="sub-tab-row">
                    <view v-for="(tab, idx) in subTabs" :key="idx"
                        :class="{ 'sub-tab': true, 'ml-16': idx > 0, 'sub-tab--active': activeSubTab == idx }" @click="onSubTabTap(idx)">
                        <text class="sub-tab-text" :class="{ 'sub-tab-text--active': activeSubTab == idx }">{{ tab }}</text>
                    </view>
                </view>
            </view>

            <!-- 筛选标签 -->
            <view class="filter-row">
                <view v-for="(tag, idx) in filterTags" :key="idx"
                    :class="{ 'filter-tag': true, 'ml-16': idx > 0, 'filter-tag--active': activeFilter == idx }" @click="onFilterTap(idx)">
                    <text class="filter-tag-text" :class="{ 'filter-tag-text--active': activeFilter == idx }">{{ tag }}</text>
                </view>
            </view>

            <!-- 课程列表：uvue 原生端页面本身不滚动 ⇒ 内容区必须自持 scroll-view（见 docs/ui-spec.md）。
                 f1ab2648 曾把该容器整段删掉 ⇒ 整页滑不动 + @scrolltolower 分页失效；
                 回归锁见 utils/uvuePageScrollContract.test.js（#1134） -->
            <scroll-view class="course-scroll" scroll-y="true" @scrolltolower="onLoadMore">
                <view v-if="courses.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">暂无课程数据</text>
                </view>
                <view class="course-list">
                    <view v-for="(course, idx) in courses" :key="idx" class="course-item"
                        @click="onCourseClick(course.course_id)">
                        <view class="course-item-badge" :style="{ backgroundColor: getBadgeColor(course) }">
                            <text class="course-item-badge-text">{{ getBadgeText(course) }}</text>
                        </view>
                        <view class="course-item-info">
                            <text class="course-item-title">{{ course.title }}</text>
                            <text class="course-item-meta">共{{ course.chapter_count > 0 ? course.chapter_count : 6 }}个课时</text>
                        </view>
                    </view>
                </view>

                <!-- 加载更多 -->
                <view v-if="loading" class="loading-more">
                    <text class="loading-text">加载中...</text>
                </view>
                <view v-if="noMore && courses.length > 0" class="loading-more">
                    <text class="loading-text">没有更多了</text>
                </view>

                <!-- 更多课程按钮 -->
                <view v-if="courses.length > 0" class="more-btn-wrap">
                    <view class="more-btn" @click="onLoadMore">
                        <text class="more-btn-text">更多课程</text>
                    </view>
                </view>
            </scroll-view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { getCourseListApi, getCatalogTreeSpecialties, getLevelsApi } from '../../api/course'
    import { getCurrentCredentialApi } from '../../api/credential'
    import type { CourseItem, SpecialtyItem, LevelItem } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 当前证件（名称 + 分区参数）----
    // `/courses` 是公开路由，服务端 CredentialScoped 兜底永不生效（见 api/course.uts 文件头、
    // docs/agents/credential-scope.md）⇒ 页面必须显式下发当前证件，否则列出的是全证件课程。
    const currentCertName = ref<string>('')
    /** 「浏览指定」证件：随请求下发的分区参数（自解释名，与 Web api/client 半边同口径 #1106） */
    const browseCredentialId = ref<number>(0)
    let credentialRefresh : Promise<void> | null = null

    async function loadBrowseCredential() : Promise<void> {
        try {
            const cred = await getCurrentCredentialApi()
            if (cred != null) {
                currentCertName.value = cred!.name
                browseCredentialId.value = cred!.id
            }
        } catch (e) {
            console.warn('[courses] load credential failed:', e)
        }
    }

    /** 取数前确认证件已解析（onShow 会重置它，以便跟随证件切换） */
    function ensureBrowseCredential() : Promise<void> {
        if (credentialRefresh == null) {
            credentialRefresh = loadBrowseCredential()
        }
        return credentialRefresh!
    }

    // ---- 顶部分类 ----
    const activeCategory = ref<string>('course')

    function onCategoryTap(cat : string) : void {
        activeCategory.value = cat
    }

    // ---- 子分类 tabs ----
    const subTabs : string[] = ['精品课', '图书同步精讲']
    const activeSubTab = ref<number>(0)

    function onSubTabTap(idx : number) : void {
        activeSubTab.value = idx
    }

    // ---- 课程数据 ----
    const courses = ref<CourseItem[]>([])
    const loading = ref<boolean>(false)
    const page = ref<number>(1)
    const pageSize = 12
    const total = ref<number>(0)
    const noMore = ref<boolean>(false)

    async function loadCourses(reset : boolean) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loading.value = true
        try {
            await ensureBrowseCredential()
            const result = await getCourseListApi(page.value, pageSize, 0, 0, browseCredentialId.value)
            if (reset) {
                courses.value = result.items
            } else {
                courses.value = courses.value.concat(result.items)
            }
            total.value = result.total
            if (courses.value.length >= result.total || result.items.length == 0) {
                noMore.value = true
            } else {
                page.value = page.value + 1
            }
        } catch (e) {
            console.error('[courses] load failed:', e)
            uni.showToast({ title: '加载课程失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // ---- 筛选标签 ----
    const filterTags : string[] = ['已完结', '进行中', '全部']
    const activeFilter = ref<number>(0)

    function onFilterTap(idx : number) : void {
        activeFilter.value = idx
        loadCourses(true)
    }

    const specialties = ref<SpecialtyItem[]>([])
    const levels = ref<LevelItem[]>([])

    async function loadSpecialties() : Promise<void> {
        try {
            specialties.value = await getCatalogTreeSpecialties()
        } catch (e) {
            console.error('[courses] load specialties failed:', e)
        }
    }

    async function loadLevels() : Promise<void> {
        try {
            levels.value = await getLevelsApi()
        } catch (e) {
            console.error('[courses] load levels failed:', e)
        }
    }

    function getBadgeText(course : CourseItem) : string {
        if (course.level_id > 0) {
            for (let i = 0; i < levels.value.length; i++) {
                if (levels.value[i].level_id == course.level_id) {
                    return levels.value[i].name
                }
            }
        }
        if (course.specialty_id > 0) {
            for (let i = 0; i < specialties.value.length; i++) {
                if (specialties.value[i].specialty_id == course.specialty_id) {
                    return specialties.value[i].name
                }
            }
        }
        // #1087：旧 course.category 已退役（后端 /api/courses 不返回该字段 ⇒ 旧两条分支恒不命中）。
        // 真实数据下 specialty_id / level_id 必有值（backend/internal/service/course_mount_scope.go 强制两者非空），
        // 故此处仅剩 level/specialty 名称查不到时的兜底。
        return '基础'
    }

    function getBadgeColor(course : CourseItem) : string {
        const text = getBadgeText(course)
        if (text == '入门' || text == '冲刺') return '#2979ff'
        if (text == '进阶' || text == '专项') return '#e6a23c'
        return '#909399'
    }

    function onLoadMore() : void {
        loadCourses(false)
    }

    function onCourseClick(courseId : number) : void {
        uni.navigateTo({
            url: '/pages/courses/course-detail?id=' + courseId
        })
    }

    onShow(async () => {
        const prevCredentialId = browseCredentialId.value
        credentialRefresh = loadBrowseCredential()
        await Promise.all([loadSpecialties(), loadLevels()])
        await ensureBrowseCredential()
        // 证件切换 ⇒ 受过滤视图立即按新证件重取（CONTEXT.md「当前证件」：切换立即生效、回到第一页）；
        // 证件未变时保持既有行为（列表非空不重取，避免从课程详情返回时丢掉滚动位置）
        if (browseCredentialId.value != prevCredentialId) {
            loadCourses(true)
        } else if (courses.value.length == 0) {
            loadCourses(true)
        }
    })
</script>

<style>
    .container {
        display: flex;
        background: linear-gradient(to bottom, #CFE9FB, #D0EBFD);
        background-color: #D0EBFD;
        flex-direction: column;
    }

    .status-bar {
        background-color: transparent;
    }

    /* ---- 顶部标题 ---- */
    .header {
        padding: 20rpx 0 12rpx;
        align-items: center;
    }

    .header-title {
        font-size: 38rpx;
        font-weight: 700;
        color: #1a1a1a;
    }

    /* ---- 顶部分类大按钮 ---- */
    .category-row {
        flex-direction: row;
        padding: 12rpx 32rpx 16rpx;
    }

    .category-card {
        flex: 1;
        height: 100rpx;
        border-radius: 20rpx;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to bottom right, #60A5FA, #3B82F6);
        background-color: #3B82F6;
        opacity: 0.7;
    }

    .category-card--active {
        opacity: 1;
    }

    .category-card-icon {
        font-size: 36rpx;
        margin-right: 10rpx;
    }

    .category-card-text {
        font-size: 32rpx;
        font-weight: 600;
        color: #ffffff;
    }

    /* ---- 资料课建设中 ---- */
    .building-section {
        flex: 1;
        padding: 32rpx;
        align-items: center;
        justify-content: center;
    }

    .building-card {
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 60rpx 40rpx;
        align-items: center;
        width: 100%;
    }

    .building-icon {
        font-size: 80rpx;
        margin-bottom: 24rpx;
    }

    .building-title {
        font-size: 32rpx;
        font-weight: 600;
        color: #333333;
        margin-bottom: 16rpx;
    }

    .building-desc {
        font-size: 26rpx;
        color: #999999;
        text-align: center;
    }

    /* ---- 课程内容区 ---- */
    .course-section {
        flex: 1;
        flex-direction: column;
    }

    .section-card {
        background-color: #ffffff;
        margin: 0 32rpx 16rpx;
        border-radius: 16rpx;
        padding: 24rpx 28rpx;
    }

    .section-card-title {
        font-size: 32rpx;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 16rpx;
    }

    .sub-tab-row {
        flex-direction: row;
    }

    .sub-tab {
        padding: 10rpx 24rpx;
        border-radius: 24rpx;
        border-width: 2rpx;
        border-color: #e0e0e0;
        border-style: solid;
    }

    .sub-tab--active {
        border-color: #2979ff;
    }

    .sub-tab-text {
        font-size: 26rpx;
        color: #666666;
    }

    .sub-tab-text--active {
        color: #2979ff;
        font-weight: 600;
    }

    /* ---- 筛选标签 ---- */
    .filter-row {
        flex-direction: row;
        padding: 0 32rpx 16rpx;
    }

    .filter-tag {
        padding: 8rpx 24rpx;
        border-radius: 20rpx;
        background-color: #ffffff;
        border-width: 1rpx;
        border-color: #e0e0e0;
        border-style: solid;
    }

    .filter-tag--active {
        background-color: #EBF5FF;
        border-color: #2979ff;
    }

    .filter-tag-text {
        font-size: 24rpx;
        color: #666666;
    }

    .filter-tag-text--active {
        color: #2979ff;
    }

    /* ---- 课程列表 ---- */
    /* flex:1 + height:0 —— 在 flex 列容器里给 scroll-view 定高（f1ab2648 之前 .course-scroll 的同款写法）。
       不设 padding：子块自带内边距（.course-list / .more-btn-wrap），重复设会改变横向留白 */
    .course-scroll {
        flex: 1;
        height: 0;
    }

    .course-list {
        padding: 0 32rpx;
    }

    .course-item {
        flex-direction: row;
        align-items: center;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 28rpx 24rpx;
        margin-bottom: 16rpx;
    }

    .course-item-badge {
        padding: 8rpx 20rpx;
        border-radius: 8rpx;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .course-item-badge-text {
        font-size: 24rpx;
        font-weight: 600;
        color: #ffffff;
    }

    .course-item-info {
        flex: 1;
        flex-direction: column;
    }

    .course-item-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 6rpx;
    }

    .course-item-meta {
        font-size: 24rpx;
        color: #999999;
    }

    /* ---- 更多课程按钮 ---- */
    .more-btn-wrap {
        align-items: center;
        padding: 24rpx 32rpx 48rpx;
    }

    .more-btn {
        padding: 18rpx 64rpx;
        border-radius: 32rpx;
        border-width: 2rpx;
        border-color: #2979ff;
        border-style: solid;
        background-color: #ffffff;
    }

    .more-btn-text {
        font-size: 28rpx;
        color: #2979ff;
        font-weight: 500;
    }

    /* ---- 空状态 / 加载 ---- */
    .empty-tip {
        align-items: center;
        padding: 80rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    .ml-16 { margin-left: 16rpx; }
    .ml-20 { margin-left: 20rpx; }
</style>
