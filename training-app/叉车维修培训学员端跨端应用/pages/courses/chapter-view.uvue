    }

    .status-tag {
        font-size: 22rpx;
        padding: 6rpx 16rpx;
        border-radius: 8rpx;
        margin-right: 16rpx;
    }

    .status-tag.completed {
        color: #4caf50;
        background-color: #e8f5e9;
    }

    .status-tag.studying {
        color: #ff9800;
        background-color: #fff3e0;
    }

