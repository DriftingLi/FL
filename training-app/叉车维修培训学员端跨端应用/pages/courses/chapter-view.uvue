        margin-top: 16rpx;
        padding: 32rpx;
    }

    .section-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 20rpx;
    }

    .chapter-content {
        font-size: 28rpx;
        color: #666666;
        line-height: 48rpx;
    }

    /* ===== Markdown 渲染样式 ===== */
    .md-section {
        padding: 32rpx;
    }

    .md-block {
        margin-bottom: 24rpx;
    }

    .md-block:last-child {
        margin-bottom: 0;
    }

    /* 标题 */
    .md-heading {
