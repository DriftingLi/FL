    }

    .file-icon-video {
        background-color: #ffebee;
    }

    .file-icon-doc {
        background-color: #e3f2fd;
    }

    .file-icon-ppt {
        background-color: #fff3e0;
    }

    .file-icon-image {
        background-color: #e8f5e9;
    }

    .file-icon-default {
        background-color: #f5f5f5;
    }

    .file-icon {
        font-size: 36rpx;
    }

    .file-info {
