<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">{{ detail != null ? detail!.title : '章节学习' }}</text>
            <!-- 收藏 / 取消（#1140）：与课程详情同形；两态都必须有可见字形（空串观感上等于没有收藏功能） -->
            <view class="header-right" @click="toggleFavorite">
                <text class="favorite-icon">{{ isFavorited ? '♥' : '♡' }}</text>
            </view>
        </view>

        <!-- 加载中 -->
        <view v-if="loading" class="loading-wrap">
            <text class="loading-text">正在加载...</text>
        </view>

        <!-- 未解锁（#1268）：后端对未兑换的付费章节返回 404 —— 不是加载失败，重试必然再 404，
             故这一支**不给重试入口**（给了就是硬死胡同）；「去解锁」待移动端上课程兑换面后补（票内排后项） -->
        <view v-else-if="chapterLocked" class="empty-wrap">
            <text class="empty-text">该章节需先解锁</text>
        </view>

        <!-- 加载失败 -->
        <view v-else-if="detail == null || detail!.chapter_id == 0" class="empty-wrap">
            <text class="empty-text">章节内容加载失败</text>
            <view class="retry-btn" @click="loadDetail">
                <text class="retry-btn-text">重试</text>
            </view>
        </view>

        <!-- 章节内容 -->
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <!-- 章节标题区 -->
            <view class="chapter-header">
                <text class="chapter-title">{{ detail!.title }}</text>
                <view class="chapter-meta">
                    <text v-if="detail!.study_status == 'completed'" class="status-tag completed">已完成</text>
                    <text v-else class="status-tag studying">学习中</text>
                    <text class="chapter-duration">预计 {{ formatDuration(detail!.duration) }}</text>
                </view>
            </view>

            <!-- 图文内容（Markdown 渲染）：渲染分支随 T08 手术搬入 chapter-markdown 组件 -->
            <ChapterMarkdown v-if="detail!.content.length > 0" :blocks="contentBlocks"
                @image-click="onImageClick" />

            <!-- 附件列表：图标/类型映射随 T08 手术搬入 chapter-file-list 组件 -->
            <ChapterFileList v-if="detail!.files.length > 0" :files="detail!.files"
                @file-click="onFileClick" />

            <!-- 无内容提示 -->
            <view v-if="detail!.content.length == 0 && detail!.files.length == 0" class="empty-tip">
                <text class="empty-text">该章节暂无内容</text>
            </view>

            <!-- 标记完成（#1111：对齐 web 的显式完成路径；已完成则收起入口） -->
            <view v-if="!isChapterCompleted" class="mark-done-wrap">
                <view class="mark-done-btn" :class="{ 'mark-done-btn--busy': markingCompleted }" @click="onMarkCompleted">
                    <text class="mark-done-text">{{ markingCompleted ? '提交中...' : '标记本章完成' }}</text>
                </view>
            </view>

            <!-- 上/下章导航：标题由页面计算下发，切章 emit 回页面 -->
            <ChapterNav :prev-chapter-id="detail!.previous_chapter_id" :next-chapter-id="detail!.next_chapter_id"
                :prev-title="prevTitle" :next-title="nextTitle"
                @prev="onPrevChapter" @next="onNextChapter" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onHide, onUnload } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { parseMarkdown } from '../../utils/markdown'
    import { getCourseDetailApi, getChapterDetailApi, isChapterNotFound } from '../../api/course'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import ChapterMarkdown from './components/chapter-markdown.uvue'
    import ChapterFileList from './components/chapter-file-list.uvue'
    import ChapterNav from './components/chapter-nav.uvue'
    import { useChapterStudy } from './composables/useChapterStudy'
    import type { ChapterDetail, ChapterFile, CourseDetail, MarkdownBlock } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const courseId = ref<number>(0)
    const chapterId = ref<number>(0)
    const detail = ref<ChapterDetail | null>(null)
    const loading = ref<boolean>(true)

    /**
     * 本章是否「未解锁」（#1268）—— 唯一判据是后端 404，走 `api/course.uts` 的 `isChapterNotFound()`。
     *
     * 与 `detail` 分开持有：404 时 `detail` 仍是 `null`，若靠它渲染就只剩「加载失败 + 重试」那一支
     * （对未解锁是误报，且重试永远失败）。每次 `loadDetail` 开头归零，防切章后带着上一章的判定。
     */
    const chapterLocked = ref<boolean>(false)

    /**
     * 本章收藏态（#1140）。
     *
     * 与 `detail` 同层：进页 / 切章由 `loadFavoriteStatus` 从后端回填，
     * 不另存一份「前端以为的收藏态」（照 T05「同一事实不两处持有」）。
     */
    const isFavorited = ref<boolean>(false)
    const favoriteId = ref<number>(0)

    // 用于上下章标题显示
    const courseDetail = ref<CourseDetail | null>(null)
    const prevTitle = ref<string>('')
    const nextTitle = ref<string>('')

    // 学习计时与增量上报走模块私有 composable；uni 生命周期钩子仍留在页面壳层（T06/T07 先例）
    const study = useChapterStudy()

    // Markdown 解析后的内容块
    const contentBlocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => {
        if (detail.value == null) return [] as MarkdownBlock[]
        if (detail.value!.content.length == 0) return [] as MarkdownBlock[]
        return parseMarkdown(detail.value!.content)
    })

    /**
     * 本章是否已完成 —— 以后端 `study_status` 为唯一判据（不在前端另存一份完成态，
     * 照 T05「同一事实不两处持有」）。「标记完成」入口据此隐藏。
     */
    const isChapterCompleted = computed<boolean>(() : boolean => {
        if (detail.value == null) return false
        return detail.value!.study_status == 'completed'
    })

    function formatDuration(minutes : number) : string {
        if (minutes <= 0) return '未知'
        if (minutes < 60) return minutes + '分钟'
        const hours = Math.floor(minutes / 60)
        const mins = minutes % 60
        return hours + '小时' + (mins > 0 ? mins + '分' : '')
    }

    function updateNavTitles() {
        if (detail.value == null || courseDetail.value == null) {
            prevTitle.value = ''
            nextTitle.value = ''
            return
        }
        const chapters = courseDetail.value!.chapters
        const prevId = detail.value!.previous_chapter_id
        const nextId = detail.value!.next_chapter_id
        prevTitle.value = ''
        nextTitle.value = ''
        for (let i = 0; i < chapters.length; i++) {
            const ch = chapters[i]
            if (ch.chapter_id == prevId) prevTitle.value = ch.title
            if (ch.chapter_id == nextId) nextTitle.value = ch.title
        }
    }

    /**
     * 查询本章收藏状态（#1140）。
     *
     * 与同域先例 `course-detail.uvue:91-100` 同式，两处差异是**刻意的**：
     * ① `target_type` 是 `'chapter'`、`target_id` 用**章节 id**（不是课程 id）——
     *    从课程详情抄接线而忘改这两处会「看起来能用」（有心形、点击有 toast），
     *    但收藏落到**课程**上；
     * ② 回写前比一次章号：上一章 / 下一章连点时会撞上「旧响应迟到」，
     *    迟到的结果不得覆盖当前章节的状态（否则心形显示的是上一章的收藏态）。
     *
     * 失败只告警、**不回写状态** —— 收藏是页面的旁路，取不到就让控件停在「未收藏」，
     * 绝不阻断正文渲染（调用点在 `loadDetail` 末尾，fire-and-forget）。
     */
    async function loadFavoriteStatus() : Promise<void> {
        if (chapterId.value <= 0) return
        const targetId = chapterId.value
        try {
            const result = await checkFavoriteApi('chapter', targetId)
            if (chapterId.value != targetId) return
            isFavorited.value = result.favorited
            favoriteId.value = result.favorite_id
        } catch (e) {
            console.warn('[chapter-view] checkFavorite failed:', e)
        }
    }

    /**
     * 收藏 / 取消收藏（#1140）—— 形状对齐课程详情的 `toggleFavorite`。
     *
     * 失败**不得谎报成功**：只有 await 过了才翻状态与提示，catch 里一律「操作失败」。
     * 章号在发出前先钉住：响应回来时用户可能已经切章，那时不再改写当前页的状态。
     */
    async function toggleFavorite() : Promise<void> {
        const targetId = chapterId.value
        if (targetId <= 0) return
        try {
            if (isFavorited.value) {
                await removeFavoriteApi(favoriteId.value)
                if (chapterId.value != targetId) return
                isFavorited.value = false
                favoriteId.value = 0
                uni.showToast({ title: '已取消收藏', icon: 'none' })
            } else {
                const result = await addFavoriteApi('chapter', targetId)
                if (chapterId.value != targetId) return
                isFavorited.value = true
                favoriteId.value = result.favorite_id
                uni.showToast({ title: '收藏成功', icon: 'none' })
            }
        } catch (e) {
            console.error('[chapter-view] toggleFavorite failed:', e)
            uni.showToast({ title: '操作失败', icon: 'none' })
        }
    }

    // 看课上报积分的调用已删除：/points/course-view 后端从未注册（#662），看课计分待后端补

    async function loadDetail() : Promise<void> {
        if (courseId.value <= 0 || chapterId.value <= 0) return
        loading.value = true
        detail.value = null
        chapterLocked.value = false
        study.stopStudy()
        try {
            const data = await getChapterDetailApi(courseId.value, chapterId.value)
            detail.value = data
            // 加载课程详情以获取上下章标题
            if (courseDetail.value == null) {
                const cd = await getCourseDetailApi(courseId.value)
                courseDetail.value = cd
            }
            updateNavTitles()
            study.beginStudy(courseId.value, data.chapter_id)
        } catch (e) {
            console.error('[chapter-view] load failed:', e)
            // 404 = 后端鉴权收回的「未解锁」（#1268），不是加载失败：判定只走 `isChapterNotFound()` 这一个出口
            chapterLocked.value = isChapterNotFound(e)
        } finally {
            loading.value = false
        }
        // 进页 / 切章后都要重查收藏态（放在 try/finally 之后：查收藏失败不影响正文渲染）
        loadFavoriteStatus()
    }

    function onBack() : void {
        goBack()
    }

    /**
     * 标记本章完成（#1111：对齐 web frontend/src/pages/student/ChapterView.vue:374 的显式完成路径）。
     *
     * 上报走模块私有 composable（页面层不直接发请求，T08 收紧口径）；
     * 成功后刷新章节详情，让 `study_status` 由后端权威值翻转（web 同样在标记后重取详情）。
     */
    const markingCompleted = ref<boolean>(false)

    async function onMarkCompleted() : Promise<void> {
        if (detail.value == null || markingCompleted.value) return
        if (isChapterCompleted.value) return
        markingCompleted.value = true
        try {
            // 先补报剩余时长，再发显式完成 —— 时长与完成是两条独立上报，不互相替代
            study.stopStudy()
            await study.reportIncremental(true)
            await study.reportCompleted()
            uni.showToast({ title: '已标记完成', icon: 'none' })
            await loadDetail()
        } catch (e) {
            console.warn('[chapter-view] mark completed failed:', e)
            uni.showToast({ title: '标记失败', icon: 'none' })
        } finally {
            markingCompleted.value = false
        }
    }

    function onImageClick(url : string) : void {
        if (url.length == 0) return
        uni.previewImage({
            urls: [url],
            current: url,
        })
    }

    function onFileClick(file : ChapterFile) : void {
        if (file.file_url.length == 0) {
            uni.showToast({ title: '文件地址无效', icon: 'none' })
            return
        }
        // 在新窗口/webview 中打开文件
        uni.showLoading({ title: '加载中...' })
        uni.downloadFile({
            url: file.file_url,
            success: (res) => {
                uni.hideLoading()
                if (res.statusCode == 200) {
                    uni.openDocument({
                        filePath: res.tempFilePath,
                        fail: () => {
                            uni.showToast({ title: '无法打开此文件', icon: 'none' })
                        }
                    })
                } else {
                    uni.showToast({ title: '文件下载失败', icon: 'none' })
                }
            },
            fail: () => {
                uni.hideLoading()
                uni.showToast({ title: '文件下载失败', icon: 'none' })
            }
        })
    }

    onHide(() : void => {
        study.stopStudy()
        study.reportIncremental(true)
    })

    onUnload(() : void => {
        study.stopStudy()
        study.reportIncremental(true)
    })
    function onPrevChapter() : void {
        if (detail.value == null) return
        const prevId = detail.value!.previous_chapter_id
        if (prevId == 0) return
        study.stopStudy()
        study.reportIncremental(true).then(() : void => {
            chapterId.value = prevId
            loadDetail()
        })
    }

    function onNextChapter() : void {
        if (detail.value == null) return
        const nextId = detail.value!.next_chapter_id
        if (nextId == 0) return
        study.stopStudy()
        study.reportIncremental(true).then(() : void => {
            chapterId.value = nextId
            loadDetail()
        })
    }

    onLoad((options : UTSJSONObject) => {
        const cid = options['course_id']
        const chid = options['chapter_id']
        if (cid != null) courseId.value = parseInt(`${cid}`)
        if (chid != null) chapterId.value = parseInt(`${chid}`)
        loadDetail()
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #ffffff;
        flex: 1;
        text-align: center;
        lines: 1;
        text-overflow: ellipsis;
    }

    .header-right {
        width: 60rpx;
        align-items: flex-end;
    }

    /* 收藏位字形（#1140）：与 course-detail.uvue 的 .favorite-icon 同值（40rpx / 白），
       未收藏态渲染 '♡' 而不是空串 —— 空串观感上等于「这页没有收藏功能」（#1087 的教训） */
    .favorite-icon {
        font-size: 40rpx;
        color: #ffffff;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 章节标题区 */
    .chapter-header {
        background-color: #ffffff;
        padding: 32rpx;
        flex-direction: column;
    }

    .chapter-title {
        font-size: 40rpx;
        font-weight: bold;
        color: #333333;
        line-height: 56rpx;
        margin-bottom: 16rpx;
    }

    .chapter-meta {
        flex-direction: row;
        align-items: center;
    }

    .status-tag {
        font-size: 22rpx;
        padding: 6rpx 16rpx;
        border-radius: 8rpx;
        margin-right: 16rpx;
    }

    .status-tag.completed {
        color: #4caf50;
        background-color: #e8f5e9;
    }

    .status-tag.studying {
        color: #ff9800;
        background-color: #fff3e0;
    }

    .chapter-duration {
        font-size: 24rpx;
        color: #999999;
    }

    /* 加载/空状态 */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .empty-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
        margin-bottom: 24rpx;
    }

    .empty-tip {
        align-items: center;
        padding: 80rpx 0;
    }

    .retry-btn {
        background-color: #2979ff;
        border-radius: 32rpx;
        padding: 16rpx 48rpx;
    }

    .retry-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    /* 标记完成（#1111）：与页面骨架同构的底部主操作，非 hint 文本 */
    .mark-done-wrap {
        padding: 32rpx;
    }

    .mark-done-btn {
        background-color: #2979ff;
        border-radius: 16rpx;
        align-items: center;
        justify-content: center;
        padding: 24rpx 0;
    }

    /* 提交中态：追加类覆盖，不改写上面的基类（变体一律追加覆盖） */
    .mark-done-btn--busy {
        background-color: #a0c4ff;
    }

    .mark-done-text {
        font-size: 30rpx;
        color: #ffffff;
    }
</style>