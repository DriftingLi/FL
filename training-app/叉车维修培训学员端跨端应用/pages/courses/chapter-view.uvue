<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">{{ detail != null ? detail!.title : '章节学习' }}</text>
            <view class="header-right"></view>
        </view>

        <!-- 加载中 -->
        <view v-if="loading" class="loading-wrap">
            <text class="loading-text">正在加载...</text>
        </view>

        <!-- 加载失败 -->
        <view v-else-if="detail == null || detail!.chapter_id == 0" class="empty-wrap">
            <text class="empty-text">章节内容加载失败</text>
            <view class="retry-btn" @click="loadDetail">
                <text class="retry-btn-text">重试</text>
            </view>
        </view>

        <!-- 章节内容 -->
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <!-- 章节标题区 -->
            <view class="chapter-header">
                <text class="chapter-title">{{ detail!.title }}</text>
                <view class="chapter-meta">
                    <text v-if="detail!.study_status == 'completed'" class="status-tag completed">已完成</text>
                    <text v-else class="status-tag studying">学习中</text>
                    <text class="chapter-duration">预计 {{ formatDuration(detail!.duration) }}</text>
                </view>
            </view>

            <!-- 图文内容（Markdown 渲染） -->
            <view v-if="detail!.content.length > 0" class="section md-section">
                <view v-for="(block, idx) in contentBlocks" :key="idx" class="md-block">
                    <!-- 标题 -->
                    <text v-if="block.type == 'heading'"
                        :class="['md-heading', 'md-h' + block.level]">{{ block.text }}</text>
                    <!-- 段落 -->
                    <text v-else-if="block.type == 'paragraph'" class="md-paragraph">{{ block.text }}</text>
                    <!-- 代码块 -->
                    <view v-else-if="block.type == 'code'" class="md-code-wrap">
                        <text class="md-code">{{ block.text }}</text>
                    </view>
                    <!-- 列表 -->
                    <view v-else-if="block.type == 'list'" class="md-list">
                        <view v-for="(item, li) in block.items" :key="li" class="md-list-item">
                            <text class="md-list-bullet">•</text>
                            <text class="md-list-text">{{ item }}</text>
                        </view>
                    </view>
                    <!-- 引用 -->
                    <view v-else-if="block.type == 'quote'" class="md-quote">
                        <text class="md-quote-text">{{ block.text }}</text>
                    </view>
                    <!-- 分隔线 -->
                    <view v-else-if="block.type == 'divider'" class="md-divider"></view>
                    <!-- 图片 -->
                    <image v-else-if="block.type == 'image'" class="md-image"
                        :src="block.text" mode="widthFix" @click="onImageClick(block.text)"></image>
                </view>
            </view>

            <!-- 附件列表 -->
            <view v-if="detail!.files.length > 0" class="section">
                <text class="section-title">附件资料</text>
                <view class="file-list">
                    <view v-for="(file, idx) in detail!.files" :key="idx" class="file-item"
                        @click="onFileClick(file)">
                        <view class="file-icon-wrap" :class="getFileIconClass(file.content_type)">
                            <text class="file-icon">{{ getFileIcon(file.content_type) }}</text>
                        </view>
                        <view class="file-info">
                            <text class="file-name">{{ file.file_name }}</text>
                            <text class="file-type">{{ getFileTypeName(file.content_type) }}</text>
                        </view>
                        <text class="file-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 无内容提示 -->
            <view v-if="detail!.content.length == 0 && detail!.files.length == 0" class="empty-tip">
                <text class="empty-text">该章节暂无内容</text>
            </view>

            <!-- 完成学习按钮 -->
            <!-- <view class="complete-bar">
                <view v-if="detail!.study_status != 'completed'" class="complete-btn" @click="onComplete">
                    <text class="complete-btn-text">完成本章学习</text>
                </view>
                <view v-else class="completed-tag">
                    <text class="completed-tag-text">✓ 本章已完成</text>
                </view>
            </view> -->

            <!-- 上/下章导航 -->
            <view class="chapter-nav">
                <view class="nav-item nav-prev" :class="{ disabled: detail!.previous_chapter_id == 0 }"
                    @click="onPrevChapter">
                    <text class="nav-arrow">‹</text>
                    <view class="nav-content">
                        <text class="nav-label">上一章节</text>
                        <text v-if="detail!.previous_chapter_id != 0" class="nav-title">{{ prevTitle }}</text>
                        <text v-else class="nav-title-muted">没有上一章节</text>
                    </view>
                </view>
                <view class="nav-item nav-next" :class="{ disabled: detail!.next_chapter_id == 0 }"
                    @click="onNextChapter">
                    <view class="nav-content nav-content-right">
                        <text class="nav-label">下一章节</text>
                        <text v-if="detail!.next_chapter_id != 0" class="nav-title">{{ nextTitle }}</text>
                        <text v-else class="nav-title-muted">没有下一章节</text>
                    </view>
                    <text class="nav-arrow">›</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { parseMarkdown } from '../../utils/markdown'
    import { getCourseDetailApi, getChapterDetailApi, updateCourseProgressApi } from '../../api/course'
    import type { ChapterDetail, ChapterFile, CourseDetail, MarkdownBlock } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const courseId = ref<number>(0)
    const chapterId = ref<number>(0)
    const detail = ref<ChapterDetail | null>(null)
    const loading = ref<boolean>(true)

    // 用于上下章标题显示
    const courseDetail = ref<CourseDetail | null>(null)
    const prevTitle = ref<string>('')
    const nextTitle = ref<string>('')

    // Markdown 解析后的内容块
    const contentBlocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => {
        if (detail.value == null) return [] as MarkdownBlock[]
        if (detail.value!.content.length == 0) return [] as MarkdownBlock[]
        return parseMarkdown(detail.value!.content)
    })

    function formatDuration(seconds : number) : string {
        if (seconds <= 0) return '未知'
        const minutes = Math.floor(seconds / 60)
        if (minutes < 60) return minutes + '分钟'
        const hours = Math.floor(minutes / 60)
        const mins = minutes % 60
        return hours + '小时' + (mins > 0 ? mins + '分' : '')
    }

    function getFileIcon(contentType : string) : string {
        if (contentType == 'video') return '🎬'
        if (contentType == 'document') return '📄'
        if (contentType == 'ppt') return '📊'
        if (contentType == 'image') return '🖼️'
        return '📎'
    }

    function getFileIconClass(contentType : string) : string {
        if (contentType == 'video') return 'file-icon-video'
        if (contentType == 'document') return 'file-icon-doc'
        if (contentType == 'ppt') return 'file-icon-ppt'
        if (contentType == 'image') return 'file-icon-image'
        return 'file-icon-default'
    }

    function getFileTypeName(contentType : string) : string {
        if (contentType == 'video') return '视频'
        if (contentType == 'document') return '文档'
        if (contentType == 'ppt') return 'PPT'
        if (contentType == 'image') return '图片'
        return '附件'
    }

    function updateNavTitles() {
        if (detail.value == null || courseDetail.value == null) {
            prevTitle.value = ''
            nextTitle.value = ''
            return
        }
        const chapters = courseDetail.value!.chapters
        const prevId = detail.value!.previous_chapter_id
        const nextId = detail.value!.next_chapter_id
        prevTitle.value = ''
        nextTitle.value = ''
        for (let i = 0; i < chapters.length; i++) {
            const ch = chapters[i]
            if (ch.chapter_id == prevId) prevTitle.value = ch.title
            if (ch.chapter_id == nextId) nextTitle.value = ch.title
        }
    }

    async function loadDetail() {
        if (courseId.value <= 0 || chapterId.value <= 0) return
        loading.value = true
        detail.value = null
        try {
            const data = await getChapterDetailApi(courseId.value, chapterId.value)
            detail.value = data
            // 加载课程详情以获取上下章标题
            if (courseDetail.value == null) {
                const cd = await getCourseDetailApi(courseId.value)
                courseDetail.value = cd
            }
            updateNavTitles()
        } catch (e) {
            console.error('[chapter-view] load failed:', e)
        } finally {
            loading.value = false
        }
    }

    function onBack() : void {
        uni.navigateBack()
    }

    function onImageClick(url : string) : void {
        if (url.length == 0) return
        uni.previewImage({
            urls: [url],
            current: url,
        })
    }

    function onFileClick(file : ChapterFile) : void {
        if (file.file_url.length == 0) {
            uni.showToast({ title: '文件地址无效', icon: 'none' })
            return
        }
        // 在新窗口/webview 中打开文件
        uni.showLoading({ title: '加载中...' })
        uni.downloadFile({
            url: file.file_url,
            success: (res) => {
                uni.hideLoading()
                if (res.statusCode == 200) {
                    uni.openDocument({
                        filePath: res.tempFilePath,
                        fail: () => {
                            uni.showToast({ title: '无法打开此文件', icon: 'none' })
                        }
                    })
                } else {
                    uni.showToast({ title: '文件下载失败', icon: 'none' })
                }
            },
            fail: () => {
                uni.hideLoading()
                uni.showToast({ title: '文件下载失败', icon: 'none' })
            }
        })
    }

    async function onComplete() : Promise<void> {
        if (detail.value == null) return
        const chapterIdVal = detail.value!.chapter_id
        try {
            await updateCourseProgressApi(courseId.value, chapterIdVal, detail.value!.duration)
            detail.value!.study_status = 'completed'
            uni.showToast({ title: '学习进度已保存', icon: 'success' })
        } catch (e) {
            console.error('[chapter-view] save progress failed:', e)
            uni.showToast({ title: '保存失败，请稍后重试', icon: 'none' })
        }
    }

    function onPrevChapter() : void {
        if (detail.value == null) return
        const prevId = detail.value!.previous_chapter_id
        if (prevId == 0) return
        chapterId.value = prevId
        loadDetail()
    }

    function onNextChapter() : void {
        if (detail.value == null) return
        const nextId = detail.value!.next_chapter_id
        if (nextId == 0) return
        chapterId.value = nextId
        loadDetail()
    }

    onLoad((options : UTSJSONObject) => {
        const cid = options['course_id']
        const chid = options['chapter_id']
        if (cid != null) courseId.value = parseInt(`${cid}`)
        if (chid != null) chapterId.value = parseInt(`${chid}`)
        loadDetail()
    })
</script>

<style>
