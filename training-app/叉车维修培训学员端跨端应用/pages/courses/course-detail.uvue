        font-size: 100rpx;
    }

    .cover-info {
        padding: 28rpx 32rpx;
        flex-direction: column;
    }

    .cover-title {
        font-size: 40rpx;
        font-weight: bold;
        color: #1a1a1a;
        line-height: 56rpx;
        margin-bottom: 16rpx;
    }

    .cover-tags {
        flex-direction: row;
        flex-wrap: wrap;
        margin-bottom: 16rpx;
    }

    .tag {
        font-size: 22rpx;
        padding: 6rpx 16rpx;
        border-radius: 8rpx;
        margin-right: 12rpx;
        margin-bottom: 8rpx;
    }

    .tag-level {
        color: #e6a23c;
        background-color: #fdf6ec;
    }

    .tag-specialty {
        color: #409eff;
        background-color: #ecf5ff;
    }

    .tag-cert {
        color: #67c23a;
        background-color: #f0f9eb;
    }

    .cover-desc {
        font-size: 26rpx;
        color: #666666;
        line-height: 42rpx;
    }

    /* ===== 学习进度 ===== */
    .progress-section {
        background-color: #ffffff;
        padding: 24rpx 32rpx;
        border-top: 1rpx solid #f5f5f5;
    }

    .progress-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12rpx;
    }

    .progress-label {
        font-size: 26rpx;
        color: #666666;
    }

    .progress-percent {
        font-size: 28rpx;
        font-weight: bold;
        color: #2979ff;
    }

    .progress-bar-wrap {
        height: 12rpx;
        background-color: #e8eaec;
        border-radius: 6rpx;
        overflow: hidden;
    }

    .progress-bar {
        height: 12rpx;
        background-color: #2979ff;
        border-radius: 6rpx;
    }

    .progress-detail {
        font-size: 22rpx;
        color: #999999;
        margin-top: 8rpx;
    }

    /* ===== 课程信息网格 ===== */
    .info-grid {
        background-color: #ffffff;
        margin-top: 16rpx;
        padding: 28rpx 32rpx;
        flex-direction: row;
        flex-wrap: wrap;
    }

    .info-item {
        width: 50%;
        flex-direction: column;
        margin-bottom: 24rpx;
    }

    .info-full {
        width: 100%;
    }

    .info-label {
        font-size: 22rpx;
        color: #999999;
        margin-bottom: 6rpx;
    }

    .info-value {
        font-size: 28rpx;
        color: #333333;
        font-weight: 500;
    }

    .info-sub {
        font-size: 22rpx;
        color: #999999;
        font-weight: normal;
    }

    .prereq-list {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .prereq-tag {
        font-size: 22rpx;
        color: #909399;
        background-color: #f5f7fa;
        padding: 6rpx 14rpx;
        border-radius: 6rpx;
        margin-right: 12rpx;
        margin-top: 6rpx;
    }

    /* ===== 通用 section ===== */
    .section {
        background-color: #ffffff;
        margin-top: 16rpx;
        padding: 28rpx 32rpx;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24rpx;
    }

    .section-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #1a1a1a;
    }

    .chapter-count {
        font-size: 24rpx;
        color: #999999;
    }

    /* ===== 章节列表 ===== */
    .chapter-list {
        flex-direction: column;
    }

    .chapter-item {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 0;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .chapter-item:last-child {
        border-bottom: none;
    }

    .chapter-item:active {
        background-color: #f5f7fa;
    }

    .chapter-item.chapter-current {
        background-color: #ecf5ff;
        margin: 0 -32rpx;
        padding: 24rpx 32rpx;
        border-radius: 12rpx;
    }

    .chapter-index {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: #e3f2fd;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .chapter-item.chapter-completed .chapter-index {
        background-color: #e8f5e9;
    }

    .chapter-index-text {
        font-size: 28rpx;
        font-weight: bold;
        color: #2979ff;
    }

    .chapter-check {
        font-size: 28rpx;
        font-weight: bold;
        color: #4caf50;
    }

    .chapter-info {
        flex: 1;
        flex-direction: column;
    }

    .chapter-title {
        font-size: 28rpx;
        color: #333333;
        margin-bottom: 6rpx;
        lines: 2;
        text-overflow: ellipsis;
    }

    .chapter-item.chapter-completed .chapter-title {
        color: #999999;
    }

    .chapter-duration {
        font-size: 22rpx;
        color: #999999;
    }

    .chapter-arrow {
        font-size: 40rpx;
        color: #cccccc;
        margin-left: 12rpx;
        flex-shrink: 0;
    }

    /* ===== 操作按钮 ===== */
    .action-bar {
        padding: 32rpx;
        padding-bottom: 60rpx;
    }

    .action-btn {
        background-color: #2979ff;
        border-radius: 48rpx;
        padding: 24rpx 0;
        align-items: center;
    }

    .action-btn:active {
        opacity: 0.85;
    }

    .action-btn-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #ffffff;
    }

    /* ===== 加载/空状态 ===== */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .empty-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
        margin-bottom: 24rpx;
    }

    .empty-tip {
        align-items: center;
        padding: 60rpx 0;
    }

    .retry-btn {
        background-color: #2979ff;
        border-radius: 32rpx;
        padding: 16rpx 48rpx;
    }

    .retry-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    /* ===== 收藏按钮 ===== */
    .favorite-icon {
        font-size: 40rpx;
    }
</style>
