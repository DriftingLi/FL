<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">课程详情</text>
            <view class="header-right" @click="toggleFavorite">
                <text class="favorite-icon">{{ isFavorited ? '❤️' : '' }}</text>
            </view>
        </view>

        <!-- 加载中 -->
        <view v-if="loading" class="loading-wrap">
            <text class="loading-text">正在加载...</text>
        </view>

        <!-- 课程内容 -->
        <scroll-view v-else-if="detail != null" class="content-scroll" scroll-y="true">
            <!-- 课程封面 -->
            <view class="cover-section">
                <view class="cover-bg" :style="{ backgroundColor: coverColor }">
                    <text class="cover-icon">{{ getCategoryIcon(detail!.category) }}</text>
                </view>
                <view class="cover-info">
                    <text class="cover-title">{{ detail!.title }}</text>
                    <view class="cover-tags">
                        <text v-if="detail!.level_name.length > 0" class="tag tag-level">{{ detail!.level_name }}</text>
                        <text v-if="detail!.specialty_name.length > 0" class="tag tag-specialty">{{ detail!.specialty_name }}</text>
                        <text v-if="detail!.certificate_name.length > 0" class="tag tag-cert">{{ detail!.certificate_name }}</text>
                    </view>
                    <text class="cover-desc">{{ detail!.description.length > 0 ? detail!.description : '暂无简介' }}</text>
                </view>
            </view>

            <!-- 学习进度 -->
            <view v-if="isEnrolled" class="progress-section">
                <view class="progress-header">
                    <text class="progress-label">学习进度</text>
                    <text class="progress-percent">{{ learningProgress }}%</text>
                </view>
                <view class="progress-bar-wrap">
                    <view class="progress-bar" :style="{ width: learningProgress + '%' }"></view>
                </view>
                <text class="progress-detail">已完成 {{ learningCompleted }}/{{ detail!.chapters.length }} 章</text>
            </view>

            <!-- 课程信息网格 -->
            <view class="info-grid">
                <view class="info-item">
                    <text class="info-label">理论学时</text>
                    <text class="info-value">{{ detail!.theory_hours > 0 ? detail!.theory_hours + ' 学时' : '-' }}</text>
                </view>
                <view class="info-item">
                    <text class="info-label">实操学时</text>
                    <text class="info-value">{{ detail!.practice_hours > 0 ? detail!.practice_hours + ' 学时' : '-' }}</text>
                </view>
                <view class="info-item">
                    <text class="info-label">章节数</text>
                    <text class="info-value">{{ detail!.chapters.length }}</text>
                </view>
                <view class="info-item">
                    <text class="info-label">课程时长</text>
                    <text class="info-value">{{ formatDuration(detail!.duration) }}</text>
                </view>
                <view v-if="detail!.certificate_name.length > 0" class="info-item info-full">
                    <text class="info-label">关联证书</text>
                    <text class="info-value">{{ detail!.certificate_name }}<text v-if="detail!.certificate_validity_days > 0" class="info-sub">（有效期 {{ detail!.certificate_validity_days }} 天）</text></text>
                </view>
                <view v-if="detail!.prerequisites.length > 0" class="info-item info-full">
                    <text class="info-label">前置课程</text>
                    <view class="prereq-list">
                        <text v-for="(pre, idx) in detail!.prerequisites" :key="idx" class="prereq-tag">{{ pre.name }}</text>
                    </view>
                </view>
            </view>

            <!-- 章节列表 -->
            <view class="section">
                <view class="section-header">
                    <text class="section-title">课程内容</text>
                    <text class="chapter-count">{{ detail!.chapters.length }} 个章节</text>
                </view>
                <view v-if="detail!.chapters.length == 0" class="empty-tip">
                    <text class="empty-text">暂无章节内容</text>
                </view>
                <view class="chapter-list">
                    <view v-for="(chapter, idx) in detail!.chapters" :key="idx" class="chapter-item"
                        :class="{ 'chapter-completed': isChapterCompleted(chapter.chapter_id), 'chapter-current': isCurrentChapter(chapter.chapter_id) }"
                        @click="onChapterClick(chapter.chapter_id)">
                        <view class="chapter-index">
                            <text v-if="isChapterCompleted(chapter.chapter_id)" class="chapter-check">✓</text>
                            <text v-else class="chapter-index-text">{{ idx + 1 }}</text>
                        </view>
                        <view class="chapter-info">
                            <text class="chapter-title">{{ chapter.title }}</text>
                            <text v-if="chapter.duration > 0" class="chapter-duration">{{ chapter.duration }} 分钟</text>
                        </view>
                        <text class="chapter-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 底部操作栏 -->
            <view class="action-bar">
                <view class="action-btn" @click="onStartLearn">
                    <text class="action-btn-text">{{ continueChapterId > 0 ? '继续学习' : '开始学习' }}</text>
                </view>
            </view>
        </scroll-view>

        <!-- 加载失败 -->
        <view v-else class="empty-wrap">
            <text class="empty-text">课程详情加载失败</text>
            <view class="retry-btn" @click="loadDetail">
                <text class="retry-btn-text">重试</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getCourseDetailApi } from '../../api/course'
    import { getStudentCourseDetailApi } from '../../api/student'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import type { CourseDetail, ChapterItem, StudentCourseChapterProgress } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const courseId = ref<number>(0)
    const detail = ref<CourseDetail | null>(null)
    const loading = ref<boolean>(true)
    const isFavorited = ref<boolean>(false)
    const favoriteId = ref<number>(0)

    // 学习状态
    const isEnrolled = ref<boolean>(false)
    const learningProgress = ref<number>(0)
    const learningCompleted = ref<number>(0)
    // 已完成章节 ID 列表（用数组模拟 Set）
    const completedIds = ref<number[]>([])
    // 继续学习的章节 ID
    const continueChapterId = ref<number>(0)

    async function loadFavoriteStatus() : Promise<void> {
        if (courseId.value <= 0) return
        try {
            const result = await checkFavoriteApi('course', courseId.value)
            isFavorited.value = result.favorited
            favoriteId.value = result.favorite_id
        } catch (e) {
            console.warn('[course-detail] checkFavorite failed:', e)
        }
    }

    async function toggleFavorite() : Promise<void> {
        try {
            if (isFavorited.value) {
                await removeFavoriteApi(favoriteId.value)
                isFavorited.value = false
                favoriteId.value = 0
                uni.showToast({ title: '已取消收藏', icon: 'none' })
            } else {
                const result = await addFavoriteApi('course', courseId.value)
                isFavorited.value = true
                favoriteId.value = result.favorite_id
                uni.showToast({ title: '收藏成功', icon: 'none' })
            }
        } catch (e) {
            console.error('[course-detail] toggleFavorite failed:', e)
            uni.showToast({ title: '操作失败', icon: 'none' })
        }
    }

    /** 检查章节是否已完成 */
    function isChapterCompleted(chapterId : number) : boolean {
        const ids = completedIds.value
        for (let i = 0; i < ids.length; i++) {
            if (ids[i] == chapterId) return true
        }
        return false
    }

    /** 检查是否为当前继续学习的章节 */
    function isCurrentChapter(chapterId : number) : boolean {
        return continueChapterId.value == chapterId && continueChapterId.value > 0
    }

    function getCategoryIcon(category : string) : string {
        if (category == 'theory' || category == 'CATEGORY_01') return ''
        if (category == 'safety' || category == 'CATEGORY_02') return '⚠️'
        if (category == 'practice' || category == 'CATEGORY_03') return ''
        if (category == 'advanced' || category == 'CATEGORY_04') return ''
        if (category == 'structure') return '️'
        if (category == 'hydraulic') return '⚙️'
        if (category == 'driving') return ''
        if (category == 'maintenance') return ''
        if (category == 'cargo') return ''
        if (category == 'troubleshooting') return ''
        return ''
    }

    function getCoverColor(category : string) : string {
        if (category == 'theory' || category == 'CATEGORY_01') return '#e3f2fd'
        if (category == 'safety' || category == 'CATEGORY_02') return '#fff3e0'
        if (category == 'practice' || category == 'CATEGORY_03') return '#e8f5e9'
        if (category == 'advanced' || category == 'CATEGORY_04') return '#f3e5f5'
        if (category == 'structure') return '#fce4ec'
        if (category == 'hydraulic') return '#e1f5fe'
        if (category == 'driving') return '#fff8e1'
        if (category == 'maintenance') return '#efebe9'
        if (category == 'cargo') return '#e0f2f1'
        if (category == 'troubleshooting') return '#fbe9e7'
        return '#f0f0f0'
    }

    const coverColor = ref<string>('#e3f2fd')

    function formatDuration(minutes : number) : string {
        if (minutes <= 0) return '-'
        if (minutes < 60) return minutes + '分钟'
        const hours = Math.floor(minutes / 60)
        const mins = minutes % 60
        return hours + '小时' + (mins > 0 ? mins + '分' : '')
    }

    /** 从章节列表中计算继续学习的章节 ID */
    function computeContinueChapterId(chapters : ChapterItem[]) : void {
        const ids = completedIds.value
        for (let i = 0; i < chapters.length; i++) {
            let found = false
            for (let j = 0; j < ids.length; j++) {
                if (ids[j] == chapters[i].chapter_id) {
                    found = true
                    break
                }
            }
            if (!found) {
                continueChapterId.value = chapters[i].chapter_id
                return
            }
        }
        // 全部完成，指向第一章
        if (chapters.length > 0) {
            continueChapterId.value = chapters[0].chapter_id
        }
    }

    async function loadLearningState() : Promise<void> {
        if (courseId.value <= 0 || detail.value == null) return
        try {
            const studentDetail = await getStudentCourseDetailApi(courseId.value)
            // 提取已完成章节 ID
            const completed : number[] = []
            const chapters = studentDetail.chapters
            for (let i = 0; i < chapters.length; i++) {
                if (chapters[i].completed) {
                    completed.push(chapters[i].chapter_id)
                }
            }
            completedIds.value = completed

            // 同步进度
            isEnrolled.value = true
            learningProgress.value = studentDetail.progress
            learningCompleted.value = studentDetail.completed_chapters

            // 计算继续学习章节
            if (detail.value != null) {
                computeContinueChapterId(detail.value!.chapters)
            }
        } catch (e) {
            console.warn('[course-detail] loadLearningState failed:', e)
        }
    }

    async function loadDetail() : Promise<void> {
        if (courseId.value <= 0) return
        loading.value = true
        detail.value = null
        try {
            const data = await getCourseDetailApi(courseId.value)
            detail.value = data
            coverColor.value = getCoverColor(data.category)
            // 使用课程详情自带的进度
            if (data.is_enrolled) {
                isEnrolled.value = true
                learningProgress.value = data.progress_pct
                learningCompleted.value = data.completed_chapters
            }
            // 并行加载学习状态（获取每章完成情况）
            loadLearningState()
        } catch (e) {
            console.error('[course-detail] load failed:', e)
            uni.showToast({ title: '加载课程详情失败', icon: 'none' })
        } finally {
            loading.value = false
        }
        loadFavoriteStatus()
    }

    function onBack() : void {
        goBack()
    }

    function onChapterClick(chapterId : number) : void {
        uni.navigateTo({
            url: '/pages/courses/chapter-view?course_id=' + courseId.value + '&chapter_id=' + chapterId
        })
    }

    function onStartLearn() : void {
        if (detail.value == null) return
        if (detail.value!.chapters.length == 0) {
            uni.showToast({ title: '暂无章节内容', icon: 'none' })
            return
        }
        // 优先跳转到继续学习的章节
        let targetId = continueChapterId.value
        if (targetId <= 0) {
            targetId = detail.value!.chapters[0].chapter_id
        }
        uni.navigateTo({
            url: '/pages/courses/chapter-view?course_id=' + courseId.value + '&chapter_id=' + targetId
        })
    }

    onLoad((options : UTSJSONObject) => {
        const id = options['id']
        if (id != null) {
            courseId.value = parseInt(`${id}`)
            loadDetail()
        } else {
            loading.value = false
        }
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
    }

    .header-right {
        width: 60rpx;
        align-items: flex-end;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* ===== 封面区 ===== */
    .cover-section {
        background-color: #ffffff;
        flex-direction: column;
    }

    .cover-bg {
        height: 280rpx;
        align-items: center;
        justify-content: center;
    }

