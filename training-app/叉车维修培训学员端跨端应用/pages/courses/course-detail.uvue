<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">课程详情</text>
            <view class="header-right" @click="toggleFavorite">
                <text class="favorite-icon">{{ isFavorited ? '♥' : '♡' }}</text>
            </view>
        </view>

        <!-- 加载中 -->
        <view v-if="loading" class="loading-wrap">
            <text class="loading-text">正在加载...</text>
        </view>

        <!-- 课程内容 -->
        <scroll-view v-else-if="detail != null" class="content-scroll" scroll-y="true">
            <!-- 课程封面 -->
            <CourseCoverSection :title="detail!.title" :level-name="detail!.level_name"
                :specialty-name="detail!.specialty_name" :certificate-name="detail!.certificate_name"
                :description="detail!.description" :specialty-icon="specialtyIcon" :cover-color="coverColor" />

            <!-- 学习进度 -->
            <CourseProgressSection v-if="isEnrolled" :progress="learningProgress" :completed="learningCompleted"
                :total-chapters="detail!.chapters.length" />

            <!-- 课程信息网格 -->
            <CourseInfoGrid :theory-hours="detail!.theory_hours" :practice-hours="detail!.practice_hours"
                :chapter-count="detail!.chapters.length" :duration-text="durationText"
                :certificate-name="detail!.certificate_name"
                :certificate-validity-days="detail!.certificate_validity_days"
                :prerequisites="detail!.prerequisites" />

            <!-- 章节列表 -->
            <CourseChapterList :chapters="detail!.chapters" :completed-ids="completedIds"
                :continue-chapter-id="continueChapterId" @chapter-click="onChapterClick" />

            <!-- 底部操作栏 -->
            <view class="action-bar">
                <view class="action-btn" @click="onStartLearn">
                    <text class="action-btn-text">{{ continueChapterId > 0 ? '继续学习' : '开始学习' }}</text>
                </view>
            </view>
        </scroll-view>

        <!-- 加载失败 -->
        <view v-else class="empty-wrap">
            <text class="empty-text">课程详情加载失败</text>
            <view class="retry-btn" @click="loadDetail">
                <text class="retry-btn-text">重试</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getCourseDetailApi } from '../../api/course'
    import { getStudentCourseDetailApi } from '../../api/student'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import CourseCoverSection from './components/course-cover-section.uvue'
    import CourseProgressSection from './components/course-progress-section.uvue'
    import CourseInfoGrid from './components/course-info-grid.uvue'
    import CourseChapterList from './components/course-chapter-list.uvue'
    import type { CourseDetail, ChapterItem, StudentCourseChapterProgress } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const courseId = ref<number>(0)
    const detail = ref<CourseDetail | null>(null)
    const loading = ref<boolean>(true)
    const isFavorited = ref<boolean>(false)
    const favoriteId = ref<number>(0)

    // 学习状态
    const isEnrolled = ref<boolean>(false)
    const learningProgress = ref<number>(0)
    const learningCompleted = ref<number>(0)
    // 已完成章节 ID 列表（用数组模拟 Set）
    const completedIds = ref<number[]>([])
    // 继续学习的章节 ID
    const continueChapterId = ref<number>(0)

    async function loadFavoriteStatus() : Promise<void> {
        if (courseId.value <= 0) return
        try {
            const result = await checkFavoriteApi('course', courseId.value)
            isFavorited.value = result.favorited
            favoriteId.value = result.favorite_id
        } catch (e) {
            console.warn('[course-detail] checkFavorite failed:', e)
        }
    }

    async function toggleFavorite() : Promise<void> {
        try {
            if (isFavorited.value) {
                await removeFavoriteApi(favoriteId.value)
                isFavorited.value = false
                favoriteId.value = 0
                uni.showToast({ title: '已取消收藏', icon: 'none' })
            } else {
                const result = await addFavoriteApi('course', courseId.value)
                isFavorited.value = true
                favoriteId.value = result.favorite_id
                uni.showToast({ title: '收藏成功', icon: 'none' })
            }
        } catch (e) {
            console.error('[course-detail] toggleFavorite failed:', e)
            uni.showToast({ title: '操作失败', icon: 'none' })
        }
    }

    /**
     * 专业方向 → 封面大图标。
     * @1087 旧实现吃 detail.category（后端已退役 ⇒ 恒为 '' ⇒ 永远走默认分支，图标恒为同一枚）。
     * 现按真实字段 specialty_id 映射，与 /api/catalog/tree 的 1=操作 / 2=维修 / 3=安全 / 4=电池 对齐。
     * 字形必须是真字形（非空串、非孤立 U+FE0F），由 utils/coursesContract.test.js 落锁。
     */
    function getSpecialtyIcon(specialtyId : number) : string {
        if (specialtyId == 1) return '🚜'
        if (specialtyId == 2) return '🔧'
        if (specialtyId == 3) return '⚠️'
        if (specialtyId == 4) return '🔋'
        return '📚'
    }

    /**
     * 专业方向 → 封面底色。
     * @1087 与 getSpecialtyIcon 同源（同一字段派生的两个展示面），一起从 category 迁到 specialty_id。
     */
    function getSpecialtyCoverColor(specialtyId : number) : string {
        if (specialtyId == 1) return '#e3f2fd'
        if (specialtyId == 2) return '#e8f5e9'
        if (specialtyId == 3) return '#fff3e0'
        if (specialtyId == 4) return '#f3e5f5'
        return '#f0f0f0'
    }

    function formatDuration(minutes : number) : string {
        if (minutes <= 0) return '-'
        if (minutes < 60) return minutes + '分钟'
        const hours = Math.floor(minutes / 60)
        const mins = minutes % 60
        return hours + '小时' + (mins > 0 ? mins + '分' : '')
    }

    // 封面图标/底色与课程时长文案由 detail 派生。原来 coverColor 是 ref、在 loadDetail 里赋值 ——
    // 同一事实两处持有属可派生状态；改 computed 后取值对同一 detail 完全一致，且去掉一处失效风险。
    const coverColor = computed<string>(() : string => {
        if (detail.value == null) return '#e3f2fd'
        return getSpecialtyCoverColor(detail.value!.specialty_id)
    })

    const specialtyIcon = computed<string>(() : string => {
        if (detail.value == null) return '📚'
        return getSpecialtyIcon(detail.value!.specialty_id)
    })

    const durationText = computed<string>(() : string => {
        if (detail.value == null) return '-'
        return formatDuration(detail.value!.duration)
    })

    /** 从章节列表中计算继续学习的章节 ID */
    function computeContinueChapterId(chapters : ChapterItem[]) : void {
        const ids = completedIds.value
        for (let i = 0; i < chapters.length; i++) {
            let found = false
            for (let j = 0; j < ids.length; j++) {
                if (ids[j] == chapters[i].chapter_id) {
                    found = true
                    break
                }
            }
            if (!found) {
                continueChapterId.value = chapters[i].chapter_id
                return
            }
        }
        // 全部完成，指向第一章
        if (chapters.length > 0) {
            continueChapterId.value = chapters[0].chapter_id
        }
    }

    async function loadLearningState() : Promise<void> {
        if (courseId.value <= 0 || detail.value == null) return
        try {
            const studentDetail = await getStudentCourseDetailApi(courseId.value)
            // 提取已完成章节 ID
            const completed : number[] = []
            const chapters = studentDetail.chapters
            for (let i = 0; i < chapters.length; i++) {
                if (chapters[i].completed) {
                    completed.push(chapters[i].chapter_id)
                }
            }
            completedIds.value = completed

            // 同步进度
            isEnrolled.value = true
            learningProgress.value = studentDetail.progress
            learningCompleted.value = studentDetail.completed_chapters

            // 计算继续学习章节
            if (detail.value != null) {
                computeContinueChapterId(detail.value!.chapters)
            }
        } catch (e) {
            console.warn('[course-detail] loadLearningState failed:', e)
        }
    }

    async function loadDetail() : Promise<void> {
        if (courseId.value <= 0) return
        loading.value = true
        detail.value = null
        try {
            const data = await getCourseDetailApi(courseId.value)
            detail.value = data
            // 使用课程详情自带的进度
            if (data.is_enrolled) {
                isEnrolled.value = true
                learningProgress.value = data.progress_pct
                learningCompleted.value = data.completed_chapters
            }
            // 并行加载学习状态（获取每章完成情况）
            loadLearningState()
        } catch (e) {
            console.error('[course-detail] load failed:', e)
            uni.showToast({ title: '加载课程详情失败', icon: 'none' })
        } finally {
            loading.value = false
        }
        loadFavoriteStatus()
    }

    function onBack() : void {
        goBack()
    }

    function onChapterClick(chapterId : number) : void {
        uni.navigateTo({
            url: '/pages/courses/chapter-view?course_id=' + courseId.value + '&chapter_id=' + chapterId
        })
    }

    function onStartLearn() : void {
        if (detail.value == null) return
        if (detail.value!.chapters.length == 0) {
            uni.showToast({ title: '暂无章节内容', icon: 'none' })
            return
        }
        // 优先跳转到继续学习的章节
        let targetId = continueChapterId.value
        if (targetId <= 0) {
            targetId = detail.value!.chapters[0].chapter_id
        }
        uni.navigateTo({
            url: '/pages/courses/chapter-view?course_id=' + courseId.value + '&chapter_id=' + targetId
        })
    }

    onLoad((options : UTSJSONObject) => {
        const id = options['id']
        if (id != null) {
            courseId.value = parseInt(`${id}`)
        }
    })

    /**
     * 取数统一放 onShow（#1126）：从章节页 `navigateBack` 返回时，本页实例仍然存活、
     * `onLoad` 不再触发 ⇒ 只挂 onLoad 会一直显示进入时的陈旧进度（真机实测：标记完成
     * 后端已是 14.29%，返回后界面仍 0%）。
     *
     * onShow 在**首次进入时也会触发**（onLoad → onShow 相邻），故取数**只放这里**、
     * onLoad 仅记 courseId，避免两个钩子各取一次造成首个请求翻倍（单一取数入口）。
     */
    onShow(() : void => {
        if (courseId.value > 0) {
            loadDetail()
        } else {
            loading.value = false
        }
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
    }

    .header-right {
        width: 60rpx;
        align-items: flex-end;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* ===== 操作按钮 ===== */
    .action-bar {
        padding: 32rpx;
        padding-bottom: 60rpx;
    }

    .action-btn {
        background-color: #2979ff;
        border-radius: 48rpx;
        padding: 24rpx 0;
        align-items: center;
    }

    .action-btn:active {
        opacity: 0.85;
    }

    .action-btn-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #ffffff;
    }

    /* ===== 加载/空状态 ===== */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .empty-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
        margin-bottom: 24rpx;
    }

    .empty-tip {
        align-items: center;
        padding: 60rpx 0;
    }

    .retry-btn {
        background-color: #2979ff;
        border-radius: 32rpx;
        padding: 16rpx 48rpx;
    }

    .retry-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    /* ===== 收藏按钮 ===== */
    /* 两态都渲染字形（♥ 已收藏 / ♡ 未收藏），靠**实心与空心**区分选中态 ——
       与论坛 stat-like-icon（♥/♡ 同色）同一套先例。此前未收藏态渲染空串，
       点击区虽在、却没有任何可点的视觉提示，观感等同「没有收藏功能」。 */
    .favorite-icon {
        font-size: 40rpx;
        color: #ffffff;
    }
</style>
