<template>
    <!-- 章节正文 Markdown 渲染 —— T08 手术自 pages/courses/chapter-view.uvue 逐段搬出（parent #646 / ADR-0007）。
         渲染分支（heading/paragraph/code/list/quote/divider/image/table）与「表格行归零块间距」的口径
         （ADR-0046）逐字未改；唯一刻意项 = 图片点击改为向页面 emit，previewImage 仍留在页面壳层
         （照 dashboard-news-section / practice-module-list「组件 emit + 页面处理」先例）。 -->
    <view class="section md-section">
        <view v-for="(block, idx) in blocks" :key="idx" class="md-block">
            <!-- 标题 -->
            <text v-if="block.type == 'heading'"
                :class="['md-heading', 'md-h' + block.level]">{{ block.text }}</text>
            <!-- 段落 -->
            <text v-else-if="block.type == 'paragraph'" class="md-paragraph">{{ block.text }}</text>
            <!-- 代码块 -->
            <view v-else-if="block.type == 'code'" class="md-code-wrap">
                <text class="md-code">{{ block.text }}</text>
            </view>
            <!-- 列表 -->
            <view v-else-if="block.type == 'list'" class="md-list">
                <view v-for="(item, li) in block.items" :key="li" class="md-list-item">
                    <text class="md-list-bullet">•</text>
                    <text class="md-list-text">{{ item }}</text>
                </view>
            </view>
            <!-- 引用 -->
            <view v-else-if="block.type == 'quote'" class="md-quote">
                <text class="md-quote-text">{{ block.text }}</text>
            </view>
            <!-- 分隔线 -->
            <view v-else-if="block.type == 'divider'" class="md-divider"></view>
            <!-- 图片 -->
            <image v-else-if="block.type == 'image'" class="md-image" :src="block.text" mode="widthFix"
                @click="onImageTap(block.text)"></image>
            <!-- 表格（ADR-0046：章节正文渲染成表格；解析器按行出块，表头行 level=1） -->
            <view v-else-if="block.type == 'table'" class="md-table-row">
                <view v-for="(cell, ci) in block.items" :key="ci"
                    :class="{ 'md-table-cell': true, 'md-table-cell-first': ci == 0, 'md-table-cell-head': block.level == 1 }">
                    <text :class="{ 'md-table-cell-text': true, 'md-table-cell-text-head': block.level == 1 }">{{ cell }}</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import type { MarkdownBlock } from '../../../types/index'

    const props = withDefaults(defineProps<{
        blocks? : MarkdownBlock[]
    }>(), {
        blocks: () => [] as MarkdownBlock[]
    })

    const emit = defineEmits(['imageClick'])

    function onImageTap(url : string) : void {
        emit('imageClick', url)
    }
</script>

<style>
    .section {
        background-color: #ffffff;
        margin-top: 16rpx;
        padding: 32rpx;
    }

    /* ===== Markdown 渲染样式 ===== */
    .md-section {
        padding: 32rpx;
    }

    .md-block {
        margin-bottom: 24rpx;
    }

    .md-block:last-child {
        margin-bottom: 0;
    }

    /* 标题 */
    .md-heading {
        font-weight: bold;
        color: #1a1a1a;
        margin-top: 16rpx;
        margin-bottom: 16rpx;
    }

    .md-h1 {
        font-size: 40rpx;
        padding-bottom: 16rpx;
        border-bottom: 1rpx solid #eeeeee;
    }

    .md-h2 {
        font-size: 36rpx;
        padding-bottom: 12rpx;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .md-h3 {
        font-size: 32rpx;
    }

    .md-h4 {
        font-size: 30rpx;
        color: #333333;
    }

    .md-h5 {
        font-size: 28rpx;
        color: #333333;
    }

    .md-h6 {
        font-size: 26rpx;
        color: #666666;
    }

    /* 段落 */
    .md-paragraph {
        font-size: 30rpx;
        color: #333333;
        line-height: 52rpx;
    }

    /* 代码块 */
    .md-code-wrap {
        background-color: #f6f8fa;
        border-left: 6rpx solid #2979ff;
        border-radius: 8rpx;
        padding: 24rpx;
        margin: 16rpx 0;
    }

    .md-code {
        font-size: 26rpx;
        color: #d63384;
        line-height: 44rpx;
        font-family: monospace;
    }

    /* 列表 */
    .md-list {
        flex-direction: column;
        margin: 12rpx 0;
    }

    .md-list-item {
        flex-direction: row;
        align-items: flex-start;
        margin-bottom: 12rpx;
    }

    .md-list-bullet {
        font-size: 30rpx;
        color: #2979ff;
        margin-right: 16rpx;
        line-height: 52rpx;
    }

    .md-list-text {
        flex: 1;
        font-size: 30rpx;
        color: #333333;
        line-height: 52rpx;
    }

    /* 引用 */
    .md-quote {
        background-color: #f0f7ff;
        border-left: 6rpx solid #2979ff;
        border-radius: 8rpx;
        padding: 24rpx;
        margin: 16rpx 0;
    }

    .md-quote-text {
        font-size: 28rpx;
        color: #555555;
        line-height: 48rpx;
    }

    /* 分隔线 */
    .md-divider {
        height: 1rpx;
        background-color: #e0e0e0;
        margin: 24rpx 0;
    }

    /* 图片 */
    .md-image {
        width: 100%;
        border-radius: 12rpx;
        margin: 16rpx 0;
    }

    /* 表格（ADR-0046：章节正文的表格渲染；uvue 无 grid，逐行 flex + 等宽单元格；
       解析器按行出块，同一张表的多行共用这一套样式、margin 归零连成一片） */
    .md-table-row {
        flex-direction: row;
        margin-bottom: 0;
    }

    .md-table-cell {
        flex: 1;
        padding: 16rpx 20rpx;
        border-right-width: 1rpx;
        border-right-color: #e0e0e0;
        border-bottom-width: 1rpx;
        border-bottom-color: #e0e0e0;
    }

    .md-table-cell-first {
        border-left-width: 1rpx;
        border-left-color: #e0e0e0;
    }

    .md-table-cell-head {
        border-top-width: 1rpx;
        border-top-color: #e0e0e0;
        background-color: #f6f8fa;
    }

    .md-table-cell-text {
        font-size: 26rpx;
        color: #333333;
        line-height: 40rpx;
    }

    .md-table-cell-text-head {
        font-weight: bold;
        color: #1a1a1a;
    }
</style>
