<template>
    <!-- 章节正文外壳（T08 手术自 pages/courses/chapter-view.uvue 搬出，parent #646 / 移动端 ADR-0007）。
         自 #2353 起**只留外壳**：块怎么排一律交给四面共用的 `components/markdown/markdown-blocks.uvue`
         （一套阅读刻度只有一处定义）。本文件保留三件不许变的东西：
         ① 对外接口仍是 `:blocks` + `@image-click`（`utils/coursesContract.test.js` 的 WIRING 行钉着，改名即红）；
         ② 容器样式仍是 `.section` / `.md-section`（白底 + 上下留白 + 32rpx 内边距，页面视觉靠它）；
         ③ 图片预览仍由页面壳层处理 —— 本层只把 `imageClick` 原样转上去。
         章节面传全集八位能力位：章节子集声明了 heading/paragraph/code/list/quote/divider/image/table。 -->
    <view class="section md-section">
        <MarkdownBlocks :blocks="blocks" :caps="CHAPTER_CAPS" @image-click="onImageTap" />
    </view>
</template>

<script setup lang="uts">
    import type { MarkdownBlock } from '../../../types/index'
    import MarkdownBlocks from '../../../components/markdown/markdown-blocks.uvue'

    /** 章节面的能力位：章节子集（`utils/markdown.uts` 的缺省档）声明的全部块类型 */
    const CHAPTER_CAPS : string[] = [
        'heading', 'paragraph', 'code', 'list', 'quote', 'divider', 'image', 'table'
    ]

    const props = withDefaults(defineProps<{
        blocks? : MarkdownBlock[]
    }>(), {
        blocks: () => [] as MarkdownBlock[]
    })

    const emit = defineEmits(['imageClick'])

    function onImageTap(url : string) : void {
        emit('imageClick', url)
    }
</script>

<style lang="scss">
    /* 只留容器样式：正文块的一切字号 / 行高 / 间距都由 MarkdownBlocks 的 $md-* 刻度提供 */
    .section {
        background-color: #ffffff;
        margin-top: 16rpx;
        padding: 32rpx;
    }

    .md-section {
        padding: 32rpx;
    }
</style>
