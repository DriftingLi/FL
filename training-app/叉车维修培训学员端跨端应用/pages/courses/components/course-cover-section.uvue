<template>
    <!-- 课程标题卡（#2518 C 方案）：封面区吸收进标题卡 —— 原 280rpx 大图块退成 64rpx 徽标，
         标题 / 标签 / 简介留在卡内；进度与信息摘要由同级组件接在下面，视觉上同属一张卡。
         类名 cover-section 与 coverColor / specialtyIcon 两个 prop 由 utils/coursesContract.test.js 落锁。 -->
    <view class="cover-section">
        <view class="cover-head">
            <view class="cover-badge" :style="{ backgroundColor: coverColor }">
                <text class="cover-icon">{{ specialtyIcon }}</text>
            </view>
            <text class="cover-title">{{ title }}</text>
        </view>
        <view v-if="levelName.length > 0 || specialtyName.length > 0 || certificateName.length > 0" class="cover-tags">
            <text v-if="levelName.length > 0" class="tag tag-level">{{ levelName }}</text>
            <text v-if="specialtyName.length > 0" class="tag tag-specialty">{{ specialtyName }}</text>
            <text v-if="certificateName.length > 0" class="tag tag-cert">{{ certificateName }}</text>
        </view>
        <text v-if="description.length > 0" class="cover-desc">{{ description }}</text>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        title? : string
        levelName? : string
        specialtyName? : string
        certificateName? : string
        description? : string
        specialtyIcon? : string
        coverColor? : string
    }>(), {
        title: '',
        levelName: '',
        specialtyName: '',
        certificateName: '',
        description: '',
        specialtyIcon: '',
        coverColor: '#e3f2fd'
    })
</script>

