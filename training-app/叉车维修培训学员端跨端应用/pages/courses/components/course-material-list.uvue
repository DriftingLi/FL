<template>
    <!-- 课程资料列表（#2518 C 方案「资料」Tab）—— 数据源 GET /api/materials?course_id=，
         装载协议走 composables/usePagedList（ADR-0027），本组件不持页码游标。
         下载动作收在 api 层（downloadAndOpenMaterialApi），组件只做展示与点击。 -->
    <view class="material-panel">
        <view v-if="items.length == 0 && !loading && !failed" class="empty-tip">
            <text class="empty-icon">📚</text>
            <text class="empty-text">暂无学习资料</text>
        </view>
        <view v-if="items.length == 0 && !loading && failed" class="empty-tip">
            <text class="empty-icon">📡</text>
            <text class="empty-text">资料加载失败</text>
            <view class="empty-btn" @click="onRetry">
                <text class="empty-btn-text">重试</text>
            </view>
        </view>
        <view class="material-list">
            <view v-for="(item, idx) in items" :key="idx" class="material-item">
                <view class="material-icon-box">
                    <text class="material-icon">{{ fileIcon(item) }}</text>
                </view>
                <view class="material-info">
                    <text class="material-title">{{ item.file_name }}</text>
                    <text v-if="item.chapter_title.length > 0" class="material-meta">{{ item.chapter_title }}</text>
                    <text class="material-size">{{ fileSizeText(item.file_size) }}</text>
                </view>
                <view class="material-action" :class="{ 'material-action--busy': downloadingId == item.file_id }"
                    @click="onDownload(item)">
                    <text class="material-action-text">{{ downloadingId == item.file_id ? '下载中' : '下载' }}</text>
                </view>
            </view>
        </view>
        <view v-if="loading" class="loading-more">
            <text class="loading-text">加载中...</text>
        </view>
        <view v-if="!loading && items.length > 0 && hasMore" class="load-more-btn" @click="onLoadMore">
            <text class="load-more-text">加载更多</text>
        </view>
        <view v-if="!loading && items.length > 0 && !hasMore" class="loading-more">
            <text class="loading-text">没有更多了</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, onMounted } from 'vue'
    import { getMaterialsApi, downloadAndOpenMaterialApi } from '../../../api/material'
    import { usePagedList } from '../../../composables/usePagedList'
    import type { PagedBatch } from '../../../composables/usePagedList'
    import type { MaterialItem } from '../../../types/index'

    const props = withDefaults(defineProps<{
        courseId? : number
    }>(), {
        courseId: 0
    })

    /** 每页条数留在本模块闭包里（ADR-0027 ②：模块只递页码） */
    const MATERIAL_PAGE_SIZE = 20

    /** 正在下载的资料 ID（0 = 无） */
    const downloadingId = ref<number>(0)

    /** 取第 page 页（页码从 1 起，由 usePagedList 递进来）；终止判据取 api 层信封归一的 hasMore */
    async function fetchMaterialPage(page : number) : Promise<PagedBatch<MaterialItem>> {
        const result = await getMaterialsApi(props.courseId, page, MATERIAL_PAGE_SIZE)
        return {
            items: result.items,
            hasMore: result.hasMore,
        } as PagedBatch<MaterialItem>
    }

    // 传箭头包一层而非裸具名引用：UTS 生成 Kotlin 时会把裸引用读成「调用」（先例 useTopicFeed）
    const paged = usePagedList<MaterialItem>((page : number) : Promise<PagedBatch<MaterialItem>> => fetchMaterialPage(page))
    const items = paged.items
    const loading = paged.loading
    const failed = paged.failed
    const hasMore = paged.hasMore

    function onLoadMore() : void {
        paged.onLoadMore()
    }

    function onRetry() : void {
        paged.loadFirst()
    }

    /** 文件类型图标（按 content_type 关键字判定；与 pages/resources/materials.uvue 同一套字形） */
    function fileIcon(item : MaterialItem) : string {
        const type = item.content_type
        if (type.indexOf('pdf') >= 0) return '📕'
        if (type.indexOf('word') >= 0 || type.indexOf('document') >= 0) return '📘'
        if (type.indexOf('excel') >= 0 || type.indexOf('sheet') >= 0) return '📗'
        if (type.indexOf('presentation') >= 0 || type.indexOf('powerpoint') >= 0) return '📙'
        if (type.indexOf('image') >= 0) return '🖼'
        if (type.indexOf('video') >= 0) return '🎬'
        return '📄'
    }

    /** 字节数 → 人类可读体积（B / KB / MB） */
    function fileSizeText(size : number) : string {
        if (size <= 0) return ''
        if (size < 1024) return size.toString() + ' B'
        if (size < 1024 * 1024) return (size / 1024).toFixed(1) + ' KB'
        return (size / 1024 / 1024).toFixed(1) + ' MB'
    }

    async function onDownload(item : MaterialItem) : Promise<void> {
        if (downloadingId.value > 0) return
        if (item.file_url.length == 0) {
            uni.showToast({ title: '资料地址无效', icon: 'none' })
            return
        }
        downloadingId.value = item.file_id
        uni.showLoading({ title: '下载中...' })
        const reason = await downloadAndOpenMaterialApi(item.file_id)
        uni.hideLoading()
        downloadingId.value = 0
        if (reason.length > 0) {
            uni.showToast({ title: reason, icon: 'none' })
        }
    }

    // 父组件只在切到「资料」Tab 时才挂载本组件 ⇒ 挂载即首屏
    onMounted(() => {
        paged.loadFirst()
    })
</script>

<style lang="scss">
    .material-panel {
        background-color: #ffffff;
        flex-direction: column;
    }

    .material-list {
        padding: 8rpx 24rpx 0;
        flex-direction: column;
    }

    .material-item {
        background-color: #f7f8fa;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        flex-direction: row;
        align-items: center;
    }

    .material-icon-box {
        width: 80rpx;
        height: 80rpx;
        border-radius: 16rpx;
        background-color: #eef4ff;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .material-icon {
        font-size: 40rpx;
    }

    .material-info {
        flex: 1;
        flex-direction: column;
    }

    .material-title {
        font-size: 28rpx;
        font-weight: 500;
        color: #333333;
        lines: 2;
        text-overflow: ellipsis;
    }

    .material-meta {
        font-size: 22rpx;
        color: #999999;
        margin-top: 6rpx;
    }

    .material-size {
        font-size: 22rpx;
        color: #bbbbbb;
        margin-top: 4rpx;
    }

    .material-action {
        border-radius: 28rpx;
        padding: 10rpx 28rpx;
        margin-left: 16rpx;
        background-color: $primary-color;
        flex-shrink: 0;
    }

    .material-action--busy {
        background-color: #a8c4ff;
    }

    .material-action-text {
        font-size: 24rpx;
        color: #ffffff;
    }

    .empty-tip {
        align-items: center;
        padding: 120rpx 0;
        flex-direction: column;
    }

    .empty-icon {
        font-size: 96rpx;
        margin-bottom: 24rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
        margin-bottom: 32rpx;
    }

    .empty-btn {
        background-color: $primary-color;
        padding: 16rpx 48rpx;
        border-radius: 32rpx;
    }

    .empty-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    .load-more-btn {
        align-items: center;
        padding: 24rpx 0;
    }

    .load-more-text {
        font-size: 26rpx;
        color: $primary-color;
    }
</style>
