<template>
    <!-- 课程章节列表 —— T08 手术自 pages/courses/course-detail.uvue 逐段搬出（parent #646 / ADR-0007）。
         类名与结构逐字不变；原来直读 detail!.chapters / completedIds / continueChapterId，
         改为扁平 props 下发；已完成/当前章判定（isChapterCompleted / isCurrentChapter）随本段搬入，
         章节点击改为 emit 回页面壳层（跳转是页面行为）。 -->
    <view class="section">
        <view class="section-header">
            <text class="section-title">课程内容</text>
            <text class="chapter-count">{{ chapters.length }} 个章节</text>
        </view>
        <view v-if="chapters.length == 0" class="empty-tip">
            <text class="empty-text">暂无章节内容</text>
        </view>
        <view class="chapter-list">
            <view v-for="(chapter, idx) in chapters" :key="idx" class="chapter-item"
                :class="{ 'chapter-completed': isChapterCompleted(chapter.chapter_id), 'chapter-current': isCurrentChapter(chapter.chapter_id), 'chapter-item-pressed': pressedIdx === idx, 'chapter-item-last': idx === chapters.length - 1 }"
                @touchstart="onPressStart(idx)" @touchend="onPressEnd" @touchcancel="onPressEnd"
                @click="onChapterTap(chapter.chapter_id)">
                <view class="chapter-index" :class="{ 'chapter-index--done': isChapterCompleted(chapter.chapter_id) }">
                    <text v-if="isChapterCompleted(chapter.chapter_id)" class="chapter-check">✓</text>
                    <text v-else class="chapter-index-text">{{ idx + 1 }}</text>
                </view>
                <view class="chapter-info">
                    <text class="chapter-title" :class="{ 'chapter-title--done': isChapterCompleted(chapter.chapter_id) }">{{ chapter.title }}</text>
                    <text v-if="chapter.duration > 0" class="chapter-duration">{{ chapter.duration }} 分钟</text>
                </view>
                <image class="chapter-arrow" src="/static/icons/profile/chevron-right.png" mode="aspectFit" />
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import type { ChapterItem } from '../../../types/index'
    import { ref } from 'vue'

    const props = withDefaults(defineProps<{
        chapters? : ChapterItem[]
        completedIds? : number[]
        continueChapterId? : number
    }>(), {
        chapters: () => [] as ChapterItem[],
        completedIds: () => [] as number[],
        continueChapterId: 0
    })

    const emit = defineEmits(['chapterClick'])

    /** 按下态行号（-1 = 无）。uvue 原生端不支持 `:active` 伪类，按压反馈只能靠
     *  @touchstart/@touchend 切 class（ui-spec §5.10）。 */
    const pressedIdx = ref<number>(-1)

    function onPressStart(idx : number) : void {
        pressedIdx.value = idx
    }

    function onPressEnd() : void {
        pressedIdx.value = -1
    }

    function onChapterTap(chapterId : number) : void {
        emit('chapterClick', chapterId)
    }

    // ---- 以下两个判定自页面逐字搬入（消费面只有本段模板） ----
    /** 检查章节是否已完成 */
    function isChapterCompleted(chapterId : number) : boolean {
        const ids = props.completedIds
        for (let i = 0; i < ids.length; i++) {
            if (ids[i] == chapterId) return true
        }
        return false
    }

    /** 检查是否为当前继续学习的章节 */
    function isCurrentChapter(chapterId : number) : boolean {
        return props.continueChapterId == chapterId && props.continueChapterId > 0
    }
</script>

<style lang="scss">
    /* ===== 通用 section ===== */
    .section {
        background-color: $card-bg;
        padding: 28rpx 32rpx;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24rpx;
    }

    .section-title {
        font-size: 32rpx;
        font-weight: bold;
        color: $text-strong;
    }

    .chapter-count {
        font-size: 24rpx;
        color: $text-color-placeholder;
    }

    /* ===== 章节列表 ===== */
    .chapter-list {
        flex-direction: column;
    }

    .chapter-item {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 0;
        border-bottom: 1rpx solid $bg-color;
    }

    /* uvue 原生端只认 .class 选择器：`:last-child` / `:active` 都会被静默忽略，
       末行去分隔线与按压反馈改由模板切类（ui-spec §5.10）。 */
    .chapter-item-last {
        border-bottom: none;
    }

    .chapter-item-pressed {
        background-color: $bg-color;
    }

    .chapter-item.chapter-current {
        background-color: $primary-tint;
        margin: 0 -32rpx;
        padding: 24rpx 32rpx;
        border-radius: 12rpx;
    }

    .chapter-index {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: $primary-tint;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    /* 关系选择器（父类 + 空格 + 子类）在 UCSS 里需运行时动态计算、有额外性能损耗，
       HarmonyOS Vapor 不支持；祖先为复合类（两个类名连写）再跟后代时，编译产物是
       含空格的死键、永远匹配不上 ⇒ 一律落成挂在元素自身的平类 */
    .chapter-index--done {
        background-color: $success-tint;
    }

    .chapter-index-text {
        font-size: 28rpx;
        font-weight: bold;
        color: $primary-color;
    }

    .chapter-check {
        font-size: 28rpx;
        font-weight: bold;
        color: $success-color;
    }

    .chapter-info {
        flex: 1;
        flex-direction: column;
    }

    .chapter-title {
        font-size: 28rpx;
        color: $text-color;
        margin-bottom: 6rpx;
        lines: 2;
        text-overflow: ellipsis;
    }

    .chapter-title--done {
        color: $text-color-placeholder;
    }

    .chapter-duration {
        font-size: 22rpx;
        color: $text-color-placeholder;
    }

    .chapter-arrow {
        width: 32rpx;
        height: 32rpx;
        margin-left: 12rpx;
        flex-shrink: 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: $text-color-placeholder;
        margin-bottom: 24rpx;
    }

    .empty-tip {
        align-items: center;
        padding: 60rpx 0;
    }
</style>
