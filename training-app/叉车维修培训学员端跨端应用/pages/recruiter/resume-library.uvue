<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">简历库</text>
            <view class="header-right" @click="onOpenFilter">
                <text class="filter-entry">筛选</text>
                <view v-if="activeFilterCount > 0" class="filter-badge">
                    <text class="filter-badge-text">{{ activeFilterCount }}</text>
                </view>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <view v-if="items.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon">📄</text>
                <text class="empty-text">{{ activeFilterCount > 0 ? '没有符合条件的简历' : '暂无可浏览的简历' }}</text>
            </view>

            <view class="list">
                <view v-for="card in items" :key="card.user_id" class="resume-card" @click="onOpenDetail(card.user_id)">
                    <view class="card-head">
                        <text class="resume-name">{{ card.real_name_masked.length > 0 ? card.real_name_masked : card.real_name }}</text>
                        <text class="resume-updated">{{ shortTime(card.updated_at) }}</text>
                    </view>

                    <text class="resume-position">{{ positionText(card) }}</text>

                    <view class="meta-row">
                        <text class="meta-salary">{{ salaryText(card) }}</text>
                        <text class="meta-experience ml-16">{{ experienceText(card) }}</text>
                    </view>
                    <view class="meta-row mt-8">
                        <text class="meta-item">{{ regionsText(card) }}</text>
                    </view>
                    <view class="meta-row mt-8">
                        <text class="meta-item">{{ jobNatureText(card) }}</text>
                        <text class="meta-item ml-16">{{ availableText(card) }}</text>
                    </view>

                    <view class="card-foot">
                        <text class="cert-text">{{ certText(card) }}</text>
                        <text class="contact-state">{{ contactStateText(card.contact_state) }}</text>
                    </view>
                </view>
            </view>

            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="!loading && noMore && items.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>

        <recruiter-filter-drawer :show="filterVisible" :filters="filters" @apply="onApplyFilter" @close="onCloseFilter" />
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { getRecruitResumesApi, emptyRecruitFilters, jobNatureLabel, RECRUIT_PAGE_SIZE } from '../../api/recruit'
    import { isRecruiterActive } from '../../utils/authRole'
    import RecruiterFilterDrawer from './components/recruiter-filter-drawer.uvue'
    import type { RecruitResumeCard, RecruitResumeFilters } from '../../api/recruit'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const items = ref<RecruitResumeCard[]>([])
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const page = ref<number>(1)
    const filters = ref<RecruitResumeFilters>(emptyRecruitFilters())
    const filterVisible = ref<boolean>(false)

    /** 生效的筛选维数（0 = 未筛选），用于标题栏徽标与空态文案 */
    const activeFilterCount = computed<number>(() : number => {
        const f = filters.value
        let n = 0
        if (f.region.trim().length > 0) n += 1
        if (f.position_id != null) n += 1
        if (f.credential_id != null) n += 1
        if (f.salary_min != null) n += 1
        if (f.salary_max != null) n += 1
        if (f.experience_min != null) n += 1
        if (f.job_nature.length > 0) n += 1
        if (f.available_in.length > 0) n += 1
        return n
    })

    /**
     * 页面级身份守卫（ADR-0021 ②「互斥」）：招聘者工作区页面只在招聘者态可用。
     * 学员 token 打任何 recruiter 端点都会被后端组级能力位拦成 403（先于资源查找），
     * 但页面**不该**先渲染再吃 403 —— 那会让学员看到一屏「加载失败」。
     */
    function guardRecruiter() : boolean {
        if (isRecruiterActive()) return true
        uni.reLaunch({ url: '/pages/recruiter/login' })
        return false
    }

    async function loadResumes(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
            items.value = []
        }
        if (noMore.value) return
        loading.value = true
        try {
            const result = await getRecruitResumesApi(filters.value, page.value)
            if (reset) {
                items.value = result.items
            } else {
                items.value = items.value.concat(result.items)
            }
            // 响应**不回显** page / page_size，故只能按「本批不足一页」或「已够 total」判到底
            if (result.items.length < RECRUIT_PAGE_SIZE || items.value.length >= result.total) {
                noMore.value = true
            }
            page.value = page.value + 1
        } catch (e) {
            uni.showToast({ title: '加载失败，请稍后重试', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    function onBack() : void {
        uni.navigateBack()
    }

    function onOpenFilter() : void {
        filterVisible.value = true
    }

    function onCloseFilter() : void {
        filterVisible.value = false
    }

    function onApplyFilter(next : RecruitResumeFilters) : void {
        filters.value = next
        filterVisible.value = false
        loadResumes(true)
    }

    function onLoadMore() : void {
        loadResumes(false)
    }

    function onOpenDetail(userId : number) : void {
        uni.navigateTo({ url: '/pages/recruiter/resume-detail?id=' + userId.toString() })
    }

    // ---- 展示口径 ----

    function positionText(card : RecruitResumeCard) : string {
        if (card.expected_position_extra.length > 0) return card.expected_position_extra
        if (card.expected_position_id != null) return '岗位 #' + card.expected_position_id!.toString()
        return '未填写期望岗位'
    }

    function salaryText(card : RecruitResumeCard) : string {
        if (card.salary_negotiable) return '面议'
        if (card.salary_min != null && card.salary_max != null) {
            return card.salary_min!.toString() + '-' + card.salary_max!.toString() + ' 元/月'
        }
        if (card.salary_min != null) return card.salary_min!.toString() + ' 元/月起'
        if (card.salary_max != null) return card.salary_max!.toString() + ' 元/月以内'
        return '薪资未填'
    }

    function experienceText(card : RecruitResumeCard) : string {
        if (card.experience_years <= 0) return '经验不限'
        return '经验 ' + card.experience_years.toString() + ' 年'
    }

    function regionsText(card : RecruitResumeCard) : string {
        if (card.expected_regions.length == 0) return '意向地区未填'
        return '意向：' + card.expected_regions.join('、')
    }

    function jobNatureText(card : RecruitResumeCard) : string {
        if (card.job_nature.length == 0) return '用工性质未填'
        return jobNatureLabel(card.job_nature)
    }

    function availableText(card : RecruitResumeCard) : string {
        if (card.available_in.length == 0) return '到岗时间未填'
        return card.available_in
    }

    /** 持证只出「编号 + 有效期」（后端已按白名单去图，这里不再展示任何图片位） */
    function certText(card : RecruitResumeCard) : string {
        if (card.resume_certifications.length == 0) return '暂无持证'
        return '持证 ' + card.resume_certifications.length.toString() + ' 项'
    }

    function contactStateText(state : string) : string {
        if (state == 'approved') return '已授权'
        if (state == 'pending') return '待授权'
        return ''
    }

    /** `2026-09-20T10:00:00Z` → `09-20`（只做展示，不解析时区） */
    function shortTime(raw : string) : string {
        if (raw.length < 10) return ''
        return raw.substring(5, 10)
    }

    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17
    // （本钩子放在全部顶层函数**之后**：UTS 无函数提升，Kotlin 侧前置调用是 error18）
    onLoad((options : OnLoadOptions) => {
        if (!guardRecruiter()) return
        loadResumes(true)
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: #f8f8f8;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        height: 88rpx;
        padding: 0 24rpx;
        background-color: #ffffff;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .header-left {
        width: 96rpx;
        height: 64rpx;
        align-items: flex-start;
        justify-content: center;
    }

    .back-icon {
        font-size: 44rpx;
        color: #333333;
    }

    .header-title {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        flex-direction: row;
        align-items: center;
        width: 140rpx;
        justify-content: flex-end;
    }

    .filter-entry {
        font-size: 28rpx;
        color: #2979ff;
    }

    .filter-badge {
        min-width: 32rpx;
        height: 32rpx;
        border-radius: 16rpx;
        background-color: #ff6b35;
        align-items: center;
        justify-content: center;
        margin-left: 8rpx;
        padding: 0 8rpx;
    }

    .filter-badge-text {
        font-size: 20rpx;
        color: #ffffff;
    }

    .content-scroll {
        flex: 1;
    }

    .list {
        flex-direction: column;
        padding: 16rpx 24rpx;
    }

    .resume-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        border: 1rpx solid #eeeeee;
        flex-direction: column;
    }

    .card-head {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .resume-name {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .resume-updated {
        font-size: 22rpx;
        color: #999999;
    }

    .resume-position {
        font-size: 28rpx;
        color: #2979ff;
        margin-top: 8rpx;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
    }

    .mt-8 { margin-top: 8rpx; }

    .meta-salary {
        font-size: 28rpx;
        font-weight: bold;
        color: #ff6b35;
    }

    .meta-experience {
        font-size: 26rpx;
        color: #666666;
    }

    .meta-item {
        font-size: 26rpx;
        color: #666666;
    }

    .card-foot {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 16rpx;
        padding-top: 16rpx;
        border-top: 1rpx solid #f5f5f5;
    }

    .cert-text {
        font-size: 24rpx;
        color: #999999;
    }

    .contact-state {
        font-size: 24rpx;
        color: #2979ff;
    }

    .empty-tip {
        flex-direction: column;
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-icon {
        font-size: 80rpx;
        margin-bottom: 24rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    .ml-16 { margin-left: 16rpx; }
</style>
