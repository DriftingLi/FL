<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <view class="nav-bar">
            <view class="nav-side"></view>
            <text class="nav-title">职位</text>
            <view class="nav-side nav-side-right" @click="onPublish">
                <text class="nav-action">发布</text>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="!loading && jobs.length == 0" class="empty-tip">
                <text class="empty-text">暂无职位，点击右上角「发布」开始招聘</text>
            </view>

            <view v-for="job in jobs" :key="job.id" class="job-card">
                <view class="card-head" @click="onOpenApplications(job)">
                    <view class="row-title-line">
                        <text class="row-title">{{ job.title }}</text>
                        <text class="tag" :class="jobTagClass(job)">{{ jobTagLabel(job) }}</text>
                    </view>
                    <text class="row-meta">{{ jobMeta(job) }}</text>
                </view>
                <view class="card-actions">
                    <text class="action-text" @click="onOpenApplications(job)">投递列表</text>
                    <text class="action-text" @click="onEdit(job)">编辑</text>
                    <text v-if="!job.forced_offline" class="action-text" @click="onToggle(job)">{{ job.status == 'open' ? '下架' : '上架' }}</text>
                </view>
            </view>

            <view v-if="loading" class="loading-tip">
                <text class="loading-text">加载中...</text>
            </view>
        </scroll-view>

        <RecruiterTabBar :active="activeKey" @switch="onSwitchTab" />
    </view>
</template>

<script setup lang="uts">
    /**
     * 招聘者工作区 · 职位面（一级 tab；T3 升级：列表卡内联「编辑 / 上下架」+ 右上角「发布」）
     *
     * 首屏批量请求 = 1（`GET /recruit/jobs`）。
     * **禁 N+1 原样保留**（ADR-0021 ② / 0028 ②）：不逐职位拉 `unread_count`——它在
     * `GET /recruit/jobs/{id}/applications` 的响应里，逐职位拉就是 N+1；`JobPostingDTO` 也无投递计数字段。
     *
     * 职位生命周期管理（ADR-0028 ④ T3，推翻 0021 ③「只读、不做发布/编辑/上下架」）：
     *   - 发布 / 编辑：`navigateTo` 全屏 `job-edit`（二级面）；
     *   - 上架 / 下架：`POST /recruit/jobs/{id}/toggle-status`（可逆，无需二次确认）；
     *   - `forced_offline`（平台强制下架）的职位**隐藏「上架」**——上架按钮点了必被后端拒，是 #705 判的空入口。
     */
    import { ref } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { getRecruitJobsApi, toggleRecruitJobStatusApi } from '../../api/recruit'
    import { describeRecruitJobStatus } from '../../utils/recruitDisplay'
    import { ensureRecruiterSession } from '../../utils/recruitGuard'
    import RecruiterTabBar from './components/recruiter-tab-bar.uvue'
    import type { RecruitJob } from '../../api/recruit'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const activeKey : string = 'jobs'

    const jobs = ref<RecruitJob[]>([])
    const loading = ref<boolean>(false)

    // ⚠️ 函数定义顺序是**契约**（`utils/utsAndroidCompile.test.js` 的 A 守护）：`onLoad(...)` 放最后。

    function loadJobs() : void {
        loading.value = true
        getRecruitJobsApi().then((result) : void => {
            jobs.value = result.items
            loading.value = false
        }).catch((e) : void => {
            console.error('[recruiter-jobs] load jobs failed:', e)
            loading.value = false
        })
    }

    /** 职位徽标（强制下架优先）；模板只消费本页薄包装，不直调 import 函数（守护规则 S） */
    function jobTagLabel(job : RecruitJob) : string {
        return describeRecruitJobStatus(job.status, job.forced_offline).label
    }

    function jobTagClass(job : RecruitJob) : string {
        return 'tag-' + describeRecruitJobStatus(job.status, job.forced_offline).status
    }

    /** 职位副行：只拼后端真给了的字段，缺项不留空占位 */
    function jobMeta(job : RecruitJob) : string {
        const parts : string[] = []
        if (job.region.length > 0) parts.push(job.region)
        if (job.salary_text.length > 0) parts.push(job.salary_text)
        if (job.experience_req.length > 0) parts.push(job.experience_req)
        return parts.join(' · ')
    }

    /** 面间 `redirectTo` 替换（不堆栈）；本 tab 的 key 命中则不动 */
    function onSwitchTab(key : string) : void {
        if (key == activeKey) return
        if (key == 'home') { uni.redirectTo({ url: '/pages/recruiter/home' }); return }
        if (key == 'resumes') { uni.redirectTo({ url: '/pages/recruiter/resumes' }); return }
        if (key == 'contacts') { uni.redirectTo({ url: '/pages/recruiter/contacts' }); return }
        if (key == 'me') { uni.redirectTo({ url: '/pages/recruiter/me' }); return }
    }

    /** 进某个职位的投递列表（二级面，`unread_count` 只有进到这里才拿得到） */
    function onOpenApplications(job : RecruitJob) : void {
        uni.navigateTo({ url: '/pages/recruiter/applications?jobId=' + job.id.toString() })
    }

    /** 发布：全屏编辑页，无 id = 新建 */
    function onPublish() : void {
        uni.navigateTo({ url: '/pages/recruiter/job-edit' })
    }

    /** 编辑：全屏编辑页，带 id = 预填更新 */
    function onEdit(job : RecruitJob) : void {
        uni.navigateTo({ url: '/pages/recruiter/job-edit?id=' + job.id.toString() })
    }

    /** 上架 / 下架切换（可逆）：成功后重取列表拿回新 status；失败透出，不做乐观更新 */
    function onToggle(job : RecruitJob) : void {
        toggleRecruitJobStatusApi(job.id).then(() : void => {
            loadJobs()
        }).catch((e) : void => {
            console.error('[recruiter-jobs] toggle failed:', e)
            uni.showToast({ title: '操作失败，请重试', icon: 'none' })
        })
    }

    onLoad((options : OnLoadOptions) => {
        if (!ensureRecruiterSession()) return
        loadJobs()
    })
</script>

<style lang="scss">
    .page {
        background-color: #F5F6FA;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .nav-bar {
        flex-direction: row;
        align-items: center;
        height: 88rpx;
        padding: 0 24rpx;
        background-color: #ffffff;
    }

    .nav-side {
        width: 120rpx;
        flex-direction: row;
        align-items: center;
    }

    .nav-side-right {
        justify-content: flex-end;
    }

    .nav-title {
        flex: 1;
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
        text-align: center;
    }

    .nav-action {
        font-size: 30rpx;
        color: #239EDD;
        padding: 16rpx 0;
    }

    .content-scroll {
        flex: 1;
    }

    .job-card {
        margin: 16rpx 24rpx 0 24rpx;
        padding: 24rpx;
        background-color: #ffffff;
        border-radius: 12rpx;
    }

    .card-head {
        flex-direction: column;
    }

    .row-title-line {
        flex-direction: row;
        align-items: center;
    }

    .row-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
    }

    .row-meta {
        margin-top: 8rpx;
        font-size: 24rpx;
        color: #999999;
    }

    .card-actions {
        flex-direction: row;
        justify-content: flex-end;
        margin-top: 16rpx;
        border-top: 1rpx solid #F0F0F0;
        padding-top: 16rpx;
    }

    .action-text {
        font-size: 26rpx;
        color: #239EDD;
        margin-left: 32rpx;
    }

    .tag {
        margin-left: 12rpx;
        padding: 4rpx 12rpx;
        border-radius: 8rpx;
        font-size: 20rpx;
    }

    .tag-forced {
        color: #E5484D;
        background-color: #FFF0F0;
    }

    .tag-open {
        color: #22A45D;
        background-color: #F0FFF0;
    }

    .tag-closed {
        color: #999999;
        background-color: #F5F5F5;
    }

    .tag-unknown {
        color: #999999;
        background-color: #F5F5F5;
    }

    .empty-tip {
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .loading-tip {
        align-items: center;
        padding: 40rpx 0;
    }

    .loading-text {
        font-size: 26rpx;
        color: #999999;
    }
</style>
