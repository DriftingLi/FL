<template>
    <view class="recruiter-login-page">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <view class="nav-bar">
            <view class="nav-back" @click="leaveRecruiterLogin">
                <text class="nav-back-text">返回</text>
            </view>
        </view>

        <scroll-view scroll-y class="body">
            <view class="header">
                <text class="page-title">招聘者登录</text>
            </view>

            <view class="form">
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" type="text" placeholder="招聘者账号" :maxlength="50" :value="username"
                            @input="onUsernameInput" @confirm="onSubmit" />
                    </view>
                </view>
                <view class="form-item">
                    <view class="input-wrap">
                        <input class="input-base" :password="!passwordVisible" placeholder="请输入密码" :maxlength="32"
                            :value="password" @input="onPasswordInput" @confirm="onSubmit" />
                        <text class="pwd-toggle" @click="togglePasswordVisible">{{ passwordVisible ? '隐藏' : '显示' }}</text>
                    </view>
                </view>

                <button class="btn-login" :class="{ 'btn-login-disabled': loading }" :disabled="loading" @click="onSubmit">
                    {{ btnText }}
                </button>
            </view>
        </scroll-view>

        <!-- 回学员端出口：纯文字链接，复用既有 link 样式（镜像 `pages/login/login.uvue` 的 `.recruiter-entry`）
             ⚠️ 走 `leaveRecruiterLogin()` 的**分流**，不是无条件 reLaunch：正常入口（学员登录页
             `navigateTo` 进来）栈里有上一页 ⇒ 只回退、不动认证槽；只有**栈空**的死胡同
             （`utils/recruitGuard.uts` 与 `api/request.uts` 的 401 角色化出口都用 `uni.reLaunch`
             ⇒ 页面栈被清空，真机已复现「退不出去」）才自带出口回学员登录页。 -->
        <view class="student-exit" @click="leaveRecruiterLogin">
            <text class="student-exit-link">返回学员登录</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad } from '@dcloudio/uni-app'
    import { ref, computed } from 'vue'
    import { useAuthStore } from '../../stores/auth'
    import { getActiveRole, isRecruiterActive } from '../../utils/authRole'
    import { ACTIVE_ROLE_STUDENT } from '../../constants/app'

    const auth = useAuthStore()

    const username = ref<string>('')
    const password = ref<string>('')
    const passwordVisible = ref<boolean>(false)
    const loading = ref<boolean>(false)

    const statusBarHeight = ref<number>(20)

    /**
     * 离开招聘者登录页 —— **按「页面栈里有没有上一页」分流**，而不是所有出口都清槽。
     *
     * 两条进入路径的语义完全不同，这正是「死胡同」的由来：
     *   ① **正常入口**（`pages/login/login.uvue` 的 `goRecruiterLogin()` 走 `navigateTo`）⇒ 栈里有上一页。
     *      此时「返回」/「取消」只应当**回退**，一个认证槽都不许动 —— 否则「点到招聘者入口又点取消」
     *      会变成「把当前学员登出」（本页 P1 的原始语义就是 `navigateBack()`）。
     *   ② **死胡同**（`utils/recruitGuard.uts` 的 `ensureRecruiterSession()` 与 `api/request.uts` 的
     *      401 角色化出口，两者都用 `uni.reLaunch` ⇒ **页面栈被清空**）⇒ 栈里没有可返回的页。
     *      真机已复现：人被困在本页（`pages/recruiter/contacts` → `/pages/recruiter/login` 反复出现）。
     *      这时才必须自带出口：`reLaunch` 回学员登录页。
     *
     * 判据用的是 UTS 全局 `getCurrentPages()`，与仓内既有同形写法一致
     * （`utils/navigation.uts:14` / `pages/search/search.uvue:376` 的 `pages != null && pages.length > 1`）。
     *
     * **清槽的判据是「当前身份是招聘者」，不是「栈空」**：`auth_active_role` 只在 `loginAsRecruiter()`
     * 里被写成 recruiter，学员侧任何登录路径都不写它 ⇒ 带着 recruiter 标记回学员端，下一次 401 仍按
     * 角色分支把人送回本页（来回弹）。反过来，**栈空但身份是学员**时（守卫把一个在册学员从招聘者页
     * 弹到了这里）**绝不能清槽** —— 那会把一个只是走错路的学员登出；不清槽时学员登录页的 `onLoad`
     * 会因为 `isLoggedIn` 直接把人送回工作区。用**既有**专用清槽函数（ADR-0022 ③），
     * 不另立清槽、不动 `clearAuthData()`。
     *
     * @note 定义必须早于 `onLoad` 与模板（UTS 无函数提升，Kotlin 侧是 error18 未解析的引用）
     */
    function leaveRecruiterLogin() : void {
        const pages = getCurrentPages()
        if (pages != null && pages.length > 1) {
            // 正常入口：只回退，不动任何认证槽（保持 P1 原语义）
            uni.navigateBack()
            return
        }
        // 死胡同（栈空）：只有招聘者身份的残留才清，学员会话一个键都不碰
        if (isRecruiterActive()) {
            auth.clearIdentityForSwitch()
        }
        uni.reLaunch({ url: '/pages/login/login' })
    }

    onLoad((options : OnLoadOptions) => {
        const sysInfo = uni.getSystemInfoSync()
        statusBarHeight.value = sysInfo.statusBarHeight
        // 身份互斥（ADR-0021 ②）：不允许「已登录学员」与招聘者并存于同一认证槽。
        // 已持学员会话时**先问人**再清槽 —— 清槽是破坏性动作，不能由一次误点触发。
        auth.restoreFromStorage()
        if (auth.isLoggedIn.value && getActiveRole() == ACTIVE_ROLE_STUDENT) {
            uni.showModal({
                title: '退出当前账号',
                content: '登录招聘者账号将退出当前学员账号',
                // 形参不写类型：`res` 由 uni-app x 按 ShowModalSuccess 推导（对齐 ai-settings.uvue 的既有写法）
                success: (res) => {
                    if (res.confirm) {
                        auth.clearAuthData()
                    } else {
                        // 取消 ⇒ 走同一个分流：栈里有页只回退（不清槽，学员会话不动）；
                        // 栈空的死胡同才回学员登录页。见 `leaveRecruiterLogin` 的注释。
                        leaveRecruiterLogin()
                    }
                },
            })
        }
    })

    const btnText = computed<string>(() : string => {
        if (loading.value) return '登录中...'
        return '登 录'
    })

    function togglePasswordVisible() : void {
        passwordVisible.value = !passwordVisible.value
    }

    function onUsernameInput(e : InputEvent) : void {
        username.value = e.detail.value
    }

    function onPasswordInput(e : InputEvent) : void {
        password.value = e.detail.value
    }

    function validate() : string {
        if (username.value.trim().length == 0) return '请输入招聘者账号'
        if (password.value.length == 0) return '请输入密码'
        if (password.value.length < 6) return '密码至少 6 位'
        return ''
    }

    /**
     * 提交登录。
     * @note 定义必须早于 `onConfirm`（UTS 无函数提升，Kotlin 侧是 error18 未解析的引用）
     */
    async function onSubmit() : Promise<void> {
        if (loading.value) return
        const err = validate()
        if (err.length > 0) {
            uni.showToast({ title: err, icon: 'none' })
            return
        }

        loading.value = true
        uni.showLoading({ title: '登录中...', mask: true })
        try {
            await auth.loginAsRecruiter({
                username: username.value.trim(),
                password: password.value,
            })
            uni.hideLoading()
            uni.showToast({ title: '登录成功', icon: 'success', duration: 1000 })
            setTimeout(() => {
                // 落到招聘者工作区的首页 = 职位段（ADR-0022 ②「首页即职位段」）；
                // P1 当时还不存在这个路由，故先指到学员 dashboard，P2 接线时改到本处
                uni.reLaunch({ url: '/pages/recruiter/jobs' })
            }, 500)
        } catch (e) {
            uni.hideLoading()
            console.error('[recruiter-login] failed:', e)
            let msg = '登录失败，请重试'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    function onConfirm() : void {
        onSubmit()
    }
</script>

<style lang="scss">
    .recruiter-login-page {
        flex: 1;
        background-color: #ffffff;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .nav-bar {
        flex-direction: row;
        align-items: center;
        padding: 0 24rpx;
        height: 88rpx;
    }

    .nav-back {
        padding: 20rpx 16rpx;
    }

    .nav-back-text {
        font-size: 30rpx;
        color: #2979ff;
    }

    .body {
        flex: 1;
    }

    .header {
        align-items: center;
        padding: 40rpx 0 60rpx 0;
    }

    .page-title {
        font-size: 44rpx;
        font-weight: bold;
        color: #333333;
        text-align: center;
    }

    .form {
        padding: 0 56rpx;
    }

    .form-item {
        margin-bottom: 28rpx;
    }

    .input-wrap {
        flex-direction: row;
        align-items: center;
        background-color: #F5F6FA;
        border-radius: 16rpx;
        height: 96rpx;
        padding: 0 28rpx;
    }

    .input-base {
        flex: 1;
        height: 96rpx;
        border: none;
        background-color: transparent;
        padding: 0;
        font-size: 30rpx;
        color: #333333;
    }

    .pwd-toggle {
        font-size: 26rpx;
        color: #999999;
        padding-left: 16rpx;
    }

    .btn-login {
        margin-top: 24rpx;
        width: 100%;
        height: 96rpx;
        line-height: 96rpx;
        border-radius: 48rpx;
        background-color: #2979ff;
        color: #ffffff;
        font-size: 34rpx;
        font-weight: bold;
        text-align: center;
        border: none;
    }

    .btn-login-disabled {
        opacity: 0.6;
    }

    /* ===== 回学员端出口（纯文字链接，复用学员登录页 `.recruiter-entry` / `.back-password-link` 的外观口径） ===== */
    .student-exit {
        align-items: center;
        padding: 0 0 60rpx 0;
    }

    .student-exit-link {
        font-size: 26rpx;
        color: #2979ff;
        border-bottom-width: 1rpx;
        border-bottom-style: solid;
        border-bottom-color: #2979ff;
        padding-bottom: 2rpx;
    }
</style>
