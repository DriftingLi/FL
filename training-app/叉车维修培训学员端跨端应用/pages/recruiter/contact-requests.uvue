<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">我的交换申请</text>
            <view class="header-right"></view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <view v-if="items.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon">✉️</text>
                <text class="empty-text">暂无交换申请</text>
            </view>

            <view class="list">
                <view v-for="item in items" :key="item.id" class="request-card" @click="onOpenResume(item.student_user_id)">
                    <view class="card-head">
                        <text class="student-text">学员 #{{ item.student_user_id }}</text>
                        <text class="status-text" :class="statusClass(item.status)">{{ statusText(item.status) }}</text>
                    </view>
                    <text class="message-text mt-8">{{ messageText(item.message) }}</text>
                    <view class="meta-row mt-12">
                        <text class="meta-item">{{ sourceText(item.source) }}</text>
                        <text class="meta-item ml-16">{{ remainText(item) }}</text>
                    </view>
                    <text class="time-text mt-8">发起于 {{ shortTime(item.created_at) }}</text>
                </view>
            </view>

            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="!loading && noMore && items.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { getRecruitContactRequestsApi, RECRUIT_PAGE_SIZE } from '../../api/recruit'
    import { isRecruiterActive } from '../../utils/authRole'
    import type { RecruitContactRequest } from '../../api/recruit'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const items = ref<RecruitContactRequest[]>([])
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const page = ref<number>(1)

    async function loadRequests(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
            items.value = []
        }
        if (noMore.value) return
        loading.value = true
        try {
            const result = await getRecruitContactRequestsApi(page.value, RECRUIT_PAGE_SIZE)
            if (reset) {
                items.value = result.items
            } else {
                items.value = items.value.concat(result.items)
            }
            if (result.items.length < RECRUIT_PAGE_SIZE || items.value.length >= result.total) {
                noMore.value = true
            }
            page.value = page.value + 1
        } catch (e) {
            uni.showToast({ title: '加载失败，请稍后重试', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // onLoad 见文件末（UTS 无函数提升：钩子必须放在它调用的全部顶层函数之后）

    function onBack() : void {
        uni.navigateBack()
    }

    function onLoadMore() : void {
        loadRequests(false)
    }

    function onOpenResume(studentUserId : number) : void {
        if (studentUserId <= 0) return
        uni.navigateTo({ url: '/pages/recruiter/resume-detail?id=' + studentUserId.toString() })
    }

    // ---- 展示口径 ----

    function statusText(status : string) : string {
        if (status == 'approved') return '已授权'
        if (status == 'pending') return '待学员处理'
        if (status == 'rejected') return '已拒绝'
        if (status == 'expired') return '已过期'
        // 交换申请域的 revoked 不复用投稿域那张状态词表（utils/contributionStatus.uts 只覆盖投稿五态，
        // 其零内联锁也禁掉了投稿域自己的两字文案）——本域另立文案，两域词表不混。
        if (status == 'revoked') return '学员已撤销'
        return status
    }

    function statusClass(status : string) : string {
        if (status == 'approved') return 'status-approved'
        if (status == 'pending') return 'status-pending'
        return 'status-closed'
    }

    function sourceText(source : string) : string {
        if (source == 'application') return '投递产生'
        return '企业发起'
    }

    function parseDay(iso : string) : number {
        const y = parseInt(iso.substring(0, 4))
        const m = parseInt(iso.substring(5, 7))
        const d = parseInt(iso.substring(8, 10))
        return y * 10000 + m * 100 + d
    }

    /** 只做「天数」粗算：解析到日期段即可，不引时区库（展示用） */
    function daysUntil(iso : string) : number {
        if (iso.length < 10) return 0
        const expire = parseDay(iso)
        const now = new Date()
        const today = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate()
        return expire - today
    }

    function messageText(message : string) : string {
        if (message.length == 0) return '（无附言）'
        return message
    }

    function shortTime(raw : string) : string {
        if (raw.length < 10) return '-'
        return raw.substring(0, 10)
    }

    /** pending 的剩余天数（14 天窗口由后端 `expires_at` 给出；其它状态不给倒计时） */
    function remainText(item : RecruitContactRequest) : string {
        if (item.status != 'pending') return ''
        const days = daysUntil(item.expires_at)
        if (days < 0) return '已过期'
        return '剩余 ' + days.toString() + ' 天'
    }

    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17
    // （钩子放在文件末：UTS 无函数提升，Kotlin 侧前置调用是 error18）
    onLoad((options : OnLoadOptions) => {
        if (!isRecruiterActive()) {
            uni.reLaunch({ url: '/pages/recruiter/login' })
            return
        }
        loadRequests(true)
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: #f8f8f8;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        height: 88rpx;
        padding: 0 24rpx;
        background-color: #ffffff;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .header-left {
        width: 96rpx;
        height: 64rpx;
        align-items: flex-start;
        justify-content: center;
    }

    .back-icon {
        font-size: 44rpx;
        color: #333333;
    }

    .header-title {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        width: 96rpx;
    }

    .content-scroll {
        flex: 1;
    }

    .list {
        flex-direction: column;
        padding: 16rpx 24rpx;
    }

    .request-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        border: 1rpx solid #eeeeee;
        flex-direction: column;
    }

    .card-head {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .student-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .status-text {
        font-size: 24rpx;
    }

    .status-approved {
        color: #2979ff;
    }

    .status-pending {
        color: #ff6b35;
    }

    .status-closed {
        color: #999999;
    }

    .message-text {
        font-size: 26rpx;
        color: #666666;
        line-height: 1.6;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
    }

    .meta-item {
        font-size: 24rpx;
        color: #999999;
    }

    .time-text {
        font-size: 22rpx;
        color: #999999;
    }

    .mt-8 { margin-top: 8rpx; }
    .mt-12 { margin-top: 12rpx; }

    .empty-tip {
        flex-direction: column;
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-icon {
        font-size: 80rpx;
        margin-bottom: 24rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    .ml-16 { margin-left: 16rpx; }
</style>
