    }

    .option-text--desc {
        font-size: 22rpx;
        color: #888888;
    }

    .option-chip--active .option-text--desc {
        color: #79AEFF;
    }

    /* ---- 热门考证卡片（横排两列） ---- */
    .hot-grid {
        flex-direction: row;
        gap: 18rpx;
    }

    .hot-card {
        flex: 1;
        padding: 24rpx 20rpx;
        background: linear-gradient(135deg, #2979FF 0%, #1565C0 100%);
        border-radius: 16rpx;
    }

    .hot-card-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 10rpx;
    }

    .hot-card-star {
        font-size: 26rpx;
        margin-right: 8rpx;
    }

    .hot-card-title {
        flex: 1;
        font-size: 28rpx;
        font-weight: 600;
        color: #FFFFFF;
    }

    .hot-card-desc {
        font-size: 22rpx;
        color: rgba(255, 255, 255, 0.85);
        lines: 3;
        text-overflow: ellipsis;
    }

    /* ---- 热门考证详情说明 ---- */
    .detail-section {
        margin: 16rpx 32rpx 0;
        padding: 28rpx;
