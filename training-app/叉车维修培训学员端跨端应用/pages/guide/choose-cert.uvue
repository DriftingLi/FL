        font-weight: 500;
    }

    /* ---- 滚动区域 ---- */
    .scroll-area {
        flex: 1;
    }

    /* ---- 分组区块 ---- */
    .section {
        margin: 16rpx 32rpx 0;
        padding: 28rpx;
        background-color: #FFFFFF;
        border-radius: 20rpx;
    }

    .section-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 24rpx;
    }

    .section-icon {
        width: 52rpx;
        height: 52rpx;
        border-radius: 12rpx;
        align-items: center;
        justify-content: center;
