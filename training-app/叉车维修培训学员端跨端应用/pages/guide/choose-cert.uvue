<template>
    <view class="page">
        <!-- 页头（N02 白底套，#1605 批2）：唯一页头件 app-nav-bar -->
        <app-nav-bar title="选择学习阶段" @left-click="toback" />

        <!-- 省份选择 -->
        <view class="province-bar" @click="onProvinceTap">
            <text class="province-pin">📍</text>
            <text class="province-label">报考省份：</text>
            <text class="province-value">{{ province }}</text>
        </view>

        <!-- 内容区：滚动面在 cert-selector 内部（内嵌形态 flex:1），页面不再另套一层 scroll-view
             ⇒ 不出现双滚动面。选证列表 = 共享领域件（内嵌形态），数据唯一真源 = 后端 grouped 字典；
             原「特种作业 / 技能等级 / 热门考证」三块静态列表已随 #1395 整删——自持静态列表
             的 key 与后端 code 不通，是「选了永远匹配不上、从不落库」病灶的根。 -->
        <view class="content">
            <CertSelector v-if="!listFailed" :groups="groups" :current-id="selectedId" @select="onSelect" />
            <!-- 列表加载失败 = 空态 + 重试，不静态兜底（兜底列表 = 重引入本票要埋掉的病灶）。
                 两条各拿一个并列 v-if（不用 v-else）：uvue 的 v-else 不容注释/空行间隔。 -->
            <app-empty-state v-if="listFailed" text="证件列表加载失败" action-text="重试" @action="loadList" />
        </view>

        <!-- 底部完成按钮：一次真切换——PATCH 后端确认成功才跳首页，失败留页可重试 -->
        <view class="bottom-bar">
            <view class="btn-confirm" :class="{ 'btn-confirm--disabled': selectedId == 0 }" @click="onConfirmTap">
                <text class="btn-confirm-text">完成</text>
            </view>
        </view>

        <!-- 选证引导态（#2535 Q2，设计稿 307_6164）：首屏先给一屏引导，点击或上滑进主态；
             右上角 X = 跳过选证直接进首页。层叠在本页内、不建路由（地图 #2510 映射裁定）。
             放在 .page 末子元素：绝对定位盖住页头与列表，且不参与上面那条 flex 列的高度分配。 -->
        <view v-if="guideVisible" class="guide" @click="enterMain" @touchstart="handleGuideTouchStart"
            @touchend="handleGuideTouchEnd">
            <view class="guide-tint"></view>
            <view class="guide-copy">
                <view class="guide-row">
                    <text class="guide-hi">Hi，您好</text>
                </view>
                <view class="guide-row guide-row--ask">
                    <text class="guide-ask">请选择您需要考的证</text>
                </view>
                <view class="guide-row guide-row--tip">
                    <text class="guide-tip">我们来为您推荐适合的课程</text>
                </view>
            </view>
            <view class="guide-mascot-box">
                <image class="guide-mascot" src="/static/guide-mascot.png" mode="aspectFit"></image>
            </view>
            <view class="guide-close" @click.stop="onSkipGuide">
                <text class="guide-close-icon">✕</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad } from '@dcloudio/uni-app'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import CertSelector from '../../components/cert-selector/cert-selector.uvue'
    import appEmptyState from '../../components/app-empty-state/app-empty-state.uvue'
    import { useChooseCertGuide } from './composables/useChooseCertGuide'
    import {
        CHOOSE_CERT_FROM_DASHBOARD,
        SUBMIT_SWITCHED,
        useChooseCertSelection
    } from './composables/useChooseCertSelection'

    // 未登录防护
    const auth = useAuthStore()
    auth.restoreFromStorage()
    if (!auth.isLoggedIn.value) {
        uni.reLaunch({ url: '/pages/login/login' })
    }

    // ---- 选择流（#2907：状态与动作全归 composable，本页只剩模板 / 生命周期 / 薄包装） ----
    // 两段式语义随之搬入：点选只改待提交项、完成才 PATCH、同证件不发 PATCH（判据可跑行为腿）。
    const { province, groups, selectedId, listFailed, loadList, onSelect, onConfirm, onProvinceTap } =
        useChooseCertSelection()

    // ---- 引导态（#2535 Q2）：首屏引导 → 点击/上滑进主态；X 跳过选证直达首页 ----
    // #2907：整页已是证件选择的唯一路径 ⇒ 从首页来是「改证件」，不能再由一屏引导挡住；
    // 注册流落地（不带 from）保持原引导态。
    const { guideVisible, onGuideTouchStart, onGuideTouchEnd, enterMain } = useChooseCertGuide()

    // 首屏装载：预选当前证件 + 拉分组字典（唯一真源 = 后端，零硬编码）
    loadList()

    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17。
    // 键取 options['from'] 索引形态（utils/navQueryKeyContract.test.js 按括号字符串键解析）。
    onLoad((options : OnLoadOptions) => {
        const rawFrom = options['from']
        if (rawFrom != null && rawFrom.toString() == CHOOSE_CERT_FROM_DASHBOARD) {
            enterMain()
        }
    })

    /**
     * 完成：切换成功后回首页。走既有 goBack()（栈 >1 则 navigateBack，栈只有 1 层才 reLaunch 回首页）
     * —— 注册流落地时栈只有本页，靠它兜住；从首页压栈进来的走返回，首页 onShow 自会重拉当前证件。
     * 失败/未选/未变更都留页（composable 已提示），不导航。
     */
    function onConfirmTap() : void {
        onConfirm().then((result : string) : void => {
            if (result == SUBMIT_SWITCHED) {
                goBack()
            }
        })
    }

    function toback() : void {
        goBack()
    }

    /** 引导层触摸起点：只取触点纵坐标（px），上滑判定与阈值归 composable */
    function handleGuideTouchStart(e : UniTouchEvent) : void {
        if (e.touches.length > 0) {
            onGuideTouchStart(e.touches[0].clientY)
        }
    }

    function handleGuideTouchEnd(e : UniTouchEvent) : void {
        if (e.changedTouches.length > 0) {
            onGuideTouchEnd(e.changedTouches[0].clientY)
        }
    }

    /** X = 跳过选证：不改证件、不 PATCH，直接落首页（票面 Q2 拍板） */
    function onSkipGuide() : void {
        uni.reLaunch({ url: '/pages/dashboard/dashboard' })
    }
</script>

<style lang="scss">
    .page {
        flex: 1;
        flex-direction: column;
        background-color: $bg-color;
    }

    /* ---- 省份选择 ---- */
    .province-bar {
        flex-direction: row;
        align-items: center;
        margin: 20rpx 32rpx 8rpx;
        padding: 14rpx 24rpx;
        background-color: #F0F2F5;
        border-radius: 40rpx;
        align-self: flex-start;
    }

    .province-pin {
        font-size: $font-size-md;
        margin-right: $spacing-xs;
    }

    .province-label {
        font-size: 26rpx;
        color: #888888;
    }

    .province-value {
        font-size: 26rpx;
        color: $text-color;
        font-weight: 500;
    }

    /* ---- 内容区（滚动面在 cert-selector 内，这里只给 flex 高度） ---- */
    .content {
        flex: 1;
    }

    /* ---- 底部完成按钮（页面 flex 列的末子元素，不再 fixed） ---- */
    .bottom-bar {
        padding: 20rpx 32rpx;
        padding-bottom: 20rpx;
        background-color: $bg-header;
    }

    .btn-confirm {
        height: 96rpx;
        background: linear-gradient(to bottom right, $primary-color, #1565C0);
        background-color: #1565C0;
        border-radius: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .btn-confirm--disabled {
        opacity: 0.5;
    }

    .btn-confirm-text {
        font-size: $font-size-lg;
        font-weight: 600;
        color: $text-color-inverse;
    }

    /* ---- 选证引导态（票 2535 Q2，设计稿 307_6164 量测） ----
       底色与闪屏同款：实底主色 + 底部一条渐变带。两层而不是三停 linear-gradient，
       因为原生端对百分比色标支持不稳（同 pages/index/index.uvue 的 .splash-tint）。 */
    .guide {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background-color: $primary-color;
        z-index: 10;
    }

    .guide-tint {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 584rpx;
        background: linear-gradient(to bottom, $primary-color, $success-color);
    }

    .guide-copy {
        position: absolute;
        left: 146rpx;
        right: 32rpx;
        top: 450rpx;
    }

    .guide-row {
        flex-direction: column;
    }

    .guide-row--ask {
        margin-top: 14rpx;
    }

    .guide-row--tip {
        margin-top: 20rpx;
    }

    .guide-hi {
        font-size: 64rpx;
        font-weight: bold;
        color: #FFFFFF;
    }

    .guide-ask {
        font-size: 46rpx;
        color: #FFFFFF;
    }

    .guide-tip {
        font-size: 38rpx;
        color: #FFFFFF;
    }

    .guide-mascot-box {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 352rpx;
        align-items: center;
    }

    .guide-mascot {
        width: 349rpx;
        height: 460rpx;
    }

    /* 关闭 X：视觉 24rpx 字形，触摸目标 88rpx（≥44×44 口径） */
    .guide-close {
        position: absolute;
        right: 12rpx;
        top: 174rpx;
        width: 88rpx;
        height: 88rpx;
        align-items: center;
        justify-content: center;
    }

    .guide-close-icon {
        font-size: 32rpx;
        color: #FFFFFF;
    }
</style>
