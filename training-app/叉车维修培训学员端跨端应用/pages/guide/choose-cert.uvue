<template>
    <view class="page">
        <!-- 状态栏占位 -->
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-back" @click="toback">
                <text class="nav-back-icon">‹</text>
            </view>
            <text class="nav-title">选择学习阶段</text>
            <view class="nav-placeholder"></view>
        </view>

        <!-- 省份选择 -->
        <view class="province-bar" @click="onProvinceTap">
            <text class="province-pin">📍</text>
            <text class="province-label">报考省份：</text>
            <text class="province-value">{{ province }}</text>
        </view>

        <!-- 内容区：滚动面在 cert-selector 内部（内嵌形态 flex:1），页面不再另套一层 scroll-view
             ⇒ 不出现双滚动面。选证列表 = 共享领域件（内嵌形态），数据唯一真源 = 后端 grouped 字典；
             原「特种作业 / 技能等级 / 热门考证」三块静态列表已随 #1395 整删——自持静态列表
             的 key 与后端 code 不通，是「选了永远匹配不上、从不落库」病灶的根。 -->
        <view class="content">
            <CertSelector v-if="!listFailed" :groups="groups" :current-id="selectedId" :embedded="true"
                @select="onSelect" />
            <!-- 列表加载失败 = 空态 + 重试，不静态兜底（兜底列表 = 重引入本票要埋掉的病灶）。
                 两条各拿一个并列 v-if（不用 v-else）：uvue 的 v-else 不容注释/空行间隔。 -->
            <view v-if="listFailed" class="error-section">
                <text class="error-text">证件列表加载失败</text>
                <view class="btn-retry" @click="loadList">
                    <text class="btn-retry-text">重试</text>
                </view>
            </view>
        </view>

        <!-- 底部完成按钮：一次真切换——PATCH 后端确认成功才跳首页，失败留页可重试 -->
        <view class="bottom-bar">
            <view class="btn-confirm" :class="{ 'btn-confirm--disabled': selectedId == 0 }" @click="onConfirm">
                <text class="btn-confirm-text">完成</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import { getAllCredentialsApi, switchCredentialApi, writeCurrentCredentialCache } from '../../api/credential'
    import type { CredentialGroup, CredentialItem } from '../../types/index'
    import CertSelector from '../../components/cert-selector/cert-selector.uvue'

    const statusBarHeight = useStatusBarHeight()

    // 未登录防护
    const auth = useAuthStore()
    auth.restoreFromStorage()
    if (!auth.isLoggedIn.value) {
        uni.reLaunch({ url: '/pages/login/login' })
    }

    // ---- 省份 ----
    const province = ref('全国')

    // ---- 选证列表（唯一真源 = 后端 GET /credentials/grouped，零硬编码） ----
    const groups = ref<CredentialGroup[]>([])
    const selectedItem = ref<CredentialItem | null>(null)
    const selectedId = ref<number>(0)
    const listFailed = ref<boolean>(false)
    const isSubmitting = ref<boolean>(false)

    /** 拉证件字典：失败置空态（不静态兜底），重试按钮重新走这里 */
    function loadList() : void {
        getAllCredentialsApi().then((res : CredentialGroup[]) => {
            groups.value = res
            listFailed.value = false
        }).catch((e) => {
            console.warn('[choose-cert] load credential list failed:', e)
            listFailed.value = true
        })
    }
    loadList()

    /** 组件只 emit 选中项（纯选择器，#1379 裁定⑥）；动作时机归页面 */
    function onSelect(item : CredentialItem) : void {
        selectedItem.value = item
        selectedId.value = item.id
    }

    /**
     * 完成 = 一次真切换（#1395，病灶 2 的直译：跳转权交给后端确认）：
     * PATCH /me/credential 后端确认成功才 reLaunch 首页；失败留页可重试，不得 reLaunch。
     * 后端 200 但未回凭证 = 未确认 ⇒ 按失败处理（#1346 K4 口径）。
     */
    function onConfirm() : void {
        const item = selectedItem.value
        if (item == null) {
            uni.showToast({ title: '请先选择一个证书', icon: 'none' })
            return
        }
        if (isSubmitting.value) {
            return
        }
        isSubmitting.value = true
        switchCredentialApi(item!.id).then((result) => {
            if (result.success && result.credential != null) {
                // 后端确认值进缓存：首页立即显示所选证件（离线回退读的就是它）
                writeCurrentCredentialCache(result.credential)
                uni.reLaunch({ url: '/pages/dashboard/dashboard' })
            } else {
                uni.showToast({ title: '切换失败，请重试', icon: 'none' })
            }
            isSubmitting.value = false
        }).catch((e) => {
            console.warn('[choose-cert] switch credential failed:', e)
            uni.showToast({ title: '切换失败，请重试', icon: 'none' })
            isSubmitting.value = false
        })
    }

    function toback() : void {
        goBack()
    }

    function onProvinceTap() : void {
        uni.showActionSheet({
            itemList: ['全国', '北京', '上海', '广东', '浙江', '江苏', '山东', '四川', '湖北', '湖南', '河南'],
            success: (res) => {
                const list = ['全国', '北京', '上海', '广东', '浙江', '江苏', '山东', '四川', '湖北', '湖南', '河南']
                province.value = list[res.tapIndex]
            }
        })
    }
</script>

<style>
    .page {
        flex: 1;
        flex-direction: column;
        background-color: #F5F7FA;
    }

    .status-bar {
        background-color: #FFFFFF;
    }

    /* ---- 顶部导航 ---- */
    .nav-bar {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        height: 88rpx;
        padding: 0 24rpx;
        background-color: #FFFFFF;
    }

    .nav-back {
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
    }

    .nav-back-icon {
        font-size: 52rpx;
        color: #333333;
    }

    .nav-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    .nav-placeholder {
        width: 64rpx;
        height: 64rpx;
    }

    /* ---- 省份选择 ---- */
    .province-bar {
        flex-direction: row;
        align-items: center;
        margin: 20rpx 32rpx 8rpx;
        padding: 14rpx 24rpx;
        background-color: #F0F2F5;
        border-radius: 40rpx;
        align-self: flex-start;
    }

    .province-pin {
        font-size: 28rpx;
        margin-right: 8rpx;
    }

    .province-label {
        font-size: 26rpx;
        color: #888888;
    }

    .province-value {
        font-size: 26rpx;
        color: #333333;
        font-weight: 500;
    }

    /* ---- 内容区（滚动面在 cert-selector 内，这里只给 flex 高度） ---- */
    .content {
        flex: 1;
    }

    /* ---- 列表失败空态 ---- */
    .error-section {
        margin: 16rpx 32rpx 0;
        padding: 48rpx 28rpx;
        background-color: #FFFFFF;
        border-radius: 20rpx;
        align-items: center;
    }

    .error-text {
        font-size: 28rpx;
        color: #888888;
        margin-bottom: 24rpx;
    }

    .btn-retry {
        padding: 14rpx 48rpx;
        border-radius: 40rpx;
        border-width: 2rpx;
        border-color: #2979FF;
    }

    .btn-retry-text {
        font-size: 28rpx;
        color: #2979FF;
        font-weight: 600;
    }

    /* ---- 底部完成按钮（页面 flex 列的末子元素，不再 fixed） ---- */
    .bottom-bar {
        padding: 20rpx 32rpx;
        padding-bottom: 20rpx;
        background-color: #FFFFFF;
    }

    .btn-confirm {
        height: 96rpx;
        background: linear-gradient(to bottom right, #2979FF, #1565C0);
        background-color: #1565C0;
        border-radius: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .btn-confirm--disabled {
        opacity: 0.5;
    }

    .btn-confirm-text {
        font-size: 32rpx;
        font-weight: 600;
        color: #FFFFFF;
    }
</style>
