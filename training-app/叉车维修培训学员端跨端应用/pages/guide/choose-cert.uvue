<template>
    <view class="page">
        <!-- 状态栏占位 -->
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-back" @click="goBack">
                <text class="nav-back-icon">‹</text>
            </view>
            <text class="nav-title">选择学习阶段</text>
            <view class="nav-search" @click="onSearch">
                <text class="nav-search-icon">🔍</text>
            </view>
        </view>

        <!-- 滚动内容区 -->
        <scroll-view scroll-y class="scroll-area">
            <!-- 省份选择 -->
            <view class="province-bar" @click="onProvinceTap">
                <text class="province-pin">📍</text>
                <text class="province-label">报考省份：</text>
                <text class="province-value">{{ province }}</text>
            </view>

            <!-- 分组一：特种作业配套上岗证 -->
            <view class="section">
                <view class="section-header">
                    <view class="section-icon icon-special">
                        <text class="section-icon-text">🔧</text>
                    </view>
                    <text class="section-title">特种作业配套上岗证</text>
                </view>
                <view class="option-row">
                    <view v-for="(item, idx) in specialCerts" :key="idx" class="option-chip"
                        :class="{ 'option-chip--active': selectedCert === item.key }" @click="onSelectCert(item.key)">
                        <text class="option-text"
                            :class="{ 'option-text--active': selectedCert === item.key }">{{ item.name }}</text>
                    </view>
                </view>
            </view>

            <!-- 分组二：工程机械维修工（叉车维修方向技能等级证） -->
            <view class="section">
                <view class="section-header">
                    <view class="section-icon icon-engineer">
                        <text class="section-icon-text">⚙️</text>
                    </view>
                    <text class="section-title">工程机械维修工
                        (叉车维修方向技能等级证)</text>
                </view>
                <view class="option-row">
                    <view v-for="(item, idx) in skillLevels" :key="idx" class="option-chip"
                        :class="{ 'option-chip--active': selectedCert === item.key }" @click="onSelectCert(item.key)">
                        <text class="option-text"
                            :class="{ 'option-text--active': selectedCert === item.key }">{{ item.name }}</text>
                    </view>
                </view>
            </view>

            <!-- 分组三：热门（纯展示，不可点击） -->
            <view class="section">
                <view class="section-header">
                    <view class="section-icon icon-hot">
                        <text class="section-icon-text">🔥</text>
                    </view>
                    <text class="section-title">热门</text>
                </view>
                <view class="hot-list">
                    <view v-for="(item, idx) in hotItems" :key="idx" class="hot-card">
                        <text class="hot-card-title">{{ item.title }}</text>
                        <text class="hot-card-desc">{{ item.desc }}</text>
                    </view>
                </view>
            </view>

            <!-- 底部留白 -->
            <view style="height: 60rpx;"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { useAuthStore } from '../../stores/auth'
    import { setStorage } from '../../utils/storage'

    const statusBarHeight = useStatusBarHeight()

    // 未登录防护
    const auth = useAuthStore()
    auth.restoreFromStorage()
    if (!auth.isLoggedIn.value) {
        uni.reLaunch({ url: '/pages/login/login' })
    }

    // ---- 省份 ----
    const province = ref('全国')

    // ---- 当前选中的证书（单选） ----
    const selectedCert = ref('')

    // ---- 特种作业配套上岗证 ----
    const specialCerts = ref([
        { key: 'low_voltage', name: '低压电工证' },
        { key: 'welder', name: '焊工证' },
        { key: 'forklift_n1', name: '叉车司机N1证' }
    ])

    // ---- 技能等级证 ----
    const skillLevels = ref([
        { key: 'level_5', name: '五级初级' },
        { key: 'level_4', name: '四级中级' },
        { key: 'level_3', name: '三级高级' },
        { key: 'level_2', name: '二级技师' },
        { key: 'level_1', name: '一级高级技师' }
    ])

    // ---- 热门（纯展示） ----
    const hotItems = ref([
        // { title: 'N2维修证', desc: '正规维修上岗资质' },
        // { title: '技能等级证', desc: '补贴、晋升、加薪' },
        // { title: '配套取证', desc: 'N1司机证/低压电工证' }
        { title: '入门组合', desc: '工程机械维修工（初级）+ 叉车N1证' },
        { title: '电动叉车维修优选', desc: '工程机械维修工+N1司机证+低压电工证' }
    ])

    // ---- 单选 → 保存 → 跳首页 ----
    function onSelectCert(key : string) : void {
        selectedCert.value = key
        // 持久化到 storage
        setStorage('selected_cert', key)
        // 直接跳转首页
        uni.reLaunch({ url: '/pages/dashboard/dashboard' })
    }

    function onProvinceTap() : void {
        uni.showActionSheet({
            itemList: ['全国', '北京', '上海', '广东', '浙江', '江苏', '山东', '四川', '湖北', '湖南', '河南'],
            success: (res) => {
                const list = ['全国', '北京', '上海', '广东', '浙江', '江苏', '山东', '四川', '湖北', '湖南', '河南']
                province.value = list[res.tapIndex]
            }
        })
    }

    function onSearch() : void {
        uni.showToast({ title: '搜索功能开发中', icon: 'none' })
    }

    function goBack() : void {
        uni.navigateBack({ delta: 1 })
    }
</script>

<style>
    .page {
        flex: 1;
        flex-direction: column;
        background-color: #F5F7FA;
    }

    .status-bar {
        background-color: #FFFFFF;
    }

    /* ---- 顶部导航 ---- */
    .nav-bar {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        height: 88rpx;
        padding: 0 24rpx;
        background-color: #FFFFFF;
    }

    .nav-back {
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
    }

    .nav-back-icon {
        font-size: 52rpx;
        color: #333333;
    }

    .nav-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    .nav-search {
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
    }

    .nav-search-icon {
        font-size: 38rpx;
    }

    /* ---- 省份选择 ---- */
    .province-bar {
        flex-direction: row;
        align-items: center;
        margin: 24rpx 32rpx 12rpx;
        padding: 16rpx 24rpx;
        background-color: #FFFFFF;
        border-radius: 40rpx;
        align-self: flex-start;
    }

    .province-pin {
        font-size: 28rpx;
        margin-right: 8rpx;
    }

    .province-label {
        font-size: 26rpx;
        color: #888888;
    }

    .province-value {
        font-size: 26rpx;
        color: #333333;
        font-weight: 500;
    }

    /* ---- 滚动区域 ---- */
    .scroll-area {
        flex: 1;
    }

    /* ---- 分组区块 ---- */
    .section {
        margin: 20rpx 32rpx 0;
        padding: 28rpx;
        background-color: #FFFFFF;
        border-radius: 20rpx;
    }

    .section-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 24rpx;
    }

    .section-icon {
        width: 52rpx;
        height: 52rpx;
        border-radius: 12rpx;
        align-items: center;
        justify-content: center;
        margin-right: 14rpx;
    }

    .icon-special {
        background-color: #FFF3E0;
    }

    .icon-engineer {
        background-color: #E8F5E9;
    }

    .icon-hot {
        background-color: #FFEBEE;
    }

    .section-icon-text {
        font-size: 30rpx;
    }

    .section-title {
        flex: 1;
        font-size: 30rpx;
        font-weight: 600;
        color: #222222;
    }

    /* ---- 选项胶囊 ---- */
    .option-row {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 18rpx;
    }

    .option-chip {
        padding: 20rpx 32rpx;
        background-color: #F5F7FA;
        border-radius: 40rpx;
        border-width: 2rpx;
        border-color: transparent;
    }

    .option-chip--active {
        background-color: #EBF5FF;
        border-color: #2979FF;
    }

    .option-text {
        font-size: 28rpx;
        color: #444444;
    }

    .option-text--active {
        color: #2979FF;
        font-weight: 600;
    }

    /* ---- 热门卡片（纯展示） ---- */
    .hot-list {
        gap: 18rpx;
    }

    .hot-card {
        padding: 28rpx 32rpx;
        background: linear-gradient(135deg, #2979FF 0%, #1565C0 100%);
        border-radius: 16rpx;
    }

    .hot-card-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #FFFFFF;
        margin-bottom: 8rpx;
    }

    .hot-card-desc {
        font-size: 24rpx;
        color: rgba(255, 255, 255, 0.85);
    }
