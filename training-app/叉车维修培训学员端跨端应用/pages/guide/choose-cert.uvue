<template>
    <view class="page">
        <!-- 页头（N02 白底套，#1605 批2）：唯一页头件 app-nav-bar -->
        <app-nav-bar title="选择学习阶段" @left-click="toback" />

        <!-- 省份选择 -->
        <view class="province-bar" @click="onProvinceTap">
            <text class="province-pin">📍</text>
            <text class="province-label">报考省份：</text>
            <text class="province-value">{{ province }}</text>
        </view>

        <!-- 内容区：滚动面在 cert-selector 内部（内嵌形态 flex:1），页面不再另套一层 scroll-view
             ⇒ 不出现双滚动面。选证列表 = 共享领域件（内嵌形态），数据唯一真源 = 后端 grouped 字典；
             原「特种作业 / 技能等级 / 热门考证」三块静态列表已随 #1395 整删——自持静态列表
             的 key 与后端 code 不通，是「选了永远匹配不上、从不落库」病灶的根。 -->
        <view class="content">
            <CertSelector v-if="!listFailed" :groups="groups" :current-id="selectedId" :embedded="true"
                @select="onSelect" />
            <!-- 列表加载失败 = 空态 + 重试，不静态兜底（兜底列表 = 重引入本票要埋掉的病灶）。
                 两条各拿一个并列 v-if（不用 v-else）：uvue 的 v-else 不容注释/空行间隔。 -->
            <view v-if="listFailed" class="error-section">
                <text class="error-text">证件列表加载失败</text>
                <view class="btn-retry" @click="loadList">
                    <text class="btn-retry-text">重试</text>
                </view>
            </view>
        </view>

        <!-- 底部完成按钮：一次真切换——PATCH 后端确认成功才跳首页，失败留页可重试 -->
        <view class="bottom-bar">
            <view class="btn-confirm" :class="{ 'btn-confirm--disabled': selectedId == 0 }" @click="onConfirm">
                <text class="btn-confirm-text">完成</text>
            </view>
        </view>

        <!-- 选证引导态（#2535 Q2，设计稿 307_6164）：首屏先给一屏引导，点击或上滑进主态；
             右上角 X = 跳过选证直接进首页。层叠在本页内、不建路由（地图 #2510 映射裁定）。
             放在 .page 末子元素：绝对定位盖住页头与列表，且不参与上面那条 flex 列的高度分配。 -->
        <view v-if="guideVisible" class="guide" @click="enterMain" @touchstart="handleGuideTouchStart"
            @touchend="handleGuideTouchEnd">
            <view class="guide-tint"></view>
            <view class="guide-copy">
                <view class="guide-row">
                    <text class="guide-hi">Hi，您好</text>
                </view>
                <view class="guide-row guide-row--ask">
                    <text class="guide-ask">请选择您需要考的证</text>
                </view>
                <view class="guide-row guide-row--tip">
                    <text class="guide-tip">我们来为您推荐适合的课程</text>
                </view>
            </view>
            <view class="guide-mascot-box">
                <image class="guide-mascot" src="/static/guide-mascot.png" mode="aspectFit"></image>
            </view>
            <view class="guide-close" @click.stop="onSkipGuide">
                <text class="guide-close-icon">✕</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { getAllCredentialsApi, switchCredentialApi, writeCurrentCredentialCache } from '../../api/credential'
    import type { CredentialGroup, CredentialItem } from '../../types/index'
    import CertSelector from '../../components/cert-selector/cert-selector.uvue'
    import { useChooseCertGuide } from './composables/useChooseCertGuide'
    import { DEFAULT_PROVINCE, pickProvince } from '../../utils/provincePicker'

    // 未登录防护
    const auth = useAuthStore()
    auth.restoreFromStorage()
    if (!auth.isLoggedIn.value) {
        uni.reLaunch({ url: '/pages/login/login' })
    }

    // ---- 引导态（#2535 Q2）：首屏引导 → 点击/上滑进主态；X 跳过选证直达首页 ----
    const { guideVisible, onGuideTouchStart, onGuideTouchEnd, enterMain } = useChooseCertGuide()

    // ---- 省份（展示性字段，选择逻辑收口在 utils/provincePicker） ----
    const province = ref(DEFAULT_PROVINCE)

    // ---- 选证列表（唯一真源 = 后端 GET /credentials/grouped，零硬编码） ----
    const groups = ref<CredentialGroup[]>([])
    const selectedItem = ref<CredentialItem | null>(null)
    const selectedId = ref<number>(0)
    const listFailed = ref<boolean>(false)
    const isSubmitting = ref<boolean>(false)

    /** 拉证件字典：失败置空态（不静态兜底），重试按钮重新走这里 */
    function loadList() : void {
        getAllCredentialsApi().then((res : CredentialGroup[]) => {
            groups.value = res
            listFailed.value = false
        }).catch((e) => {
            console.warn('[choose-cert] load credential list failed:', e)
            listFailed.value = true
        })
    }
    loadList()

    /** 组件只 emit 选中项（纯选择器，#1379 裁定⑥）；动作时机归页面 */
    function onSelect(item : CredentialItem) : void {
        selectedItem.value = item
        selectedId.value = item.id
    }

    /**
     * 完成 = 一次真切换（#1395，病灶 2 的直译：跳转权交给后端确认）：
     * PATCH /me/credential 后端确认成功才 reLaunch 首页；失败留页可重试，不得 reLaunch。
     * 后端 200 但未回凭证 = 未确认 ⇒ 按失败处理（#1346 K4 口径）。
     */
    function onConfirm() : void {
        const item = selectedItem.value
        if (item == null) {
            uni.showToast({ title: '请先选择一个证书', icon: 'none' })
            return
        }
        if (isSubmitting.value) {
            return
        }
        isSubmitting.value = true
        switchCredentialApi(item!.id).then((result) => {
            if (result.success && result.credential != null) {
                // 后端确认值进缓存：首页立即显示所选证件（离线回退读的就是它）
                writeCurrentCredentialCache(result.credential)
                uni.reLaunch({ url: '/pages/dashboard/dashboard' })
            } else {
                uni.showToast({ title: '切换失败，请重试', icon: 'none' })
            }
            isSubmitting.value = false
        }).catch((e) => {
            console.warn('[choose-cert] switch credential failed:', e)
            uni.showToast({ title: '切换失败，请重试', icon: 'none' })
            isSubmitting.value = false
        })
    }

    function toback() : void {
        goBack()
    }

    /** 引导层触摸起点：只取触点纵坐标（px），上滑判定与阈值归 composable */
    function handleGuideTouchStart(e : UniTouchEvent) : void {
        if (e.touches.length > 0) {
            onGuideTouchStart(e.touches[0].clientY)
        }
    }

    function handleGuideTouchEnd(e : UniTouchEvent) : void {
        if (e.changedTouches.length > 0) {
            onGuideTouchEnd(e.changedTouches[0].clientY)
        }
    }

    /** X = 跳过选证：不改证件、不 PATCH，直接落首页（票面 Q2 拍板） */
    function onSkipGuide() : void {
        uni.reLaunch({ url: '/pages/dashboard/dashboard' })
    }

    function onProvinceTap() : void {
        pickProvince((p : string) : void => {
            province.value = p
        })
    }
</script>

<style lang="scss">
    .page {
        flex: 1;
        flex-direction: column;
        background-color: #F5F7FA;
    }

    /* ---- 省份选择 ---- */
    .province-bar {
        flex-direction: row;
        align-items: center;
        margin: 20rpx 32rpx 8rpx;
        padding: 14rpx 24rpx;
        background-color: #F0F2F5;
        border-radius: 40rpx;
        align-self: flex-start;
    }

    .province-pin {
        font-size: $font-size-md;
        margin-right: $spacing-xs;
    }

    .province-label {
        font-size: 26rpx;
        color: #888888;
    }

    .province-value {
        font-size: 26rpx;
        color: $text-color;
        font-weight: 500;
    }

    /* ---- 内容区（滚动面在 cert-selector 内，这里只给 flex 高度） ---- */
    .content {
        flex: 1;
    }

    /* ---- 列表失败空态 ---- */
    .error-section {
        margin: $spacing-sm 32rpx 0;
        padding: $spacing-lg 28rpx;
        background-color: $bg-header;
        border-radius: 20rpx;
        align-items: center;
    }

    .error-text {
        font-size: $font-size-md;
        color: #888888;
        margin-bottom: $spacing-md;
    }

    .btn-retry {
        padding: 14rpx $spacing-lg;
        border-radius: 40rpx;
        border-width: 2rpx;
        border-color: $primary-color;
    }

    .btn-retry-text {
        font-size: $font-size-md;
        color: $primary-color;
        font-weight: 600;
    }

    /* ---- 底部完成按钮（页面 flex 列的末子元素，不再 fixed） ---- */
    .bottom-bar {
        padding: 20rpx 32rpx;
        padding-bottom: 20rpx;
        background-color: $bg-header;
    }

    .btn-confirm {
        height: 96rpx;
        background: linear-gradient(to bottom right, $primary-color, #1565C0);
        background-color: #1565C0;
        border-radius: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .btn-confirm--disabled {
        opacity: 0.5;
    }

    .btn-confirm-text {
        font-size: $font-size-lg;
        font-weight: 600;
        color: $text-color-inverse;
    }

    /* ---- 选证引导态（票 2535 Q2，设计稿 307_6164 量测） ----
       底色与闪屏同款：实底主色 + 底部一条渐变带。两层而不是三停 linear-gradient，
       因为原生端对百分比色标支持不稳（同 pages/index/index.uvue 的 .splash-tint）。 */
    .guide {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background-color: $primary-color;
        z-index: 10;
    }

    .guide-tint {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 584rpx;
        background: linear-gradient(to bottom, $primary-color, $success-color);
    }

    .guide-copy {
        position: absolute;
        left: 146rpx;
        right: 32rpx;
        top: 450rpx;
    }

    .guide-row {
        flex-direction: column;
    }

    .guide-row--ask {
        margin-top: 14rpx;
    }

    .guide-row--tip {
        margin-top: 20rpx;
    }

    .guide-hi {
        font-size: 64rpx;
        font-weight: bold;
        color: #FFFFFF;
    }

    .guide-ask {
        font-size: 46rpx;
        color: #FFFFFF;
    }

    .guide-tip {
        font-size: 38rpx;
        color: #FFFFFF;
    }

    .guide-mascot-box {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 352rpx;
        align-items: center;
    }

    .guide-mascot {
        width: 349rpx;
        height: 460rpx;
    }

    /* 关闭 X：视觉 24rpx 字形，触摸目标 88rpx（≥44×44 口径） */
    .guide-close {
        position: absolute;
        right: 12rpx;
        top: 174rpx;
        width: 88rpx;
        height: 88rpx;
        align-items: center;
        justify-content: center;
    }

    .guide-close-icon {
        font-size: 32rpx;
        color: #FFFFFF;
    }
</style>
