    .btn-confirm {
        height: 96rpx;
        background: linear-gradient(135deg, #2979FF 0%, #1565C0 100%);
        border-radius: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .btn-confirm--disabled {
        opacity: 0.5;
    }

    .btn-confirm-text {
        font-size: 32rpx;
        font-weight: 600;
        color: #FFFFFF;
    }
</style>
