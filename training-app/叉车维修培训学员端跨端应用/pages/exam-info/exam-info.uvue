<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="考情资讯" @left-click="onBack" />
        <scroll-view class="tab-bar" direction="horizontal" :show-scrollbar="false">
            <view v-for="(tab, idx) in mainTabs" :key="idx" class="tab-item" @click="onMainTabChange(idx)">
                <text class="tab-text" :class="{ 'tab-text-active': activeMainTab === idx }" lines="1">{{ tab }}</text>
                <view v-if="activeMainTab === idx" class="tab-underline"></view>
            </view>
        </scroll-view>
        <view class="filter-bar">
            <view v-for="(tag, idx) in filterTags" :key="idx" class="filter-tag"
                :class="{ 'filter-tag-active': activeFilter === idx }" @click="onFilterChange(idx)">
                <text class="filter-tag-text"
                    :class="{ 'filter-tag-text-active': activeFilter === idx }">{{ tag }}</text>
            </view>
        </view>
        <scroll-view class="content-scroll" direction="vertical" @scrolltolower="onLoadMore">
            <view v-if="items.length == 0 && !loading" class="empty-tip">
                <text class="empty-text">暂无资讯</text>
            </view>
            <view class="news-list">
                <view v-for="(item, idx) in items" :key="idx" class="news-item" @click="onItemClick(item)">
                    <view class="news-dot"></view>
                    <text class="news-title">{{ item.title }}</text>
                </view>
            </view>
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && items.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { goBack } from '../../utils/navigation'
    function onBack() : void {
        goBack()
    }
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const mainTabs : string[] = ['招聘信息', '新闻资讯', '考试动态', '相关问题', '报名入口', '成绩查询', '岗位表']
    const activeMainTab = ref<number>(1)

    const filterTags : string[] = ['最新资讯', '热点关注', '政策法规', '全部']
    const activeFilter = ref<number>(0)

    type NewsItem = {
        id : number
        title : string
        category : string
    }

    const items = ref<NewsItem[]>([])
    const page = ref<number>(1)
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)

    async function loadItems(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loading.value = true
        try {
            const mockItems : NewsItem[] = [
                { id: 1, title: '国务院安委会办公室应急管理部关于开展2026年', category: 'policy' },
                { id: 2, title: '2026年特种设备作业人员考试安排通知', category: 'exam' },
                { id: 3, title: '叉车司机职业技能等级认定新规解读', category: 'hot' },
                { id: 4, title: '应急管理部发布叉车安全操作规范（2026修订版）', category: 'policy' },
                { id: 5, title: '全国叉车维修技能竞赛报名入口已开放', category: 'latest' },
            ]
            if (reset) {
                items.value = mockItems
            } else {
                items.value = items.value.concat(mockItems)
            }
            noMore.value = true
        } catch (e) {
            console.error('[exam-info] load failed:', e)
        } finally {
            loading.value = false
        }
    }

    function onMainTabChange(idx : number) : void {
        activeMainTab.value = idx
        loadItems(true)
    }

    function onFilterChange(idx : number) : void {
        activeFilter.value = idx
        loadItems(true)
    }

    function onLoadMore() : void {
        loadItems(false)
    }

    function onItemClick(item : NewsItem) : void {
        uni.showToast({ title: '详情开发中', icon: 'none' })
    }

    onLoad((_options : any) => {
        loadItems(true)
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: $bg-color;
        flex-direction: column;
    }

    .tab-bar {
        height: 80rpx;
        flex-direction: row;
        background-color: $bg-header;
        border-bottom: 1rpx solid $border-color-light;
    }

    .tab-item {
        width: 160rpx;
        align-items: center;
        position: relative;
        flex-shrink: 0;
    }

    .tab-text {
        font-size: $font-size-md;
        color: $text-color-secondary;
    }

    .tab-text-active {
        color: $primary-color;
        font-weight: bold;
    }

    .tab-underline {
        width: 40rpx;
        height: 6rpx;
        border-radius: 3rpx;
        background-color: $primary-color;
        margin-top: $spacing-xs;
    }

    .filter-bar {
        flex-direction: row;
        background-color: $bg-header;
        padding: 16rpx 24rpx 20rpx;
        flex-wrap: wrap;
    }

    .filter-tag {
        padding: 10rpx 28rpx;
        border-radius: 28rpx;
        background-color: $bg-color;
        margin-right: $spacing-sm;
        margin-bottom: $spacing-xs;
    }

    .filter-tag-active {
        background-color: $primary-color;
    }

    .filter-tag-text {
        font-size: $font-size-sm;
        color: $text-color-secondary;
    }

    .filter-tag-text-active {
        color: $text-color-inverse;
        font-weight: 500;
    }

    .content-scroll {
        flex: 1;
        height: 0;
        background-color: $bg-header;
    }

    .news-list {
        flex-direction: column;
        padding: $spacing-xs 0;
    }

    .news-item {
        flex-direction: row;
        align-items: center;
        padding: 28rpx 32rpx;
        border-bottom: 1rpx solid $bg-color;
    }

    .news-dot {
        width: 12rpx;
        height: 12rpx;
        border-radius: 6rpx;
        background-color: $primary-color;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .news-title {
        flex: 1;
        font-size: $font-size-md;
        color: $text-color;
        lines: 2;
        text-overflow: ellipsis;
    }

    .empty-tip {
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-text {
        font-size: $font-size-md;
        color: $text-color-placeholder;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: $font-size-sm;
        color: $text-color-placeholder;
    }
</style>