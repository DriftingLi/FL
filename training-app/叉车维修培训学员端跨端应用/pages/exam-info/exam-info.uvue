<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="资讯" @left-click="onBack" />
        <!-- 主 Tab（B3 票 2519）：322:9139 贴片规范（app-tabs 承载，以本批为准）；四 tab 口径仍单点 EXAM_INFO_TABS -->
        <view class="tab-bar">
            <app-tabs :tabs="mainTabs" :active-index="activeMainTab" @change="onMainTabChange" />
        </view>
        <!-- 「报名入口」「成绩查询」同走考情内容（#1940 Q3 裁定）：文案把「同一批内容」讲清楚 -->
        <view v-if="hintText.length > 0" class="hint-bar">
            <text class="hint-text">{{ hintText }}</text>
        </view>
        <!-- chips 只在「新闻资讯」tab（#1940 Q4 裁定）：其余 tab 自身已是类别；「全部」贴右（原型 322:8928） -->
        <view v-if="withFilters" class="filter-bar">
            <view class="filter-left">
                <view v-for="(tag, idx) in leftFilterTags" :key="tag" class="filter-tag"
                    :class="{ 'filter-tag-active': activeFilter === idx }" @click="onFilterChange(idx)">
                    <text class="filter-tag-text"
                        :class="{ 'filter-tag-text-active': activeFilter === idx }">{{ tag }}</text>
                </view>
            </view>
            <view class="filter-tag filter-tag-all" :class="{ 'filter-tag-active': activeFilter === 3 }"
                @click="onFilterChange(3)">
                <text class="filter-tag-text" :class="{ 'filter-tag-text-active': activeFilter === 3 }">{{ filterTags[3] }}</text>
            </view>
        </view>
        <scroll-view class="content-scroll" direction="vertical" @scrolltolower="onLoadMore">
            <!-- 失败态与空态分开（#816 口径）：拉不到不能说成「暂无资讯」 -->
            <app-empty-state v-if="items.length == 0 && failed && !loading" text="资讯加载失败" action-text="重试"
                @action="onRetry" />
            <app-empty-state v-else-if="items.length == 0 && !loading" icon="📰" text="暂无资讯" />
            <view class="news-list">
                <view v-for="item in items" :key="item.content_id" class="news-card" @click="onItemClick(item)">
                    <view class="news-title-row">
                        <text class="news-spark">✨</text>
                        <text class="news-title" lines="2">{{ item.title }}</text>
                    </view>
                    <view class="news-meta">
                        <text v-if="item.category_label.length > 0" class="news-category">{{ item.category_label }}</text>
                        <text v-if="item.published_at.length > 0" class="news-date">{{ displayDate(item.published_at) }}</text>
                    </view>
                </view>
            </view>
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && items.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
        <!-- 底部 TabBar（原型 322:8928 五项；裁定 4 补「首页」出口）：本页非 tab 页，switchTab 落 tab 页，
             高亮固定首页与原型一致；图标复用 static/tabbar 现网资产（#2513 口径：优先复用） -->
        <view class="fake-tabbar">
            <view v-for="(tab, idx) in fakeTabs" :key="tab.label" class="fake-tab-item" @click="onFakeTabTap(tab)">
                <image class="fake-tab-icon" :src="idx == 0 ? tab.activeIcon : tab.icon" mode="aspectFit" />
                <text class="fake-tab-label" :class="idx == 0 ? 'fake-tab-label-active' : ''">{{ tab.label }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import appTabs from '../../components/app-tabs/app-tabs.uvue'
    import appEmptyState from '../../components/app-empty-state/app-empty-state.uvue'
    import { goBack } from '../../utils/navigation'
    import { getFeaturedContentsApi } from '../../api/featured'
    import { mergeDashboardNews } from '../../utils/dashboardNews'
    import { EXAM_INFO_TABS, EXAM_INFO_FILTERS, tabCategories, tabHint, showsFilters, filterQuery, appendUnique } from '../../utils/examInfoTabs'
    import { formatDateStr } from '../../utils/format'
    import type { FeaturedContentItem } from '../../types/index'

    /** 单类别请求的页大小；多类别 tab（新闻资讯 = 行业新闻 + 政策法规）合并后一屏约 2× 条 */
    const PAGE_SIZE : number = 10

    const windowHeight = uni.getSystemInfoSync().windowHeight

    /** tab 表与 chips 表的唯一口径在 utils/examInfoTabs：改口径改那里，不改模板 */
    const mainTabs : string[] = EXAM_INFO_TABS
    const filterTags : string[] = EXAM_INFO_FILTERS
    /** 左侧三枚 chips（「全部」单独贴右、仍是 filterQuery(3) 同一口径）；模板不做切片表达式 */
    const leftFilterTags : string[] = [filterTags[0], filterTags[1], filterTags[2]]

    const activeMainTab = ref<number>(0)
    const activeFilter = ref<number>(0)

    const items = ref<FeaturedContentItem[]>([])
    const page = ref<number>(1)
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    /** 本轮**所有**类别都失败（与「暂无资讯」区分开；#816 口径） */
    const failed = ref<boolean>(false)

    /** 底部 TabBar（裁定 3 定版 + 原型 AI学 仍在现网五 Tab 内）：落点 = 各 tab 页 switchTab */
    type FakeTab = {
        label : string
        icon : string
        activeIcon : string
        path : string
    }
    const fakeTabs : FakeTab[] = [
        { label: '首页', icon: '/static/tabbar/home.png', activeIcon: '/static/tabbar/home-active.png', path: '/pages/dashboard/dashboard' } as FakeTab,
        { label: '课程', icon: '/static/tabbar/course.png', activeIcon: '/static/tabbar/course-active.png', path: '/pages/courses/courses' } as FakeTab,
        { label: 'AI学', icon: '/static/tabbar/ai.png', activeIcon: '/static/tabbar/ai-active.png', path: '/pages/ai-assistant/ai-assistant' } as FakeTab,
        { label: '交流', icon: '/static/tabbar/forum.png', activeIcon: '/static/tabbar/forum-active.png', path: '/pages/forum/forum' } as FakeTab,
        { label: '我的', icon: '/static/tabbar/profile.png', activeIcon: '/static/tabbar/profile-active.png', path: '/pages/profile/profile' } as FakeTab,
    ]

    function onFakeTabTap(tab : FakeTab) : void {
        uni.switchTab({ url: tab.path })
    }

    const withFilters = computed<boolean>(() : boolean => showsFilters(activeMainTab.value))
    const hintText = computed<string>(() : string => tabHint(activeMainTab.value))

    /** 模板不可直调 import 函数（uvue 模板 import 调用编译为 .invoke() = Kotlin error18，先例 #677） */
    function displayDate(dateStr : string) : string {
        return formatDateStr(dateStr)
    }

    function onBack() : void {
        goBack()
    }

    /**
     * 取数：按 tab 的类别表**各发一次**请求（后端只支持单个 category，#2063 边界），
     * 合并 / 去重 / 倒序复用 utils/dashboardNews（#1939 已落地的同一口径）。
     */
    async function loadItems(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
            failed.value = false
            items.value = []
        }
        if (noMore.value) return

        loading.value = true
        // 无 chips 的 tab 用「全部」口径（不筛不排）；有 chips 时按 chip 映射（政策法规 chip 直接锁类别）
        const query = showsFilters(activeMainTab.value) ? filterQuery(activeFilter.value) : filterQuery(3)
        let cats : string[] = tabCategories(activeMainTab.value)
        if (query.category.length > 0) {
            const only : string[] = [query.category]
            cats = only
        }

        const groups : FeaturedContentItem[][] = []
        let failedCount = 0
        for (let i = 0; i < cats.length; i++) {
            try {
                const result = await getFeaturedContentsApi(page.value, PAGE_SIZE, cats[i], query.sort)
                groups.push(result.items)
            } catch (e) {
                // 单类别抖动不拦整页：一个类别失败不该把已有内容清空
                failedCount = failedCount + 1
                console.warn('[exam-info] load failed:', e)
            }
        }
        loading.value = false

        if (failedCount == cats.length) {
            failed.value = items.value.length == 0
            return
        }
        const merged = mergeDashboardNews(groups, 0)
        items.value = appendUnique(items.value, merged)
        noMore.value = merged.length == 0
        if (merged.length > 0) {
            page.value = page.value + 1
        }
    }

    function onMainTabChange(idx : number) : void {
        if (activeMainTab.value == idx) return
        activeMainTab.value = idx
        // chips 只在新闻资讯 tab：切走时回到「最新资讯」，切回来不会带着上一次的热点口径
        activeFilter.value = 0
        loadItems(true)
    }

    function onFilterChange(idx : number) : void {
        if (activeFilter.value == idx) return
        activeFilter.value = idx
        loadItems(true)
    }

    function onLoadMore() : void {
        loadItems(false)
    }

    /** 详情复用内容精选详情页（ADR-0045：三处消费点同一个落点）；正文外链由该页「参考链接」承载 */
    function onItemClick(item : FeaturedContentItem) : void {
        uni.navigateTo({ url: '/pages/featured/featured-detail?id=' + item.content_id.toString() })
    }

    function onRetry() : void {
        loadItems(true)
    }

    onLoad((_options : any) => {
        loadItems(true)
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: $bg-color;
        flex-direction: column;
    }

    /* 主 Tab 带（B3 票 2519）：白底 + app-tabs（322:9139 贴片规范） */
    .tab-bar {
        background-color: $bg-header;
        padding: 8rpx 24rpx;
    }

    .hint-bar {
        background-color: $bg-tint;
        padding: 16rpx 32rpx;
    }

    .hint-text {
        font-size: $font-size-sm;
        color: $text-color-secondary;
    }

    /* chips 行（原型 322:8928）：左侧三枚 + 「全部」贴右；选中浅蓝底主色字（实测同族） */
    .filter-bar {
        flex-direction: row;
        align-items: center;
        background-color: $bg-header;
        padding: 12rpx 24rpx 20rpx;
    }

    .filter-left {
        flex: 1;
        flex-direction: row;
        align-items: center;
    }

    .filter-tag {
        padding: 10rpx 28rpx;
        border-radius: $radius-pill;
        background-color: $tag-bg-neutral;
        margin-right: $spacing-sm;
    }

    .filter-tag-all {
        flex-shrink: 0;
        margin-right: 0;
    }

    .filter-tag-active {
        background-color: $primary-tint;
    }

    .filter-tag-text {
        font-size: $font-size-sm;
        color: $text-color;
    }

    .filter-tag-text-active {
        color: $primary-color;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 资讯卡（原型 322:8928）：白卡圆角 + ✨ 前缀标题 */
    .news-list {
        flex-direction: column;
        padding: $spacing-sm 24rpx 0;
    }

    .news-card {
        background-color: $card-bg;
        border-radius: $radius-card;
        padding: 28rpx 32rpx;
        margin-bottom: $spacing-sm;
        flex-direction: column;
    }

    .news-title-row {
        flex-direction: row;
        align-items: flex-start;
    }

    .news-spark {
        font-size: 26rpx;
        margin-right: 12rpx;
    }

    .news-title {
        flex: 1;
        font-size: $font-size-md;
        color: $text-color;
        lines: 2;
        text-overflow: ellipsis;
    }

    .news-meta {
        flex-direction: row;
        align-items: center;
        margin-top: $spacing-sm;
    }

    .news-category {
        font-size: $font-size-xs;
        color: $primary-color;
        background-color: $primary-tint;
        padding: 4rpx 12rpx;
        border-radius: $radius-sm;
        margin-right: $spacing-sm;
    }

    .news-date {
        font-size: $font-size-xs;
        color: $text-color-placeholder;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: $font-size-sm;
        color: $text-color-placeholder;
    }

    /* 底部 TabBar（原型 322:8928）：白底上边框，五项图标 + 标签，选中态=首页（与原型一致） */
    .fake-tabbar {
        flex-direction: row;
        background-color: $tabbar-bg;
        border-top: 1rpx solid $border-color-light;
        padding: 12rpx 0 20rpx;
    }

    .fake-tab-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
    }

    .fake-tab-icon {
        width: 48rpx;
        height: 48rpx;
        margin-bottom: 4rpx;
    }

    .fake-tab-label {
        font-size: 20rpx;
        color: $tabbar-inactive;
    }

    .fake-tab-label-active {
        color: $tabbar-active;
    }
</style>
