<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="文章详情" variant="inverse" @left-click="onBack">
            <template #right>
                <view class="fav-btn" @click="onToggleFavorite">
                    <text class="fav-icon">{{ isFavorited ? '⭐' : '☆' }}</text>
                </view>
            </template>
        </app-nav-bar>

        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="loading" class="loading-wrap">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-else-if="detail != null" class="article-wrap">
                <!-- 标题 -->
                <text class="page-heading">{{ detail!.title }}</text>
                <!-- 元信息 -->
                <view class="page-meta">
                    <text v-if="detail!.category_label.length > 0" class="meta-category">{{ detail!.category_label }}</text>
                    <text v-if="detail!.source.length > 0" class="meta-text">{{ detail!.source }}</text>
                    <text v-if="detail!.published_at.length > 0" class="meta-text">{{ displayTime(detail!.published_at) }}</text>
                    <text class="meta-text">{{ detail!.view_count }} 阅读</text>
                </view>
                <!-- 封面图 -->
                <view v-if="detail!.cover_image.length > 0" class="cover-wrap">
                    <image class="cover-img" :src="detail!.cover_image" mode="widthFix" :webp="true"></image>
                </view>
                <!-- 正文按形态分叉（2026-11，对接后端 content_type / docx_url）：
                     · markdown ⇒ 走四面共用的公共块渲染件（既有路径，逐字不动）；
                     · docx ⇒ 正文由写侧置空、原文件在 docx_url，移动端没有 docx-preview，
                       出路是「下载原文件 → 交系统打开」（下载动作收在 api 层）；
                     · 异常形态（docx 缺地址 / 正文为空）⇒ 给可见提示，**不许退回空白**
                       （根 CONTEXT.md「会让内容读不出来的降级必须补齐」）。
                     判定收在 `utils/featuredBody.uts`，本页只消费结论，不自己比字符串。 -->
                <view v-if="bodyKind == 'markdown'" class="article-body">
                    <MarkdownBlocks :blocks="contentBlocks" :caps="FEATURED_CAPS" inline-axis="plain"
                        @link-click="onRunLink" />
                </view>
                <view v-else-if="bodyKind == 'docx'" class="docx-card">
                    <text class="docx-badge">Word 文档</text>
                    <text class="docx-file">{{ docxFileName }}</text>
                    <view class="docx-btn" @click="onOpenDocx">
                        <text class="docx-btn-text">{{ docxOpening ? '正在打开...' : '打开文档' }}</text>
                    </view>
                    <text class="docx-tip">该文章为导入的原始 Word 文档，将下载后由系统应用打开</text>
                </view>
                <view v-else class="body-hint">
                    <text class="body-hint-text">{{ bodyHint }}</text>
                </view>
                <!-- 正文外链（#2097）：链接由正文 Markdown 承载，`source` 列只作来源名称、不参与判断 -->
                <view v-if="sourceLinks.length > 0" class="link-section">
                    <text class="link-title">参考链接</text>
                    <view v-for="(lnk, lIdx) in sourceLinks" :key="lIdx" class="link-item" @click="onOpenLink(lnk.url)">
                        <text class="link-item-text">{{ lnk.label }}</text>
                        <text class="link-item-host">{{ lnk.host }}</text>
                    </view>
                </view>
                <!-- 上下篇导航 -->
                <view v-if="detail!.prev != null || detail!.next != null" class="nav-section">
                    <view v-if="detail!.prev != null" class="nav-item" @click="onNavClick(detail!.prev!)">
                        <text class="nav-label">上一篇</text>
                        <text class="nav-title">{{ detail!.prev!.title }}</text>
                    </view>
                    <view v-if="detail!.next != null" class="nav-item" @click="onNavClick(detail!.next!)">
                        <text class="nav-label">下一篇</text>
                        <text class="nav-title">{{ detail!.next!.title }}</text>
                    </view>
                </view>
            </view>
            <view v-else class="empty-wrap">
                <text class="empty-text">内容不存在</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { goBack } from '../../utils/navigation'
    import { getFeaturedContentDetailApi, viewFeaturedContentApi, openFeaturedDocxApi } from '../../api/featured'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import { parseMarkdown, SUBSET_FEATURED } from '../../utils/markdown'
    import { featuredBodyKind, featuredBodyIssue, featuredBodyHint, featuredDocxFileName } from '../../utils/featuredBody'
    import type { FeaturedContentDetail, FeaturedContentItem, MarkdownBlock } from '../../types/index'
    import { formatDateStr } from '../../utils/format'
    import { collectFeaturedLinks } from '../../utils/featuredLinks'
    import type { FeaturedLink } from '../../utils/featuredLinks'
    import { dispatchExternalLinkTap } from '../../utils/externalLinkDispatch'
    import MarkdownBlocks from '../../components/markdown/markdown-blocks.uvue'

    /**
     * 内容精选面的能力位（#2355 决议 D2 / #2354 D2 同形：常量写在页面脚本里，不散进模板字面量）。
     *
     * 与 `SUBSET_MEMBERS_FEATURED` 的差集只有一处：多一个 `paragraph` —— 它是**段落地板**，
     * 从来没进过解析器那边的声明表，但公共件的 paragraph 分支靠 `cap('paragraph')` 开；
     * 不传这一位，整篇正文只剩标题与列表。这条是两份天然事实，故
     * `markdownContract` 里有一条源守卫钉「每一项 ∈ 声明表 ∪ {paragraph}」。
     *
     * **不传 `table`**：精选档本来就不声明它（三端交集），窄屏里表格按行退回原始文本是既定口径。
     */
    const FEATURED_CAPS : string[] = [
        'heading', 'paragraph', 'code', 'list', 'quote', 'divider', 'image'
    ]

    /** 模板不可直调 import 函数（uvue 模板 import 调用编译为 .invoke() = Kotlin error18，先例 #677）；
     *  本地薄包装消费 utils/format 唯一实现（T03 口径：展示纯函数零第二实现） */
    function displayTime(dateStr : string) : string {
        return formatDateStr(dateStr)
    }

    const windowHeight = uni.getSystemInfoSync().windowHeight

    const contentId = ref<number>(0)
    const detail = ref<FeaturedContentDetail | null>(null)
    const loading = ref<boolean>(true)
    const isFavorited = ref<boolean>(false)
    const favoriteId = ref<number>(0)

    // 内容精选属可信面，但正文子集取**三端交集**（ADR-0046 决定 3）：表格与公式都不渲染，
    // 与 Web `featuredMarked`（表格降级为转义原文）和门户保持一致。故固定走 featured 档。
    const contentBlocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => {
        if (detail.value == null || detail.value!.content.length == 0) return []
        return parseMarkdown(detail.value!.content, SUBSET_FEATURED)
    })

    /**
     * 正文形态（2026-11）：`markdown` / `docx` / `docx-missing` / `empty`。
     * 判定收在 `utils/featuredBody.uts`（纯函数、行为腿真执行）—— 本页不自己做字符串比较，
     * 否则「什么算 docx」会在模板里长成第二处事实。
     */
    const bodyKind = computed<string>(() : string => {
        const d = detail.value
        if (d == null) return ''
        return featuredBodyKind(d!.content_type, d!.content, d!.docx_url)
    })

    /** docx 卡片的文件名（只做展示；空地址由 `bodyKind` 先拦成 docx-missing） */
    const docxFileName = computed<string>(() : string => {
        const d = detail.value
        if (d == null) return ''
        return featuredDocxFileName(d!.docx_url)
    })

    /** 异常形态的可见提示（不许空白；文案的唯一处在 `utils/featuredBody.uts` 的 HINT_*） */
    const bodyHint = computed<string>(() : string => {
        return featuredBodyHint(bodyKind.value)
    })

    const docxOpening = ref<boolean>(false)

    /** docx 正文的出路：「下载原文件 → 交系统打开」。下载动作收在 api 层（页面禁 uni.downloadFile 裸调） */
    async function onOpenDocx() : Promise<void> {
        if (docxOpening.value) return
        const d = detail.value
        if (d == null) return
        docxOpening.value = true
        try {
            const err = await openFeaturedDocxApi(d!.docx_url)
            if (err.length > 0) uni.showToast({ title: err, icon: 'none' })
        } finally {
            docxOpening.value = false
        }
    }

    /** 正文 Markdown 里的外链：按出现顺序、同 URL 去重；协议闸在分词器单点，本页不判协议 */
    const sourceLinks = computed<FeaturedLink[]>(() : FeaturedLink[] => {
        if (detail.value == null) return []
        return collectFeaturedLinks(detail.value!.content)
    })

    /** 确认弹窗 + 按端分叉复用既有编排（移动端 ADR-0025 ⑩-8/⑩-9）；模板不可直调 import ⇒ 本地薄包装 */
    function onOpenLink(url : string) : void {
        dispatchExternalLinkTap(url)
    }

    /**
     * 正文句中链接的落点（#2355 决议 D3）：公共件只把 url 交回来，**编排仍只在本页一处** ——
     * 确认弹窗 + 按端分叉全在 `dispatchExternalLinkTap`（移动端 ADR-0025 ⑩-8/⑩-9）。
     * 公共件因此不持有「离开 app」这件事，四个阅读面共用它时也不会各写一份弹窗。
     */
    function onRunLink(url : string) : void {
        dispatchExternalLinkTap(url)
    }

    async function loadDetail() : Promise<void> {
        // 缺 id / id 非法（脏链接、外部直达）⇒ 直接落「内容不存在」态（模板 v-else）。
        // 不能就这么 return：loading 会永远停在 true，页面卡在「加载中…」——
        // 这正是 #2097 由 ② 门截图暴露的形态（门导航到本页不带 id，截出来是永久加载中）。
        if (contentId.value <= 0) {
            loading.value = false
            return
        }
        loading.value = true
        try {
            const result = await getFeaturedContentDetailApi(contentId.value)
            detail.value = result
            // 正文完整性预警（本票需求 5）：异常只记录 + 已在正文区给可见提示，不阻断阅读
            // （标题 / 元信息 / 收藏仍可用）。文案的唯一处在 `utils/featuredBody.uts` 的 ISSUE_*。
            const issue = featuredBodyIssue(result.content_type, result.content, result.docx_url)
            if (issue.length > 0) {
                console.warn('[featured-detail] 正文完整性异常:', issue, 'content_id=', contentId.value)
            }
            // 增加阅读量（静默）
            viewFeaturedContentApi(contentId.value).catch(() : void => {})
            // 检查收藏状态（静默）
            checkFavoriteApi('featured', contentId.value).then((res) : void => {
                isFavorited.value = res.favorited
                favoriteId.value = res.favorite_id
            }).catch(() : void => {})
        } catch (e) {
            console.error('[featured-detail] load failed:', e)
        } finally {
            loading.value = false
        }
    }

    async function onToggleFavorite() : Promise<void> {
        if (isFavorited.value) {
            // 取消收藏
            if (favoriteId.value <= 0) return
            try {
                await removeFavoriteApi(favoriteId.value)
                isFavorited.value = false
                favoriteId.value = 0
                uni.showToast({ title: '已取消收藏', icon: 'success' })
            } catch (e) {
                uni.showToast({ title: '操作失败', icon: 'none' })
            }
        } else {
            // 添加收藏
            try {
                const result = await addFavoriteApi('featured', contentId.value)
                isFavorited.value = true
                favoriteId.value = result.favorite_id
                uni.showToast({ title: '收藏成功', icon: 'success' })
            } catch (e) {
                uni.showToast({ title: '操作失败', icon: 'none' })
            }
        }
    }

    function onNavClick(item : FeaturedContentItem) : void {
        // 跳转到另一篇文章（用 replace 模式）
        contentId.value = item.content_id
        detail.value = null
        loadDetail()
    }

    function onBack() : void {
        goBack()
    }

    onLoad((_options : any) : void => {
        const opts = _options as UTSJSONObject | null
        const id = opts != null ? opts['id'] : null
        if (id != null) {
            contentId.value = parseInt(id as string)
        }
        loadDetail()
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .fav-btn {
        padding: 8rpx;
    }

    .fav-icon {
        font-size: 40rpx;
    }

    .content-scroll {
        flex: 1;
    }

    .loading-wrap {
        align-items: center;
        padding: 120rpx 0;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .article-wrap {
        background-color: #ffffff;
        padding: 32rpx;
    }

    /* 页面标题区（#2357 决议 D1/D2）：详情页专用类名，与列表卡片的 .article-title 不再同名 ——
       列表卡片（featured-list.uvue）一个字不动，居中规则因此不靠「同名类靠隔离策略兜住」这一层。
       四个值一律引阅读刻度 $md-* 的 h1 档：页面标题区就是正文 h1 档，两者只差对齐（这里居中、
       正文标题恒左对齐）。lines: 3 / text-overflow 保留（D4）：详情页长标题截断有「别把正文
       推下一屏」的作用，且不在这五项统一范围内。
       居中只能落 <text> 的 text-align：写 <view> 上会被渲染层忽略并逐次打 error（uvue-css.md）。 */
    .page-heading {
        font-size: $md-size-h1;
        line-height: $md-line-h1;
        font-weight: $md-weight-heading;
        color: $md-color-text;
        text-align: center;
        lines: 3;
        text-overflow: ellipsis;
        margin-bottom: 16rpx;
    }

    /* 元信息行与标题同轴（justify-content 整行居中）；flex-wrap 本页已有，超宽时换行不溢出 */
    .page-meta {
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 24rpx;
        padding-bottom: 20rpx;
        border-bottom-width: 1rpx;
        border-bottom-color: #f0f0f0;
    }

    .meta-category {
        font-size: 22rpx;
        color: $primary-color;
        background-color: #e8f0fe;
        padding: 4rpx 14rpx;
        border-radius: 8rpx;
        margin-right: 16rpx;
    }

    .meta-text {
        font-size: 24rpx;
        color: #999999;
        margin-right: 16rpx;
    }

    .cover-wrap {
        margin-bottom: 24rpx;
    }

    .cover-img {
        width: 100%;
        border-radius: 12rpx;
    }

    .article-body {
        margin-top: 16rpx;
    }

    /* docx 正文卡片（2026-11）：移动端不做 OOXML 渲染，给出「打开原文档」的唯一下载入口。
       文字类样式一律落 <text>（C1）；<view> 只放布局 / 底色 / 边框。 */
    .docx-card {
        margin-top: 16rpx;
        padding: 32rpx;
        background-color: #f7f8fa;
        border-radius: 12rpx;
        border-width: 1rpx;
        border-color: #e6e8eb;
        align-items: center;
    }

    .docx-badge {
        font-size: 22rpx;
        color: $primary-color;
        background-color: #e8f0fe;
        padding: 4rpx 14rpx;
        border-radius: 8rpx;
        margin-bottom: 16rpx;
    }

    .docx-file {
        font-size: 28rpx;
        color: #333333;
        lines: 2;
        text-overflow: ellipsis;
        text-align: center;
        margin-bottom: 24rpx;
    }

    .docx-btn {
        padding: 18rpx 48rpx;
        background-color: $primary-color;
        border-radius: 44rpx;
        align-items: center;
        justify-content: center;
    }

    .docx-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    .docx-tip {
        font-size: 22rpx;
        color: #999999;
        margin-top: 20rpx;
        text-align: center;
        lines: 2;
    }

    /* 异常正文的可见提示（不许空白）：与空态同色阶，但不占满屏 */
    .body-hint {
        margin-top: 16rpx;
        padding: 48rpx 0;
        align-items: center;
    }

    .body-hint-text {
        font-size: 26rpx;
        color: #999999;
    }

    /* 正文外链段（#2097）：无链接整段不渲染；样式落在 text 上（C1：App 端子节点不继承父样式） */
    .link-section {
        margin-top: 24rpx;
        padding-top: 20rpx;
        border-top-width: 1rpx;
        border-top-color: #f0f0f0;
    }

    .link-title {
        font-size: 24rpx;
        color: #999999;
        margin-bottom: 8rpx;
    }

    .link-item {
        padding: 12rpx 0;
    }

    .link-item-text {
        font-size: 28rpx;
        color: $primary-color;
        lines: 1;
        text-overflow: ellipsis;
    }

    .link-item-host {
        font-size: 22rpx;
        color: #999999;
        margin-top: 4rpx;
    }

    /* 上下篇导航 */
    .nav-section {
        margin-top: 40rpx;
        padding-top: 24rpx;
        border-top-width: 1rpx;
        border-top-color: #f0f0f0;
    }

    .nav-item {
        padding: 20rpx 0;
        border-bottom-width: 1rpx;
        border-bottom-color: #f0f0f0;
    }

    .nav-label {
        font-size: 22rpx;
        color: #999999;
        margin-bottom: 6rpx;
    }

    .nav-title {
        font-size: 28rpx;
        color: $primary-color;
        lines: 1;
        text-overflow: ellipsis;
    }

    .empty-wrap {
        align-items: center;
        padding: 160rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }
</style>
