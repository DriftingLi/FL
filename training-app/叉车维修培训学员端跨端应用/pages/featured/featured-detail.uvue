<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="文章详情" variant="inverse" @left-click="onBack">
            <template #right>
                <view class="fav-btn" @click="onToggleFavorite">
                    <text class="fav-icon">{{ isFavorited ? '⭐' : '☆' }}</text>
                </view>
            </template>
        </app-nav-bar>

        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="loading" class="loading-wrap">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-else-if="detail != null" class="article-wrap">
                <!-- 标题 -->
                <text class="article-title">{{ detail!.title }}</text>
                <!-- 元信息 -->
                <view class="article-meta">
                    <text v-if="detail!.category_label.length > 0" class="meta-category">{{ detail!.category_label }}</text>
                    <text v-if="detail!.source.length > 0" class="meta-text">{{ detail!.source }}</text>
                    <text v-if="detail!.published_at.length > 0" class="meta-text">{{ displayTime(detail!.published_at) }}</text>
                    <text class="meta-text">{{ detail!.view_count }} 阅读</text>
                </view>
                <!-- 封面图 -->
                <view v-if="detail!.cover_image.length > 0" class="cover-wrap">
                    <image class="cover-img" :src="detail!.cover_image" mode="widthFix"></image>
                </view>
                <!-- 正文 Markdown 渲染 -->
                <view class="article-body">
                    <view v-for="(block, idx) in contentBlocks" :key="idx" class="md-block">
                        <text v-if="block.type == 'heading'" class="md-heading" :style="{ fontSize: getHeadingSize(block.level) }"><text v-for="(run, ri) in runsOf(block.text)" :key="ri" :class="runClasses(run, 2, block.level)" @click="onRunTap(run)">{{ runText(run) }}</text></text>
                        <text v-else-if="block.type == 'paragraph'" class="md-paragraph"><text v-for="(run, ri) in runsOf(block.text)" :key="ri" :class="runClasses(run, 0, 0)" @click="onRunTap(run)">{{ runText(run) }}</text></text>
                        <text v-else-if="block.type == 'code'" class="md-code">{{ block.text }}</text>
                        <view v-else-if="block.type == 'list'" class="md-list">
                            <text v-for="(item, itemIdx) in block.items" :key="itemIdx" class="md-list-item"><text class="md-list-bullet">{{ listBullet(block.level, itemIdx) }}</text><text v-for="(run, ri) in runsOf(item)" :key="ri" :class="runClasses(run, 0, 0)" @click="onRunTap(run)">{{ runText(run) }}</text></text>
                        </view>
                        <text v-else-if="block.type == 'quote'" class="md-quote"><text v-for="(run, ri) in runsOf(block.text)" :key="ri" :class="runClasses(run, 1, 0)" @click="onRunTap(run)">{{ runText(run) }}</text></text>
                        <view v-else-if="block.type == 'divider'" class="md-divider"></view>
                        <image v-else-if="block.type == 'image'" class="md-image" :src="block.text" mode="widthFix"></image>
                    </view>
                </view>
                <!-- 正文外链（#2097）：链接由正文 Markdown 承载，`source` 列只作来源名称、不参与判断 -->
                <view v-if="sourceLinks.length > 0" class="link-section">
                    <text class="link-title">参考链接</text>
                    <view v-for="(lnk, lIdx) in sourceLinks" :key="lIdx" class="link-item" @click="onOpenLink(lnk.url)">
                        <text class="link-item-text">{{ lnk.label }}</text>
                        <text class="link-item-host">{{ lnk.host }}</text>
                    </view>
                </view>
                <!-- 上下篇导航 -->
                <view v-if="detail!.prev != null || detail!.next != null" class="nav-section">
                    <view v-if="detail!.prev != null" class="nav-item" @click="onNavClick(detail!.prev!)">
                        <text class="nav-label">上一篇</text>
                        <text class="nav-title">{{ detail!.prev!.title }}</text>
                    </view>
                    <view v-if="detail!.next != null" class="nav-item" @click="onNavClick(detail!.next!)">
                        <text class="nav-label">下一篇</text>
                        <text class="nav-title">{{ detail!.next!.title }}</text>
                    </view>
                </view>
            </view>
            <view v-else class="empty-wrap">
                <text class="empty-text">内容不存在</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
import { goBack } from '../../utils/navigation'
    import { getFeaturedContentDetailApi, viewFeaturedContentApi } from '../../api/featured'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import { parseMarkdown, SUBSET_FEATURED } from '../../utils/markdown'
    import type { FeaturedContentDetail, FeaturedContentItem, MarkdownBlock } from '../../types/index'
    import { formatDateStr } from '../../utils/format'
    import { collectFeaturedLinks } from '../../utils/featuredLinks'
    import type { FeaturedLink } from '../../utils/featuredLinks'
    import { dispatchExternalLinkTap } from '../../utils/externalLinkDispatch'
    import { splitInlineRuns } from '../../utils/markdownInline'
    import type { MarkdownInlineRun } from '../../utils/markdownInline'

    /** 模板不可直调 import 函数（uvue 模板 import 调用编译为 .invoke() = Kotlin error18，先例 #677）；
     *  本地薄包装消费 utils/format 唯一实现（T03 口径：展示纯函数零第二实现） */
    function displayTime(dateStr : string) : string {
        return formatDateStr(dateStr)
    }

    const windowHeight = uni.getSystemInfoSync().windowHeight

    const contentId = ref<number>(0)
    const detail = ref<FeaturedContentDetail | null>(null)
    const loading = ref<boolean>(true)
    const isFavorited = ref<boolean>(false)
    const favoriteId = ref<number>(0)

    // 内容精选属可信面，但正文子集取**三端交集**（ADR-0046 决定 3）：表格与公式都不渲染，
    // 与 Web `featuredMarked`（表格降级为转义原文）和门户保持一致。故固定走 featured 档。
    const contentBlocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => {
        if (detail.value == null || detail.value!.content.length == 0) return []
        return parseMarkdown(detail.value!.content, SUBSET_FEATURED)
    })

    /** 正文 Markdown 里的外链：按出现顺序、同 URL 去重；协议闸在分词器单点，本页不判协议 */
    const sourceLinks = computed<FeaturedLink[]>(() : FeaturedLink[] => {
        if (detail.value == null) return []
        return collectFeaturedLinks(detail.value!.content)
    })

    /** 确认弹窗 + 按端分叉复用既有编排（移动端 ADR-0025 ⑩-8/⑩-9）；模板不可直调 import ⇒ 本地薄包装 */
    function onOpenLink(url : string) : void {
        dispatchExternalLinkTap(url)
    }

    /** 正文行内 runs（ADR-0025 ⑩-2 口径，#2124 起精选面也走）：分词器是唯一实现，此处只是模板可调的薄包装
     *  （模板不可直调 import 函数 —— uvue 编译成 .invoke() 即 Kotlin error18，先例 #677）。 */
    const runsOf = (src : string) : MarkdownInlineRun[] => splitInlineRuns(src)

    /** 列表符号（⑩-3 / ⑩-4）：有序档由 `level` 槽判定，编号一律从 1 起；无序沿用本页原有 `·` */
    function listBullet(level : number, idx : number) : string {
        if (level == 1) return (idx + 1).toString() + '. '
        return '· '
    }

    /**
     * C1：App 端**子 `<text>` 不继承父样式** ⇒ 每条 run 自带字号字色行高，再叠样式位。
     * 第二参 = 块上下文（0 正文 / 1 引用 / 2 标题），第三参 = 标题级数（字号与 getHeadingSize 同表）。
     * ⚠️ UTS 匿名函数不允许参数默认值（论坛面实测）⇒ 所有调用点显式传满三参。
     * 顺序即优先级：基线 → 块覆盖 → 样式位（uvue 只认同权重后来者）。
     */
    const runClasses = (run : MarkdownInlineRun, kind : number, level : number) : string[] => {
        const cls : string[] = ['md-run']
        if (kind == 1) cls.push('md-run-q')
        else if (kind == 2) {
            if (level <= 1) cls.push('md-run-h1')
            else if (level == 2) cls.push('md-run-h2')
            else if (level == 3) cls.push('md-run-h3')
            else cls.push('md-run-h4')
        }
        if (run.bold) cls.push('md-run-b')
        if (run.italic) cls.push('md-run-i')
        if (run.strike) cls.push('md-run-s')
        if (run.code) cls.push('md-run-c')
        if (run.link.length > 0) cls.push('md-run-l')
        return cls
    }

    /** C3：行内代码不写 padding / margin（子 text 上不生效），胶囊感靠 background + 前后字符空格 */
    const runText = (run : MarkdownInlineRun) : string => run.code ? ' ' + run.text + ' ' : run.text

    /** ⑩-8：句中链接点击委托既有编排（确认弹窗 + 按端分叉）；link 为空 = 普通文字，不弹窗 */
    const onRunTap = (run : MarkdownInlineRun) : void => {
        if (run.link.length > 0) dispatchExternalLinkTap(run.link)
    }

    function getHeadingSize(level : number) : string {
        if (level == 1) return '38rpx'
        if (level == 2) return '34rpx'
        if (level == 3) return '30rpx'
        return '28rpx'
    }

    async function loadDetail() : Promise<void> {
        // 缺 id / id 非法（脏链接、外部直达）⇒ 直接落「内容不存在」态（模板 v-else）。
        // 不能就这么 return：loading 会永远停在 true，页面卡在「加载中…」——
        // 这正是 #2097 由 ② 门截图暴露的形态（门导航到本页不带 id，截出来是永久加载中）。
        if (contentId.value <= 0) {
            loading.value = false
            return
        }
        loading.value = true
        try {
            const result = await getFeaturedContentDetailApi(contentId.value)
            detail.value = result
            // 增加阅读量（静默）
            viewFeaturedContentApi(contentId.value).catch(() : void => {})
            // 检查收藏状态（静默）
            checkFavoriteApi('featured', contentId.value).then((res) : void => {
                isFavorited.value = res.favorited
                favoriteId.value = res.favorite_id
            }).catch(() : void => {})
        } catch (e) {
            console.error('[featured-detail] load failed:', e)
        } finally {
            loading.value = false
        }
    }

    async function onToggleFavorite() : Promise<void> {
        if (isFavorited.value) {
            // 取消收藏
            if (favoriteId.value <= 0) return
            try {
                await removeFavoriteApi(favoriteId.value)
                isFavorited.value = false
                favoriteId.value = 0
                uni.showToast({ title: '已取消收藏', icon: 'success' })
            } catch (e) {
                uni.showToast({ title: '操作失败', icon: 'none' })
            }
        } else {
            // 添加收藏
            try {
                const result = await addFavoriteApi('featured', contentId.value)
                isFavorited.value = true
                favoriteId.value = result.favorite_id
                uni.showToast({ title: '收藏成功', icon: 'success' })
            } catch (e) {
                uni.showToast({ title: '操作失败', icon: 'none' })
            }
        }
    }

    function onNavClick(item : FeaturedContentItem) : void {
        // 跳转到另一篇文章（用 replace 模式）
        contentId.value = item.content_id
        detail.value = null
        loadDetail()
    }

    function onBack() : void {
        goBack()
    }

    onLoad((_options : any) : void => {
        const opts = _options as UTSJSONObject | null
        const id = opts != null ? opts['id'] : null
        if (id != null) {
            contentId.value = parseInt(id as string)
        }
        loadDetail()
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .fav-btn {
        padding: 8rpx;
    }

    .fav-icon {
        font-size: 40rpx;
    }

    .content-scroll {
        flex: 1;
    }

    .loading-wrap {
        align-items: center;
        padding: 120rpx 0;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .article-wrap {
        background-color: #ffffff;
        padding: 32rpx;
    }

    .article-title {
        font-size: 38rpx;
        font-weight: bold;
        color: #333333;
        lines: 3;
        text-overflow: ellipsis;
        margin-bottom: 16rpx;
    }

    .article-meta {
        flex-direction: row;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 24rpx;
        padding-bottom: 20rpx;
        border-bottom-width: 1rpx;
        border-bottom-color: #f0f0f0;
    }

    .meta-category {
        font-size: 22rpx;
        color: #2979ff;
        background-color: #e8f0fe;
        padding: 4rpx 14rpx;
        border-radius: 8rpx;
        margin-right: 16rpx;
    }

    .meta-text {
        font-size: 24rpx;
        color: #999999;
        margin-right: 16rpx;
    }

    .cover-wrap {
        margin-bottom: 24rpx;
    }

    .cover-img {
        width: 100%;
        border-radius: 12rpx;
    }

    .article-body {
        margin-top: 16rpx;
    }

    .md-block {
        margin-bottom: 16rpx;
    }

    .md-heading {
        font-weight: bold;
        color: #333333;
        margin-bottom: 12rpx;
        margin-top: 8rpx;
    }

    .md-paragraph {
        font-size: 28rpx;
        color: #555555;
        line-height: 44rpx;
    }

    .md-code {
        font-size: 24rpx;
        color: #333333;
        background-color: #f5f5f5;
        padding: 16rpx 20rpx;
        border-radius: 8rpx;
        font-family: monospace;
    }

    .md-list {
        flex-direction: column;
        padding-left: 12rpx;
    }

    .md-list-item {
        font-size: 28rpx;
        color: #555555;
        line-height: 44rpx;
    }

    .md-quote {
        font-size: 26rpx;
        color: #888888;
        border-left-width: 6rpx;
        border-left-color: #2979ff;
        padding-left: 20rpx;
        margin: 8rpx 0;
        line-height: 40rpx;
    }

    .md-divider {
        height: 2rpx;
        background-color: #eeeeee;
        margin: 20rpx 0;
    }

    .md-image {
        width: 100%;
        border-radius: 8rpx;
        margin: 8rpx 0;
    }

    /* ── 行内 run（ADR-0025 ⑩-2；C1–C4 的落点；#2124 起精选正文也走 runs）──────────────
       每条 run 自带字号 / 字色 / 行高：App 端子 `<text>` **不继承**父组件样式（C1）。
       基线取本页正文（28rpx / #555555 / 44rpx）；引用与标题由下面的覆盖条改尺寸。 */
    .md-run {
        font-size: 28rpx;
        color: #555555;
        line-height: 44rpx;
    }

    .md-run-b {
        font-weight: bold;
    }

    .md-run-i {
        font-style: italic;
    }

    /* C2：只写长形态 —— `text-decoration` 简写在 app 端不支持，值域只有 underline / line-through / overline / none */
    .md-run-s {
        text-decoration-line: line-through;
    }

    .md-run-l {
        color: #2979ff;
        text-decoration-line: underline;
    }

    /* C3：行内代码不写 padding / margin / width / display（子 text 上不生效），胶囊感靠 background + 模板前后空格；
       C4：等宽只给单一 monospace，不写逗号回退列表。 */
    .md-run-c {
        font-family: monospace;
        background-color: #f0f0f0;
        color: #333333;
    }

    /* 引用块内的 run：父级样式带不下来，由 runClasses 的第二参显式传入（不靠 CSS 级联） */
    .md-run-q {
        font-size: 26rpx;
        color: #888888;
        line-height: 40rpx;
    }

    /* 标题内的 run：字号与 getHeadingSize 同表，否则子 run 缩成正文尺寸（C1） */
    .md-run-h1 {
        font-size: 38rpx;
        color: #333333;
        font-weight: bold;
    }

    .md-run-h2 {
        font-size: 34rpx;
        color: #333333;
        font-weight: bold;
    }

    .md-run-h3 {
        font-size: 30rpx;
        color: #333333;
        font-weight: bold;
    }

    .md-run-h4 {
        font-size: 28rpx;
        color: #333333;
        font-weight: bold;
    }

    /* 列表符号同样是子 text（C1）：自带字号字色，符号·间距由字符本身撑开 */
    .md-list-bullet {
        font-size: 28rpx;
        color: #2979ff;
        line-height: 44rpx;
    }
    /* 正文外链段（#2097）：无链接整段不渲染；样式落在 text 上（C1：App 端子节点不继承父样式） */
    .link-section {
        margin-top: 24rpx;
        padding-top: 20rpx;
        border-top-width: 1rpx;
        border-top-color: #f0f0f0;
    }

    .link-title {
        font-size: 24rpx;
        color: #999999;
        margin-bottom: 8rpx;
    }

    .link-item {
        padding: 12rpx 0;
    }

    .link-item-text {
        font-size: 28rpx;
        color: #2979ff;
        lines: 1;
        text-overflow: ellipsis;
    }

    .link-item-host {
        font-size: 22rpx;
        color: #999999;
        margin-top: 4rpx;
    }

    /* 上下篇导航 */
    .nav-section {
        margin-top: 40rpx;
        padding-top: 24rpx;
        border-top-width: 1rpx;
        border-top-color: #f0f0f0;
    }

    .nav-item {
        padding: 20rpx 0;
        border-bottom-width: 1rpx;
        border-bottom-color: #f0f0f0;
    }

    .nav-label {
        font-size: 22rpx;
        color: #999999;
        margin-bottom: 6rpx;
    }

    .nav-title {
        font-size: 28rpx;
        color: #2979ff;
        lines: 1;
        text-overflow: ellipsis;
    }

    .empty-wrap {
        align-items: center;
        padding: 160rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }
</style>