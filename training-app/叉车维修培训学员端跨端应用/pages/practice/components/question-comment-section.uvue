        font-size: 30rpx;
        color: #333333;
        font-weight: 600;
    }
    .qcm-action { padding: 8rpx 16rpx; }
    .qcm-action-text { font-size: 24rpx; color: #2979ff; }
    .qcm-item {
        padding: 20rpx 0;
        border-bottom: 1rpx solid #f5f5f5;
        flex-direction: column;
    }
    .qcm-head {
        flex-direction: row;
        align-items: center;
        margin-bottom: 12rpx;
    }
    .qcm-author {
        font-size: 26rpx;
        color: #333333;
        font-weight: 500;
        margin-right: 16rpx;
    }
    .qcm-time {
        font-size: 22rpx;
        color: #cccccc;
        flex: 1;
    }
    .qcm-delete {
        padding: 6rpx 16rpx;
        border: 1rpx solid #f44336;
        border-radius: 8rpx;
    }
    .qcm-delete-text { font-size: 22rpx; color: #f44336; }
    .qcm-content {
        font-size: 28rpx;
        color: #666666;
        line-height: 42rpx;
    }
    .qcm-empty-wrap { padding: 20rpx 0; align-items: center; }
    .qcm-empty-text { font-size: 26rpx; color: #cccccc; }
    .qcm-input-bar {
        flex-direction: row;
        align-items: center;
        margin-top: 16rpx;
    }
    .qcm-input {
        flex: 1;
        height: 72rpx;
        background-color: #f5f5f5;
        border-radius: 36rpx;
        padding: 0 28rpx;
        font-size: 26rpx;
        color: #333333;
    }
    .qcm-send-btn {
        margin-left: 16rpx;
        padding: 16rpx 28rpx;
        border-radius: 36rpx;
        background-color: #e0e0e0;
    }
    .qcm-send-active { background-color: #2979ff; }
    .qcm-send-text {
        font-size: 26rpx;
        color: #ffffff;
        font-weight: 500;
    }
</style>