<template>
    <!-- 数据统计栏（蓝色渐变）：数据源 /practice-mode/practice-stats ——T06 手术自 practice.uvue 逐段搬出 -->
    <view class="stat-bar">
        <view class="stat-item">
            <text class="stat-num">{{ todayCount }}</text>
            <text class="stat-label">今日做题</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
            <text class="stat-num">{{ totalCount }}</text>
            <text class="stat-label">累计做题</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
            <text class="stat-num">{{ totalDays }}</text>
            <text class="stat-label">累计天数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" @click="onReportClick">
            <view class="stat-report-wrap">
                <text class="stat-report-text">数据报告</text>
                <text class="stat-report-arrow">›</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    // 对象 prop 扁平化为原始 props（ADR-0007 规则 N/P，全仓先例）
    const props = withDefaults(defineProps<{
        todayCount? : number
        totalCount? : number
        totalDays? : number
    }>(), {
        todayCount: 0,
        totalCount: 0,
        totalDays: 0
    })

    const emit = defineEmits(['reportClick'])

    function onReportClick() : void {
        emit('reportClick')
    }
</script>

