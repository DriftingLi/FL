         前两格数字绿（#14AE50 实测）、天数格蓝、数据报告深字带箭头 -->
    <view class="stat-bar">
        <view class="stat-card">
            <text class="stat-num stat-num-success">{{ todayCount }}</text>
            <text class="stat-label">今日做题</text>
        </view>
        <view class="stat-card">
            <text class="stat-num stat-num-success">{{ totalCount }}</text>
            <text class="stat-label">累计做题</text>
        </view>
        <view class="stat-card">
            <text class="stat-num stat-num-primary">{{ totalDays }}</text>
