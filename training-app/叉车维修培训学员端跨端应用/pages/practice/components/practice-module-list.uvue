        border-radius: 20rpx;
    }

    .skeleton-item {
        padding: 24rpx 28rpx;
        flex-direction: row;
        align-items: center;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .skeleton-content {
        flex: 1;
        flex-direction: column;
    }

    .skeleton-line {
        background-color: #f0f0f0;
        border-radius: 8rpx;
        margin-bottom: 12rpx;
    }

    .skeleton-line-title {
        width: 60%;
        height: 28rpx;
    }

    .skeleton-line-sub {
        width: 40%;
        height: 20rpx;
    }

    .skeleton-arrow {
        width: 24rpx;
        height: 24rpx;
        background-color: #f0f0f0;
        border-radius: 4rpx;
        margin-left: 16rpx;
    }

    /* ===== 错误态 ===== */
    .error-state {
        margin: 0 24rpx;
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 80rpx 0;
        flex-direction: column;
        align-items: center;
    }

    .error-icon {
        font-size: 64rpx;
        margin-bottom: 16rpx;
    }

    .error-text {
        font-size: 28rpx;
        color: #999999;
        margin-bottom: 24rpx;
    }

    .error-btn {
