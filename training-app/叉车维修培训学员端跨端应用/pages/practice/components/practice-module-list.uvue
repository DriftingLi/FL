        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .module-icon-text {
        font-size: 30rpx;
        color: #2979ff;
        font-weight: bold;
    }

    .module-info {
        flex: 1;
        flex-direction: column;
    }

    .module-name {
        font-size: 30rpx;
        color: #333333;
        font-weight: 600;
    }

    .module-meta {
        font-size: 24rpx;
        color: #999999;
        margin-top: 8rpx;
    }

    .module-arrow {
        font-size: 36rpx;
        color: #cccccc;
