<template>
    <!-- 模块练习列表（标签专项） ——T06 手术自 practice.uvue 逐段搬出；B3（#2519）按原型 473:4247 收口 -->
    <view class="module-section">
        <!-- 骨架屏 -->
        <view v-if="loading && modules.length == 0" class="skeleton-list">
            <view v-for="i in 4" :key="i" class="skeleton-item">
                <view class="skeleton-content">
                    <view class="skeleton-line skeleton-line-title"></view>
                    <view class="skeleton-line skeleton-line-sub"></view>
                </view>
                <view class="skeleton-arrow"></view>
            </view>
        </view>

        <!-- 错误态 -->
        <view v-else-if="error.length > 0 && modules.length == 0" class="error-state" @click="onRetry">
            <text class="error-icon">⚠️</text>
            <text class="error-text">{{ error }}</text>
            <view class="error-btn">
                <text class="error-btn-text">点击重试</text>
            </view>
        </view>

        <!-- 空状态 -->
        <view v-else-if="modules.length == 0" class="empty-state">
            <text class="empty-icon">📭</text>
            <text class="empty-text">暂无题库标签</text>
        </view>

        <!-- 模块列表 -->
        <view v-else class="module-list">
            <view v-for="(m, idx) in modules" :key="m.tag_id" class="module-card" @click="onModuleClick(m)">
                <view class="module-icon">
                    <text class="module-icon-text">›</text>
                </view>
                <view class="module-info">
                    <text class="module-name">{{ m.name }}</text>
                    <text class="module-meta">{{ moduleMeta(m) }}</text>
                </view>
                <text class="module-arrow">›</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import type { ModuleRow } from '../composables/usePracticeOverview'
    import { moduleMetaText } from '../../../utils/practiceModuleDisplay'

    const props = withDefaults(defineProps<{
        loading? : boolean
        error? : string
        modules? : ModuleRow[]
    }>(), {
        loading: false,
        error: '',
        modules: () => [] as ModuleRow[]
    })

    const emit = defineEmits(['retry', 'moduleClick'])

    /** 模块行副标题（#1948 摘 mock）：正确率来自 by_tag，文案唯一实现在 utils/practiceModuleDisplay.uts */
    function moduleMeta(m : ModuleRow) : string {
        return moduleMetaText(m.completed, m.total, m.accuracy, m.has_accuracy)
    }

    function onRetry() : void {
        emit('retry')
    }

    function onModuleClick(m : ModuleRow) : void {
        emit('moduleClick', m)
    }
</script>

<style lang="scss">
    .module-section {
        flex-direction: column;
    }

    .module-list {
        padding: 0 24rpx;
        flex-direction: column;
    }

    .module-card {
        background-color: $card-bg;
        border-radius: $radius-card;
        padding: 28rpx;
        margin-bottom: 20rpx;
        flex-direction: row;
        align-items: center;
    }

    .module-icon {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        border: 3rpx solid $primary-color;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .module-icon-text {
        font-size: 30rpx;
        color: $primary-color;
        font-weight: bold;
    }

    .module-info {
        flex: 1;
        flex-direction: column;
    }

    .module-name {
        font-size: 30rpx;
        color: $text-color;
        font-weight: 600;
    }

    .module-meta {
        font-size: 24rpx;
        color: $text-color-secondary;
        margin-top: 8rpx;
    }

    .module-arrow {
        font-size: 36rpx;
        color: $text-disabled;
        margin-left: 12rpx;
    }

    /* ===== 骨架屏 ===== */
    .skeleton-list {
        margin: 0 24rpx;
        background-color: $card-bg;
        border-radius: $radius-card;
    }

    .skeleton-item {
        padding: 24rpx 28rpx;
        flex-direction: row;
        align-items: center;
        border-bottom: 1rpx solid $border-color-light;
    }

    .skeleton-content {
        flex: 1;
        flex-direction: column;
    }

    .skeleton-line {
        background-color: $border-color-light;
        border-radius: $radius-sm;
        margin-bottom: 12rpx;
    }

    .skeleton-line-title {
        width: 60%;
        height: 28rpx;
    }

    .skeleton-line-sub {
        width: 40%;
        height: 20rpx;
    }

    .skeleton-arrow {
        width: 24rpx;
        height: 24rpx;
        background-color: $border-color-light;
        border-radius: 4rpx;
        margin-left: 16rpx;
    }

    /* ===== 错误态 ===== */
    .error-state {
        margin: 0 24rpx;
        background-color: $card-bg;
        border-radius: $radius-card;
        padding: 80rpx 0;
        flex-direction: column;
        align-items: center;
    }

    .error-icon {
        font-size: 64rpx;
        margin-bottom: 16rpx;
    }

    .error-text {
        font-size: 28rpx;
        color: $text-color-placeholder;
        margin-bottom: 24rpx;
    }

    /* 主 CTA 渐变（#2509 冲突 9）：重试钮随批换渐变，兜底色写在简写之后 */
    .error-btn {
        background: linear-gradient(to right, $primary-grad-start, $primary-grad-end);
        background-color: $primary-grad-start;
        border-radius: $radius-pill;
        padding: 12rpx 40rpx;
    }

    .error-btn-text {
        font-size: 26rpx;
        color: $text-color-inverse;
    }

    /* ===== 空状态 ===== */
    .empty-state {
        margin: 0 24rpx;
        background-color: $card-bg;
        border-radius: $radius-card;
        padding: 80rpx 0;
        flex-direction: column;
        align-items: center;
    }

    .empty-icon {
        font-size: 64rpx;
        margin-bottom: 16rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: $text-color-placeholder;
    }
</style>
