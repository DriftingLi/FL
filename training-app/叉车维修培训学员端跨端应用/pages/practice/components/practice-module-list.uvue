<template>
    <!-- 模块练习列表 -->
    <view>
        <!-- 骨架屏 -->
        <view v-if="loading && modules.length == 0" class="pm-skeleton-list">
            <view v-for="i in 4" :key="i" class="pm-skeleton-item">
                <view class="pm-skeleton-content">
                    <view class="pm-skeleton-line pm-skeleton-line-title"></view>
                    <view class="pm-skeleton-line pm-skeleton-line-sub"></view>
                </view>
                <view class="pm-skeleton-arrow"></view>
            </view>
        </view>

        <!-- 错误态 -->
        <view v-else-if="error.length > 0 && modules.length == 0" class="pm-error-state" @click="onRetry">
            <text class="pm-error-icon">⚠️</text>
            <text class="pm-error-text">{{ error }}</text>
            <view class="pm-error-btn">
                <text class="pm-error-btn-text">点击重试</text>
            </view>
        </view>

        <!-- 空状态 -->
        <view v-else-if="modules.length == 0" class="pm-empty-state">
            <text class="pm-empty-icon">📭</text>
            <text class="pm-empty-text">暂无题库标签</text>
        </view>

        <!-- 列表 -->
        <view v-else class="pm-list">
            <view v-for="(m, idx) in modules" :key="m.tag_id" class="pm-card" @click="onModuleClick(m)">
                <view class="pm-icon">
                    <text class="pm-icon-text">›</text>
                </view>
                <view class="pm-info">
                    <text class="pm-name">{{ m.name }}</text>
                    <text class="pm-meta">{{ moduleMeta(m) }}</text>
                </view>
                <text class="pm-arrow">›</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type ModuleRow = {
        tag_id : number
        name : string
        total : number
        completed : number
    }

    const props = defineProps<{
        loading : boolean
        error : string
        modules : ModuleRow[]
    }>()

    const emit = defineEmits<{
        (e : 'retry') : void
        (e : 'module-click', m : ModuleRow) : void
    }>()

    function mockAccuracy(tagId : number) : number {
        return 60 + (tagId * 13) % 35
    }

    function moduleMeta(m : ModuleRow) : string {
        if (m.completed > 0) {
            return '已完成 ' + m.completed.toString() + '/' + m.total.toString() + ' 正确率 ' + mockAccuracy(m.tag_id).toString() + '%'
        }
        if (m.total > 0) {
            return '共 ' + m.total.toString() + ' 题'
        }
        return '暂无题目'
    }

    function onRetry() : void {
        emit('retry')
    }

    function onModuleClick(m : ModuleRow) : void {
        emit('module-click', m)
    }
</script>

<style>
    .pm-skeleton-list {
        margin: 0 24rpx;
        background-color: #ffffff;
        border-radius: 20rpx;
    }
    .pm-skeleton-item {
        padding: 24rpx 28rpx;
        flex-direction: row;
        align-items: center;
        border-bottom: 1rpx solid #f5f5f5;
    }
    .pm-skeleton-content {
        flex: 1;
        flex-direction: column;
    }
    .pm-skeleton-line {
        background-color: #f0f0f0;
        border-radius: 8rpx;
        margin-bottom: 12rpx;
    }
    .pm-skeleton-line-title { width: 60%; height: 28rpx; }
    .pm-skeleton-line-sub { width: 40%; height: 20rpx; }
    .pm-skeleton-arrow {
        width: 24rpx;
        height: 24rpx;
        background-color: #f0f0f0;
        border-radius: 4rpx;
        margin-left: 16rpx;
    }
    .pm-error-state {
        margin: 0 24rpx;
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 80rpx 0;
        flex-direction: column;
        align-items: center;
    }
    .pm-error-icon { font-size: 64rpx; margin-bottom: 16rpx; }
    .pm-error-text { font-size: 28rpx; color: #999999; margin-bottom: 24rpx; }
    .pm-error-btn {
        background-color: #2979ff;
        border-radius: 12rpx;
        padding: 12rpx 40rpx;
    }
    .pm-error-btn-text { font-size: 26rpx; color: #ffffff; }
    .pm-empty-state {
        margin: 0 24rpx;
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 80rpx 0;
        flex-direction: column;
        align-items: center;
    }
    .pm-empty-icon { font-size: 64rpx; margin-bottom: 16rpx; }
    .pm-empty-text { font-size: 28rpx; color: #999999; }
    .pm-list {
        padding: 0 24rpx;
        flex-direction: column;
    }
    .pm-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 28rpx;
        margin-bottom: 20rpx;
        flex-direction: row;
        align-items: center;
    }
    .pm-icon {
        width: 52rpx;
        height: 52rpx;
        border-radius: 26rpx;
        border: 3rpx solid #2979ff;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }
    .pm-icon-text { font-size: 30rpx; color: #2979ff; font-weight: bold; }
    .pm-info { flex: 1; flex-direction: column; }
    .pm-name { font-size: 30rpx; color: #333333; font-weight: 600; }
    .pm-meta { font-size: 24rpx; color: #999999; margin-top: 8rpx; }
    .pm-arrow { font-size: 36rpx; color: #cccccc; margin-left: 12rpx; }
</style>