<template>
    <!-- 结果汇总弹窗 -->
    <view v-if="visible" class="sm-mask">
        <view class="sm-box">
            <text class="sm-title">练习完成</text>
            <view class="sm-stats">
                <view class="sm-stat">
                    <text class="sm-stat-num">{{ totalCount }}</text>
                    <text class="sm-stat-label">总题数</text>
                </view>
                <view class="sm-stat">
                    <text class="sm-stat-num sm-correct">{{ correctCount }}</text>
                    <text class="sm-stat-label">答对</text>
                </view>
                <view class="sm-stat">
                    <text class="sm-stat-num sm-wrong">{{ totalCount - correctCount }}</text>
                    <text class="sm-stat-label">答错</text>
                </view>
                <view class="sm-stat">
                    <text class="sm-stat-num">{{ accuracy }}%</text>
                    <text class="sm-stat-label">正确率</text>
                </view>
            </view>
            <view class="sm-actions">
                <view class="sm-btn sm-btn-secondary" @click="onExit">
                    <text class="sm-btn-secondary-text">返回</text>
                </view>
                <view class="sm-btn sm-btn-primary" @click="onRestart">
                    <text class="sm-btn-primary-text">再练一次</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    const props = defineProps<{
        visible : boolean
        totalCount : number
        correctCount : number
        accuracy : number
    }>()

    const emit = defineEmits<{
        (e : 'exit') : void
        (e : 'restart') : void
    }>()

    function onExit() : void {
        emit('exit')
    }

    function onRestart() : void {
        emit('restart')
    }
</script>

