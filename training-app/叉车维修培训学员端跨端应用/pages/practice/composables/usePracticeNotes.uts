/**
 * practice-do 笔记交互 composable（T06 practice 手术，parent #644）
 */
import { ref } from 'vue'
import { getNoteApi, saveNoteApi, deleteNoteApi } from '../../../api/questionInteraction'

export function usePracticeNotes() {
    const showNote = ref<boolean>(false)
    const noteContent = ref<string>('')
    let noteSaveTimer : number | null = null

    async function loadNote(questionId : number) : Promise<void> {
        if (questionId <= 0) return
        try { const note = await getNoteApi(questionId); noteContent.value = note.content }
        catch (e) { console.warn('[practice-do] loadNote failed:', e) }
    }

    function toggleNote(questionId : number) : void { showNote.value = !showNote.value; if (showNote.value) { loadNote(questionId) } }

    function onSaveNote(questionId : number) : void {
        if (questionId <= 0) return
        const nt = noteSaveTimer; if (nt != null) clearTimeout(nt)
        noteSaveTimer = setTimeout(() => { saveNoteApi(questionId, noteContent.value).catch((e) => { console.warn('[practice-do] saveNote failed:', e) }) }, 500)
    }

    function onDeleteNote(questionId : number) : void {
        uni.showModal({ title: '提示', content: '确定删除这条笔记吗？',
            success: (res) => { if (res.confirm) { deleteNoteApi(questionId).then(() => { noteContent.value = ''; showNote.value = false; uni.showToast({ title: '笔记已删除', icon: 'none' }) }).catch((e) => { console.warn('[practice-do] deleteNote failed:', e) }) } }
        })
    }

    function resetNotes() : void { showNote.value = false; noteContent.value = '' }

    return {
        showNote,
        noteContent,
        loadNote: (questionId : number) => loadNote(questionId),
        toggleNote: (questionId : number) => toggleNote(questionId),
        onSaveNote: (questionId : number) => onSaveNote(questionId),
        onDeleteNote: (questionId : number) => onDeleteNote(questionId),
        resetNotes: () => resetNotes()
    }
}