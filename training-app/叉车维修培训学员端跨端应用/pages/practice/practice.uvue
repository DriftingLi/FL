<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="题库练习" @left-click="onBack" divider>
    <template #right><text class="nav-icon" @click="onSearch">🔍</text></template>
</app-nav-bar>
        <view class="region-bar">
            <view class="region-left" @click="onRegionTap">
                <text class="region-text">{{ region }}</text>
                <text class="region-arrow">∨</text>
            </view>
        </view>
        <scroll-view class="scroll-content" scroll-y="true" :refresher-enabled="true" :refresher-triggered="isRefreshing" @refresherrefresh="onRefresh">
            <PracticeBannerCard />
            <PracticeStatsBar :today-count="overview.today_count" :total-count="overview.total_count" :total-days="overview.total_days" @report-click="onReportClick" />
            <PracticeFeatureGrid @feature-click="onFeatureClick" />
            <PracticeModuleList :loading="listLoading" :error="listError" :modules="modules" @retry="loadModules" @module-click="onModuleClick" />
            <view class="safe-bottom"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { goBack } from '../../utils/navigation'
    import { usePracticeOverview, type ModuleRow } from './composables/usePracticeOverview'
    import PracticeBannerCard from './components/practice-banner-card.uvue'
    import PracticeStatsBar from './components/practice-stats-bar.uvue'
    import PracticeFeatureGrid from './components/practice-feature-grid.uvue'
    import PracticeModuleList from './components/practice-module-list.uvue'
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const { overview, modules, listLoading, listError, loadOverview, loadModules, loadTagAccuracy } = usePracticeOverview()
    const region = ref<string>('全国')
    const regionOptions : string[] = ['全国', '北京', '上海', '广东', '浙江', '江苏', '山东', '四川', '湖北', '湖南', '河南']
    const isRefreshing = ref<boolean>(false)

    function onRegionTap() : void { uni.showActionSheet({ itemList: regionOptions, success: (res) => { region.value = regionOptions[res.tapIndex] } }) }
    function onBack() : void { goBack() }
    function onSearch() : void { uni.navigateTo({ url: '/pages/search/search' }) }
    function onReportClick() : void { uni.navigateTo({ url: '/pages/practice/practice-report' }) }
    function onModuleClick(m : ModuleRow) : void { uni.navigateTo({ url: '/pages/practice/practice-do?mode=tag&tag_id=' + m.tag_id.toString() + '&tag_name=' + encodeURIComponent(m.name) }) }
    function onFeatureClick(feature : string) : void {
        if (feature == 'past_paper') { uni.showToast({ title: '历年真题开发中', icon: 'none' }) }
        else if (feature == 'mock_exam') { uni.navigateTo({ url: '/pages/exam/mock-exam' }) }
        // #810：等级考试域已退役；本格视觉与 feature key 保持不变，改指既有模拟考试链路
        else if (feature == 'level_exam') { uni.navigateTo({ url: '/pages/exam/mock-exam' }) }
        else if (feature == 'wrong_question') { uni.navigateTo({ url: '/pages/profile/wrong-questions' }) }
    }
    async function onRefresh() : Promise<void> { isRefreshing.value = true; await loadOverview(); await loadModules(); isRefreshing.value = false }
    // 做题回本页（#1948）：模块已装载时只补一次正确率（单请求），不重跑标签与逐标签进度面
    onShow(() => { loadOverview(); if (modules.value.length == 0) { loadModules() } else { loadTagAccuracy() } })
</script>

<style lang="scss">
    .page { display: flex; flex-direction: column; background-color: $bg-color; }
    .scroll-content { flex: 1; height: 0; }
    .region-bar { background-color: $card-bg; padding: 8rpx 24rpx 20rpx; flex-direction: row; align-items: center; }
    .region-left { flex-direction: row; align-items: center; background-color: #f5f6fa; border-radius: 24rpx; padding: 8rpx 20rpx; }
    .region-text { font-size: 26rpx; color: $text-color; }
    .region-arrow { font-size: 20rpx; color: $text-color-placeholder; margin-left: 8rpx; }
    .safe-bottom { height: 34rpx; }
</style>