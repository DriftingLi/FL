        overflow: hidden;
    }

    .question-meta {
        flex-direction: row;
        align-items: center;
    }

    .question-status {
        font-size: 24rpx;
        color: #999999;
    }

    .question-status-space {
        width: 16rpx;
    }

    .question-arrow {
        font-size: 36rpx;
        color: #cccccc;
        margin-left: 12rpx;
    }

    /* ===== 标签练习 ===== */
    .tags-section {
        margin: 0 24rpx 24rpx 24rpx;
        background-color: #ffffff;
        border-radius: 20rpx;
