    }

    .banner-tag {
        font-size: 20rpx;
        color: #ffffff;
        background-color: rgba(41, 121, 255, 0.7);
        padding: 6rpx 16rpx;
        border-radius: 8rpx;
        text-align: center;
    }

    /* ===== 数据统计栏 ===== */
    .stat-bar {
        margin: 0 24rpx 24rpx 24rpx;
        background: linear-gradient(135deg, #4facfe 0%, #2979ff 100%);
        border-radius: 20rpx;
        padding: 24rpx 0;
        flex-direction: row;
        align-items: center;
        justify-content: space-around;
    }

    .stat-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
    }

    .stat-num {
        font-size: 34rpx;
