<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <!-- 状态栏占位 -->
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏：返回 / 标题 / 搜索 -->
        <view class="nav-bar">
            <view class="nav-left" @click="onBack">
                <text class="nav-icon">‹</text>
            </view>
            <text class="nav-title">题库练习</text>
            <view class="nav-right" @click="onSearch">
                <text class="nav-icon">🔍</text>
            </view>
        </view>

        <!-- 地区行（mock：后端暂无题目地区维度，仅作本地筛选展示） -->
        <view class="region-bar">
            <view class="region-left" @click="onRegionTap">
                <text class="region-text">{{ region }}</text>
                <text class="region-arrow">∨</text>
            </view>
        </view>

        <!-- 主内容滚动区 -->
        <scroll-view
            class="scroll-content"
            scroll-y="true"
            :refresher-enabled="true"
            :refresher-triggered="isRefreshing"
            @refresherrefresh="onRefresh"
        >
            <!-- 培训横幅卡片 -->
            <view class="banner-card">
                <view class="banner-image-area">
                    <view class="banner-forklift">
                        <text class="banner-emoji">🏗️</text>
                    </view>
                    <view class="banner-overlay">
                        <text class="banner-title-cn">叉车维修培训</text>
                        <text class="banner-title-sub">规范检修 · 安全作业</text>
                    </view>
                    <!-- 右侧标签 -->
                    <view class="banner-tags">
                        <text class="banner-tag">维修步骤</text>
                        <text class="banner-tag">安全要点</text>
                        <text class="banner-tag">实操教学</text>
                        <text class="banner-tag">案例分析</text>
                        <text class="banner-tag">考核发证</text>
                    </view>
                </view>
            </view>

            <!-- 数据统计栏（蓝色渐变）：数据源 /practice-mode/practice-stats -->
            <view class="stat-bar">
                <view class="stat-item">
                    <text class="stat-num">{{ overview.today_count }}</text>
                    <text class="stat-label">今日做题</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item">
                    <text class="stat-num">{{ overview.total_count }}</text>
                    <text class="stat-label">累计做题</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item">
                    <text class="stat-num">{{ overview.total_days }}</text>
                    <text class="stat-label">累计天数</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item" @click="onReportClick">
                    <view class="stat-report-wrap">
                        <text class="stat-report-text">数据报告</text>
                        <text class="stat-report-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 功能入口网格 -->
            <view class="feature-grid">
                <view class="feature-item" @click="onFeatureClick('past_paper')">
                    <view class="feature-icon-wrap feature-color-paper">
                        <text class="feature-icon-text">📄</text>
                    </view>
                    <text class="feature-name">历年真题</text>
                </view>
                <view class="feature-item" @click="onFeatureClick('mock_exam')">
                    <view class="feature-icon-wrap feature-color-mock">
                        <text class="feature-icon-text">📋</text>
                    </view>
                    <text class="feature-name">套卷模拟</text>
                </view>
                <view class="feature-item" @click="onFeatureClick('level_exam')">
                    <view class="feature-icon-wrap feature-color-level">
                        <text class="feature-icon-text">🏆</text>
                    </view>
                    <text class="feature-name">模考大赛</text>
                </view>
                <view class="feature-item" @click="onFeatureClick('wrong_question')">
                    <view class="feature-icon-wrap feature-color-wrong">
                        <text class="feature-icon-text">❌</text>
                    </view>
                    <text class="feature-name">错题本</text>
                </view>
            </view>

            <!-- 模块练习列表（标签专项） -->
            <view v-if="listLoading && modules.length == 0" class="skeleton-list">
                <view v-for="i in 4" :key="i" class="skeleton-item">
                    <view class="skeleton-content">
                        <view class="skeleton-line skeleton-line-title"></view>
                        <view class="skeleton-line skeleton-line-sub"></view>
                    </view>
                    <view class="skeleton-arrow"></view>
                </view>
            </view>

            <view v-else-if="listError.length > 0 && modules.length == 0" class="error-state" @click="loadModules">
                <text class="error-icon">⚠️</text>
                <text class="error-text">{{ listError }}</text>
                <view class="error-btn">
                    <text class="error-btn-text">点击重试</text>
                </view>
            </view>

            <view v-else-if="modules.length == 0" class="empty-state">
                <text class="empty-icon">📭</text>
                <text class="empty-text">暂无题库标签</text>
            </view>

            <view v-else class="module-list">
                <view v-for="(m, idx) in modules" :key="m.tag_id" class="module-card" @click="onModuleClick(m)">
                    <view class="module-icon">
                        <text class="module-icon-text">›</text>
                    </view>
                    <view class="module-info">
                        <text class="module-name">{{ m.name }}</text>
                        <text class="module-meta">{{ moduleMeta(m) }}</text>
                    </view>
                    <text class="module-arrow">›</text>
                </view>
            </view>

            <!-- 底部安全区 -->
            <view class="safe-bottom"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getTagsApi } from '../../api/course'
    import type { TagItem } from '../../types/index'
    import { getPracticeOverviewApi, getPracticeProgressApi } from '../../api/practice'
    import type { PracticeOverview } from '../../types/index'

    /** 模块练习行（标签 + 进度快照） */
    type ModuleRow = {
        tag_id : number
        name : string
        total : number
        completed : number
    }

    // ===== 系统信息 =====
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ===== 地区筛选（mock：无后端支撑，本地展示态） =====
    const region = ref<string>('全国')
    const regionOptions : string[] = ['全国', '北京', '上海', '广东', '浙江', '江苏', '山东', '四川', '湖北', '湖南', '河南']

    function onRegionTap() : void {
        uni.showActionSheet({
            itemList: regionOptions,
            success: (res) => {
                region.value = regionOptions[res.tapIndex]
            }
        })
    }

    // ===== 刷题数据统计 =====
    const overview = ref<PracticeOverview>({
        today_count: 0,
        total_count: 0,
        total_days: 0,
    } as PracticeOverview)

    // ===== 模块列表 =====
    const modules = ref<ModuleRow[]>([])
    const listLoading = ref<boolean>(false)
    const listError = ref<string>('')
    const isRefreshing = ref<boolean>(false)

    async function loadOverview() : Promise<void> {
        try {
            overview.value = await getPracticeOverviewApi()
        } catch (e) {
            console.error('[practice] load overview failed:', e)
        }
    }

    /**
     * mock 正确率：后端无"按标签"维度正确率接口（stats 仅按题型），
     * 用标签 ID 派生的稳定伪值填充 UI，接口就绪后删除本函数并接真实字段。
     */
    function mockAccuracy(tagId : number) : number {
        return 60 + (tagId * 13) % 35
    }

    /** 模块行副标题：已开始显示完成进度（正确率为 mock），未开始显示总题量 */
    function moduleMeta(m : ModuleRow) : string {
        if (m.completed > 0) {
            return '已完成 ' + m.completed.toString() + '/' + m.total.toString() + ' 正确率 ' + mockAccuracy(m.tag_id).toString() + '%'
        }
        if (m.total > 0) {
            return '共 ' + m.total.toString() + ' 题'
        }
        return '暂无题目'
    }

    /**
     * 加载标签模块列表：
     * 1) /tags 拿名称与题量先渲染；
     * 2) 再逐个查 /practice-mode/progress?mode=tag:<id> 回填"已完成 x/y"。
     * 正确率后端无标签维度接口（仅按题型 by_type），原型该项暂缺。
     */
    async function loadModules() : Promise<void> {
        listLoading.value = true
        listError.value = ''
        let tags : TagItem[] = []
        try {
            tags = await getTagsApi()
        } catch (e) {
            console.error('[practice] load tags failed:', e)
            listError.value = '加载失败，请点击重试'
            listLoading.value = false
            return
        }
        const rows : ModuleRow[] = []
        for (let i = 0; i < tags.length; i++) {
            const t = tags[i]
            rows.push({ tag_id: t.id, name: t.name, total: t.question_count, completed: 0 } as ModuleRow)
        }
        modules.value = rows
        listLoading.value = false

        // 逐个回填进度（标签数量有限，顺序拉取；单个失败保持默认值不影响整页）
        for (let i = 0; i < rows.length; i++) {
            try {
                const p = await getPracticeProgressApi('tag:' + rows[i].tag_id.toString())
                if (p.completed > 0 || p.total > 0) {
                    rows[i].completed = p.completed
                    if (p.total > 0) {
                        rows[i].total = p.total
                    }
                    modules.value = rows.slice()
                }
            } catch (e) {
                // 无进度记录等场景静默
            }
        }
    }

    function onModuleClick(m : ModuleRow) : void {
        uni.navigateTo({
            url: '/pages/practice/practice-do?mode=tag&tag_id=' + m.tag_id.toString() + '&tag_name=' + encodeURIComponent(m.name)
        })
    }

    // ===== 事件处理 =====
    function onBack() : void {
        goBack()
    }

    function onSearch() : void {
        uni.navigateTo({ url: '/pages/search/search' })
    }

    function onReportClick() : void {
        uni.navigateTo({ url: '/pages/practice/practice-report' })
    }

    function onFeatureClick(feature : string) : void {
        if (feature == 'past_paper') {
            uni.showToast({ title: '历年真题开发中', icon: 'none' })
        } else if (feature == 'mock_exam') {
            uni.navigateTo({ url: '/pages/exam/mock-exam' })
        } else if (feature == 'level_exam') {
            uni.navigateTo({ url: '/pages/exam/level-exam-do' })
        } else if (feature == 'wrong_question') {
            uni.navigateTo({ url: '/pages/profile/wrong-questions' })
        }
    }

    async function onRefresh() : Promise<void> {
        isRefreshing.value = true
        await loadOverview()
        await loadModules()
        isRefreshing.value = false
    }

    // ===== 生命周期 =====
    onShow(() => {
        loadOverview()
        if (modules.value.length == 0) {
            loadModules()
        }
    })
</script>

