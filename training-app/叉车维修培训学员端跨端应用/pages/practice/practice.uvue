<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <!-- 状态栏占位 -->
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-left" @click="onBack">
                <text class="nav-icon">‹</text>
            </view>
            <text class="nav-title">题库练习</text>
            <view class="nav-right" @click="onMenu">
                <text class="nav-icon">☰</text>
            </view>
        </view>

        <!-- 主内容滚动区 -->
        <scroll-view
            class="scroll-content"
            scroll-y="true"
            :refresher-enabled="true"
            :refresher-triggered="isRefreshing"
            @refresherrefresh="onRefresh"
            @scrolltolower="onLoadMore"
        >
            <!-- 筛选栏 -->
            <view class="filter-row">
                <view class="filter-dropdown" @click="onFilterClick">
                    <text class="filter-text">{{ currentFilterLabel }}</text>
                    <text class="filter-arrow">▼</text>
                </view>
                <view class="filter-spacer"></view>
            </view>

            <!-- 培训横幅卡片 -->
            <view class="banner-card" @click="onBannerClick">
                <view class="banner-image-area">
                    <view class="banner-forklift">
                        <text class="banner-emoji">🏗️</text>
                    </view>
                    <view class="banner-overlay">
                        <text class="banner-title-cn">叉车维修培训</text>
                        <text class="banner-title-sub">规范检修 · 安全作业</text>
                    </view>
                    <!-- 右侧标签 -->
                    <view class="banner-tags">
                        <text class="banner-tag">维修步骤</text>
                        <text class="banner-tag">安全要点</text>
                        <text class="banner-tag">实操教学</text>
                        <text class="banner-tag">案例分析</text>
                        <text class="banner-tag">考核发证</text>
                    </view>
                </view>
            </view>

            <!-- 数据统计栏（蓝色渐变） -->
            <view class="stat-bar">
                <view class="stat-item" @click="onStatClick('today')">
                    <text class="stat-num">{{ stats.today_count }}</text>
                    <text class="stat-label">今日做题</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item" @click="onStatClick('total')">
                    <text class="stat-num">{{ stats.total_practiced }}</text>
                    <text class="stat-label">累计做题</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item" @click="onStatClick('days')">
                    <text class="stat-num">{{ stats.streak_days }}</text>
                    <text class="stat-label">累计天数</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item" @click="onStatClick('report')">
                    <view class="stat-report-wrap">
                        <text class="stat-report-text">数据报告</text>
                        <text class="stat-report-arrow">›</text>
                    </view>
                    <text class="stat-label">查看分析</text>
                </view>
            </view>

            <!-- 功能入口网格 -->
            <view class="feature-grid">
                <view class="feature-item" @click="onFeatureClick('past_paper')">
                    <view class="feature-icon-wrap feature-color-paper">
                        <text class="feature-icon-text">📄</text>
                    </view>
                    <text class="feature-name">历年试卷</text>
                </view>
                <view class="feature-item" @click="onFeatureClick('mock_exam')">
                    <view class="feature-icon-wrap feature-color-mock">
                        <text class="feature-icon-text">📋</text>
                    </view>
                    <text class="feature-name">套卷模拟</text>
                </view>
                <view class="feature-item" @click="onFeatureClick('level_exam')">
                    <view class="feature-icon-wrap feature-color-level">
                        <text class="feature-icon-text">🏆</text>
                    </view>
                    <text class="feature-name">模考大赛</text>
                </view>
                <view class="feature-item" @click="onFeatureClick('wrong_question')">
                    <view class="feature-icon-wrap feature-color-wrong">
                        <text class="feature-icon-text">❌</text>
                    </view>
                    <text class="feature-name">错题重练</text>
                </view>
            </view>

            <!-- 骨架屏加载态 -->
            <view v-if="listLoading && questionList.length === 0" class="skeleton-list">
                <view v-for="i in 4" :key="i" class="skeleton-item">
                    <view class="skeleton-content">
                        <view class="skeleton-line skeleton-line-title"></view>
                        <view class="skeleton-line skeleton-line-sub"></view>
                    </view>
                    <view class="skeleton-arrow"></view>
                </view>
            </view>

            <!-- 错误态 -->
            <view v-else-if="listError" class="error-state" @click="retryLoad">
                <text class="error-icon">⚠️</text>
                <text class="error-text">{{ listError }}</text>
                <view class="error-btn">
                    <text class="error-btn-text">点击重试</text>
                </view>
            </view>

            <!-- 空状态 -->
            <view v-else-if="!listLoading && questionList.length === 0" class="empty-state">
                <text class="empty-icon">📭</text>
                <text class="empty-text">暂无题目数据</text>
            </view>

            <!-- 标签练习 -->
            <view v-if="tagList.length > 0" class="tags-section">
                <view class="section-header-bar">
                    <text class="section-title-bar">标签练习</text>
                </view>
                <view class="tags-wrap">
                    <view v-for="(tag, idx) in tagList" :key="tag.id" class="tag-chip" @click="onTagClick(tag)">
                        <text class="tag-chip-text">{{ tag.name }}</text>
                        <text class="tag-chip-count">{{ tag.question_count }}题</text>
                    </view>
                </view>
            </view>

            <!-- 题目列表（独立卡片样式） -->
            <view v-if="tagList.length === 0 && questionList.length > 0" class="question-list">
                <view
                    v-for="(item, idx) in questionList"
                    :key="item.question_id"
                    class="question-card"
                    @click="onQuestionClick(item, idx)"
                >
                    <view class="question-info">
                        <text class="question-title">{{ item.title }}</text>
                        <view class="question-meta">
                            <text class="question-status">已完成 {{ item.completedCount }}/{{ item.totalCount }}</text>
                            <text class="question-status-space"> </text>
                            <text class="question-status">正确率 {{ item.accuracy }}%</text>
                        </view>
                    </view>
                    <text class="question-arrow">›</text>
                </view>
            </view>

            <!-- 加载更多 -->
            <view v-if="listLoading && questionList.length > 0" class="load-more">
                <text class="load-more-text">加载中...</text>
            </view>
            <view v-if="listNoMore && questionList.length > 0" class="load-more">
                <text class="load-more-text">— 没有更多了 —</text>
            </view>

            <!-- 底部安全区 -->
            <view class="safe-bottom"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow, onPullDownRefresh } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { getTagsApi } from '../../api/course'
    import type { TagItem } from '../../types/index'
    import { goBack } from '../../utils/navigation'
    import {
        getPracticeStatsApi,
        getQuestionListApi,
        getQuestionBankStatsApi,
    } from '../../api/practice'
    import type { PracticeStats } from '../../types/index'

    // ===== 系统信息 =====
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ===== 筛选标签 =====
    const tabs = ref<{ key: string; label: string; type: string }[]>([
        { key: 'all', label: '全部', type: '' },
        { key: 'choice', label: '选择题', type: 'single_choice' },
        { key: 'judge', label: '判断题', type: 'true_false' },
        { key: 'safety', label: '安全规范', type: 'safety' },
    ])
    const activeTab = ref<string>('all')

    const currentFilterLabel = computed<string>(() : string => {
        for (let i = 0; i < tabs.value.length; i++) {
            if (tabs.value[i].key == activeTab.value) {
                return tabs.value[i].label
            }
        }
        return '全部'
    })

    // ===== 标签数据 =====
    const tagList = ref<TagItem[]>([])

    async function loadTags() : Promise<void> {
        try {
            tagList.value = await getTagsApi()
        } catch (e) {
            console.warn('[practice] loadTags failed:', e)
        }
    }

    function onTagClick(tag : TagItem) : void {
        uni.navigateTo({
            url: '/pages/practice/practice-do?mode=tag&tag_id=' + tag.id.toString() + '&tag_name=' + encodeURIComponent(tag.name)
        })
    }

    // ===== 统计数据 =====
    const stats = ref<PracticeStats>({
        total_practiced: 0,
        correct_count: 0,
        accuracy: 0,
        today_count: 0,
        streak_days: 0,
    } as PracticeStats)

    // ===== 题目列表 =====
    interface QuestionListItem {
        question_id: number
        type: string
        title: string
        completed: boolean
        accuracy: number
        completedCount: number
        totalCount: number
    }

    const questionList = ref<QuestionListItem[]>([])
    const listPage = ref<number>(1)
    const listPageSize = 20
    const listTotal = ref<number>(0)
    const listLoading = ref<boolean>(false)
    const listNoMore = ref<boolean>(false)
    const listError = ref<string>('')

    // ===== 下拉刷新 =====
    const isRefreshing = ref<boolean>(false)

    // ===== 工具函数 =====
    function getTypeName(type: string): string {
        if (type === 'single' || type === 'single_choice') return '选择题'
        if (type === 'multi' || type === 'multiple_choice' || type === 'multi_choice') return '多选题'
        if (type === 'judge' || type === 'true_false') return '判断题'
        if (type === 'safety') return '安全规范'
        return '其他'
    }

    function getFilterType(): string {
        for (let i = 0; i < tabs.value.length; i++) {
            if (tabs.value[i].key == activeTab.value) {
                return tabs.value[i].type
            }
        }
        return ''
    }

    // ===== 数据加载 =====
    async function loadStats(): Promise<void> {
        try {
            const data = await getPracticeStatsApi()
            stats.value = data
        } catch (e) {
            console.error('[practice] load stats failed:', e)
        }
    }

    async function loadQuestions(reset: boolean = false): Promise<void> {
        if (listLoading.value) return
        if (reset) {
            listPage.value = 1
            listNoMore.value = false
            listError.value = ''
        }
        if (listNoMore.value && !reset) return

        listLoading.value = true
        listError.value = ''
        try {
            const filterType = getFilterType()
            const result = await getQuestionListApi(listPage.value, listPageSize, filterType, '')
            const rawItems = result['items'] as any[] | null
            const rawTotal = result['total'] as number

            const newItems: QuestionListItem[] = []
            if (rawItems != null) {
                for (let i = 0; i < rawItems.length; i++) {
                    const raw = rawItems[i] as UTSJSONObject
                    const item: QuestionListItem = {
                        question_id: (raw['id'] ?? raw['question_id']) as number ?? 0,
                        type: (raw['type'] ?? '') as string,
                        title: (raw['content'] ?? raw['title'] ?? '') as string,
                        completed: false,
                        accuracy: 0,
                        completedCount: 0,
                        totalCount: 0,
                    } as QuestionListItem
                    // 如果后端返回了进度信息
                    const cc = raw['completed_count']
                    if (cc != null) item.completedCount = cc as number
                    const tc = raw['total_count']
                    if (tc != null) item.totalCount = tc as number
                    const acc = raw['accuracy']
                    if (acc != null) item.accuracy = acc as number
                    newItems.push(item)
                }
            }

            if (reset) {
                questionList.value = newItems
            } else {
                questionList.value = questionList.value.concat(newItems)
            }
            listTotal.value = rawTotal ?? 0

            if (questionList.value.length >= listTotal.value || newItems.length === 0) {
                listNoMore.value = true
            } else {
                listPage.value = listPage.value + 1
            }
        } catch (e) {
            console.error('[practice] load questions failed:', e)
            listError.value = '加载失败，请点击重试'
        } finally {
            listLoading.value = false
        }
    }

    // ===== 事件处理 =====
    function onBack(): void {
        goBack()
    }

    function onMenu(): void {
        uni.showToast({ title: '菜单', icon: 'none' })
    }

    function onFilterClick(): void {
        const keys = ['all', 'choice', 'judge', 'safety']
        let currentIdx = 0
        for (let i = 0; i < keys.length; i++) {
            if (keys[i] == activeTab.value) {
                currentIdx = i
                break
            }
        }
        const nextIdx = (currentIdx + 1) % keys.length
        activeTab.value = keys[nextIdx]
        loadQuestions(true)
    }

    function onBannerClick(): void {
        // 横幅整体点击
    }

    function onStatClick(statType: string): void {
        if (statType == 'report') {
            uni.showToast({ title: '数据报告开发中', icon: 'none' })
        }
    }

    function onFeatureClick(feature: string): void {
        if (feature == 'past_paper') {
            uni.showToast({ title: '历年试卷开发中', icon: 'none' })
        } else if (feature == 'mock_exam') {
            uni.navigateTo({ url: '/pages/exam/mock-exam' })
        } else if (feature == 'level_exam') {
            uni.navigateTo({ url: '/pages/exam/level-exam-do' })
        } else if (feature == 'wrong_question') {
            uni.navigateTo({ url: '/pages/profile/wrong-questions' })
        }
    }

    function onQuestionClick(item: QuestionListItem, index: number): void {
        const filterType = getFilterType()
        let url = '/pages/practice/practice-do?mode=free'
        if (filterType.length > 0) {
            url = url + '&type=' + filterType
        }
        url = url + '&start=' + index.toString()
        uni.navigateTo({ url: url })
    }

    async function onRefresh(): Promise<void> {
        isRefreshing.value = true
        await Promise.all([loadStats(), loadQuestions(true)])
        isRefreshing.value = false
    }

    function onLoadMore(): void {
        loadQuestions(false)
    }

    function retryLoad(): void {
        loadQuestions(true)
    }

    // ===== 生命周期 =====
    onShow(() => {
        loadStats()
        loadTags()
        if (questionList.value.length === 0) {
            loadQuestions(true)
        }
    })
</script>

<style>
