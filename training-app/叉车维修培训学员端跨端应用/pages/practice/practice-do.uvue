<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-left" @click="onBack">
                <text class="nav-back">‹</text>
            </view>
            <view class="nav-center">
                <text class="nav-timer">⏱ {{ timerText }}</text>
                <text class="nav-progress">{{ currentIndex + 1 }}/{{ questions.length }}</text>
            </view>
            <view class="nav-right"></view>
        </view>

        <!-- 加载中 -->
        <view v-if="loading && questions.length == 0" class="loading-wrap">
            <text class="loading-text">正在加载题目...</text>
        </view>

        <!-- 空数据 -->
        <view v-else-if="questions.length == 0" class="empty-wrap">
            <text class="empty-text">暂无题目</text>
        </view>

        <!-- 答题区域 -->
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <!-- 题目区域 -->
            <view class="question-section">
                <view class="question-type-row">
                    <text class="question-type-tag">{{ getTypeName(currentQuestion.type) }}</text>
                </view>
                <text class="question-title">{{ currentQuestion.title }}</text>
            </view>

            <!-- 选项列表 -->
            <view class="option-list">
                <view v-for="(opt, idx) in currentQuestion.options" :key="idx"
                    class="option-item"
                    :class="getOptionClass(opt.key)"
                    @click="onOptionClick(opt.key)">
                    <view class="option-key" :class="getOptionKeyClass(opt.key)">
                        <text v-if="showResult && isCorrectAnswer(opt.key)" class="option-key-icon">✓</text>
                        <text v-else-if="showResult && isSelected(opt.key) && !isCorrectAnswer(opt.key)" class="option-key-icon">✗</text>
                        <text v-else class="option-key-text">{{ opt.key }}</text>
                    </view>
                    <text class="option-text" :class="getOptionTextClass(opt.key)">{{ opt.text }}</text>
                </view>
            </view>

            <!-- 答题结果区域 -->
            <view v-if="showResult" class="result-section">
                <!-- 答案对比 -->
                <view class="result-answer-box">
                    <text class="result-answer-line">正确答案是 <text class="result-correct-text">{{ lastResult.correct_answer }}</text>，您的答案是 <text :class="lastResult.correct ? 'result-correct-text' : 'result-wrong-text'">{{ lastUserAnswer.length > 0 ? lastUserAnswer : '未作答' }}</text></text>
                </view>

                <!-- 统计数据行 -->
                <view class="stats-row">
                    <view class="stats-item">
                        <text class="stats-label">做题时长</text>
                        <text class="stats-value">{{ questionTimeText }}</text>
                    </view>
                    <view class="stats-divider"></view>
                    <view class="stats-item">
                        <text class="stats-label">全站正确率</text>
                        <text class="stats-value">{{ siteAccuracy }}%</text>
                    </view>
                    <view class="stats-divider"></view>
                    <view class="stats-item">
                        <text class="stats-label">难度值</text>
                        <text class="stats-value">{{ difficultyLevel }}</text>
                    </view>
                </view>

                <!-- AI 解析 -->
                <view class="section-block">
                    <view class="section-header">
                        <text class="section-title">AI 解析</text>
                        <view class="section-action" @click="onShareExplanation">
                            <text class="section-action-text">分享解析</text>
                        </view>
                    </view>
                    <text v-if="lastResult.explanation.length > 0" class="section-content">{{ lastResult.explanation }}</text>
                    <text v-else class="section-empty">暂无解析</text>
                </view>

                <!-- 评论 -->
                <view class="section-block">
                    <view class="section-header">
                        <text class="section-title">评论</text>
                        <view class="section-action" @click="toggleComments">
                            <text class="section-action-text">{{ showComments ? '收起' : '查看所有评论' }}</text>
                        </view>
                    </view>
                    <view v-if="showComments">
                        <view v-for="(c, idx) in comments" :key="idx" class="comment-item">
                            <view class="comment-head">
                                <text class="comment-author">{{ c.username }}</text>
                                <text class="comment-time">{{ formatTime(c.created_at) }}</text>
                                <view v-if="c.can_delete" class="comment-delete" @click="onDeleteComment(c)">
                                    <text class="comment-delete-text">删除</text>
                                </view>
                            </view>
                            <text class="comment-content">{{ c.content }}</text>
                        </view>
                        <view v-if="comments.length == 0" class="section-empty-wrap">
                            <text class="section-empty-text">暂无评论，快来抢沙发吧~</text>
                        </view>
                        <view class="comment-input-bar">
                            <input class="comment-input" v-model="commentText" placeholder="写下你的评论..." maxlength="500" />
                            <view class="comment-send-btn" :class="commentText.length > 0 ? 'active' : ''" @click="onSubmitComment">
                                <text class="comment-send-text">发表</text>
                            </view>
                        </view>
                    </view>
                </view>

                <!-- 考点 -->
                <view class="section-block">
                    <view class="section-header">
                        <text class="section-title">考点</text>
                    </view>
                    <view v-if="knowledgeTags.length > 0" class="tag-row">
                        <view v-for="tag in knowledgeTags" :key="tag.id" class="knowledge-tag">
                            <text class="knowledge-tag-text">{{ tag.name }}</text>
                        </view>
                    </view>
                    <text v-else class="section-empty">暂无考点信息</text>
                </view>

                <!-- 笔记 -->
                <view class="section-block">
                    <view class="section-header">
                        <text class="section-title">笔记</text>
                        <view class="section-action" @click="toggleNote">
                            <text class="section-action-text">{{ showNote ? '收起' : (noteContent.length > 0 ? '查看笔记' : '添加笔记') }}</text>
                        </view>
                    </view>
                    <view v-if="showNote" class="note-area">
                        <textarea class="note-textarea" v-model="noteContent" placeholder="记录你的学习心得..." maxlength="2000" @blur="onSaveNote" />
                        <view v-if="noteContent.length > 0" class="note-actions">
                            <view class="note-delete-btn" @click="onDeleteNote">
                                <text class="note-delete-text">删除笔记</text>
                            </view>
                            <text class="note-autosave">自动保存</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 底部占位 -->
            <view class="bottom-placeholder"></view>
        </scroll-view>

        <!-- 底部操作栏 -->
        <view v-if="questions.length > 0" class="bottom-bar">
            <view class="bottom-actions">
                <view class="bottom-icon-btn" @click="onToggleAnswerCard">
                    <image class="bottom-icon-img" src="/static/icons/answer-card.png" mode="aspectFit" />
                    <text class="bottom-icon-label">答题卡</text>
                </view>
                <view class="bottom-icon-btn" @click="onToggleFavorite">
                    <image class="bottom-icon-img" :src="isFavorited ? '/static/icons/star-filled.png' : '/static/icons/star.png'" mode="aspectFit" />
                    <text class="bottom-icon-label">{{ isFavorited ? '已收藏' : '收藏' }}</text>
                </view>
                <view v-if="!showResult" class="submit-btn" @click="onSubmit">
                    <text class="submit-btn-text">提交答案</text>
                </view>
                <view v-else class="submit-btn next-btn" @click="onNext">
                    <text class="submit-btn-text">{{ currentIndex >= questions.length - 1 ? '查看结果' : '下一题' }}</text>
                </view>
            </view>
        </view>

        <!-- 答题卡弹窗 -->
        <view v-if="showAnswerCard" class="answer-card-mask" @click="onCloseAnswerCard">
            <view class="answer-card-sheet" @click.stop>
                <view class="answer-card-header">
                    <text class="answer-card-title">答题卡</text>
                </view>
                <view class="answer-card-grid">
                    <view v-for="(q, idx) in questions" :key="idx"
                        class="answer-card-item"
                        :class="getAnswerCardClass(idx)"
                        @click="onJumpToQuestion(idx)">
                        <text class="answer-card-num" :class="getAnswerCardNumClass(idx)">{{ idx + 1 }}</text>
                    </view>
                </view>
                <view class="answer-card-footer">
                    <view class="submit-paper-btn" @click="onSubmitPaper">
                        <text class="submit-paper-text">交卷</text>
                    </view>
                </view>
            </view>
        </view>

        <!-- 结果汇总弹窗 -->
        <view v-if="showSummary" class="summary-mask">
            <view class="summary-box">
                <text class="summary-title">练习完成</text>
                <view class="summary-stats">
                    <view class="summary-stat">
                        <text class="summary-stat-num">{{ questions.length }}</text>
                        <text class="summary-stat-label">总题数</text>
                    </view>
                    <view class="summary-stat">
                        <text class="summary-stat-num correct-color">{{ correctCount }}</text>
                        <text class="summary-stat-label">答对</text>
                    </view>
                    <view class="summary-stat">
                        <text class="summary-stat-num wrong-color">{{ questions.length - correctCount }}</text>
                        <text class="summary-stat-label">答错</text>
                    </view>
                    <view class="summary-stat">
                        <text class="summary-stat-num">{{ summaryAccuracy }}%</text>
                        <text class="summary-stat-label">正确率</text>
                    </view>
                </view>
                <view class="summary-actions">
                    <view class="summary-btn summary-btn-secondary" @click="onExit">
                        <text class="summary-btn-secondary-text">返回</text>
                    </view>
                    <view class="summary-btn summary-btn-primary" @click="onRestart">
                        <text class="summary-btn-primary-text">再练一次</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import {
        getFreePracticeApi,
        getSequentialPracticeApi,
        getTagPracticeApi,
        submitAnswerApi,
        savePracticeProgressApi,
    } from '../../api/practice'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import {
        getCommentsApi, createCommentApi, deleteCommentApi,
        getKnowledgeApi,
        getNoteApi, saveNoteApi, deleteNoteApi,
    } from '../../api/questionInteraction'
    import { useAuthStore } from '../../stores/auth'
    import type { Question, SubmitAnswerResult, AnswerState, QuestionOption, SubmitAnswerParams, FavoriteCheckResult, QuestionComment, KnowledgeTag } from '../../types/index'

    const authStore = useAuthStore()

    /** 当前用户 ID */
    const currentUserId = computed<number>(() : number => {
        const u = authStore.user.value
        if (u != null) return u.user_id
        return 0
    })

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 页面参数
    const mode = ref<string>('free')
    const practiceCount = ref<number>(20)
    const tagId = ref<number>(0)
    const tagName = ref<string>('')
    const isContinue = ref<boolean>(false)

    // 题目与状态
    const questions = ref<Question[]>([])
    const currentIndex = ref<number>(0)
    const loading = ref<boolean>(false)
    const showResult = ref<boolean>(false)
    const showSummary = ref<boolean>(false)
    const showAnswerCard = ref<boolean>(false)
    const isFavorited = ref<boolean>(false)
    const favoriteId = ref<number>(0)

    // 答案状态
    const selectedKeys = ref<string[]>([])
    const answerStates = ref<AnswerState[]>([])
    const lastUserAnswer = ref<string>('')
    const lastResult = ref<SubmitAnswerResult>({
        correct: false,
        correct_answer: '',
        explanation: '',
    } as SubmitAnswerResult)

    // 计时器
    const totalSeconds = ref<number>(0)
    const questionStartTime = ref<number>(0)
    const questionElapsed = ref<number>(0)
    let timerInterval : any = null

    // 评论状态
    const showComments = ref<boolean>(false)
    const comments = ref<QuestionComment[]>([])
    const commentText = ref<string>('')

    // 考点状态
    const knowledgeTags = ref<KnowledgeTag[]>([])

    // 笔记状态
    const showNote = ref<boolean>(false)
    const noteContent = ref<string>('')
    let noteSaveTimer : any = null

    // 模拟数据（实际应从后端获取）
    const siteAccuracy = ref<number>(85)
    const difficultyLevel = ref<string>('C')

    const currentQuestion = computed<Question>(() : Question => {
        if (questions.value.length == 0) {
            return { question_id: 0, type: '', title: '', options: [] as QuestionOption[], correct_answer: '', explanation: '' } as Question
        }
        return questions.value[currentIndex.value]
    })

    const timerText = computed<string>(() : string => {
        const m = Math.floor(totalSeconds.value / 60)
        const s = totalSeconds.value % 60
        const mStr = m < 10 ? '0' + `${m}` : `${m}`
        const sStr = s < 10 ? '0' + `${s}` : `${s}`
        return mStr + ':' + sStr
    })

    const questionTimeText = computed<string>(() : string => {
        const t = questionElapsed.value
        if (t < 1) return '< 1秒'
        return `${t}` + '秒'
    })

    const correctCount = computed<number>(() : number => {
        let count = 0
        for (let i = 0; i < answerStates.value.length; i++) {
            if (answerStates.value[i].is_correct) count++
        }
        return count
    })

    const summaryAccuracy = computed<number>(() : number => {
        if (questions.value.length == 0) return 0
        return Math.floor(correctCount.value * 100 / questions.value.length)
    })

    function getTypeName(type : string) : string {
        if (type == 'single' || type == 'single_choice') return '单选题'
        if (type == 'multi' || type == 'multiple_choice' || type == 'multi_choice') return '多选题'
        if (type == 'judge' || type == 'true_false') return '判断题'
        return '其他'
    }

    function isMultiChoice() : boolean {
        const t = currentQuestion.value.type
        return t == 'multi' || t == 'multiple_choice' || t == 'multi_choice'
    }

    function isSelected(key : string) : boolean {
        return selectedKeys.value.indexOf(key) >= 0
    }

    function parseAnswerKeys(answer : string) : string[] {
        if (answer.length == 0) return [] as string[]
        if (answer == 'true' || answer == 'false') return [answer] as string[]
        let separator = ''
        if (answer.indexOf(',') >= 0) separator = ','
        else if (answer.indexOf('，') >= 0) separator = '，'
        else if (answer.indexOf(' ') >= 0) separator = ' '
        else if (answer.indexOf(';') >= 0) separator = ';'
        else if (answer.indexOf('|') >= 0) separator = '|'
        if (separator.length > 0) {
            const parts = answer.split(separator)
            const keys : string[] = []
            for (let i = 0; i < parts.length; i++) {
                const k = parts[i].trim()
                if (k.length > 0) keys.push(k)
            }
            return keys
        }
        const keys : string[] = []
        for (let i = 0; i < answer.length; i++) {
            keys.push(answer.charAt(i))
        }
        return keys
    }

    function isCorrectAnswer(key : string) : boolean {
        const keys = parseAnswerKeys(lastResult.value.correct_answer)
        return keys.indexOf(key) >= 0
    }

    function getOptionClass(key : string) : string {
        if (!showResult.value) {
            return isSelected(key) ? 'option-selected' : ''
        }
        if (isCorrectAnswer(key)) return 'option-correct'
        if (isSelected(key) && !isCorrectAnswer(key)) return 'option-wrong'
        return ''
    }

    function getOptionKeyClass(key : string) : string {
        if (!showResult.value) {
            return isSelected(key) ? 'option-key-selected' : ''
        }
        if (isCorrectAnswer(key)) return 'option-key-correct'
        if (isSelected(key) && !isCorrectAnswer(key)) return 'option-key-wrong'
        return ''
    }

    function getOptionTextClass(key : string) : string {
        if (showResult.value && isCorrectAnswer(key)) return 'option-text-correct'
        if (showResult.value && isSelected(key) && !isCorrectAnswer(key)) return 'option-text-wrong'
        return ''
    }

    function getAnswerCardClass(idx : number) : string {
        if (idx == currentIndex.value) return 'card-item-current'
        // 检查是否已答题
        const q = questions.value[idx]
        for (let i = 0; i < answerStates.value.length; i++) {
            if (answerStates.value[i].question_id == q.question_id) {
                return answerStates.value[i].is_correct ? 'card-item-correct' : 'card-item-wrong'
            }
        }
        return 'card-item-default'
    }

    function getAnswerCardNumClass(idx : number) : string {
        if (idx == currentIndex.value) return 'card-num-current'
        const q = questions.value[idx]
        for (let i = 0; i < answerStates.value.length; i++) {
            if (answerStates.value[i].question_id == q.question_id) {
                return 'card-num-answered'
            }
        }
        return 'card-num-default'
    }

    function onOptionClick(key : string) : void {
        if (showResult.value) return
        if (isMultiChoice()) {
            const idx = selectedKeys.value.indexOf(key)
            if (idx >= 0) {
                selectedKeys.value.splice(idx, 1)
            } else {
                selectedKeys.value.push(key)
            }
        } else {
            selectedKeys.value = [key]
        }
    }

    function startTimer() {
        if (timerInterval != null) return
        timerInterval = setInterval(() => {
            totalSeconds.value = totalSeconds.value + 1
        }, 1000)
    }

    function stopTimer() {
        if (timerInterval != null) {
            clearInterval(timerInterval)
            timerInterval = null
        }
    }

    function recordQuestionTime() {
        const now = Date.now()
        if (questionStartTime.value > 0) {
            questionElapsed.value = Math.floor((now - questionStartTime.value) / 1000)
        }
        questionStartTime.value = now
    }

    async function loadQuestions() {
        loading.value = true
        try {
            if (mode.value == 'free') {
                questions.value = await getFreePracticeApi(practiceCount.value)
            } else if (mode.value == 'sequential') {
                questions.value = await getSequentialPracticeApi()
            } else if (mode.value == 'tag') {
                questions.value = await getTagPracticeApi(tagId.value, 0)
            }
            if (questions.value.length > 0) {
                startTimer()
                recordQuestionTime()
                checkFavorite()
                loadKnowledge()
            }
        } catch (e) {
            console.error('[practice-do] load questions failed:', e)
            uni.showToast({ title: '加载题目失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    function saveProgress() {
        // 后端 practice_mode 为封闭枚举（sequential | tag:<id> | paper:<id>），随机练习无续练语义，跳过
        if (mode.value == 'free') return
        const saveMode = mode.value == 'tag' ? 'tag:' + tagId.value.toString() : mode.value
        const answersState : UTSJSONObject = {} as UTSJSONObject
        for (let i = 0; i < answerStates.value.length; i++) {
            const s = answerStates.value[i]
            answersState[s.question_id.toString()] = s.user_answer
        }
        savePracticeProgressApi(currentIndex.value + 1, saveMode, questions.value.length, answersState).catch((e) => {
            console.warn('[practice-do] save progress failed:', e)
        })
    }

    async function onSubmit() : Promise<void> {
        if (selectedKeys.value.length == 0) {
            uni.showToast({ title: '请选择答案', icon: 'none' })
            return
        }
        let userAnswer = ''
        if (isMultiChoice()) {
            const sorted = selectedKeys.value.slice().sort()
            userAnswer = sorted.join(',')
        } else {
            userAnswer = selectedKeys.value[0]
        }
        lastUserAnswer.value = userAnswer

        const qid = currentQuestion.value.question_id
        try {
            const params : SubmitAnswerParams = {
                question_id: qid,
                user_answer: userAnswer,
                practice_type: mode.value,
            } as SubmitAnswerParams
            const result = await submitAnswerApi(params)
            lastResult.value = result
            showResult.value = true
            recordQuestionTime()

            const state : AnswerState = {
                question_id: qid,
                user_answer: userAnswer,
                is_correct: result.correct,
                correct_answer: result.correct_answer,
                submitted: true,
            } as AnswerState
            answerStates.value.push(state)

            if (mode.value != 'free') {
                saveProgress()
            }
        } catch (e) {
            console.error('[practice-do] submit failed:', e)
            uni.showToast({ title: '提交失败', icon: 'none' })
        }
    }

    function onNext() : void {
        if (currentIndex.value >= questions.value.length - 1) {
            showSummary.value = true
            stopTimer()
            return
        }
        currentIndex.value = currentIndex.value + 1
        selectedKeys.value = []
        showResult.value = false
        lastUserAnswer.value = ''
        lastResult.value = { correct: false, correct_answer: '', explanation: '' } as SubmitAnswerResult
        // 重置互动状态
        showComments.value = false
        comments.value = []
        commentText.value = ''
        knowledgeTags.value = []
        showNote.value = false
        noteContent.value = ''
        recordQuestionTime()
        checkFavorite()
        loadKnowledge()
    }

    function onJumpToQuestion(idx : number) : void {
        if (idx == currentIndex.value) {
            showAnswerCard.value = false
            return
        }
        currentIndex.value = idx
        selectedKeys.value = []
        showResult.value = false
        lastUserAnswer.value = ''
        lastResult.value = { correct: false, correct_answer: '', explanation: '' } as SubmitAnswerResult
        // 恢复已答状态
        const q = questions.value[idx]
        for (let i = 0; i < answerStates.value.length; i++) {
            if (answerStates.value[i].question_id == q.question_id) {
                const state = answerStates.value[i]
                lastUserAnswer.value = state.user_answer
                lastResult.value = {
                    correct: state.is_correct,
                    correct_answer: state.correct_answer,
                    explanation: '',
                } as SubmitAnswerResult
                showResult.value = true
                break
            }
        }
        showAnswerCard.value = false
        // 重置互动状态
        showComments.value = false
        comments.value = []
        commentText.value = ''
        knowledgeTags.value = []
        showNote.value = false
        noteContent.value = ''
        recordQuestionTime()
        checkFavorite()
        loadKnowledge()
    }

    function onToggleAnswerCard() : void {
        showAnswerCard.value = !showAnswerCard.value
    }

    function onCloseAnswerCard() : void {
        showAnswerCard.value = false
    }

    function onToggleFavorite() : void {
        const qid = currentQuestion.value.question_id
        if (qid <= 0) return
        if (isFavorited.value) {
            // 取消收藏
            const fid = favoriteId.value
            if (fid > 0) {
                removeFavoriteApi(fid).then(() => {
                    isFavorited.value = false
                    favoriteId.value = 0
                    uni.showToast({ title: '已取消收藏', icon: 'none' })
                }).catch((e : any) => {
                    console.warn('[practice-do] removeFavorite failed:', e)
                    uni.showToast({ title: '操作失败', icon: 'none' })
                })
            }
        } else {
            // 添加收藏
            addFavoriteApi('question', qid).then((item) => {
                isFavorited.value = true
                favoriteId.value = item.favorite_id
                uni.showToast({ title: '已收藏', icon: 'none' })
            }).catch((e : any) => {
                console.warn('[practice-do] addFavorite failed:', e)
                uni.showToast({ title: '操作失败', icon: 'none' })
            })
        }
    }

    async function checkFavorite() : Promise<void> {
        const qid = currentQuestion.value.question_id
        if (qid <= 0) return
        try {
            const result = await checkFavoriteApi('question', qid)
            isFavorited.value = result.favorited
            favoriteId.value = result.favorite_id
        } catch (e) {
            console.warn('[practice-do] checkFavorite failed:', e)
        }
    }

    function onShareExplanation() : void {
        uni.showToast({ title: '分享功能开发中', icon: 'none' })
    }

    // ========== 评论方法 ==========

    function toggleComments() : void {
        showComments.value = !showComments.value
        if (showComments.value && comments.value.length == 0) {
            loadComments()
        }
    }

    async function loadComments() : Promise<void> {
        const qid = currentQuestion.value.question_id
        if (qid <= 0) return
        try {
            const result = await getCommentsApi(qid)
            const uid = currentUserId.value
            // 根据 user_id 设置 can_delete
            const list = result.items
            for (let i = 0; i < list.length; i++) {
                list[i].can_delete = list[i].user_id == uid && uid > 0
            }
            comments.value = list
        } catch (e) {
            console.warn('[practice-do] loadComments failed:', e)
        }
    }

    async function onSubmitComment() : Promise<void> {
        const text = commentText.value.trim()
        if (text.length == 0) return
        const qid = currentQuestion.value.question_id
        try {
            const c = await createCommentApi(qid, text)
            comments.value.push(c)
            commentText.value = ''
            uni.showToast({ title: '评论成功', icon: 'none' })
        } catch (e) {
            console.error('[practice-do] submitComment failed:', e)
        }
    }

    function onDeleteComment(comment : QuestionComment) : void {
        uni.showModal({
            title: '提示',
            content: '确定删除这条评论吗？',
            success: (res) => {
                if (res.confirm) {
                    const commentId = comment.id
                    deleteCommentApi(commentId).then((_ : UTSJSONObject) => {
                        comments.value = comments.value.filter((c) => c.id != commentId)
                        uni.showToast({ title: '已删除', icon: 'none' })
                    }).catch((e : any) => {
                        console.warn('[practice-do] deleteComment failed:', e)
                        uni.showToast({ title: '删除失败', icon: 'none' })
                    })
                }
            }
        })
    }

    // ========== 考点方法 ==========

    async function loadKnowledge() : Promise<void> {
        const qid = currentQuestion.value.question_id
        if (qid <= 0) return
        try {
            knowledgeTags.value = await getKnowledgeApi(qid)
        } catch (e) {
            console.warn('[practice-do] loadKnowledge failed:', e)
        }
    }

    // ========== 笔记方法 ==========

    function toggleNote() : void {
        showNote.value = !showNote.value
        if (showNote.value) {
            loadNote()
        }
    }

    async function loadNote() : Promise<void> {
        const qid = currentQuestion.value.question_id
        if (qid <= 0) return
        try {
            const note = await getNoteApi(qid)
            noteContent.value = note.content
        } catch (e) {
            console.warn('[practice-do] loadNote failed:', e)
        }
    }

    function onSaveNote() : void {
        const qid = currentQuestion.value.question_id
        if (qid <= 0) return
        // 防抖 500ms 保存
        if (noteSaveTimer != null) clearTimeout(noteSaveTimer)
        noteSaveTimer = setTimeout(() => {
            saveNoteApi(qid, noteContent.value).catch((e : any) => {
                console.warn('[practice-do] saveNote failed:', e)
            })
        }, 500)
    }

    function onDeleteNote() : void {
        const qid = currentQuestion.value.question_id
        uni.showModal({
            title: '提示',
            content: '确定删除这条笔记吗？',
            success: (res) => {
                if (res.confirm) {
                    deleteNoteApi(qid).then(() => {
                        noteContent.value = ''
                        showNote.value = false
                        uni.showToast({ title: '笔记已删除', icon: 'none' })
                    }).catch((e : any) => {
                        console.warn('[practice-do] deleteNote failed:', e)
                    })
                }
            }
        })
    }

    // ========== 时间格式化 ==========

    function formatTime(dateStr : string) : string {
        if (dateStr.length == 0) return ''
        const d = new Date(dateStr)
        const m = d.getMonth() + 1
        const day = d.getDate()
        const h = d.getHours()
        const min = d.getMinutes()
        const mStr = m < 10 ? `0${m}` : `${m}`
        const dStr = day < 10 ? `0${day}` : `${day}`
        const hStr = h < 10 ? `0${h}` : `${h}`
        const minStr = min < 10 ? `0${min}` : `${min}`
        return `${mStr}-${dStr} ${hStr}:${minStr}`
    }

    function onSubmitPaper() : void {
        uni.showModal({
            title: '提示',
            content: '确定要交卷吗？',
            success: (res) => {
                if (res.confirm) {
                    showAnswerCard.value = false
                    showSummary.value = true
                    stopTimer()
                }
            }
        })
    }

    function onBack() : void {
        uni.showModal({
            title: '提示',
            content: '确定要退出练习吗？',
            success: (res) => {
                if (res.confirm) {
                    stopTimer()
                    goBack()
                }
            }
        })
    }

    function onExit() : void {
        stopTimer()
        goBack()
    }

    function onRestart() : void {
        currentIndex.value = 0
        selectedKeys.value = []
        showResult.value = false
        showSummary.value = false
        answerStates.value = []
        lastResult.value = { correct: false, correct_answer: '', explanation: '' } as SubmitAnswerResult
        totalSeconds.value = 0
        questionStartTime.value = 0
        questionElapsed.value = 0
        loadQuestions()
    }

    onLoad((options : UTSJSONObject) => {
        const m = options['mode']
        if (m != null) mode.value = `${m}`
        const cnt = options['count']
        if (cnt != null) practiceCount.value = parseInt(`${cnt}`)
        const tagIdParam = options['tag_id']
        if (tagIdParam != null) tagId.value = parseInt(`${tagIdParam}`)
        const tagNameParam = options['tag_name']
        if (tagNameParam != null) {
            const decoded = decodeURIComponent(`${tagNameParam}`)
            tagName.value = decoded ?? ''
        }
        const cont = options['continue']
        if (cont != null) isContinue.value = (`${cont}`) == '1'
        loadQuestions()
    })
</script>

