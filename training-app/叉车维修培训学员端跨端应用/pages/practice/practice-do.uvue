    .comment-input { flex: 1; height: 72rpx; background-color: #f5f5f5; border-radius: 36rpx; padding: 0 28rpx; font-size: 26rpx; color: #333333; }
    .comment-send-btn { margin-left: 16rpx; padding: 16rpx 28rpx; border-radius: 36rpx; background-color: #e0e0e0; }
