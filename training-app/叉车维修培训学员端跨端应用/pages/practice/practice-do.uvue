<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <!-- 右槽腾空（票 1847）：⏱计时+题号进度两段最长合计约 270rpx，超典型可用槽宽约 164rpx（顶部布局调研 §4.2）。
             B3（票 2519）按原型 435:797 把计时/进度/答题卡/星标落为导航下的**独立状态行**（仍在胶囊间隙带之外，
             #1847 的「不顶进页头」约束不破），底条只留提交/翻题动作。 -->
        <app-nav-bar title="" @left-click="onBack" divider></app-nav-bar>
        <view v-if="session.questions.value.length > 0" class="status-row">
            <view class="status-left">
                <text v-if="!isSingle" class="status-timer">⏰ {{ session.timerText.value }}</text>
                <text v-if="!isSingle" class="status-progress">{{ session.currentIndex.value + 1 }}<text class="status-progress-total">/{{ session.questions.value.length }}</text></text>
            </view>
            <view class="status-actions">
                <text v-if="!isSingle" class="status-icon" @click="session.onToggleAnswerCard()">📝</text>
                <text class="status-icon" @click="session.onToggleFavorite()">{{ session.isFavorited.value ? '⭐' : '☆' }}</text>
            </view>
        </view>
        <view v-if="session.loading.value && session.questions.value.length == 0" class="loading-wrap">
            <text class="loading-text">正在加载题目...</text>
        </view>
        <view v-else-if="session.questions.value.length == 0" class="empty-wrap">
            <text class="empty-text">{{ emptyText }}</text>
        </view>
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <!-- 题卡（原型 435:797）：类型 chip + 题干 + 选项同卡 -->
            <view class="question-card">
                <view class="question-type-row"><text class="question-type-tag">{{ session.getTypeName(session.currentQuestion.value.type) }}</text></view>
                <text class="question-title">{{ session.currentQuestion.value.title }}</text>
                <view class="option-list">
                    <view v-for="(opt, idx) in session.currentQuestion.value.options" :key="idx" class="option-item" :class="session.getOptionClass(opt.key)" @click="session.onOptionClick(opt.key)">
                        <view class="option-key" :class="session.getOptionKeyClass(opt.key)">
                            <text v-if="session.showResult.value && session.isCorrectAnswer(opt.key)" class="option-key-icon">✓</text>
                            <text v-else-if="session.showResult.value && session.isSelected(opt.key) && !session.isCorrectAnswer(opt.key)" class="option-key-icon">✗</text>
                            <text v-else class="option-key-text">{{ opt.key }}</text>
                        </view>
                        <text class="option-text">{{ opt.text }}</text>
                    </view>
                </view>
            </view>
            <view v-if="session.showResult.value" class="result-section">
                <!-- 对错卡（原型 452:2391）：灰条双段「正确答案是 C / 您的答案是 B」+ 三列统计 -->
                <view class="result-card">
                    <view class="result-answer-bar">
                        <view class="result-answer-seg">
                            <text class="result-answer-label">正确答案是</text>
                            <text class="result-answer-value result-value-correct">{{ session.lastResult.value.correct_answer }}</text>
                        </view>
                        <view class="result-answer-seg">
                            <text class="result-answer-label">您的答案是</text>
                            <text class="result-answer-value" :class="session.lastResult.value.correct ? 'result-value-correct' : 'result-value-wrong'">{{ session.lastUserAnswer.value.length > 0 ? session.lastUserAnswer.value : '未作答' }}</text>
                        </view>
                    </view>
                    <view class="stats-row">
                        <view class="stats-item"><text class="stats-label">答题用时</text><text class="stats-value stats-value-primary">{{ session.questionTimeText.value }}</text></view>
                        <view class="stats-divider"></view>
                        <view class="stats-item"><text class="stats-label">全站正确率</text><text class="stats-value stats-value-success">{{ session.siteAccuracy.value }}%</text></view>
                        <view class="stats-divider"></view>
                        <view class="stats-item"><text class="stats-label">难度值</text><text class="stats-value stats-value-wrong">{{ session.difficultyLevel.value }}</text></view>
                    </view>
                </view>
                <!-- AI 解析（原型 452:2391）：标题 + 分享解析药丸 -->
                <view class="section-block">
                    <view class="section-header"><text class="section-title">AI解析</text><view class="section-pill" @click="onShareExplanation"><text class="section-pill-text">分享解析</text></view></view>
                    <text v-if="session.lastResult.value.explanation.length > 0" class="section-content">{{ session.lastResult.value.explanation }}</text>
                    <text v-else class="section-empty">暂无解析</text>
                </view>
                <!-- 评论 -->
                <view class="section-block">
                    <view class="section-header"><text class="section-title">评论</text><view class="section-link" @click="comments.toggleComments(session.currentQuestion.value.question_id)"><text class="section-link-text">{{ comments.showComments.value ? '收起' : '查看所有评论' }}</text></view></view>
                    <view v-if="comments.showComments.value">
                        <view v-for="(c, idx) in comments.comments.value" :key="idx" class="comment-item">
                            <view class="comment-head"><text class="comment-author">{{ c.username }}</text><text class="comment-time">{{ formatTime(c.created_at) }}</text>
                                <view v-if="c.can_delete" class="comment-delete" @click="comments.onDeleteComment(c)"><text class="comment-delete-text">删除</text></view>
                            </view>
                            <text class="comment-content">{{ c.content }}</text>
                        </view>
                        <view v-if="comments.comments.value.length == 0" class="section-empty-wrap"><text class="section-empty-text">暂无评论，快来抢沙发吧~</text></view>
                        <view class="comment-input-bar">
                            <input class="comment-input" v-model="comments.commentText.value" placeholder="写下你的评论..." maxlength="500" />
                            <view class="comment-send-btn" :class="comments.commentText.value.length > 0 ? 'comment-send-active' : ''" @click="comments.onSubmitComment(session.currentQuestion.value.question_id)"><text class="comment-send-text">发表</text></view>
                        </view>
                    </view>
                </view>
                <!-- 考点 -->
                <view class="section-block">
                    <view class="section-header"><text class="section-title">考点</text></view>
                    <view v-if="knowledgeTags.length > 0" class="tag-row">
                        <view v-for="tag in knowledgeTags" :key="tag.id" class="knowledge-tag mr-12-mb-12"><text class="knowledge-tag-text">{{ tag.name }}</text></view>
                    </view>
                    <text v-else class="section-empty">暂无考点信息</text>
                </view>
                <!-- 笔记（原型 452:2391）：「添加笔记」药丸 → 笔记本新增态（NAV_FLOW 边 452:2433 → 769:1854） -->
                <view class="section-block">
                    <view class="section-header"><text class="section-title">笔记</text><view class="section-pill" @click="onOpenNoteEditor"><text class="section-pill-text">{{ notes.noteContent.value.length > 0 ? '查看笔记' : '添加笔记' }}</text></view></view>
                    <text v-if="notes.noteContent.value.length > 0" class="section-content">{{ notes.noteContent.value }}</text>
                </view>
            </view>
            <view class="bottom-placeholder"></view>
        </scroll-view>
        <view v-if="session.questions.value.length > 0" class="bottom-bar">
            <!-- 状态行上移（原型 435:797）后，底条只留动作钮；单题承载无提交/翻题，只有同类题出口 -->
            <view class="bottom-actions">
                <view v-if="isSingle && session.showResult.value" class="submit-btn" @click="onGoPractice"><text class="submit-btn-text">去题库练习同类题</text></view>
                <view v-else-if="!session.showResult.value" class="submit-btn" @click="onSubmit"><text class="submit-btn-text">提交答案</text></view>
                <view v-else class="submit-btn" @click="onNext"><text class="submit-btn-text">{{ session.currentIndex.value >= session.questions.value.length - 1 ? '查看结果' : '下一题' }}</text></view>
            </view>
        </view>
        <!-- 答题卡弹窗（原型 435:903）：标题居中 + 右上 X；单题承载无答题卡 -->
        <view v-if="session.showAnswerCard.value && !isSingle" class="answer-card-mask" @click="session.onCloseAnswerCard()">
            <view class="answer-card-sheet" @click.stop>
                <view class="answer-card-header">
                    <view class="answer-card-header-spacer"></view>
                    <text class="answer-card-title">答题卡</text>
                    <text class="answer-card-close" @click="session.onCloseAnswerCard()">✕</text>
                </view>
                <view class="answer-card-grid">
                    <view v-for="(q, idx) in session.questions.value" :key="idx" class="answer-card-item mr-20-mb-20" :class="session.getAnswerCardClass(idx)" @click="session.onJumpToQuestion(idx)">
                        <text class="answer-card-num" :class="session.getAnswerCardNumClass(idx)">{{ idx + 1 }}</text>
                    </view>
                </view>
                <view class="answer-card-footer"><view class="submit-paper-btn" @click="session.onSubmitPaper()"><text class="submit-paper-text">交卷</text></view></view>
            </view>
        </view>
        <!-- 结果汇总弹窗（单题承载不交卷） -->
        <view v-if="session.showSummary.value && !isSingle" class="summary-mask">
            <view class="summary-box">
                <text class="summary-title">练习完成</text>
                <view class="summary-stats">
                    <view class="summary-stat"><text class="summary-stat-num">{{ session.questions.value.length }}</text><text class="summary-stat-label">总题数</text></view>
                    <view class="summary-stat"><text class="summary-stat-num correct-color">{{ session.correctCount.value }}</text><text class="summary-stat-label">答对</text></view>
                    <view class="summary-stat"><text class="summary-stat-num wrong-color">{{ session.questions.value.length - session.correctCount.value }}</text><text class="summary-stat-label">答错</text></view>
                    <view class="summary-stat"><text class="summary-stat-num">{{ session.summaryAccuracy.value }}%</text><text class="summary-stat-label">正确率</text></view>
                </view>
                <view class="summary-actions">
                    <view class="summary-btn summary-btn-secondary" @click="onExit"><text class="summary-btn-secondary-text">返回</text></view>
                    <view class="summary-btn summary-btn-primary" @click="onRestart"><text class="summary-btn-primary-text">再练一次</text></view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onHide, onUnload } from '@dcloudio/uni-app'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { usePracticeSession } from './composables/usePracticeSession'
    import { usePracticeComments } from './composables/usePracticeComments'
    import { usePracticeNotes } from './composables/usePracticeNotes'
    import { getKnowledgeApi } from '../../api/questionInteraction'
    import type { KnowledgeTag } from '../../types/index'

    const authStore = useAuthStore()
    const currentUserId = computed<number>(() : number => { const u = authStore.user.value; if (u != null) return u.user_id; return 0 })
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const mode = ref<string>('free')
    const practiceCount = ref<number>(20)
    const tagId = ref<number>(0)
    const tagName = ref<string>('')
    /** 单题承载（搜索「题目」落点，ADR-0049 决策 4）：>0 即单题模式，无答题卡/交卷/进度 */
    const questionId = ref<number>(0)
    const isSingle = computed<boolean>(() : boolean => questionId.value > 0)

    const session = usePracticeSession()
    const comments = usePracticeComments(currentUserId.value)
    const notes = usePracticeNotes()
    const knowledgeTags = ref<KnowledgeTag[]>([])

    /** 按卷练习承载（#2463）：卷 id 由会话持有（session.paperId，单一真源），>0 即按卷模式 */
    const isPaper = computed<boolean>(() : boolean => session.paperId.value > 0)
    /** 空态文案：paper 承载优先用会话记下的失败原因（未解锁 / 无已发布题 / 其他），其余承载维持原文案 */
    const emptyText = computed<string>(() : string => {
        if (isPaper.value) return session.errorText.value.length > 0 ? session.errorText.value : '该卷暂无已发布题目'
        return isSingle.value ? '题目不存在或不在当前证件的题库内' : '暂无题目'
    })

    async function loadKnowledge() : Promise<void> {
        const qid = session.currentQuestion.value.question_id
        if (qid <= 0) return
        // 笔记预览随题装载（B3：编辑面在笔记本，这里只读展示）
        notes.loadNote(qid)
        try { knowledgeTags.value = await getKnowledgeApi(qid) } catch (e) { console.warn('[practice-do] loadKnowledge failed:', e) }
    }

    function formatTime(dateStr : string) : string {
        if (dateStr.length == 0) return ''
        const d = new Date(dateStr); const m = d.getMonth() + 1; const day = d.getDate(); const h = d.getHours(); const min = d.getMinutes()
        return (m < 10 ? '0' + m.toString() : m.toString()) + '-' + (day < 10 ? '0' + day.toString() : day.toString()) + ' ' + (h < 10 ? '0' + h.toString() : h.toString()) + ':' + (min < 10 ? '0' + min.toString() : min.toString())
    }

    function onNext() : void { if (isSingle.value) return; session.onNext(); comments.resetComments(); notes.resetNotes(); knowledgeTags.value = []; loadKnowledge() }
    function onSubmit() : void { session.onSubmit(mode.value) }
    function onShareExplanation() : void { uni.showToast({ title: '分享功能开发中', icon: 'none' }) }
    function onBack() : void { goBack() }
    function onExit() : void { session.stopTimer(); goBack() }
    function onGoPractice() : void { uni.navigateTo({ url: '/pages/practice/practice' }) }

    /**
     * 笔记出口（B3，NAV_FLOW 边 452:2433「添加笔记」→ 769:1854）：跳笔记本新增态挂该题；
     * 保存后回本页即解析态。笔记内容读取/删除仍走 usePracticeNotes（loadNote 供预览），
     * 编辑面收敛到笔记本一处 —— practice-do 不再有第二份编辑器。
     */
    function onOpenNoteEditor() : void {
        const qid = session.currentQuestion.value.question_id
        if (qid <= 0) { uni.navigateTo({ url: '/pages/profile/notebook' }); return }
        uni.navigateTo({ url: '/pages/profile/notebook?edit=1&question_id=' + qid.toString() })
    }

    /** 单题模式重载（「再练一次」语义收敛为重新拉这道题） */
    function onReloadSingle() : void { session.onRestart(); comments.resetComments(); notes.resetNotes(); knowledgeTags.value = []; session.loadQuestions('single', practiceCount.value, tagId.value, questionId.value); loadKnowledge() }

    /** 按卷的「再练一次」= 重新按卷取题但**不读回**旧进度（resume=false），旧进度行仍留着等下次续练覆盖 */
    function onReloadPaper() : void { session.onRestart(); comments.resetComments(); notes.resetNotes(); knowledgeTags.value = []; session.loadPaperQuestions(session.paperId.value, false); loadKnowledge() }

    function onRestart() : void { if (isSingle.value) { onReloadSingle(); return }; if (isPaper.value) { onReloadPaper(); return }; session.onRestart(); comments.resetComments(); notes.resetNotes(); knowledgeTags.value = []; session.loadQuestions(mode.value, practiceCount.value, tagId.value, 0); loadKnowledge() }

    onLoad((options : UTSJSONObject) => {
        const m = options['mode']; if (m != null) mode.value = m.toString()
        const cnt = options['count']; if (cnt != null) practiceCount.value = parseInt(cnt.toString())
        const tagIdParam = options['tag_id']; if (tagIdParam != null) tagId.value = parseInt(tagIdParam.toString())
        const tagNameParam = options['tag_name']; if (tagNameParam != null) { tagName.value = decodeURIComponent(tagNameParam.toString()) ?? '' }
        const qidParam = options['question_id']
        if (qidParam != null) {
            const parsed = parseInt(qidParam.toString())
            if (!isNaN(parsed) && parsed > 0) { questionId.value = parsed; mode.value = 'single' }
        }
        // 按卷练习承载（#2463）：paper_id 存在即按卷；提交练习类型固定 paper（后端封闭枚举）
        const pidParam = options['paper_id']
        if (pidParam != null) {
            const parsedPid = parseInt(pidParam.toString())
            if (!isNaN(parsedPid) && parsedPid > 0) { session.paperId.value = parsedPid; mode.value = 'paper' }
        }
        if (isPaper.value) { session.loadPaperQuestions(session.paperId.value, true) } else { session.loadQuestions(mode.value, practiceCount.value, tagId.value, questionId.value) }
        loadKnowledge()
    })

    // 系统返回键/手势返回不走 onExit（#1727）：页面隐藏/销毁时必须停表，避免计时随页面引用在后台继续递增。
    // 按卷练习还要顺手存一次进度（AC③）：只提交才存的话，跳到第 N 题没作答就退出会丢掉游标。
    onHide(() : void => {
        session.stopTimer()
        if (isPaper.value) session.saveProgress('paper', 0)
    })

    onUnload(() : void => {
        session.stopTimer()
        if (isPaper.value) session.saveProgress('paper', 0)
    })
</script>

<style lang="scss">
    .page { display: flex; background-color: $bg-color; flex-direction: column; }

    /* 状态行（原型 435:797）：导航下独立一行，计时+进度在左、答题卡/星标在右 */
    .status-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 16rpx 24rpx;
        background-color: $bg-header;
    }
    .status-left { flex-direction: row; align-items: center; }
    .status-timer { font-size: 28rpx; color: $text-color; }
    .status-progress { font-size: 30rpx; color: $text-color; font-weight: 600; margin-left: 32rpx; }
    .status-progress-total { font-size: 24rpx; color: $text-color-placeholder; font-weight: 400; }
    .status-actions { flex-direction: row; align-items: center; }
    .status-icon { font-size: 40rpx; padding: 8rpx 0 8rpx 32rpx; }

    .content-scroll { flex: 1; height: 0; }
    /* 题卡（原型 435:797）：chip+题干+选项同卡 */
    .question-card { margin: 24rpx; background-color: $card-bg; border-radius: $radius-card; padding: 32rpx; flex-direction: column; }
    .question-type-row { flex-direction: row; margin-bottom: 16rpx; }
    .question-type-tag { font-size: 24rpx; color: $primary-color; background-color: $primary-tint; padding: 8rpx 20rpx; border-radius: $radius-sm; }
    .question-title { font-size: 32rpx; color: $text-color; line-height: 52rpx; margin-bottom: 8rpx; }
    .option-list { padding-top: 16rpx; flex-direction: column; }
    .option-item { flex-direction: row; align-items: center; padding: 24rpx 0; border-radius: $radius-md; margin-bottom: 8rpx; }
    .option-selected { background-color: $primary-tint; }
    .option-key { width: 60rpx; height: 60rpx; border-radius: 30rpx; background-color: $card-bg; border: 2rpx solid $border-color; align-items: center; justify-content: center; margin-right: 24rpx; }
    .option-key-selected { border-color: $primary-color; background-color: $primary-color; }
    .option-key-correct { border-color: $success-color; background-color: $success-color; }
    .option-key-wrong { border-color: $answer-wrong; background-color: $answer-wrong; }
    .option-key-text { font-size: 28rpx; font-weight: 600; color: $text-color-secondary; }
    .option-key-selected .option-key-text { color: $card-bg; }
    .option-key-icon { font-size: 28rpx; font-weight: bold; color: $card-bg; }
    .option-text { flex: 1; font-size: 30rpx; color: $text-color; line-height: 44rpx; }

    /* 对错卡（原型 452:2391）：白卡内灰条双段 + 三列统计 */
    .result-section { padding: 0 24rpx; flex-direction: column; }
    .result-card { background-color: $card-bg; border-radius: $radius-card; padding: 24rpx; margin-bottom: 20rpx; flex-direction: column; }
    .result-answer-bar { background-color: $bg-color; border-radius: $radius-md; padding: 24rpx; flex-direction: row; justify-content: space-around; margin-bottom: 24rpx; }
    .result-answer-seg { flex-direction: row; align-items: center; }
    .result-answer-label { font-size: 28rpx; color: $text-color; }
    .result-answer-value { font-size: 28rpx; font-weight: bold; margin-left: 8rpx; }
    .result-value-correct { color: $success-color; }
    .result-value-wrong { color: $answer-wrong; }
    .stats-row { flex-direction: row; align-items: center; padding: 8rpx 0; }
    .stats-item { flex: 1; flex-direction: column; align-items: center; justify-content: center; }
    .stats-label { font-size: 24rpx; color: $text-color-secondary; margin-bottom: 8rpx; }
    .stats-value { font-size: 34rpx; font-weight: bold; }
    .stats-value-primary { color: $primary-color; }
    .stats-value-success { color: $success-color; }
    .stats-value-wrong { color: $answer-wrong; }
    .stats-divider { width: 1rpx; height: 48rpx; background-color: $border-color-light; }

    .section-block { background-color: $card-bg; border-radius: $radius-card; padding: 24rpx; margin-bottom: 20rpx; flex-direction: column; }
    .section-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
    .section-title { font-size: 30rpx; color: $text-color; font-weight: 600; }
    /* 药丸动作（原型 452:2391「分享解析 / 添加笔记」）：浅蓝底 + 主色字 */
    .section-pill { background-color: $primary-tint; border-radius: $radius-pill; padding: 10rpx 28rpx; }
    .section-pill-text { font-size: 24rpx; color: $primary-color; }
    .section-link { padding: 8rpx 16rpx; }
    .section-link-text { font-size: 26rpx; color: $primary-color; }
    .section-content { font-size: 28rpx; color: $text-color-secondary; line-height: 44rpx; }
    .section-empty { font-size: 26rpx; color: $text-disabled; }
    .tag-row { flex-direction: row; flex-wrap: wrap; }
    .knowledge-tag { background-color: $primary-tint; border-radius: $radius-sm; padding: 8rpx 20rpx; }
    .knowledge-tag-text { font-size: 24rpx; color: $primary-color; }
    .comment-item { padding: 20rpx 0; border-bottom: 1rpx solid $bg-color; flex-direction: column; }
    .comment-head { flex-direction: row; align-items: center; margin-bottom: 12rpx; }
    .comment-author { font-size: 26rpx; color: $text-color; font-weight: 500; margin-right: 16rpx; }
    .comment-time { font-size: 22rpx; color: $text-disabled; flex: 1; }
    .comment-delete { padding: 6rpx 16rpx; border: 1rpx solid $answer-wrong; border-radius: $radius-sm; }
    .comment-delete-text { font-size: 22rpx; color: $answer-wrong; }
    .comment-content { font-size: 28rpx; color: $text-color-secondary; line-height: 42rpx; }
    .section-empty-wrap { padding: 20rpx 0; align-items: center; }
    .section-empty-text { font-size: 26rpx; color: $text-disabled; }
    .comment-input-bar { flex-direction: row; align-items: center; margin-top: 16rpx; }
    .comment-input { flex: 1; height: 72rpx; background-color: $bg-color; border-radius: 36rpx; padding: 0 28rpx; font-size: 26rpx; color: $text-color; }
    .comment-send-btn { margin-left: 16rpx; padding: 16rpx 28rpx; border-radius: 36rpx; background-color: $tag-bg-neutral; }
    .comment-send-active { background-color: $primary-color; }
    .comment-send-text { font-size: 26rpx; color: $card-bg; font-weight: 500; }

    /* 底条：状态行上移后只留动作钮 */
    .bottom-bar { padding: 16rpx 24rpx; padding-bottom: 32rpx; background-color: $bg-header; border-top: 1rpx solid $border-color-light; }
    .bottom-actions { flex-direction: row; align-items: center; }
    /* 提交/翻题钮（B3 实测：435/452 主按钮原型为实底主色，未走渐变） */
    .submit-btn { flex: 1; align-items: center; padding: 26rpx 0; border-radius: 48rpx; background-color: $primary-color; }
    .submit-btn-text { font-size: 32rpx; font-weight: 600; color: $card-bg; }
    .bottom-placeholder { height: 40rpx; }
    .loading-wrap { flex: 1; align-items: center; justify-content: center; }
    .empty-wrap { flex: 1; align-items: center; justify-content: center; }
    .loading-text { font-size: 28rpx; color: $text-color-placeholder; }
    .empty-text { font-size: 28rpx; color: $text-color-placeholder; }

    /* 答题卡弹层（原型 435:903）：标题居中 + 右上 X，宫格当前题实底主色 */
    .answer-card-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: $uni-bg-color-mask; justify-content: flex-end; }
    .answer-card-sheet { background-color: $card-bg; border-radius: 32rpx 32rpx 0 0; padding: 40rpx 32rpx; padding-bottom: 48rpx; flex-direction: column; max-height: 960rpx; }
    .answer-card-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 40rpx; }
    .answer-card-header-spacer { width: 64rpx; height: 44rpx; }
    .answer-card-title { font-size: 34rpx; font-weight: 600; color: $text-color; }
    .answer-card-close { width: 64rpx; height: 44rpx; font-size: 32rpx; color: $text-color; text-align: right; }
    .answer-card-grid { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }
    .answer-card-item { width: 100rpx; height: 100rpx; border-radius: 50rpx; align-items: center; justify-content: center; background-color: $bg-color; }
    .card-item-current { background-color: $primary-color; }
    .card-item-correct { background-color: $primary-tint; }
    .card-item-wrong { background-color: $primary-tint; }
    .card-item-default { background-color: $bg-color; }
    .answer-card-num { font-size: 28rpx; color: $text-color-secondary; }
    .card-num-current { color: $card-bg; font-weight: bold; }
    .card-num-answered { color: $primary-color; font-weight: bold; }
    .card-num-default { color: $text-color-secondary; }
    .answer-card-footer { margin-top: 40rpx; flex-direction: row; justify-content: center; }
    .submit-paper-btn { background-color: $primary-color; border-radius: 48rpx; padding: 26rpx 0; align-items: center; justify-content: center; width: 100%; }
    .submit-paper-text { font-size: 32rpx; font-weight: 600; color: $card-bg; }

    .summary-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6); justify-content: center; align-items: center; }
    .summary-box { width: 600rpx; background-color: $card-bg; border-radius: 24rpx; padding: 48rpx 32rpx; align-items: center; }
    .summary-title { font-size: 36rpx; font-weight: bold; color: $text-color; margin-bottom: 40rpx; }
    .summary-stats { flex-direction: row; justify-content: space-around; margin-bottom: 40rpx; align-self: stretch; }
    .summary-stat { flex-direction: column; align-items: center; }
    .summary-stat-num { font-size: 44rpx; font-weight: bold; color: $text-color; margin-bottom: 8rpx; }
    .correct-color { color: $success-color; }
    .wrong-color { color: $answer-wrong; }
    .summary-stat-label { font-size: 22rpx; color: $text-color-placeholder; }
    .summary-actions { flex-direction: row; align-self: stretch; }
    .summary-btn { flex: 1; align-items: center; padding: 24rpx 0; border-radius: 48rpx; margin: 0 12rpx; }
    .summary-btn-secondary { background-color: $bg-color; }
    .summary-btn-primary { background-color: $primary-color; }
    .summary-btn-primary-text { font-size: 28rpx; font-weight: bold; color: $card-bg; }
    .summary-btn-secondary-text { font-size: 28rpx; font-weight: bold; color: $text-color-secondary; }
    .mr-12-mb-12 { margin-right: 12rpx; margin-bottom: 12rpx; }
    .mr-20-mb-20 { margin-right: 20rpx; margin-bottom: 20rpx; }
</style>
