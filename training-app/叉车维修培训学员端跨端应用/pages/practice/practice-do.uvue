<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-left" @click="onBack">
                <text class="nav-back">‹</text>
            </view>
            <view class="nav-center">
                <text class="nav-timer">⏱ {{ session.timerText.value }}</text>
                <text class="nav-progress ml-24">{{ session.currentIndex.value + 1 }}/{{ session.questions.value.length }}</text>
            </view>
            <view class="nav-right"></view>
        </view>

        <!-- 加载中 -->
        <view v-if="session.loading.value && session.questions.value.length == 0" class="loading-wrap">
            <text class="loading-text">正在加载题目...</text>
        </view>

        <!-- 空数据 -->
        <view v-else-if="session.questions.value.length == 0" class="empty-wrap">
            <text class="empty-text">暂无题目</text>
        </view>

        <!-- 答题区域 -->
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <!-- 题目区域 -->
            <view class="question-section">
                <view class="question-type-row">
                    <text class="question-type-tag">{{ session.getTypeName(session.currentQuestion.value.type) }}</text>
                </view>
                <text class="question-title">{{ session.currentQuestion.value.title }}</text>
            </view>

            <!-- 选项列表 -->
            <view class="option-list">
                <view v-for="(opt, idx) in session.currentQuestion.value.options" :key="idx"
                    class="option-item"
                    :class="session.getOptionClass(opt.key)"
                    @click="session.onOptionClick(opt.key)">
                    <view class="option-key" :class="session.getOptionKeyClass(opt.key)">
                        <text v-if="session.showResult.value && session.isCorrectAnswer(opt.key)" class="option-key-icon">✓</text>
                        <text v-else-if="session.showResult.value && session.isSelected(opt.key) && !session.isCorrectAnswer(opt.key)" class="option-key-icon">✗</text>
                        <text v-else class="option-key-text">{{ opt.key }}</text>
                    </view>
                    <text class="option-text" :class="session.getOptionTextClass(opt.key)">{{ opt.text }}</text>
                </view>
            </view>

            <!-- 答题结果区域 -->
            <view v-if="session.showResult.value" class="result-section">
                <view class="result-answer-box">
                    <text class="result-answer-line">正确答案是 <text class="result-correct-text">{{ session.lastResult.value.correct_answer }}</text>，您的答案是 <text :class="session.lastResult.value.correct ? 'result-correct-text' : 'result-wrong-text'">{{ session.lastUserAnswer.value.length > 0 ? session.lastUserAnswer.value : '未作答' }}</text></text>
                </view>

                <view class="stats-row">
                    <view class="stats-item">
                        <text class="stats-label">做题时长</text>
                        <text class="stats-value">{{ session.questionTimeText.value }}</text>
                    </view>
                    <view class="stats-divider"></view>
                    <view class="stats-item">
                        <text class="stats-label">全站正确率</text>
                        <text class="stats-value">{{ session.siteAccuracy.value }}%</text>
                    </view>
                    <view class="stats-divider"></view>
                    <view class="stats-item">
                        <text class="stats-label">难度值</text>
                        <text class="stats-value">{{ session.difficultyLevel.value }}</text>
                    </view>
                </view>

                <!-- AI 解析 -->
                <view class="section-block">
                    <view class="section-header">
                        <text class="section-title">AI 解析</text>
                        <view class="section-action" @click="onShareExplanation">
                            <text class="section-action-text">分享解析</text>
                        </view>
                    </view>
                    <text v-if="session.lastResult.value.explanation.length > 0" class="section-content">{{ session.lastResult.value.explanation }}</text>
                    <text v-else class="section-empty">暂无解析</text>
                </view>

                <!-- 评论 -->
                <QuestionCommentSection
                    :expanded="comments.showComments.value"
                    :comments="comments.comments.value"
                    :commentText="comments.commentText.value"
                    @toggle="comments.toggleComments(session.currentQuestion.value.question_id)"
                    @submit="comments.onSubmitComment(session.currentQuestion.value.question_id)"
                    @delete="comments.onDeleteComment($event)"
                />

                <!-- 考点 -->
                <QuestionKnowledgeTags :tags="knowledgeTags" />

                <!-- 笔记 -->
                <QuestionNoteSection
                    :expanded="notes.showNote.value"
                    :content="notes.noteContent.value"
                    @toggle="notes.toggleNote(session.currentQuestion.value.question_id)"
                    @save="notes.onSaveNote(session.currentQuestion.value.question_id)"
                    @delete="notes.onDeleteNote(session.currentQuestion.value.question_id)"
                />
            </view>

            <view class="bottom-placeholder"></view>
        </scroll-view>

        <!-- 底部操作栏 -->
        <view v-if="session.questions.value.length > 0" class="bottom-bar">
            <view class="bottom-actions">
                <view class="bottom-icon-btn" @click="session.onToggleAnswerCard()">
                    <image class="bottom-icon-img" src="/static/icons/answer-card.png" mode="aspectFit" />
                    <text class="bottom-icon-label">答题卡</text>
                </view>
                <view class="bottom-icon-btn ml-16" @click="session.onToggleFavorite()">
                    <image class="bottom-icon-img" :src="session.isFavorited.value ? '/static/icons/star-filled.png' : '/static/icons/star.png'" mode="aspectFit" />
                    <text class="bottom-icon-label">{{ session.isFavorited.value ? '已收藏' : '收藏' }}</text>
                </view>
                <view v-if="!session.showResult.value" class="submit-btn ml-16" @click="onSubmit">
                    <text class="submit-btn-text">提交答案</text>
                </view>
                <view v-else class="submit-btn next-btn ml-16" @click="onNext">
                    <text class="submit-btn-text">{{ session.currentIndex.value >= session.questions.value.length - 1 ? '查看结果' : '下一题' }}</text>
                </view>
            </view>
        </view>

        <!-- 答题卡弹窗 -->
        <AnswerCardSheet
            :visible="session.showAnswerCard.value"
            :questions="session.questions.value"
            :currentIndex="session.currentIndex.value"
            :answerStates="session.answerStates.value"
            @close="session.onCloseAnswerCard()"
            @jump="session.onJumpToQuestion($event)"
            @submit-paper="session.onSubmitPaper()"
        />

        <!-- 结果汇总弹窗 -->
        <PracticeSummaryDialog
            :visible="session.showSummary.value"
            :totalCount="session.questions.value.length"
            :correctCount="session.correctCount.value"
            :accuracy="session.summaryAccuracy.value"
            @exit="onExit"
            @restart="onRestart"
        />
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import { usePracticeSession } from './composables/usePracticeSession'
    import { usePracticeComments } from './composables/usePracticeComments'
    import { usePracticeNotes } from './composables/usePracticeNotes'
    import { getKnowledgeApi } from '../../api/questionInteraction'
    import type { KnowledgeTag } from '../../types/index'
    import AnswerCardSheet from './components/answer-card-sheet.uvue'
    import PracticeSummaryDialog from './components/practice-summary-dialog.uvue'
    import QuestionCommentSection from './components/question-comment-section.uvue'
    import QuestionKnowledgeTags from './components/question-knowledge-tags.uvue'
    import QuestionNoteSection from './components/question-note-section.uvue'

    const authStore = useAuthStore()
    const currentUserId = computed<number>(() : number => {
        const u = authStore.user.value
        if (u != null) return u.user_id
        return 0
    })

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 页面参数
    const mode = ref<string>('free')
    const practiceCount = ref<number>(20)
    const tagId = ref<number>(0)
    const tagName = ref<string>('')

    // composables
    const session = usePracticeSession()
    const comments = usePracticeComments(currentUserId.value)
    const notes = usePracticeNotes()
    const knowledgeTags = ref<KnowledgeTag[]>([])

    // 考点加载
    async function loadKnowledge() : Promise<void> {
        const qid = session.currentQuestion.value.question_id
        if (qid <= 0) return
        try {
            knowledgeTags.value = await getKnowledgeApi(qid)
        } catch (e) {
            console.warn('[practice-do] loadKnowledge failed:', e)
        }
    }

    // 包装 session 的 onNext，额外重置互动状态
    function onNext() : void {
        session.onNext()
        comments.resetComments()
        notes.resetNotes()
        knowledgeTags.value = []
        loadKnowledge()
    }

    // 包装 session 的 onJumpToQuestion，额外重置互动状态
    const origJump = session.onJumpToQuestion
    function onJumpToQuestion(idx : number) : void {
        origJump(idx)
        comments.resetComments()
        notes.resetNotes()
        knowledgeTags.value = []
        loadKnowledge()
    }

    function onSubmit() : void {
        session.onSubmit(mode.value)
    }

    function onShareExplanation() : void {
        uni.showToast({ title: '分享功能开发中', icon: 'none' })
    }

    function onExit() : void {
        session.stopTimer()
        goBack()
    }

    function onRestart() : void {
        session.onRestart()
        comments.resetComments()
        notes.resetNotes()
        knowledgeTags.value = []
        session.loadQuestions(mode.value, practiceCount.value, tagId.value)
        loadKnowledge()
    }

    onLoad((options : UTSJSONObject) => {
        const m = options['mode']
        if (m != null) mode.value = `${m}`
        const cnt = options['count']
        if (cnt != null) practiceCount.value = parseInt(`${cnt}`)
        const tagIdParam = options['tag_id']
        if (tagIdParam != null) tagId.value = parseInt(`${tagIdParam}`)
        const tagNameParam = options['tag_name']
        if (tagNameParam != null) {
            const decoded = decodeURIComponent(`${tagNameParam}`)
            tagName.value = decoded ?? ''
        }
        session.loadQuestions(mode.value, practiceCount.value, tagId.value)
        loadKnowledge()
    })
</script>

<style>
    .page {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }
    .status-bar { background-color: #ffffff; }
    .nav-bar {
        background-color: #ffffff;
        padding: 16rpx 24rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1rpx solid #f0f0f0;
    }
    .nav-left {
        width: 80rpx;
        height: 72rpx;
        align-items: flex-start;
        justify-content: center;
    }
    .nav-back { font-size: 52rpx; color: #333333; font-weight: 300; }
    .nav-center {
        flex: 1;
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }
    .nav-timer { font-size: 26rpx; color: #999999; }
    .nav-progress { font-size: 28rpx; color: #333333; font-weight: 500; }
    .nav-right {
        width: 120rpx;
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
    }
    .content-scroll { flex: 1; height: 0; }
    .question-section { padding: 32rpx 32rpx 0; }
    .question-type-row { flex-direction: row; margin-bottom: 16rpx; }
    .question-type-tag {
        font-size: 24rpx;
        color: #2979ff;
        background-color: #e8f0fe;
        padding: 6rpx 20rpx;
        border-radius: 8rpx;
        overflow: hidden;
    }
    .question-title {
        font-size: 32rpx;
        color: #333333;
        line-height: 52rpx;
        margin-bottom: 32rpx;
    }
    .option-list { padding: 0 32rpx; flex-direction: column; }
    .option-item {
        flex-direction: row;
        align-items: center;
        padding: 28rpx 24rpx;
        background-color: #ffffff;
        border-radius: 16rpx;
        margin-bottom: 20rpx;
        border: 2rpx solid #f0f0f0;
    }
    .option-selected { background-color: #f0f7ff; border-color: #2979ff; }
    .option-correct { background-color: #f0faf0; border-color: #4caf50; }
    .option-wrong { background-color: #fff5f5; border-color: #f44336; }
    .option-key {
        width: 60rpx;
        height: 60rpx;
        border-radius: 30rpx;
        background-color: #f0f0f0;
        align-items: center;
        justify-content: center;
        margin-right: 24rpx;
    }
    .option-key-selected { background-color: #2979ff; }
    .option-key-correct { background-color: #4caf50; }
    .option-key-wrong { background-color: #f44336; }
    .option-key-text { font-size: 28rpx; font-weight: 600; color: #666666; }
    .option-key-selected .option-key-text { color: #ffffff; }
    .option-key-icon { font-size: 28rpx; font-weight: bold; color: #ffffff; }
    .option-text { flex: 1; font-size: 30rpx; color: #333333; line-height: 44rpx; }
    .option-text-correct { color: #4caf50; }
    .option-text-wrong { color: #f44336; }
    .result-section { padding: 32rpx; flex-direction: column; }
    .result-answer-box {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 28rpx;
        margin-bottom: 24rpx;
        border: 1rpx solid #f0f0f0;
    }
    .result-answer-line { font-size: 28rpx; color: #333333; line-height: 44rpx; }
    .result-correct-text { color: #4caf50; font-weight: bold; }
    .result-wrong-text { color: #f44336; font-weight: bold; }
    .stats-row {
        flex-direction: row;
        align-items: center;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx 0;
        margin-bottom: 24rpx;
        border: 1rpx solid #f0f0f0;
    }
    .stats-item { flex: 1; flex-direction: column; align-items: center; justify-content: center; }
    .stats-label { font-size: 22rpx; color: #999999; margin-bottom: 8rpx; }
    .stats-value { font-size: 28rpx; color: #333333; font-weight: 600; }
    .stats-divider { width: 1rpx; height: 48rpx; background-color: #f0f0f0; }
    .section-block {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 28rpx;
        margin-bottom: 20rpx;
        border: 1rpx solid #f0f0f0;
        flex-direction: column;
    }
    .section-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16rpx;
    }
    .section-title { font-size: 30rpx; color: #333333; font-weight: 600; }
    .section-action { padding: 8rpx 16rpx; }
    .section-action-text { font-size: 24rpx; color: #2979ff; }
    .section-content { font-size: 28rpx; color: #666666; line-height: 44rpx; }
    .section-empty { font-size: 26rpx; color: #cccccc; }
    .bottom-bar {
        padding: 16rpx 24rpx;
        padding-bottom: 32rpx;
        background-color: #ffffff;
        border-top: 1rpx solid #f0f0f0;
    }
    .bottom-actions { flex-direction: row; align-items: center; }
    .bottom-icon-btn {
        width: 100rpx;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 8rpx 0;
    }
    .bottom-icon-img { width: 44rpx; height: 44rpx; margin-bottom: 4rpx; }
    .bottom-icon-label { font-size: 20rpx; color: #999999; }
    .submit-btn {
        flex: 1;
        align-items: center;
        padding: 26rpx 0;
        border-radius: 48rpx;
        background-color: #2979ff;
    }
    .next-btn { background-color: #2979ff; }
    .submit-btn-text { font-size: 32rpx; font-weight: 600; color: #ffffff; }
    .bottom-placeholder { height: 120rpx; }
    .loading-wrap { flex: 1; align-items: center; justify-content: center; }
    .empty-wrap { flex: 1; align-items: center; justify-content: center; }
    .loading-text { font-size: 28rpx; color: #999999; }
    .empty-text { font-size: 28rpx; color: #999999; }
    .ml-16 { margin-left: 16rpx; }
    .ml-24 { margin-left: 24rpx; }
</style>