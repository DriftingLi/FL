    .comment-send-text { font-size: 26rpx; color: #ffffff; font-weight: 500; }
    .note-area { flex-direction: column; }
    .note-textarea { width: 100%; min-height: 200rpx; background-color: #fafafa; border: 1rpx solid #f0f0f0; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; color: #333333; line-height: 44rpx; }
    .note-actions { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 12rpx; }
    .note-delete-btn { padding: 8rpx 16rpx; }
    .note-delete-text { font-size: 24rpx; color: #f44336; }
    .note-autosave { font-size: 22rpx; color: #cccccc; }
    .bottom-bar { padding: 16rpx 24rpx; padding-bottom: 32rpx; background-color: #ffffff; border-top: 1rpx solid #f0f0f0; }
    .bottom-actions { flex-direction: row; align-items: center; }
    .bottom-icon-btn { width: 100rpx; flex-direction: column; align-items: center; justify-content: center; padding: 8rpx 0; }
    .bottom-icon-img { width: 44rpx; height: 44rpx; margin-bottom: 4rpx; }
    .bottom-icon-label { font-size: 20rpx; color: #999999; }
    .submit-btn { flex: 1; align-items: center; padding: 26rpx 0; border-radius: 48rpx; background-color: #2979ff; }
    .next-btn { background-color: #2979ff; }
    .submit-btn-text { font-size: 32rpx; font-weight: 600; color: #ffffff; }
    .bottom-placeholder { height: 120rpx; }
    .loading-wrap { flex: 1; align-items: center; justify-content: center; }
    .empty-wrap { flex: 1; align-items: center; justify-content: center; }
    .loading-text { font-size: 28rpx; color: #999999; }
    .empty-text { font-size: 28rpx; color: #999999; }
    .answer-card-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); justify-content: flex-end; }
    .answer-card-sheet { background-color: #ffffff; border-radius: 32rpx 32rpx 0 0; padding: 40rpx 32rpx; padding-bottom: 48rpx; flex-direction: column; max-height: 960rpx; }
    .answer-card-header { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 40rpx; }
    .answer-card-title { font-size: 34rpx; font-weight: bold; color: #333333; }
    .answer-card-grid { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }
    .answer-card-item { width: 100rpx; height: 100rpx; border-radius: 50rpx; align-items: center; justify-content: center; border: 2rpx solid #e0e0e0; background-color: #ffffff; }
    .card-item-current { border-color: #2979ff; background-color: #ffffff; }
    .card-item-correct { border-color: #2979ff; background-color: #2979ff; }
    .card-item-wrong { border-color: #2979ff; background-color: #2979ff; }
    .card-item-default { border-color: #e0e0e0; background-color: #ffffff; }
    .answer-card-num { font-size: 28rpx; color: #666666; }
    .card-num-current { color: #2979ff; font-weight: bold; }
    .card-num-answered { color: #ffffff; font-weight: bold; }
    .card-num-default { color: #666666; }
    .answer-card-footer { margin-top: 40rpx; flex-direction: row; justify-content: center; }
    .submit-paper-btn { background-color: #2979ff; border-radius: 48rpx; padding: 26rpx 0; align-items: center; justify-content: center; width: 100%; }
    .submit-paper-text { font-size: 32rpx; font-weight: 600; color: #ffffff; }
    .summary-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6); justify-content: center; align-items: center; }
    .summary-box { width: 600rpx; background-color: #ffffff; border-radius: 24rpx; padding: 48rpx 32rpx; align-items: center; }
    .summary-title { font-size: 36rpx; font-weight: bold; color: #333333; margin-bottom: 40rpx; }
    .summary-stats { flex-direction: row; justify-content: space-around; margin-bottom: 40rpx; align-self: stretch; }
    .summary-stat { flex-direction: column; align-items: center; }
    .summary-stat-num { font-size: 44rpx; font-weight: bold; color: #333333; margin-bottom: 8rpx; }
    .correct-color { color: #4caf50; }
    .wrong-color { color: #f44336; }
    .summary-stat-label { font-size: 22rpx; color: #999999; }
    .summary-actions { flex-direction: row; align-self: stretch; }
    .summary-btn { flex: 1; align-items: center; padding: 24rpx 0; border-radius: 48rpx; margin: 0 12rpx; }
    .summary-btn-secondary { background-color: #f5f5f5; }
    .summary-btn-primary { background-color: #2979ff; }
    .summary-btn-primary-text { font-size: 28rpx; font-weight: bold; color: #ffffff; }
    .summary-btn-secondary-text { font-size: 28rpx; font-weight: bold; color: #666666; }
    .ml-16 { margin-left: 16rpx; }
    .ml-24 { margin-left: 24rpx; }
    .mr-12-mb-12 { margin-right: 12rpx; margin-bottom: 12rpx; }
    .mr-20-mb-20 { margin-right: 20rpx; margin-bottom: 20rpx; }
</style>