<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="帮助中心" variant="inverse" @left-click="onBack" />

        <!-- 端上搜索：问题或答案命中即算（口径同 Web 帮助中心，不新增搜索接口） -->
        <view class="search-bar">
            <text class="search-icon">🔍</text>
            <input class="search-input" type="text" v-model="keyword" placeholder="搜索问题关键词"
                confirm-type="search" />
            <view v-if="keyword.length > 0" class="search-clear" @click="onClearKeyword">
                <text class="search-clear-text">✕</text>
            </view>
        </view>

        <!-- 分类切换：数字为当前搜索命中数 -->
        <scroll-view v-if="hasCategories" class="category-scroll" scroll-x="true">
            <view v-for="(c, idx) in categoryNav" :key="c.code" class="category-chip"
                :class="{ 'category-chip-active': c.active }" @click="onSelectCategory(c.code)">
                <text class="category-text" :class="{ 'category-text-active': c.active }">{{ c.label }}</text>
            </view>
        </scroll-view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 加载态 -->
            <view v-if="loading" class="state-tip">
                <text class="state-text">加载中...</text>
            </view>

            <!-- 失败态：给重试位，不伪装成「暂无内容」 -->
            <view v-if="!loading && failed" class="state-tip">
                <text class="state-icon">📡</text>
                <text class="state-text">帮助内容加载失败</text>
                <view class="state-btn" @click="reload">
                    <text class="state-btn-text">重试</text>
                </view>
            </view>

            <!-- 空态：接口无内容，或搜索无命中 -->
            <view v-if="!loading && !failed && groups.length == 0" class="state-tip">
                <text class="state-icon">{{ emptyIcon }}</text>
                <text class="state-text">{{ emptyText }}</text>
            </view>

            <!-- 问答分组：折叠 Q&A -->
            <view class="group-list">
                <view v-for="(g, gi) in groups" :key="g.code" class="group-card">
                    <text v-if="g.title.length > 0" class="group-title">{{ g.title }}</text>
                    <view v-for="(e, ei) in g.entries" :key="e.id" class="entry">
                        <view class="entry-head" @click="onToggle(e.id)">
                            <text class="entry-question">{{ e.question }}</text>
                            <text class="entry-arrow">{{ isExpanded(e.id) ? '▾' : '▸' }}</text>
                        </view>
                        <view v-if="isExpanded(e.id)" class="entry-answer-box">
                            <text class="entry-answer">{{ e.answer }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 服务区（#1950）：反馈有落点（提交 + 历史），「在线客服」落到 AI 助手（送审要求客服可达）。
                 三条入口都在内容滚动区底部，搜索/分类切换不影响它 —— 它不属于 FAQ 内容，属服务入口。 -->
            <view class="service-card">
                <text class="service-title">服务</text>
                <view class="service-row" @click="onOpenFeedback">
                    <text class="service-label">意见反馈</text>
                    <text class="service-desc">问题提交后有落点，可附图</text>
                    <text class="service-arrow">▸</text>
                </view>
                <view class="service-row" @click="onToggleHistory">
                    <text class="service-label">我的反馈</text>
                    <text class="service-desc">查看处理状态</text>
                    <text class="service-arrow">{{ historyVisible ? '▾' : '▸' }}</text>
                </view>
                <view class="service-row" @click="onOpenCustomerService">
                    <text class="service-label">在线客服</text>
                    <text class="service-desc">AI 学助手，随时可问</text>
                    <text class="service-arrow">▸</text>
                </view>

                <!-- 历史列表：点「我的反馈」就地展开，不另开一页（提交成功自动重拉） -->
                <view v-if="historyVisible" class="history-box">
                    <view v-if="historyLoading" class="history-tip">
                        <text class="history-tip-text">加载中...</text>
                    </view>
                    <view v-if="!historyLoading && historyFailed" class="history-tip" @click="loadHistory">
                        <text class="history-tip-text">反馈列表加载失败，点此重试</text>
                    </view>
                    <view v-if="!historyLoading && !historyFailed && historyItems.length == 0" class="history-tip">
                        <text class="history-tip-text">还没有提交过反馈</text>
                    </view>
                    <view v-for="item in historyItems" :key="item.id" class="history-item">
                        <view class="history-head">
                            <text class="history-status"
                                :class="{ 'history-status-handled': item.status == handledStatus }">{{ statusText(item.status) }}</text>
                            <text class="history-time">{{ item.created_at }}</text>
                        </view>
                        <text class="history-content">{{ item.content }}</text>
                        <note-image-strip v-if="item.images.length > 0" :urls="item.images"
                            :max="imageMax" :editable="false" />
                        <text v-if="item.contact.length > 0" class="history-contact">联系方式：{{ item.contact }}</text>
                    </view>
                </view>
            </view>
        </scroll-view>

        <!-- 反馈表单（表单真值源与提交流程收在组件里，页面只关心开关与提交成功后刷新历史） -->
        <feedback-dialog :show="feedbackVisible" @close="onCloseFeedback" @submitted="onFeedbackSubmitted" />
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
import { goBack } from '../../utils/navigation'
    import { getFaqApi } from '../../api/faq'
    import { listFeedbackApi, FEEDBACK_STATUS_HANDLED, FEEDBACK_IMAGES_MAX } from '../../api/feedback'
    import { buildFaqNav, buildFaqGroups, faqEmptyText, faqEmptyIcon } from '../../utils/faqDisplay'
    import type { FaqCategory, FaqGroup, FaqNavItem, FeedbackItem } from '../../types/index'
    import feedbackDialog from './components/feedback-dialog.uvue'
    import noteImageStrip from './components/note-image-strip.uvue'

    /** AI 学助手（tabBar 页，只能走 switchTab；先例 pages/points/points-shop.uvue:148） */
    const AI_ASSISTANT_ROUTE = '/pages/ai-assistant/ai-assistant'

    const windowHeight = uni.getSystemInfoSync().windowHeight

    /** 整页数据：一次取回分类 + 全部已发布条目（#1079 契约，无分页、无搜索接口） */
    const categories = ref<FaqCategory[]>([])
    const loading = ref<boolean>(false)
    const failed = ref<boolean>(false)
    /** 端上搜索关键词（问题或答案命中即算） */
    const keyword = ref<string>('')
    /** 选中分类；空串 = 全部 */
    const activeCode = ref<string>('')
    /** 已展开的条目 id（uvue 无 CSS 过渡，展开靠 v-if 切换） */
    const expandedIds = ref<number[]>([])

    /** 分类栏数据（纯函数在 utils/faqDisplay，页面只做绑定） */
    const categoryNav = computed<FaqNavItem[]>(() : FaqNavItem[] => buildFaqNav(categories.value, keyword.value, activeCode.value))

    /** 列表数据：搜索时跨分类，单分组时隐藏分类标题 */
    const groups = computed<FaqGroup[]>(() : FaqGroup[] => buildFaqGroups(categories.value, keyword.value, activeCode.value))

    /** 分类栏是否展示：拿到分类才展示（加载中 / 失败 / 整体为空都不展示） */
    const hasCategories = computed<boolean>(() : boolean => !loading.value && !failed.value && categories.value.length > 0)

    const emptyText = computed<string>(() : string => faqEmptyText(keyword.value))

    const emptyIcon = computed<string>(() : string => faqEmptyIcon(keyword.value))

    /** 反馈表单开关（表单内部自己管草稿与提交，页面只开关 + 成功后刷历史） */
    const feedbackVisible = ref<boolean>(false)
    /** 历史列表：默认收起，点「我的反馈」才拉（没人看的列表不占一次请求） */
    const historyVisible = ref<boolean>(false)
    const historyLoading = ref<boolean>(false)
    const historyFailed = ref<boolean>(false)
    const historyItems = ref<FeedbackItem[]>([])
    /** 状态词只在模板里比较，不写字面量（`pending` / `handled` 由 api/feedback 导出） */
    const handledStatus = FEEDBACK_STATUS_HANDLED
    const imageMax = FEEDBACK_IMAGES_MAX

    /** 状态 → 中文标签。本域不向学员下发回复，所以只说「待处理 / 已处理」，不写「已回复」 */
    function statusText(status : string) : string {
        return status == handledStatus ? '已处理' : '待处理'
    }

    function onOpenFeedback() : void {
        feedbackVisible.value = true
    }

    function onCloseFeedback() : void {
        feedbackVisible.value = false
    }

    /** 我的反馈：展开即拉一次（失败给重试位，不伪装成空列表） */
    async function loadHistory() : Promise<void> {
        if (historyLoading.value) return
        historyLoading.value = true
        historyFailed.value = false
        try {
            const page = await listFeedbackApi(1, 20)
            historyItems.value = page.items
        } catch (e) {
            console.error('[help-center] history load failed:', e)
            historyFailed.value = true
        } finally {
            historyLoading.value = false
        }
    }

    /** 提交成功后：收起表单、打开历史并重拉一遍，让用户当场看到自己刚提交的那条 */
    function onFeedbackSubmitted() : void {
        feedbackVisible.value = false
        historyVisible.value = true
        loadHistory()
    }

    function onToggleHistory() : void {
        historyVisible.value = !historyVisible.value
        if (historyVisible.value) {
            loadHistory()
        }
    }

    /** 在线客服 = AI 学助手（教育类目送审要求客服可达；不新建客服页、不接第三方客服） */
    function onOpenCustomerService() : void {
        uni.switchTab({ url: AI_ASSISTANT_ROUTE })
    }

    /** 拉取帮助中心（失败置 failed，由重试位重新进入） */
    async function loadFaq() : Promise<void> {
        if (loading.value) return
        loading.value = true
        failed.value = false
        try {
            const data : FaqCategory[] = await getFaqApi()
            categories.value = data
        } catch (e) {
            console.error('[help-center] load failed:', e)
            failed.value = true
        } finally {
            loading.value = false
        }
    }

    /** 失败重试 */
    function reload() : void {
        failed.value = false
        loadFaq()
    }

    function onBack() : void {
        goBack()
    }

    function isExpanded(id : number) : boolean {
        for (let i = 0; i < expandedIds.value.length; i++) {
            if (expandedIds.value[i] == id) return true
        }
        return false
    }

    /** 折叠 / 展开：重赋新数组以触发响应式 */
    function onToggle(id : number) : void {
        const next : number[] = []
        let removed = false
        for (let i = 0; i < expandedIds.value.length; i++) {
            const cur = expandedIds.value[i]
            if (cur == id) {
                removed = true
            } else {
                next.push(cur)
            }
        }
        if (!removed) next.push(id)
        expandedIds.value = next
    }

    /** 切分类即清关键词（同 Web 帮助中心：分类选择与搜索互斥） */
    function onSelectCategory(code : string) : void {
        activeCode.value = code
        keyword.value = ''
    }

    function onClearKeyword() : void {
        keyword.value = ''
    }

    onShow(() => {
        loadFaq()
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    /* 搜索栏 */
    .search-bar {
        background-color: #2979ff;
        padding: 0 32rpx 24rpx 32rpx;
        flex-direction: row;
        align-items: center;
    }

    .search-icon {
        font-size: 30rpx;
        margin-right: 12rpx;
    }

    .search-input {
        flex: 1;
        height: 68rpx;
        background-color: #ffffff;
        border-radius: 34rpx;
        padding: 0 24rpx;
        font-size: 26rpx;
        color: #333333;
    }

    .search-clear {
        width: 56rpx;
        height: 56rpx;
        align-items: center;
        justify-content: center;
        margin-left: 12rpx;
    }

    .search-clear-text {
        font-size: 30rpx;
        color: #ffffff;
    }

    /* 分类 chip 行（横滑）：靠 flex-direction:row + 子项 flex-shrink:0 撑出横向溢出。
       ⚠️ **不写 `white-space: nowrap`** —— uvue 原生端该属性只支持 `<text>` / `<button>`，
       写在 `<scroll-view>` 上会被渲染层直接判错并忽略（2026-09-17 真机日志实测：
       `style property white-space is only supported on <text>|<button>. there is an error on
       <scroll-view class="category-scroll" …>`）。旧的 `.filter-scroll` 写法照抄不得。 */
    .category-scroll {
        background-color: #f5f5f5;
        flex-direction: row;
        align-items: center;
        padding: 20rpx 24rpx;
    }

    .category-chip {
        padding: 10rpx 24rpx;
        border-radius: 32rpx;
        background-color: #ffffff;
        margin-right: 16rpx;
        flex-shrink: 0;
    }

    .category-chip-active {
        background-color: #2979ff;
    }

    .category-text {
        font-size: 24rpx;
        color: #666666;
    }

    .category-text-active {
        color: #ffffff;
    }

    /* 内容区 */
    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 加载 / 失败 / 空 三态 */
    .state-tip {
        align-items: center;
        padding: 160rpx 0 80rpx 0;
        flex-direction: column;
    }

    .state-icon {
        font-size: 80rpx;
        margin-bottom: 24rpx;
    }

    .state-text {
        font-size: 28rpx;
        color: #999999;
    }

    .state-btn {
        background-color: #2979ff;
        padding: 16rpx 48rpx;
        border-radius: 32rpx;
        margin-top: 32rpx;
    }

    .state-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    /* 问答分组 */
    .group-list {
        flex-direction: column;
        padding: 8rpx 24rpx 40rpx 24rpx;
    }

    .group-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 8rpx 24rpx;
        margin-bottom: 16rpx;
    }

    .group-title {
        font-size: 26rpx;
        font-weight: bold;
        color: #999999;
        padding: 20rpx 0 8rpx 0;
    }

    .entry {
        flex-direction: column;
    }

    .entry-head {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 24rpx 0;
    }

    .entry-question {
        flex: 1;
        font-size: 28rpx;
        color: #333333;
    }

    .entry-arrow {
        font-size: 28rpx;
        color: #999999;
        margin-left: 16rpx;
    }

    .entry-answer-box {
        flex-direction: column;
        background-color: #f7f8fa;
        border-radius: 12rpx;
        padding: 20rpx;
        margin-bottom: 24rpx;
    }

    /* 答案：纯文本、原样换行（不引 Markdown 渲染口径） */
    .entry-answer {
        font-size: 26rpx;
        color: #666666;
        line-height: 42rpx;
    }

    /* 服务区（#1950）：入口列表 + 历史 */
    .service-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 8rpx 24rpx 16rpx 24rpx;
        margin: 8rpx 24rpx 40rpx 24rpx;
        flex-direction: column;
    }

    .service-title {
        font-size: 26rpx;
        font-weight: bold;
        color: #999999;
        padding: 20rpx 0 8rpx 0;
    }

    .service-row {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 0;
        border-bottom-width: 1rpx;
        border-bottom-style: solid;
        border-bottom-color: #f0f0f0;
    }

    .service-label {
        font-size: 28rpx;
        color: #333333;
        width: 160rpx;
    }

    .service-desc {
        flex: 1;
        font-size: 24rpx;
        color: #999999;
    }

    .service-arrow {
        font-size: 28rpx;
        color: #999999;
        margin-left: 16rpx;
    }

    .history-box {
        flex-direction: column;
        padding-top: 12rpx;
    }

    .history-tip {
        align-items: center;
        padding: 32rpx 0;
    }

    .history-tip-text {
        font-size: 26rpx;
        color: #999999;
    }

    .history-item {
        flex-direction: column;
        background-color: #f7f8fa;
        border-radius: 12rpx;
        padding: 20rpx;
        margin-bottom: 16rpx;
    }

    .history-head {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 12rpx;
    }

    .history-status {
        font-size: 22rpx;
        color: #ff9800;
    }

    .history-status-handled {
        color: #4caf50;
    }

    .history-time {
        font-size: 22rpx;
        color: #999999;
    }

    .history-content {
        font-size: 26rpx;
        color: #333333;
        line-height: 40rpx;
    }

    .history-contact {
        font-size: 24rpx;
        color: #666666;
        padding-top: 12rpx;
    }
</style>
