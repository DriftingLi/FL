<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <scroll-view class="content-scroll" scroll-y>
            <view class="header">
                <view class="user-card">
                    <view class="user-avatar">
                        <text class="avatar-icon">👤</text>
                    </view>
                    <view class="user-info">
                        <text class="user-name">{{ userName }}</text>
                        <text class="user-role">叉车学员</text>
                    </view>
                </view>
            </view>
            <view class="stats-row">
                <view class="stats-item">
                    <text class="stats-num">{{ totalHours }}</text>
                    <text class="stats-label">累计学时</text>
                </view>
                <view class="stats-divider"></view>
                <view class="stats-item">
                    <text class="stats-num">{{ completedCourses }}</text>
                    <text class="stats-label">已完成课程</text>
                </view>
                <view class="stats-divider"></view>
                <view class="stats-item">
                    <text class="stats-num">{{ totalCourses }}</text>
                    <text class="stats-label">课程总数</text>
                </view>
            </view>
            <view class="menu-section">
                <view class="menu-item" @click="onMenuClick('wrong')">
                    <text class="menu-icon">❌</text>
                    <text class="menu-text">错题本</text>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" @click="onMenuClick('records')">
                    <text class="menu-icon">📊</text>
                    <text class="menu-text">学习记录</text>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" @click="onMenuClick('practice')">
                    <text class="menu-icon">✏️</text>
                    <text class="menu-text">练习记录</text>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" @click="onMenuClick('settings')">
                    <text class="menu-icon">⚙️</text>
                    <text class="menu-text">设置</text>
                    <text class="menu-arrow">›</text>
                </view>
                <!-- <view class="menu-item" @click="onMenuClick('about')">
					<text class="menu-icon">ℹ️</text>
					<text class="menu-text">关于我们</text>
					<text class="menu-arrow">›</text>
				</view> -->
            </view>
        </scroll-view>
        <tab-bar :active-index="3"></tab-bar>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { getProfileApi } from '../../api/student'
    import { useStatusBarHeight } from '../../utils/system'
    import type { StudentProfile } from '../../types/index'

    const authStore = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const profile = ref<StudentProfile | null>(null)

    const userName = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null) {
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const totalHours = computed<string>(() : string => {
        if (profile.value != null) {
            const minutes = profile.value.total_study_duration
            const hours = Math.floor(minutes / 60)
            const mins = minutes % 60
            if (hours > 0) {
                return hours + 'h' + mins + 'm'
            }
            return mins + 'm'
        }
        return '0m'
    })

    const completedCourses = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.completed_courses
        }
        return 0
    })

    const totalCourses = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.total_courses
        }
        return 0
    })

    async function loadProfile() {
        try {
            const data = await getProfileApi()
            profile.value = data
        } catch (e) {
            console.error('[profile] load failed:', e)
        }
    }

    function onMenuClick(type : string) : void {
        if (type == 'wrong') {
            uni.showToast({ title: '错题本开发中', icon: 'none' })
        } else if (type == 'records') {
            uni.showToast({ title: '学习记录开发中', icon: 'none' })
        } else if (type == 'practice') {
            uni.showToast({ title: '练习记录开发中', icon: 'none' })
        } else if (type == 'settings') {
            uni.navigateTo({ url: '/pages/profile/settings' })
        }
        // else if (type == 'about') {
        //     uni.showToast({ title: '叉车维修培训学员端 v1.0', icon: 'none' })
        // }
    }

    onShow(() => {
        loadProfile()
    })
</script>

