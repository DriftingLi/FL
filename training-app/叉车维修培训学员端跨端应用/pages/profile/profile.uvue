<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <scroll-view class="content-scroll" scroll-y>
            <!-- 顶部用户信息区（简洁） -->
            <view class="header">
                <view class="user-card" @click="onEditNickname">
                    <view class="user-avatar" @click.stop="onChangeAvatar">
                        <image v-if="avatarUrl.length > 0" class="avatar-img" :src="avatarUrl" mode="aspectFill">
                        </image>
                        <text v-else class="avatar-icon">👤</text>
                    </view>
                    <view class="user-info">
                        <view class="name-row">
                            <text class="user-name">{{ userName }}</text>
                            <view class="lv-badge">
                                <text class="lv-badge-text">Lv{{ userLevel }}</text>
                            </view>
                        </view>
                        <view class="role-row">
                            <text class="user-role">{{ rankName }}</text>
                            <view class="stars-row">
                                <text v-for="(s, i) in starList" :key="i"
                                    :class="['star', { 'star-active': i < starCount }]">★</text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 签到卡片（醒目） -->
            <view class="checkin-card" @click="onGoCheckIn">
                <view class="checkin-left">
                    <text class="checkin-icon">📅</text>
                    <view class="checkin-info">
                        <text class="checkin-title">今日签到</text>
                        <text class="checkin-desc">已连续签到 {{ consecutiveDays }} 天，每天打卡得 {{ pointsPerDay }} 积分</text>
                    </view>
                </view>
                <view class="checkin-right">
                    <text class="checkin-btn-text">{{ todayChecked ? '已打卡 ✓' : '去签到 →' }}</text>
                </view>
            </view>

            <!-- 学习数据统计 -->
            <view class="stats-row">
                <view class="stats-card">
                    <text class="stats-num">{{ totalHours }}</text>
                    <text class="stats-label">学习时长</text>
                </view>
                <view class="stats-card">
                    <text class="stats-num">{{ streakDays }}</text>
                    <text class="stats-label">坚持天数</text>
                </view>
                <view class="stats-card">
                    <text class="stats-num">{{ points }}</text>
                    <text class="stats-label">积分</text>
                </view>
            </view>

            <!-- 我的课程 -->
            <view class="course-section" @click="onMenuClick('courses')">
                <view class="course-left">
                    <text class="course-icon">📁</text>
                    <text class="course-title">我的课程</text>
                </view>
                <view class="course-right">
                    <text class="course-count">{{ courseCount }}个</text>
                    <text class="course-arrow">›</text>
                </view>
            </view>

            <!-- 功能宫格 -->
            <view class="grid-section">
                <view class="grid-body">
                    <view v-for="(item, idx) in gridItems" :key="idx" class="grid-item" @click="onGridClick(item)">
                        <view class="grid-icon-wrap">
                            <text class="grid-icon">{{ item.icon }}</text>
                        </view>
                        <text class="grid-text">{{ item.title }}</text>
                    </view>
                </view>
            </view>

            <!-- 菜单列表 -->
            <view class="menu-section">
                <view class="menu-item" @click="onMenuClick('orders')">
                    <view class="menu-left">
                        <text class="menu-icon">📋</text>
                        <text class="menu-text">订单</text>
                    </view>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" @click="onMenuClick('wallet')">
                    <view class="menu-left">
                        <text class="menu-icon">💰</text>
                        <text class="menu-text">我的钱包</text>
                    </view>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" @click="onMenuClick('exam-goal')">
                    <view class="menu-left">
                        <text class="menu-icon">🎯</text>
                        <text class="menu-text">我的考试目标</text>
                    </view>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" @click="onMenuClick('settings')">
                    <view class="menu-left">
                        <text class="menu-icon">⚙</text>
                        <text class="menu-text">设置</text>
                    </view>
                    <text class="menu-arrow">›</text>
                </view>
                <!-- <view class="menu-item" @click="onMenuClick('notifications')">
                    <view class="menu-left">
                        <text class="menu-icon">🔔</text>
                        <text class="menu-text">通知</text>
                    </view>
                    <text class="menu-arrow">›</text>
                </view> -->
                <view class="menu-item" @click="onMenuClick('about')">
                    <view class="menu-left">
                        <text class="menu-icon">ℹ</text>
                        <text class="menu-text">关于</text>
                    </view>
                    <text class="menu-arrow">›</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { getProfileApi, getStudyStatsApi } from '../../api/student'
    import { updateProfileApi, uploadAvatarApi } from '../../api/auth'
    import { getCheckInCalendarApi } from '../../api/forum'
    import { useStatusBarHeight } from '../../utils/system'
    import { UNAVAILABLE_TOAST } from '../../constants/app'
    import type { StudentProfile, UpdateProfileParams, GridItem, CheckInCalendarDay } from '../../types/index'

    const authStore = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const profile = ref<StudentProfile | null>(null)
    const uploadingAvatar = ref<boolean>(false)
    const streakDays = ref<number>(0)

    // 签到相关数据
    const consecutiveDays = ref<number>(0)
    const pointsPerDay = ref<number>(7)
    const todayChecked = ref<boolean>(false)

    const userName = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null) {
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const avatarUrl = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })

    const totalHours = computed<string>(() : string => {
        if (profile.value != null) {
            const minutes = profile.value.total_study_duration
            const hours = Math.floor(minutes / 60)
            const mins = minutes % 60
            if (hours > 0) {
                if (mins > 0) {
                    return hours + 'h' + mins + 'm'
                }
                return hours + 'h'
            }
            return mins + 'm'
        }
        return '0h'
    })

    /** 学习分钟数（计算 Lv / 积分用） */
    const studyMinutes = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.total_study_duration
        }
        return 0
    })

    /** 已完成课程数（供段位/积分推导；须定义在使用它的 computed 之前，UTS 不支持前向引用） */
    const completedCourses = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.completed_courses
        }
        return 0
    })

    /**
     * 学员等级 Lv：按累计学时本地推导（后端无等级字段）
     * <5h → Lv1，<20h → Lv2，<50h → Lv3，<100h → Lv4，其余 Lv5
     */
    const userLevel = computed<number>(() : number => {
        const hours = studyMinutes.value / 60
        if (hours < 5) return 1
        if (hours < 20) return 2
        if (hours < 50) return 3
        if (hours < 100) return 4
        return 5
    })

    /**
     * 段位：按已完成课程数本地推导（后端无段位字段）
     * 0 → 初级工，1 → 中级技师，2 → 高级技师，>=3 → 技师
     */
    const rankName = computed<string>(() : string => {
        const completed = completedCourses.value
        if (completed <= 0) return '初级工'
        if (completed == 1) return '中级技师'
        if (completed == 2) return '高级技师'
        return '技师'
    })

    /** 星级：5 颗，点亮数 = Lv（Lv3 点亮 3 颗） */
    const starList : number[] = [1, 2, 3, 4, 5]
    const starCount = computed<number>(() : number => {
        const n = userLevel.value
        if (n > 5) return 5
        return n
    })

    /**
     * 积分：本地换算展示（后端无积分字段）
     * 每学时 3 分 + 每完成 1 门课程 20 分
     */
    const points = computed<number>(() : number => {
        const hours = Math.floor(studyMinutes.value / 60)
        return hours * 3 + completedCourses.value * 20
    })

    /** 我的课程数：学习中（有进度）的课程数 */
    const courseCount = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.course_progress.length
        }
        return 0
    })

    /**
     * 功能宫格：匹配原型图布局
     */
    const gridItems : GridItem[] = [
        { key: 'records', title: '学习记录', icon: '📖', color: '#2979ff', path: '/pages/profile/records', available: true },
        { key: 'favorites', title: '收藏夹', icon: '⭐', color: '#ffb800', path: '/pages/profile/favorites', available: true },
        { key: 'wrong-questions', title: '错题集', icon: '❓', color: '#ff5722', path: '/pages/profile/wrong-questions', available: true },
        { key: 'notebook', title: '笔记本', icon: '📝', color: '#9c27b0', path: '', available: false },
        { key: 'download', title: '资料下载', icon: '📥', color: '#00bcd4', path: '', available: false },
        { key: 'help', title: '帮助中心', icon: '❓', color: '#607d8b', path: '', available: false },
        { key: 'study-plan', title: '学习计划', icon: '📋', color: '#ff9900', path: '', available: false },
        { key: 'materials', title: '学习资料', icon: '📚', color: '#19be6b', path: '', available: false },
        { key: 'jobs', title: '就业在线', icon: '💼', color: '#dd524d', path: '/pages/jobs/job-list', available: true },
    ]

    function padZero(n : number) : string {
        if (n < 10) return '0' + n
        return '' + n
    }

    async function loadProfile() {
        try {
            const data = await getProfileApi()
            profile.value = data
        } catch (e) {
            console.error('[profile] load failed:', e)
        }
    }

    /** 近 7 天有学习记录的天数 */
    async function loadStreak() {
        try {
            const stats = await getStudyStatsApi(7)
            streakDays.value = stats.active_days
        } catch (e) {
            console.error('[profile] loadStreak failed:', e)
        }
    }

    /** 加载签到状态（今日是否已签到、连续天数） */
    async function loadCheckInStatus() {
        try {
            const now = new Date()
            const year = now.getFullYear()
            const month = now.getMonth() + 1
            const result = await getCheckInCalendarApi(year, month)
            consecutiveDays.value = result.consecutive_days
            pointsPerDay.value = result.points_per_day
            // 检查今日是否已签到
            const todayStr = year + '-' + padZero(month) + '-' + padZero(now.getDate())
            todayChecked.value = false
            for (let i = 0; i < result.days.length; i++) {
                if (result.days[i].date == todayStr && result.days[i].checked) {
                    todayChecked.value = true
                    break
                }
            }
        } catch (e) {
            console.error('[profile] loadCheckInStatus failed:', e)
        }
    }

    /** 上传头像 */
    async function uploadAvatar(filePath : string) : Promise<void> {
        uploadingAvatar.value = true
        uni.showLoading({ title: '上传中...' })
        try {
            await uploadAvatarApi(filePath)
            uni.showToast({ title: '头像已提交，审核通过后生效', icon: 'none' })
        } catch (e) {
            console.error('[profile] uploadAvatar failed:', e)
            let msg = '头像上传失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            uploadingAvatar.value = false
            uni.hideLoading()
        }
    }

    /** 点击头像，选择图片并上传 */
    function onChangeAvatar() : void {
        if (uploadingAvatar.value) return
        uni.chooseImage({
            count: 1,
            sizeType: ['compressed'],
            sourceType: ['album', 'camera'],
            success: (res) => {
                const tempFilePaths = res.tempFilePaths
                if (tempFilePaths.length == 0) return
                const filePath = tempFilePaths[0]
                uploadAvatar(filePath)
            },
            fail: (err) => {
                console.log('[profile] chooseImage canceled/failed:', err)
            }
        })
    }

    /** 提交昵称修改（走资料审核） */
    async function submitNickname(newName : string) : Promise<void> {
        uni.showLoading({ title: '保存中...' })
        try {
            const patch : UpdateProfileParams = { nickname: newName } as UpdateProfileParams
            await updateProfileApi(patch)
            uni.showToast({ title: '昵称已提交，审核通过后生效', icon: 'none' })
        } catch (e) {
            console.error('[profile] updateNickname failed:', e)
            let msg = '修改失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 编辑昵称 */
    function onEditNickname() : void {
        const current = authStore.user.value
        const currentName = current != null ? current.name : ''
        uni.showModal({
            title: '修改昵称',
            editable: true,
            placeholderText: '请输入新昵称',
            content: currentName,
            success: (res) => {
                if (!res.confirm) return
                const content = res.content
                const newName = (content != null ? content : '').trim()
                if (newName.length == 0) {
                    uni.showToast({ title: '昵称不能为空', icon: 'none' })
                    return
                }
                if (newName == currentName) return
                submitNickname(newName)
            }
        })
    }

    /** 跳转到签到页面（学习打卡） */
    function onGoCheckIn() : void {
        uni.navigateTo({ url: '/pages/forum/check-in' })
    }

    function onGridClick(item : GridItem) : void {
        if (item.available && item.path.length > 0) {
            uni.navigateTo({ url: item.path })
            return
        }
        uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
    }

    function onMenuClick(type : string) : void {
        if (type == 'settings') {
            uni.navigateTo({ url: '/pages/profile/settings' })
        } else if (type == 'courses') {
            uni.switchTab({ url: '/pages/courses/courses' })
        } else if (type == 'notifications') {
            uni.navigateTo({ url: '/pages/notifications/notifications' })
        } else if (type == 'about') {
            uni.showToast({ title: '叉车维修培训 v1.0.0', icon: 'none' })
        } else if (type == 'orders') {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
        } else if (type == 'wallet') {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
        } else if (type == 'exam-goal') {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
        }
    }

    onShow(() => {
        loadProfile()
        loadStreak()
        loadCheckInStatus()
    })
</script>

<style>
