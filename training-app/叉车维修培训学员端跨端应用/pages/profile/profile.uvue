    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .content-scroll {
        flex: 1;
    }

    .header {
        background-color: #2979ff;
        padding: 32rpx;
    }

    .user-card {
        flex-direction: row;
        align-items: center;
    }

    .user-avatar {
        width: 120rpx;
        height: 120rpx;
        border-radius: 60rpx;
        background-color: #4a9aff;
        align-items: center;
        justify-content: center;
        margin-right: 24rpx;
    }

    .avatar-icon {
        font-size: 64rpx;
    }

    .user-info {
        flex-direction: column;
    }

    .user-name {
        font-size: 40rpx;
        font-weight: bold;
        color: #ffffff;
        margin-bottom: 8rpx;
    }

    .user-role {
        font-size: 26rpx;
        color: #cfe5ff;
    }

    .stats-row {
        background-color: #ffffff;
        margin: -32rpx 24rpx 24rpx;
        border-radius: 16rpx;
        padding: 32rpx;
        flex-direction: row;
        justify-content: space-around;
        border: 1px solid #eeeeee;
    }

    .stats-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
    }

    .stats-num {
        font-size: 40rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 8rpx;
    }

    .stats-label {
        font-size: 24rpx;
        color: #999999;
    }

    .stats-divider {
        width: 1rpx;
        background-color: #f0f0f0;
    }

    .menu-section {
        background-color: #ffffff;
        margin-bottom: 24rpx;
    }

    .menu-item {
        flex-direction: row;
        align-items: center;
        padding: 32rpx;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .menu-item:last-child {
        border-bottom: none;
    }

    .menu-icon {
        font-size: 44rpx;
        margin-right: 20rpx;
    }

    .menu-text {
        flex: 1;
        font-size: 32rpx;
        color: #333333;
    }

    .menu-arrow {
        font-size: 40rpx;
        color: #cccccc;
    }
</style>