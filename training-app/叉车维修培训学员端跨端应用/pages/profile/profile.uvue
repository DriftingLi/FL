        flex: 1;
        background: linear-gradient(180deg, #CFE9FB 1%, #D0EBFD 16%, #F5F5F5 100%);
        flex-direction: column;
    }

    .status-bar {
        background-color: transparent;
    }

    .content-scroll {
        flex: 1;
    }

    /* 顶部用户信息区（简洁） */
    .header {
        background-color: transparent;
        padding: 24rpx 32rpx 40rpx;
    }

    .user-card {
        flex-direction: row;
        align-items: center;
    }

    .user-avatar {
        width: 128rpx;
        height: 128rpx;
        border-radius: 64rpx;
        background-color: #f0f0f0;
        align-items: center;
        justify-content: center;
        margin-right: 24rpx;
        overflow: hidden;
        border: 4rpx solid #ffffff;
        box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
    }

    .avatar-img {
        width: 128rpx;
        height: 128rpx;
        border-radius: 64rpx;
    }

    .avatar-icon {
        font-size: 60rpx;
    }

    .user-info {
        flex: 1;
        flex-direction: column;
    }

    .name-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 8rpx;
    }

    .user-name {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
    }

    .lv-badge {
        background-color: #E8F0FE;
        border-radius: 16rpx;
        padding: 4rpx 14rpx;
        margin-left: 16rpx;
    }

    .lv-badge-text {
        font-size: 22rpx;
        color: #2979ff;
        font-weight: bold;
    }

    .role-row {
        flex-direction: row;
        align-items: center;
    }

    .user-role {
        font-size: 26rpx;
        color: #666666;
        margin-right: 12rpx;
    }

    .stars-row {
        flex-direction: row;
        align-items: center;
    }

    .star {
        font-size: 24rpx;
        color: #cccccc;
        margin-right: 2rpx;
    }

    .star-active {
        color: #ffd700;
    }

    /* 签到卡片（醒目） */
    .checkin-card {
        background-color: #ffffff;
        margin: 0 24rpx 20rpx;
        border-radius: 16rpx;
        padding: 28rpx 24rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-left: 8rpx solid #3a8dff;
    }

    .checkin-left {
        flex: 1;
        flex-direction: row;
        align-items: center;
    }

    .checkin-icon {
        font-size: 48rpx;
        margin-right: 20rpx;
    }

    .checkin-info {
        flex: 1;
        flex-direction: column;
    }

    .checkin-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 6rpx;
    }

    .checkin-desc {
        font-size: 22rpx;
        color: #999999;
    }

    .checkin-right {
        margin-left: 16rpx;
    }

    .checkin-btn-text {
        font-size: 26rpx;
        font-weight: bold;
        color: #3a8dff;
    }

    /* 学习数据统计卡片 */
    .stats-row {
        flex-direction: row;
        justify-content: space-between;
        padding: 0 24rpx;
        margin-bottom: 20rpx;
    }

    .stats-card {
        flex: 1;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx 16rpx;
        margin: 0 8rpx;
        flex-direction: column;
        align-items: center;
        border: 1rpx solid #eeeeee;
    }

    .stats-num {
        font-size: 40rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 8rpx;
    }

    .stats-label {
        font-size: 22rpx;
        color: #999999;
    }

    /* 我的课程入口 */
    .course-section {
        background-color: #ffffff;
        margin: 0 24rpx 20rpx;
        border-radius: 16rpx;
        padding: 28rpx 24rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .course-left {
        flex-direction: row;
        align-items: center;
    }

    .course-icon {
        font-size: 36rpx;
        margin-right: 16rpx;
    }

    .course-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
    }

    .course-right {
        flex-direction: row;
        align-items: center;
    }

    .course-count {
        font-size: 26rpx;
        color: #999999;
        margin-right: 8rpx;
    }

    .course-arrow {
        font-size: 32rpx;
        color: #cccccc;
    }

    /* 功能宫格 */
    .grid-section {
        background-color: #ffffff;
        margin: 0 24rpx 20rpx;
        border-radius: 16rpx;
        padding: 24rpx 16rpx;
    }

    .grid-body {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .grid-item {
        width: 25%;
        flex-direction: column;
        align-items: center;
        padding: 20rpx 0;
    }

    .grid-icon-wrap {
        width: 80rpx;
        height: 80rpx;
        border-radius: 20rpx;
        background-color: #f5f7fa;
        align-items: center;
        justify-content: center;
        margin-bottom: 12rpx;
    }

    .grid-icon {
        font-size: 40rpx;
    }

    .grid-text {
        font-size: 22rpx;
        color: #333333;
    }

    /* 菜单列表 */
    .menu-section {
        background-color: #ffffff;
        margin: 0 24rpx 24rpx;
        border-radius: 16rpx;
        overflow: hidden;
    }

    .menu-item {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 28rpx 24rpx;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .menu-item:last-child {
        border-bottom-width: 0;
    }

    .menu-left {
        flex-direction: row;
        align-items: center;
    }

    .menu-icon {
        font-size: 36rpx;
        margin-right: 20rpx;
    }

    .menu-text {
        font-size: 30rpx;
        color: #333333;
    }

    .menu-arrow {
        font-size: 32rpx;
        color: #cccccc;
    }
</style>