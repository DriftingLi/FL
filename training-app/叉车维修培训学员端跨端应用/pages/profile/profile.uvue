<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部标题（原型：居中「我的」） -->
        <view class="nav-bar">
            <text class="nav-title">我的</text>
        </view>

        <scroll-view class="content-scroll" scroll-y>
            <!-- 用户行：头像 + 昵称/等级 + 段位星级 + 签到胶囊 -->
            <view class="user-row">
                <view class="user-avatar" @click.stop="onChangeAvatar">
                    <image v-if="avatarUrl.length > 0" class="avatar-img" :src="avatarUrl" mode="aspectFill">
                    </image>
                    <text v-else class="avatar-icon">👤</text>
                </view>
                <view class="user-info" @click="onEditNickname">
                    <view class="name-row">
                        <text class="user-name">{{ userName }}</text>
                        <text class="user-lv">Lv{{ userLevel }}</text>
                    </view>
                    <view class="role-row">
                        <text class="role-icon">🏅</text>
                        <text class="user-role">{{ rankName }}</text>
                        <view class="stars-row">
                            <text v-for="(s, i) in starList" :key="i"
                                :class="['star', { 'star-active': i < starCount }]">★</text>
                        </view>
                    </view>
                </view>
                <view class="checkin-pill" @click="onGoCheckIn">
                    <text class="checkin-pill-text">{{ todayChecked ? '已签到' : '签到' }}</text>
                </view>
            </view>

            <!-- 学习数据：三张独立卡片 -->
            <view class="stats-row">
                <view class="stats-card">
                    <text class="stats-num stats-num-green">{{ totalHours }}</text>
                    <text class="stats-label">学习时长</text>
                </view>
                <view class="stats-card stats-card-gap">
                    <text class="stats-num stats-num-green">{{ streakDays }}</text>
                    <text class="stats-label">坚持天数</text>
                </view>
                <view class="stats-card stats-card-gap" @click="onPointsTap">
                    <view class="stats-value-row">
                        <text class="stats-num stats-num-blue">{{ pointsText }}</text>
                        <text class="stats-arrow">›</text>
                    </view>
                    <text class="stats-label">可用积分</text>
                </view>
            </view>

            <!-- 我的课程 -->
            <view class="course-card" @click="onMyCourses">
                <text class="course-icon">📁</text>
                <text class="course-title">我的课程</text>
                <view class="course-right">
                    <text class="course-count">{{ courseCount }}个</text>
                    <text class="course-arrow">›</text>
                </view>
            </view>

            <!-- 工具宫格 -->
            <view class="section-card">
                <text class="section-title">工具</text>
                <view class="grid-body">
                    <view v-for="(item, idx) in toolItems" :key="idx" class="grid-item" @click="onEntryClick(item)">
                        <text class="grid-icon">{{ item.icon }}</text>
                        <text class="grid-text">{{ item.title }}</text>
                    </view>
                </view>
            </view>

            <!-- 服务宫格 -->
            <view class="section-card section-card-last">
                <text class="section-title">服务</text>
                <view class="grid-body">
                    <view v-for="(item, idx) in serviceItems" :key="idx" class="grid-item" @click="onEntryClick(item)">
                        <text class="grid-icon">{{ item.icon }}</text>
                        <text class="grid-text">{{ item.title }}</text>
                    </view>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { getProfileApi, getStudyStatsApi } from '../../api/student'
    import { updateProfileApi, uploadAvatarApi } from '../../api/auth'
    import { getCheckInCalendarApi } from '../../api/checkin'
    import { getPointsBalanceApi } from '../../api/points'
    import { useStatusBarHeight } from '../../utils/system'
    import { UNAVAILABLE_TOAST } from '../../constants/app'
    import type { StudentProfile, UpdateProfileParams } from '../../types/index'

    /** 宫格入口：path 为空或 available=false 时走占位提示 */
    type ProfileEntry = {
        key : string
        title : string
        icon : string
        path : string
        available : boolean
    }

    const authStore = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const profile = ref<StudentProfile | null>(null)
    const uploadingAvatar = ref<boolean>(false)
    const streakDays = ref<number>(0)
    const pointsTotal = ref<number>(0)

    /** 签到状态（原型：签到胶囊只区分今日是否已签到） */
    const todayChecked = ref<boolean>(false)

    const userName = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null) {
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const avatarUrl = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })

    /** 学习分钟数 → 展示文本：48h / 1h30m / 45m */
    function formatStudyDuration(minutes : number) : string {
        if (minutes <= 0) return '0m'
        const hours = Math.floor(minutes / 60)
        const mins = minutes % 60
        if (hours <= 0) return mins + 'm'
        if (mins <= 0) return hours + 'h'
        return hours + 'h' + mins + 'm'
    }

    /**
     * 学员等级 Lv：按累计学时本地推导（后端无等级字段）
     * <5h → Lv1，<20h → Lv2，<50h → Lv3，<100h → Lv4，其余 Lv5
     */
    function levelFromHours(hours : number) : number {
        if (hours < 5) return 1
        if (hours < 20) return 2
        if (hours < 50) return 3
        if (hours < 100) return 4
        return 5
    }

    /**
     * 段位：按已完成课程数本地推导（后端无段位字段）
     * 0 → 初级工，1 → 中级技师，2 → 高级技师，>=3 → 技师
     */
    function rankNameFromCompleted(completed : number) : string {
        if (completed <= 0) return '初级工'
        if (completed == 1) return '中级技师'
        if (completed == 2) return '高级技师'
        return '技师'
    }

    /** 等级 → 点亮星数（共 5 颗） */
    function starCountFromLevel(level : number) : number {
        if (level <= 0) return 0
        if (level > 5) return 5
        return level
    }

    /** 积分展示：非正数归零，超过 9999 折叠 */
    function formatPoints(total : number) : string {
        if (total <= 0) return '0'
        if (total > 9999) return '9999+'
        return total.toString()
    }

    /** 学习分钟数（计算 Lv / 星级用；须定义在使用它的 computed 之前，UTS 不支持前向引用） */
    const studyMinutes = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.total_study_duration
        }
        return 0
    })

    /** 已完成课程数（供段位推导） */
    const completedCourses = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.completed_courses
        }
        return 0
    })

    const totalHours = computed<string>(() : string => {
        return formatStudyDuration(studyMinutes.value)
    })

    const userLevel = computed<number>(() : number => {
        return levelFromHours(studyMinutes.value / 60)
    })

    const rankName = computed<string>(() : string => {
        return rankNameFromCompleted(completedCourses.value)
    })

    const starList : number[] = [1, 2, 3, 4, 5]

    const starCount = computed<number>(() : number => {
        return starCountFromLevel(userLevel.value)
    })

    const pointsText = computed<string>(() : string => {
        return formatPoints(pointsTotal.value)
    })

    /** 我的课程数：学习中（有进度）的课程数 */
    const courseCount = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.course_progress.length
        }
        return 0
    })

    /** 工具宫格：条目与顺序对齐原型图 */
    const toolItems : ProfileEntry[] = [
        { key: 'records', title: '学习记录', icon: '📖', path: '/pages/profile/records', available: true },
        { key: 'favorites', title: '收藏夹', icon: '⭐', path: '/pages/profile/favorites', available: true },
        { key: 'wrong-questions', title: '错题本', icon: '📕', path: '/pages/profile/wrong-questions', available: true },
        { key: 'notebook', title: '笔记本', icon: '📔', path: '', available: false },
        { key: 'study-plan', title: '学练计划', icon: '🎯', path: '', available: false },
        { key: 'materials', title: '学习资料', icon: '📚', path: '', available: false },
        { key: 'jobs', title: '就业在线', icon: '💼', path: '/pages/jobs/job-list', available: true },
        { key: 'task-center', title: '任务中心', icon: '✅', path: '/pages/points/task-center', available: true },
    ]

    /** 服务宫格：按原型「设置」落在第二行首列 */
    const serviceItems : ProfileEntry[] = [
        { key: 'orders', title: '我的订单', icon: '📋', path: '', available: false },
        { key: 'help', title: '帮助中心', icon: '🎧', path: '', available: false },
        { key: 'address', title: '地址管理', icon: '📍', path: '', available: false },
        { key: 'messages', title: '消息中心', icon: '🔔', path: '/pages/notifications/notifications', available: true },
        { key: 'settings', title: '设置', icon: '⚙', path: '/pages/profile/settings', available: true },
    ]

    async function loadProfile() {
        try {
            const data = await getProfileApi()
            profile.value = data
        } catch (e) {
            console.error('[profile] load failed:', e)
        }
    }

    /** 近 7 天有学习记录的天数 */
    async function loadStreak() {
        try {
            const stats = await getStudyStatsApi(7)
            streakDays.value = stats.active_days
        } catch (e) {
            console.error('[profile] loadStreak failed:', e)
        }
    }

    /** 可用积分：取积分余额 */
    async function loadPoints() {
        try {
            const data = await getPointsBalanceApi()
            pointsTotal.value = data.total_points
        } catch (e) {
            console.error('[profile] loadPoints failed:', e)
        }
    }

    /** 加载签到状态（今日是否已签到） */
    async function loadCheckInStatus() {
        try {
            const now = new Date()
            const result = await getCheckInCalendarApi(now.getFullYear(), now.getMonth() + 1)
            todayChecked.value = result.today_checked
        } catch (e) {
            console.error('[profile] loadCheckInStatus failed:', e)
        }
    }

    /** 上传头像 */
    async function uploadAvatar(filePath : string) : Promise<void> {
        uploadingAvatar.value = true
        uni.showLoading({ title: '上传中...' })
        try {
            await uploadAvatarApi(filePath)
            uni.showToast({ title: '头像已提交，审核通过后生效', icon: 'none' })
        } catch (e) {
            console.error('[profile] uploadAvatar failed:', e)
            let msg = '头像上传失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            uploadingAvatar.value = false
            uni.hideLoading()
        }
    }

    /** 点击头像，选择图片并上传 */
    function onChangeAvatar() : void {
        if (uploadingAvatar.value) return
        uni.chooseImage({
            count: 1,
            sizeType: ['compressed'],
            sourceType: ['album', 'camera'],
            success: (res) => {
                const tempFilePaths = res.tempFilePaths
                if (tempFilePaths.length == 0) return
                const filePath = tempFilePaths[0]
                uploadAvatar(filePath)
            },
            fail: (err) => {
                console.log('[profile] chooseImage canceled/failed:', err)
            }
        })
    }

    /** 提交昵称修改（走资料审核） */
    async function submitNickname(newName : string) : Promise<void> {
        uni.showLoading({ title: '保存中...' })
        try {
            const patch : UpdateProfileParams = { nickname: newName } as UpdateProfileParams
            await updateProfileApi(patch)
            uni.showToast({ title: '昵称已提交，审核通过后生效', icon: 'none' })
        } catch (e) {
            console.error('[profile] updateNickname failed:', e)
            let msg = '修改失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 编辑昵称 */
    function onEditNickname() : void {
        const current = authStore.user.value
        const currentName = current != null ? current.name : ''
        uni.showModal({
            title: '修改昵称',
            editable: true,
            placeholderText: '请输入新昵称',
            content: currentName,
            success: (res) => {
                if (!res.confirm) return
                const content = res.content
                const newName = (content != null ? content : '').trim()
                if (newName.length == 0) {
                    uni.showToast({ title: '昵称不能为空', icon: 'none' })
                    return
                }
                if (newName == currentName) return
                submitNickname(newName)
            }
        })
    }

    /** 跳转到签到页面（学习打卡） */
    function onGoCheckIn() : void {
        uni.navigateTo({ url: '/pages/forum/check-in' })
    }

    /** 跳转到积分明细 */
    function onPointsTap() : void {
        uni.navigateTo({ url: '/pages/points/points-detail' })
    }

    function onMyCourses() : void {
        uni.switchTab({ url: '/pages/courses/courses' })
    }

    function onEntryClick(item : ProfileEntry) : void {
        if (item.available && item.path.length > 0) {
            uni.navigateTo({ url: item.path })
            return
        }
        uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
    }

    onShow(() => {
        loadProfile()
        loadStreak()
        loadPoints()
        loadCheckInStatus()
    })
</script>

<style>
    .container {
        flex: 1;
        background: linear-gradient(180deg, #6ECCFD 20%, #0CA2EF 72%, #0CA2EF 100%);
        flex-direction: column;
    }

    .status-bar {
        background-color: transparent;
    }

    .nav-bar {
        height: 88rpx;
        align-items: center;
        justify-content: center;
    }

    .nav-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .content-scroll {
        flex: 1;
    }

    /* 用户行 */
    .user-row {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 48rpx 0 24rpx;
    }

    .user-avatar {
        width: 116rpx;
        height: 116rpx;
        border-radius: 58rpx;
        background-color: #F5F5F5;
        border: 4rpx solid #ffffff;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .avatar-img {
        width: 116rpx;
        height: 116rpx;
        border-radius: 58rpx;
    }

    .avatar-icon {
        font-size: 56rpx;
    }

    .user-info {
        flex: 1;
        flex-direction: column;
        margin-left: 24rpx;
    }

    .name-row {
        flex-direction: row;
        align-items: center;
    }

    .user-name {
        font-size: 40rpx;
        font-weight: bold;
        color: #333333;
    }

    .user-lv {
        font-size: 22rpx;
        font-weight: bold;
        color: #333333;
        margin-left: 16rpx;
    }

    .role-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8rpx;
    }

    .role-icon {
        font-size: 26rpx;
        margin-right: 8rpx;
    }

    .user-role {
        font-size: 28rpx;
        color: #666666;
    }

    .stars-row {
        flex-direction: row;
        align-items: center;
        margin-left: 24rpx;
    }

    .star {
        font-size: 26rpx;
        color: #FFFFFF;
        margin-right: 4rpx;
    }

    .star-active {
        color: #FDE03B;
    }

    .checkin-pill {
        height: 52rpx;
        padding: 0 24rpx;
        border-radius: 26rpx;
        background-color: #EBF9FF;
        align-items: center;
        justify-content: center;
        margin-left: 16rpx;
        flex-shrink: 0;
    }

    .checkin-pill-text {
        font-size: 26rpx;
        font-weight: bold;
        color: #239EDD;
    }

    /* 学习数据：三张独立卡片 */
    .stats-row {
        flex-direction: row;
        padding: 0 48rpx;
        margin-top: 40rpx;
    }

    .stats-card {
        flex: 1;
        height: 100rpx;
        background-color: #ffffff;
        border-radius: 24rpx;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .stats-card-gap {
        margin-left: 24rpx;
    }

    .stats-value-row {
        flex-direction: row;
        align-items: center;
    }

    .stats-num {
        font-size: 40rpx;
        font-weight: bold;
        line-height: 48rpx;
    }

    .stats-num-green {
        color: #14AE50;
    }

    .stats-num-blue {
        color: #239EDD;
    }

    .stats-arrow {
        font-size: 32rpx;
        color: #239EDD;
        margin-left: 4rpx;
    }

    .stats-label {
        font-size: 26rpx;
        color: #8C8C8C;
        margin-top: 4rpx;
    }

    /* 我的课程 */
    .course-card {
        flex-direction: row;
        align-items: center;
        height: 138rpx;
        background-color: #ffffff;
        border-radius: 24rpx;
        margin: 40rpx 24rpx 0 24rpx;
        padding: 0 40rpx;
    }

    .course-icon {
        font-size: 56rpx;
        margin-right: 26rpx;
    }

    .course-title {
        flex: 1;
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .course-right {
        flex-direction: row;
        align-items: center;
    }

    .course-count {
        font-size: 26rpx;
        color: #666666;
    }

    .course-arrow {
        font-size: 32rpx;
        color: #CCCCCC;
        margin-left: 8rpx;
    }

    /* 工具 / 服务 分区卡片 */
    .section-card {
        background-color: #ffffff;
        border-radius: 24rpx;
        margin: 24rpx 24rpx 0 24rpx;
        padding-bottom: 24rpx;
    }

    .section-card-last {
        margin-bottom: 40rpx;
    }

    .section-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        padding: 24rpx 0 40rpx 40rpx;
    }

    .grid-body {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .grid-item {
        width: 25%;
        flex-direction: column;
        align-items: center;
        padding: 12rpx 0;
    }

    .grid-icon {
        font-size: 60rpx;
        line-height: 68rpx;
    }

    .grid-text {
        font-size: 26rpx;
        color: #666666;
        margin-top: 10rpx;
    }
</style>
