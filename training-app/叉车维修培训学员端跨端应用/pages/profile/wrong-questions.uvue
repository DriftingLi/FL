<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">错题本</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 统计卡片 -->
            <view class="stats-card">
                <view class="stat-item">
                    <text class="stat-num">{{ stats.total }}</text>
                    <text class="stat-label">我的错题</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item">
                    <text class="stat-num">{{ todayCount }}</text>
                    <text class="stat-label">今日错题</text>
                </view>
            </view>

            <!-- 筛选栏 -->
            <view class="filter-bar">
                <scroll-view class="filter-scroll" scroll-x="true">
                    <view class="filter-list">
                        <view v-for="(opt, idx) in filterOptions" :key="idx"
                            :class="['filter-chip', { active: currentFilter == opt.value }]"
                            @click="onFilterClick(opt.value)">
                            <text class="filter-chip-text">{{ opt.label }}</text>
                        </view>
                    </view>
                </scroll-view>
            </view>

            <!-- 错题列表 -->
            <view v-if="records.length == 0 && !loading" class="empty-tip">
                <text class="empty-text">暂无错题</text>
            </view>
            <view class="record-list">
                <view v-for="(item, idx) in records" :key="idx" class="record-card">
                    <view class="record-header">
                        <text class="record-type-tag">{{ getTypeName(item.type) }}</text>
                        <text class="record-wrong-count">错 {{ item.wrong_count }} 次</text>
                        <text class="record-date">{{ formatDateStr(item.created_at) }}</text>
                    </view>
                    <text class="record-title">{{ item.title }}</text>

                    <!-- 折叠态：显示用户答案与正确答案 -->
                    <!-- <view v-if="!isExpanded(item.question_id)" class="record-answers">
                        <view class="answer-row wrong">
                            <text class="answer-label">我的答案：</text>
                            <text class="answer-value">{{ item.user_answer.length > 0 ? item.user_answer : '未作答' }}</text>
                        </view>
                        <view class="answer-row correct">
                            <text class="answer-label">正确答案：</text>
                            <text class="answer-value">{{ item.correct_answer }}</text>
                        </view>
                    </view> -->

                    <!-- 展开态：重做交互 -->
                    <view v-if="isExpanded(item.question_id)" class="redo-section">
                        <view class="option-list">
                            <view v-for="(opt, oidx) in item.options" :key="oidx"
                                class="option-item" :class="getOptionClass(item, opt.key)"
                                @click="onOptionClick(item, opt.key)">
                                <view class="option-key" :class="getOptionKeyClass(item, opt.key)">
                                    <text class="option-key-text">{{ opt.key }}</text>
                                </view>
                                <text class="option-text">{{ opt.text }}</text>
                            </view>
                        </view>

                        <!-- 重做结果 -->
                        <view v-if="hasRedoResult()" class="redo-result"
                            :class="redoResultClass()">
                            <text class="redo-result-text">{{ redoResultLabel() }}</text>
                            <text class="redo-result-answer">我的答案：{{ redoResultUserAnswer() }}</text>
                            <text class="redo-result-answer">正确答案：{{ redoResultAnswer() }}</text>
                            <text v-if="redoResultLocalMatch()" class="redo-result-hint">提示：选项内容一致，可能因答案格式差异被判错</text>
                        </view>

                        <!-- 操作按钮 -->
                        <view class="redo-actions">
                            <view v-if="!hasRedoResult()" class="redo-btn redo-btn-primary"
                                @click="onSubmitRedo(item)">
                                <text class="redo-btn-text">提交答案</text>
                            </view>
                            <view v-if="hasRedoResult() && redoResultCorrect()" class="redo-btn redo-btn-success"
                                @click="onRemove(item)">
                                <text class="redo-btn-text">移出错题本</text>
                            </view>
                            <view v-else class="redo-btn redo-btn-danger" @click="onRemove(item)">
                                <text class="redo-btn-text">移出错题本</text>
                            </view>
                        </view>
                    </view>

                    <!-- 折叠态操作按钮 -->
                    <view v-if="!isExpanded(item.question_id)" class="card-actions">
                        <view class="card-action-btn" @click="onToggleExpand(item.question_id)">
                            <text class="card-action-text">重做</text>
                        </view>
                        <view class="card-action-btn card-action-danger" @click="onRemove(item)">
                            <text class="card-action-text card-action-danger-text">移出</text>
                        </view>
                    </view>
                </view>
            </view>
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && records.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import {
        getWrongQuestionsApi,
        getWrongQuestionStatsApi,
        redoWrongQuestionApi,
        removeWrongQuestionApi,
    } from '../../api/wrongQuestion'
    import { API_BASE_URL } from '../../config/env'
    import type { WrongQuestionItem, WrongQuestionStats, QuestionOption } from '../../types/index'
    import { formatDateStr } from '../../utils/format'

    type TypeOption = {
        label : string
        value : string
    }

    /** 重做结果 */
    type RedoResult = {
        correct : boolean
        correct_answer : string
        explanation : string
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const authStore = useAuthStore()

    const filterOptions : TypeOption[] = [
        { label: '时间', value: 'time' },
        { label: '收藏', value: 'favorite' },
        { label: '错多次', value: 'wrong_many' },
        { label: '重置', value: 'reset' },
        { label: '答对移除', value: 'auto_remove' },
    ]

    const currentFilter = ref<string>('time')
    const records = ref<WrongQuestionItem[]>([])
    const page = ref<number>(1)
    const pageSize = 20
    const total = ref<number>(0)
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)

    // 统计
    const stats = ref<WrongQuestionStats>({
        total: 0,
        by_type: {} as UTSJSONObject,
        by_knowledge_point: {} as UTSJSONObject,
    } as WrongQuestionStats)

    // 当前展开的题目 ID（0 表示都折叠）。同一时间只展开一道题，
    // 因此选中答案与重做结果用单值 ref，避免 UTSJSONObject 索引/null 赋值在 uvue 模板中的兼容性问题。
    const expandedId = ref<number>(0)
    const selectedKeys = ref<string[]>([])
    const lastRedoAnswer = ref<string>('')
    const redoResult = ref<RedoResult | null>(null)

    /** 从 by_type 统计中取某题型数量 */
    function countByType(type : string) : number {
        const byType = stats.value.by_type
        const v = byType[type]
        if (v == null) return 0
        const s = `${v}`
        const n = parseFloat(s)
        if (isNaN(n)) return 0
        return n
    }

    /** 今日新增错题数（暂时用0，后续对接后端 today_count） */
    const todayCount = computed<number>(() : number => {
        return 0
    })

    /** 题型名称 */
    function getTypeName(type : string) : string {
        if (type == 'single' || type == 'single_choice') return '单选题'
        if (type == 'multi' || type == 'multiple_choice' || type == 'multi_choice') return '多选题'
        if (type == 'judge' || type == 'true_false') return '判断题'
        return '其他'
    }

    /** 是否多选题 */
    function isMultiChoice(type : string) : boolean {
        return type == 'multi' || type == 'multiple_choice' || type == 'multi_choice'
    }

    /** 当前展开判断（模板调用） */
    function isExpanded(qid : number) : boolean {
        return expandedId.value == qid
    }

    /** 是否已提交重做（模板调用） */
    function hasRedoResult() : boolean {
        return redoResult.value != null
    }

    /** 重做结果是否正确（模板调用） */
    function redoResultCorrect() : boolean {
        const r = redoResult.value
        if (r == null) return false
        return r.correct
    }

    /** 重做结果样式类（模板调用） */
    function redoResultClass() : string {
        const r = redoResult.value
        if (r == null) return ''
        return r.correct ? 'correct' : 'wrong'
    }

    /** 重做结果文案（模板调用） */
    function redoResultLabel() : string {
        const r = redoResult.value
        if (r == null) return ''
        return r.correct ? '回答正确' : '回答错误'
    }

    /** 重做结果正确答案（模板调用） */
    function redoResultAnswer() : string {
        const r = redoResult.value
        if (r == null) return ''
        return r.correct_answer
    }

    /** 重做结果用户答案（模板调用） */
    function redoResultUserAnswer() : string {
        return lastRedoAnswer.value.length > 0 ? lastRedoAnswer.value : '未作答'
    }

    /** 将答案字符串解析为 key 数组，兼容多种分隔符（声明在 redoResultLocalMatch 之前，避免 Kotlin 局部函数前向引用） */
    function parseAnswerKeys(answer : string) : string[] {
        if (answer.length == 0) return [] as string[]
        if (answer == 'true' || answer == 'false') return [answer] as string[]
        let separator = ''
        if (answer.indexOf(',') >= 0) separator = ','
        else if (answer.indexOf('，') >= 0) separator = '，'
        else if (answer.indexOf(' ') >= 0) separator = ' '
        else if (answer.indexOf(';') >= 0) separator = ';'
        else if (answer.indexOf('|') >= 0) separator = '|'
        if (separator.length > 0) {
            const parts = answer.split(separator)
            const keys : string[] = []
            for (let i = 0; i < parts.length; i++) {
                const k = parts[i].trim()
                if (k.length > 0) keys.push(k)
            }
            return keys
        }
        const keys : string[] = []
        for (let i = 0; i < answer.length; i++) {
            keys.push(answer.charAt(i))
        }
        return keys
    }

    /** 本地比对：用户答案与正确答案 key 集合是否一致（模板调用） */
    function redoResultLocalMatch() : boolean {
        const r = redoResult.value
        if (r == null) return false
        if (r.correct) return false
        const correctKeys = parseAnswerKeys(r.correct_answer)
        const userKeys = parseAnswerKeys(lastRedoAnswer.value)
        if (correctKeys.length != userKeys.length) return false
        if (correctKeys.length == 0) return false
        const sortedCorrect = correctKeys.slice().sort().join('')
        const sortedUser = userKeys.slice().sort().join('')
        return sortedCorrect == sortedUser
    }

    /** 选项是否已选中 */
    function isSelected(key : string) : boolean {
        return selectedKeys.value.indexOf(key) >= 0
    }

    /** 答案是否包含某 key */
    function isAnswerContains(answer : string, key : string) : boolean {
        const keys = parseAnswerKeys(answer)
        return keys.indexOf(key) >= 0
    }

    /** 选项样式类（模板调用） */
    function getOptionClass(item : WrongQuestionItem, key : string) : string {
        const r = redoResult.value
        if (r != null) {
            if (isAnswerContains(r.correct_answer, key)) return 'option-correct'
            if (isSelected(key) && !isAnswerContains(r.correct_answer, key)) return 'option-wrong'
            return ''
        }
        return isSelected(key) ? 'option-selected' : ''
    }

    /** 选项 key 样式类（模板调用） */
    function getOptionKeyClass(item : WrongQuestionItem, key : string) : string {
        const r = redoResult.value
        if (r != null) {
            if (isAnswerContains(r.correct_answer, key)) return 'option-key-correct'
            if (isSelected(key) && !isAnswerContains(r.correct_answer, key)) return 'option-key-wrong'
            return ''
        }
        return isSelected(key) ? 'option-key-selected' : ''
    }

    /** 点击选项 */
    function onOptionClick(item : WrongQuestionItem, key : string) : void {
        if (redoResult.value != null) return
        if (isMultiChoice(item.type)) {
            const idx = selectedKeys.value.indexOf(key)
            if (idx >= 0) {
                selectedKeys.value.splice(idx, 1)
            } else {
                selectedKeys.value.push(key)
            }
        } else {
            // 单选/判断：替换为单元素数组
            const arr : string[] = [key]
            selectedKeys.value = arr
        }
    }

    async function loadStats() {
        try {
            const data = await getWrongQuestionStatsApi()
            stats.value = data
        } catch (e) {
            uni.__f__('error','at pages/profile/wrong-questions.uvue:356','[wrong-questions] load stats failed:', e)
        }
    }

    async function loadRecords(reset : boolean = false) {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loading.value = true
        try {
            const result = await getWrongQuestionsApi(page.value, pageSize, currentFilter.value)
            if (reset) {
                records.value = result.items
            } else {
                records.value = records.value.concat(result.items)
            }
            total.value = result.total
            if (records.value.length >= result.total || result.items.length == 0) {
                noMore.value = true
            } else {
                page.value = page.value + 1
            }
        } catch (e) {
            uni.__f__('error','at pages/profile/wrong-questions.uvue:383','[wrong-questions] load failed:', e)
            uni.showToast({ title: '加载错题失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    function onFilterClick(val : string) : void {
        if (val == 'reset') {
            // 重置所有筛选
            currentFilter.value = 'time'
            expandedId.value = 0
            selectedKeys.value = [] as string[]
            lastRedoAnswer.value = ''
            redoResult.value = null
            loadRecords(true)
            return
        }
        if (currentFilter.value == val) return
        currentFilter.value = val
        expandedId.value = 0
        selectedKeys.value = [] as string[]
        lastRedoAnswer.value = ''
        redoResult.value = null
        loadRecords(true)
    }

    function onLoadMore() : void {
        loadRecords(false)
    }

    function onToggleExpand(qid : number) : void {
        if (expandedId.value == qid) {
            // 收起当前题
            expandedId.value = 0
        } else {
            // 展开新题，重置该题的选中与结果
            expandedId.value = qid
            selectedKeys.value = [] as string[]
            lastRedoAnswer.value = ''
            redoResult.value = null
        }
    }

    /** 提交重做 */
    async function onSubmitRedo(item : WrongQuestionItem) : Promise<void> {
        if (selectedKeys.value.length == 0) {
            uni.showToast({ title: '请选择答案', icon: 'none' })
            return
        }
        // 拼接答案：多选按字母排序拼接，单选/判断直接取
        let userAnswer = ''
        if (isMultiChoice(item.type)) {
            // 拷贝后排序，避免修改原数组
            const sorted : string[] = []
            for (let i = 0; i < selectedKeys.value.length; i++) {
                sorted.push(selectedKeys.value[i])
            }
            sorted.sort()
            userAnswer = sorted.join(',')
        } else {
            userAnswer = selectedKeys.value[0]
        }
        lastRedoAnswer.value = userAnswer

        uni.showLoading({ title: '提交中...' })
        try {
            const data = await redoWrongQuestionApi(item.question_id, userAnswer)
            // 后端返回 { is_correct, correct_answer, explanation }
            const isCorrect = `${data['is_correct']}` == 'true' || `${data['is_correct']}` == '1'
            const correctAnswer = data['correct_answer'] != null ? `${data['correct_answer']}` : item.correct_answer
            const explanation = data['explanation'] != null ? `${data['explanation']}` : ''

            if (isCorrect) {
                // 重做正确：自动移出错题本，不保留该数据
                try {
                    await removeWrongQuestionApi(item.question_id)
                } catch (e) {
                    uni.__f__('error','at pages/profile/wrong-questions.uvue:461','[wrong-questions] auto remove failed:', e)
                }
                // 从列表中移除
                const newRecords : WrongQuestionItem[] = []
                for (let i = 0; i < records.value.length; i++) {
                    if (records.value[i].question_id != item.question_id) {
                        newRecords.push(records.value[i])
                    }
                }
                records.value = newRecords
                total.value = Math.max(0, total.value - 1)
                expandedId.value = 0
                selectedKeys.value = [] as string[]
                redoResult.value = null
                uni.showToast({ title: '回答正确，已移出错题本', icon: 'success' })
                // 刷新统计
                loadStats()
            } else {
                // 重做错误：显示结果，保留在错题本中
                const result : RedoResult = {
                    correct: false,
                    correct_answer: correctAnswer,
                    explanation: explanation,
                } as RedoResult
                redoResult.value = result
            }
        } catch (e) {
            uni.__f__('error','at pages/profile/wrong-questions.uvue:488','[wrong-questions] redo failed:', e)
            uni.showToast({ title: '提交失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 执行移出错题本（声明在 onRemove 之前，避免 Kotlin 局部函数前向引用） */
    async function doRemove(item : WrongQuestionItem) : Promise<void> {
        uni.showLoading({ title: '处理中...' })
        try {
            await removeWrongQuestionApi(item.question_id)
            uni.showToast({ title: '已移出错题本', icon: 'success' })
            // 从列表中移除
            const newRecords : WrongQuestionItem[] = []
            for (let i = 0; i < records.value.length; i++) {
                if (records.value[i].question_id != item.question_id) {
                    newRecords.push(records.value[i])
                }
            }
            records.value = newRecords
            total.value = Math.max(0, total.value - 1)
            if (expandedId.value == item.question_id) {
                expandedId.value = 0
                selectedKeys.value = [] as string[]
                redoResult.value = null
            }
            // 刷新统计
            loadStats()
        } catch (e) {
            uni.__f__('error','at pages/profile/wrong-questions.uvue:518','[wrong-questions] remove failed:', e)
            uni.showToast({ title: '移出失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 移出错题本 */
    function onRemove(item : WrongQuestionItem) : void {
        uni.showModal({
            title: '提示',
            content: '确定将此题移出错题本？',
            success: (res) => {
                if (res.confirm) {
                    doRemove(item)
                }
            }
        })
    }

    /** 导出错题本（使用 downloadFile 处理 .txt 附件） */
    function onExport() : void {
        const token = authStore.token.value
        if (token.length == 0) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        uni.showLoading({ title: '导出中...' })
        uni.downloadFile({
            url: API_BASE_URL + '/wrong-questions/export',
            header: {
                'Authorization': 'Bearer ' + token,
            },
            success: (res) => {
                if (res.statusCode == 200) {
                    uni.openDocument({
                        filePath: res.tempFilePath,
                        success: () => {
                            uni.showToast({ title: '导出成功', icon: 'success' })
                        },
                        fail: () => {
                            uni.showToast({ title: '已下载，打开文件失败', icon: 'none' })
                        }
                    })
                } else {
                    uni.showToast({ title: '导出失败 (' + res.statusCode + ')', icon: 'none' })
                }
            },
            fail: () => {
                uni.showToast({ title: '导出失败，请检查网络', icon: 'none' })
            },
            complete: () => {
                uni.hideLoading()
            }
        })
    }

    function onBack() : void {
        goBack()
    }

    onShow(() => {
        if (records.value.length == 0) {
            loadRecords(true)
        }
        loadStats()
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        background-color: #ffffff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
        align-items: center;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 统计卡片 */
    .stats-card {
        margin: 24rpx;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 32rpx 0;
        flex-direction: row;
        justify-content: space-around;
        border: 1rpx solid #eeeeee;
    }

    .stat-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
    }

    .stat-num {
        font-size: 48rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 8rpx;
    }

    .stat-label {
        font-size: 24rpx;
        color: #999999;
    }

    .stat-divider {
        width: 1rpx;
        background-color: #f0f0f0;
    }

    /* 筛选条 */
    .filter-bar {
        background-color: #ffffff;
        margin: 0 0 16rpx;
        padding: 16rpx 24rpx;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .filter-scroll {
        white-space: nowrap;
    }

    .filter-list {
        flex-direction: row;
        align-items: center;
    }

    .filter-chip {
        padding: 12rpx 28rpx;
        border-radius: 32rpx;
        background-color: #f5f5f5;
        margin-right: 16rpx;
    }

    .filter-chip.active {
        background-color: #e3f2fd;
        border: 1rpx solid #2979ff;
    }

    .filter-chip-text {
        font-size: 26rpx;
        color: #666666;
    }

    .filter-chip.active .filter-chip-text {
        color: #2979ff;
    }

    /* 错题列表 */
    .record-list {
