<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">我的收藏</text>
            <view class="header-right"></view>
        </view>

        <!-- 类型筛选 -->
        <view class="filter-bar">
            <scroll-view class="filter-scroll" scroll-x="true">
                <view v-for="(opt, idx) in typeOptions" :key="idx"
                    :class="['filter-chip', { active: currentType == opt.value }]"
                    @click="onTypeClick(opt.value)">
                    <text class="filter-chip-text">{{ opt.label }}</text>
                </view>
            </scroll-view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 收藏列表 -->
            <view v-if="items.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon">⭐</text>
                <text class="empty-text">暂无收藏</text>
            </view>
            <view class="fav-list">
                <view v-for="(item, idx) in items" :key="idx" class="fav-card" @click="onItemClick(item)">
                    <view v-if="item.cover.length > 0" class="fav-cover">
                        <image class="fav-cover-img" :src="item.cover" mode="aspectFill"></image>
                    </view>
                    <view v-else class="fav-cover fav-cover-fallback">
                        <text class="fav-cover-text">{{ getTypeLabel(item.target_type).charAt(0) }}</text>
                    </view>
                    <view class="fav-info">
                        <view class="fav-title-row">
                            <text class="fav-type-tag" :style="{ backgroundColor: getTypeColor(item.target_type) }">{{ getTypeLabel(item.target_type) }}</text>
                            <text class="fav-title">{{ item.title.length > 0 ? item.title : getTypeLabel(item.target_type) + ' #' + item.target_id }}</text>
                        </view>
                        <text v-if="item.created_at.length > 0" class="fav-time">{{ formatDateStr(item.created_at) }}</text>
                    </view>
                    <view class="fav-actions" @click.stop="onRemove(item)">
                        <text class="fav-remove-text">移除</text>
                    </view>
                </view>
            </view>
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && items.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getFavoritesApi, removeFavoriteApi } from '../../api/favorite'
    import type { FavoriteItem } from '../../types/index'
    import { formatDateStr } from '../../utils/format'

    type TypeOption = {
        label : string
        value : string
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const typeOptions : TypeOption[] = [
        { label: '全部', value: '' },
        { label: '课程', value: 'course' },
        { label: '章节', value: 'chapter' },
        { label: '帖子', value: 'topic' },
        { label: '资讯', value: 'featured' },
        { label: '题目', value: 'question' },
    ]

    const currentType = ref<string>('')
    const items = ref<FavoriteItem[]>([])
    const page = ref<number>(1)
    const pageSize = 20
    const total = ref<number>(0)
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)

    function getTypeLabel(type : string) : string {
        if (type == 'course') return '课程'
        if (type == 'chapter') return '章节'
        if (type == 'topic') return '帖子'
        if (type == 'featured') return '资讯'
        if (type == 'question') return '题目'
        return type
    }

    function getTypeColor(type : string) : string {
        if (type == 'course') return '#2979ff'
        if (type == 'chapter') return '#4caf50'
        if (type == 'topic') return '#f44336'
        if (type == 'featured') return '#9e9e9e'
        if (type == 'question') return '#ff9800'
        return '#999999'
    }

    async function loadFavorites(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loading.value = true
        try {
            const result = await getFavoritesApi(currentType.value, page.value, pageSize)
            if (reset) {
                items.value = result.items
            } else {
                items.value = items.value.concat(result.items)
            }
            total.value = result.total
            if (items.value.length >= result.total || result.items.length == 0) {
                noMore.value = true
            } else {
                page.value = page.value + 1
            }
        } catch (e) {
            uni.__f__('error','at pages/profile/favorites.uvue:140','[favorites] load failed:', e)
        } finally {
            loading.value = false
        }
    }

    function onTypeClick(val : string) : void {
        if (currentType.value == val) return
        currentType.value = val
        loadFavorites(true)
    }

    function onLoadMore() : void {
        loadFavorites(false)
    }

    function onItemClick(item : FavoriteItem) : void {
        if (item.target_type == 'course') {
            uni.navigateTo({ url: '/pages/courses/course-detail?id=' + item.target_id })
        } else if (item.target_type == 'topic') {
            uni.navigateTo({ url: '/pages/forum/forum-detail?id=' + item.target_id })
        } else if (item.target_type == 'chapter') {
            uni.navigateTo({ url: '/pages/courses/chapter-view?chapterId=' + item.target_id })
        }
    }

    function onRemove(item : FavoriteItem) : void {
        uni.showModal({
            title: '提示',
            content: '确定取消收藏？',
            success: (res) => {
                if (res.confirm) {
                    doRemove(item)
                }
            }
        })
    }

    async function doRemove(item : FavoriteItem) : Promise<void> {
        uni.showLoading({ title: '处理中...' })
        try {
            await removeFavoriteApi(item.favorite_id)
            uni.showToast({ title: '已取消收藏', icon: 'success' })
            const newList : FavoriteItem[] = []
            for (let i = 0; i < items.value.length; i++) {
                if (items.value[i].favorite_id != item.favorite_id) {
                    newList.push(items.value[i])
                }
            }
            items.value = newList
            total.value = Math.max(0, total.value - 1)
        } catch (e) {
            uni.__f__('error','at pages/profile/favorites.uvue:192','[favorites] remove failed:', e)
            uni.showToast({ title: '取消失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    function onBack() : void {
        goBack()
    }

    onShow(() => {
        loadFavorites(true)
    })
</script>

<style>
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
        align-items: center;
    }

    .filter-bar {
        background-color: #ffffff;
        margin: 0 24rpx 16rpx;
        margin-top: 16rpx;
        border-radius: 12rpx;
        border: 1px solid #eeeeee;
    }

    .filter-scroll {
        white-space: nowrap;
        border-radius: 12rpx;
        flex-direction: row;
        align-items: center;
        padding: 16rpx;
    }

    .filter-chip {
        padding: 10rpx 24rpx;
        border-radius: 32rpx;
        background-color: #f5f5f5;
        margin-right: 12rpx;
        flex-shrink: 0;
    }

    .filter-chip.active {
        background-color: #2979ff;
    }

    .filter-chip-text {
        font-size: 24rpx;
        color: #666666;
    }

    .filter-chip.active .filter-chip-text {
        color: #ffffff;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    .fav-list {
        flex-direction: column;
        padding: 0 24rpx;
    }

    .fav-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        flex-direction: row;
        align-items: center;
        border: 1px solid #eeeeee;
    }

    .fav-cover {
        width: 100rpx;
        height: 80rpx;
        border-radius: 10rpx;
        margin-right: 20rpx;
        overflow: hidden;
        flex-shrink: 0;
    }

    .fav-cover-img {
        width: 100rpx;
        height: 80rpx;
    }

    .fav-cover-fallback {
        background-color: #e3f2fd;
        align-items: center;
        justify-content: center;
    }

    .fav-cover-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #2979ff;
    }

    .fav-info {
        flex: 1;
        min-width: 0;
        flex-direction: column;
    }

    .fav-title-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 8rpx;
    }

    .fav-type-tag {
        font-size: 20rpx;
        color: #ffffff;
        padding: 4rpx 10rpx;
        border-radius: 6rpx;
        margin-right: 12rpx;
        flex-shrink: 0;
    }

    .fav-title {
        font-size: 28rpx;
        color: #333333;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        lines: 2;
        flex: 1;
    }

    .fav-time {
        font-size: 22rpx;
        color: #999999;
        margin-top: 4rpx;
    }

    .fav-actions {
        flex-shrink: 0;
        margin-left: 16rpx;
        padding: 8rpx 20rpx;
        border-radius: 24rpx;
        border: 1rpx solid #f44336;
        align-items: center;
        justify-content: center;
    }

    .fav-remove-text {
        font-size: 22rpx;
        color: #f44336;
    }

    .empty-tip {
        align-items: center;
        padding: 160rpx 0;
        flex-direction: column;
    }

    .empty-icon {
        font-size: 80rpx;
        margin-bottom: 24rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }
</style>
