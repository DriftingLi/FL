<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="我的收藏" variant="inverse" @left-click="onBack" />

        <!-- 类型筛选 -->
        <view class="filter-bar">
            <scroll-view class="filter-scroll" scroll-x="true">
                <view v-for="(opt, idx) in typeOptions" :key="idx"
                    :class="['filter-chip', { active: currentType == opt.value }]"
                    @click="onTypeClick(opt.value)">
                    <text class="filter-chip-text">{{ opt.label }}</text>
                </view>
            </scroll-view>
        </view>

        <!-- 类别下钻（#1947 / Q25）：只有「题目」类型有这一层；tagChips 为空 = 整行不渲染 -->
        <view v-if="tagChips.length > 0" class="filter-bar filter-bar-secondary">
            <scroll-view class="filter-scroll" scroll-x="true">
                <view v-for="chip in tagChips" :key="chip.tag_id"
                    :class="['filter-chip', { active: tagId == chip.tag_id }]"
                    @click="onTagClick(chip.tag_id)">
                    <text class="filter-chip-text">{{ chip.name }}</text>
                </view>
            </scroll-view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 收藏列表 -->
            <view v-if="items.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon">⭐</text>
                <text class="empty-text">暂无收藏</text>
            </view>
            <view class="fav-list">
                <view v-for="(item, idx) in items" :key="idx" class="fav-card" @click="onItemClick(item)">
                    <view v-if="item.cover.length > 0" class="fav-cover">
                        <image class="fav-cover-img" :src="item.cover" mode="aspectFill"></image>
                    </view>
                    <view v-else class="fav-cover fav-cover-fallback">
                        <text class="fav-cover-text">{{ getTypeLabel(item.target_type).charAt(0) }}</text>
                    </view>
                    <view class="fav-info">
                        <view class="fav-title-row">
                            <text class="fav-type-tag" :style="{ backgroundColor: getTypeColor(item.target_type) }">{{ getTypeLabel(item.target_type) }}</text>
                            <text class="fav-title">{{ item.title.length > 0 ? item.title : getTypeLabel(item.target_type) + ' #' + item.target_id }}</text>
                        </view>
                        <text v-if="item.company.length > 0" class="fav-sub">{{ jobSubline(item) }}</text>
                        <text v-if="item.created_at.length > 0" class="fav-time">{{ displayTime(item.created_at) }}</text>
                    </view>
                    <view class="fav-actions" @click.stop="onRemove(item)">
                        <text class="fav-remove-text">移除</text>
                    </view>
                </view>
            </view>
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && items.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
import { goBack } from '../../utils/navigation'
    import { getFavoritesApi, removeFavoriteApi } from '../../api/favorite'
    import { getTagsApi } from '../../api/course'
    import { getCurrentCredentialApi } from '../../api/credential'
    import type { FavoriteItem, TagItem } from '../../types/index'
    import { formatDateStr } from '../../utils/format'
    import { favoriteLanding } from '../../utils/favoriteLanding'
    import { favoriteTagChips } from '../../utils/favoriteTagDrill'
    import type { FavoriteTagChip } from '../../utils/favoriteTagDrill'

    /** 模板不可直调 import 函数（uvue 模板 import 调用编译为 .invoke() = Kotlin error18，先例 #677）；
     *  本地薄包装消费 utils/format 唯一实现（T03 口径：展示纯函数零第二实现） */
    function displayTime(dateStr : string) : string {
        return formatDateStr(dateStr)
    }

    type TypeOption = {
        label : string
        value : string
    }

    const windowHeight = uni.getSystemInfoSync().windowHeight

    const typeOptions : TypeOption[] = [
        { label: '全部', value: '' },
        { label: '课程', value: 'course' },
        { label: '章节', value: 'chapter' },
        { label: '帖子', value: 'topic' },
        { label: '资讯', value: 'featured' },
        { label: '题目', value: 'question' },
        { label: '职位', value: 'job' },
    ]

    /** 合法类型集（#1946）：路由参数 `type` 来自招聘「我的」三收藏格，越界值一律忽略，
     *  免得把一个后端不认的 target_type 透到查询串上。 */
    const VALID_TYPES : string[] = ['course', 'chapter', 'topic', 'featured', 'question', 'job']

    const currentType = ref<string>('')
    const items = ref<FavoriteItem[]>([])
    const page = ref<number>(1)
    const pageSize = 20
    const total = ref<number>(0)
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)

    /** 题库类别字典全量（#1947，`GET /tags`）与当前类型下的 chip 行（空数组 = 整行不渲染） */
    const allTags = ref<TagItem[]>([])
    const tagChips = ref<FavoriteTagChip[]>([])
    /** 当前下钻的类别：0 = 「全部」（不按类别过滤） */
    const tagId = ref<number>(0)

    function getTypeLabel(type : string) : string {
        if (type == 'course') return '课程'
        if (type == 'chapter') return '章节'
        if (type == 'topic') return '帖子'
        if (type == 'featured') return '资讯'
        if (type == 'question') return '题目'
        if (type == 'job') return '职位'
        return type
    }

    function getTypeColor(type : string) : string {
        if (type == 'course') return '#2979ff'
        if (type == 'chapter') return '#4caf50'
        if (type == 'topic') return '#f44336'
        if (type == 'featured') return '#9e9e9e'
        if (type == 'question') return '#ff9800'
        if (type == 'job') return '#1565c0'
        return '#999999'
    }

    /**
     * 职位条目的第二行「企业 · 地区」（#1946）。
     *
     * 后端只对 job 补齐这两键，其余类型是空串 ⇒ 本函数返回空串、模板据此不渲染该行。
     * 与 `displayTime` 同理是本页本地薄包装（模板不可直调 import 函数，#677）。
     */
    function jobSubline(item : FavoriteItem) : string {
        if (item.company.length == 0) return ''
        if (item.region.length == 0) return item.company
        return item.company + ' · ' + item.region
    }

    /**
     * 按当前类型重算类别 chip 行（#1947）。
     *
     * 决策在 `utils/favoriteTagDrill`（唯一实现；行为守护经 loadUts 真跑它）：非「题目」类型
     * 或字典为空都返回空数组 ⇒ 模板整行不渲染。页面不自己判断类型，免得这一层越界到其它 tab。
     */
    function refreshTagChips() : void {
        tagChips.value = favoriteTagChips(currentType.value, allTags.value)
    }

    /**
     * 拉题库类别字典（#1947，`GET /tags`）。
     *
     * 只在 onLoad 取一次；失败静默降级为「没有类别栏」——收藏列表本身照常可用，
     * 不该因为一个二级筛选挂掉整页。证件口径与练习页同源（`/tags` 是公开路由、handler
     * 自读 `credential_id`，见 docs/agents/credential-scope.md）：传当前证件才与学员题池对齐。
     */
    async function loadTagChips() : Promise<void> {
        let credentialId = 0
        try {
            const cred = await getCurrentCredentialApi()
            if (cred != null) { credentialId = cred!.id }
        } catch (e) {
            console.warn('[favorites] load credential failed:', e)
        }
        try {
            allTags.value = await getTagsApi(credentialId)
            refreshTagChips()
        } catch (e) {
            console.error('[favorites] load tags failed:', e)
        }
    }

    /** 请求代号：只为「谁的结果算数」服务（竞态注释见 loadFavorites 头） */
    const loadSeq = ref<number>(0)

    async function loadFavorites(reset : boolean = false) : Promise<void> {
        // 竞态（#1947）：原判据 `if (loading.value) return` 写在 reset 分支**之前** —— 连点两个
        // 类别（或两个类型）时，后一次的重置被静默丢弃：chip 高亮 B、列表还是 A，接着 loadMore
        // 还会把 B 的第 2 页拼到 A 的第 1 页。现在：追加仍被在途请求挡掉（同一页重拉没意义），
        // 重置**永远放行**，再由 loadSeq 丢弃过期响应（谁后发谁算数）。
        if (!reset && loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loadSeq.value = loadSeq.value + 1
        const seq = loadSeq.value
        loading.value = true
        try {
            const result = await getFavoritesApi(currentType.value, page.value, pageSize, tagId.value)
            if (seq != loadSeq.value) return
            if (reset) {
                items.value = result.items
            } else {
                items.value = items.value.concat(result.items)
            }
            total.value = result.total
            if (items.value.length >= result.total || result.items.length == 0) {
                noMore.value = true
            } else {
                page.value = page.value + 1
            }
        } catch (e) {
            console.error('[favorites] load failed:', e)
        } finally {
            if (seq == loadSeq.value) { loading.value = false }
        }
    }

    /** 类别 chip 点击（#1947）：`0` = 「全部」，等价于不带 tag_id 的那一次请求 */
    function onTagClick(val : number) : void {
        if (tagId.value == val) return
        tagId.value = val
        loadFavorites(true)
    }

    /**
     * 类型切换（#1947）：类别过滤**归零**——每个类型都从「全部」开始，免得带着上一类的
     * tag_id 看到一份被静默收窄的列表（api 层已兜住非 question 不下发，这里只管观感）。
     */
    function onTypeClick(val : string) : void {
        if (currentType.value == val) return
        currentType.value = val
        tagId.value = 0
        refreshTagChips()
        loadFavorites(true)
    }

    function onLoadMore() : void {
        loadFavorites(false)
    }

    /**
     * 条目点击 → **应用**落点决策（#1089 / #1237）。
     *
     * 落点口径**不在本页**：唯一实现在 `utils/favoriteLanding.uts` 的 `favoriteLanding()`，
     * 由 `utils/favoritesLandingContract.test.js` 经共享执行器（`utils/utsHarness.js` 的 `loadUts`）
     * **真跑那个模块**。页面这里只剩「应用决策」：`notice` 非空 → 可见提示；`url` 非空 → 跳转。
     *
     * 为什么搬出去（#1237）：落点表内联在本页时，只能被「取出函数体 + `new Function`」那类自搓执行器
     * 跑 —— 按 `docs/agents/guards.md` 的分类器判据它落不进**行为守护**，这一面因此没有 ③ 承重证据。
     */
    function onItemClick(item : FavoriteItem) : void {
        const landing = favoriteLanding(item)
        if (landing.notice.length > 0) {
            uni.showToast({ title: landing.notice, icon: 'none' })
        }
        if (landing.url.length > 0) {
            uni.navigateTo({ url: landing.url })
        }
    }

    async function doRemove(item : FavoriteItem) : Promise<void> {
        uni.showLoading({ title: '处理中...' })
        try {
            await removeFavoriteApi(item.favorite_id)
            uni.showToast({ title: '已取消收藏', icon: 'success' })
            const newList : FavoriteItem[] = []
            for (let i = 0; i < items.value.length; i++) {
                if (items.value[i].favorite_id != item.favorite_id) {
                    newList.push(items.value[i])
                }
            }
            items.value = newList
            total.value = Math.max(0, total.value - 1)
        } catch (e) {
            console.error('[favorites] remove failed:', e)
            uni.showToast({ title: '取消失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    function onRemove(item : FavoriteItem) : void {
        uni.showModal({
            title: '提示',
            content: '确定取消收藏？',
            success: (res) => {
                if (res.confirm) {
                    doRemove(item)
                }
            }
        })
    }

    function onBack() : void {
        goBack()
    }

    /**
     * 路由参数 `type`（#1946）：招聘「我的」页的「公告收藏 / 职位收藏」格直接落到对应 tab。
     *
     * 只认 VALID_TYPES（其余值静默忽略 ⇒ 回到「全部」），因为该参数是**跨页约定**、
     * 不是本页内部量；越界值透下去会让列表查询带一个后端不认的 target_type。
     * 首屏加载仍由下面的 onShow 触发（onLoad 先于 onShow），不在这里重复请求。
     */
    onLoad((options : OnLoadOptions) => {
        const opts = options as UTSJSONObject | null
        const t = opts != null ? opts['type'] : null
        if (t == null) return
        const want = t as string
        if (want.length == 0) return
        for (let i = 0; i < VALID_TYPES.length; i++) {
            if (VALID_TYPES[i] == want) {
                currentType.value = want
                return
            }
        }
    })

    /**
     * 每次显示都重取类别字典（#1947）：与练习页同节拍（practice.uvue 的 onShow 也重取证件 + 字典）。
     * 只挂 onLoad 会让「在别的页换了目标证件」后本页 chip 行停在旧证件的类别上；
     * 字典拉失败时 allTags 保持上一次成功的值，不闪空。
     */
    onShow(() => {
        loadTagChips()
        loadFavorites(true)
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .filter-bar {
        background-color: #ffffff;
        margin: 0 24rpx 16rpx;
        margin-top: 16rpx;
        border-radius: 12rpx;
        border: 1px solid #eeeeee;
    }

    /* 二级类别栏（#1947）：与类型栏同形，只是紧贴其下，不再吃一份上边距 */
    .filter-bar-secondary {
        margin-top: 0;
    }

    .filter-scroll {
        border-radius: 12rpx;
        flex-direction: row;
        align-items: center;
        padding: 16rpx;
    }

    .filter-chip {
        padding: 10rpx 24rpx;
        border-radius: 32rpx;
        background-color: #f5f5f5;
        margin-right: 12rpx;
        flex-shrink: 0;
    }

    .filter-chip.active {
        background-color: #2979ff;
    }

    .filter-chip-text {
        font-size: 24rpx;
        color: #666666;
    }

    .filter-chip.active .filter-chip-text {
        color: #ffffff;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    .fav-list {
        flex-direction: column;
        padding: 0 24rpx;
    }

    .fav-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        flex-direction: row;
        align-items: center;
        border: 1px solid #eeeeee;
    }

    .fav-cover {
        width: 100rpx;
        height: 80rpx;
        border-radius: 10rpx;
        margin-right: 20rpx;
        overflow: hidden;
        flex-shrink: 0;
    }

    .fav-cover-img {
        width: 100rpx;
        height: 80rpx;
    }

    .fav-cover-fallback {
        background-color: #e3f2fd;
        align-items: center;
        justify-content: center;
    }

    .fav-cover-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #2979ff;
    }

    .fav-info {
        flex: 1;
        min-width: 0;
        flex-direction: column;
    }

    .fav-title-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 8rpx;
    }

    .fav-type-tag {
        font-size: 20rpx;
        color: #ffffff;
        padding: 4rpx 10rpx;
        border-radius: 6rpx;
        margin-right: 12rpx;
        flex-shrink: 0;
    }

    .fav-title {
        font-size: 28rpx;
        color: #333333;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        lines: 2;
        flex: 1;
    }

    .fav-time {
        font-size: 22rpx;
        color: #999999;
        margin-top: 4rpx;
    }

    .fav-actions {
        flex-shrink: 0;
        margin-left: 16rpx;
        padding: 8rpx 20rpx;
        border-radius: 24rpx;
        border: 1rpx solid #f44336;
        align-items: center;
        justify-content: center;
    }

    .fav-remove-text {
        font-size: 22rpx;
        color: #f44336;
    }

    .empty-tip {
        align-items: center;
        padding: 160rpx 0;
        flex-direction: column;
    }

    .empty-icon {
        font-size: 80rpx;
        margin-bottom: 24rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    /* 职位条目第二行「企业 · 地区」（#1946）：文字类样式必须落 <text>，故挂在 .fav-sub 上 */
    .fav-sub {
        font-size: 22rpx;
        color: $text-color-secondary;
        margin-top: 2rpx;
        overflow: hidden;
        text-overflow: ellipsis;
        lines: 1;
    }
</style>
