<template>
  <view class="topic-card" @click="onCardTap">
    <text v-if="refHeader" class="reply-ref-title">回复了 {{ title }}</text>
    <text v-else class="topic-title">{{ title }}</text>
    <text v-if="hasContent" class="topic-preview">{{ contentPreview(content, contentFormat) }}</text>
    <view class="topic-footer">
      <view v-if="showStats" class="topic-stats">
        <text class="stat-text">{{ likesCount }} 赞</text>
        <text class="stat-text">{{ repliesCount }} 评论</text>
      </view>
      <text class="topic-time">{{ displayTime(createdDate) }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  // 个人动态列表卡（T03e #677）：六个 tab 变体共用（帖子/赞过/疑问/回复/围观/浏览）。
  // props 全部扁平原始值（#687 教训：可选对象 prop 成员直读 = Kotlin error18）；
  // 变体差异走显式布尔/字符串标志，footer 子节点渲染条件与旧内联版逐一对应。
  //
  // 原第七个变体「收藏」已于 2026-09-18 随「收藏的唯一列表承载面」裁定（根仓库 ADR-0018 补遗）
  // **整体摘除**：个人动态不承载收藏，故 `tagText` prop 与 `.tag-text` 样式一并删除
  // —— 它们当时的唯一消费方就是那一格。收藏条目的类型标签由 `pages/profile/favorites.uvue`
  // 的 `getTypeLabel()` 独任，本卡不再承担。
  import { formatDateStr } from '../../../utils/format'
  import { getContentPreview } from '../../../utils/forumDisplay'

  const props = withDefaults(defineProps<{
    title?: string
    content?: string
    createdDate?: string
    likesCount?: number
    repliesCount?: number
    showStats?: boolean
    refHeader?: boolean
    hasContent?: boolean
    contentFormat?: string // 正文格式轴（#1273；空串与非 markdown 都按纯文本投影）
  }>(), {
    title: '',
    content: '',
    createdDate: '',
    likesCount: 0,
    repliesCount: 0,
    showStats: false,
    refHeader: false,
    hasContent: false,
    contentFormat: ''
  })

  const emit = defineEmits(['tap'])

  /** 模板不可直调 import 函数（uvue 模板 import 调用编译为 .invoke() = Kotlin error18，
   *  #677 编译门实测）；本地薄包装后消费 utils/format 唯一实现 */
  function displayTime(dateStr : string) : string {
    return formatDateStr(dateStr)
  }

  /**
   * 摘要：本地薄包装，转发到唯一实现 `utils/forumDisplay.getContentPreview`（#1273）。
   * 原先这里是它的**逐字副本**（第三处实现，且不看格式）⇒ 已删（T03 口径：展示纯函数零第二实现）。
   * Markdown 帖因此与广场 / 知识问答 / 我的帖子同口径**剥成纯文本**（根 ADR-0044）。
   */
  function contentPreview(text : string, format : string) : string {
    return getContentPreview(text, format)
  }

  function onCardTap() : void {
    emit('tap')
  }
</script>

<style>
  .topic-card {
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 16rpx;
    border: 1rpx solid #eeeeee;
    flex-direction: column;
  }

  .topic-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333333;
    line-height: 1.4;
    margin-bottom: 12rpx;
  }

  .topic-preview {
    font-size: 26rpx;
    color: #666666;
    line-height: 1.5;
    margin-bottom: 12rpx;
  }

  .reply-ref-title {
    font-size: 26rpx;
    color: #2979ff;
    margin-bottom: 8rpx;
    font-weight: bold;
  }

  .topic-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .topic-stats {
    flex-direction: row;
    align-items: center;
  }

  .stat-text {
    font-size: 22rpx;
    color: #999999;
    margin-right: 16rpx;
  }

  .topic-time {
    font-size: 22rpx;
    color: #cccccc;
  }
</style>
