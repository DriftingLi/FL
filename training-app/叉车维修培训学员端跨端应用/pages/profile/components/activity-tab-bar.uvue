<template>
  <view v-if="sub" class="sub-tab-bar">
    <view v-for="(label, i) in labels" :key="i" class="sub-tab-item" :class="{ 'active': keys[i] == active }" @click="onTap(i)">
      <view class="sub-tab-inner">
        <text class="sub-tab-text" :class="{ 'active': keys[i] == active }">{{ label }}</text>
        <view class="sub-tab-underline"></view>
      </view>
    </view>
  </view>
  <view v-else class="tab-bar">
    <view v-for="(label, i) in labels" :key="i" class="tab-item" :class="{ 'active': keys[i] == active }" @click="onTap(i)">
      <view class="tab-inner">
        <text class="tab-text" :class="{ 'active': keys[i] == active }">{{ label }}</text>
        <view class="tab-underline"></view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // 个人动态 tab 栏（T03e #677）：主 tab 与子 tab 共用壳；
  // 纯展示，切换决策与取数留页面（emit switch 回传 key）。
  // 结构按 profilePage class 一一对应检查器语法：主/子分支类名全部字面量，无函数拼接。
  const props = withDefaults(defineProps<{
    keys?: string[]
    labels?: string[]
    active?: string
    sub?: boolean
  }>(), {
    keys: () : string[] => [],
    labels: () : string[] => [],
    active: '',
    sub: false
  })

  const emit = defineEmits(['switch'])

  function onTap(i : number) : void {
    emit('switch', props.keys[i])
  }
</script>

<style lang="scss">
  .tab-bar {
    flex-direction: row;
    background-color: #ffffff;
    border-bottom: 1rpx solid #eeeeee;
  }

  .tab-item {
    flex: 1;
    height: 88rpx;
    align-items: center;
    justify-content: center;
  }

  /* 票 2730 docx ⑧：下划线宽度跟文字走（原画在 flex:1 等宽格上，「互动」与「游览记录」一样宽） */
  .tab-inner {
    flex-direction: column;
    align-items: center;
  }

  .tab-underline {
    width: 100%;
    height: 4rpx;
    border-radius: 2rpx;
    margin-top: 6rpx;
    background-color: transparent;
  }

  .tab-item.active .tab-underline {
    background-color: $primary-color;
  }

  .tab-text {
    font-size: 28rpx;
    color: #666666;
  }

  .tab-text.active {
    color: $primary-color;
    font-weight: bold;
  }

  /* 子 Tab 栏 */
  .sub-tab-bar {
    flex-direction: row;
    background-color: #ffffff;
    border-bottom: 1rpx solid #eeeeee;
    padding: 0 24rpx;
  }

  .sub-tab-item {
    padding: 20rpx 32rpx;
    align-items: center;
    justify-content: center;
  }

  .sub-tab-inner {
    flex-direction: column;
    align-items: center;
  }

  .sub-tab-underline {
    width: 100%;
    height: 4rpx;
    border-radius: 2rpx;
    margin-top: 6rpx;
    background-color: transparent;
  }

  .sub-tab-item.active .sub-tab-underline {
    background-color: $primary-color;
  }

  .sub-tab-text {
    font-size: 32rpx;
    color: #999999;
  }

  .sub-tab-text.active {
    color: $primary-color;
    font-weight: bold;
  }
</style>
