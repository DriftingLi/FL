<template>
    <!-- 用户行：头像 + 昵称/等级 + 等级徽章（Lv1-9 规格）+ 签到胶囊 -->
    <view class="user-row">
        <view class="user-avatar" @click.stop="onAvatarTap">
            <image v-if="avatarUrl.length > 0" class="avatar-img" :src="avatarUrl" mode="aspectFill" :webp="true">
            </image>
            <image v-else class="avatar-img" src="/static/icons/avatar/avatar-default-youth.png" mode="aspectFill" />
        </view>
        <view class="user-info" @click="onInfoTap">
            <view class="name-row">
                <text class="user-name">{{ userName }}</text>
                <text class="user-lv">Lv{{ userLevel }}</text>
            </view>
            <view class="role-row">
                <app-level-badge :level="userLevel" />
            </view>
        </view>
        <view class="checkin-pill" @click="onCheckinTap">
            <text class="checkin-pill-text">{{ todayChecked ? '已签到' : '签到' }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import { useAuthStore } from '../../../stores/auth'
    import appLevelBadge from '../../../components/app-level-badge/app-level-badge.uvue'

    /** 用户行展示数据：学时来自页面（推导 Lv，徽章/星级由 app-level-badge 统一渲染），头像与昵称读 authStore */
    const props = withDefaults(defineProps<{
        studyMinutes ?: number
        todayChecked ?: boolean
    }>(), {
        studyMinutes: 0,
        todayChecked: false
    })

    const emit = defineEmits(['avatarTap', 'editNickname', 'checkinTap'])

    const authStore = useAuthStore()

    const userName = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null) {
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const avatarUrl = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })

    /**
     * 学员等级 Lv：按累计学时本地推导（后端无等级字段）
     * <5h → Lv1，<20h → Lv2，<50h → Lv3，<100h → Lv4，其余 Lv5
     */
    function levelFromHours(hours : number) : number {
        if (hours < 5) return 1
        if (hours < 20) return 2
        if (hours < 50) return 3
        if (hours < 100) return 4
        return 5
    }

    const userLevel = computed<number>(() : number => {
        return levelFromHours(props.studyMinutes / 60)
    })

    function onAvatarTap() : void {
        emit('avatarTap')
    }

    function onInfoTap() : void {
        emit('editNickname')
    }

    function onCheckinTap() : void {
        emit('checkinTap')
    }
</script>

<style lang="scss">
    /* 用户行（原型 979:1540） */
    .user-row {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 44rpx 0 32rpx;
    }

    .user-avatar {
        width: 116rpx;
        height: 116rpx;
        border-radius: 58rpx;
        background-color: $bg-color;
        border: 4rpx solid $card-bg;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .avatar-img {
        width: 116rpx;
        height: 116rpx;
        border-radius: 58rpx;
    }

    .user-info {
        flex: 1;
        flex-direction: column;
        margin-left: 24rpx;
    }

    .name-row {
        flex-direction: row;
        align-items: center;
    }

    .user-name {
        font-size: 40rpx;
        font-weight: bold;
        color: $text-color;
    }

    .user-lv {
        font-size: 22rpx;
        font-weight: bold;
        color: $text-color;
        margin-left: 16rpx;
    }

    .role-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8rpx;
    }

    /* 原型 979:1540：白底 + 主色描边 + 主色字的胶囊 */
    .checkin-pill {
        height: 52rpx;
        padding: 0 24rpx;
        border-radius: 26rpx;
        background-color: $card-bg;
        border: 1rpx solid $primary-color;
        align-items: center;
        justify-content: center;
        margin-left: 16rpx;
        flex-shrink: 0;
    }

    .checkin-pill-text {
        font-size: 26rpx;
        font-weight: bold;
        color: $primary-color;
    }
</style>
