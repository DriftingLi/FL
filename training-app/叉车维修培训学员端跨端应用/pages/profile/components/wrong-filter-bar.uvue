<template>
            <view class="filter-bar">
                <view class="filter-left">
                    <view class="filter-chip" :class="{ 'active': sortMode == 'time_asc' }" @click="onTimeTap">
                        <text class="filter-chip-text">{{ sortMode == 'time_asc' ? '最早在前 ▾' : '时间 ▾' }}</text>
                    </view>
                    <view class="filter-chip" :class="{ 'active': onlyFav }" @click="onFavTap">
                        <text class="filter-chip-text">{{ onlyFav ? '仅收藏 ▾' : '收藏 ▾' }}</text>
                    </view>
                    <view class="filter-chip" :class="{ 'active': onlyWrongMany }" @click="onWrongManyTap">
                        <text class="filter-chip-text">错多次</text>
                    </view>
                </view>
                <view class="filter-reset" @click="onResetTap">
                    <text class="filter-reset-text">重置</text>
                </view>
            </view>
</template>

<script setup lang="uts">
    // 筛选栏：ActionSheet 交互归组件；筛选状态真值源在页面（buildQuery 消费），组件以事件回传新值
    const props = withDefaults(defineProps<{
        sortMode?: string
        onlyFav?: boolean
        onlyWrongMany?: boolean
    }>(), {
        sortMode: 'desc',
        onlyFav: false,
        onlyWrongMany: false
    })

    const emit = defineEmits(['timeChange', 'favChange', 'wrongManyChange', 'reset'])

    function onTimeTap() : void {
        uni.showActionSheet({
            itemList: ['最近错误在前', '最早错误在前'],
            success: (res) => {
                emit('timeChange', res.tapIndex == 1 ? 'time_asc' : 'desc')
            }
        })
    }

    function onFavTap() : void {
        uni.showActionSheet({
            itemList: ['全部错题', '仅看收藏'],
            success: (res) => {
                emit('favChange', res.tapIndex == 1)
            }
        })
    }

    function onWrongManyTap() : void {
        emit('wrongManyChange')
    }

    function onResetTap() : void {
        emit('reset')
    }
</script>

<style lang="scss">
    /* 筛选栏（B3 票 2519 按原型 452:2223）：chips 坐在统计条下的白底带上，无卡片边框 */
    .filter-bar {
        background-color: $bg-header;
        margin: 0 24rpx;
        padding: 8rpx 4rpx 20rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .filter-left {
        flex-direction: row;
        align-items: center;
        flex: 1;
    }

    .filter-chip {
        padding: 12rpx 28rpx;
        border-radius: $radius-pill;
        background-color: $tag-bg-neutral;
        margin-right: 14rpx;
        flex-shrink: 0;
    }

    /* 选中态（原型实测）：浅蓝底 + 主色字，无描边 */
    .filter-chip.active {
        background-color: $primary-tint;
    }

    .filter-chip-text {
        font-size: 26rpx;
        color: $text-color;
    }

    .filter-chip.active .filter-chip-text {
        color: $primary-color;
    }

    .filter-reset {
        padding: 12rpx 8rpx;
        flex-shrink: 0;
    }

    .filter-reset-text {
        font-size: 26rpx;
        color: $text-color;
    }
</style>
