<template>
            <view class="filter-bar">
                <view class="filter-left">
                    <view class="filter-chip" :class="{ 'active': sortMode == 'time_asc' }" @click="onTimeTap">
                        <text class="filter-chip-text">{{ sortMode == 'time_asc' ? '最早在前 ▾' : '时间 ▾' }}</text>
                    </view>
                    <view class="filter-chip" :class="{ 'active': onlyFav }" @click="onFavTap">
                        <text class="filter-chip-text">{{ onlyFav ? '仅收藏 ▾' : '收藏 ▾' }}</text>
                    </view>
                    <view class="filter-chip" :class="{ 'active': onlyWrongMany }" @click="onWrongManyTap">
                        <text class="filter-chip-text">错多次</text>
                    </view>
                </view>
                <view class="filter-reset" @click="onResetTap">
                    <text class="filter-reset-text">重置</text>
                </view>
            </view>
</template>

<script setup lang="uts">
    // 筛选栏：ActionSheet 交互归组件；筛选状态真值源在页面（buildQuery 消费），组件以事件回传新值
    const props = withDefaults(defineProps<{
        sortMode?: string
        onlyFav?: boolean
        onlyWrongMany?: boolean
    }>(), {
        sortMode: 'desc',
        onlyFav: false,
        onlyWrongMany: false
    })

    const emit = defineEmits(['timeChange', 'favChange', 'wrongManyChange', 'reset'])

    function onTimeTap() : void {
        uni.showActionSheet({
            itemList: ['最近错误在前', '最早错误在前'],
            success: (res) => {
                emit('timeChange', res.tapIndex == 1 ? 'time_asc' : 'desc')
            }
        })
    }

    function onFavTap() : void {
        uni.showActionSheet({
            itemList: ['全部错题', '仅看收藏'],
            success: (res) => {
                emit('favChange', res.tapIndex == 1)
            }
        })
    }

    function onWrongManyTap() : void {
        emit('wrongManyChange')
    }

    function onResetTap() : void {
        emit('reset')
    }
</script>

<style>
    /* 筛选栏 */
    .filter-bar {
        background-color: #ffffff;
        margin: 0 24rpx;
        padding: 16rpx 20rpx;
        border-radius: 16rpx;
        border: 1rpx solid #eeeeee;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .filter-left {
        flex-direction: row;
        align-items: center;
        flex: 1;
    }

    .filter-chip {
        padding: 10rpx 24rpx;
        border-radius: 32rpx;
        background-color: #f5f5f5;
        margin-right: 14rpx;
        flex-shrink: 0;
    }

    .filter-chip.active {
        background-color: #e3f2fd;
        border: 1rpx solid #2979ff;
    }

    .filter-chip-text {
        font-size: 24rpx;
        color: #666666;
    }

    .filter-chip.active .filter-chip-text {
        color: #2979ff;
    }

    .filter-reset {
        padding: 10rpx 8rpx;
        flex-shrink: 0;
    }

    .filter-reset-text {
        font-size: 24rpx;
        color: #666666;
    }
</style>
