<template>
                <view class="record-card">
                    <view class="record-header">
                        <text class="record-type-tag">{{ displayTypeName }}</text>
                        <text class="record-wrong-count">错 {{ item.wrong_count }} 次</text>
                        <text v-if="item.favorited" class="record-fav-tag">收藏</text>
                        <text class="record-date">{{ displayDate }}</text>
                    </view>
                    <text class="record-title">{{ item.title }}</text>

                    <!-- 展开态：重做交互 -->
                    <view v-if="expanded" class="redo-section">
                        <view class="option-list">
                            <view v-for="(opt, oidx) in item.options" :key="oidx"
                                class="option-item" :class="getOptionClass(opt.key)"
                                @click="onSelect(opt.key)">
                                <view class="option-key" :class="getOptionKeyClass(opt.key)">
                                    <text class="option-key-text">{{ opt.key }}</text>
                                </view>
                                <text class="option-text">{{ opt.text }}</text>
                            </view>
                        </view>

                        <!-- 重做结果 -->
                        <view v-if="hasRedoResult()" class="redo-result"
                            :class="redoResultClass()">
                            <text class="redo-result-text">{{ redoResultLabel() }}</text>
                            <text class="redo-result-answer">我的答案：{{ redoResultUserAnswer() }}</text>
                            <text class="redo-result-answer">正确答案：{{ redoResultAnswer() }}</text>
                            <text v-if="redoResultLocalMatch()" class="redo-result-hint">提示：选项内容一致，可能因答案格式差异被判错</text>
                        </view>

                        <!-- 操作按钮 -->
                        <view class="redo-actions">
                            <view v-if="!hasRedoResult()" class="redo-btn redo-btn-primary"
                                @click="onSubmit">
                                <text class="redo-btn-text">提交答案</text>
                            </view>
                            <view v-if="hasRedoResult() && redoResultCorrect()" class="redo-btn redo-btn-success"
                                @click="onRemoveTap">
                                <text class="redo-btn-text">移出错题本</text>
                            </view>
                            <view v-else class="redo-btn redo-btn-danger" @click="onRemoveTap">
                                <text class="redo-btn-text">移出错题本</text>
                            </view>
                        </view>
                    </view>

                    <!-- 折叠态操作按钮 -->
                    <view v-if="!expanded" class="card-actions">
                        <view class="card-action-btn" @click="onToggle">
                            <text class="card-action-text">重做</text>
                        </view>
                        <view class="card-action-btn card-action-danger" @click="onRemoveTap">
                            <text class="card-action-text card-action-danger-text">移出</text>
                        </view>
                    </view>
                </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import type { WrongQuestionItem } from '../../../types/index'
    import { getTypeName, isMultiChoice } from '../../../utils/wrongQuestionDisplay'

    /** 错题卡片：展示 + 重做选项选中态（选中态属展示时态随卡片自持；提交结果由页面下发） */
    type RedoResult = {
        correct : boolean
        correct_answer : string
        explanation : string
    }

    const props = withDefaults(defineProps<{
        item?: WrongQuestionItem
        expanded?: boolean
        redoResult?: RedoResult | null
        lastRedoAnswer?: string
    }>(), {
        item: null as unknown as WrongQuestionItem,
        expanded: false,
        redoResult: null,
        lastRedoAnswer: ''
    })

    const emit = defineEmits(['toggleExpand', 'submitRedo', 'remove'])

    /** 选项选中态（展示时态，页面 onToggleExpand 切换 expanded 时经 expose 的 resetSelection 重置） */
    const selectedKeys = ref<string[]>([])

    function resetSelection() : void {
        selectedKeys.value = [] as string[]
    }

    function formatDateStr(dateStr : string) : string {
        if (dateStr == null || dateStr.length < 10) return dateStr
        return dateStr.substring(0, 10)
    }

    /** 是否已提交重做（模板调用） */
    function hasRedoResult() : boolean {
        return props.redoResult != null
    }

    /** 重做结果是否正确（模板调用） */
    function redoResultCorrect() : boolean {
        return props.redoResult != null && props.redoResult.correct
    }

    /** 重做结果样式类（模板调用） */
    function redoResultClass() : string {
        if (props.redoResult == null) return ''
        return props.redoResult.correct ? 'correct' : 'wrong'
    }

    /** 重做结果文案（模板调用） */
    function redoResultLabel() : string {
        if (props.redoResult == null) return ''
        return props.redoResult.correct ? '回答正确' : '回答错误'
    }

    /** 重做结果正确答案（模板调用） */
    function redoResultAnswer() : string {
        if (props.redoResult == null) return ''
        return props.redoResult.correct_answer
    }

    /** 重做结果用户答案（模板调用） */
    function redoResultUserAnswer() : string {
        return props.lastRedoAnswer.length > 0 ? props.lastRedoAnswer : '未作答'
    }

    /** 将答案字符串解析为 key 数组，兼容多种分隔符 */
    function parseAnswerKeys(answer : string) : string[] {
        if (answer.length == 0) return [] as string[]
        if (answer == 'true' || answer == 'false') return [answer] as string[]
        let separator = ''
        if (answer.indexOf(',') >= 0) separator = ','
        else if (answer.indexOf('，') >= 0) separator = '，'
        else if (answer.indexOf(' ') >= 0) separator = ' '
        else if (answer.indexOf(';') >= 0) separator = ';'
        else if (answer.indexOf('|') >= 0) separator = '|'
        if (separator.length > 0) {
            const parts = answer.split(separator)
            const keys : string[] = []
            for (let i = 0; i < parts.length; i++) {
                const k = parts[i].trim()
                if (k.length > 0) keys.push(k)
            }
            return keys
        }
        const keys : string[] = []
        for (let i = 0; i < answer.length; i++) {
            keys.push(answer.charAt(i))
        }
        return keys
    }

    /** 本地比对：用户答案与正确答案 key 集合是否一致（模板调用） */
    function redoResultLocalMatch() : boolean {
        const r = props.redoResult
        if (r == null) return false
        if (r.correct) return false
        const correctKeys = parseAnswerKeys(r.correct_answer)
        const userKeys = parseAnswerKeys(props.lastRedoAnswer)
        if (correctKeys.length != userKeys.length) return false
        if (correctKeys.length == 0) return false
        const sortedCorrect = correctKeys.slice().sort().join('')
        const sortedUser = userKeys.slice().sort().join('')
        return sortedCorrect == sortedUser
    }

    /** 选项是否已选中 */
    function isSelected(key : string) : boolean {
        return selectedKeys.value.indexOf(key) >= 0
    }

    /** 答案是否包含某 key */
    function isAnswerContains(answer : string, key : string) : boolean {
        const keys = parseAnswerKeys(answer)
        return keys.indexOf(key) >= 0
    }

    /** 选项样式类（模板调用） */
    function getOptionClass(key : string) : string {
        const r = props.redoResult
        if (r != null) {
            if (isAnswerContains(r.correct_answer, key)) return 'option-correct'
            if (isSelected(key) && !isAnswerContains(r.correct_answer, key)) return 'option-wrong'
            return ''
        }
        return isSelected(key) ? 'option-selected' : ''
    }

    /** 选项 key 样式类（模板调用） */
    function getOptionKeyClass(key : string) : string {
        const r = props.redoResult
        if (r != null) {
            if (isAnswerContains(r.correct_answer, key)) return 'option-key-correct'
            if (isSelected(key) && !isAnswerContains(r.correct_answer, key)) return 'option-key-wrong'
            return ''
        }
        return isSelected(key) ? 'option-key-selected' : ''
    }

    function displayTypeName() : string {
        return getTypeName(props.item.type)
    }

    function displayDate() : string {
        return formatDateStr(props.item.created_at)
    }

    /** 点击选项（多选切换 / 单选替换，与原页逻辑一致） */
    function onSelect(key : string) : void {
        if (props.redoResult != null) return
        if (isMultiChoice(props.item.type)) {
            const idx = selectedKeys.value.indexOf(key)
            if (idx >= 0) {
                selectedKeys.value.splice(idx, 1)
            } else {
                selectedKeys.value.push(key)
            }
        } else {
            const arr : string[] = [key]
            selectedKeys.value = arr
        }
    }

    function onToggle() : void {
        resetSelection()
        emit('toggleExpand')
    }

    function onSubmit() : void {
        emit('submitRedo', selectedKeys.value.slice())
    }

    function onRemoveTap() : void {
        emit('remove')
    }

    defineExpose({ resetSelection })
</script>

<style>
    .record-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        border: 1px solid #eeeeee;
        flex-direction: column;
    }

    .record-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 16rpx;
    }

    .record-type-tag {
        font-size: 20rpx;
        color: #ffffff;
        background-color: #ff5722;
        padding: 4rpx 12rpx;
        border-radius: 6rpx;
        margin-right: 12rpx;
    }

    .record-wrong-count {
        font-size: 22rpx;
        color: #f44336;
        background-color: #ffebee;
        padding: 4rpx 12rpx;
        border-radius: 6rpx;
        margin-right: 12rpx;
    }

    .record-fav-tag {
        font-size: 20rpx;
        color: #2979ff;
        background-color: #e3f2fd;
        padding: 4rpx 12rpx;
        border-radius: 6rpx;
        margin-right: 12rpx;
    }

    .record-date {
        font-size: 22rpx;
        color: #cccccc;
    }

    .record-title {
        font-size: 30rpx;
        color: #333333;
        line-height: 1.5;
        margin-bottom: 16rpx;
    }

    /* 重做区域 */
    .redo-section {
        flex-direction: column;
        margin-bottom: 16rpx;
    }

    .option-list {
        flex-direction: column;
        margin-bottom: 16rpx;
    }

    .option-item {
        flex-direction: row;
        align-items: center;
        padding: 20rpx 16rpx;
        background-color: #f8f9fa;
        border-radius: 8rpx;
        margin-bottom: 12rpx;
        border: 2rpx solid transparent;
    }

    .option-selected {
        background-color: #e3f2fd;
        border-color: #2979ff;
    }

    .option-correct {
        background-color: #e8f5e9;
        border-color: #4caf50;
    }

    .option-wrong {
        background-color: #ffebee;
        border-color: #f44336;
    }

    .option-key {
        width: 48rpx;
        height: 48rpx;
        border-radius: 24rpx;
        background-color: #e0e0e0;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .option-key-selected {
        background-color: #2979ff;
    }

    .option-key-correct {
        background-color: #4caf50;
    }

    .option-key-wrong {
        background-color: #f44336;
    }

    .option-key-text {
        font-size: 24rpx;
        font-weight: bold;
        color: #333333;
    }

    .option-key-selected .option-key-text {
        color: #ffffff;
    }

    .option-key-correct .option-key-text {
        color: #ffffff;
    }

    .option-key-wrong .option-key-text {
        color: #ffffff;
    }

    .option-text {
        flex: 1;
        font-size: 26rpx;
        color: #333333;
    }

    .redo-result {
        flex-direction: column;
        padding: 16rpx;
        border-radius: 8rpx;
        margin-bottom: 16rpx;
    }

    .redo-result.correct {
        background-color: #e8f5e9;
    }

    .redo-result.wrong {
        background-color: #ffebee;
    }

    .redo-result-text {
        font-size: 26rpx;
        font-weight: bold;
        margin-bottom: 8rpx;
    }

    .redo-result.correct .redo-result-text {
        color: #4caf50;
    }

    .redo-result.wrong .redo-result-text {
        color: #f44336;
    }

    .redo-result-answer {
        font-size: 24rpx;
        color: #666666;
    }

    .redo-result-hint {
        font-size: 22rpx;
        color: #ff9800;
        margin-top: 8rpx;
    }

    .redo-actions {
        flex-direction: row;
        justify-content: flex-end;
    }

    .redo-btn {
        padding: 12rpx 32rpx;
        border-radius: 32rpx;
        margin-left: 16rpx;
        align-items: center;
        justify-content: center;
    }

    .redo-btn-primary {
        background-color: #2979ff;
    }

    .redo-btn-success {
        background-color: #4caf50;
    }

    .redo-btn-danger {
        background-color: #ffffff;
        border: 1rpx solid #f44336;
    }

    .redo-btn-text {
        font-size: 24rpx;
        color: #ffffff;
    }

    .redo-btn-danger .redo-btn-text {
        color: #f44336;
    }

    /* 折叠态操作 */
    .card-actions {
        flex-direction: row;
        justify-content: flex-end;
        padding-top: 8rpx;
        border-top: 1rpx solid #f5f5f5;
    }

    .card-action-btn {
        padding: 8rpx 24rpx;
        border-radius: 24rpx;
        background-color: #2979ff;
        margin-left: 16rpx;
    }

    .card-action-danger {
        background-color: #ffffff;
        border: 1rpx solid #f44336;
    }

    .card-action-text {
        font-size: 24rpx;
        color: #ffffff;
    }

    .card-action-danger-text {
        color: #f44336;
    }
</style>
