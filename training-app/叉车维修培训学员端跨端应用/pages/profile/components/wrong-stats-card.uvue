<template>
            <!-- 统计卡片 -->
            <view class="stats-card">
                <view class="stat-item">
                    <text class="stat-label">我的错题</text>
                    <view class="stat-num-row">
                        <text class="stat-num">{{ stats.total }}</text>
                        <text class="stat-unit">道</text>
                    </view>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item">
                    <text class="stat-label">今日错题</text>
                    <view class="stat-num-row">
                        <text class="stat-num">{{ todayCount }}</text>
                        <text class="stat-unit">道</text>
                    </view>
                </view>
            </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { getWrongQuestionStatsApi } from '../../../api/wrongQuestion'
    import type { WrongQuestionStats } from '../../../types/index'

    const props = withDefaults(defineProps<{
        todayCount?: number
    }>(), {
        todayCount: 0
    })

    // 统计
    const stats = ref<WrongQuestionStats>({
        total: 0,
        by_type: {} as UTSJSONObject,
        by_knowledge_point: {} as UTSJSONObject,
    } as WrongQuestionStats)

    async function loadStats() {
        try {
            const data = await getWrongQuestionStatsApi()
            stats.value = data
        } catch (e) {
            console.error('[wrong-questions] load stats failed:', e)
        }
    }

</script>

<style>
    /* 统计卡片 */
    .stats-card {
        margin: 24rpx;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 32rpx 0;
        flex-direction: row;
        justify-content: space-around;
        border: 1rpx solid #eeeeee;
    }

    .stat-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
    }

    .stat-num-row {
        flex-direction: row;
        align-items: flex-start;
        justify-content: center;
    }

    .stat-num {
        font-size: 48rpx;
        font-weight: bold;
        color: #333333;
    }

    .stat-unit {
        font-size: 24rpx;
        color: #999999;
        margin-left: 8rpx;
    }

    .stat-label {
        font-size: 24rpx;
        color: #999999;
        margin-bottom: 8rpx;
    }

    .stat-divider {
        width: 1rpx;
        background-color: #f0f0f0;
    }

    /* 筛选栏 */
</style>
