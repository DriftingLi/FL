<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">设置</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 账号与安全 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onNavigate('personal-info')">
                        <text class="cell-label">账号与安全</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 功能设置 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onFeature('address')">
                        <text class="cell-label">收货地址</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell cell-border-none" @click="onToggleCareMode">
                        <text class="cell-label">关怀模式</text>
                        <text class="cell-value">{{ careModeEnabled ? '已开启' : '未开启' }}</text>
                    </view>
                </view>
            </view>

            <!-- 通知与存储 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onFeature('notification')">
                        <text class="cell-label">通知设置</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <!-- <view class="cell" @click="onClearCache"> -->
                    <view class="cell">
                        <text class="cell-label">清理缓存</text>
                        <text class="cell-value">{{ cacheSize }}</text>
                    </view>
                    <view class="cell" @click="onFeature('general')">
                        <text class="cell-label">通用</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell cell-border-none" @click="onFeature('device')">
                        <text class="cell-label">登录设备管理</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 隐私 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onFeature('privacy')">
                        <text class="cell-label">隐私</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onFeature('info-collection')">
                        <text class="cell-label">个人信息收集清单</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell cell-border-none" @click="onFeature('third-party')">
                        <text class="cell-label">第三方收集清单</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 关于 -->
            <view class="section">
                <view class="card">
                    <view class="cell cell-border-none" @click="onAbout">
                        <text class="cell-label">关于我们</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 退出登录 -->
            <view class="logout-wrap">
                <view class="logout-btn" @click="onLogout">
                    <text class="logout-text">退出登录</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, onMounted } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import { STORAGE_KEY_TOKEN, STORAGE_KEY_USER } from '../../constants/app'

    const authStore = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 关怀模式（本地存储）
    const careModeEnabled = ref<boolean>(false)
    // 缓存大小
    const cacheSize = ref<string>('0 KB')

    onMounted(() => {
        // 读取关怀模式状态
        const careMode = uni.getStorageSync('care_mode')
        careModeEnabled.value = careMode === 'true'
        // 计算缓存大小
        calculateCacheSize()
    })

    function calculateCacheSize() : void {
        try {
            const info = uni.getStorageInfoSync()
            const size = info.currentSize || 0
            if (size > 1024) {
                cacheSize.value = (size / 1024).toFixed(1) + ' MB'
            } else {
                cacheSize.value = size + ' KB'
            }
        } catch (e) {
            cacheSize.value = '0 KB'
        }
    }

    function onBack() : void {
        goBack()
    }

    function onNavigate(type : string) : void {
        if (type === 'personal-info') {
            uni.navigateTo({ url: '/pages/profile/personal-info' })
        }
    }

    function onToggleCareMode() : void {
        careModeEnabled.value = !careModeEnabled.value
        uni.setStorageSync('care_mode', careModeEnabled.value.toString())
        uni.showToast({
            title: careModeEnabled.value ? '关怀模式已开启' : '关怀模式已关闭',
            icon: 'none'
        })
    }

    function onClearCache() : void {
        uni.showModal({
            title: '提示',
            content: '确定要清理缓存吗？',
            success: (res) => {
                if (res.confirm) {
                    uni.showLoading({ title: '清理中...' })
                    try {
                        // 保留登录信息（使用正确的 key）
                        const token = uni.getStorageSync(STORAGE_KEY_TOKEN)
                        const userInfo = uni.getStorageSync(STORAGE_KEY_USER)
                        const careMode = uni.getStorageSync('care_mode')

                        // 清除所有缓存
                        uni.clearStorageSync()

                        // 恢复必要信息
                        if (token) uni.setStorageSync(STORAGE_KEY_TOKEN, token)
                        if (userInfo) uni.setStorageSync(STORAGE_KEY_USER, userInfo)
                        if (careMode) uni.setStorageSync('care_mode', careMode)

                        calculateCacheSize()
                        uni.showToast({ title: '清理完成', icon: 'success' })
                    } catch (e) {
                        uni.showToast({ title: '清理失败', icon: 'none' })
                    } finally {
                        uni.hideLoading()
                    }
                }
            }
        })
    }

    function onFeature(type : string) : void {
        const titles : Record<string, string> = {
            'address': '收货地址',
            'notification': '通知设置',
            'general': '通用设置',
            'device': '登录设备管理',
            'privacy': '隐私政策',
            'info-collection': '个人信息收集清单',
            'third-party': '第三方收集清单'
        }
        const title = titles[type] || type
        uni.showToast({ title: title + '（开发中）', icon: 'none' })
    }

    function onAbout() : void {
        uni.showToast({ title: '叉车维修培训学员端 v1.0.0', icon: 'none' })
    }

    function onLogout() : void {
        uni.showModal({
            title: '提示',
            content: '确认退出登录？',
            success: (res) => {
                if (res.confirm) {
                    // authStore.logout() 内部已包含 logoutApi 调用，无需重复调用
                    authStore.logout()
                }
            }
        })
    }
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        background-color: #ffffff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        width: 60rpx;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    .section {
        margin-top: 24rpx;
        padding: 0 32rpx;
    }

    .card {
        background-color: #ffffff;
        border-radius: 16rpx;
        flex-direction: column;
    }

    .cell {
        flex-direction: row;
        align-items: center;
        padding: 28rpx 24rpx;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .cell-border-none {
        border-bottom: none;
    }

    .cell-label {
        flex: 1;
        font-size: 30rpx;
        color: #333333;
    }

    .cell-value {
        font-size: 28rpx;
        color: #999999;
        margin-right: 8rpx;
    }

    .cell-arrow {
        font-size: 40rpx;
        color: #cccccc;
    }

    .logout-wrap {
        padding: 48rpx 32rpx;
    }

    .logout-btn {
        background-color: #ffffff;
        border-radius: 48rpx;
        padding: 24rpx 0;
        align-items: center;
    }

    .logout-text {
        font-size: 32rpx;
        color: #ff5252;
    }
</style>