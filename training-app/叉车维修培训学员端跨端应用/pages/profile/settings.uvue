<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="设置" @left-click="onBack" divider />
        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 账号与安全 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onNavigate('personal-info')">
                        <text class="cell-label">账号与安全</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 功能设置：关怀模式单独成卡（原型 307:6175 分组）；
                 「收货地址」入口按 G2 G-06 已裁定删除（虚拟商品无实物收货对象），不按原型恢复 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onToggleCareMode">
                        <text class="cell-label">关怀模式</text>
                        <text class="cell-value">{{ careModeEnabled ? '已开启' : '未开启' }}</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 通知与存储 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onFeature('notification')">
                        <text class="cell-label">通知设置</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onClearCache">
                        <text class="cell-label">清理缓存</text>
                        <text class="cell-value">{{ cacheSize }}</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onFeature('general')">
                        <text class="cell-label">通用</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onFeature('device')">
                        <text class="cell-label">登录设备管理</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 隐私与关于 -->
            <view class="section">
                <view class="card">
                    <view class="cell" @click="onFeature('privacy')">
                        <text class="cell-label">隐私</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onFeature('info-collection')">
                        <text class="cell-label">个人信息收集清单</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onFeature('third-party')">
                        <text class="cell-label">第三方收集清单</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onAbout">
                        <text class="cell-label">关于我们</text>
                        <text class="cell-arrow">›</text>
                    </view>
                </view>
            </view>

            <!-- 退出登录 -->
            <view class="logout-wrap">
                <view class="logout-btn" @click="onLogout">
                    <text class="logout-text">退出登录</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { ref, onMounted } from 'vue'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import { STORAGE_KEY_TOKEN, STORAGE_KEY_REFRESH_TOKEN, STORAGE_KEY_USER, STORAGE_KEY_LOGIN_PROVIDER } from '../../constants/app'

    const authStore = useAuthStore()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 关怀模式（本地存储）
    const careModeEnabled = ref<boolean>(false)
    // 缓存大小
    const cacheSize = ref<string>('0 KB')

    function calculateCacheSize() : void {
        try {
            const info = uni.getStorageInfoSync()
            const size = info.currentSize
            if (size > 1024) {
                cacheSize.value = (size / 1024).toFixed(1) + ' MB'
            } else {
                cacheSize.value = size + ' KB'
            }
        } catch (e) {
            cacheSize.value = '0 KB'
        }
    }

    onMounted(() => {
        // 读取关怀模式状态
        const careMode = uni.getStorageSync('care_mode')
        careModeEnabled.value = careMode === 'true'
        // 计算缓存大小
        calculateCacheSize()
    })

    function onBack() : void {
        goBack()
    }

    function onNavigate(type : string) : void {
        if (type === 'personal-info') {
            uni.navigateTo({ url: '/pages/profile/personal-info' })
        }
    }

    function onToggleCareMode() : void {
        careModeEnabled.value = !careModeEnabled.value
        uni.setStorageSync('care_mode', careModeEnabled.value.toString())
        uni.showToast({
            title: careModeEnabled.value ? '关怀模式已开启' : '关怀模式已关闭',
            icon: 'none'
        })
    }

    function onClearCache() : void {
        uni.showModal({
            title: '提示',
            content: '确定要清理缓存吗？',
            success: (res) => {
                if (res.confirm) {
                    uni.showLoading({ title: '清理中...' })
                    try {
                        // 保留登录信息（使用正确的 key）
                        const token = uni.getStorageSync(STORAGE_KEY_TOKEN)
                        const userInfo = uni.getStorageSync(STORAGE_KEY_USER)
                        // 清缓存不得削掉续期能力（#1124 根因 5）：refresh_token 是 access
                        // 过期后唯一的自动续期凭据，丢了它会话从此只能重新登录。
                        const refreshToken = uni.getStorageSync(STORAGE_KEY_REFRESH_TOKEN)
                        const loginProvider = uni.getStorageSync(STORAGE_KEY_LOGIN_PROVIDER)
                        const careMode = uni.getStorageSync('care_mode')

                        // 清除所有缓存
                        uni.clearStorageSync()

                        // 恢复必要信息
                        if (token != null) uni.setStorageSync(STORAGE_KEY_TOKEN, token as any)
                        if (userInfo != null) uni.setStorageSync(STORAGE_KEY_USER, userInfo as any)
                        if (refreshToken != null) uni.setStorageSync(STORAGE_KEY_REFRESH_TOKEN, refreshToken as any)
                        if (loginProvider != null) uni.setStorageSync(STORAGE_KEY_LOGIN_PROVIDER, loginProvider as any)
                        if (careMode != null) uni.setStorageSync('care_mode', careMode as any)

                        calculateCacheSize()
                        uni.showToast({ title: '清理完成', icon: 'success' })
                    } catch (e) {
                        uni.showToast({ title: '清理失败', icon: 'none' })
                    } finally {
                        uni.hideLoading()
                    }
                }
            }
        })
    }

    function onFeature(type : string) : void {
        const titles = new Map<string, string>()
        titles.set('notification', '通知设置')
        titles.set('general', '通用设置')
        titles.set('device', '登录设备管理')
        titles.set('privacy', '隐私政策')
        titles.set('info-collection', '个人信息收集清单')
        titles.set('third-party', '第三方收集清单')
        const title = titles.get(type) ?? type
        uni.showToast({ title: title + '（开发中）', icon: 'none' })
    }

    function onAbout() : void {
        uni.showToast({ title: '叉车维修培训学员端 v1.0.0', icon: 'none' })
    }

    function onLogout() : void {
        uni.showModal({
            title: '提示',
            content: '确认退出登录？',
            success: (res) => {
                if (res.confirm) {
                    // authStore.logout() 内部已包含 logoutApi 调用，无需重复调用
                    authStore.logout()
                }
            }
        })
    }
</script>

<style lang="scss">
    .container {
        display: flex;
        background-color: $bg-color;
        flex-direction: column;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    .section {
        margin-top: 24rpx;
        padding: 0 24rpx;
    }

    .card {
        background-color: $card-bg;
        border-radius: $radius-card;
        flex-direction: column;
    }

    /* 原型 307:6175：分组卡内行间无分割线，靠行高与留白分组 */
    .cell {
        flex-direction: row;
        align-items: center;
        padding: 24rpx;
    }

    .cell-label {
        flex: 1;
        font-size: 30rpx;
        color: $text-color;
    }

    .cell-value {
        font-size: 28rpx;
        color: $text-color-placeholder;
        margin-right: 8rpx;
    }

    /* 固定箭槽：宽度 + 行高统一，保证每行 › 的水平右缘与垂直中线都一致 */
    .cell-arrow {
        width: 32rpx;
        flex-shrink: 0;
        font-size: 40rpx;
        line-height: 44rpx;
        text-align: center;
        color: $text-disabled;
    }

    .logout-wrap {
        padding: 40rpx 24rpx;
    }

    .logout-btn {
        background-color: $card-bg;
        border-radius: $radius-card;
        padding: 30rpx 0;
        align-items: center;
    }

    .logout-text {
        font-size: 32rpx;
        color: $text-color;
    }
</style>