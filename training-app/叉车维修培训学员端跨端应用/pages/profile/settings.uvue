<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">设置</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 账号信息 -->
            <view class="section">
                <text class="section-title">账号</text>
                <view class="card">
                    <view class="cell" @click="onEditAvatar">
                        <text class="cell-label">头像</text>
                        <view class="cell-avatar-wrap">
                            <image v-if="avatarUrl.length > 0" class="cell-avatar" :src="avatarUrl" mode="aspectFill">
                            </image>
                            <view v-else class="cell-avatar-placeholder">
                                <text class="cell-avatar-icon">👤</text>
                            </view>
                        </view>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell" @click="onEditNickname">
                        <text class="cell-label">昵称</text>
                        <text class="cell-value">{{ userName }}</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell">
                        <text class="cell-label">手机号</text>
                        <text class="cell-value">{{ loginName }}</text>
                    </view>
                    <view class="cell">
                        <text class="cell-label">角色</text>
                        <text class="cell-value">叉车学员</text>
                    </view>
                </view>
            </view>

            <!-- 关于 -->
            <view class="section">
                <text class="section-title">关于</text>
                <view class="card">
                    <view class="cell" @click="onAbout">
                        <text class="cell-label">关于我们</text>
                        <text class="cell-arrow">›</text>
                    </view>
                    <view class="cell">
                        <text class="cell-label">当前版本</text>
                        <text class="cell-value">v1.0.0</text>
                    </view>
                </view>
            </view>

            <!-- 退出登录 -->
            <view class="logout-wrap">
                <view class="logout-btn" @click="onLogout">
                    <text class="logout-text">退出登录</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { useAuthStore } from '../../stores/auth'
    import { updateProfileApi, uploadAvatarApi } from '../../api/auth'
    import type { UpdateProfileParams } from '../../types/index'

    const authStore = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const uploadingAvatar = ref<boolean>(false)

    const userName = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null) {
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const loginName = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null) {
            return u.username
        }
        return '-'
    })

    const avatarUrl = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.avatar != null && u.avatar.length > 0) {
            return u.avatar!
        }
        return ''
    })

    function onBack() : void {
        uni.navigateBack()
    }

    function onAbout() : void {
        uni.showToast({ title: '叉车维修培训学员端 v1.0.0', icon: 'none' })
    }

    function onLogout() : void {
        uni.showModal({
            title: '提示',
            content: '确认退出登录？',
            success: (res) => {
                if (res.confirm) {
                    authStore.logout()
                }
            }
        })
    }

    /** 修改头像：选择图片 -> 上传 -> 更新资料 */
    function onEditAvatar() : void {
        if (uploadingAvatar.value) return
        uni.chooseImage({
            count: 1,
            sizeType: ['compressed'],
            sourceType: ['album', 'camera'],
            success: (res) => {
                const tempFilePaths = res.tempFilePaths
                if (tempFilePaths.length == 0) return
                uploadAvatar(tempFilePaths[0])
            },
            fail: (err) => {
                console.log('[settings] chooseImage canceled/failed:', err)
            }
        })
    }

    async function uploadAvatar(filePath : string) : Promise<void> {
        uploadingAvatar.value = true
        uni.showLoading({ title: '上传中...' })
        try {
            const upRes = await uploadAvatarApi(filePath)
            const newAvatarUrl = upRes.avatar
            if (newAvatarUrl.length == 0) {
                throw new Error('上传成功但未返回头像地址')
            }
            try {
                const patch : UpdateProfileParams = { avatar: newAvatarUrl } as UpdateProfileParams
                const updatedUser = await updateProfileApi(patch)
                authStore.setAuthData(authStore.token.value, updatedUser)
            } catch (e) {
                console.warn('[settings] updateProfileApi failed, fallback to local update:', e)
                const patch : UpdateProfileParams = { avatar: newAvatarUrl } as UpdateProfileParams
                authStore.updateUser(patch)
            }
            uni.showToast({ title: '头像更新成功', icon: 'success' })
        } catch (e) {
            console.error('[settings] uploadAvatar failed:', e)
            let msg = '头像上传失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            uploadingAvatar.value = false
            uni.hideLoading()
        }
    }

    /** 修改昵称 */
    function onEditNickname() : void {
        const current = authStore.user.value
        const currentName = current != null ? current.name : ''
        uni.showModal({
            title: '修改昵称',
            editable: true,
            placeholderText: '请输入新昵称',
            content: currentName,
            success: async (res) => {
                if (!res.confirm) return
                const content = res.content
                const newName = (content != null ? content : '').trim()
                if (newName.length == 0) {
                    uni.showToast({ title: '昵称不能为空', icon: 'none' })
                    return
                }
                if (newName == currentName) return
                uni.showLoading({ title: '保存中...' })
                try {
                    const patch : UpdateProfileParams = { name: newName } as UpdateProfileParams
                    const updatedUser = await updateProfileApi(patch)
                    authStore.setAuthData(authStore.token.value, updatedUser)
                    uni.showToast({ title: '修改成功', icon: 'success' })
                } catch (e) {
                    console.error('[settings] updateNickname failed:', e)
                    let msg = '修改失败'
                    if (e instanceof Error) {
                        const errObj = e as Error
                        const m = errObj.message
                        if (m != null && m.length > 0) {
                            msg = m
                        }
                    }
                    uni.showToast({ title: msg, icon: 'none' })
                } finally {
                    uni.hideLoading()
                }
            }
        })
    }
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
    }

    .header-right {
        width: 60rpx;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    .section {
        margin-top: 24rpx;
        padding: 0 32rpx;
    }

    .section-title {
        font-size: 26rpx;
        color: #999999;
        margin-bottom: 16rpx;
        padding-left: 8rpx;
    }

    .card {
        background-color: #ffffff;
        border-radius: 16rpx;
        border: 1px solid #eeeeee;
        flex-direction: column;
    }

    .cell {
        flex-direction: row;
        align-items: center;
        padding: 28rpx 24rpx;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .cell:last-child {
        border-bottom: none;
    }

    .cell-label {
        flex: 1;
        font-size: 30rpx;
        color: #333333;
    }

    .cell-value {
        font-size: 28rpx;
        color: #999999;
    }

    .cell-arrow {
        font-size: 40rpx;
        color: #cccccc;
    }

    .cell-avatar-wrap {
        width: 80rpx;
        height: 80rpx;
        margin-right: 16rpx;
        align-items: center;
        justify-content: center;
    }

    .cell-avatar {
        width: 80rpx;
        height: 80rpx;
        border-radius: 40rpx;
    }

    .cell-avatar-placeholder {
        width: 80rpx;
        height: 80rpx;
        border-radius: 40rpx;
        background-color: #4a9aff;
        align-items: center;
        justify-content: center;
    }

    .cell-avatar-icon {
        font-size: 44rpx;
    }

    .logout-wrap {
        padding: 48rpx 32rpx;
    }

    .logout-btn {
        background-color: #ffffff;
        border: 1rpx solid #ff5252;
        border-radius: 48rpx;
        padding: 24rpx 0;
        align-items: center;
    }

    .logout-text {
        font-size: 32rpx;
        color: #ff5252;
    }
</style>