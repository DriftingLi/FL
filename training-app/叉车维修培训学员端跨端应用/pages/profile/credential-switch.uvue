<template>
    <view class="page">
        <!-- 状态栏占位 -->
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-back" @click="goBack">
                <text class="nav-back-icon">‹</text>
            </view>
            <text class="nav-title">证件切换</text>
            <view class="nav-placeholder"></view>
        </view>

        <!-- 当前证件卡片 -->
        <view class="current-card" v-if="currentCredential != null">
            <view class="current-header">
                <text class="current-label">当前证件</text>
                <view class="current-badge">
                    <text class="current-badge-text">使用中</text>
                </view>
            </view>
            <view class="current-info">
                <view class="current-icon-wrap">
                    <text class="current-icon">{{ currentCredential.icon }}</text>
                </view>
                <view class="current-detail">
                    <text class="current-name">{{ currentCredential.name }}</text>
                    <text class="current-group">{{ currentCredential.group_name }}</text>
                </view>
            </view>
        </view>

        <!-- 证件列表 -->
        <scroll-view scroll-y class="scroll-area">
            <view v-for="(group, gIdx) in groups" :key="gIdx" class="section">
                <view class="section-header">
                    <view class="section-icon-wrap">
                        <text class="section-icon">{{ group.icon }}</text>
                    </view>
                    <text class="section-title">{{ group.group_name }}</text>
                </view>
                <view class="cert-list">
                    <view v-for="(item, idx) in group.items" :key="idx" class="cert-item"
                        :class="{ 'cert-item--active': selectedId === item.id }"
                        @click="onSelectCert(item)">
                        <view class="cert-left">
                            <text class="cert-name">{{ item.name }}</text>
                            <text class="cert-level" v-if="item.level.length > 0">{{ item.level }} · {{ item.desc }}</text>
                        </view>
                        <view class="cert-check" v-if="item.is_current">
                            <text class="cert-check-icon">✓</text>
                        </view>
                        <view class="cert-check cert-check--selected" v-else-if="selectedId === item.id">
                            <text class="cert-check-icon cert-check-icon--selected">✓</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 底部留白 -->
            <view style="height: 160rpx;"></view>
        </scroll-view>

        <!-- 底部确认按钮 -->
        <view class="bottom-bar">
            <view class="btn-confirm" :class="{ 'btn-confirm--disabled': !canConfirm }" @click="onConfirm">
                <text class="btn-confirm-text">{{ isSwitching ? '切换中...' : '确认切换' }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getCredentialApi, switchCredentialApi } from '../../api/credential'
    import type { CredentialItem, CredentialGroup } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()

    // ---- 状态 ----
    const currentCredential = ref<CredentialItem | null>(null)
    const groups = ref<CredentialGroup[]>([])
    const selectedId = ref('')
    const isSwitching = ref<boolean>(false)

    /** 是否可以确认切换（选中了与当前不同的证件） */
    const canConfirm = ref<boolean>(false)

    /** 加载证件数据 */
    async function loadData() {
        try {
            const data = await getCredentialApi()
            currentCredential.value = data.current_credential
            groups.value = data.groups
            if (currentCredential.value != null) {
                selectedId.value = currentCredential.value!.id
            }
        } catch (e) {
            console.error('[credential-switch] loadData failed:', e)
            uni.showToast({ title: '加载失败', icon: 'none' })
        }
    }

    /** 选择证件 */
    function onSelectCert(item : CredentialItem) : void {
        selectedId.value = item.id
        // 判断是否与当前证件不同
        if (currentCredential.value != null && item.id === currentCredential.value!.id) {
            canConfirm.value = false
        } else {
            canConfirm.value = true
        }
    }

    /** 确认切换 */
    async function onConfirm() : Promise<void> {
        if (!canConfirm.value || isSwitching.value) return

        isSwitching.value = true
        uni.showLoading({ title: '切换中...' })
        try {
            const result = await switchCredentialApi(selectedId.value)
            if (result.success) {
                currentCredential.value = result.current_credential
                // 更新所有证件的 is_current 标记
                for (let g = 0; g < groups.value.length; g++) {
                    const items = groups.value[g].items
                    for (let i = 0; i < items.length; i++) {
                        items[i].is_current = (items[i].id === selectedId.value)
                    }
                }
                canConfirm.value = false
                uni.showToast({ title: '切换成功', icon: 'success' })
            }
        } catch (e) {
            console.error('[credential-switch] switch failed:', e)
            let msg = '切换失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            isSwitching.value = false
            uni.hideLoading()
        }
    }

    // 页面加载时拉取数据
    loadData()
</script>

<style>
    .page {
        flex: 1;
        flex-direction: column;
        background-color: #F5F7FA;
    }

    .status-bar {
        background-color: #FFFFFF;
    }

    /* ---- 导航栏 ---- */
    .nav-bar {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        height: 88rpx;
        padding: 0 24rpx;
        background-color: #FFFFFF;
    }

    .nav-back {
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
    }

    .nav-back-icon {
        font-size: 52rpx;
        color: #333333;
    }

    .nav-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    .nav-placeholder {
        width: 64rpx;
        height: 64rpx;
    }

    /* ---- 当前证件卡片 ---- */
    .current-card {
        margin: 20rpx 32rpx 0;
        padding: 28rpx;
        background-color: #FFFFFF;
        border-radius: 20rpx;
        border-left: 8rpx solid #2979FF;
    }

    .current-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20rpx;
    }

    .current-label {
        font-size: 26rpx;
        color: #888888;
    }

    .current-badge {
        background-color: #EBF5FF;
        border-radius: 20rpx;
        padding: 4rpx 16rpx;
    }

    .current-badge-text {
        font-size: 22rpx;
        color: #2979FF;
        font-weight: 500;
    }

    .current-info {
        flex-direction: row;
        align-items: center;
    }

    .current-icon-wrap {
        width: 80rpx;
        height: 80rpx;
        border-radius: 16rpx;
        background-color: #F0F7FF;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
    }

    .current-icon {
        font-size: 40rpx;
    }

    .current-detail {
        flex: 1;
        flex-direction: column;
    }

    .current-name {
        font-size: 32rpx;
        font-weight: 600;
        color: #222222;
        margin-bottom: 4rpx;
    }

    .current-group {
        font-size: 24rpx;
        color: #888888;
    }

    /* ---- 滚动区域 ---- */
    .scroll-area {
        flex: 1;
    }

    /* ---- 分组区块 ---- */
    .section {
        margin: 16rpx 32rpx 0;
        background-color: #FFFFFF;
        border-radius: 20rpx;
        overflow: hidden;
    }

    .section-header {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 28rpx;
        border-bottom: 1rpx solid #F0F2F5;
    }

    .section-icon-wrap {
        width: 48rpx;
        height: 48rpx;
        border-radius: 10rpx;
        background-color: #F5F7FA;
        align-items: center;
        justify-content: center;
        margin-right: 14rpx;
    }

    .section-icon {
        font-size: 28rpx;
    }

    .section-title {
        font-size: 28rpx;
        font-weight: 600;
        color: #222222;
    }

    /* ---- 证件列表 ---- */
    .cert-list {
        flex-direction: column;
    }

    .cert-item {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 28rpx;
        border-bottom: 1rpx solid #F5F5F5;
    }

    .cert-item:last-child {
        border-bottom-width: 0;
    }

    .cert-item--active {
        background-color: #F8FBFF;
    }

    .cert-left {
        flex: 1;
        flex-direction: column;
    }

    .cert-name {
        font-size: 30rpx;
        color: #333333;
        margin-bottom: 4rpx;
    }

    .cert-level {
        font-size: 24rpx;
        color: #888888;
    }

    .cert-check {
        width: 44rpx;
        height: 44rpx;
        border-radius: 22rpx;
        border-width: 2rpx;
        border-color: #DDDDDD;
        border-style: solid;
        align-items: center;
        justify-content: center;
        margin-left: 20rpx;
    }

    .cert-check--selected {
        background-color: #2979FF;
        border-color: #2979FF;
    }

    .cert-check-icon {
        font-size: 26rpx;
        color: transparent;
    }

    .cert-check-icon--selected {
        color: #FFFFFF;
    }

    /* ---- 底部按钮 ---- */
    .bottom-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 20rpx 32rpx;
        padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
        background-color: #FFFFFF;
    }

    .btn-confirm {
        height: 96rpx;
        background: linear-gradient(135deg, #2979FF 0%, #1565C0 100%);
        border-radius: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .btn-confirm--disabled {
        opacity: 0.5;
    }

    .btn-confirm-text {
        font-size: 32rpx;
        font-weight: 600;
        color: #FFFFFF;
    }
</style>