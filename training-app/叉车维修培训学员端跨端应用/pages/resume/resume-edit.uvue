<template>
    <view class="page" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <!-- 顶栏：返回 / 标题 / 保存 -->
        <view class="nav-bar">
            <view class="nav-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="nav-title">在线简历</text>
            <view class="nav-right" @click="onSave">
                <text class="nav-save">保存</text>
            </view>
        </view>

        <scroll-view class="body" scroll-y="true">
            <!-- 完善度 -->
            <ResumeProgressCard :completion="edit.completion.value" />

            <!-- 基本信息 -->
            <ResumeBasicCard
                :real-name="edit.realName.value"
                :contact-phone="edit.contactPhone.value"
                :wechat="edit.wechat.value"
                :region="edit.region.value"
                @update:real-name="onRealNameUpdate"
                @update:contact-phone="onContactPhoneUpdate"
                @update:wechat="onWechatUpdate"
                @update:region="onRegionUpdate" />

            <!-- 求职期望 -->
            <ResumeExpectationCard
                :experience-years="edit.experienceYears.value"
                :selected-position-name="edit.selectedPositionName.value"
                :expected-position-extra="edit.expectedPositionExtra.value"
                :expected-regions-text="edit.expectedRegionsText.value"
                :salary-min="edit.salaryMin.value"
                :salary-max="edit.salaryMax.value"
                :salary-negotiable="edit.salaryNegotiable.value"
                :job-nature="edit.jobNature.value"
                :job-nature-label="edit.jobNatureLabel.value"
                :available-in="edit.availableIn.value"
                :available-in-label="edit.availableInLabel.value"
                @update:experience-years="onExperienceYearsUpdate"
                @update:expected-position-extra="onExpectedPositionExtraUpdate"
                @update:expected-regions-text="onExpectedRegionsTextUpdate"
                @update:salary-min="onSalaryMinUpdate"
                @update:salary-max="onSalaryMaxUpdate"
                @position-tap="onPositionTap"
                @job-nature-tap="onJobNatureTap"
                @available-in-tap="onAvailableInTap"
                @salary-negotiable-toggle="onSalaryNegotiableToggle" />

            <!-- 教育经历（纯本地，不提交后端）：列表编辑留页面壳层 —— 见文件尾「拆分判据」注释 -->
            <view class="card">
                <text class="card-title">教育经历</text>
                <view v-for="(item, idx) in edit.eduItems.value" :key="idx" class="sub-card">
                    <view class="sub-head">
                        <text class="sub-title">教育 {{ idx + 1 }}</text>
                        <text class="sub-del" @click="edit.removeEdu(idx)">删除</text>
                    </view>
                    <view class="field-row">
                        <text class="field-label">学校</text>
                        <input class="field-input" type="text" :maxlength="30" v-model="item.school" placeholder="学校名称" />
                    </view>
                    <view class="divider"></view>
                    <view class="field-row">
                        <text class="field-label">专业</text>
                        <input class="field-input" type="text" :maxlength="30" v-model="item.major" placeholder="所学专业" />
                    </view>
                    <view class="divider"></view>
                    <view class="field-row" @click="edit.onDegreeTap(idx)">
                        <text class="field-label">学历</text>
                        <view class="field-picker">
                            <text :class="item.degree.length > 0 ? 'field-value' : 'field-ph'">{{ item.degree.length > 0 ? item.degree : '请选择' }}</text>
                            <text class="field-arrow">›</text>
                        </view>
                    </view>
                    <view class="divider"></view>
                    <view class="field-row">
                        <text class="field-label">时间</text>
                        <view class="field-range">
                            <input class="field-range-input" type="text" :maxlength="7" v-model="item.start" placeholder="2020.09" />
                            <text class="field-range-sep">至</text>
                            <input class="field-range-input" type="text" :maxlength="7" v-model="item.end" placeholder="2023.06" />
                        </view>
                    </view>
                </view>
                <view class="add-btn" @click="edit.addEdu()">
                    <text class="add-btn-text">+ 添加教育经历</text>
                </view>
            </view>

            <!-- 工作经历 -->
            <view class="card">
                <text class="card-title">工作经历</text>
                <view v-for="(item, idx) in edit.expItems.value" :key="idx" class="sub-card">
                    <view class="sub-head">
                        <text class="sub-title">经历 {{ idx + 1 }}</text>
                        <text class="sub-del" @click="edit.removeExp(idx)">删除</text>
                    </view>
                    <view class="field-row">
                        <text class="field-label">公司</text>
                        <input class="field-input" type="text" :maxlength="30" v-model="item.company" placeholder="公司名称" />
                    </view>
                    <view class="divider"></view>
                    <view class="field-row">
                        <text class="field-label">职位</text>
                        <input class="field-input" type="text" :maxlength="30" v-model="item.role" placeholder="如：叉车维修工" />
                    </view>
                    <view class="divider"></view>
                    <view class="field-row">
                        <text class="field-label">时间</text>
                        <view class="field-range">
                            <input class="field-range-input" type="text" :maxlength="7" v-model="item.start_month" placeholder="2023.07" />
                            <text class="field-range-sep">至</text>
                            <input class="field-range-input" type="text" :maxlength="7" v-model="item.end_month" placeholder="至今" />
                        </view>
                    </view>
                    <view class="divider"></view>
                    <textarea class="area-input" :maxlength="500" v-model="item.desc" placeholder="工作内容：如日常叉车保养、液压系统检修、发动机故障排查…" :auto-height="true"></textarea>
                </view>
                <view class="add-btn" @click="edit.addExp()">
                    <text class="add-btn-text">+ 添加工作经历</text>
                </view>
            </view>

            <!-- 证书技能（本地展示，resume_certifications 提交空数组） -->
            <view class="card">
                <text class="card-title">证书与技能</text>
                <textarea class="area-input" :maxlength="300" v-model="edit.certs.value" placeholder="每行一条，如：叉车作业操作证（N1）、低压电工证" :auto-height="true"></textarea>
            </view>

            <!-- 自我介绍 -->
            <view class="card">
                <text class="card-title">自我介绍</text>
                <textarea class="area-input" :maxlength="1000" v-model="edit.selfIntro.value" placeholder="简单介绍你的维修经验、擅长机型、求职意向" :auto-height="true"></textarea>
                <text class="area-counter">{{ edit.selfIntro.value.length }}/1000</text>
            </view>

            <view class="bottom-space"></view>

            <view class="save-bar">
                <view class="save-btn" @click="onSave">
                    <text class="save-btn-text">保存简历</text>
                </view>
            </view>
            <view class="bottom-space"></view>
        </scroll-view>
    </view>
</template>

<!--
  拆分判据（T09 新增，回写 ADR-0007）：
  section 抽组件的**准入条件**是「接口面可以只有原始值 prop + 单参事件」。
  ① 完善度卡（纯展示）、② 基本信息卡 / 求职期望卡（单值字段组 + actionSheet 触发面）满足 ⇒ 抽组件；
  ③ 教育 / 工作经历列表 **不满足** —— 跨组件传行索引 + 逐字段改写只能用 `$event` 双参投递，
  属 T04 已录的「跨组件 v-model / 事件面」uvue 编译风险区（那次处置就是「模板留壳层」）；
  ④ 证书与技能 / 自我介绍是单 textarea 卡，抽出去只换来一个包装层 ⇒ 同样留壳层。
  状态所有权仍单一：留壳层的编辑态也全部归 useResumeEdit（页面只做 v-model 透传，不自持 ref）。
-->

<script setup lang="uts">
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useResumeEdit } from './composables/useResumeEdit'
    import ResumeProgressCard from './components/resume-progress-card.uvue'
    import ResumeBasicCard from './components/resume-basic-card.uvue'
    import ResumeExpectationCard from './components/resume-expectation-card.uvue'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 编辑态与保存流程全部下沉 composable，页面只保留模板与薄包装 handler
    const edit = useResumeEdit()

    function onBack() : void { goBack('/pages/resume/resume') }
    function onSave() : void { edit.onSave() }

    function onRealNameUpdate(v : string) : void { edit.setRealName(v) }
    function onContactPhoneUpdate(v : string) : void { edit.setContactPhone(v) }
    function onWechatUpdate(v : string) : void { edit.setWechat(v) }
    function onRegionUpdate(v : string) : void { edit.setRegion(v) }
    function onExperienceYearsUpdate(v : string) : void { edit.setExperienceYears(v) }
    function onExpectedPositionExtraUpdate(v : string) : void { edit.setExpectedPositionExtra(v) }
    function onExpectedRegionsTextUpdate(v : string) : void { edit.setExpectedRegionsText(v) }
    function onSalaryMinUpdate(v : string) : void { edit.setSalaryMin(v) }
    function onSalaryMaxUpdate(v : string) : void { edit.setSalaryMax(v) }
    function onPositionTap() : void { edit.onPositionTap() }
    function onJobNatureTap() : void { edit.onJobNatureTap() }
    function onAvailableInTap() : void { edit.onAvailableInTap() }
    function onSalaryNegotiableToggle() : void { edit.toggleSalaryNegotiable() }

    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17
    onLoad((options : OnLoadOptions) => {
        edit.boot()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #f5f6fa;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    /* ===== 顶栏 ===== */
    .nav-bar {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 12rpx 32rpx;
        background-color: #ffffff;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .nav-left {
        width: 100rpx;
    }

    .back-icon {
        font-size: 52rpx;
        color: #333333;
    }

    .nav-title {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .nav-right {
        width: 100rpx;
        align-items: flex-end;
    }

    .nav-save {
        font-size: 30rpx;
        color: #2979ff;
        font-weight: bold;
    }

    .body {
        flex: 1;
        height: 0;
        padding: 0 24rpx;
    }

    /* ===== 卡片与字段 ===== */
    .card {
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 28rpx;
        margin-top: 24rpx;
    }

    .card-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 8rpx;
    }

    .field-row {
        flex-direction: row;
        align-items: center;
        min-height: 96rpx;
    }

    .field-label {
        width: 170rpx;
        font-size: 28rpx;
        color: #666666;
        flex-shrink: 0;
    }

    .field-req {
        color: #fa3534;
        font-size: 26rpx;
    }

    .field-input {
        flex: 1;
        font-size: 28rpx;
        color: #333333;
        background-color: transparent;
        border: none;
        padding: 0;
        height: 80rpx;
    }

    .field-picker {
        flex: 1;
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
    }

    .field-value {
        font-size: 28rpx;
        color: #333333;
    }

    .field-ph {
        font-size: 28rpx;
        color: #bbbbbb;
    }

    .field-arrow {
        font-size: 32rpx;
        color: #cccccc;
        margin-left: 8rpx;
    }

    .field-range {
        flex: 1;
        flex-direction: row;
        align-items: center;
    }

    .field-range-input {
        width: 150rpx;
        height: 80rpx;
        font-size: 28rpx;
        color: #333333;
        background-color: #f7f8fa;
        border-radius: 8rpx;
        padding: 0 16rpx;
    }

    .field-range-sep {
        font-size: 26rpx;
        color: #999999;
        margin: 0 16rpx;
    }

    .divider {
        height: 1rpx;
        background-color: #f0f2f5;
    }

    .area-input {
        width: 100%;
        min-height: 160rpx;
        margin-top: 16rpx;
        padding: 20rpx;
        font-size: 28rpx;
        color: #333333;
        background-color: #f7f8fa;
        border-radius: 12rpx;
    }

    .area-counter {
        margin-top: 8rpx;
        font-size: 22rpx;
        color: #999999;
        text-align: right;
    }

    /* ===== 多段经历子卡 ===== */
    .sub-card {
        background-color: #fafbfd;
        border: 1rpx solid #eef1f6;
        border-radius: 16rpx;
        padding: 8rpx 24rpx;
        margin-top: 20rpx;
    }

    .sub-head {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        height: 72rpx;
    }

    .sub-title {
        font-size: 26rpx;
        color: #999999;
    }

    .sub-del {
        font-size: 26rpx;
        color: #fa3534;
    }

    .add-btn {
        margin-top: 24rpx;
        height: 80rpx;
        border-radius: 40rpx;
        border: 2rpx dashed #2979ff;
        align-items: center;
        justify-content: center;
    }

    .add-btn-text {
        font-size: 26rpx;
        color: #2979ff;
    }

    /* ===== 保存 ===== */
    .bottom-space {
        height: 24rpx;
    }

    .save-bar {
        padding: 8rpx 8rpx 0 8rpx;
    }

    .save-btn {
        height: 96rpx;
        border-radius: 48rpx;
        background-color: #2979ff;
        align-items: center;
        justify-content: center;
    }

    .save-btn-text {
        font-size: 32rpx;
        color: #ffffff;
        font-weight: bold;
    }
</style>
