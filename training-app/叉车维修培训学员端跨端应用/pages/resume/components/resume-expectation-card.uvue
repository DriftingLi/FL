<template>
    <!-- 求职期望卡 —— T09 手术自 pages/resume/resume-edit.uvue 逐段搬出，类名与结构逐字不变 -->
    <view class="card">
        <text class="card-title">求职期望</text>
        <view class="field-row" @click="onPositionTap">
            <text class="field-label">意向岗位<text class="field-req">*</text></text>
            <view class="field-picker">
                <text :class="selectedPositionName.length > 0 ? 'field-value' : 'field-ph'">{{ selectedPositionName.length > 0 ? selectedPositionName : '请选择' }}</text>
                <text class="field-arrow">›</text>
            </view>
        </view>
        <view class="divider"></view>
        <view class="field-row">
            <text class="field-label">岗位补充</text>
            <input class="field-input" type="text" :maxlength="50" :value="expectedPositionExtra" placeholder="如：柴油叉车维修" @input="onExpectedPositionExtraInput" />
        </view>
        <view class="divider"></view>
        <view class="field-row">
            <text class="field-label">意向地区</text>
            <input class="field-input" type="text" :maxlength="50" :value="expectedRegionsText" placeholder="多个用逗号分隔，如：杭州,上海" @input="onExpectedRegionsTextInput" />
        </view>
        <view class="divider"></view>
        <view class="field-row">
            <text class="field-label">薪资(K)</text>
            <view class="field-range">
                <input class="field-range-input" type="number" :value="salaryMin" placeholder="最低" @input="onSalaryMinInput" />
                <text class="field-range-sep">-</text>
                <input class="field-range-input" type="number" :value="salaryMax" placeholder="最高" @input="onSalaryMaxInput" />
            </view>
        </view>
        <view class="divider"></view>
        <view class="field-row" @click="onSalaryNegotiableToggle">
            <text class="field-label">薪资面议</text>
            <text :class="salaryNegotiable ? 'field-value' : 'field-ph'">{{ salaryNegotiable ? '是' : '否' }}</text>
        </view>
        <view class="divider"></view>
        <view class="field-row" @click="onJobNatureTap">
            <text class="field-label">工作类型</text>
            <view class="field-picker">
                <text :class="jobNature.length > 0 ? 'field-value' : 'field-ph'">{{ jobNatureLabel.length > 0 ? jobNatureLabel : '请选择' }}</text>
                <text class="field-arrow">›</text>
            </view>
        </view>
        <view class="divider"></view>
        <view class="field-row" @click="onAvailableInTap">
            <text class="field-label">到岗时间</text>
            <view class="field-picker">
                <text :class="availableIn.length > 0 ? 'field-value' : 'field-ph'">{{ availableInLabel.length > 0 ? availableInLabel : '请选择' }}</text>
                <text class="field-arrow">›</text>
            </view>
        </view>
        <view class="divider"></view>
        <view class="field-row">
            <text class="field-label">工作年限</text>
            <input class="field-input" type="number" :value="experienceYears" placeholder="如：3" @input="onExperienceYearsInput" />
        </view>
    </view>
</template>

<script setup lang="uts">
    // 单值字段组 + 三个 actionSheet 触发面：状态与取值逻辑全在 useResumeEdit，
    // 本组件只做「显示原始值 / 上报新值 / 上报点击」（`jobNature` / `availableIn` 原值一并收，
    // 是为了让 `field-value | field-ph` 判据与原页逐字一致，避免换成 label 判据造成边缘态样式漂移）
    const props = withDefaults(defineProps<{
        experienceYears? : string
        selectedPositionName? : string
        expectedPositionExtra? : string
        expectedRegionsText? : string
        salaryMin? : string
        salaryMax? : string
        salaryNegotiable? : boolean
        jobNature? : string
        jobNatureLabel? : string
        availableIn? : string
        availableInLabel? : string
    }>(), {
        experienceYears: '',
        selectedPositionName: '',
        expectedPositionExtra: '',
        expectedRegionsText: '',
        salaryMin: '',
        salaryMax: '',
        salaryNegotiable: false,
        jobNature: '',
        jobNatureLabel: '',
        availableIn: '',
        availableInLabel: ''
    })

    const emit = defineEmits<{
        (e: 'update:experienceYears', value : string): void
        (e: 'update:expectedPositionExtra', value : string): void
        (e: 'update:expectedRegionsText', value : string): void
        (e: 'update:salaryMin', value : string): void
        (e: 'update:salaryMax', value : string): void
        (e: 'positionTap'): void
        (e: 'jobNatureTap'): void
        (e: 'availableInTap'): void
        (e: 'salaryNegotiableToggle'): void
    }>()

    function onExperienceYearsInput(e : InputEvent) : void {
        emit('update:experienceYears', e.detail.value)
    }

    function onExpectedPositionExtraInput(e : InputEvent) : void {
        emit('update:expectedPositionExtra', e.detail.value)
    }

    function onExpectedRegionsTextInput(e : InputEvent) : void {
        emit('update:expectedRegionsText', e.detail.value)
    }

    function onSalaryMinInput(e : InputEvent) : void {
        emit('update:salaryMin', e.detail.value)
    }

    function onSalaryMaxInput(e : InputEvent) : void {
        emit('update:salaryMax', e.detail.value)
    }

    function onPositionTap() : void {
        emit('positionTap')
    }

    function onJobNatureTap() : void {
        emit('jobNatureTap')
    }

    function onAvailableInTap() : void {
        emit('availableInTap')
    }

    function onSalaryNegotiableToggle() : void {
        emit('salaryNegotiableToggle')
    }
</script>

<style>
    .card {
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 28rpx;
        margin-top: 24rpx;
    }

    .card-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 8rpx;
    }

    .field-row {
        flex-direction: row;
        align-items: center;
        min-height: 96rpx;
    }

    .field-label {
        width: 170rpx;
        font-size: 28rpx;
        color: #666666;
        flex-shrink: 0;
    }

    .field-req {
        color: #fa3534;
        font-size: 26rpx;
    }

    .field-input {
        flex: 1;
        font-size: 28rpx;
        color: #333333;
        background-color: transparent;
        border: none;
        padding: 0;
        height: 80rpx;
    }

    .field-picker {
        flex: 1;
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
    }

    .field-value {
        font-size: 28rpx;
        color: #333333;
    }

    .field-ph {
        font-size: 28rpx;
        color: #bbbbbb;
    }

    .field-arrow {
        font-size: 32rpx;
        color: #cccccc;
        margin-left: 8rpx;
    }

    .field-range {
        flex: 1;
        flex-direction: row;
        align-items: center;
    }

    .field-range-input {
        width: 150rpx;
        height: 80rpx;
        font-size: 28rpx;
        color: #333333;
        background-color: #f7f8fa;
        border-radius: 8rpx;
        padding: 0 16rpx;
    }

    .field-range-sep {
        font-size: 26rpx;
        color: #999999;
        margin: 0 16rpx;
    }

    .divider {
        height: 1rpx;
        background-color: #f0f2f5;
    }
</style>
