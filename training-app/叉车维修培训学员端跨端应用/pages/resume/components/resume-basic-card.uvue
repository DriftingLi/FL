<template>
    <!-- 基本信息卡 —— T09 手术自 pages/resume/resume-edit.uvue 逐段搬出，类名与结构逐字不变 -->
    <view class="card">
        <text class="card-title">基本信息</text>
        <view class="field-row">
            <text class="field-label">姓名<text class="field-req">*</text></text>
            <input class="field-input" type="text" :maxlength="20" :value="realName" placeholder="请输入姓名" @input="onRealNameInput" />
        </view>
        <view class="divider"></view>
        <view class="field-row">
            <text class="field-label">手机号<text class="field-req">*</text></text>
            <input class="field-input" type="number" :maxlength="11" :value="contactPhone" placeholder="用于企业联系你" @input="onContactPhoneInput" />
        </view>
        <view class="divider"></view>
        <view class="field-row">
            <text class="field-label">微信</text>
            <input class="field-input" type="text" :maxlength="50" :value="wechat" placeholder="选填" @input="onWechatInput" />
        </view>
        <view class="divider"></view>
        <view class="field-row">
            <text class="field-label">现居地</text>
            <input class="field-input" type="text" :maxlength="20" :value="region" placeholder="如：杭州" @input="onRegionInput" />
        </view>
    </view>
</template>

<script setup lang="uts">
    // 单值字段组：`:value` + `@input` 受控写法（先例 components/ai-chat/ai-chat-custom-form.uvue），
    // 状态归 useResumeEdit，本组件不自持编辑态（ADR-0007 数据所有权单一；禁跨组件 v-model）
    const props = withDefaults(defineProps<{
        realName? : string
        contactPhone? : string
        wechat? : string
        region? : string
    }>(), {
        realName: '',
        contactPhone: '',
        wechat: '',
        region: ''
    })

    const emit = defineEmits<{
        (e: 'update:realName', value : string): void
        (e: 'update:contactPhone', value : string): void
        (e: 'update:wechat', value : string): void
        (e: 'update:region', value : string): void
    }>()

    function onRealNameInput(e : InputEvent) : void {
        emit('update:realName', e.detail.value)
    }

    function onContactPhoneInput(e : InputEvent) : void {
        emit('update:contactPhone', e.detail.value)
    }

    function onWechatInput(e : InputEvent) : void {
        emit('update:wechat', e.detail.value)
    }

    function onRegionInput(e : InputEvent) : void {
        emit('update:region', e.detail.value)
    }
</script>

<style>
    .card {
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 28rpx;
        margin-top: 24rpx;
    }

    .card-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 8rpx;
    }

    .field-row {
        flex-direction: row;
        align-items: center;
        min-height: 96rpx;
    }

    .field-label {
        width: 170rpx;
        font-size: 28rpx;
        color: #666666;
        flex-shrink: 0;
    }

    .field-req {
        color: #fa3534;
        font-size: 26rpx;
    }

    .field-input {
        flex: 1;
        font-size: 28rpx;
        color: #333333;
        background-color: transparent;
        border: none;
        padding: 0;
        height: 80rpx;
    }

    .divider {
        height: 1rpx;
        background-color: #f0f2f5;
    }
</style>
