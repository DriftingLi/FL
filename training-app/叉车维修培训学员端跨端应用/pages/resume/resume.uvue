    .container {
        flex: 1;
        background-color: #f5f6fa;
        flex-direction: column;
    }

    .status-bar {
        background-color: #f5f6fa;
    }

    .header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 12rpx 32rpx;
        background-color: #f5f6fa;
    }

    .header-left {
        width: 80rpx;
    }

    .back-icon {
        font-size: 52rpx;
        color: #333333;
    }

    .bell-icon {
        font-size: 40rpx;
    }

    .content {
        flex: 1;
        height: 0;
        padding: 0 32rpx;
    }

    /* ===== 用户信息卡 ===== */
    .user-card {
        background-image: linear-gradient(135deg, #e3f0ff, #cfe4ff);
        border-radius: 24rpx;
        padding: 32rpx 24rpx 24rpx 24rpx;
    }

    .user-row {
        flex-direction: row;
        align-items: center;
        padding-left: 8rpx;
    }

    .avatar {
        width: 96rpx;
        height: 96rpx;
        border-radius: 48rpx;
        background-color: #ffffff;
    }

    .avatar-placeholder {
        align-items: center;
        justify-content: center;
    }

    .avatar-icon {
        font-size: 52rpx;
    }

    .user-meta {
        flex-direction: row;
        align-items: center;
        margin-left: 20rpx;
    }

    .user-name {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .lv-badge {
        margin-left: 12rpx;
        padding: 2rpx 12rpx;
        border-radius: 16rpx;
        background-color: #2979ff;
    }

    .lv-badge-text {
        font-size: 22rpx;
        color: #ffffff;
    }

    .stats-row {
        flex-direction: row;
        margin-top: 24rpx;
    }

    .stat-card {
        flex: 1;
        margin: 0 8rpx;
        align-items: center;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 20rpx 0;
    }

    .stat-num {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .stat-label {
        margin-top: 6rpx;
        font-size: 24rpx;
        color: #999999;
    }

    /* ===== 简历填写引导 ===== */
    .resume-guide {
        align-items: center;
        margin-top: 40rpx;
    }

    .resume-guide-text {
        font-size: 28rpx;
        color: #666666;
    }

    .resume-guide-btn {
        margin-top: 16rpx;
        padding: 12rpx 44rpx;
        border-radius: 36rpx;
        background-color: #2979ff;
    }

    .resume-guide-btn-text {
        font-size: 26rpx;
        color: #ffffff;
    }

    /* ===== 常用功能 ===== */
    .section-title {
        margin-top: 48rpx;
        margin-bottom: 20rpx;
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .func-grid {
        flex-direction: row;
        justify-content: space-between;
    }

    .func-card {
        width: 48%;
        align-items: center;
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 32rpx 0;
    }

    .func-icon {
        font-size: 56rpx;
    }

    .func-title {
        margin-top: 16rpx;
        font-size: 28rpx;
        font-weight: bold;
    }

    .func-title-online {
        color: #16a34a;
    }

    .func-title-attach {
        color: #2979ff;
    }

    .func-desc {
        margin-top: 8rpx;
        font-size: 22rpx;
        color: #999999;
    }
</style>
