<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <view class="header-right">
                <text class="bell-icon" @click="onNotifications">🔔</text>
            </view>
        </view>
        <scroll-view class="content" scroll-y="true">
            <!-- 用户信息卡 -->
            <view class="user-card">
                <view class="user-row">
                    <image v-if="avatarUrl.length > 0" class="avatar" :src="avatarUrl" mode="aspectFill" />
                    <view v-else class="avatar avatar-placeholder">
                        <text class="avatar-icon">👷</text>
                    </view>
                    <view class="user-meta">
                        <text class="user-name">{{ userName }}</text>
                        <view class="lv-badge">
                            <text class="lv-badge-text">Lv{{ userLevel }}</text>
                        </view>
                    </view>
                </view>
                <view class="stats-row">
                    <view class="stat-card">
                        <text class="stat-num">{{ noticeFavCount }}</text>
                        <text class="stat-label">公告收藏</text>
                    </view>
                    <view class="stat-card">
                        <text class="stat-num">{{ jobFavCount }}</text>
                        <text class="stat-label">职位收藏</text>
                    </view>
                    <view class="stat-card">
                        <text class="stat-num">{{ collectionFavCount }}</text>
                        <text class="stat-label">合集收藏</text>
                    </view>
                </view>
            </view>

            <!-- 简历完善度引导（#724 单页合并：真实 ResumeData 八项字段计算，服务端加载完成后未满 100% 展示） -->
            <view class="resume-guide" v-if="resumeIncomplete">
                <text class="resume-guide-icon">📄</text>
                <text class="resume-guide-text">去填写简历</text>
                <view class="resume-guide-prog-wrap">
                    <view class="resume-guide-prog-bar" :style="{ width: resumePct + '%' }"></view>
                </view>
                <text class="resume-guide-sub">完善度 {{ resumePct }}%（{{ resumeFilledCount }}/8 项已填写）</text>
                <view class="resume-guide-btn" @click="onOnlineResume">
                    <text class="resume-guide-btn-text">去完善</text>
                </view>
            </view>

            <!-- 常用功能 -->
            <text class="section-title">常用功能</text>
            <view class="func-grid">
                <view class="func-card" @click="onOnlineResume">
                    <text class="func-icon">📝</text>
                    <text class="func-title func-title-online">在线简历</text>
                    <text class="func-desc">优化增加推荐</text>
                </view>
                <view class="func-card" @click="onAttachmentResume">
                    <text class="func-icon">🗂️</text>
                    <text class="func-title func-title-attach">附件简历</text>
                    <text class="func-desc">制作/上传</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { getProfileApi } from '../../api/student'
    import { getFavoritesApi } from '../../api/favorite'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getResumeApi } from '../../api/resume'
    import type { StudentProfile, FavoriteListResult, ResumeData } from '../../types/index'

    const auth = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const profile = ref<StudentProfile | null>(null)
    const noticeFavCount = ref<number>(0)
    const jobFavCount = ref<number>(0)
    const collectionFavCount = ref<number>(0)
    // ---- 简历完善度（B 定稿：真实 ResumeData 八项字段计算，GET /resume 现有契约）----
    const RESUME_FIELD_TOTAL = 8
    const resumeFilledCount = ref<number>(0)
    const resumeStatusLoaded = ref<boolean>(false)
    const resumePct = computed<number>(() : number => {
        return Math.floor(resumeFilledCount.value * 100 / RESUME_FIELD_TOTAL)
    })
    // 服务端加载完成且未满 8 项才展示引导卡（加载前隐藏，避免闪烁）
    const resumeIncomplete = computed<boolean>(() : boolean => {
        return resumeStatusLoaded.value && resumeFilledCount.value < RESUME_FIELD_TOTAL
    })

    function countResumeFilled(r : ResumeData) : number {
        let n = 0
        if (r.real_name.length > 0) n = n + 1
        if (r.contact_phone.length > 0) n = n + 1
        if (r.wechat.length > 0) n = n + 1
        if (r.region.length > 0) n = n + 1
        if (r.expected_position_extra.length > 0) n = n + 1
        if (r.salary_min > 0 || r.salary_max > 0 || r.salary_negotiable) n = n + 1
        if (r.experience_years > 0) n = n + 1
        if (r.self_intro.length > 0) n = n + 1
        return n
    }

    const userName = computed<string>(() : string => {
        const u = auth.user.value
        if (u != null) {
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const avatarUrl = computed<string>(() : string => {
        const u = auth.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })

    /** 学员等级 Lv：与 profile.uvue 同一推导规则（后端无等级字段） */
    const userLevel = computed<number>(() : number => {
        let minutes = 0
        if (profile.value != null) {
            minutes = profile.value.total_study_duration
        }
        const hours = minutes / 60
        if (hours < 5) return 1
        if (hours < 20) return 2
        if (hours < 50) return 3
        if (hours < 100) return 4
        return 5
    })

    function onBack() : void {
        goBack()
    }

    function onNotifications() : void {
        uni.navigateTo({ url: '/pages/notifications/notifications' })
    }

    function onOnlineResume() : void {
        uni.navigateTo({ url: '/pages/resume/resume-edit' })
    }

    function onAttachmentResume() : void {
        uni.navigateTo({ url: '/pages/resume/resume-attach' })
    }

    /** 以服务端数据刷新完善度；kind=notfound → 0 项；其他错误保持上次状态（未加载成功则引导卡隐藏） */
    function refreshResumeFilled() : void {
        getResumeApi().then((r : ResumeData) : void => {
            resumeFilledCount.value = countResumeFilled(r)
            resumeStatusLoaded.value = true
        }).catch((e) : void => {
            let isNotFound = false
            try {
                const obj = e as UTSJSONObject
                if (obj['kind'] != null && `${obj['kind']}` == 'notfound') {
                    isNotFound = true
                }
            } catch (_ex) {}
            if (isNotFound) {
                resumeFilledCount.value = 0
                resumeStatusLoaded.value = true
            }
        })
    }

    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17
    onLoad((options : OnLoadOptions) => {
        auth.restoreFromStorage()
        getProfileApi().then((p : StudentProfile) : void => {
            profile.value = p
        }).catch((e) => {
            console.warn('[resume] load profile failed:', e)
        })
        // 公告/职位/合集收藏数：后端多态收藏暂未收录这三类 target_type，返回 total 恒为 0；
        // 接口就绪后此处无需改动映射
        getFavoritesApi('notice', 1, 1).then((res : FavoriteListResult) : void => {
            noticeFavCount.value = res.total
        }).catch(() => {})
        getFavoritesApi('job', 1, 1).then((res : FavoriteListResult) : void => {
            jobFavCount.value = res.total
        }).catch(() => {})
        getFavoritesApi('collection', 1, 1).then((res : FavoriteListResult) : void => {
            collectionFavCount.value = res.total
        }).catch(() => {})
    })

    onShow(() => {
        refreshResumeFilled()
    })
</script>

<style>
    .container {
        flex: 1;
        background-color: #f5f6fa;
        flex-direction: column;
    }

    .status-bar {
        background-color: #f5f6fa;
    }

    .header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 12rpx 32rpx;
        background-color: #f5f6fa;
    }

    .header-left {
        width: 80rpx;
    }

    .back-icon {
        font-size: 52rpx;
        color: #333333;
    }

    .bell-icon {
        font-size: 40rpx;
    }

    .content {
        flex: 1;
        height: 0;
        padding: 0 32rpx;
    }

    /* ===== 用户信息卡 ===== */
    .user-card {
        background-image: linear-gradient(135deg, #e3f0ff, #cfe4ff);
        border-radius: 24rpx;
        padding: 32rpx 24rpx 24rpx 24rpx;
    }

    .user-row {
        flex-direction: row;
        align-items: center;
        padding-left: 8rpx;
    }

    .avatar {
        width: 96rpx;
        height: 96rpx;
        border-radius: 48rpx;
        background-color: #ffffff;
    }

    .avatar-placeholder {
        align-items: center;
        justify-content: center;
    }

    .avatar-icon {
        font-size: 52rpx;
    }

    .user-meta {
        flex-direction: row;
        align-items: center;
        margin-left: 20rpx;
    }

    .user-name {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .lv-badge {
        margin-left: 12rpx;
        padding: 2rpx 12rpx;
        border-radius: 16rpx;
        background-color: #2979ff;
    }

    .lv-badge-text {
        font-size: 22rpx;
        color: #ffffff;
    }

    .stats-row {
        flex-direction: row;
        margin-top: 24rpx;
    }

    .stat-card {
        flex: 1;
        margin: 0 8rpx;
        align-items: center;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 20rpx 0;
    }

    .stat-num {
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
    }

    .stat-label {
        margin-top: 6rpx;
        font-size: 24rpx;
        color: #999999;
    }

    /* ===== 简历完善度引导（白卡，对齐原型「去填写简历」卡） ===== */
    .resume-guide {
        flex-direction: column;
        align-items: center;
        background-color: #ffffff;
        border-radius: 24rpx;
        padding: 32rpx 24rpx;
        margin-top: 24rpx;
    }

    .resume-guide-icon {
        font-size: 56rpx;
    }

    .resume-guide-text {
        font-size: 30rpx;
        font-weight: bold;
        color: #1a1a1a;
        margin-top: 12rpx;
    }

    .resume-guide-prog-wrap {
        width: 100%;
        height: 12rpx;
        background-color: #eef1f5;
        border-radius: 6rpx;
        margin-top: 20rpx;
    }

    .resume-guide-prog-bar {
        height: 12rpx;
        background-color: #2979ff;
        border-radius: 6rpx;
    }

    .resume-guide-sub {
        font-size: 22rpx;
        color: #999999;
        margin-top: 12rpx;
    }

    .resume-guide-btn {
        margin-top: 20rpx;
        padding: 12rpx 44rpx;
        border-radius: 36rpx;
        background-color: #2979ff;
    }

    .resume-guide-btn-text {
        font-size: 26rpx;
        color: #ffffff;
    }

    /* ===== 常用功能 ===== */
    .section-title {
        margin-top: 48rpx;
        margin-bottom: 20rpx;
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .func-grid {
        flex-direction: row;
        justify-content: space-between;
    }

    .func-card {
        width: 48%;
        align-items: center;
        background-color: #ffffff;
        border-radius: 20rpx;
        padding: 32rpx 0;
    }

    .func-icon {
        font-size: 56rpx;
    }

    .func-title {
        margin-top: 16rpx;
        font-size: 28rpx;
        font-weight: bold;
    }

    .func-title-online {
        color: #16a34a;
    }

    .func-title-attach {
        color: #2979ff;
    }

    .func-desc {
        margin-top: 8rpx;
        font-size: 22rpx;
        color: #999999;
    }
</style>
