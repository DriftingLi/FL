<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <view class="header-right">
                <text class="bell-icon" @click="onNotifications">🔔</text>
            </view>
        </view>
        <scroll-view class="content" scroll-y="true">
            <!-- 用户信息卡 -->
            <view class="user-card">
                <view class="user-row">
                    <image v-if="avatarUrl.length > 0" class="avatar" :src="avatarUrl" mode="aspectFill" />
                    <view v-else class="avatar avatar-placeholder">
                        <text class="avatar-icon">👷</text>
                    </view>
                    <view class="user-meta">
                        <text class="user-name">{{ userName }}</text>
                        <view class="lv-badge">
                            <text class="lv-badge-text">Lv{{ userLevel }}</text>
                        </view>
                    </view>
                </view>
                <view class="stats-row">
                    <view class="stat-card">
                        <text class="stat-num">{{ noticeFavCount }}</text>
                        <text class="stat-label">公告收藏</text>
                    </view>
                    <view class="stat-card">
                        <text class="stat-num">{{ jobFavCount }}</text>
                        <text class="stat-label">职位收藏</text>
                    </view>
                    <view class="stat-card">
                        <text class="stat-num">{{ collectionFavCount }}</text>
                        <text class="stat-label">合集收藏</text>
                    </view>
                </view>
            </view>

            <!-- 简历填写引导（未填写时展示） -->
            <view class="resume-guide" v-if="!resumeFilled">
                <text class="resume-guide-text">去填写简历</text>
                <view class="resume-guide-btn" @click="onOnlineResume">
                    <text class="resume-guide-btn-text">去完善</text>
                </view>
            </view>

            <!-- 常用功能 -->
            <text class="section-title">常用功能</text>
            <view class="func-grid">
                <view class="func-card" @click="onOnlineResume">
                    <text class="func-icon">📝</text>
                    <text class="func-title func-title-online">在线简历</text>
                    <text class="func-desc">优化增加推荐</text>
                </view>
                <view class="func-card" @click="onAttachmentResume">
                    <text class="func-icon">🗂️</text>
                    <text class="func-title func-title-attach">附件简历</text>
                    <text class="func-desc">制作/上传</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { getProfileApi } from '../../api/student'
    import { getFavoritesApi } from '../../api/favorite'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getStorageJSON } from '../../utils/storage'
    import { toStr } from '../../api/helpers'
    import { getResumeApi } from '../../api/resume'
    import { STORAGE_KEY_RESUME } from '../../constants/app'
    import type { StudentProfile, FavoriteListResult, ResumeData } from '../../types/index'

    const auth = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const profile = ref<StudentProfile | null>(null)
    const noticeFavCount = ref<number>(0)
    const jobFavCount = ref<number>(0)
    const collectionFavCount = ref<number>(0)
    // 在线简历是否已填写（以服务端数据为准）
    const resumeFilled = ref<boolean>(false)

    const userName = computed<string>(() : string => {
        const u = auth.user.value
        if (u != null) {
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const avatarUrl = computed<string>(() : string => {
        const u = auth.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })

    /** 学员等级 Lv：与 profile.uvue 同一推导规则（后端无等级字段） */
    const userLevel = computed<number>(() : number => {
        let minutes = 0
        if (profile.value != null) {
            minutes = profile.value.total_study_duration
        }
        const hours = minutes / 60
        if (hours < 5) return 1
        if (hours < 20) return 2
        if (hours < 50) return 3
        if (hours < 100) return 4
        return 5
    })

    function onBack() : void {
        goBack()
    }

    function onNotifications() : void {
        uni.navigateTo({ url: '/pages/notifications/notifications' })
    }

    function onOnlineResume() : void {
        uni.navigateTo({ url: '/pages/resume/resume-edit' })
    }

    function onAttachmentResume() : void {
        uni.navigateTo({ url: '/pages/resume/resume-attach' })
    }

    /** 以服务端数据为准判定简历是否已填写；kind=notfound → 未填写；其他错误不改状态 */
    function refreshResumeFilled() : void {
        // 先用本地草稿做即时初步推断
        const saved = getStorageJSON(STORAGE_KEY_RESUME)
        if (saved != null) {
            resumeFilled.value = toStr(saved['real_name'], '').length > 0
        }
        // 以服务端为准
        getResumeApi().then((r : ResumeData) : void => {
            resumeFilled.value = r.real_name.length > 0
        }).catch((e : any) : void => {
            let isNotFound = false
            try {
                const obj = e as UTSJSONObject
                if (obj['kind'] != null && `${obj['kind']}` == 'notfound') {
                    isNotFound = true
                }
            } catch (_ex) {}
            if (isNotFound) {
                resumeFilled.value = false
            }
            // 其他错误不改 resumeFilled，保持上次状态
        })
    }

    onLoad(() => {
        auth.restoreFromStorage()
        getProfileApi().then((p : StudentProfile) : void => {
            profile.value = p
        }).catch((e) => {
            console.warn('[resume] load profile failed:', e)
        })
        // 公告/职位/合集收藏数：后端多态收藏暂未收录这三类 target_type，返回 total 恒为 0；
        // 接口就绪后此处无需改动映射
        getFavoritesApi('notice', 1, 1).then((res : FavoriteListResult) : void => {
            noticeFavCount.value = res.total
        }).catch(() => {})
        getFavoritesApi('job', 1, 1).then((res : FavoriteListResult) : void => {
            jobFavCount.value = res.total
        }).catch(() => {})
        getFavoritesApi('collection', 1, 1).then((res : FavoriteListResult) : void => {
            collectionFavCount.value = res.total
        }).catch(() => {})
    })

    onShow(() => {
        refreshResumeFilled()
    })
</script>

