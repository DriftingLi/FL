	}

	.f-hub-back {
		left: 26rpx;
		top: 80rpx;
	}

	.f-hub-front {
		left: 54rpx;
		top: 80rpx;
	}

	/* 扳手（叉车右侧） */
	.f-wrench-ring {
		position: absolute;
		left: 103rpx;
		top: 18rpx;
		width: 19rpx;
		height: 19rpx;
		border-radius: 50%;
		border: 4rpx solid #16A34A;
	}

	.f-wrench-handle {
		position: absolute;
		left: 107rpx;
		top: 31rpx;
		width: 9rpx;
		height: 15rpx;
		border-radius: 4rpx;
		background-color: #16A34A;
	}

	.page-title {
		margin-top: 24rpx;
		font-size: 40rpx;
		font-weight: bold;
		color: #333333;
		text-align: center;
	}

	.page-subtitle {
		margin-top: 12rpx;
		font-size: 24rpx;
		color: #999999;
		text-align: center;
	}

	/* ===== 找回方式切换（手机号 / 邮箱） ===== */
	.mode-tabs {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		margin: 8rpx 0 40rpx 0;
	}

	.mode-tab {
		padding: 14rpx 44rpx;
		margin: 0 12rpx;
		font-size: 28rpx;
		color: #666666;
		background-color: #F0F1F5;
