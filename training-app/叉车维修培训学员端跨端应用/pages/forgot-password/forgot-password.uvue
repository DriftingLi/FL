<template>
	<view class="forgot-page">
		<!-- 顶部品牌区 -->
		<view class="header">
			<view class="logo-box">
				<image src="/static/logo.png" mode="aspectFit" style="width: 140rpx; height: 140rpx;"></image>
			</view>
			<text class="page-title">找回密码</text>
			<text class="page-subtitle">通过验证码重置登录密码</text>
		</view>

		<!-- 找回方式切换：手机号 / 邮箱 -->
		<view class="mode-tabs">
			<view class="mode-tab" :class="{ 'mode-tab-active': mode == 'phone' }" @click="switchMode('phone')">手机号找回</view>
			<view class="mode-tab" :class="{ 'mode-tab-active': mode == 'email' }" @click="switchMode('email')">邮箱找回</view>
		</view>

		<view class="form">
			<!-- ===== 手机号找回（默认） ===== -->
			<template v-if="mode == 'phone'">
				<view class="form-item">
					<view class="input-wrap">
						<text class="input-prefix">+86</text>
						<input class="input-base" type="number" placeholder="请输入注册手机号" :maxlength="11"
							:value="form.phone" @input="onPhoneInput" @confirm="onConfirm" />
					</view>
				</view>
			</template>

			<!-- ===== 邮箱找回 ===== -->
			<template v-else>
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入注册邮箱" :maxlength="50"
							:value="form.email" @input="onEmailInput" @confirm="onConfirm" />
					</view>
				</view>
			</template>

			<view class="form-item captcha-row">
				<view class="input-wrap captcha-input-wrap">
					<input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
						:value="captchaValue" @input="onCaptchaInput" />
				</view>
				<image class="captcha-img" :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
			</view>

			<view class="form-item code-row">
				<view class="code-input-wrap">
					<view class="input-wrap">
						<input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
							:value="form.code" @input="onCodeInput" @confirm="onConfirm" />
					</view>
				</view>
				<button class="code-btn" :class="{ 'code-btn-disabled': sendingCode || countdown > 0 }" :disabled="sendingCode || countdown > 0" @click="onSendCode">
					{{ countdown > 0 ? countdown + 's' : '获取验证码' }}
				</button>
			</view>
			<view class="form-item hint" v-if="codeHint.length > 0">
				<text class="hint-text">{{ codeHint }}</text>
			</view>

			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="true" placeholder="新密码（6-20 位）" :maxlength="32"
						:value="form.password" @input="onPasswordInput" />
				</view>
			</view>
			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="true" placeholder="请再次输入新密码" :maxlength="32"
						:value="form.confirmPassword" @input="onConfirmPasswordInput" @confirm="onConfirm" />
				</view>
			</view>

			<button class="btn-primary submit-btn" :class="{ 'btn-primary-disabled': loading }" :disabled="loading" @click="onSubmit">
				{{ loading ? '提交中...' : '重置密码' }}
			</button>

			<view class="footer">
				<text class="footer-text">想起密码了？</text>
				<text class="footer-link" @click="goLogin">返回登录</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { reactive, ref, computed } from 'vue'
	import { resetPasswordApi, sendCodeApi, getCaptchaApi } from '../../api/auth'

	// 重置表单数据类型（UTS 必须显式声明，否则 reactive 字段会被推断为 Any?）
	type ResetForm = {
		phone : string
		email : string
		code : string
		password : string
		confirmPassword : string
	}

	// 找回方式：phone（手机号找回，默认） | email（邮箱找回）
	const mode = ref<string>('phone')

	const form = reactive({
		phone: '',
		email: '',
		code: '',
		password: '',
		confirmPassword: '',
	} as ResetForm)

	// 图形验证码（人机验证，生产环境发送验证码前必填）
	const captchaId = ref<string>('')
	const captchaImage = ref<string>('')
	const captchaValue = ref<string>('')
	const captchaLoading = ref<boolean>(false)

	/** 加载图形验证码（进入页面/切换方式/点击图片刷新） */
	async function loadCaptcha() : Promise<void> {
		if (captchaLoading.value) return
		captchaLoading.value = true
		try {
			const data = await getCaptchaApi()
			captchaId.value = data['id'] as string
			captchaImage.value = data['image'] as string
			captchaValue.value = ''
		} catch (e) {
			console.error('[forgot-password] load captcha failed:', e)
		} finally {
			captchaLoading.value = false
		}
	}

	function refreshCaptcha() : void {
		loadCaptcha()
	}

	const loading = ref<boolean>(false)
	const sendingCode = ref<boolean>(false)
	// 验证码倒计时（秒）
	const countdown = ref<number>(0)
	let countdownTimer : number | null = null
	/** 清理倒计时定时器（局部副本承接：Kotlin 禁止对闭包中修改的 var 智能转换） */
	function clearCountdownTimer() : void {
		const timer = countdownTimer
		if (timer != null) {
			clearInterval(timer)
			countdownTimer = null
		}
	}
	// 连续输错次数（对齐后端：错误上限 5 次，发新码时清零）
	const wrongAttempts = ref<number>(0)

	onLoad((options : OnLoadOptions) => {
		loadCaptcha()
	})

	// 页面卸载时清理倒计时定时器
	onUnload(() => {
		clearCountdownTimer()
	})

	/** 切换找回方式：重置验证码倒计时并刷新图形验证码 */
	function switchMode(m : string) : void {
		if (m == mode.value) return
		mode.value = m
		clearCountdownTimer()
		countdown.value = 0
		wrongAttempts.value = 0
		loadCaptcha()
	}

	function validatePhone() : string {
		const phone : string = form.phone
		if (phone.length != 11) return '请输入 11 位手机号'
		if (!phone.startsWith('1')) return '手机号格式不正确'
		if (!/^\d{11}$/.test(phone)) return '手机号必须为数字'
		return ''
	}

	function validateEmail() : string {
		const t = form.email.trim()
		if (t.length == 0) return '请输入邮箱'
		if (t.indexOf('@') <= 0 || t.indexOf('.') <= 0) return '邮箱格式不正确'
		return ''
	}

	function startCountdown() : void {
		countdown.value = 60
		clearCountdownTimer()
		countdownTimer = setInterval(() => {
			countdown.value -= 1
			if (countdown.value <= 0) {
				clearCountdownTimer()
			}
		}, 1000) as number
	}

	async function onSendCode() : Promise<void> {
		if (sendingCode.value || countdown.value > 0) return
		if (captchaId.value.length == 0 || captchaValue.value.length == 0) {
			uni.showToast({ title: '请先输入图形验证码', icon: 'none' })
			return
		}
		let target = ''
		if (mode.value == 'phone') {
			const err = validatePhone()
			if (err.length > 0) {
				uni.showToast({ title: err, icon: 'none' })
				return
			}
			target = form.phone
		} else {
			const err = validateEmail()
			if (err.length > 0) {
				uni.showToast({ title: err, icon: 'none' })
				return
			}
			target = form.email.trim()
		}
		sendingCode.value = true
		uni.showLoading({ title: '发送中...', mask: true })
		try {
			await sendCodeApi(target, mode.value, 'reset_password', captchaId.value, captchaValue.value)
			// 发送成功后刷新图形验证码（答案用后即焚，防止重放）
			loadCaptcha()
			// 新验证码下发后重置本地连续输错计数（对齐后端错误上限）
			wrongAttempts.value = 0
			uni.hideLoading()
			uni.showToast({ title: '验证码已发送，请查收', icon: 'none' })
			startCountdown()
		} catch (e) {
			uni.hideLoading()
			console.error('[forgot-password] send code failed:', e)
			let msg = '验证码发送失败'
			if (e instanceof Error) {
				const errObj = e as Error
				const m = errObj.message
				if (m != null && m.length > 0) {
					msg = m
				}
			}
			uni.showToast({ title: msg, icon: 'none' })
			// 失败后刷新图形验证码：后端校验即消费（无论对错都会删除答案）
			loadCaptcha()
		} finally {
			sendingCode.value = false
		}
	}

	function validate() : string {
		const code : string = form.code
		const password : string = form.password
		const confirmPassword : string = form.confirmPassword
		if (mode.value == 'phone') {
			const err = validatePhone()
			if (err.length > 0) return err
		} else {
			const err = validateEmail()
			if (err.length > 0) return err
		}
		if (code.length == 0) return '请输入验证码'
		if (code.length != 6) return '请输入 6 位验证码'
		if (password.length < 6) return '密码至少 6 位'
		if (password != confirmPassword) return '两次输入的密码不一致'
		return ''
	}

	async function onSubmit() : Promise<void> {
		const errMsg = validate()
		if (errMsg.length > 0) {
			uni.showToast({ title: errMsg, icon: 'none' })
			return
		}

		loading.value = true
		uni.showLoading({ title: '提交中...', mask: true })

		try {
			const target = mode.value == 'phone' ? form.phone : form.email.trim()
			// 验证码通过后重置密码（不自动登录），成功后引导回登录页
			await resetPasswordApi(target, mode.value, form.code, form.password)
			uni.hideLoading()
			uni.showToast({ title: '密码已重置，请使用新密码登录', icon: 'success', duration: 1500 })
			setTimeout(() => {
				uni.redirectTo({ url: '/pages/login/login' })
			}, 1000)
		} catch (e) {
			uni.hideLoading()
			console.error('[forgot-password] reset failed:', e)
			// 验证码错误时累计连续输错次数（后端上限 5 次，到达后需重新获取）
			const m = e instanceof Error ? (e as Error).message : ''
			if (m.indexOf('验证码') >= 0) {
				wrongAttempts.value += 1
			}
			let msg = '重置失败，请重试'
			if (e instanceof Error) {
				const err = e as Error
				const mm = err.message
				if (mm != null && mm.length > 0) {
					msg = mm
				}
			}
			uni.showToast({ title: msg, icon: 'none' })
		} finally {
			loading.value = false
		}
	}

	// 验证码提示：说明后端规则 + 实时展示连续输错次数
	const codeHint = computed<string>(() : string => {
		if (wrongAttempts.value >= 5) {
			return '验证码错误次数过多，请点击获取验证码重新发送'
		}
		if (wrongAttempts.value > 0) {
			return '验证码错误，还可再试 ' + (5 - wrongAttempts.value) + ' 次'
		}
		return '6 位数字验证码，5 分钟内有效'
	})

	function goLogin() : void {
		uni.redirectTo({ url: '/pages/login/login' })
	}

	function onConfirm() : void {
		onSubmit()
	}

	function onPhoneInput(e : InputEvent) : void {
		form.phone = e.detail.value
	}

	function onEmailInput(e : InputEvent) : void {
		form.email = e.detail.value
	}

	function onCodeInput(e : InputEvent) : void {
		form.code = e.detail.value
	}

	function onPasswordInput(e : InputEvent) : void {
		form.password = e.detail.value
	}

	function onConfirmPasswordInput(e : InputEvent) : void {
		form.confirmPassword = e.detail.value
	}

	function onCaptchaInput(e : InputEvent) : void {
		captchaValue.value = e.detail.value
	}
</script>

