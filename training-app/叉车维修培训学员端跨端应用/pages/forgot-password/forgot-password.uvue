<template>
	<view class="forgot-page">
		<!-- 顶部品牌区 -->
		<view class="header">
			<view class="logo-box">
				<image src="/static/logo.png" mode="aspectFit" style="width: 140rpx; height: 140rpx;"></image>
			</view>
			<text class="page-title">找回密码</text>
			<text class="page-subtitle">通过验证码重置登录密码</text>
		</view>

		<!-- 找回方式切换：手机号 / 邮箱 -->
		<view class="mode-tabs">
			<view class="mode-tab" :class="{ 'mode-tab-active': fp.mode.value == 'phone' }" @click="fp.switchMode('phone')">手机号找回</view>
			<view class="mode-tab" :class="{ 'mode-tab-active': fp.mode.value == 'email' }" @click="fp.switchMode('email')">邮箱找回</view>
		</view>

		<view class="form">
			<!-- ===== 手机号找回（默认） ===== -->
			<template v-if="fp.mode.value == 'phone'">
				<view class="form-item">
					<view class="input-wrap">
						<text class="input-prefix">+86</text>
						<input class="input-base" type="number" placeholder="请输入注册手机号" :maxlength="11"
							:value="fp.form.value.phone" @input="onPhoneInput" @confirm="onConfirm" />
					</view>
				</view>
			</template>

			<!-- ===== 邮箱找回 ===== -->
			<template v-else>
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入注册邮箱" :maxlength="50"
							:value="fp.form.value.email" @input="onEmailInput" @confirm="onConfirm" />
					</view>
				</view>
			</template>

			<view class="form-item captcha-row">
				<view class="input-wrap captcha-input-wrap">
					<input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
						:value="fp.captchaValue.value" @input="onCaptchaInput" />
				</view>
				<image class="captcha-img" :src="fp.captchaImage.value" mode="aspectFit" @click="fp.refreshCaptcha()" />
			</view>

			<view class="form-item code-row">
				<view class="code-input-wrap">
					<view class="input-wrap">
						<input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
							:value="fp.form.value.code" @input="onCodeInput" @confirm="onConfirm" />
					</view>
				</view>
				<button class="code-btn" :class="{ 'code-btn-disabled': fp.sendingCode.value || fp.countdown.value > 0 }" :disabled="fp.sendingCode.value || fp.countdown.value > 0" @click="fp.onSendCode()">
					{{ fp.countdown.value > 0 ? fp.countdown.value + 's' : '获取验证码' }}
				</button>
			</view>
			<view class="form-item hint" v-if="fp.codeHint.value.length > 0">
				<text class="hint-text">{{ fp.codeHint.value }}</text>
			</view>

			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="true" placeholder="新密码（6-20 位）" :maxlength="32"
						:value="fp.form.value.password" @input="onPasswordInput" />
				</view>
			</view>
			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="true" placeholder="请再次输入新密码" :maxlength="32"
						:value="fp.form.value.confirmPassword" @input="onConfirmPasswordInput" @confirm="onConfirm" />
				</view>
			</view>

			<button class="btn-primary submit-btn" :class="{ 'btn-primary-disabled': fp.loading.value }" :disabled="fp.loading.value" @click="fp.onSubmit()">
				{{ fp.loading.value ? '提交中...' : '重置密码' }}
			</button>

			<view class="footer">
				<text class="footer-text">想起密码了？</text>
				<text class="footer-link" @click="fp.goLogin()">返回登录</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useForgotPasswordForm } from './composables/useForgotPasswordForm'

	// 找回态与全部动作下沉模块私有 composable；页面只保留模板、生命周期与薄包装 handler（T06–T11 先例）
	const fp = useForgotPasswordForm()

	// 输入面：uvue 的 InputEvent 留在壳层，只把值转交 composable（理由见 composable 文件头形态决定 ②）
	function onPhoneInput(e : InputEvent) : void { fp.setPhone(e.detail.value) }
	function onEmailInput(e : InputEvent) : void { fp.setEmail(e.detail.value) }
	function onCodeInput(e : InputEvent) : void { fp.setCode(e.detail.value) }
	function onPasswordInput(e : InputEvent) : void { fp.setPassword(e.detail.value) }
	function onConfirmPasswordInput(e : InputEvent) : void { fp.setConfirmPassword(e.detail.value) }
	function onCaptchaInput(e : InputEvent) : void { fp.setCaptchaValue(e.detail.value) }

	// 键盘「完成」等价于点重置密码（原 `onConfirm()` → `onSubmit()` 的调用逐字保持）
	function onConfirm() : void { fp.onSubmit() }

	onLoad((options : OnLoadOptions) => {
		fp.loadCaptcha()
	})

	// 页面卸载时清理倒计时定时器
	onUnload(() => {
		fp.clearCountdownTimer()
	})
</script>

