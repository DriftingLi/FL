		border: 2rpx solid transparent;
	}

	.mode-tab-active {
		background-color: #E8F3FF;
		color: #2979ff;
		border-color: #2979ff;
		font-weight: bold;
	}

	/* ===== 表单区 ===== */
	.form {
		padding: 0 56rpx;
	}

	.form-item {
		margin-bottom: 28rpx;
	}

	/* 灰底圆角输入框 */
	.input-wrap {
		flex-direction: row;
		align-items: center;
		background-color: #F5F6FA;
		border-radius: 16rpx;
		height: 96rpx;
		padding: 0 28rpx;
	}

	.input-prefix {
		font-size: 32rpx;
		color: #333333;
		font-weight: bold;
		margin-right: 16rpx;
		border-right: 2rpx solid #E0E2EA;
		padding-right: 16rpx;
	}

	.input-base {
		flex: 1;
		height: 96rpx;
		border: none;
		background-color: transparent;
		padding: 0;
		font-size: 30rpx;
		color: #333333;
	}

	/* 验证码行：输入框 + 获取验证码按钮 */
	.code-row {
		flex-direction: row;
		align-items: center;
	}

	.code-input-wrap {
		flex: 1;
		margin-right: 20rpx;
	}

	.code-btn {
		width: 200rpx;
		height: 96rpx;
		line-height: 96rpx;
		padding: 0;
		font-size: 26rpx;
		color: #2979ff;
		background-color: #ffffff;
		border: 2rpx solid #2979ff;
		border-radius: 48rpx;
		text-align: center;
	}

	.code-btn-disabled {
		opacity: 0.5;
	}

	/* 图形验证码行：输入框 + 图片 */
	.captcha-row {
		flex-direction: row;
		align-items: center;
	}

	.captcha-input-wrap {
		flex: 1;
		margin-right: 20rpx;
	}

	.captcha-input {
		font-size: 26rpx;
	}

	.captcha-img {
		width: 180rpx;
		height: 96rpx;
		border-radius: 16rpx;
		background-color: #F5F6FA;
	}

	/* 验证码规则提示 */
	.hint {
		margin-top: -16rpx;
		margin-bottom: 16rpx;
	}

	.hint-text {
		font-size: 22rpx;
		color: #999999;
	}

	/* 重置密码按钮 */
	.submit-btn {
		margin-top: 16rpx;
		width: 100%;
		height: 96rpx;
		line-height: 96rpx;
		border-radius: 48rpx;
		background-color: #2979ff;
		color: #ffffff;
		font-size: 34rpx;
		font-weight: bold;
		text-align: center;
		border: none;
	}

	.btn-primary-disabled {
		opacity: 0.6;
	}

	.footer {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		padding: 48rpx 0 60rpx 0;
	}

	.footer-text {
		font-size: 26rpx;
		color: #666666;
	}

	.footer-link {
		font-size: 26rpx;
		color: #2979ff;
		margin-left: 8rpx;
	}
</style>
