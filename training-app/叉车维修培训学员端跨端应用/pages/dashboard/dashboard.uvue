<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <scroll-view class="content-scroll" scroll-y="true">
            <view class="header">
                <view class="greeting">
                    <text class="greeting-text">你好，{{ userName }}</text>
                    <text class="greeting-sub">今天也要努力学习哦！</text>
                </view>
                <view class="avatar">
                    <text class="avatar-icon">👤</text>
                </view>
            </view>
            <view class="stats-card">
                <view class="stat-item">
                    <text class="stats-label">课程总数</text>
                    <text class="stats-value">{{ totalCourses }}</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item">
                    <text class="stats-label">已完成</text>
                    <text class="stats-value">{{ completedCourses }}</text>
                </view>
                <view class="stat-divider"></view>
                <view class="stat-item">
                    <text class="stats-label">学习时长</text>
                    <text class="stats-value">{{ studyHours }}</text>
                </view>
            </view>
            <view class="section">
                <view class="section-header">
                    <text class="section-title">快速入口</text>
                </view>
                <view class="grid">
                    <view class="grid-item" @click="onGridClick('courses')">
                        <view class="grid-icon-wrap">
                            <text class="grid-icon">📚</text>
                        </view>
                        <text class="grid-text">课程中心</text>
                    </view>
                    <view class="grid-item" @click="onGridClick('exam')">
                        <view class="grid-icon-wrap">
                            <text class="grid-icon">📝</text>
                        </view>
                        <text class="grid-text">在线考试</text>
                    </view>
                    <view class="grid-item" @click="onGridClick('practice')">
                        <view class="grid-icon-wrap">
                            <text class="grid-icon">✏️</text>
                        </view>
                        <text class="grid-text">题库练习</text>
                    </view>
                    <view class="grid-item" @click="onGridClick('profile')">
                        <view class="grid-icon-wrap">
                            <text class="grid-icon">👤</text>
                        </view>
                        <text class="grid-text">个人中心</text>
                    </view>
                </view>
            </view>
            <view class="section">
                <view class="section-header">
                    <text class="section-title">最近学习</text>
                    <text class="section-more" @click="onGridClick('courses')">查看全部 →</text>
                </view>
                <view v-if="recentCourses.length == 0" class="empty-tip">
                    <text class="empty-text">暂无学习记录</text>
                </view>
                <view class="course-list">
                    <view v-for="(course, idx) in recentCourses" :key="idx" class="course-item"
                        @click="onCourseClick(course.course_id)">
                        <view class="course-cover">
                            <text class="course-icon">{{ getCategoryIcon(course.category) }}</text>
                        </view>
                        <view class="course-info">
                            <text class="course-title">{{ course.title }}</text>
                            <text class="course-progress">{{ course.chapter_count }}章 ·
                                {{ formatDuration(course.duration) }}</text>
                        </view>
                        <view class="course-arrow">
                            <text class="arrow-icon">›</text>
                        </view>
                    </view>
                </view>
            </view>
        </scroll-view>
        <tab-bar :active-index="0"></tab-bar>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { useAuthStore } from '../../stores/auth'
    import { getProfileApi } from '../../api/student'
    import { getCourseListApi } from '../../api/course'
    import { useStatusBarHeight } from '../../utils/system'
    import type { StudentProfile, CourseItem } from '../../types/index'

    const authStore = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const profile = ref<StudentProfile | null>(null)
    const recentCourses = ref<CourseItem[]>([])

    const userName = computed<string>(() : string => {
        if (authStore.user.value != null) {
            const u = authStore.user.value
            if (u.name.length > 0) return u.name
            if (u.username.length > 0) return u.username
        }
        return '同学'
    })

    const totalCourses = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.total_courses
        }
        return recentCourses.value.length
    })

    const completedCourses = computed<number>(() : number => {
        if (profile.value != null) {
            return profile.value.completed_courses
        }
        return 0
    })

    const studyHours = computed<string>(() : string => {
        if (profile.value != null) {
            const minutes = profile.value.total_study_duration
            const hours = Math.floor(minutes / 60)
            const mins = minutes % 60
            if (hours > 0) {
                return hours + 'h' + mins + 'm'
            }
            return mins + 'm'
        }
        return '0m'
    })

    function getCategoryIcon(category : string) : string {
        if (category == 'driving') return '🚗'
        if (category == 'maintenance') return '🔧'
        if (category == 'safety') return '⚠️'
        if (category == 'troubleshooting') return '🔩'
        if (category == 'cargo') return '📐'
        if (category == 'electric') return '⚡'
        return '📚'
    }

    function formatDuration(seconds : number) : string {
        if (seconds <= 0) return ''
        const minutes = Math.floor(seconds / 60)
        if (minutes < 60) return minutes + '分钟'
        const hours = Math.floor(minutes / 60)
        const mins = minutes % 60
        return hours + 'h' + mins + 'm'
    }

    async function loadProfile() {
        try {
            const data = await getProfileApi()
            profile.value = data
        } catch (e) {
            console.error('[dashboard] load profile failed:', e)
        }
    }

    async function loadRecentCourses() {
        try {
            const result = await getCourseListApi(1, 3, '')
            recentCourses.value = result.items
        } catch (e) {
            console.error('[dashboard] load courses failed:', e)
        }
    }

    function onGridClick(type : string) : void {
        if (type == 'courses') {
            uni.reLaunch({ url: '/pages/courses/courses' })
        } else if (type == 'exam') {
            uni.reLaunch({ url: '/pages/exam/exam' })
        } else if (type == 'practice') {
            uni.showToast({ title: '题库练习开发中', icon: 'none' })
        } else if (type == 'profile') {
            uni.reLaunch({ url: '/pages/profile/profile' })
        }
    }

    function onCourseClick(courseId : number) : void {
        uni.showToast({ title: '课程详情开发中', icon: 'none' })
    }

    loadProfile()
    loadRecentCourses()
</script>

