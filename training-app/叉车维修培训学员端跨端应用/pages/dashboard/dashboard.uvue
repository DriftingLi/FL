    }

    .grid-text {
        font-size: 26rpx;
        color: #333333;
    }

    .course-list {
        flex-direction: column;
    }

    .course-item {
        flex-direction: row;
        align-items: center;
        padding: 20rpx 0;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .course-item:last-child {
        border-bottom: none;
    }

    .course-cover {
        width: 100rpx;
        height: 100rpx;
        border-radius: 12rpx;
        background-color: #f0f0f0;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
    }

    .course-icon {
