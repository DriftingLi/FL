<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <!-- #1602 迁移：页头收口到 app-nav-bar（唯一页头件，ADR-0035 禁 fork）。
             状态栏占位由页头件内化；搜索、商城与证件放在页头下方独立业务栏。 -->
        <!-- 一级页页头仅保留状态栏与88rpx导航行；证件、搜索、商城移至下方独立业务栏。 -->
        <AppNavBar variant="plain" transparent :left-icon="''" />

        <view class="credential-bar">
            <view class="credential-picker" @click="onCertTap">
                <text class="credential-name">{{ currentCert }}</text>
                <text class="credential-arrow">⌄</text>
            </view>
            <view class="header-actions">
                <view class="header-action" @click="onHeaderSearch">
                    <image class="header-action-icon" src="/static/icons/mall/search.png" mode="aspectFit"></image>
                </view>
                <view class="header-action" @click="onHeaderMall">
                    <image class="header-action-icon header-mall-icon" src="/static/icons/dashboard/grid-course-mall.png"
                        mode="aspectFit"></image>
                </view>
            </view>
        </view>

        <!-- 公告栏 -->
        <view class="notice-bar" @click="onNoticeClick">
            <text class="notice-icon">📢</text>
            <text class="notice-text">叉车维修培训开课通知，欢迎报名学习</text>
            <text class="notice-arrow">›</text>
        </view>

        <!-- 证件选择面板（共享领域件 cert-selector，#1395 提升搬家）
             #2535 Q3：浮层升级为与 choose-cert 主态同源的完整面板——省份 + 分组 + 热门考证 + 完成；
             点选只改待确认项，点「完成」才 PATCH 落库，关闭面板不改证件。
             below-nav-bar 让页头保持可见（设计稿 324_9793：面板从页头下方起、上圆角）。 -->
        <CertSelector v-if="showCertDropdown" :groups="credentialGroups"
            :current-id="pendingCredentialId" :province="province" :show-province="true" :confirmable="true"
            :below-nav-bar="true" :top-inset="credentialPanelTop" @close="onCloseCertDropdown" @select="onPickCredential"
            @confirm="onConfirmCredential" @province-tap="onProvinceTap" />

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- Banner 海报（原型 404_2195 的 Rectangle 39：704x320 = 352x160 容器 2x，图内含「叉车维修培训」整版文案） -->
            <view class="banner" @click="onBannerClick">
                <image class="banner-img" src="/static/Rectangle_39.png" mode="widthFix"></image>
            </view>

            <!-- 功能入口网格 -->
            <DashboardMenuGrid />

            <!-- 继续学习 -->
            <DashboardContinueCard v-if="continueLearning != null" :course-name="continueLearning!.course_name"
                :chapter-title="continueLearning!.last_chapter_title" :progress="continueLearning!.progress"
                @click="onContinueLearning" />

            <!-- 新闻资讯板块 -->
            <DashboardNewsSection :news-list="newsList" :failed="newsFailed" :active-filter="newsFilter"
                @click="onNewsClick" @more="onMoreNews" @retry="loadFeaturedContents"
                @filter-change="selectNewsFilter" />

            <!-- 内容 Tab + 筛选标签 + 课程卡片列表（#1422：数据源改为真实热门课程，经 props 流入） -->
            <DashboardCourseSection :courses="hotCourses" @open-filter="onFilterBtnClick" @course-open="onCourseOpen" />

            <!-- 底部留白（tabBar 悬浮遮挡） -->
            <view class="page-footer-space"></view>
        </scroll-view>

        <!-- 筛选底部弹窗（选中态由页面持有：重开抽屉保持上次选择；组件不持表单态，避免跨层双向绑定，见 ADR-0007） -->
        <view v-if="showFilter" class="filter-mask" @click="showFilter = false">
            <view class="filter-drawer" @click.stop>
                <!-- 标题栏 -->
                <view class="filter-header">
                    <text class="filter-title">筛选</text>
                    <app-icon-button @click="showFilter = false">
                        <text class="filter-close-icon">✕</text>
                    </app-icon-button>
                </view>

                <!-- 口径（#1608 §8⑤ 裁定：双轴改单轴，值域映射后端既有 filter；直播/录播、免费/付费两轴删除）
                     #2535：胶囊改等宽网格（设计稿 956_2984 三个胶囊平分一行） -->
                <view class="filter-section">
                    <text class="filter-label">口径</text>
                    <view class="filter-options">
                        <view v-for="(opt, idx) in filterOptions" :key="idx" class="filter-chip mb-20"
                            :class="{ 'filter-chip--active': selectedFilter === idx, 'filter-chip--last': idx === filterOptions.length - 1 }"
                            @click="selectedFilter = idx">
                            <text class="filter-chip-text"
                                :class="{ 'filter-chip-text--active': selectedFilter === idx }">{{ opt }}</text>
                        </view>
                    </view>
                </view>

                <!-- 底部按钮 -->
                <view class="filter-actions">
                    <view class="filter-btn-reset" @click="onFilterReset">
                        <text class="filter-btn-reset-text">重置</text>
                    </view>
                    <view class="filter-btn-confirm ml-24" @click="onFilterConfirm">
                        <text class="filter-btn-confirm-text">确定</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow, onHide } from '@dcloudio/uni-app'
    import type { FeaturedContentItem, CourseItem } from '../../types/index'
    import AppNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import CertSelector from '../../components/cert-selector/cert-selector.uvue'
    import DashboardMenuGrid from './components/dashboard-menu-grid.uvue'
    import DashboardContinueCard from './components/dashboard-continue-card.uvue'
    import DashboardNewsSection from './components/dashboard-news-section.uvue'
    import DashboardCourseSection from './components/dashboard-course-section.uvue'
    import { useDashboardCredential } from './composables/use-dashboard-credential.uts'
    import { useDashboardFeeds } from './composables/use-dashboard-feeds.uts'

    const windowHeight = uni.getSystemInfoSync().windowHeight
    const credentialPanelTop = computed((): number => {
        const system = uni.getSystemInfoSync()
        let statusHeight = system.statusBarHeight
        if (statusHeight == null || statusHeight <= 0) statusHeight = 44
        const navHeight = Math.round(88 * system.windowWidth / 750)
        const credentialHeight = Math.round(88 * system.windowWidth / 750)
        return statusHeight + navHeight + credentialHeight
    })

    // 首页证件栏保留证件切换、顶部搜索与商城入口；快捷宫格只保留原型四项。

    // ---- 证件切换流（composable 持有） ----
    const {
        currentCert, showCertDropdown, credentialGroups, currentCredentialId,
        pendingCredentialId, province,
        loadCredentials, onCertTap, onPickCredential, onConfirmCredential,
        onProvinceTap, onCloseCertDropdown,
    } = useDashboardCredential()

    // ---- 数据流：未读轮询 / 继续学习 / 新闻资讯 / 首页课程区（composable 持有） ----
    const {
        unreadCount, continueLearning, newsList, newsFailed, newsFilter, hotCourses,
        loadMyCourses, loadFeaturedContents, selectNewsFilter, loadHotCourses, startUnreadPolling, stopUnreadPolling,
    } = useDashboardFeeds()

    // ---- 筛选弹窗（页面持有选中态）----
    // #1608 §8⑤ 裁定：「价格（直播/录播）」「类型（免费/付费）」双轴后端无此维度，删；
    // 改单轴「口径」，值域直接映射 getCourseListApi 既有 filter: '' | 'hot' | 'featured'（api/course.uts）。
    // 初值=热门（idx 1）：保持 #1422 起课程区默认热门口径的既有行为；「重置」=清空为全部。
    const showFilter = ref(false)
    const filterOptions : string[] = ['全部', '热门', '精品']
    const filterValues : string[] = ['', 'hot', 'featured']
    const selectedFilter = ref(1)

    function onFilterBtnClick() : void {
        showFilter.value = true
    }

    function onFilterReset() : void {
        selectedFilter.value = 0
    }

    function onFilterConfirm() : void {
        showFilter.value = false
        // #1608 §8⑤：确认即按所选口径重拉课程区（此前只 console.log 空转不落数据）
        loadHotCourses(currentCredentialId.value, filterValues[selectedFilter.value])
    }

    // #1846：onSearchClick 随页头 🔍 一并退役——搜索跳转归宫格条目（path 常量 + push 语义，
    // dashboard-menu-grid 内自导航），页面不再持入口函数。

    // 页面显示时刷新数据
    onShow(() => {
        // #1422：课程区热门口径要按「当前证件」分区取（公开路由兜底永不生效），故证件解析完成后再拉。
        // `.then` 回调必须显式 `: void` 块体吞掉 Promise —— 箭头直返 loadHotCourses(...) 会被 Kotlin
        // 判成「return type mismatch: expected Unit, actual UTSPromise<Unit>」（同 mall onLoad 先例）。
        loadCredentials().then(() : void => {
            loadHotCourses(currentCredentialId.value, filterValues[selectedFilter.value])
        })
        loadMyCourses()
        loadFeaturedContents()
        startUnreadPolling()
    })

    onHide(() => {
        stopUnreadPolling()
    })

    function onContinueLearning() : void {
        const cl = continueLearning.value
        if (cl != null) {
            uni.navigateTo({ url: '/pages/courses/course-detail?id=' + cl.course_id.toString() })
        }
    }

    // #1422：首页课程区点击落点即该课真详情（修 mock id 直跳真实详情页的错位 bug）
    // 跳转归页面而非组件：字面量留在组件会让 dashboardPage 的跳转契约扫不到注册页
    function onCourseOpen(course : CourseItem) : void {
        uni.navigateTo({ url: '/pages/courses/course-detail?id=' + course.course_id.toString() })
    }

    // ---- Banner 点击 ----
    function onBannerClick() : void {
        uni.showToast({ title: '报名功能开发中', icon: 'none' })
    }

    function onHeaderSearch() : void {
        uni.navigateTo({ url: '/pages/search/search' })
    }

    function onHeaderMall() : void {
        uni.reLaunch({ url: '/pages/mall/mall' })
    }

    // ---- 新闻点击 ----
    function onNewsClick(news : FeaturedContentItem) : void {
        uni.navigateTo({
            url: '/pages/featured/featured-detail?id=' + news.content_id.toString()
        })
    }

    function onMoreNews() : void {
        uni.navigateTo({ url: '/pages/featured/featured-list' })
    }

    // ---- 公告栏点击 ----
    function onNoticeClick() : void {
        uni.navigateTo({ url: '/pages/featured/featured-list' })
    }
</script>

<style lang="scss">
    .container {
        flex: 1;
        /* 批5 N05（票1608）：tabBar 渐变页模板（ui-spec §6.1），色值走 token（§1.2，禁 deg 与裸 hex） */
        background: linear-gradient(to bottom, $gradient-start, $gradient-end);
        background-color: $gradient-end;
        flex-direction: column;
    }

    .content-scroll {
        flex: 1;
    }

    /* #1602 迁移：状态栏占位与页头骨架（旧页头那组样式）已整体收口进 app-nav-bar，
       页内不再自持页头形态与角标样式。 */

    /* Figma 页头下方证件/搜索/商城栏：整行88rpx；证件胶囊72rpx（约36px）。 */
    .credential-bar {
        height: 88rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 0 40rpx;
    }

    .credential-picker {
        height: 72rpx;
        max-width: 520rpx;
        flex-direction: row;
        align-items: center;
        background-color: $primary-tint;
        border-radius: $radius-pill;
        padding: 0 24rpx;
    }

    .credential-name {
        font-size: 32rpx;
        font-weight: 500;
        color: #333333;
        max-width: 420rpx;
        lines: 1;
        text-overflow: ellipsis;
    }

    .credential-arrow {
        font-size: 32rpx;
        color: #666666;
        margin-left: 12rpx;
        margin-bottom: 4rpx;
    }

    .header-actions {
        flex-direction: row;
        align-items: center;
    }

    .header-action {
        width: 88rpx;
        height: 88rpx;
        align-items: center;
        justify-content: center;
    }

    .header-action-icon {
        width: 32rpx;
        height: 32rpx;
    }

    .header-mall-icon {
        width: 44rpx;
        height: 44rpx;
    }

    /* 公告栏 */
    .notice-bar {
        flex-direction: row;
        align-items: center;
        margin: 8rpx 40rpx 0;
        padding: 10rpx 20rpx;
    }

    .notice-icon {
        font-size: 30rpx;
        margin-right: 12rpx;
    }

    .notice-text {
        flex: 1;
        font-size: 24rpx;
        color: #333333;
        lines: 1;
        text-overflow: ellipsis;
    }

    .notice-arrow {
        font-size: 30rpx;
        color: #333333;
        margin-left: 12rpx;
    }

    /* Banner 海报 */
    .banner {
        margin: 24rpx 37rpx;
        border-radius: 16rpx;
        overflow: hidden;
    }

    .banner-img {
        width: 100%;
    }

    /* ---- 页面底部留白 ---- */
    .page-footer-space {
        height: 120rpx;
    }

    /* ---- 筛选底部弹窗 ---- */
    .filter-mask {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 200;
        background-color: rgba(0, 0, 0, 0.4);
        justify-content: flex-end;
    }

    .filter-drawer {
        background-color: #FFFFFF;
        border-top-left-radius: 28rpx;
        border-top-right-radius: 28rpx;
        padding-bottom: 32rpx;
    }

    .filter-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 40rpx 32rpx 24rpx;
    }

    .filter-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    /* 票 2730 第 1 项：88rpx 命中盒 / 64rpx 承载面由 components/app-icon-button 承担；✕ 字形 32rpx 不变。 */
    .filter-close-icon {
        font-size: 32rpx;
        color: #999999;
    }

    .filter-section {
        padding: 28rpx 32rpx 0;
    }

    .filter-label {
        font-size: 28rpx;
        font-weight: 600;
        color: #333333;
        margin-bottom: 20rpx;
    }

    .filter-options {
        flex-direction: row;
        flex-wrap: wrap;
    }

    /* #2535：胶囊等宽网格（设计稿 956_2984 三个胶囊平分一行），选中态浅蓝底 + 主色字、无描边 */
    .filter-chip {
        flex: 1;
        height: 88rpx;
        margin-right: 42rpx;
        background-color: $bg-color;
        border-radius: 40rpx;
        align-items: center;
        justify-content: center;
    }

    .filter-chip--last {
        margin-right: 0;
    }

    .filter-chip--active {
        background-color: $primary-tint;
    }

    .filter-chip-text {
        font-size: 28rpx;
        color: #555555;
    }

    .filter-chip-text--active {
        color: $primary-color;
        font-weight: 500;
    }

    .filter-actions {
        flex-direction: row;
        padding: 36rpx 32rpx 0;
    }

    .filter-btn-reset {
        flex: 1;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: $bg-color;
        align-items: center;
        justify-content: center;
    }

    .filter-btn-reset-text {
        font-size: 30rpx;
        color: $text-color-secondary;
    }

    .filter-btn-confirm {
        flex: 1;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: $primary-color;
        align-items: center;
        justify-content: center;
    }

    .filter-btn-confirm-text {
        font-size: 30rpx;
        font-weight: 600;
        color: #FFFFFF;
    }

    /* ---- 间距工具类（替代 gap） ---- */
    .ml-24 { margin-left: 24rpx; }
    .mb-20 { margin-bottom: 20rpx; }
</style>
