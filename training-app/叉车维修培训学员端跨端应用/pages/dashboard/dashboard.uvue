        font-size: 26rpx;
        color: rgba(255, 255, 255, 0.8);
    }

    .avatar {
        width: 88rpx;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: #4a9aff;
        align-items: center;
        justify-content: center;
    }

