<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-left" @click="onCertTap">
                <text class="nav-title">{{ currentCert }}</text>
                <text class="nav-arrow">▾</text>
            </view>
            <view class="nav-right">
                <view class="nav-icon-btn" @click="onNotificationClick">
                    <text class="nav-icon-text">🔔</text>
                    <view v-if="unreadCount > 0" class="unread-badge">
                        <text class="unread-badge-text">{{ unreadCount > 99 ? '99+' : unreadCount.toString() }}</text>
                    </view>
                </view>
                <view class="nav-icon-btn" @click="onCartClick">
                    <text class="nav-icon-text">🛒</text>
                </view>
            </view>
        </view>

        <!-- 公告栏 -->
        <view class="notice-bar" @click="onNoticeClick">
            <text class="notice-icon">📢</text>
            <text class="notice-text">叉车维修培训开课通知，欢迎报名学习</text>
            <text class="notice-arrow">›</text>
        </view>

        <!-- 证件下拉选择器（选择学习阶段风格） -->
        <DashboardCertDropdown v-if="showCertDropdown" :groups="credentialGroups"
            :current-id="currentCredentialId" @close="onCloseCertDropdown" @select="onSelectCredential" />

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- Banner 海报（图内含标题与"实际教学·案例分析·考核发证"文案） -->
            <view class="banner" @click="onBannerClick">
                <image class="banner-img" src="/static/Rectangle_39.png" mode="widthFix"></image>
            </view>

            <!-- 功能入口网格 -->
            <DashboardMenuGrid />

            <!-- 继续学习 -->
            <DashboardContinueCard v-if="continueLearning != null" :course-name="continueLearning!.course_name"
                :chapter-title="continueLearning!.last_chapter_title" :progress="continueLearning!.progress"
                @click="onContinueLearning" />

            <!-- 新闻资讯板块 -->
            <DashboardNewsSection :news-list="newsList" @click="onNewsClick" @more="onMoreNews" />

            <!-- 内容 Tab + 筛选标签 + 课程卡片列表 -->
            <DashboardCourseSection @open-filter="onFilterBtnClick" />

            <!-- 底部留白（tabBar 悬浮遮挡） -->
            <view class="page-footer-space"></view>
        </scroll-view>

        <!-- 筛选底部弹窗（选中态由页面持有：重开抽屉保持上次选择；组件不持表单态，避免跨层双向绑定，见 ADR-0007） -->
        <view v-if="showFilter" class="filter-mask" @click="showFilter = false">
            <view class="filter-drawer" @click.stop>
                <!-- 标题栏 -->
                <view class="filter-header">
                    <text class="filter-title">筛选</text>
                    <view class="filter-close" @click="showFilter = false">
                        <text class="filter-close-icon">✕</text>
                    </view>
                </view>

                <!-- 价格 -->
                <view class="filter-section">
                    <text class="filter-label">价格</text>
                    <view class="filter-options">
                        <view v-for="(opt, idx) in priceOptions" :key="idx" class="filter-chip mr-20 mb-20"
                            :class="{ 'filter-chip--active': selectedPrice === idx }" @click="selectedPrice = idx">
                            <text class="filter-chip-text"
                                :class="{ 'filter-chip-text--active': selectedPrice === idx }">{{ opt }}</text>
                        </view>
                    </view>
                </view>

                <!-- 类型 -->
                <view class="filter-section">
                    <text class="filter-label">类型</text>
                    <view class="filter-options">
                        <view v-for="(opt, idx) in typeOptions" :key="idx" class="filter-chip mr-20 mb-20"
                            :class="{ 'filter-chip--active': selectedType === idx }" @click="selectedType = idx">
                            <text class="filter-chip-text"
                                :class="{ 'filter-chip-text--active': selectedType === idx }">{{ opt }}</text>
                        </view>
                    </view>
                </view>

                <!-- 底部按钮 -->
                <view class="filter-actions">
                    <view class="filter-btn-reset" @click="onFilterReset">
                        <text class="filter-btn-reset-text">重置</text>
                    </view>
                    <view class="filter-btn-confirm ml-24" @click="onFilterConfirm">
                        <text class="filter-btn-confirm-text">确定</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow, onHide } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import type { FeaturedContentItem } from '../../types/index'
    import DashboardCertDropdown from './components/dashboard-cert-dropdown.uvue'
    import DashboardMenuGrid from './components/dashboard-menu-grid.uvue'
    import DashboardContinueCard from './components/dashboard-continue-card.uvue'
    import DashboardNewsSection from './components/dashboard-news-section.uvue'
    import DashboardCourseSection from './components/dashboard-course-section.uvue'
    import { useDashboardCredential } from './composables/use-dashboard-credential.uts'
    import { useDashboardFeeds } from './composables/use-dashboard-feeds.uts'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 证件切换流（composable 持有） ----
    const {
        currentCert, showCertDropdown, credentialGroups, currentCredentialId,
        loadCredentials, onCertTap, onSelectCredential, onCloseCertDropdown,
    } = useDashboardCredential()

    // ---- 数据流：未读轮询 / 继续学习 / 新闻资讯（composable 持有） ----
    const {
        unreadCount, continueLearning, newsList,
        loadMyCourses, loadFeaturedContents, startUnreadPolling, stopUnreadPolling,
    } = useDashboardFeeds()

    // ---- 筛选弹窗（页面持有选中态） ----
    const showFilter = ref(false)
    const priceOptions : string[] = ['全部', '直播', '录播']
    const typeOptions : string[] = ['全部', '免费', '付费']
    const selectedPrice = ref(0)
    const selectedType = ref(0)

    function onFilterBtnClick() : void {
        showFilter.value = true
    }

    function onFilterReset() : void {
        selectedPrice.value = 0
        selectedType.value = 0
    }

    function onFilterConfirm() : void {
        showFilter.value = false
        // TODO: 根据筛选条件刷新课程列表
        const price = priceOptions[selectedPrice.value]
        const type = typeOptions[selectedType.value]
        console.log('[dashboard] filter applied:', price, type)
    }

    function onNotificationClick() : void {
        uni.navigateTo({ url: '/pages/notifications/notifications' })
    }

    // 页面显示时刷新数据
    onShow(() => {
        loadCredentials()
        loadMyCourses()
        loadFeaturedContents()
        startUnreadPolling()
    })

    onHide(() => {
        stopUnreadPolling()
    })

    function onContinueLearning() : void {
        const cl = continueLearning.value
        if (cl != null) {
            uni.navigateTo({ url: '/pages/courses/course-detail?id=' + cl.course_id.toString() })
        }
    }

    function onCartClick() : void {
        uni.showToast({ title: '购物车功能开发中', icon: 'none' })
    }

    // ---- Banner 点击 ----
    function onBannerClick() : void {
        uni.showToast({ title: '报名功能开发中', icon: 'none' })
    }

    // ---- 新闻点击 ----
    function onNewsClick(news : FeaturedContentItem) : void {
        uni.navigateTo({
            url: '/pages/featured/featured-detail?id=' + news.content_id.toString()
        })
    }

    function onMoreNews() : void {
        uni.navigateTo({ url: '/pages/featured/featured-list' })
    }

    // ---- 公告栏点击 ----
    function onNoticeClick() : void {
        uni.navigateTo({ url: '/pages/featured/featured-list' })
    }
</script>

<style>
    .container {
        flex: 1;
        background: linear-gradient(180deg, #CFE9FB 1%, #D0EBFD 16%, #F5F5F5 100%);
        flex-direction: column;
    }

    .status-bar {
        background-color: transparent;
    }

    .content-scroll {
        flex: 1;
    }

    /* 顶部导航栏 */
    .nav-bar {
        background-color: transparent;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 20rpx 32rpx;
    }

    .nav-left {
        flex-direction: row;
        align-items: center;
    }

    .nav-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .nav-arrow {
        font-size: 24rpx;
        color: #999999;
        margin-left: 8rpx;
    }

    .nav-right {
        flex-direction: row;
        align-items: center;
    }

    .nav-icon-btn {
        position: relative;
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
        margin-left: 48rpx;
    }

    .nav-icon-text {
        font-size: 40rpx;
    }

    /* 公告栏 */
    .notice-bar {
        flex-direction: row;
        align-items: center;
        margin: 8rpx 40rpx 0;
        padding: 10rpx 20rpx;
    }

    .notice-icon {
        font-size: 30rpx;
        margin-right: 12rpx;
    }

    .notice-text {
        flex: 1;
        font-size: 24rpx;
        color: #333333;
        lines: 1;
        text-overflow: ellipsis;
    }

    .notice-arrow {
        font-size: 30rpx;
        color: #333333;
        margin-left: 12rpx;
    }

    .unread-badge {
        position: absolute;
        top: -4rpx;
        right: -4rpx;
        background-color: #ff3b30;
        border-radius: 20rpx;
        min-width: 32rpx;
        height: 32rpx;
        padding: 0 8rpx;
        align-items: center;
        justify-content: center;
    }

    .unread-badge-text {
        font-size: 20rpx;
        color: #ffffff;
        font-weight: 600;
    }

    /* Banner 海报 */
    .banner {
        margin: 24rpx 40rpx;
        border-radius: 16rpx;
        overflow: hidden;
    }

    .banner-img {
        width: 100%;
    }

    /* ---- 页面底部留白 ---- */
    .page-footer-space {
        height: 120rpx;
    }

    /* ---- 筛选底部弹窗 ---- */
    .filter-mask {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 200;
        background-color: rgba(0, 0, 0, 0.4);
        justify-content: flex-end;
    }

    .filter-drawer {
        background-color: #FFFFFF;
        border-top-left-radius: 28rpx;
        border-top-right-radius: 28rpx;
        padding-bottom: 32rpx;
    }

    .filter-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 32rpx;
        border-bottom-width: 1rpx;
        border-bottom-color: #F0F0F0;
    }

    .filter-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    .filter-close {
        width: 48rpx;
        height: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .filter-close-icon {
        font-size: 32rpx;
        color: #999999;
    }

    .filter-section {
        padding: 28rpx 32rpx 0;
    }

    .filter-label {
        font-size: 28rpx;
        font-weight: 600;
        color: #333333;
        margin-bottom: 20rpx;
    }

    .filter-options {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .filter-chip {
        padding: 18rpx 40rpx;
        background-color: #F5F7FA;
        border-radius: 40rpx;
        border-width: 2rpx;
        border-color: transparent;
    }

    .filter-chip--active {
        background-color: #EBF5FF;
        border-color: #2979FF;
    }

    .filter-chip-text {
        font-size: 28rpx;
        color: #555555;
    }

    .filter-chip-text--active {
        color: #2979FF;
        font-weight: 500;
    }

    .filter-actions {
        flex-direction: row;
        padding: 36rpx 32rpx 0;
    }

    .filter-btn-reset {
        flex: 1;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: #F5F7FA;
        align-items: center;
        justify-content: center;
    }

    .filter-btn-reset-text {
        font-size: 30rpx;
        color: #666666;
    }

    .filter-btn-confirm {
        flex: 2;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: #2979FF;
        align-items: center;
        justify-content: center;
    }

    .filter-btn-confirm-text {
        font-size: 30rpx;
        font-weight: 600;
        color: #FFFFFF;
    }

    /* ---- 间距工具类（替代 gap） ---- */
    .ml-24 { margin-left: 24rpx; }
    .mr-20 { margin-right: 20rpx; }
    .mb-20 { margin-bottom: 20rpx; }
</style>
