<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-left" @click="onCertTap">
                <text class="nav-title">{{ currentCert }}</text>
                <text class="nav-arrow">▾</text>
            </view>
            <view class="nav-right">
                <view class="nav-icon-btn" @click="onNotificationClick">
                    <text class="nav-icon-text"></text>
                    <view v-if="unreadCount > 0" class="unread-badge">
                        <text class="unread-badge-text">{{ unreadCount > 99 ? '99+' : unreadCount.toString() }}</text>
                    </view>
                </view>
                <view class="nav-icon-btn ml-16" @click="onCartClick">
                    <text class="nav-icon-text"></text>
                </view>
            </view>
        </view>

        <!-- 证件下拉选择器（选择学习阶段风格） -->
        <view v-if="showCertDropdown" class="cert-dropdown-mask" @click="onCloseCertDropdown">
            <view class="cert-dropdown" @click.stop>
                <!-- 标题栏 -->
                <view class="cert-dropdown-header">
                    <text class="cert-dropdown-title">选择学习阶段</text>
                    <view class="cert-dropdown-close" @click="onCloseCertDropdown">
                        <text class="cert-dropdown-close-icon">✕</text>
                    </view>
                </view>
                <scroll-view scroll-y class="cert-dropdown-scroll">
                    <view v-for="(group, gIdx) in credentialGroups" :key="gIdx" class="cert-dropdown-section">
                        <!-- 分组标题 -->
                        <view class="cert-dropdown-section-header">
                            <view class="cert-dropdown-section-icon-wrap"
                                :style="{ backgroundColor: group.category === 'skill_level' ? '#E8F5E9' : '#FFF3E0' }">
                                <text class="cert-dropdown-section-icon">{{ group.icon }}</text>
                            </view>
                            <text class="cert-dropdown-section-title">{{ group.group_name }}</text>
                        </view>
                        <!-- 胶囊标签 -->
                        <view class="cert-dropdown-chips">
                            <view v-for="(item, idx) in group.items" :key="idx" class="cert-dropdown-chip mr-16 mb-16"
                                :class="{ 'cert-dropdown-chip--active': currentCredentialId === item.id }"
                                @click="onSelectCredential(item)">
                                <!-- 单行（特种作业证） -->
                                <view v-if="item.level == null" class="cert-dropdown-chip-single">
                                    <text class="cert-dropdown-chip-text"
                                        :class="{ 'cert-dropdown-chip-text--active': currentCredentialId === item.id }">{{ item.name }}</text>
                                </view>
                                <!-- 双行（技能等级证） -->
                                <view v-else class="cert-dropdown-chip-double">
                                    <text class="cert-dropdown-chip-level"
                                        :class="{ 'cert-dropdown-chip-text--active': currentCredentialId === item.id }">{{ levelNames[item.level!.toString()] }}</text>
                                    <!-- <text class="cert-dropdown-chip-desc"
                                        :class="{ 'cert-dropdown-chip-desc--active': currentCredentialId === item.id }">{{ item.name }}</text> -->
                                </view>
                            </view>
                        </view>
                    </view>

                    <!-- 热门考证 -->
                    <view class="cert-dropdown-section">
                        <view class="cert-dropdown-hot-header">
                            <text class="cert-dropdown-hot-title">热门考证</text>
                            <view class="cert-dropdown-hot-line"></view>
                        </view>
                        <view class="cert-dropdown-hot-grid">
                            <view v-for="(item, idx) in hotCertList" :key="idx" class="cert-dropdown-hot-card"
                                :class="idx > 0 ? 'ml-16' : ''">
                                <view class="cert-dropdown-hot-card-header">
                                    <text class="cert-dropdown-hot-card-star">⭐</text>
                                    <text class="cert-dropdown-hot-card-title">{{ item.title }}</text>
                                </view>
                                <text class="cert-dropdown-hot-card-desc">{{ item.desc }}</text>
                            </view>
                        </view>
                    </view>

                    <!-- 热门考证详情说明 -->
                    <view class="cert-dropdown-section">
                        <view v-for="(item, idx) in hotCertDetails" :key="idx" class="cert-dropdown-detail-item">
                            <view class="cert-dropdown-detail-title-row">
                                <text class="cert-dropdown-detail-bullet">✦</text>
                                <text class="cert-dropdown-detail-title">{{ item.title }}</text>
                            </view>
                            <text class="cert-dropdown-detail-content">{{ item.content }}</text>
                        </view>
                    </view>

                    <!-- 底部留白 -->
                    <view style="height: 48rpx;"></view>
                </scroll-view>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- Banner 海报（图内含标题与"实际教学·案例分析·考核发证"文案） -->
            <view class="banner" @click="onBannerClick">
                <image class="banner-img" src="/static/Rectangle_39.png" mode="widthFix"></image>
            </view>

            <!-- 功能入口网格 -->
            <view class="menu-grid">
                <view v-for="(item, idx) in menuItems" :key="idx" class="menu-item" @click="onMenuClick(item)">
                    <view class="menu-icon-box" :style="{ backgroundColor: item.color }">
                        <text class="menu-icon-text">{{ item.icon }}</text>
                    </view>
                    <text class="menu-label">{{ item.title }}</text>
                </view>
            </view>

            <!-- 继续学习 -->
            <view v-if="continueLearning != null" class="continue-section">
                <view class="section-header">
                    <text class="section-title">继续学习</text>
                    <text class="section-more" @click="onContinueLearning">查看全部</text>
                </view>
                <view class="continue-card" @click="onContinueLearning">
                    <view class="continue-info">
                        <text class="continue-course-name">{{ continueLearning!.course_name }}</text>
                        <text class="continue-chapter">上次学到：{{ continueLearning!.last_chapter_title }}</text>
                        <view class="continue-progress-bar">
                            <view class="continue-progress-fill" :style="{ width: continueLearning!.progress + '%' }">
                            </view>
                        </view>
                        <text class="continue-progress-text">已完成 {{ continueLearning!.progress }}%</text>
                    </view>
                    <text class="continue-arrow">›</text>
                </view>
            </view>

            <!-- 新闻资讯板块 -->
            <view class="news-section">
                <view class="section-header">
                    <text class="section-title">新闻资讯</text>
                    <text class="section-more" @click="onMoreNews">更多</text>
                </view>
                <view class="news-list">
                    <view v-for="(news, idx) in newsList" :key="idx" class="news-item" @click="onNewsClick(news)">
                        <text class="news-icon">+</text>
                        <text class="news-title" :style="{ flex: 1 }">{{ news.title }}</text>
                        <text class="news-date" v-if="news.published_at">{{ news.published_at }}</text>
                    </view>
                </view>
            </view>

            <!-- Tab 切换 -->
            <view class="tab-row">
                <view v-for="(tab, idx) in contentTabs" :key="idx" class="tab-item"
                    :class="{ 'tab-active': activeTab == idx }" @click="onTabChange(idx)">
                    <text class="tab-text" :class="{ 'tab-text-active': activeTab == idx }">{{ tab }}</text>
                    <view v-if="activeTab == idx" class="tab-underline"></view>
                </view>
            </view>

            <!-- 筛选标签 -->
            <view class="filter-row">
                <view class="filter-tags">
                    <view v-for="(tag, idx) in filterTags" :key="idx" class="filter-tag"
                        :class="{ 'filter-tag-active': activeFilter == idx }" @click="onFilterChange(idx)">
                        <text class="filter-tag-text"
                            :class="{ 'filter-tag-text-active': activeFilter == idx }">{{ tag }}</text>
                    </view>
                </view>
                <view class="filter-btn" @click="onFilterBtnClick">
                    <text class="filter-btn-text">筛选</text>
                </view>
            </view>

            <!-- 课程卡片列表 -->
            <view class="course-list">
                <view v-for="(course, idx) in courseList" :key="idx" class="course-card" @click="onCourseClick(course)">
                    <view class="course-header">
                        <view v-if="course.isHot" class="course-tag-hot">
                            <text class="course-tag-hot-text">热销</text>
                        </view>
                        <text class="course-title">{{ course.title }}</text>
                    </view>
                    <view class="course-tags">
                        <view v-for="(tag, tagIdx) in course.tags" :key="tagIdx" class="course-tag-sm">
                            <text class="course-tag-sm-text">{{ tag }}</text>
                        </view>
                    </view>
                    <view class="course-footer">
                        <text class="course-price">¥ {{ course.price }}</text>
                        <text class="course-sales">{{ course.sales }}+人购买</text>
                    </view>
                </view>
            </view>
        </scroll-view>

        <!-- 筛选底部弹窗 -->
        <view v-if="showFilter" class="filter-mask" @click="showFilter = false">
            <view class="filter-drawer" @click.stop>
                <!-- 标题栏 -->
                <view class="filter-header">
                    <text class="filter-title">筛选</text>
                    <view class="filter-close" @click="showFilter = false">
                        <text class="filter-close-icon">✕</text>
                    </view>
                </view>

                <!-- 价格 -->
                <view class="filter-section">
                    <text class="filter-label">价格</text>
                    <view class="filter-options">
                        <view v-for="(opt, idx) in priceOptions" :key="idx" class="filter-chip mr-20 mb-20"
                            :class="{ 'filter-chip--active': selectedPrice === idx }" @click="selectedPrice = idx">
                            <text class="filter-chip-text"
                                :class="{ 'filter-chip-text--active': selectedPrice === idx }">{{ opt }}</text>
                        </view>
                    </view>
                </view>

                <!-- 类型 -->
                <view class="filter-section">
                    <text class="filter-label">类型</text>
                    <view class="filter-options">
                        <view v-for="(opt, idx) in typeOptions" :key="idx" class="filter-chip mr-20 mb-20"
                            :class="{ 'filter-chip--active': selectedType === idx }" @click="selectedType = idx">
                            <text class="filter-chip-text"
                                :class="{ 'filter-chip-text--active': selectedType === idx }">{{ opt }}</text>
                        </view>
                    </view>
                </view>

                <!-- 底部按钮 -->
                <view class="filter-actions">
                    <view class="filter-btn-reset" @click="onFilterReset">
                        <text class="filter-btn-reset-text">重置</text>
                    </view>
                    <view class="filter-btn-confirm ml-24" @click="onFilterConfirm">
                        <text class="filter-btn-confirm-text">确定</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow, onHide } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { UNAVAILABLE_TOAST } from '../../constants/app'
    import { getStudentCoursesApi } from '../../api/student'
    import { getFeaturedContentsApi } from '../../api/featured'
    import { getUnreadCountApi } from '../../api/notification'
    import { getCurrentCredentialApi, getAllCredentialsApi, switchCredentialApi } from '../../api/credential'
    import type { StudentCourse, FeaturedContentItem, CredentialItem, CredentialGroup } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 通知未读数 ----
    const unreadCount = ref<number>(0)
    let unreadTimer : number | null = null

    async function loadUnreadCount() : Promise<void> {
        try {
            const count = await getUnreadCountApi()
            unreadCount.value = count
        } catch (e) {
            // 静默失败
        }
    }

    function stopUnreadPolling() : void {
        const t = unreadTimer
        if (t != null) {
            clearInterval(t)
            unreadTimer = null
        }
    }

    function startUnreadPolling() : void {
        stopUnreadPolling()
        loadUnreadCount()
        unreadTimer = setInterval(() => {
            loadUnreadCount()
        }, 30000)
    }

    function onNotificationClick() : void {
        uni.navigateTo({ url: '/pages/notifications/notifications' })
    }

    // ---- 证件切换（下拉选择器） ----
    const currentCert = ref<string>('加载中...')
    const showCertDropdown = ref<boolean>(false)
    const credentialGroups = ref<CredentialGroup[]>([])
    const currentCredentialId = ref<number>(0)
    const isSwitching = ref<boolean>(false)

    // 等级数字转中文
    const levelNames : UTSJSONObject = {
        '5': '五级',
        '4': '四级',
        '3': '三级',
        '2': '二级',
        '1': '一级',
    }

    /** 加载证件数据 */
    async function loadCredentials() : Promise<void> {
        try {
            // 并发加载当前证件 + 全部证件列表
            const current = await getCurrentCredentialApi()
            const groups = await getAllCredentialsApi()
            credentialGroups.value = groups

            if (current != null) {
                // API 返回了当前证件
                currentCredentialId.value = current!.id
                currentCert.value = current!.name
                // 同步到本地存储
                uni.setStorageSync('selected_cert', current!.code)
            } else {
                // API 返回 null，尝试从本地存储恢复
                const savedCertCode = uni.getStorageSync('selected_cert') as string
                if (savedCertCode.length > 0) {
                    for (let g = 0; g < groups.length; g++) {
                        for (let i = 0; i < groups[g].items.length; i++) {
                            if (groups[g].items[i].code == savedCertCode) {
                                currentCredentialId.value = groups[g].items[i].id
                                currentCert.value = groups[g].items[i].name
                                return
                            }
                        }
                    }
                }
                currentCert.value = '选择证件'
            }
        } catch (e) {
            console.warn('[dashboard] loadCredentials failed:', e)
            // 回退到本地存储
            const savedCertCode = uni.getStorageSync('selected_cert') as string
            if (savedCertCode.length > 0) {
                // 从 mock 列表中按 code 查找
                const groups = await getAllCredentialsApi()
                credentialGroups.value = groups
                for (let g = 0; g < groups.length; g++) {
                    for (let i = 0; i < groups[g].items.length; i++) {
                        if (groups[g].items[i].code == savedCertCode) {
                            currentCredentialId.value = groups[g].items[i].id
                            currentCert.value = groups[g].items[i].name
                            return
                        }
                    }
                }
            }
            currentCert.value = '选择证件'
        }
    }

    /** 点击证件名称，展开下拉列表 */
    function onCertTap() : void {
        if (credentialGroups.value.length == 0) {
            uni.showToast({ title: '证件数据加载中', icon: 'none' })
            return
        }
        showCertDropdown.value = !showCertDropdown.value
    }

    /** 选择证件 */
    async function onSelectCredential(item : CredentialItem) : Promise<void> {
        if (isSwitching.value) return
        if (item.id === currentCredentialId.value) {
            showCertDropdown.value = false
            return
        }

        // 乐观更新：立即更新 UI，不等后端返回
        const prevId = currentCredentialId.value
        const prevName = currentCert.value
        currentCredentialId.value = item.id
        currentCert.value = item.name
        showCertDropdown.value = false

        isSwitching.value = true
        try {
            const result = await switchCredentialApi(item.id)
            if (result.success && result.credential != null) {
                // 后端返回了有效结果，用后端数据覆盖
                currentCredentialId.value = result.credential!.id
                currentCert.value = result.credential!.name
                // 同步本地存储（存 code，兼容 choose-cert 页面）
                uni.setStorageSync('selected_cert', result.credential!.code)
                uni.showToast({ title: '已切换至 ' + result.credential!.name, icon: 'none' })
            } else {
                // 后端没返回有效数据，但乐观更新已生效，仅同步本地存储
                uni.setStorageSync('selected_cert', item.code)
                uni.showToast({ title: '已切换至 ' + item.name, icon: 'none' })
            }
        } catch (e) {
            console.warn('[dashboard] switchCredential failed:', e)
            // 回滚到之前的证件
            currentCredentialId.value = prevId
            currentCert.value = prevName
            let msg = '切换失败，请重试'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            isSwitching.value = false
        }
    }

    /** 关闭下拉列表 */
    function onCloseCertDropdown() : void {
        showCertDropdown.value = false
    }

    // ---- 热门考证（静态数据） ----
    type HotCertItem = {
        title : string
        desc : string
    }

    const hotCertList : HotCertItem[] = [
        { title: '入门组合', desc: '工程机械维修工（初级）+ 叉车N1证' },
        { title: '电动叉车维修优选', desc: '工程机械维修工+N1司机证+低压电工证' },
    ]

    type HotCertDetail = {
        title : string
        content : string
    }

    const hotCertDetails : HotCertDetail[] = [
        {
            title: '1、工程机械机械维修工（初级）',
            content: '叉车证N1代表叉车车辆维修，N1是场内专用机动车辆作业叉车司机上岗证，N1是场内专用机动车辆叉车司机资格证，在早期，叉车证N1可以驾驶任何吨位的叉车。'
        },
        {
            title: '2、叉车N1证',
            content: '叉车证N1代表叉车车辆维修，N1是场内专用机动车辆作业叉车司机上岗证，N1是场内专用机动车辆叉车司机资格证，在早期，叉车证N1可以驾驶任何吨位的叉车。'
        }
    ]

    /** 本地证书名映射（回退用） */
    const certNameMap : Record<string, string> = {
        'low_voltage': '低压电工证',
        'welder': '焊工证',
        'forklift_n1': '叉车司机N1证',
        'level_5': '五级初级',
        'level_4': '四级中级',
        'level_3': '三级高级',
        'level_2': '二级技师',
        'level_1': '一级高级技师',
        'n2': 'N2维修证',
        'skill_cert': '技能等级证',
        'combo_cert': '配套取证'
    }

    // 页面显示时刷新数据
    onShow(() => {
        loadCredentials()
        loadMyCourses()
        loadFeaturedContents()
        startUnreadPolling()
    })

    onHide(() => {
        stopUnreadPolling()
    })

    // ---- 功能入口 ----
    type MenuItem = {
        key : string
        title : string
        icon : string
        color : string
        path : string
        available : boolean
    }

    const menuItems : MenuItem[] = [
        { key: 'course-mall', title: '课程商城', icon: '', color: '#FF6B35', path: '/pages/mall/mall', available: true },
        { key: 'question-bank', title: '题库练习', icon: '', color: '#4ECDC4', path: '/pages/practice/practice', available: true },
        { key: 'exam-center', title: '考试中心', icon: '', color: '#2979ff', path: '/pages/exam/exam', available: true },
        { key: 'material-course', title: '资料下载', icon: '', color: '#45B7D1', path: '', available: false },
        { key: 'exam-info', title: '考情资讯', icon: '', color: '#96CEB4', path: '/pages/exam-info/exam-info', available: true },
    ]

    // ---- 继续学习 ----
    const continueLearning = ref<StudentCourse | null>(null)
    const myCourses = ref<StudentCourse[]>([])

    async function loadMyCourses() : Promise<void> {
        try {
            const result = await getStudentCoursesApi()
            myCourses.value = result.courses
            continueLearning.value = result.continue_learning
        } catch (e) {
            console.warn('[dashboard] loadMyCourses failed:', e)
        }
    }

    // ---- 精选内容（从 API 加载） ----
    const newsList = ref<FeaturedContentItem[]>([])

    async function loadFeaturedContents() : Promise<void> {
        try {
            const result = await getFeaturedContentsApi(1, 5)
            newsList.value = result.items
        } catch (e) {
            console.warn('[dashboard] loadFeaturedContents failed:', e)
        }
    }

    // ---- 内容 Tab ----
    const contentTabs : string[] = ['热门课程', '精品课程']
    const activeTab = ref<number>(0)

    // ---- 筛选标签 ----
    const filterTags : string[] = ['全部', '实操技能', '综合评审']
    const activeFilter = ref<number>(0)

    // ---- 课程静态数据 ----
    type CourseItem = {
        id : number
        title : string
        tags : string[]
        price : number
        sales : number
        isHot : boolean
    }

    const courseList : CourseItem[] = [
        { id: 1, title: '2026年叉车基础理论课程', tags: ['直播报课', '电子资料'], price: 39, sales: 999, isHot: true },
        { id: 2, title: '叉车实操技能强化班', tags: ['实操教学', '在线答疑'], price: 128, sales: 567, isHot: true },
        { id: 3, title: '叉车安全规范专题课', tags: ['法规解读', '案例分析'], price: 0, sales: 1234, isHot: false },
        { id: 4, title: '叉车维修高级进阶课', tags: ['直播回放', '电子资料'], price: 199, sales: 234, isHot: false },
    ]

    function onContinueLearning() : void {
        const cl = continueLearning.value
        if (cl != null) {
            uni.navigateTo({ url: '/pages/courses/course-detail?id=' + cl.course_id.toString() })
        }
    }

    function onMenuClick(item : MenuItem) : void {
        if (!item.available || item.path.length == 0) {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
            return
        }
        uni.reLaunch({ url: item.path })
    }

    function onTabChange(idx : number) : void {
        activeTab.value = idx
    }

    function onFilterChange(idx : number) : void {
        activeFilter.value = idx
    }

    // ---- 筛选弹窗 ----
    const showFilter = ref(false)
    const priceOptions : string[] = ['全部', '直播', '录播']
    const typeOptions : string[] = ['全部', '免费', '付费']
    const selectedPrice = ref(0)
    const selectedType = ref(0)

    function onFilterBtnClick() : void {
        showFilter.value = true
    }

    function onFilterReset() : void {
        selectedPrice.value = 0
        selectedType.value = 0
    }

    function onFilterConfirm() : void {
        showFilter.value = false
        // TODO: 根据筛选条件刷新课程列表
        const price = priceOptions[selectedPrice.value]
        const type = typeOptions[selectedType.value]
        console.log('[dashboard] filter applied:', price, type)
    }

    function onCartClick() : void {
        uni.showToast({ title: '购物车功能开发中', icon: 'none' })
    }

    // ---- Banner 点击 ----
    function onBannerClick() : void {
        uni.showToast({ title: '报名功能开发中', icon: 'none' })
    }

    // ---- 新闻点击 ----
    function onNewsClick(news : FeaturedContentItem) : void {
        uni.navigateTo({
            url: '/pages/featured/featured-detail?id=' + news.content_id.toString()
        })
    }

    function onMoreNews() : void {
        uni.navigateTo({ url: '/pages/featured/featured-list' })
    }

    // ---- 课程点击 ----
    function onCourseClick(course : CourseItem) : void {
        uni.navigateTo({ url: `/pages/courses/course-detail?id=${course.id}` })
    }
</script>

<style>
