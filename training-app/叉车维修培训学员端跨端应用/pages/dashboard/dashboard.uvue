<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="nav-bar">
            <view class="nav-left" @click="goChooseCert">
                <text class="nav-title">{{ currentCert }}</text>
                <text class="nav-arrow">▾</text>
            </view>
            <view class="nav-right" @click="onCartClick">
                <text class="nav-cart-icon">🛒</text>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- Banner 占位 -->
            <view class="banner-placeholder"></view>

            <!-- 功能入口（4+2 布局） -->
            <view class="menu-grid">
                <view v-for="(item, idx) in menuItems" :key="idx" class="menu-item" @click="onMenuClick(item)">
                    <view class="menu-icon-box" :style="{ backgroundColor: item.color }"></view>
                    <text class="menu-label">{{ item.title }}</text>
                </view>
            </view>

            <!-- Tab 切换 -->
            <view class="tab-row">
                <view v-for="(tab, idx) in contentTabs" :key="idx" class="tab-item"
                    :class="{ 'tab-active': activeTab == idx }" @click="onTabChange(idx)">
                    <text class="tab-text" :class="{ 'tab-text-active': activeTab == idx }">{{ tab }}</text>
                    <view v-if="activeTab == idx" class="tab-underline"></view>
                </view>
            </view>

            <!-- 筛选标签 -->
            <view class="filter-row">
                <view class="filter-tags">
                    <view v-for="(tag, idx) in filterTags" :key="idx" class="filter-tag"
                        :class="{ 'filter-tag-active': activeFilter == idx }" @click="onFilterChange(idx)">
                        <text class="filter-tag-text"
                            :class="{ 'filter-tag-text-active': activeFilter == idx }">{{ tag }}</text>
                    </view>
                </view>
                <view class="filter-btn" @click="onFilterBtnClick">
                    <text class="filter-btn-text">筛选</text>
                </view>
            </view>

            <!-- 课程卡片列表 -->
            <!-- <view class="course-list">
                <view class="empty-tip">
                    <text class="empty-text">暂无推荐课程</text>
                </view>
            </view> -->
        </scroll-view>

        <!-- 筛选底部弹窗 -->
        <view v-if="showFilter" class="filter-mask" @click="showFilter = false">
            <view class="filter-drawer" @click.stop>
                <!-- 标题栏 -->
                <view class="filter-header">
                    <text class="filter-title">筛选</text>
                    <view class="filter-close" @click="showFilter = false">
                        <text class="filter-close-icon">✕</text>
                    </view>
                </view>

                <!-- 价格 -->
                <view class="filter-section">
                    <text class="filter-label">价格</text>
                    <view class="filter-options">
                        <view v-for="(opt, idx) in priceOptions" :key="idx" class="filter-chip"
                            :class="{ 'filter-chip--active': selectedPrice === idx }" @click="selectedPrice = idx">
                            <text class="filter-chip-text"
                                :class="{ 'filter-chip-text--active': selectedPrice === idx }">{{ opt }}</text>
                        </view>
                    </view>
                </view>

                <!-- 类型 -->
                <view class="filter-section">
                    <text class="filter-label">类型</text>
                    <view class="filter-options">
                        <view v-for="(opt, idx) in typeOptions" :key="idx" class="filter-chip"
                            :class="{ 'filter-chip--active': selectedType === idx }" @click="selectedType = idx">
                            <text class="filter-chip-text"
                                :class="{ 'filter-chip-text--active': selectedType === idx }">{{ opt }}</text>
                        </view>
                    </view>
                </view>

                <!-- 底部按钮 -->
                <view class="filter-actions">
                    <view class="filter-btn-reset" @click="onFilterReset">
                        <text class="filter-btn-reset-text">重置</text>
                    </view>
                    <view class="filter-btn-confirm" @click="onFilterConfirm">
                        <text class="filter-btn-confirm-text">确定</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { UNAVAILABLE_TOAST } from '../../constants/app'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 证书选择（跳转 choose-cert 页面复用同一格式） ----
    const certNameMap : Record<string, string> = {
        'low_voltage': '低压电工证',
        'welder': '焊工证',
        'forklift_n1': '叉车司机N1证',
        'level_5': '五级初级',
        'level_4': '四级中级',
        'level_3': '三级高级',
        'level_2': '二级技师',
        'level_1': '一级高级技师',
        'n2': 'N2维修证',
        'skill_cert': '技能等级证',
        'combo_cert': '配套取证'
    }

    const savedCertKey = uni.getStorageSync('selected_cert') as string
    const currentCert = ref(savedCertKey.length > 0 && certNameMap[savedCertKey] != null
        ? certNameMap[savedCertKey]!
        : '叉车司机N1证')


    function goChooseCert() : void {
        uni.navigateTo({ url: '/pages/guide/choose-cert' })
    }

    // 页面显示时刷新证书（从 choose-cert 返回后）
    const onShow = () : void => {
        const key = uni.getStorageSync('selected_cert') as string
        if (key.length > 0 && certNameMap[key] != null) {
            currentCert.value = certNameMap[key]!
        }
    }

    // ---- 功能入口 ----
    type MenuItem = {
        key : string
        title : string
        icon : string
        color : string
        path : string
        available : boolean
    }

    const menuItems : MenuItem[] = [
        { key: 'course-mall', title: '课程商城', icon: '', color: '#b0c4de', path: '/pages/courses/courses', available: true },
        { key: 'question-bank', title: '题库练习', icon: '✏️', color: '#ff9900', path: '/pages/practice/practice', available: true },
        { key: 'material-course', title: '资料课程', icon: '', color: '#b0c4de', path: '', available: false },
        { key: 'exam-info', title: '考情资讯', icon: '', color: '#b0c4de', path: '', available: false },

    ]

    // ---- 内容 Tab ----
    const contentTabs : string[] = ['精品活动', '精品课程']
    // const contentTabs : string[] = ['推荐课程', '精品活动', '精品课程']
    const activeTab = ref<number>(0)

    // ---- 筛选标签 ----
    const filterTags : string[] = ['笔试', '实操技能', '综合评审']
    const activeFilter = ref<number>(0)

    function onMenuClick(item : MenuItem) : void {
        if (!item.available || item.path.length == 0) {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
            return
        }
        uni.reLaunch({ url: item.path })
    }

    function onTabChange(idx : number) : void {
        activeTab.value = idx
    }

    function onFilterChange(idx : number) : void {
        activeFilter.value = idx
    }

    // ---- 筛选弹窗 ----
    const showFilter = ref(false)
    const priceOptions : string[] = ['全部', '直播', '录播']
    const typeOptions : string[] = ['全部', '免费', '付费']
    const selectedPrice = ref(0)
    const selectedType = ref(0)

    function onFilterBtnClick() : void {
        showFilter.value = true
    }

    function onFilterReset() : void {
        selectedPrice.value = 0
        selectedType.value = 0
    }

    function onFilterConfirm() : void {
        showFilter.value = false
        // TODO: 根据筛选条件刷新课程列表
        const price = priceOptions[selectedPrice.value]
        const type = typeOptions[selectedType.value]
        console.log('[dashboard] filter applied:', price, type)
    }

    function onCartClick() : void {
        uni.showToast({ title: '购物车功能开发中', icon: 'none' })
    }
</script>

<style>
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .content-scroll {
        flex: 1;
    }

    /* 顶部导航栏 */
    .nav-bar {
        background-color: #ffffff;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 20rpx 32rpx;
    }

    .nav-left {
        flex-direction: row;
        align-items: center;
    }

    .nav-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .nav-arrow {
        font-size: 24rpx;
        color: #999999;
        margin-left: 8rpx;
    }

    .nav-right {
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
    }

    .nav-cart-icon {
        font-size: 44rpx;
    }

    /* Banner 占位 */
    .banner-placeholder {
        height: 240rpx;
        margin: 24rpx;
        border-radius: 16rpx;
        background-color: #e8f4fd;
    }

    /* 功能入口网格 */
    .menu-grid {
        flex-direction: row;
        flex-wrap: wrap;
        padding: 0 24rpx;
    }

    .menu-item {
        width: 25%;
        padding: 20rpx 0;
        flex-direction: column;
        align-items: center;
    }

    .menu-icon-box {
        width: 80rpx;
        height: 80rpx;
        border-radius: 8rpx;
        margin-bottom: 12rpx;
    }

    .menu-label {
        font-size: 24rpx;
        color: #333333;
    }

    /* 内容 Tab */
    .tab-row {
        flex-direction: row;
        padding: 24rpx 32rpx 0;
    }

    .tab-item {
        margin-right: 40rpx;
        flex-direction: column;
        align-items: center;
    }

    .tab-text {
        font-size: 28rpx;
        color: #999999;
        padding-bottom: 12rpx;
    }

    .tab-text-active {
        color: #333333;
        font-weight: bold;
    }

    .tab-underline {
        width: 40rpx;
        height: 6rpx;
        border-radius: 3rpx;
        background-color: #2979ff;
    }

    /* 筛选标签 */
    .filter-row {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 20rpx 32rpx;
    }

    .filter-tags {
        flex: 1;
        flex-direction: row;
    }

    .filter-tag {
        padding: 8rpx 24rpx;
        border-radius: 24rpx;
        border: 1rpx solid #e0e0e0;
        margin-right: 16rpx;
        background-color: #ffffff;
    }

    .filter-tag-active {
        border-color: #2979ff;
        background-color: #e8f0fe;
    }

    .filter-tag-text {
        font-size: 24rpx;
        color: #666666;
    }

    .filter-tag-text-active {
        color: #2979ff;
    }

    .filter-btn {
        padding: 8rpx 24rpx;
        border-radius: 24rpx;
        border: 1rpx solid #e0e0e0;
        background-color: #ffffff;
    }

    .filter-btn-text {
        font-size: 24rpx;
        color: #666666;
    }

    /* 课程卡片 */
    .course-list {
        padding: 0 24rpx;
    }

    .empty-tip {
        align-items: center;
        padding: 60rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    /* ---- 筛选底部弹窗 ---- */
    .filter-mask {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 200;
        background-color: rgba(0, 0, 0, 0.4);
        justify-content: flex-end;
    }

    .filter-drawer {
        background-color: #FFFFFF;
        border-top-left-radius: 28rpx;
        border-top-right-radius: 28rpx;
        padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
    }

    .filter-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 32rpx;
        border-bottom-width: 1rpx;
        border-bottom-color: #F0F0F0;
    }

    .filter-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    .filter-close {
        width: 48rpx;
        height: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .filter-close-icon {
        font-size: 32rpx;
        color: #999999;
    }

    .filter-section {
        padding: 28rpx 32rpx 0;
    }

    .filter-label {
        font-size: 28rpx;
        font-weight: 600;
        color: #333333;
        margin-bottom: 20rpx;
    }

    .filter-options {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 20rpx;
    }

    .filter-chip {
        padding: 18rpx 40rpx;
        background-color: #F5F7FA;
        border-radius: 40rpx;
        border-width: 2rpx;
        border-color: transparent;
    }

    .filter-chip--active {
        background-color: #EBF5FF;
        border-color: #2979FF;
    }

    .filter-chip-text {
        font-size: 28rpx;
        color: #555555;
    }

    .filter-chip-text--active {
        color: #2979FF;
        font-weight: 500;
    }

    .filter-actions {
        flex-direction: row;
        gap: 24rpx;
        padding: 36rpx 32rpx 0;
    }

    .filter-btn-reset {
        flex: 1;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: #F5F7FA;
        align-items: center;
        justify-content: center;
    }

    .filter-btn-reset-text {
        font-size: 30rpx;
        color: #666666;
    }

    .filter-btn-confirm {
        flex: 2;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: #2979FF;
        align-items: center;
        justify-content: center;
    }

    .filter-btn-confirm-text {
        font-size: 30rpx;
        font-weight: 600;
        color: #FFFFFF;
    }
</style>