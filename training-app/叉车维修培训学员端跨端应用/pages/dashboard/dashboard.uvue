        flex-direction: row;
        justify-content: space-around;
        border: 1px solid #eeeeee;
    }

    .stat-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
    }

    .stats-label {
        font-size: 24rpx;
        color: #999999;
        margin-bottom: 12rpx;
    }

    .stats-value {
        font-size: 40rpx;
        font-weight: bold;
        color: #333333;
    }

    .stat-divider {
        width: 1rpx;
        background-color: #f0f0f0;
    }

    .section {
        background-color: #ffffff;
        margin-bottom: 16rpx;
        padding: 24rpx;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24rpx;
    }

    .section-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .section-more {
        font-size: 26rpx;
        color: #2979ff;
    }

    .grid {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    .grid-item {
        width: 340rpx;
        background-color: #f8f9fa;
        border-radius: 12rpx;
        padding: 32rpx 0;
        flex-direction: column;
