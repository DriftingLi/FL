<template>
    <!-- 内容 Tab + 筛选标签 + 课程卡片列表 ——T05 手术自 dashboard.uvue 逐段搬出（Tab/标签选中态纯视觉，归组件自持） -->
    <view>
        <view class="tab-row">
            <view v-for="(tab, idx) in contentTabs" :key="idx" class="tab-item" @click="onTabChange(idx)">
                <text class="tab-text" :class="{ 'tab-text-active': activeTab == idx }">{{ tab }}</text>
                <view v-if="activeTab == idx" class="tab-underline"></view>
            </view>
        </view>

        <view class="filter-row">
            <view class="filter-tags">
                <view v-for="(tag, idx) in filterTags" :key="idx" class="filter-tag"
                    :class="{ 'filter-tag-active': activeFilter == idx }" @click="onFilterChange(idx)">
                    <text class="filter-tag-text"
                        :class="{ 'filter-tag-text-active': activeFilter == idx }">{{ tag }}</text>
                </view>
            </view>
            <view class="filter-btn" @click="onFilterBtnClick">
                <text class="filter-btn-text">筛选</text>
            </view>
        </view>

        <view class="course-list">
            <view v-for="(course, idx) in courses" :key="idx" class="course-card" @click="onCourseClick(course)">
                <view class="course-header">
                    <view v-if="course.is_hot" class="course-tag-hot">
                        <text class="course-tag-hot-text">热销</text>
                    </view>
                    <text class="course-title">{{ course.title }}</text>
                </view>
                <view class="course-footer">
                    <text class="course-price">{{ renderCoursePriceText(course) }}</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { renderCoursePrice } from '../../../utils/coursePointsCta'
    import type { CourseItem } from '../../../types/index'

    // #1422：数据源改为页面流入的真实热门课程（不再自持写死的 mock 数组）；
    // 点击回抛真 course_id 交页面跳转（修「mock id 直跳真实详情页」的错位 bug）。
    defineProps<{ courses : CourseItem[] }>()
    const emit = defineEmits(['openFilter', 'courseOpen'])

    // ---- 内容 Tab ----
    const contentTabs : string[] = ['热门课程', '精品课程']
    const activeTab = ref<number>(0)

    // ---- 筛选标签 ----
    const filterTags : string[] = ['全部', '实操技能', '综合评审']
    const activeFilter = ref<number>(0)

    function onTabChange(idx : number) : void {
        activeTab.value = idx
    }

    function onFilterChange(idx : number) : void {
        activeFilter.value = idx
    }

    function onFilterBtnClick() : void {
        emit('openFilter')
    }

    // ---- 课程点击（回抛，跳转归页面） ----
    function onCourseClick(course : CourseItem) : void {
        emit('courseOpen', course)
    }

    /**
     * 价格行单点包装（同 mall 先例）：模板不能直调 import 函数（Kotlin 判炸，规则 S），
     * 这里只做转发 —— 价格语义仍单点在 utils/coursePointsCta.uts 的 renderCoursePrice。
     */
    function renderCoursePriceText(item : CourseItem) : string {
        return renderCoursePrice(item.points_price)
    }
</script>

<style>
    /* 内容 Tab */
    .tab-row {
        flex-direction: row;
        padding: 24rpx 32rpx 0;
    }

    .tab-item {
        margin-right: 40rpx;
        flex-direction: column;
        align-items: center;
    }

    .tab-text {
        font-size: 28rpx;
        color: #999999;
        padding-bottom: 12rpx;
    }

    .tab-text-active {
        color: #333333;
        font-weight: bold;
    }

    .tab-underline {
        width: 40rpx;
        height: 6rpx;
        border-radius: 3rpx;
        background-color: #2979ff;
    }

    /* 筛选标签 */
    .filter-row {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 20rpx 32rpx;
    }

    .filter-tags {
        flex: 1;
        flex-direction: row;
    }

    .filter-tag {
        padding: 14rpx 28rpx;
        border-radius: 999rpx;
        background-color: #ECECEC;
        margin-right: 24rpx;
    }

    .filter-tag-active {
        background-color: #EBF9FF;
    }

    .filter-tag-text {
        font-size: 24rpx;
        color: #666666;
    }

    .filter-tag-text-active {
        color: #239EDD;
    }

    .filter-btn {
        padding: 14rpx 28rpx;
        border-radius: 999rpx;
        background-color: #ECECEC;
    }

    .filter-btn-text {
        font-size: 24rpx;
        color: #666666;
    }

    /* 课程卡片 */
    .course-list {
        padding: 0 24rpx 24rpx;
    }

    .course-card {
        background-color: #FFFFFF;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 20rpx;
    }

    .course-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 16rpx;
    }

    .course-tag-hot {
        background-color: #00A443;
        padding: 8rpx 20rpx;
        border-radius: 999rpx;
        margin-right: 16rpx;
    }

    .course-tag-hot-text {
        font-size: 22rpx;
        color: #FFFFFF;
        font-weight: 600;
    }

    .course-title {
        font-size: 30rpx;
        font-weight: 600;
        color: #333333;
        flex: 1;
        lines: 1;
        text-overflow: ellipsis;
    }

    .course-footer {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .course-price {
        font-size: 36rpx;
        font-weight: bold;
        color: #FF2424;
    }
</style>
