    /* ---- 热门考证详情说明 ---- */
    .cert-dropdown-detail-item {
        margin-bottom: 20rpx;
    }

    /* uvue 原生端不支持 last-child 伪类；末项收尾由内容区底部留白承担 */

    .cert-dropdown-detail-title-row {
        flex-direction: row;
        align-items: center;
