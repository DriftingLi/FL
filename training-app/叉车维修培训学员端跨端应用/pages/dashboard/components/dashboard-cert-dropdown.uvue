        font-size: 28rpx;
        font-weight: 600;
        color: #222222;
        flex: 1;
    }

    /* ---- 胶囊标签 ---- */
    .cert-dropdown-chips {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .cert-dropdown-chip {
        padding: 18rpx 28rpx;
        background-color: #F5F7FA;
