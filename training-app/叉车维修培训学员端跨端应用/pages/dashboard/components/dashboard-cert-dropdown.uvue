        font-size: 34rpx;
        font-weight: 600;
        color: #222222;
    }

    .cert-dropdown-close {
        width: 48rpx;
        height: 48rpx;
        align-items: center;
        justify-content: center;
    }

    .cert-dropdown-close-icon {
        font-size: 32rpx;
        color: #999999;
    }

    .cert-dropdown-scroll {
        max-height: 700rpx;
    }

    /* ---- 分组区块 ---- */
    .cert-dropdown-section {
        margin: 16rpx 24rpx 0;
        padding: 24rpx;
        background-color: #FFFFFF;
        border-radius: 16rpx;
    }

    .cert-dropdown-section-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 20rpx;
    }

    .cert-dropdown-section-icon-wrap {
        width: 48rpx;
