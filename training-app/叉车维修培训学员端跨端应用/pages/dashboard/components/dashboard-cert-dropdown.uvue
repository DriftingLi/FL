    }

    .cert-dropdown-detail-content {
        font-size: 22rpx;
        color: #666666;
        line-height: 36rpx;
        padding-left: 32rpx;
    }

    /* ---- 间距工具类（替代 gap） ---- */
    .ml-16 { margin-left: 16rpx; }
    .mr-16 { margin-right: 16rpx; }
    .mb-16 { margin-bottom: 16rpx; }
