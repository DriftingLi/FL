<template>
    <!-- 继续学习 ——T05 手术自 dashboard.uvue 逐段搬出；数据扁平下发（ADR-0007 规则 N/P：禁对象 prop 成员直读），显隐由页面 v-if 控制 -->
    <view class="continue-section">
        <view class="section-header">
            <text class="section-title">继续学习</text>
            <text class="section-more" @click="onTap">查看全部</text>
        </view>
        <view class="continue-card" @click="onTap">
            <view class="continue-info">
                <text class="continue-course-name">{{ courseName }}</text>
                <text class="continue-chapter">上次学到：{{ chapterTitle }}</text>
                <view class="continue-progress-bar">
                    <view class="continue-progress-fill" :style="{ width: progress + '%' }">
                    </view>
                </view>
                <text class="continue-progress-text">已完成 {{ progress }}%</text>
            </view>
            <text class="continue-arrow">›</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        courseName? : string
        chapterTitle? : string
        progress? : number
    }>(), {
        courseName: '',
        chapterTitle: '',
        progress: 0
    })

    const emit = defineEmits(['click'])

    function onTap() : void {
        emit('click')
    }
</script>

