<template>
    <!-- 功能入口网格（原型 404_2195：四格 3D 插画、无彩色底块；#1846 的「全局搜索」是现网独有第 5 格） -->
    <view class="menu-grid">
        <view v-for="(item, idx) in menuItems" :key="idx" class="menu-item"
            :class="{ 'menu-item--col4': idx < 5 }" @click="onMenuClick(item)">
            <image class="menu-icon-img" :src="'/static/icons/dashboard/' + item.icon + '.png'" mode="aspectFit" />
            <text class="menu-label">{{ item.title }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { UNAVAILABLE_TOAST } from '../../../constants/app'

    // ---- 功能入口 ----
    type MenuItem = {
        key : string
        title : string
        /** static/icons/dashboard 下的文件名（不含 .png），出图尺寸 = 44px 容器 × 2 */
        icon : string
        path : string
        available : boolean
        /** #1846：搜索自页头右槽移入宫格。搜索页「取消」走 navigateBack，须压栈进入；其余主目的地维持 reLaunch 清栈 */
        push ?: boolean
    }

    const menuItems : MenuItem[] = [
        { key: 'course-mall', title: '课程商城', icon: 'grid-course-mall', path: '/pages/mall/mall', available: true },
        { key: 'question-bank', title: '题库练习', icon: 'grid-question-bank', path: '/pages/practice/practice', available: true },
        { key: 'materials', title: '学习资料', icon: 'grid-materials', path: '/pages/resources/materials', available: true },
        { key: 'exam-info', title: '考情资讯', icon: 'grid-exam-info', path: '/pages/exam-info/exam-info', available: true },
        // #1846：页头搜索图标的页内可达落点（原型宫格只有 4 格，此格用原型页头的线性放大镜切图）
        { key: 'search', title: '全局搜索', icon: 'grid-search', path: '/pages/search/search', available: true, push: true },
    ]

    function onMenuClick(item : MenuItem) : void {
        if (!item.available || item.path.length == 0) {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
            return
        }
        if (item.push == true) {
            uni.navigateTo({ url: item.path })
            return
        }
        uni.reLaunch({ url: item.path })
    }
</script>

<style lang="scss">
    /* 功能入口网格 */
    .menu-grid {
        flex-direction: row;
        flex-wrap: wrap;
        padding: 0 24rpx;
    }

    .menu-item {
        width: 20%;
        padding: 20rpx 0;
        flex-direction: column;
        align-items: center;
    }

    /* 截图稿为四列宫格：条目各占四分之一宽（四项一行，票 1846 搜索移入后第五项换行续排同宽；样式块禁 # 票号引用，同 search 页先例口径） */
    .menu-item--col4 {
        width: 25%;
    }

    /* 插画为 44x40 / 38x38 原比例，统一装进 88rpx 方框居中（原型格内图标高 40） */
    .menu-icon-img {
        width: 88rpx;
        height: 88rpx;
        margin-bottom: 8rpx;
    }

    /* 原型 404_2195 宫格标签 14px */
    .menu-label {
        font-size: 28rpx;
        color: #333333;
    }
</style>
