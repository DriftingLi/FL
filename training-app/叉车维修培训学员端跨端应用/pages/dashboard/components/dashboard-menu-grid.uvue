<template>
    <!-- 功能入口网格（原型 404_2195：四格 3D 插画、无彩色底块） -->
    <view class="menu-grid">
        <view v-for="(item, idx) in menuItems" :key="idx" class="menu-item"
            :class="{ 'menu-item--col4': idx < 5 }" @click="onMenuClick(item)">
            <image class="menu-icon-img" :src="'/static/icons/dashboard/' + item.icon + '.png'" mode="aspectFit" />
            <text class="menu-label">{{ item.title }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { UNAVAILABLE_TOAST } from '../../../constants/app'

    // ---- 功能入口 ----
    type MenuItem = {
        key : string
        title : string
        /** static/icons/dashboard 下的文件名（不含 .png），出图尺寸 = 44px 容器 × 2 */
        icon : string
        path : string
        available : boolean
    }

    const menuItems : MenuItem[] = [
        // #2620：「课程商城」收为旧名（词表）——学员看到的只有一个货架，叫「商城」
        { key: 'course-mall', title: '商城', icon: 'grid-course-mall', path: '/pages/mall/mall', available: true },
        { key: 'question-bank', title: '题库练习', icon: 'grid-question-bank', path: '/pages/practice/practice', available: true },
        { key: 'materials', title: '学习资料', icon: 'grid-materials', path: '/pages/resources/materials', available: true },
        { key: 'exam-info', title: '考情资讯', icon: 'grid-exam-info', path: '/pages/exam-info/exam-info', available: true },
    ]

    function onMenuClick(item : MenuItem) : void {
        if (!item.available || item.path.length == 0) {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
            return
        }
        uni.reLaunch({ url: item.path })
    }
</script>

<style lang="scss">
    /* 功能入口网格 */
    .menu-grid {
        flex-direction: row;
        flex-wrap: wrap;
        padding: 0 24rpx;
    }

    .menu-item {
        width: 20%;
        padding: 20rpx 0;
        flex-direction: column;
        align-items: center;
    }

    /* 截图稿为四列宫格：条目各占四分之一宽，四项一行 */
    .menu-item--col4 {
        width: 25%;
    }

    /* 插画统一装进方框居中，缩小后保留原比例与标签间距 */
    .menu-icon-img {
        width: 80rpx;
        height: 80rpx;
        margin-bottom: 8rpx;
    }

    /* 原型 404_2195 宫格标签 14px */
    .menu-label {
        font-size: 28rpx;
        color: #333333;
    }
</style>
