<template>
    <!-- 功能入口网格 -->
    <view class="menu-grid">
        <view v-for="(item, idx) in menuItems" :key="idx" class="menu-item"
            :class="{ 'menu-item--col4': idx < 5 }" @click="onMenuClick(item)">
            <view class="menu-icon-box" :style="{ backgroundColor: item.color }">
                <text class="menu-icon-text">{{ item.icon }}</text>
            </view>
            <text class="menu-label">{{ item.title }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { UNAVAILABLE_TOAST } from '../../../constants/app'

    // ---- 功能入口 ----
    type MenuItem = {
        key : string
        title : string
        icon : string
        color : string
        path : string
        available : boolean
        /** #1846：搜索自页头右槽移入宫格。搜索页「取消」走 navigateBack，须压栈进入；其余主目的地维持 reLaunch 清栈 */
        push ?: boolean
    }

    const menuItems : MenuItem[] = [
        { key: 'course-mall', title: '课程商城', icon: '🛒', color: '#FF6B35', path: '/pages/mall/mall', available: true },
        { key: 'question-bank', title: '题库练习', icon: '📚', color: '#4ECDC4', path: '/pages/practice/practice', available: true },
        { key: 'materials', title: '学习资料', icon: '📚', color: '#2979ff', path: '/pages/resources/materials', available: true },
        { key: 'exam-info', title: '考情资讯', icon: '📣', color: '#96CEB4', path: '/pages/exam-info/exam-info', available: true },
        // #1846：页头 🔍 的页内可达落点（色值复用本格既有蓝，不新色）
        { key: 'search', title: '全局搜索', icon: '🔍', color: '#2979ff', path: '/pages/search/search', available: true, push: true },
    ]

    function onMenuClick(item : MenuItem) : void {
        if (!item.available || item.path.length == 0) {
            uni.showToast({ title: UNAVAILABLE_TOAST, icon: 'none' })
            return
        }
        if (item.push == true) {
            uni.navigateTo({ url: item.path })
            return
        }
        uni.reLaunch({ url: item.path })
    }
</script>

<style>
    /* 功能入口网格 */
    .menu-grid {
        flex-direction: row;
        flex-wrap: wrap;
        padding: 0 24rpx;
    }

    .menu-item {
        width: 20%;
        padding: 20rpx 0;
        flex-direction: column;
        align-items: center;
    }

    /* 截图稿为四列宫格：条目各占四分之一宽（四项一行，#1846 搜索移入后第五项换行续排同宽） */
    .menu-item--col4 {
        width: 25%;
    }

    .menu-icon-box {
        width: 88rpx;
        height: 88rpx;
        border-radius: 20rpx;
        margin-bottom: 12rpx;
        align-items: center;
        justify-content: center;
    }

    .menu-icon-text {
        font-size: 44rpx;
    }

    .menu-label {
        font-size: 24rpx;
        color: #333333;
    }
</style>
