/**
 * dashboard 首页数据流（T05 手术 #643，parent #638 / ADR-0007）
 *
 * 自 pages/dashboard/dashboard.uvue 逐符号搬出，行为逐行等价：
 * 通知未读数轮询（30s）、我的课程/继续学习加载、精选内容（新闻资讯）加载。
 * #1422 追加首页课程区热门口径加载（loadHotCourses，替代 dashboard 组件写死的 mock 数组）。
 * 生命周期挂载（onShow/onHide）留在页面壳，本模块只提供 start/stop 纯动作。
 */
import { ref } from 'vue'
import type { Ref } from 'vue'
import { getStudentCoursesApi } from '../../../api/student'
import { getFeaturedContentsApi } from '../../../api/featured'
import { getUnreadCountApi } from '../../../api/notification'
import { getCourseListApi } from '../../../api/course'
import type { StudentCourse, FeaturedContentItem, CourseItem } from '../../../types/index'
import { DASHBOARD_NEWS_CATEGORIES, DASHBOARD_NEWS_LIMIT, mergeDashboardNews } from '../../../utils/dashboardNews'

export type UseDashboardFeedsResult = {
    unreadCount : Ref<number>
    continueLearning : Ref<StudentCourse | null>
    myCourses : Ref<StudentCourse[]>
    newsList : Ref<FeaturedContentItem[]>
    newsFailed : Ref<boolean>
    hotCourses : Ref<CourseItem[]>
    loadMyCourses : () => Promise<void>
    loadFeaturedContents : () => Promise<void>
    loadHotCourses : (credentialId : number, filter : string) => Promise<void>
    startUnreadPolling : () => void
    stopUnreadPolling : () => void
}

export function useDashboardFeeds() : UseDashboardFeedsResult {
    // ---- 通知未读数 ----
    const unreadCount = ref<number>(0)
    let unreadTimer : number | null = null

    async function loadUnreadCount() : Promise<void> {
        try {
            const count = await getUnreadCountApi()
            unreadCount.value = count
        } catch (e) {
            // 静默失败
        }
    }

    function stopUnreadPolling() : void {
        const t = unreadTimer
        if (t != null) {
            clearInterval(t)
            unreadTimer = null
        }
    }

    function startUnreadPolling() : void {
        stopUnreadPolling()
        loadUnreadCount()
        unreadTimer = setInterval(() => {
            loadUnreadCount()
        }, 30000)
    }

    // ---- 继续学习 ----
    const continueLearning = ref<StudentCourse | null>(null)
    const myCourses = ref<StudentCourse[]>([])

    async function loadMyCourses() : Promise<void> {
        try {
            const result = await getStudentCoursesApi()
            myCourses.value = result.courses
            continueLearning.value = result.continue_learning
        } catch (e) {
            console.warn('[dashboard] loadMyCourses failed:', e)
        }
    }

    // ---- 精选内容（#1939：类别范围 = 考情 + 行业新闻 + 政策法规）----
    // 公开列表只支持单个 category（#2063 边界：不加多值参数）⇒ 按类别各取一次再合并；
    // 合并 / 去重 / 倒序 / 截断在 utils/dashboardNews 的纯函数里（行为腿真执行它）。
    const newsList = ref<FeaturedContentItem[]>([])
    /** 三个类别**全部**失败：失败态与空态分开（#816 口径），拉不到不能说成「暂无资讯」 */
    const newsFailed = ref<boolean>(false)

    async function loadFeaturedContents() : Promise<void> {
        const groups : FeaturedContentItem[][] = []
        let failedCount = 0
        for (let i = 0; i < DASHBOARD_NEWS_CATEGORIES.length; i++) {
            try {
                const result = await getFeaturedContentsApi(1, DASHBOARD_NEWS_LIMIT, DASHBOARD_NEWS_CATEGORIES[i])
                groups.push(result.items)
            } catch (e) {
                // 单类别失败不拦整块：首页只是 5 条预告（「更多」进列表页），
                // 一个类别抖动不该把整块清空；只有全失败才落失败态。
                failedCount = failedCount + 1
                console.warn('[dashboard] loadFeaturedContents failed:', e)
            }
        }
        newsList.value = mergeDashboardNews(groups, DASHBOARD_NEWS_LIMIT)
        newsFailed.value = failedCount == DASHBOARD_NEWS_CATEGORIES.length
    }

    // ---- 首页课程区（#1422：真实课程 + 热门口径，替代写死的 mock 数组） ----
    // `/courses` 是公开路由，服务端 CredentialScoped 兜底永不生效（见 api/course.uts 文件头）
    // ⇒ credentialId 必须由页面显式传入（证件解析完成后），否则热门口径会跨证件。取前 4 门（页面卡片位）。
    // #1608 §8⑤：口径不再写死 'hot'——filter 由页面筛选抽屉传入（'' | 'hot' | 'featured'，映射后端既有维度）。
    const hotCourses = ref<CourseItem[]>([])

    async function loadHotCourses(credentialId : number, filter : string) : Promise<void> {
        try {
            const result = await getCourseListApi(1, 4, 0, 0, credentialId, filter)
            hotCourses.value = result.items
        } catch (e) {
            console.warn('[dashboard] loadHotCourses failed:', e)
        }
    }

    return {
        unreadCount: unreadCount,
        continueLearning: continueLearning,
        myCourses: myCourses,
        newsList: newsList,
        newsFailed: newsFailed,
        hotCourses: hotCourses,
        loadMyCourses: () => loadMyCourses(),
        loadFeaturedContents: () => loadFeaturedContents(),
        loadHotCourses: (credentialId : number, filter : string) => loadHotCourses(credentialId, filter),
        startUnreadPolling: () => startUnreadPolling(),
        stopUnreadPolling: () => stopUnreadPolling()
    } as UseDashboardFeedsResult
}
