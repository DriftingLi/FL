/**
 * dashboard 首页证件切换流（T05 手术 #643，parent #638 / ADR-0007）
 *
 * 自 pages/dashboard/dashboard.uvue 逐符号搬出，行为逐行等价：
 * 当前证件加载（含本地存储恢复）→ 失败回退 → 下拉选择 → 乐观更新 → 失败回滚。
 * 数据所有权单一：证件状态全部由本 composable 持有，下拉组件仅收扁平 props、回抛选择事件。
 *
 * @note 原页面局部的证书名回退映射表（本地 Map，key=code）经全仓消费面核对为 0 读取的死代码，
 *       本票随手术删除（T02「逐符号核对消费面」教训的执行）；删除不影响任何行为。
 */
import { ref } from 'vue'
import type { Ref } from 'vue'
import { getCurrentCredentialApi, getAllCredentialsApi, switchCredentialApi, readCurrentCredentialCache, writeCurrentCredentialCache } from '../../../api/credential'
import type { CredentialItem, CredentialGroup } from '../../../types/index'

export type UseDashboardCredentialResult = {
    currentCert : Ref<string>
    showCertDropdown : Ref<boolean>
    credentialGroups : Ref<CredentialGroup[]>
    currentCredentialId : Ref<number>
    isSwitching : Ref<boolean>
    loadCredentials : () => Promise<void>
    onCertTap : () => void
    onSelectCredential : (item : CredentialItem) => Promise<void>
    onCloseCertDropdown : () => void
}

export function useDashboardCredential() : UseDashboardCredentialResult {
    // ---- 证件切换（下拉选择器） ----
    const currentCert = ref<string>('加载中...')
    const showCertDropdown = ref<boolean>(false)
    const credentialGroups = ref<CredentialGroup[]>([])
    const currentCredentialId = ref<number>(0)
    const isSwitching = ref<boolean>(false)
    /**
     * 列表加载失败的去重键（#1349）：`loadCredentials` 挂在 `onShow` 上，首页每次重进都会重拉 ——
     * 同一个错误反复弹同一个 toast 会沦为噪音。只在**错误变化**时提示一次；成功或换一种错误时复位。
     * 内部节流态，不入返回值面（不进契约锁的读写点计数）。
     */
    const lastListError = ref<string>('')

    /**
     * 加载证件数据（#1349：当前证件与列表**两段独立**，各自的失败各自呈现）
     *
     * 原实现是单一 try/catch，且 catch 里再 `await getAllCredentialsApi()` 指望它仍出 mock 列表 ——
     * 列表切真后端后那是一次级联失败（裸 reject 出 `loadCredentials`，`currentCert` 卡在「加载中...」）。
     * 拆两段同时修掉「列表失败覆盖已取到的当前证件」：`getCurrentCredentialApi` 内部已 catch、永不 reject，
     * 故它那段不需要 try。
     */
    async function loadCredentials() : Promise<void> {
        // ---- 段一：当前证件（后端回显 → 缓存 → 清空） ----
        const current = await getCurrentCredentialApi()
        if (current != null) {
            // API 返回了当前证件
            currentCredentialId.value = current!.id
            currentCert.value = current!.name
            // （#1395）原「同步 selected_cert code 键」写点已删：全仓读 0，键退役
            // 缓存「后端确认值」，供下次网络失败时回退（#1349）
            writeCurrentCredentialCache(current)
        } else {
            const cached = readCurrentCredentialCache()
            if (cached != null) {
                // 读不到后端（网络失败）：用上一次后端确认过的 id + name 顶住显示，不回写缓存
                currentCredentialId.value = cached!.id
                currentCert.value = cached!.name
            } else {
                // 后端确认未选择证件（或无缓存可退）⇒ 清空缓存，不留旧值冒充当前证件
                writeCurrentCredentialCache(null)
                currentCert.value = '选择证件'
            }
        }

        // ---- 段二：证件列表（真源 = 后端 grouped；失败只影响下拉，不动段一的结果） ----
        try {
            const groups = await getAllCredentialsApi()
            credentialGroups.value = groups
            lastListError.value = ''
        } catch (e) {
            console.warn('[dashboard] load credential list failed:', e)
            let msg = '证件列表加载失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = msg + ': ' + m
                }
            }
            if (lastListError.value != msg) {
                lastListError.value = msg
                uni.showToast({ title: '证件列表加载失败，请重试', icon: 'none' })
            }
        }
    }

    /** 点击证件名称，展开下拉列表 */
    function onCertTap() : void {
        if (credentialGroups.value.length == 0) {
            uni.showToast({ title: '证件数据加载中', icon: 'none' })
            return
        }
        showCertDropdown.value = !showCertDropdown.value
    }

    /** 选择证件 */
    async function onSelectCredential(item : CredentialItem) : Promise<void> {
        if (isSwitching.value) return
        if (item.id === currentCredentialId.value) {
            showCertDropdown.value = false
            return
        }

        // 乐观更新：立即更新 UI，不等后端返回
        const prevId = currentCredentialId.value
        const prevName = currentCert.value
        currentCredentialId.value = item.id
        currentCert.value = item.name
        showCertDropdown.value = false

        isSwitching.value = true
        try {
            const result = await switchCredentialApi(item.id)
            if (result.success && result.credential != null) {
                // 后端返回了有效结果，用后端数据覆盖
                currentCredentialId.value = result.credential!.id
                currentCert.value = result.credential!.name
                // （#1395）原「同步 selected_cert code 键」写点已删：引导页已切后端确认值，
                // 全仓读 0，键退役
                // 后端确认过的切换结果同样进缓存（#1349：离线回退读的就是这份）
                writeCurrentCredentialCache(result.credential)
                uni.showToast({ title: '已切换至 ' + result.credential!.name, icon: 'none' })
            } else {
                // 后端 200 但没回凭证 = 未确认的切换 ⇒ 按失败处理（回滚 + 提示），
                // 不把乐观更新当成功、也不写本地存储（#1346 K4：未确认不得报成功）
                currentCredentialId.value = prevId
                currentCert.value = prevName
                uni.showToast({ title: '切换失败，请重试', icon: 'none' })
            }
        } catch (e) {
            console.warn('[dashboard] switchCredential failed:', e)
            // 回滚到之前的证件
            currentCredentialId.value = prevId
            currentCert.value = prevName
            let msg = '切换失败，请重试'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            isSwitching.value = false
        }
    }

    /** 关闭下拉列表 */
    function onCloseCertDropdown() : void {
        showCertDropdown.value = false
    }

    return {
        currentCert: currentCert,
        showCertDropdown: showCertDropdown,
        credentialGroups: credentialGroups,
        currentCredentialId: currentCredentialId,
        isSwitching: isSwitching,
        loadCredentials: () => loadCredentials(),
        onCertTap: () => onCertTap(),
        onSelectCredential: (item : CredentialItem) => onSelectCredential(item),
        onCloseCertDropdown: () => onCloseCertDropdown()
    } as UseDashboardCredentialResult
}
