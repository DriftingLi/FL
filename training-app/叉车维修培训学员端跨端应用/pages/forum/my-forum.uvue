<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">我的论坛</text>
            <view class="header-right"></view>
        </view>

        <!-- Tab 切换 -->
        <view class="tab-bar">
            <view class="tab-item" :class="{ active: currentTab === 'topics' }" @click="onSwitchTab('topics')">
                <text class="tab-text">我的帖子</text>
            </view>
            <view class="tab-item" :class="{ active: currentTab === 'replies' }" @click="onSwitchTab('replies')">
                <text class="tab-text">我的回复</text>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 我的帖子 -->
            <view v-if="currentTab === 'topics'">
                <view v-if="topics.length === 0 && !loading" class="empty-tip">
                    <text class="empty-icon"></text>
                    <text class="empty-text">还没有发过帖子</text>
                </view>

                <view class="topic-list">
                    <view v-for="(item, idx) in topics" :key="idx" class="topic-card">
                        <view class="topic-card-main" @click="onTopicClick(item.id)">
                            <text class="topic-title">{{ item.title }}</text>
                            <text class="topic-content-preview">{{ getContentPreview(item.content) }}</text>
                        </view>
                        <view class="topic-footer">
                            <view class="topic-meta">
                                <text class="meta-like-icon">{{ item.liked ? '❤️' : '' }} {{ item.likes_count > 0 ? item.likes_count : '' }}</text>
                                <text class="meta-item"> {{ item.replies_count }}</text>
                                <text class="meta-item"> {{ item.views_count }}</text>
                            </view>
                            <view class="topic-footer-right">
                                <view class="topic-edit-btn" @click.stop="onEditTopic(item.id)">
                                    <text class="topic-edit-text">编辑</text>
                                </view>
                                <text class="meta-time">{{ formatDateStr(item.created_at) }}</text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 我的回复 -->
            <view v-if="currentTab === 'replies'">
                <view v-if="replies.length === 0 && !loading" class="empty-tip">
                    <text class="empty-icon"></text>
                    <text class="empty-text">还没有回复过帖子</text>
                </view>

                <view class="reply-list">
                    <view v-for="(item, idx) in replies" :key="idx" class="reply-card" @click="onTopicClick(item.topic_id)">
                        <text class="reply-topic-title"> {{ item.topic_title }}</text>
                        <text class="reply-content">{{ item.content }}</text>
                        <view class="reply-footer">
                            <text class="reply-time">{{ formatDateStr(item.created_at) }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && (currentTab === 'topics' ? topics.length > 0 : replies.length > 0)" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getMyTopicsApi, getMyRepliesApi } from '../../api/forum'
    import type { ForumTopic, ForumReply } from '../../types/index'

    /** ISO 日期字符串 → YYYY-MM-DD */
    function formatDateStr(dateStr : string) : string {
        if (dateStr == null || dateStr.length < 10) return dateStr
        return dateStr.substring(0, 10)
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const currentTab = ref<string>('topics')
    const topics = ref<ForumTopic[]>([])
    const replies = ref<ForumReply[]>([])
    const page = ref<number>(1)
    const pageSize = 10
    const total = ref<number>(0)
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)

    function getContentPreview(content : string) : string {
        const single = content.replace('\n', ' ')
        if (single.length <= 80) return single
        return single.substring(0, 80) + '...'
    }

    async function loadData(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loading.value = true
        try {
            if (currentTab.value === 'topics') {
                const result = await getMyTopicsApi(page.value, pageSize)
                if (reset) {
                    topics.value = result.items
                } else {
                    topics.value = topics.value.concat(result.items)
                }
                total.value = result.total
                if (topics.value.length >= result.total || result.items.length === 0) {
                    noMore.value = true
                }
            } else {
                const result = await getMyRepliesApi(page.value, pageSize)
                if (reset) {
                    replies.value = result.items
                } else {
                    replies.value = replies.value.concat(result.items)
                }
                total.value = result.total
                if (replies.value.length >= result.total || result.items.length === 0) {
                    noMore.value = true
                }
            }
            if (!noMore.value) {
                page.value = page.value + 1
            }
        } catch (e) {
            console.error('[my-forum] load failed:', e)
            uni.showToast({ title: '加载失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    function onSwitchTab(tab : string) : void {
        if (currentTab.value === tab) return
        currentTab.value = tab
        loadData(true)
    }

    function onLoadMore() : void {
        loadData(false)
    }

    function onTopicClick(topicId : number) : void {
        uni.navigateTo({ url: '/pages/forum/forum-detail?id=' + topicId })
    }

    function onEditTopic(topicId : number) : void {
        uni.navigateTo({ url: '/pages/forum/forum-create?id=' + topicId })
    }

    function onBack() : void {
        goBack()
    }

    onShow(() => {
        loadData(true)
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
    }

    /* Tab 栏 */
    .tab-bar {
        flex-direction: row;
        background-color: #ffffff;
        border-bottom: 1rpx solid #eeeeee;
    }

    .tab-item {
        flex: 1;
        height: 88rpx;
        align-items: center;
        justify-content: center;
        border-bottom: 4rpx solid transparent;
    }

    .tab-item.active {
        border-bottom-color: #2979ff;
    }

    .tab-text {
        font-size: 30rpx;
        color: #666666;
    }

    .tab-item.active .tab-text {
        color: #2979ff;
        font-weight: bold;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 帖子列表 */
    .topic-list {
        flex-direction: column;
        padding: 16rpx 24rpx;
    }

    .topic-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        border: 1rpx solid #eeeeee;
        flex-direction: column;
    }

    .topic-card-main {
        flex-direction: column;
        margin-bottom: 12rpx;
    }

    .topic-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
        line-height: 1.4;
        margin-bottom: 12rpx;
    }

    .topic-content-preview {
        font-size: 26rpx;
        color: #666666;
        line-height: 1.5;
        margin-bottom: 16rpx;
    }

    .topic-footer {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding-top: 12rpx;
        border-top: 1rpx solid #f5f5f5;
    }

    .topic-meta {
        flex-direction: row;
        align-items: center;
    }

    .meta-like-icon {
        font-size: 22rpx;
        color: #999999;
        margin-right: 16rpx;
    }

    .meta-item {
        font-size: 22rpx;
        color: #999999;
        margin-right: 16rpx;
    }

    .meta-time {
        font-size: 22rpx;
        color: #cccccc;
    }

    .topic-footer-right {
        flex-direction: row;
        align-items: center;
    }

    .topic-edit-btn {
        padding: 6rpx 20rpx;
        border-radius: 24rpx;
        background-color: #f0f5ff;
        border: 1rpx solid #d0e0ff;
        margin-right: 16rpx;
    }

    .topic-edit-text {
        font-size: 22rpx;
        color: #2979ff;
    }

    /* 回复列表 */
    .reply-list {
        flex-direction: column;
        padding: 16rpx 24rpx;
    }

    .reply-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        border: 1rpx solid #eeeeee;
        flex-direction: column;
    }

    .reply-topic-title {
        font-size: 26rpx;
        color: #2979ff;
        margin-bottom: 12rpx;
        font-weight: bold;
    }

    .reply-content {
        font-size: 28rpx;
        color: #333333;
        line-height: 1.6;
        margin-bottom: 12rpx;
    }

    .reply-footer {
        flex-direction: row;
        justify-content: flex-end;
    }

    .reply-time {
        font-size: 22rpx;
        color: #cccccc;
    }

    /* 空状态 */
    .empty-tip {
        align-items: center;
        padding: 120rpx 0 80rpx;
        flex-direction: column;
    }

    .empty-icon {
        font-size: 96rpx;
        margin-bottom: 24rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    /* 加载更多 */
    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }
</style>
