<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar :title="headerTitle" variant="inverse" @left-click="onBack" />

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 键盘弹起时给滚动区留出底部空间（#2641）：组件只报原始高度，偏移由宿主加，
                 避免「组件加一次 + 系统 adjust-position 再加一次」的双重位移。 -->
            <view class="scroll-body" :style="{ paddingBottom: keyboardHeight + 'px' }">
                <!-- ===== 反馈模式（G-09）：普通反馈提交 = 单向消息（POST /feedback）；提交后只显示「已提交」态，
                      不做列表、不做状态流转、不做回复线程，也不带 type / 工单号 / SLA ===== -->
                <view v-if="isFeedbackMode" class="form-section">
                    <view v-if="feedbackSubmitted" class="feedback-done">
                        <text class="feedback-done-icon">✓</text>
                        <text class="feedback-done-title">已提交</text>
                        <text class="feedback-done-sub">感谢你的反馈，我们会认真查看</text>
                        <view class="feedback-done-btn" @click="onBack">
                            <text class="feedback-done-btn-text">返回</text>
                        </view>
                    </view>
                    <template v-else>
                        <view class="form-item">
                            <text class="form-label">反馈内容</text>
                            <textarea class="feedback-textarea" :maxlength="feedbackContentMax"
                                placeholder="请描述你遇到的问题或建议（1-1000 字）" v-model="feedbackContent"></textarea>
                            <text class="form-counter">{{ feedbackContent.length }}/{{ feedbackContentMax }}</text>
                        </view>
                        <view class="form-item">
                            <text class="form-label">联系方式（选填）</text>
                            <input class="form-input" type="text" :maxlength="80"
                                placeholder="手机 / 微信 / QQ，方便我们联系你" v-model="feedbackContact" />
                        </view>
                        <view class="submit-section submit-section-inline">
                            <view class="submit-btn" :class="{ disabled: !canSubmitFeedback }" @click="onSubmitFeedback">
                                <text class="submit-btn-text">{{ feedbackSubmitting ? '提交中...' : '提交' }}</text>
                            </view>
                        </view>
                    </template>
                </view>

                <!-- ===== 发帖 / 编辑：单卡（#2689 决策 1）===== -->
                <view v-else-if="!isResourceMode" class="post-card">
                    <!-- 模块 chips：收到标题上方一行（G-08：写侧只留「广场 / 知识问答」两值） -->
                    <view class="category-row">
                        <view v-for="cat in categories" :key="cat.value" class="category-chip"
                            :class="{ active: selectedCategory === cat.value }" @click="onSelectCategory(cat.value)">
                            <text class="category-chip-text"
                                :class="{ active: selectedCategory === cat.value }">{{ cat.label }}</text>
                        </view>
                    </view>

                    <!-- 标题：无边框大字，去掉 label 文本（#2689 决策 1） -->
                    <input class="post-title" type="text" placeholder="请输入标题（1-100 字）" :maxlength="100"
                        v-model="title" />
                    <text class="post-title-counter">{{ title.length }}/100</text>

                    <!-- 输入区形态（#2641 / ADR-0073）：能力端**唯一** WYSIWYG 形态，对外只吐序列化后的
                         markdown 与保真检查结果；无 editor 的平台仍走记号工具栏组件 —— 同一份旧形态。
                         保真 / 粘贴 / 属地 / 边界提示由组件合并成一条提示带（#2689 决策 4）。 -->
                    <!-- #ifndef MP-ALIPAY || MP-BAIDU || MP-TOUTIAO -->
                    <ForumWysiwygInput v-if="useRichEditor" :preview-images="imagePreviewUrls"
                        :image-count="images.length" :max-images="topicImageLimit"
                        placeholder="请输入内容（1-10000 字）" :uploading="uploadingImage"
                        @update:markdown="onMarkdownChange" @update:issues="onIssuesChange"
                        @add-image="onAddImage" @remove-image="onRemoveImage"
                        @preview-image="onPreviewImage" @keyboard-height="onKeyboardHeight" />
                    <!-- #endif -->
                    <ForumMarkdownInput v-if="!useRichEditor" :content="content"
                        :preview-images="imagePreviewUrls" :image-count="images.length" variant="topic"
                        :max-images="topicImageLimit" :maxlength="10000" placeholder="请输入内容（1-10000 字）"
                        :format="effectiveFormat" :show-format-switch="false" :uploading="uploadingImage"
                        @update:content="onContentChange" @add-image="onAddImage"
                        @remove-image="onRemoveImage" @preview-image="onPreviewImage" />

                    <!-- 底部只留一个主按钮（#2689 决策 1） -->
                    <view class="post-submit">
                        <view class="submit-btn" :class="{ disabled: !canSubmit }" @click="onSubmit">
                            <text class="submit-btn-text">{{ submitLabel }}</text>
                        </view>
                    </view>
                </view>

                <!-- ===== 资源投稿（#760）：保持旧布局（label + 简介 + 投稿表单），本票不动 ===== -->
                <view v-else class="form-section">
                    <view class="form-item">
                        <text class="form-label">标题</text>
                        <input class="form-input" type="text" placeholder="请输入资源标题（1-120 字）"
                            :maxlength="120" v-model="title" />
                        <text class="form-counter">{{ title.length }}/120</text>
                    </view>

                    <view class="form-item">
                        <text class="form-label">简介</text>
                        <ForumMarkdownInput :content="content" :preview-images="imagePreviewUrls"
                            :image-count="images.length" variant="topic" :max-images="topicImageLimit"
                            :maxlength="2000" placeholder="介绍这份资料的内容与用途（≤2000 字）"
                            :format="effectiveFormat" :show-format-switch="false" :show-images="false"
                            :show-region-notice="false" :uploading="uploadingImage"
                            @update:content="onContentChange" @add-image="onAddImage"
                            @remove-image="onRemoveImage" @preview-image="onPreviewImage" />
                    </view>

                    <!-- 资源投稿表单（#760）：私有组件承载，状态自持；primitive props 单向下发 -->
                    <ForumContributionForm :title="title" :intro="content" :credential-id="credentialId"
                        :credential-name="credentialName" />
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { FORUM_MAX_TOPIC_IMAGES } from '../../constants/app'
    import { useForumCreateForm } from './composables/useForumCreateForm'
    import ForumContributionForm from './components/forum-contribution-form.uvue'
    import ForumMarkdownInput from './components/forum-markdown-input.uvue'
    // #ifndef MP-ALIPAY || MP-BAIDU || MP-TOUTIAO
    import ForumWysiwygInput from '../../components/forum-wysiwyg-input.uvue'
    // #endif

    /** 发帖面的图片限额（`constants/app` 单点；组件不持缺省值，本页只报自己那一档） */
    const topicImageLimit : number = FORUM_MAX_TOPIC_IMAGES

    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ===== 表单域整域归 composable（页面壳层零自持状态：不 import ref / computed）=====
    const form = useForumCreateForm()
    const {
        categories, title, content, selectedCategory, images, imagePreviewUrls, uploadingImage,
        credentialId, credentialName, isResourceMode, isFeedbackMode, feedbackContent,
        feedbackContact, feedbackSubmitting, feedbackSubmitted, feedbackContentMax,
        useRichEditor, effectiveFormat, keyboardHeight, headerTitle,
        submitLabel, canSubmit, canSubmitFeedback, onSelectCategory, onContentChange,
        onMarkdownChange, onIssuesChange, onKeyboardHeight, onAddImage, onRemoveImage,
        onPreviewImage, onSubmit, onSubmitFeedback, onBack, initFromOptions, loadCredential,
    } = form

    onLoad((options : UTSJSONObject) => { initFromOptions(options) })
    onShow(() => { loadCredential() })
</script>

<style lang="scss">
    .container {
        display: flex;
        background: linear-gradient(to bottom, $gradient-start, $gradient-mid);
        background-color: $gradient-mid;
        flex-direction: column;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    .scroll-body {
        flex-direction: column;
    }

    /* 表单区（资源投稿 / 反馈模式沿用） */
    .form-section {
        background-color: #ffffff;
        margin: 24rpx;
        border-radius: 16rpx;
        padding: 32rpx;
        border: 1px solid #eeeeee;
        flex-direction: column;
    }

    /* 发帖单卡（#2689 决策 1）：标题 / 正文 / 工具栏 / 图片 / 提示 / 发布按钮同处一张卡 */
    .post-card {
        background-color: #ffffff;
        margin: 24rpx;
        border-radius: 16rpx;
        padding: 32rpx;
        border: 1px solid #eeeeee;
        flex-direction: column;
    }

    .form-item {
        flex-direction: column;
        margin-bottom: 32rpx;
    }

    .form-label {
        font-size: 28rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 16rpx;
    }

    .form-input {
        height: 88rpx;
        background-color: #f8f9fa;
        border-radius: 12rpx;
        padding: 0 24rpx;
        font-size: 30rpx;
        color: #333333;
        border: 1rpx solid #e0e0e0;
    }

    .form-counter {
        font-size: 22rpx;
        color: #999999;
        text-align: right;
        margin-top: 8rpx;
    }

    /* 单卡标题：无边框大字（去掉 label 与输入框底色） */
    .post-title {
        height: 88rpx;
        font-size: 34rpx;
        font-weight: bold;
        color: #333333;
        margin-top: 16rpx;
    }

    .post-title-counter {
        font-size: 22rpx;
        color: #999999;
        text-align: right;
        margin-top: 8rpx;
    }

    /* 分类选择 */
    .category-row {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .category-chip {
        min-height: 88rpx;
        padding: 0 24rpx;
        border-radius: 16rpx;
        align-items: center;
        justify-content: center;
        background-color: #f5f5f5;
        border: 1rpx solid #e0e0e0;
        margin-right: 16rpx;
        margin-bottom: 8rpx;
    }

    .category-chip.active {
        background-color: #e8f0fe;
        border: 1rpx solid $primary-color;
    }

    .category-chip-text {
        font-size: 26rpx;
        color: #666666;
    }

    .category-chip-text.active {
        color: $primary-color;
        font-weight: bold;
    }

    /* 发布按钮区 */
    .submit-section {
        padding: 24rpx 24rpx 64rpx;
        align-items: center;
    }

    /* 单卡内的主按钮：卡底一行，不再单独占一个区块 */
    .post-submit {
        margin-top: 24rpx;
    }

    .submit-btn {
        width: 100%;
        height: 88rpx;
        border-radius: 16rpx;
        background-color: $primary-color;
        align-items: center;
        justify-content: center;
    }

    .submit-btn.disabled {
        background-color: #cccccc;
    }

    .submit-btn-text {
        font-size: 32rpx;
        color: #ffffff;
        font-weight: bold;
    }

    /* ===== 反馈模式（G-09）：普通反馈提交（单向消息） ===== */
    .feedback-textarea {
        width: 100%;
        height: 240rpx;
        background-color: #f8f9fa;
        border-radius: 12rpx;
        padding: 16rpx 24rpx;
        font-size: 30rpx;
        color: #333333;
        border: 1rpx solid #e0e0e0;
    }

    /* 反馈提交按钮在表单卡内，收掉外层的大段底部留白 */
    .submit-section-inline {
        padding: 8rpx 0 0;
    }

    /* 提交成功态：只显示「已提交」，不展示列表 / 状态流转 / 回复线程 */
    .feedback-done {
        align-items: center;
        padding: 80rpx 0;
    }

    .feedback-done-icon {
        font-size: 96rpx;
        color: $success-color;
    }

    .feedback-done-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
        margin-top: 24rpx;
    }

    .feedback-done-sub {
        font-size: 26rpx;
        color: #999999;
        margin-top: 8rpx;
    }

    .feedback-done-btn {
        margin-top: 32rpx;
        background-color: $primary-color;
        padding: 16rpx 32rpx;
        border-radius: 16rpx;
        align-items: center;
        justify-content: center;
    }

    .feedback-done-btn-text {
        font-size: 28rpx;
        color: #ffffff;
        font-weight: bold;
    }
</style>
