<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon" @click="onBack">‹</text>
            </view>
            <text class="header-title">{{ headerTitle }}</text>
            <view class="header-right"></view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <view class="form-section">
                <!-- 分类选择 -->
                <view class="form-item">
                    <text class="form-label">分类</text>
                    <view class="category-row">
                        <view v-for="(cat, idx) in categories" :key="idx" class="category-chip"
                            :class="{ active: selectedCategory === cat.value }" @click="onSelectCategory(cat.value)">
                            <text class="category-chip-text"
                                :class="{ active: selectedCategory === cat.value }">{{ cat.label }}</text>
                        </view>
                    </view>
                </view>

                <view class="form-item">
                    <text class="form-label">标题</text>
                    <input class="form-input" type="text"
                        :placeholder="isResourceMode ? '请输入资源标题（1-120 字）' : '请输入标题（1-100 字）'"
                        :maxlength="isResourceMode ? 120 : 100" v-model="title" />
                    <text class="form-counter">{{ title.length }}/{{ isResourceMode ? 120 : 100 }}</text>
                </view>

                <view class="form-item">
                    <text class="form-label">{{ isResourceMode ? '简介' : '内容' }}</text>
                    <!-- 输入区形态（ADR-0025 P3）：数据档位 / 编写预览 / 工具栏 / 图片单入口 / 提示行
                         全在共享组件里（发帖与回复是**同一份**形态）；本页只接线与提交。 -->
                    <ForumMarkdownInput :content="content" :preview-images="imagePreviewUrls"
                        :image-count="images.length" variant="topic" :max-images="topicImageLimit"
                        :maxlength="isResourceMode ? 2000 : 10000"
                        :placeholder="isResourceMode ? '介绍这份资料的内容与用途（≤2000 字）' : '请输入内容（1-10000 字）'"
                        :format="effectiveFormat" :show-format-switch="showFormatSwitch"
                        :show-images="!isResourceMode" :show-region-notice="!isResourceMode"
                        :uploading="uploadingImage"
                        @update:content="onContentChange" @update:format="onFormatChange"
                        @add-image="onAddImage" @remove-image="onRemoveImage"
                        @preview-image="onPreviewImage" />
                </view>

                <!-- 资源投稿表单（#760）：私有组件承载，状态自持；primitive props 单向下发 -->
                <ForumContributionForm v-if="isResourceMode" :title="title" :intro="content"
                    :credential-id="credentialId" :credential-name="credentialName" />
            </view>

            <view v-if="!isResourceMode" class="submit-section">
                <view class="submit-btn" :class="{ disabled: !canSubmit }" @click="onSubmit">
                    <text class="submit-btn-text">{{ submitLabel }}</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { FORMAT_TEXT } from '../../utils/forumBody'
    import { normalizeAuthorFormat, readAuthorFormat, writeAuthorFormat } from '../../utils/forumFormatPreference'
    import { useForumImagePicker } from '../../composables/useForumImagePicker'
    import { FORUM_MAX_TOPIC_IMAGES } from '../../constants/app'
    import { createForumTopicApi, updateForumTopicApi, getForumTopicDetailApi } from '../../api/forum'
    import { getCurrentCredentialApi } from '../../api/credential'
    import { useAuthStore } from '../../stores/auth'
    import type { ForumTopicDetail } from '../../types/index'
    import ForumContributionForm from './components/forum-contribution-form.uvue'
    import ForumMarkdownInput from './components/forum-markdown-input.uvue'

    /** 发帖面的图片限额（`constants/app` 单点；组件不持缺省值，本页只报自己那一档） */
    const topicImageLimit : number = FORUM_MAX_TOPIC_IMAGES

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const authStore = useAuthStore()

    // ===== 分类选项（#760：资源 tab 承载投稿表单，为真模式非论坛类别） =====
    // ADR-0040：「备考经验」改为管理端认定，发布口不再提供 —— 分类行三段 = 广场/资源/知识问答
    type CategoryOption = { label : string, value : string }
    const categories : CategoryOption[] = [
        { label: '广场', value: 'discussion' },
        { label: '资源', value: 'resource' },
        { label: '知识问答', value: 'question' },
    ]

    // ===== 表单状态 =====
    const isEdit = ref<boolean>(false)
    const editTopicId = ref<number>(0)
    const title = ref<string>('')
    const content = ref<string>('')
    const selectedCategory = ref<string>('discussion')
    const submitting = ref<boolean>(false)
    const loadingDetail = ref<boolean>(false)
    /**
     * 图片域整域取自**共享流水线**（发帖与回复同一份实现：选图 / 逐张上传 / 删除 / 预览）。
     * 解构后名字与页内既有引用（`images` / `imagePreviewUrls` / `uploadingImage` / 三个处理器）一一对应，
     * 模板与提交路径无需改动。
     */
    const {
        images, previewImages: imagePreviewUrls, uploading: uploadingImage,
        onAddImage, onRemoveImage, onPreviewImage,
    } = useForumImagePicker(FORUM_MAX_TOPIC_IMAGES)
    // 资源投稿态（#760）：证件由壳层持有（onShow 跟随证件切换刷新），
    // 文件列表与提交在 forum-contribution-form 组件内自持
    const credentialId = ref<number>(0)
    const credentialName = ref<string>('')

    // ===== 正文格式轴（ADR-0025 P3 输入区形态）=====
    /** 新建态：作者上次声明的档位（根 ADR-0044「首次默认纯文本、之后记住上次选择」） */
    const authorFormat = ref<string>(readAuthorFormat())
    /** 编辑态：**帖子原格式**，只读 —— PUT 载荷按编辑不变式不带 `content_format`（P1 已落锁），
        故编辑态不给档位控件，只按原格式决定给不给编写预览与工具栏 */
    const editFormat = ref<string>(FORMAT_TEXT)

    /**
     * 档位切换：**先归一**再落本地值与记忆位。
     *
     * 为什么赋值前也要归一：本地值随后**直接进发布载荷**（`createForumTopicApi` 的 `content_format`），
     * 而契约外取值后端会 400 —— 归一只在存储侧做的话，脏值仍会从载荷漏出去
     * （ADR P3 回记第 4 条：读与写两个方向都归一，契约外的取值既不进存储也不漏出来）。
     */
    function onFormatChange(value : string) : void {
        const next = normalizeAuthorFormat(value)
        authorFormat.value = next
        writeAuthorFormat(next)
    }

    /** 正文变更（组件上抛；工具栏插入也走这条回流，故草稿必须由页面持有） */
    function onContentChange(value : string) : void {
        content.value = value
    }

    /** 资源 tab = 投稿模式；编辑态永不进资源（帖子无 resource 类别） */
    const isResourceMode = computed<boolean>(() : boolean => {
        return selectedCategory.value == 'resource' && !isEdit.value
    })

    // ⚠️ 下面两条**必须**排在 `isResourceMode` 之后：UTS 编译到 Kotlin 后**没有变量提升**，
    // 在前面的初始化式里引用后面声明的 computed 会直接 `unresolved reference`（④c 门实测，
    // 见移动端 `AGENTS.md` 的 UTS 限制表最后几行）。
    /** 实际生效的档位：资源投稿走投稿接口、**没有**格式契约 ⇒ 恒纯文本（不出现 tab / 工具栏） */
    const effectiveFormat = computed<string>(() : string => {
        if (isResourceMode.value) return FORMAT_TEXT
        return isEdit.value ? editFormat.value : authorFormat.value
    })

    /** 档位控件只在**新建论坛帖**时出现：编辑态改不动、资源态存不下，控件留在那里就是承诺做不到的事 */
    const showFormatSwitch = computed<boolean>(() : boolean => !isEdit.value && !isResourceMode.value)

    const headerTitle = computed<string>(() : string => {
        if (isEdit.value) return '编辑帖子'
        return isResourceMode.value ? '上传资源' : '发布新帖'
    })

    /** 提交按钮文案（资源模式提交在组件内，壳层按钮仅论坛态） */
    const submitLabel = computed<string>(() : string => {
        if (submitting.value) return isEdit.value ? '保存中...' : '发布中...'
        return isEdit.value ? '保存修改' : '发布'
    })

    /** 是否可提交 */
    const canSubmit = computed<boolean>(() : boolean => {
        if (submitting.value) return false
        if (uploadingImage.value) return false
        if (loadingDetail.value) return false
        if (title.value.trim().length == 0) return false
        if (content.value.trim().length == 0) return false
        return true
    })

    // ===== 分类选择 =====
    function onSelectCategory(value : string) : void {
        if (submitting.value) return
        if (isEdit.value && value == 'resource') {
            uni.showToast({ title: '编辑帖子不支持资源分类', icon: 'none' })
            return
        }
        selectedCategory.value = value
    }

    /** 非法/历史类别值归一（#710，ADR-0040 收窄）：后端发帖/编辑只认 discussion/question，
        旧默认 general、资源域残留 resource 与历史 experience 一律归 discussion——
        历史值读回来归一而非抛错，防「帖子类别无效」400 */
    function normalizeCategory(value : string) : string {
        if (value == 'question') return value
        return 'discussion'
    }

    /** 加载当前证件（投稿目标；onShow 刷新以跟随证件切换，下发给投稿组件） */
    async function loadCredential() : Promise<void> {
        try {
            const cred = await getCurrentCredentialApi()
            credentialId.value = cred != null ? cred.id : 0
            credentialName.value = cred != null ? cred.name : ''
        } catch (e) {
            credentialId.value = 0
            credentialName.value = ''
        }
    }

    // ===== 加载帖子数据（编辑模式） =====
    async function loadTopicForEdit(topicId : number) : Promise<void> {
        loadingDetail.value = true
        uni.showLoading({ title: '加载中...' })
        try {
            const data = await getForumTopicDetailApi(topicId)
            title.value = data.title
            content.value = data.content
            images.value = data.images.slice()
            // #811：编辑态回填读 category（详情 DTO 只回 category，不回 scope——
            // 旧写法读 data.scope 恒为 buildTopicDetail 垫的 'general'，任何问答帖/经验帖
            // 一进编辑态就被归一成 discussion，保存即降级类别）
            selectedCategory.value = normalizeCategory(data.category)
            // #1240 P3：编辑态把该帖的**原格式**读进来（只读）。它是「按原格式给不给编写预览与工具栏」
            // 的判据；不写回任何载荷 —— 编辑不变式要求 PUT 不带 content_format（ADR-0044 / P1 已落锁）。
            editFormat.value = data.content_format
        } catch (e) {
            console.error('[forum-create] loadTopicForEdit failed:', e)
            uni.showToast({ title: '加载帖子失败', icon: 'none' })
            setTimeout(() => { goBack() }, 1000)
        } finally {
            loadingDetail.value = false
            uni.hideLoading()
        }
    }

    // ===== 提交 =====
    async function onSubmit() : Promise<void> {
        if (submitting.value) return
        if (uploadingImage.value || loadingDetail.value) return
        // 资源模式的提交与按钮在 forum-contribution-form 内；壳层按钮已隐藏，
        // 此处双保险：resource 永不流入发帖接口
        if (isResourceMode.value) return
        if (title.value.trim().length == 0) {
            uni.showToast({ title: '请输入标题', icon: 'none' })
            return
        }
        if (content.value.trim().length == 0) {
            uni.showToast({ title: '请输入内容', icon: 'none' })
            return
        }

        submitting.value = true
        uni.showLoading({ title: isEdit.value ? '保存中...' : '发布中...' })
        try {
            if (isEdit.value) {
                await updateForumTopicApi(editTopicId.value, title.value.trim(), content.value.trim(), images.value, selectedCategory.value)
                uni.showToast({ title: '修改成功', icon: 'success' })
            } else {
                // 新建：把作者的格式声明一并写入（P3 接上数据档位后，缺省不再靠「不带字段」表达）
                await createForumTopicApi(title.value.trim(), content.value.trim(), images.value, selectedCategory.value, authorFormat.value)
                uni.showToast({ title: '发布成功', icon: 'success' })
            }
            setTimeout(() => { goBack() }, 1000)
        } catch (e) {
            console.error('[forum-create] submit failed:', e)
            let msg = isEdit.value ? '修改失败' : '发布失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            submitting.value = false
            uni.hideLoading()
        }
    }

    // 图片域（选图 / 逐张上传 / 删除 / 预览）整域取自 `composables/useForumImagePicker.uts`
    // —— 与回复栏**同一份实现**（限额只在 constants/app 单点声明），本页不再持第二份流水线。

    function onBack() : void {
        if (title.value.length > 0 || content.value.length > 0) {
            uni.showModal({
                title: '提示',
                content: '确定放弃编辑吗？已输入的内容将丢失。',
                success: (res) => {
                    if (res.confirm) {
                        goBack()
                    }
                }
            })
        } else {
            goBack()
        }
    }

    // ===== 初始化：根据 URL 参数决定新建/编辑模式 =====
    onLoad((options : UTSJSONObject) => {
        const id = options['id']
        if (id != null) {
            const parsedId = parseInt(`${id}`)
            if (parsedId > 0) {
                isEdit.value = true
                editTopicId.value = parsedId
                loadTopicForEdit(parsedId)
            }
        }
        // 从 URL 参数接收默认分类：resource 为合法投稿 tab（#760），
        // 其余非法/历史 scope（含历史 experience）归一（#710 / ADR-0040）
        const scope = options['scope']
        if (scope != null && scope != '') {
            const s = `${scope}`
            selectedCategory.value = s == 'resource' ? 'resource' : normalizeCategory(s)
        }
    })

    onShow(() => { loadCredential() })
</script>

<style>
    .container {
        display: flex;
        background: linear-gradient(to bottom, #CFE9FB, #D0EBFD);
        background-color: #D0EBFD;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
        align-items: center;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 表单区 */
    .form-section {
        background-color: #ffffff;
        margin: 24rpx;
        border-radius: 16rpx;
        padding: 32rpx;
        border: 1px solid #eeeeee;
        flex-direction: column;
    }

    .form-item {
        flex-direction: column;
        margin-bottom: 32rpx;
    }

    .form-label {
        font-size: 28rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 16rpx;
    }

    .form-input {
        height: 88rpx;
        background-color: #f8f9fa;
        border-radius: 12rpx;
        padding: 0 24rpx;
        font-size: 30rpx;
        color: #333333;
        border: 1rpx solid #e0e0e0;
    }

    .form-counter {
        font-size: 22rpx;
        color: #999999;
        text-align: right;
        margin-top: 8rpx;
    }

    /* 分类选择 */
    .category-row {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .category-chip {
        padding: 12rpx 28rpx;
        border-radius: 32rpx;
        background-color: #f5f5f5;
        border: 1rpx solid #e0e0e0;
        margin-right: 16rpx;
        margin-bottom: 8rpx;
    }

    .category-chip.active {
        background-color: #e8f0fe;
        border: 1rpx solid #2979ff;
    }

    .category-chip-text {
        font-size: 26rpx;
        color: #666666;
    }

    .category-chip-text.active {
        color: #2979ff;
        font-weight: bold;
    }

    /* 发布按钮区 */
    .submit-section {
        padding: 24rpx 24rpx 64rpx;
        align-items: center;
    }

    .submit-btn {
        width: 100%;
        height: 88rpx;
        border-radius: 44rpx;
        background-color: #2979ff;
        align-items: center;
        justify-content: center;
    }

    .submit-btn.disabled {
        background-color: #cccccc;
    }

    .submit-btn-text {
        font-size: 32rpx;
        color: #ffffff;
        font-weight: bold;
    }
</style>
