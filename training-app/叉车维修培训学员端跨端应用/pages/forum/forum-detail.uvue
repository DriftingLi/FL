<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">帖子详情</text>
            <view class="header-right" v-if="canDelete" @click="onDelete">
                <text class="header-action-danger">删除</text>
            </view>
            <view class="header-right" v-else></view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 加载中 -->
            <view v-if="loading && topic == null" class="loading-wrap">
                <text class="loading-text">加载中...</text>
            </view>

            <!-- 帖子内容 -->
            <view v-if="topic != null" class="topic-section">
                <text class="topic-title">{{ topic.title }}</text>
                <view class="topic-info">
                    <view class="author-avatar">
                        <text class="author-avatar-text">{{ getAuthorInitial(topic.author_name) }}</text>
                    </view>
                    <view class="author-info">
                        <text class="author-name">{{ topic.author_name.length > 0 ? topic.author_name : '匿名学员' }}</text>
                        <text class="post-time">{{ formatDateTime(topic.created_at) }}</text>
                    </view>
                    <view class="topic-stats">
                        <text class="stat-text">👁 {{ topic.views_count }}</text>
                    </view>
                </view>
                <view class="topic-content">
                    <text class="content-text">{{ topic.content }}</text>
                </view>
            </view>

            <!-- 回复列表 -->
            <view v-if="topic != null" class="replies-section">
                <view class="replies-header">
                    <text class="replies-title">全部回复（{{ replies.length }}）</text>
                </view>

                <view v-if="replies.length == 0" class="empty-replies">
                    <text class="empty-replies-text">暂无回复，来说两句吧</text>
                </view>

                <view v-for="(reply, idx) in replies" :key="idx" class="reply-card">
                    <view class="reply-header">
                        <view class="reply-avatar">
                            <text class="reply-avatar-text">{{ getAuthorInitial(reply.author_name) }}</text>
                        </view>
                        <view class="reply-info">
                            <text class="reply-author">{{ reply.author_name.length > 0 ? reply.author_name : '匿名学员' }}</text>
                            <text class="reply-time">{{ formatDateTime(reply.created_at) }}</text>
                        </view>
                        <view v-if="canDeleteReply(reply.author_id)" class="reply-delete" @click="onDeleteReply(reply.id)">
                            <text class="reply-delete-text">删除</text>
                        </view>
                    </view>
                    <text class="reply-content">{{ reply.content }}</text>
                </view>
            </view>
        </scroll-view>

        <!-- 底部回复输入栏 -->
        <view v-if="topic != null" class="reply-bar">
            <input class="reply-input" type="text" placeholder="写下你的回复..." v-model="replyContent" />
            <view class="reply-btn" :class="{ disabled: replyContent.length == 0 || submitting }" @click="onSubmitReply">
                <text class="reply-btn-text">{{ submitting ? '发送中' : '发送' }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { useAuthStore } from '../../stores/auth'
    import {
        getForumTopicDetailApi,
        replyForumTopicApi,
        deleteForumTopicApi,
        deleteForumReplyApi,
    } from '../../api/forum'
    import type { ForumTopicDetail, ForumReply } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const authStore = useAuthStore()

    const topicId = ref<number>(0)
    const topic = ref<ForumTopicDetail | null>(null)
    const replies = ref<ForumReply[]>([])
    const loading = ref<boolean>(false)
    const submitting = ref<boolean>(false)
    const replyContent = ref<string>('')

    /** 当前用户 ID */
    const currentUserId = computed<number>(() : number => {
        const u = authStore.user.value
        if (u != null) return u.user_id
        return 0
    })

    /** 是否可删除帖子（作者本人） */
    const canDelete = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.author_id == currentUserId.value && currentUserId.value > 0
    })

    /** 是否可删除回复（作者本人） */
    function canDeleteReply(authorId : number) : boolean {
        return authorId == currentUserId.value && currentUserId.value > 0
    }

    /** 获取作者名首字 */
    function getAuthorInitial(name : string) : string {
        if (name.length == 0) return '学'
        return name.substring(0, 1)
    }

    /** 格式化时间 YYYY-MM-DD HH:mm */
    function formatDateTime(dateStr : string) : string {
        if (dateStr.length < 16) return dateStr
        return dateStr.substring(0, 16).replace('T', ' ')
    }

    async function loadDetail() : Promise<void> {
        if (topicId.value == 0) return
        loading.value = true
        try {
            const data = await getForumTopicDetailApi(topicId.value)
            topic.value = data
            replies.value = data.replies
        } catch (e) {
            console.error('[forum-detail] load failed:', e)
            uni.showToast({ title: '加载帖子失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    /** 提交回复 */
    async function onSubmitReply() : Promise<void> {
        if (replyContent.value.trim().length == 0) {
            uni.showToast({ title: '请输入回复内容', icon: 'none' })
            return
        }
        if (submitting.value) return
        submitting.value = true
        try {
            const reply = await replyForumTopicApi(topicId.value, replyContent.value.trim())
            replies.value.push(reply)
            replyContent.value = ''
            // 更新回复数
            const t = topic.value
            if (t != null) {
                t.replies_count = t.replies_count + 1
            }
            uni.showToast({ title: '回复成功', icon: 'success' })
        } catch (e) {
            console.error('[forum-detail] reply failed:', e)
            uni.showToast({ title: '回复失败', icon: 'none' })
        } finally {
            submitting.value = false
        }
    }

    /** 删除帖子 */
    function onDelete() : void {
        uni.showModal({
            title: '提示',
            content: '确定删除这篇帖子吗？删除后不可恢复。',
            success: (res) => {
                if (res.confirm) {
                    doDeleteTopic()
                }
            }
        })
    }

    async function doDeleteTopic() : Promise<void> {
        uni.showLoading({ title: '删除中...' })
        try {
            await deleteForumTopicApi(topicId.value)
            uni.showToast({ title: '已删除', icon: 'success' })
            setTimeout(() => {
                uni.navigateBack()
            }, 1000)
        } catch (e) {
            console.error('[forum-detail] delete topic failed:', e)
            uni.showToast({ title: '删除失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 删除回复 */
    function onDeleteReply(replyId : number) : void {
        uni.showModal({
            title: '提示',
            content: '确定删除这条回复吗？',
            success: (res) => {
                if (res.confirm) {
                    doDeleteReply(replyId)
                }
            }
        })
    }

    async function doDeleteReply(replyId : number) : Promise<void> {
        uni.showLoading({ title: '删除中...' })
        try {
            await deleteForumReplyApi(replyId)
            // 从列表中移除
            const newReplies : ForumReply[] = []
            for (let i = 0; i < replies.value.length; i++) {
                if (replies.value[i].id != replyId) {
                    newReplies.push(replies.value[i])
                }
            }
            replies.value = newReplies
            // 更新回复数
            const t = topic.value
            if (t != null) {
                t.replies_count = Math.max(0, t.replies_count - 1)
            }
            uni.showToast({ title: '已删除', icon: 'success' })
        } catch (e) {
            console.error('[forum-detail] delete reply failed:', e)
            uni.showToast({ title: '删除失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    function onBack() : void {
        uni.navigateBack()
    }

    onLoad((options : UTSJSONObject) => {
        const id = options['id']
        if (id != null) {
            topicId.value = parseInt(`${id}`)
        }
        loadDetail()
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
        align-items: center;
    }

    .header-action-danger {
        font-size: 28rpx;
        color: #ffcdd2;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 加载中 */
    .loading-wrap {
        align-items: center;
        padding: 120rpx 0;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    /* 帖子内容区 */
    .topic-section {
        background-color: #ffffff;
        padding: 32rpx;
        margin-bottom: 16rpx;
        flex-direction: column;
    }

    .topic-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
        line-height: 1.5;
        margin-bottom: 24rpx;
    }

    .topic-info {
        flex-direction: row;
        align-items: center;
        margin-bottom: 24rpx;
        padding-bottom: 24rpx;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .author-avatar {
        width: 64rpx;
        height: 64rpx;
        border-radius: 32rpx;
        background-color: #2979ff;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .author-avatar-text {
        font-size: 28rpx;
        color: #ffffff;
        font-weight: bold;
    }

    .author-info {
        flex: 1;
        flex-direction: column;
    }

    .author-name {
        font-size: 28rpx;
        color: #333333;
        font-weight: bold;
        margin-bottom: 4rpx;
    }

    .post-time {
        font-size: 22rpx;
        color: #999999;
    }

    .topic-stats {
        flex-direction: row;
        align-items: center;
    }

    .stat-text {
        font-size: 24rpx;
        color: #999999;
    }

    .topic-content {
        flex-direction: column;
    }

    .content-text {
        font-size: 30rpx;
        color: #333333;
        line-height: 1.8;
    }

    /* 回复列表 */
    .replies-section {
        background-color: #ffffff;
        padding: 32rpx;
        flex-direction: column;
    }

    .replies-header {
        padding-bottom: 24rpx;
        border-bottom: 1rpx solid #f0f0f0;
        margin-bottom: 16rpx;
    }

    .replies-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
    }

    .empty-replies {
        align-items: center;
        padding: 60rpx 0;
    }

    .empty-replies-text {
        font-size: 26rpx;
        color: #999999;
    }

    .reply-card {
        flex-direction: column;
        padding: 24rpx 0;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .reply-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 12rpx;
    }

    .reply-avatar {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: #4caf50;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .reply-avatar-text {
        font-size: 24rpx;
        color: #ffffff;
        font-weight: bold;
    }

    .reply-info {
        flex: 1;
        flex-direction: column;
    }

    .reply-author {
        font-size: 26rpx;
        color: #333333;
        font-weight: bold;
        margin-bottom: 4rpx;
    }

    .reply-time {
        font-size: 22rpx;
        color: #999999;
    }

    .reply-delete {
        padding: 8rpx 16rpx;
    }

    .reply-delete-text {
        font-size: 24rpx;
        color: #f44336;
    }

    .reply-content {
        font-size: 28rpx;
        color: #333333;
        line-height: 1.6;
        padding-left: 72rpx;
    }

    /* 底部回复栏 */
    .reply-bar {
        flex-direction: row;
        align-items: center;
        padding: 16rpx 24rpx;
        background-color: #ffffff;
        border-top: 1rpx solid #eeeeee;
    }

    .reply-input {
        flex: 1;
        height: 72rpx;
        background-color: #f5f5f5;
        border-radius: 36rpx;
        padding: 0 28rpx;
        font-size: 28rpx;
        margin-right: 16rpx;
    }

    .reply-btn {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        border-radius: 36rpx;
        align-items: center;
        justify-content: center;
    }

    .reply-btn.disabled {
        background-color: #cccccc;
    }

    .reply-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }
</style>
