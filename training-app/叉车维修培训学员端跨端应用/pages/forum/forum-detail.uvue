<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">帖子详情</text>
            <view class="header-right" v-if="canDelete" @click="onDelete">
                <!-- <view class="header-right" v-if="canDelete" @click="onDelete"> -->
                <text class="header-action-danger">删除</text>
            </view>
            <view class="header-right" v-if="canEdit && !canDelete" @click="onEditTopic">
                <text class="header-action">编辑</text>
            </view>
            <view class="header-right" v-if="!canDelete && !canEdit" @click="onReportTopicClick">
                <text class="header-action">举报</text>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 加载中 -->
            <view v-if="loading && topic == null" class="loading-wrap">
                <text class="loading-text">加载中...</text>
            </view>

            <!-- 帖子内容 -->
            <view v-if="topic != null" class="topic-section">
                <!--   <text class="topic-title">{{ topic.title }}</text> -->
                <ForumTopicHeader :author-name="tAuthorName" :author-initial="tAuthorInitial"
                    :author-avatar="tAuthorAvatar" :avatar-color="tAvatarColor" :created-at-text="tCreatedAtText"
                    :likes-count="tLikesCount" :liked="tLiked" :favorited="tFavorited"
                    :views-count="tViewsCount" :can-delete="canDelete"
                    @toggle-like="onToggleLike" @toggle-favorite="onToggleFavorite" @delete="onDelete" />
                <ForumTopicBody :content="topicContent" :image-urls="topicImages" />
            </view>

            <!-- 回复列表 -->
            <ForumReplyList v-if="topic != null" :items="replyItems" :sort-field="replySortField"
                :sort-order="replySortOrder" :is-topic-owner="isTopicOwner"
                @sort-field-change="onReplySortFieldChange"
                @sort-order-change="onReplySortOrderChange" @delete-reply="onDeleteReply"
                @report-reply="onReportReply" @toggle-reply-like="onToggleReplyLikeById"
                @reply-to-user="onReplyToUserById"
                @accept-reply="onAcceptReplyById" @cancel-accept="onCancelAcceptById" />
        </scroll-view>

        <!-- 底部回复输入栏 -->
        <view v-if="topic != null" class="reply-bar">
            <view v-for="(img, idx) in replyPreviewImages" :key="idx" class="reply-preview"
                @click="onPreviewReplyImage(idx)">
                <image class="reply-preview-img" :src="img" mode="aspectFill" />
                <view class="reply-preview-remove" @click.stop="onRemoveReplyImage(idx)">
                    <text class="reply-preview-remove-text">×</text>
                </view>
            </view>
            <view v-if="replyImages.length < 3" class="reply-add" @click="onAddReplyImage">
                <text class="reply-add-text">{{ uploadingReplyImage ? '…' : '＋' }}</text>
            </view>
            <input class="reply-input" type="text" placeholder="写下你的回复..." v-model="replyContent" />
            <view class="reply-btn" :class="{ disabled: replyContent.length == 0 || submitting }"
                @click="onSubmitReply">
                <text class="reply-btn-text">{{ submitting ? '发送中' : '发送' }}</text>
            </view>
        </view>

        <!-- 举报弹窗 -->
        <ForumReportDialog v-if="showReportModal" :report-target-type="reportTargetType"
            :submitting="submittingReport" @close="onCloseReport" @submit="onSubmitReport" />
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import ForumTopicHeader from './components/forum-topic-header.uvue'
    import ForumTopicBody from './components/forum-topic-body.uvue'
    import ForumReplyList from './components/forum-reply-list.uvue'
    import ForumReportDialog from './components/forum-report-dialog.uvue'
    import { useTopicDetail } from '../../composables/useTopicDetail'
    import { useReplyComposer } from '../../composables/useReplyComposer'
    import { useReport } from '../../composables/useReport'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { formatDateTimeStr } from '../../utils/format'
    import type { ForumReplyDisplay } from '../../utils/forumDetailDisplay'
    import { resolveFileUrl, getAuthorInitial, getAvatarColor } from '../../utils/forumDisplay'
    import type { ForumReply } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ===== 三域 composable 接线：详情核心 / 回复输入 / 举报 =====
    const detail = useTopicDetail()
    const {
        topicId, topic, replies, loading, replySortField, replySortOrder,
        canDelete, canEdit, currentUserId, onToggleLike, onToggleFavorite, onDelete, onEditTopic,
        onReplySortFieldChange, onReplySortOrderChange, onDeleteReply, afterReplyPosted, loadDetail,
        isTopicOwner, onAcceptReply, onCancelAccept,
    } = detail
    const composer = useReplyComposer()
    const {
        replyContent, replyImages, replyPreviewImages, uploadingReplyImage, submitting,
        onAddReplyImage, onRemoveReplyImage, onPreviewReplyImage,
    } = composer
    const report = useReport()
    const {
        showReportModal, reportTargetType, submittingReport, onReportReply, onCloseReport, onSubmitReport,
    } = report

    /**
     * 帖子头部展示字段（扁平下发：模板不直读可空 topic 成员，Kotlin 可空接收者规避）
     * 帖子图片预解析为完整 URL：模板中不再调用 resolveFileUrl（UTS 模板函数解析不稳定）
     */
    const tAuthorName = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return '匿名学员'
        return t.author_name.length > 0 ? t.author_name : '匿名学员'
    })
    const tAuthorInitial = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return '学'
        return getAuthorInitial(t.author_name)
    })
    const tAuthorAvatar = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return t.author_avatar
    })
    const tAvatarColor = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return '#2979ff'
        return getAvatarColor(t.author_id)
    })
    const tCreatedAtText = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return formatDateTimeStr(t.created_at)
    })
    const tLikesCount = computed<number>(() : number => {
        const t = topic.value
        if (t == null) return 0
        return t.likes_count
    })
    const tLiked = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.liked
    })
    const tFavorited = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.favorited
    })
    const tViewsCount = computed<number>(() : number => {
        const t = topic.value
        if (t == null) return 0
        return t.views_count
    })
    const topicContent = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return t.content
    })
    const topicImages = computed<string[]>(() : string[] => {
        const t = topic.value
        if (t == null) return []
        const urls : string[] = []
        for (let i = 0; i < t.images.length; i++) {
            urls.push(resolveFileUrl(t.images[i]))
        }
        return urls
    })

    /**
     * 该条回复能否被当前用户采纳（问答帖 + 楼主本人 + 非自己回复）。
     * 2026-09-11：原判断写在 forum-reply-list 模板 v-if 里，安卓真机整块不渲染
     * （同数据在小程序正常），判定为原生端模板求值不稳；改为壳层算好后扁平下发
     * （先例：本文件 replyItems 已有的 canDelete/liked 等权限位）。
     */
    function canAcceptReply(r : ForumReply) : boolean {
        if (!isTopicOwner.value) return false
        const t = topic.value
        if (t == null || t.category != 'question') return false
        // 备考经验帖不可被采纳（#836：后端守卫双向 + 库层 CHECK，前端先隐藏必然失败的按钮）
        if (t.is_experience) return false
        if (r.is_accepted) return false
        const uid = currentUserId.value
        if (uid <= 0) return false
        return r.author_id != uid
    }

    const replyItems = computed<ForumReplyDisplay[]>(() : ForumReplyDisplay[] => {
        const out : ForumReplyDisplay[] = []
        const rs = replies.value
        for (let i = 0; i < rs.length; i++) {
            const r = rs[i]
            const urls : string[] = []
            for (let j = 0; j < r.images.length; j++) {
                urls.push(resolveFileUrl(r.images[j]))
            }
            const display : ForumReplyDisplay = {
                id: r.id,
                authorId: r.author_id,
                authorName: r.author_name.length > 0 ? r.author_name : '匿名学员',
                authorInitial: getAuthorInitial(r.author_name),
                authorAvatar: r.author_avatar,
                avatarColor: getAvatarColor(r.author_id),
                createdAtText: formatDateTimeStr(r.created_at),
                content: r.content,
                imageUrls: urls,
                canDelete: detail.canDeleteReply(r),
                liked: detail.isReplyLiked(r),
                likesCount: detail.getReplyLikesCount(r),
                isAccepted: r.is_accepted,
                canAcceptReply: canAcceptReply(r),
            }
            out.push(display)
        }
        return out
    })

    function replyById(id : number) : ForumReply | null {
        const rs = replies.value
        for (let i = 0; i < rs.length; i++) {
            if (rs[i].id == id) return rs[i]
        }
        return null
    }

    function onToggleReplyLikeById(id : number) : void {
        const r = replyById(id)
        if (r == null) return
        detail.onToggleReplyLike(r)
    }

    // ===== 采纳/取消采纳 =====
    function onAcceptReplyById(id : number) : void {
        uni.showModal({
            title: '提示',
            content: '确定采纳此回答吗？采纳后不可撤销积分，但可更换采纳对象。',
            success: (res) => {
                if (res.confirm) {
                    detail.onAcceptReply(id)
                }
            }
        })
    }

    function onCancelAcceptById() : void {
        uni.showModal({
            title: '提示',
            content: '确定取消采纳吗？取消后状态回到未解决，已发积分不回滚。',
            success: (res) => {
                if (res.confirm) {
                    detail.onCancelAccept()
                }
            }
        })
    }

    // ===== 回复某条回复 =====
    function onReplyToUserById(id : number) : void {
        const r = replyById(id)
        if (r == null) return
        const name = r.author_name.length > 0 ? r.author_name : '匿名学员'
        replyContent.value = '@' + name + ' '
    }

    function onSubmitReply() : void {
        composer.onSubmitReply(topicId.value, (reply : ForumReply) => afterReplyPosted(reply))
    }

    function onReportTopicClick() : void {
        const t = topic.value
        if (t == null) return
        report.onReportTopic(t.id)
    }

    function onBack() : void {
        goBack()
    }

    onLoad((options : UTSJSONObject) => {
        const id = options['id']
        if (id != null) {
            topicId.value = parseInt(`${id}`)
        }
        loadDetail()
    })
</script>

<style>
    .container {
        display: flex;
        background: linear-gradient(180deg, #CFE9FB 1%, #D0EBFD 16%, #F5F5F5 100%);
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
        align-items: center;
    }

    .header-action-danger {
        font-size: 28rpx;
        color: #ffcdd2;
    }

    .header-action {
        font-size: 26rpx;
        color: #ffffff;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 加载中 */
    .loading-wrap {
        align-items: center;
        padding: 120rpx 0;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    /* 帖子内容区 */
    .topic-section {
        background-color: #ffffff;
        padding: 32rpx;
        margin-bottom: 16rpx;
        flex-direction: column;
    }

    .topic-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
        line-height: 1.5;
        margin-bottom: 24rpx;
    }

    /* 底部回复栏 */
    .reply-bar {
        flex-direction: row;
        align-items: center;
        padding: 16rpx 24rpx;
        background-color: #ffffff;
        border-top: 1rpx solid #eeeeee;
    }

    .reply-preview {
        width: 56rpx;
        height: 56rpx;
        margin-right: 12rpx;
        position: relative;
    }

    .reply-preview-img {
        width: 56rpx;
        height: 56rpx;
        border-radius: 8rpx;
        background-color: #f0f0f0;
    }

    .reply-preview-remove {
        position: absolute;
        top: -6rpx;
        right: -6rpx;
        width: 32rpx;
        height: 32rpx;
        border-radius: 16rpx;
        background-color: rgba(0, 0, 0, 0.55);
        align-items: center;
        justify-content: center;
    }

    .reply-preview-remove-text {
        font-size: 22rpx;
        color: #ffffff;
        line-height: 1;
    }

    .reply-add {
        width: 56rpx;
        height: 56rpx;
        margin-right: 12rpx;
        border: 1rpx solid #d0d0d0;
        border-radius: 8rpx;
        background-color: #f5f5f5;
        align-items: center;
        justify-content: center;
    }

    .reply-add-text {
        font-size: 36rpx;
        color: #909399;
        line-height: 1;
    }

    .reply-input {
        flex: 1;
        height: 72rpx;
        background-color: #f5f5f5;
        border-radius: 36rpx;
        padding: 0 28rpx;
        font-size: 28rpx;
        margin-right: 16rpx;
    }

    .reply-btn {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        border-radius: 36rpx;
        align-items: center;
        justify-content: center;
    }

    .reply-btn.disabled {
        background-color: #cccccc;
    }

    .reply-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }
</style>
