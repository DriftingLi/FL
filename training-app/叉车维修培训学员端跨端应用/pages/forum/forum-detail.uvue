<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">帖子详情</text>
            <view class="header-right" v-if="canDelete" @click="onDelete">
                <!-- <view class="header-right" v-if="canDelete" @click="onDelete"> -->
                <text class="header-action-danger">删除</text>
            </view>
            <view class="header-right" v-if="canEdit && !canDelete" @click="onEditTopic">
                <text class="header-action">编辑</text>
            </view>
            <view class="header-right" v-if="!canDelete && !canEdit" @click="onReportTopic">
                <text class="header-action">举报</text>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 加载中 -->
            <view v-if="loading && topic == null" class="loading-wrap">
                <text class="loading-text">加载中...</text>
            </view>

            <!-- 帖子内容 -->
            <view v-if="topic != null" class="topic-section">
                <!--   <text class="topic-title">{{ topic.title }}</text> -->
                <view class="topic-info">
                    <view class="author-avatar" :style="{ backgroundColor: getAvatarColor(topic.author_id) }">
                        <image v-if="topic.author_avatar.length > 0" class="author-avatar-img"
                            :src="topic.author_avatar" mode="aspectFill" />
                        <text v-else class="author-avatar-text">{{ getAuthorInitial(topic.author_name) }}</text>
                    </view>
                    <view class="author-info">
                        <text class="author-name">{{ topic.author_name.length > 0 ? topic.author_name : '匿名学员' }}</text>
                        <text class="post-time">{{ formatDateTimeStr(topic.created_at) }}</text>
                    </view>
                    <view class="topic-stats">
                        <view :class="topic.liked ? 'stat-like stat-like-liked' : 'stat-like'" @click="onToggleLike">
                            <text :class="topic.liked ? 'stat-like-icon stat-like-icon-liked' : 'stat-like-icon'">{{ topic.liked ? '♥' : '♡' }}</text>
                            <text :class="topic.liked ? 'stat-like-count stat-like-count-liked' : 'stat-like-count'">{{ topic.likes_count }}</text>
                        </view>
                        <view :class="topic.favorited ? 'stat-like stat-like-favorited' : 'stat-like'" @click="onToggleFavorite">
                            <text :class="topic.favorited ? 'stat-like-icon stat-like-icon-favorited' : 'stat-like-icon'">{{ topic.favorited ? '★' : '☆' }}</text>
                            <text :class="topic.favorited ? 'stat-like-count stat-like-count-favorited' : 'stat-like-count'">收藏</text>
                        </view>
                        <text class="stat-text"> {{ topic.views_count }}</text>
                    </view>
                    <view v-if="canDelete" class="topic-delete" @click="onDelete">
                        <text class="topic-delete-text">删除</text>
                    </view>
                </view>
                <view class="topic-content">
                    <text class="content-text">{{ topic.content }}</text>
                    <view v-if="topicImages.length > 0" class="img-grid">
                        <view v-for="(img, idx) in topicImages" :key="idx" class="img-cell"
                            @click="onPreviewTopicImages(idx)">
                            <image class="img-thumb" :src="img" mode="aspectFill" />
                        </view>
                    </view>
                </view>
            </view>

            <!-- 回复列表 -->
            <view v-if="topic != null" class="replies-section">
                <view class="replies-header">
                    <text class="replies-title">全部回复（{{ replies.length }}）</text>
                    <view class="replies-sort-bar">
                        <view class="reply-sort-chip" :class="{ active: replySortField === 'latest' }" @click="onReplySortFieldChange('latest')">
                            <text class="reply-sort-text" :class="{ active: replySortField === 'latest' }">最新</text>
                        </view>
                        <view class="reply-sort-chip" :class="{ active: replySortField === 'hot' }" @click="onReplySortFieldChange('hot')">
                            <text class="reply-sort-text" :class="{ active: replySortField === 'hot' }">热门</text>
                        </view>
                        <view class="reply-sort-chip" :class="{ active: replySortOrder === 'desc' }" @click="onReplySortOrderChange('desc')">
                            <text class="reply-sort-text" :class="{ active: replySortOrder === 'desc' }">逆序</text>
                        </view>
                        <view class="reply-sort-chip" :class="{ active: replySortOrder === 'asc' }" @click="onReplySortOrderChange('asc')">
                            <text class="reply-sort-text" :class="{ active: replySortOrder === 'asc' }">正序</text>
                        </view>
                    </view>
                </view>

                <view v-if="replies.length == 0" class="empty-replies">
                    <text class="empty-replies-text">暂无回复，来说两句吧</text>
                </view>

                <view v-for="(reply, idx) in replies" :key="idx" class="reply-card">
                    <view class="reply-header">
                        <view class="reply-avatar" :style="{ backgroundColor: getAvatarColor(reply.author_id) }">
                            <image v-if="reply.author_avatar.length > 0" class="reply-avatar-img"
                                :src="reply.author_avatar" mode="aspectFill" />
                            <text v-else class="reply-avatar-text">{{ getAuthorInitial(reply.author_name) }}</text>
                        </view>
                        <view class="reply-info">
                            <text
                                class="reply-author">{{ reply.author_name.length > 0 ? reply.author_name : '匿名学员' }}</text>
                            <text class="reply-time">{{ formatDateTimeStr(reply.created_at) }}</text>
                        </view>
                        <view v-if="canDeleteReply(reply)" class="reply-delete" @click="onDeleteReply(reply.id)">
                            <text class="reply-delete-text">删除</text>
                        </view>
                        <view v-else class="reply-more" @click="onReportReply(reply.id)">
                            <text class="reply-more-text">举报</text>
                        </view>
                    </view>
                    <text class="reply-content">{{ reply.content }}</text>
                    <view v-if="replyImageList(reply).length > 0" class="img-grid">
                        <view v-for="(img, idx) in replyImageList(reply)" :key="idx" class="img-cell small"
                            @click="onPreviewReplyImages(reply, idx)">
                            <image class="img-thumb" :src="img" mode="aspectFill" />
                        </view>
                    </view>
                    <view class="reply-action-row">
                        <text class="reply-action-time">{{ formatDateTimeStr(reply.created_at) }}</text>
                        <view class="reply-action-right">
                            <view :class="isReplyLiked(reply) ? 'reply-like reply-like-liked' : 'reply-like'" @click="onToggleReplyLike(reply)">
                                <text :class="isReplyLiked(reply) ? 'reply-like-icon reply-like-icon-liked' : 'reply-like-icon'">{{ isReplyLiked(reply) ? '♥' : '♡' }}</text>
                                <text :class="isReplyLiked(reply) ? 'reply-like-count reply-like-count-liked' : 'reply-like-count'">{{ getReplyLikesCount(reply) }}</text>
                            </view>
                            <view class="reply-action-btn" @click="onReplyToUser(reply)">
                                <text class="reply-action-text"> 回复</text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </scroll-view>

        <!-- 底部回复输入栏 -->
        <view v-if="topic != null" class="reply-bar">
            <view v-for="(img, idx) in replyPreviewImages" :key="idx" class="reply-preview"
                @click="onPreviewReplyImage(idx)">
                <image class="reply-preview-img" :src="img" mode="aspectFill" />
                <view class="reply-preview-remove" @click.stop="onRemoveReplyImage(idx)">
                    <text class="reply-preview-remove-text">×</text>
                </view>
            </view>
            <view v-if="replyImages.length < 3" class="reply-add" @click="onAddReplyImage">
                <text class="reply-add-text">{{ uploadingReplyImage ? '…' : '＋' }}</text>
            </view>
            <input class="reply-input" type="text" placeholder="写下你的回复..." v-model="replyContent" />
            <view class="reply-btn" :class="{ disabled: replyContent.length == 0 || submitting }"
                @click="onSubmitReply">
                <text class="reply-btn-text">{{ submitting ? '发送中' : '发送' }}</text>
            </view>
        </view>

        <!-- 举报弹窗 -->
        <view v-if="showReportModal" class="report-modal-mask" @click="onCloseReport">
            <view class="report-modal" @click.stop>
                <text class="report-modal-title">{{ reportTargetType === 'topic' ? '举报帖子' : '举报回复' }}</text>
                <textarea class="report-textarea" placeholder="请输入举报原因（1-500字）" maxlength="500"
                    v-model="reportReason" />
                <text class="report-counter">{{ reportReason.length }}/500</text>
                <view class="report-actions">
                    <view class="report-cancel" @click="onCloseReport">
                        <text class="report-cancel-text">取消</text>
                    </view>
                    <view class="report-confirm" :class="{ disabled: reportReason.length < 1 || submittingReport }"
                        @click="onSubmitReport">
                        <text class="report-confirm-text">{{ submittingReport ? '提交中...' : '提交' }}</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useAuthStore } from '../../stores/auth'
    import {
        getForumTopicDetailApi,
        replyForumTopicApi,
        deleteForumTopicApi,
        deleteForumReplyApi,
        uploadForumImageApi,
        likeTopicApi,
        unlikeTopicApi,
        likeReplyApi,
        unlikeReplyApi,
        reportTopicApi,
        reportReplyApi,
    } from '../../api/forum'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import { getStorageJSON, setStorageJSON } from '../../utils/storage'
    import type { ForumTopicDetail, ForumReply } from '../../types/index'

    /** ISO 日期字符串 → YYYY-MM-DD HH:mm */
    function formatDateTimeStr(dateStr : string) : string {
        if (dateStr == null || dateStr.length < 16) return dateStr
        return dateStr.substring(0, 16).replace('T', ' ')
    }

    /** 补全后端返回的相对文件 URL */
    function resolveFileUrl(url : string) : string {
        if (url.length == 0) return ''
        if (url.startsWith('http://') || url.startsWith('https://')) {
            return url
        }
        return url
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const authStore = useAuthStore()

    const topicId = ref<number>(0)
    const topic = ref<ForumTopicDetail | null>(null)
    const replySortField = ref<string>('latest') // latest | hot
    const replySortOrder = ref<string>('asc')    // asc | desc
    /**
     * 帖子图片列表（computed 包装：模板中直接访问 topic.value 的链式属性时，
     * Kotlin 因 value 是可并发修改的 mutable property 无法 smart cast，转由 computed 取值）
     */
    const topicImages = computed<string[]>(() : string[] => {
        const t = topic.value
        if (t == null) return []
        // 预解析为完整 URL：模板中不再调用 resolveFileUrl（UTS 模板函数解析不稳定）
        const urls : string[] = []
        for (let i = 0; i < t.images.length; i++) {
            urls.push(resolveFileUrl(t.images[i]))
        }
        return urls
    })
    const replies = ref<ForumReply[]>([])
    const loading = ref<boolean>(false)
    const submitting = ref<boolean>(false)
    const replyContent = ref<string>('')
    const replyImages = ref<string[]>([])
    /**
     * 回复图片预览 URL（预解析：模板中不调用 import 的 resolveFileUrl，规避 error18；
     * replyImages 仍保存原始路径用于提交后端）
     */
    const replyPreviewImages = computed<string[]>(() : string[] => {
        const urls : string[] = []
        for (let i = 0; i < replyImages.value.length; i++) {
            urls.push(resolveFileUrl(replyImages.value[i]))
        }
        return urls
    })
    const uploadingReplyImage = ref<boolean>(false)
    const topicFavoriteId = ref<number>(0)
    // 回复点赞本地态：key 为 reply.id 字符串，value 为 { liked: boolean, likes_count: number }，持久化到本地存储防止刷新丢失（后端暂未在 GetTopic 下发 replies[].liked/likes_count）
    const replyLikeState = ref<UTSJSONObject>({} as UTSJSONObject)

    function replyLikeStorageKey() : string {
        return 'forum_reply_like_' + topicId.value.toString()
    }

    function persistReplyLikeState() : void {
        try {
            if (topicId.value > 0) setStorageJSON(replyLikeStorageKey(), replyLikeState.value as object)
        } catch (e) { console.warn('[forum-detail] persistReplyLikeState failed:', e) }
    }

    function restoreReplyLikeState() : void {
        if (topicId.value <= 0) return
        try {
            const saved = getStorageJSON(replyLikeStorageKey())
            if (saved != null) {
                // 合并到当前态（保留内存中更新的优先）
                const merged : UTSJSONObject = {} as UTSJSONObject
                for (const k in saved) merged[k] = saved[k]
                for (const k in replyLikeState.value) merged[k] = replyLikeState.value[k]
                replyLikeState.value = merged
            }
        } catch (e) { console.warn('[forum-detail] restoreReplyLikeState failed:', e) }
    }

    function hydrateReplyLikesFromReplies() : void {
        restoreReplyLikeState()
        // 若后端已下发 liked/likes_count（未来实现），以后端为权威回填到本地态，避免刷新后样式因后端 0 被覆盖则仅在本地无记录时写入
        for (let i = 0; i < replies.value.length; i++) {
            const r = replies.value[i]
            const hasBackend = (r.liked == true) || (r.likes_count > 0)
            if (!hasBackend) continue
            const key = r.id.toString()
            const existing = replyLikeState.value[key] as UTSJSONObject | null
            if (existing == null) {
                const next : UTSJSONObject = {} as UTSJSONObject
                for (const k in replyLikeState.value) next[k] = replyLikeState.value[k]
                next[key] = { liked: r.liked, likes_count: r.likes_count } as UTSJSONObject
                replyLikeState.value = next
            }
        }
        // 首次回填后即持久化，保证刷新后数据不丢
        persistReplyLikeState()
    }

    // 举报相关状态
    const showReportModal = ref<boolean>(false)
    const reportTargetType = ref<string>('topic')
    const reportTargetId = ref<number>(0)
    const reportReason = ref<string>('')
    const submittingReport = ref<boolean>(false)

    /** 当前用户 ID */
    const currentUserId = computed<number>(() : number => {
        const u = authStore.user.value
        if (u != null) return u.user_id
        return 0
    })

    /** 是否可删除帖子（后端 can_delete 或作者本人） */
    const canDelete = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        if (t.can_delete) return true
        return t.author_id == currentUserId.value && currentUserId.value > 0
    })

    /** 是否可编辑帖子（作者本人） */
    const canEdit = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.author_id == currentUserId.value && currentUserId.value > 0
    })

    /** 是否可删除回复（后端 can_delete 或作者本人） */
    function canDeleteReply(reply : ForumReply) : boolean {
        if (reply.can_delete) return true
        return reply.author_id == currentUserId.value && currentUserId.value > 0
    }

    /** 回复图片列表（预解析为完整 URL：模板中不再调用函数，规避 UTS 模板函数解析问题） */
    function replyImageList(reply : ForumReply) : string[] {
        const urls : string[] = []
        for (let i = 0; i < reply.images.length; i++) {
            urls.push(resolveFileUrl(reply.images[i]))
        }
        return urls
    }

    /** 获取作者名首字 */
    function getAuthorInitial(name : string) : string {
        if (name.length == 0) return '学'
        return name.substring(0, 1)
    }

    /** 基于 author_id 稳定生成头像背景色，保证同一人在主帖和回复中颜色一致 */
    function getAvatarColor(authorId : number) : string {
        const colors : string[] = ['#2979ff', '#4caf50', '#ff9800', '#9c27b0', '#e91e63', '#009688', '#795548', '#607d8b']
        if (authorId <= 0) return colors[0]
        return colors[authorId % colors.length]
    }

    /** 格式化时间 YYYY-MM-DD HH:mm */
    // ===== 收藏（声明在 loadDetail 之前，避免 Kotlin 局部函数前向引用） =====
    async function loadTopicFavorite() : Promise<void> {
        const t = topic.value
        if (t == null || t.id <= 0) return
        try {
            const result = await checkFavoriteApi('topic', t.id)
            t.favorited = result.favorited
            topicFavoriteId.value = result.favorite_id
        } catch (e) {
            console.warn('[forum-detail] loadTopicFavorite failed:', e)
        }
    }

    async function onToggleFavorite() : Promise<void> {
        const t = topic.value
        if (t == null) return
        const wasFavorited = t.favorited
        // 乐观更新
        t.favorited = !wasFavorited
        try {
            if (wasFavorited) {
                await removeFavoriteApi(topicFavoriteId.value)
                topicFavoriteId.value = 0
            } else {
                const result = await addFavoriteApi('topic', t.id)
                topicFavoriteId.value = result.favorite_id
            }
        } catch (e) {
            // 回滚
            t.favorited = wasFavorited
            console.error('[forum-detail] toggleFavorite failed:', e)
            uni.showToast({ title: '操作失败', icon: 'none' })
        }
    }

    async function loadDetail() : Promise<void> {
        if (topicId.value == 0) return
        loading.value = true
        try {
            const data = await getForumTopicDetailApi(topicId.value, replySortField.value, replySortOrder.value)
            topic.value = data
            replies.value = data.replies
            console.log('[forum-detail] DIAG can_delete=', data.can_delete, 'author_id=', data.author_id, 'currentUserId=', currentUserId.value, 'user=', JSON.stringify(authStore.user.value), 'canDelete=', canDelete.value)
            // 回填回复点赞态（后端暂未下发时靠本地存储恢复，避免刷新后数据/样式丢失）
            hydrateReplyLikesFromReplies()
            // 刷新收藏状态（获取 favorite_id 供取消收藏使用）
            loadTopicFavorite()
        } catch (e) {
            console.error('[forum-detail] load failed:', e)
            uni.showToast({ title: '加载帖子失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    /** 提交回复 */
    async function onSubmitReply() : Promise<void> {
        if (replyContent.value.trim().length == 0) {
            uni.showToast({ title: '请输入回复内容', icon: 'none' })
            return
        }
        if (submitting.value) return
        submitting.value = true
        try {
            const reply = await replyForumTopicApi(topicId.value, replyContent.value.trim(), replyImages.value)
            replies.value.push(reply)
            replyContent.value = ''
            replyImages.value = []
            // 更新回复数
            const t = topic.value
            if (t != null) {
                t.replies_count = t.replies_count + 1
            }
            uni.showToast({ title: '回复成功', icon: 'success' })
        } catch (e) {
            console.error('[forum-detail] reply failed:', e)
            uni.showToast({ title: '回复失败', icon: 'none' })
        } finally {
            submitting.value = false
        }
    }

    /** 执行删除帖子（声明在 onDelete 之前，避免 Kotlin 局部函数前向引用） */
    async function doDeleteTopic() : Promise<void> {
        uni.showLoading({ title: '删除中...' })
        try {
            await deleteForumTopicApi(topicId.value)
            uni.showToast({ title: '已删除', icon: 'success' })
            setTimeout(() => {
                goBack()
            }, 1000)
        } catch (e) {
            console.error('[forum-detail] delete topic failed:', e)
            uni.showToast({ title: '删除失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 删除帖子 */
    function onDelete() : void {
        uni.showModal({
            title: '提示',
            content: '确定删除这篇帖子吗？删除后不可恢复。',
            success: (res) => {
                if (res.confirm) {
                    doDeleteTopic()
                }
            }
        })
    }

    /** 执行删除回复（声明在 onDeleteReply 之前，避免 Kotlin 局部函数前向引用） */
    async function doDeleteReply(replyId : number) : Promise<void> {
        uni.showLoading({ title: '删除中...' })
        try {
            await deleteForumReplyApi(replyId)
            // 从列表中移除
            const newReplies : ForumReply[] = []
            for (let i = 0; i < replies.value.length; i++) {
                if (replies.value[i].id != replyId) {
                    newReplies.push(replies.value[i])
                }
            }
            replies.value = newReplies
            // 更新回复数
            const t = topic.value
            if (t != null) {
                t.replies_count = Math.max(0, t.replies_count - 1)
            }
            uni.showToast({ title: '已删除', icon: 'success' })
        } catch (e) {
            console.error('[forum-detail] delete reply failed:', e)
            uni.showToast({ title: '删除失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 删除回复 */
    function onDeleteReply(replyId : number) : void {
        uni.showModal({
            title: '提示',
            content: '确定删除这条回复吗？',
            success: (res) => {
                if (res.confirm) {
                    doDeleteReply(replyId)
                }
            }
        })
    }

    /** 预览一组图片（帖子/回复共用） */
    function onPreviewImages(all : string[], index : number) : void {
        const urls : string[] = []
        for (let i = 0; i < all.length; i++) {
            urls.push(resolveFileUrl(all[i]))
        }
        uni.previewImage({
            urls: urls,
            current: index,
        })
    }

    /** 预览帖子图片（index 从模板传入；定义在 onPreviewImages 之后，UTS 局部函数不可前向引用） */
    function onPreviewTopicImages(index : number) : void {
        const t = topic.value
        if (t == null) return
        onPreviewImages(t.images, index)
    }

    /** 预览回复图片 */
    function onPreviewReplyImages(reply : ForumReply, index : number) : void {
        onPreviewImages(reply.images, index)
    }

    /** 逐张上传回复图片（声明在 onAddReplyImage 之前，避免 Kotlin 局部函数前向引用） */
    async function uploadReplyImages(paths : string[]) : Promise<void> {
        uploadingReplyImage.value = true
        uni.showLoading({ title: '上传图片中...' })
        let failed = 0
        for (let i = 0; i < paths.length; i++) {
            if (replyImages.value.length >= 3) break
            try {
                const url = await uploadForumImageApi(paths[i])
                replyImages.value.push(url)
            } catch (e) {
                console.error('[forum-detail] upload reply image failed:', e)
                failed = failed + 1
            }
        }
        uni.hideLoading()
        uploadingReplyImage.value = false
        if (failed > 0) {
            uni.showToast({ title: failed + ' 张图片上传失败，请重试', icon: 'none' })
        }
    }

    /** 选择回复图片：批量选择并上传（最多 3 张） */
    function onAddReplyImage() : void {
        if (uploadingReplyImage.value) return
        const remaining = 3 - replyImages.value.length
        if (remaining <= 0) {
            uni.showToast({ title: '最多上传 3 张图片', icon: 'none' })
            return
        }
        uni.chooseImage({
            count: remaining,
            sizeType: ['compressed'],
            sourceType: ['album', 'camera'],
            success: (res) => {
                const paths = res.tempFilePaths as string[]
                if (paths.length == 0) return
                uploadReplyImages(paths)
            },
            fail: (err) => {
                console.log('[forum-detail] chooseImage canceled/failed:', err)
            },
        })
    }

    /** 删除已选回复图片 */
    function onRemoveReplyImage(index : number) : void {
        const next : string[] = []
        for (let i = 0; i < replyImages.value.length; i++) {
            if (i != index) next.push(replyImages.value[i])
        }
        replyImages.value = next
    }

    /** 预览已选回复图片 */
    function onPreviewReplyImage(index : number) : void {
        onPreviewImages(replyImages.value, index)
    }

    // ===== 回复点赞本地态 helpers（后端 GET /forum/topics/{id} 暂未返回 replies[].liked/likes_count，靠本地态 + POST/DELETE /forum/replies/{id}/like 同步） =====
    function getReplyLikeRecord(replyId : number) : UTSJSONObject | null {
        const key = replyId.toString()
        const v = replyLikeState.value[key]
        if (v == null) return null
        return v as UTSJSONObject
    }

    function isReplyLiked(reply : ForumReply) : boolean {
        const rec = getReplyLikeRecord(reply.id)
        if (rec != null) return rec['liked'] == true
        // 兼容后端未来在 reply 上直接返回 liked / liked_by_me
        const raw = reply as unknown as UTSJSONObject
        if (raw['liked'] == true) return true
        if (raw['liked_by_me'] == true) return true
        return false
    }

    function getReplyLikesCount(reply : ForumReply) : number {
        const rec = getReplyLikeRecord(reply.id)
        if (rec != null) {
            const n = rec['likes_count'] as number
            if (n != null) return n as number
        }
        const raw = reply as unknown as UTSJSONObject
        const v1 = raw['likes_count'] as number
        if (v1 != null && (v1 as number) >= 0) return v1 as number
        const v2 = raw['like_count'] as number
        if (v2 != null && (v2 as number) >= 0) return v2 as number
        return 0
    }

    function setReplyLikeState(replyId : number, liked : boolean, likesCount : number) : void {
        const key = replyId.toString()
        const next : UTSJSONObject = {} as UTSJSONObject
        for (const k in replyLikeState.value) {
            next[k] = replyLikeState.value[k]
        }
        next[key] = { liked: liked, likes_count: likesCount } as UTSJSONObject
        replyLikeState.value = next
        persistReplyLikeState()
    }

    async function onToggleReplyLike(reply : ForumReply) : Promise<void> {
        const wasLiked = isReplyLiked(reply)
        const oldCount = getReplyLikesCount(reply)
        const nextLiked = !wasLiked
        const nextCount = wasLiked ? Math.max(0, oldCount - 1) : oldCount + 1
        setReplyLikeState(reply.id, nextLiked, nextCount)
        try {
            if (wasLiked) {
                const result = await unlikeReplyApi(reply.id)
                setReplyLikeState(reply.id, result.liked, result.likes_count)
            } else {
                const result = await likeReplyApi(reply.id)
                setReplyLikeState(reply.id, result.liked, result.likes_count)
            }
        } catch (e) {
            setReplyLikeState(reply.id, wasLiked, oldCount)
            console.error('[forum-detail] toggle reply like failed:', e)
            let msg = '操作失败'
            if (e instanceof Error) {
                const m = (e as Error).message
                if (m != null && m.length > 0) msg = m
            }
            // 后端若尚未实现该接口会 404，提示更友好
            if (msg.indexOf('404') >= 0 || msg.indexOf('不存在') >= 0) {
                msg = '点赞回复功能后端暂未实现'
            }
            uni.showToast({ title: msg, icon: 'none' })
        }
    }

    // ===== 点赞 =====
    async function onToggleLike() : Promise<void> {
        const t = topic.value
        if (t == null) return
        const wasLiked = t.liked
        const oldCount = t.likes_count
        t.liked = !wasLiked
        t.likes_count = wasLiked ? oldCount - 1 : oldCount + 1
        if (t.likes_count < 0) t.likes_count = 0
        try {
            if (wasLiked) {
                const result = await unlikeTopicApi(t.id)
                t.liked = result.liked
                t.likes_count = result.likes_count
            } else {
                const result = await likeTopicApi(t.id)
                t.liked = result.liked
                t.likes_count = result.likes_count
            }
        } catch (e) {
            t.liked = wasLiked
            t.likes_count = oldCount
            console.error('[forum-detail] toggle like failed:', e)
        }
    }

    // ===== 回复某条回复 =====
    function onReplyToUser(reply : ForumReply) : void {
        const name = reply.author_name.length > 0 ? reply.author_name : '匿名学员'
        replyContent.value = '@' + name + ' '
    }

    // ===== 举报 =====
    function onReportTopic() : void {
        const t = topic.value
        if (t == null) return
        reportTargetType.value = 'topic'
        reportTargetId.value = t.id
        reportReason.value = ''
        showReportModal.value = true
    }

    function onReportReply(replyId : number) : void {
        reportTargetType.value = 'reply'
        reportTargetId.value = replyId
        reportReason.value = ''
        showReportModal.value = true
    }

    function onCloseReport() : void {
        showReportModal.value = false
        reportReason.value = ''
    }

    async function onSubmitReport() : Promise<void> {
        if (reportReason.value.trim().length < 1) {
            uni.showToast({ title: '请输入举报原因', icon: 'none' })
            return
        }
        if (submittingReport.value) return
        submittingReport.value = true
        try {
            if (reportTargetType.value == 'topic') {
                await reportTopicApi(reportTargetId.value, reportReason.value.trim())
            } else {
                await reportReplyApi(reportTargetId.value, reportReason.value.trim())
            }
            uni.showToast({ title: '举报已提交，感谢反馈', icon: 'success' })
            onCloseReport()
        } catch (e) {
            console.error('[forum-detail] report failed:', e)
            let msg = '举报失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) msg = m
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            submittingReport.value = false
        }
    }

    // ===== 编辑帖子 =====
    function onEditTopic() : void {
        const t = topic.value
        if (t == null) return
        uni.navigateTo({ url: '/pages/forum/forum-create?id=' + t.id })
    }

    // ===== 回复排序 =====
    function onReplySortFieldChange(field : string) : void {
        if (replySortField.value === field) return
        replySortField.value = field
        loadDetail()
    }

    function onReplySortOrderChange(order : string) : void {
        if (replySortOrder.value === order) return
        replySortOrder.value = order
        loadDetail()
    }

    function onBack() : void {
        goBack()
    }

    onLoad((options : UTSJSONObject) => {
        const id = options['id']
        if (id != null) {
            topicId.value = parseInt(`${id}`)
        }
        loadDetail()
    })
</script>

