<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">帖子详情</text>
            <view class="header-right" v-if="canDelete" @click="onDelete">
                <!-- <view class="header-right" v-if="canDelete" @click="onDelete"> -->
                <text class="header-action-danger">删除</text>
            </view>
            <view class="header-right" v-if="canEdit && !canDelete" @click="onEditTopic">
                <text class="header-action">编辑</text>
            </view>
            <view class="header-right" v-if="!canDelete && !canEdit" @click="onReportTopicClick">
                <text class="header-action">举报</text>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 加载中 -->
            <view v-if="loading && topic == null" class="loading-wrap">
                <text class="loading-text">加载中...</text>
            </view>

            <!-- 帖子内容 -->
            <view v-if="topic != null" class="topic-section">
                <!--   <text class="topic-title">{{ topic.title }}</text> -->
                <ForumTopicHeader :author-name="tAuthorName" :author-initial="tAuthorInitial"
                    :author-avatar="tAuthorAvatar" :avatar-color="tAvatarColor" :created-at-text="tCreatedAtText"
                    :region-text="tRegionText"
                    :likes-count="tLikesCount" :liked="tLiked" :favorited="tFavorited"
                    :replies-count="tRepliesCount"
                    :views-count="tViewsCount" :can-delete="canDelete"
                    @toggle-like="onToggleLike" @toggle-favorite="onToggleFavorite" @delete="onDelete" />
                <!-- 正文格式由壳层扁平下发（ADR-0025 P2）：组件不读 topic，档位决策在 utils/forumBody -->
                <ForumTopicBody :content="topicContent" :format="topicFormat" :image-urls="topicImages" />
            </view>

            <!-- 回复列表 -->
            <ForumReplyList v-if="topic != null" :items="replyItems" :sort-field="replySortField"
                :sort-order="replySortOrder" :is-topic-owner="isTopicOwner"
                :total-count="replyTotal" :has-more="hasMoreReplies"
                :loading-more="loadingMore" :remaining="remainingReplies"
                @sort-field-change="onReplySortFieldChange"
                @sort-order-change="onReplySortOrderChange" @delete-reply="onDeleteReply"
                @report-reply="onReportReply" @toggle-reply-like="onToggleReplyLikeById"
                @reply-to-user="onReplyToUserById"
                @accept-reply="onAcceptReplyById" @cancel-accept="onCancelAcceptById"
                @load-more="loadMoreReplies" />
        </scroll-view>

        <!-- 底部**常驻触发条**（⑪-1：形态不变，点它升起半屏浮层）。数据档位常驻一行是
             「Markdown 完全 opt-in」下唯一入口；tab / 工具栏 / 边界提示行只在 Markdown 档出现（⑥-5）。 -->
        <view v-if="topic != null" class="reply-bar">
            <view class="reply-trigger" @click="onOpenReply">
                <text class="reply-trigger-ph">写下你的回复...</text>
                <text class="reply-trigger-act">回复</text>
            </view>
        </view>

        <!-- 半屏浮层（⑪-1/⑪-4）：全屏遮罩阻断阅读（列表滚不动）+ 从底部升起、贴键盘上沿的面板。
             面板 `bottom` 由 uni.onKeyboardHeightChange 去抖后驱动；输入区形态本身仍是共享组件
             ForumMarkdownInput，原样搬进、不改形态（⑪-2）。遮罩点击收起，面板 @click.stop 防误收。 -->
        <view v-if="replyExpanded" class="reply-panel-mask" @click="onCollapseReply">
            <view class="reply-panel" :style="{ marginBottom: panelBottom + 'px', maxHeight: panelMaxHeight + 'px' }"
                @click.stop>
                <ForumMarkdownInput :content="replyContent" :preview-images="replyPreviewImages"
                    :image-count="replyImages.length" variant="reply" :max-images="replyImageLimit"
                    :maxlength="10000" placeholder="写下你的回复..."
                    :format="replyFormat" :show-format-switch="true"
                    :uploading="uploadingReplyImage"
                    @update:content="onReplyContentChange" @update:format="onReplyFormatChange"
                    @add-image="onAddReplyImage" @remove-image="onRemoveReplyImage"
                    @preview-image="onPreviewReplyImage" />
                <view class="reply-actions">
                    <view class="reply-collapse" @click="onCollapseReply">
                        <text class="reply-collapse-text">收起</text>
                    </view>
                    <view class="reply-btn" :class="{ disabled: !canSubmitReply }"
                        @click="onSubmitReply">
                        <text class="reply-btn-text">{{ submitting ? '发送中' : '发送' }}</text>
                    </view>
                </view>
            </view>
        </view>

        <!-- 举报弹窗 -->
        <ForumReportDialog v-if="showReportModal" :report-target-type="reportTargetType"
            :submitting="submittingReport" @close="onCloseReport" @submit="onSubmitReport" />
    </view>
</template>

<script setup lang="uts">
    import { computed, ref, nextTick } from 'vue'
    import { onLoad, onUnload } from '@dcloudio/uni-app'
    import ForumTopicHeader from './components/forum-topic-header.uvue'
    import ForumTopicBody from './components/forum-topic-body.uvue'
    import ForumReplyList from './components/forum-reply-list.uvue'
    import ForumReportDialog from './components/forum-report-dialog.uvue'
    import ForumMarkdownInput from './components/forum-markdown-input.uvue'
    import { useTopicDetail } from '../../composables/useTopicDetail'
    import { useReplyComposer } from '../../composables/useReplyComposer'
    import { useReport } from '../../composables/useReport'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { formatDateTimeStr } from '../../utils/format'
    import type { ForumReplyDisplay } from '../../utils/forumDetailDisplay'
    import { resolveFileUrl, getAuthorInitial, getAvatarColor, regionLabel } from '../../utils/forumDisplay'
    import { FORUM_MAX_REPLY_IMAGES } from '../../constants/app'
    import { createKeyboardHeightTracker, panelBottomPx, panelMaxHeightPx } from '../../utils/replyPanelLayout'
    import type { ForumReply } from '../../types/index'

    /** 回复面的图片限额（`constants/app` 单点；组件不持缺省值，本页只报自己那一档） */
    const replyImageLimit : number = FORUM_MAX_REPLY_IMAGES

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ===== 三域 composable 接线：详情核心 / 回复输入 / 举报 =====
    const detail = useTopicDetail()
    const {
        topicId, topic, replies, loading, replySortField, replySortOrder,
        replyTotal, hasMoreReplies, loadingMore, remainingReplies, loadMoreReplies,
        canDelete, canEdit, currentUserId, onToggleLike, onToggleFavorite, onDelete, onEditTopic,
        onReplySortFieldChange, onReplySortOrderChange, onDeleteReply, afterReplyPosted, loadDetail,
        isTopicOwner, onAcceptReply, onCancelAccept,
    } = detail
    const composer = useReplyComposer()
    const {
        replyContent, replyImages, replyPreviewImages, uploadingReplyImage, submitting, replyFormat,
        canSubmitReply,
        onFormatChange: onReplyFormatChange,
        onAddReplyImage, onRemoveReplyImage, onPreviewReplyImage,
    } = composer

    /** 底部回复浮层展开态（点常驻触发条 / @某人 升起半屏面板，遮罩点击或发送成功后收起） */
    const replyExpanded = ref<boolean>(false)
    // ⑪-4：去抖后的键盘高度，驱动浮层面板 bottom 贴键盘上沿（replyPanelLayout 纯逻辑，③ 可执行）。
    const keyboardHeight = ref<number>(0)
    const keyboardTracker = createKeyboardHeightTracker((h : number) => {
        keyboardHeight.value = h
    })
    const panelBottom = computed<number>(() : number => panelBottomPx(keyboardHeight.value, replyExpanded.value))
    const panelMaxHeight = computed<number>(() : number => panelMaxHeightPx(windowHeight))

    /** 正文变更（组件上抛；工具栏插入也走这条回流，故草稿由 composable 持有） */
    function onReplyContentChange(value : string) : void {
        replyContent.value = value
    }
    const report = useReport()
    const {
        showReportModal, reportTargetType, submittingReport, onReportReply, onCloseReport, onSubmitReport,
    } = report

    /**
     * 帖子头部展示字段（扁平下发：模板不直读可空 topic 成员，Kotlin 可空接收者规避）
     * 帖子图片预解析为完整 URL：模板中不再调用 resolveFileUrl（UTS 模板函数解析不稳定）
     */
    const tAuthorName = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return '匿名学员'
        return t.author_name.length > 0 ? t.author_name : '匿名学员'
    })
    const tAuthorInitial = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return '学'
        return getAuthorInitial(t.author_name)
    })
    const tAuthorAvatar = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return t.author_avatar
    })
    const tAvatarColor = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return '#2979ff'
        return getAvatarColor(t.author_id)
    })
    const tCreatedAtText = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return formatDateTimeStr(t.created_at)
    })
    /** 帖子属地快照（ADR-0045）：空串 = 无属地，作者行那段整段不渲染 */
    const tRegionText = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return regionLabel(t.ip_province, t.ip_city)
    })
    const tLikesCount = computed<number>(() : number => {
        const t = topic.value
        if (t == null) return 0
        return t.likes_count
    })
    const tLiked = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.liked
    })
    const tFavorited = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.favorited
    })
    const tViewsCount = computed<number>(() : number => {
        const t = topic.value
        if (t == null) return 0
        return t.views_count
    })
    /** 回复数（只读统计，与卡片侧 💬 对齐）：与 replies_count 同源，不另持一份 */
    const tRepliesCount = computed<number>(() : number => {
        const t = topic.value
        if (t == null) return 0
        return t.replies_count
    })
    const topicContent = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return t.content
    })
    /** 正文格式（ADR-0025 P2）：DTO 层已归一（缺省与脏值 → `text`），壳层只透传，不再二次判值 */
    const topicFormat = computed<string>(() : string => {
        const t = topic.value
        if (t == null) return ''
        return t.content_format
    })
    const topicImages = computed<string[]>(() : string[] => {
        const t = topic.value
        if (t == null) return []
        const urls : string[] = []
        for (let i = 0; i < t.images.length; i++) {
            urls.push(resolveFileUrl(t.images[i]))
        }
        return urls
    })

    /**
     * 该条回复能否被当前用户采纳（问答帖 + 楼主本人 + 非自己回复）。
     * 2026-09-11：原判断写在 forum-reply-list 模板 v-if 里，安卓真机整块不渲染
     * （同数据在小程序正常），判定为原生端模板求值不稳；改为壳层算好后扁平下发
     * （先例：本文件 replyItems 已有的 canDelete/liked 等权限位）。
     */
    function canAcceptReply(r : ForumReply) : boolean {
        if (!isTopicOwner.value) return false
        const t = topic.value
        if (t == null || t.category != 'question') return false
        // 备考经验帖不可被采纳（#836：后端守卫双向 + 库层 CHECK，前端先隐藏必然失败的按钮）
        if (t.is_experience) return false
        if (r.is_accepted) return false
        const uid = currentUserId.value
        if (uid <= 0) return false
        return r.author_id != uid
    }

    const replyItems = computed<ForumReplyDisplay[]>(() : ForumReplyDisplay[] => {
        const out : ForumReplyDisplay[] = []
        const rs = replies.value
        for (let i = 0; i < rs.length; i++) {
            const r = rs[i]
            const urls : string[] = []
            for (let j = 0; j < r.images.length; j++) {
                urls.push(resolveFileUrl(r.images[j]))
            }
            const display : ForumReplyDisplay = {
                id: r.id,
                authorId: r.author_id,
                authorName: r.author_name.length > 0 ? r.author_name : '匿名学员',
                authorInitial: getAuthorInitial(r.author_name),
                authorAvatar: r.author_avatar,
                avatarColor: getAvatarColor(r.author_id),
                createdAtText: formatDateTimeStr(r.created_at),
                content: r.content,
                // 回复正文格式（ADR-0025 P2）：与帖子正文同源同归一，回复卡据此选渲染档位
                contentFormat: r.content_format,
                imageUrls: urls,
                canDelete: detail.canDeleteReply(r),
                liked: detail.isReplyLiked(r),
                likesCount: detail.getReplyLikesCount(r),
                isAccepted: r.is_accepted,
                canAcceptReply: canAcceptReply(r),
                // 属地快照（ADR-0045）：市优先退省，空串即无属地（署名行整段不渲染）
                regionText: regionLabel(r.ip_province, r.ip_city),
            }
            out.push(display)
        }
        return out
    })

    function replyById(id : number) : ForumReply | null {
        const rs = replies.value
        for (let i = 0; i < rs.length; i++) {
            if (rs[i].id == id) return rs[i]
        }
        return null
    }

    function onToggleReplyLikeById(id : number) : void {
        const r = replyById(id)
        if (r == null) return
        detail.onToggleReplyLike(r)
    }

    // ===== 采纳/取消采纳 =====
    function onAcceptReplyById(id : number) : void {
        uni.showModal({
            title: '提示',
            content: '确定采纳此回答吗？采纳后不可撤销积分，但可更换采纳对象。',
            success: (res) => {
                if (res.confirm) {
                    detail.onAcceptReply(id)
                }
            }
        })
    }

    function onCancelAcceptById() : void {
        uni.showModal({
            title: '提示',
            content: '确定取消采纳吗？取消后状态回到未解决，已发积分不回滚。',
            success: (res) => {
                if (res.confirm) {
                    detail.onCancelAccept()
                }
            }
        })
    }

    // ===== 回复某条回复 =====
    function onReplyToUserById(id : number) : void {
        const r = replyById(id)
        if (r == null) return
        const name = r.author_name.length > 0 ? r.author_name : '匿名学员'
        // 先展开、等输入组件挂载完成再写草稿：收起态下组件未挂载，原生 <input> 的
        // :value 不认「挂载那一帧之前」刚写的值（实测点回复后框是空的）。nextTick 后
        // 再写，走的是「已挂载后 :value 反应式更新」这条与工具栏插入同源、已验证可用的路径。
        replyExpanded.value = true
        nextTick(() => {
            replyContent.value = '@' + name + ' '
        })
    }

    /** 升起 / 收起半屏浮层（触发条见模板 `.reply-trigger`，浮层见 `.reply-panel`） */
    function onOpenReply() : void {
        replyExpanded.value = true
    }

    function onCollapseReply() : void {
        replyExpanded.value = false
        uni.hideKeyboard()
    }

    // ⑪-3：原 onContentScroll「相对展开锚点下滑 > 60px 自动收起」（来自 #1300）整条删除 ——
    // 浮层带全屏遮罩，面板开着时列表滚不动 ⇒ 那条永不成立，#1300 的真机判据同批作废。

    function onSubmitReply() : void {
        composer.onSubmitReply(topicId.value, (reply : ForumReply) => {
            afterReplyPosted(reply)
            // 发送成功后收起，回到极简触发条（onPosted 仅在提交成功路径触发，见 useReplyComposer）
            replyExpanded.value = false
        })
    }

    function onReportTopicClick() : void {
        const t = topic.value
        if (t == null) return
        report.onReportTopic(t.id)
    }

    function onBack() : void {
        goBack()
    }

    onLoad((options : UTSJSONObject) => {
        const id = options['id']
        if (id != null) {
            topicId.value = parseInt(`${id}`)
        }
        loadDetail()
        // ⑪-4：监听键盘高度（回调给的是 `{ height }` 结果对象），取 height 交去抖 tracker 驱动面板 bottom。
        uni.onKeyboardHeightChange((res) => {
            keyboardTracker(res.height)
        })
    })

    onUnload(() => {
        // 注销键盘监听，避免离开本页后回调仍持有本页 ref。
        uni.offKeyboardHeightChange()
    })
</script>

<style>
    .container {
        display: flex;
        background: linear-gradient(to bottom, #CFE9FB, #D0EBFD);
        background-color: #D0EBFD;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
        align-items: center;
    }

    .header-action-danger {
        font-size: 28rpx;
        color: #ffcdd2;
    }

    .header-action {
        font-size: 26rpx;
        color: #ffffff;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 加载中 */
    .loading-wrap {
        align-items: center;
        padding: 120rpx 0;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    /* 帖子内容区 */
    .topic-section {
        background-color: #ffffff;
        padding: 32rpx;
        margin-bottom: 16rpx;
        flex-direction: column;
    }

    .topic-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
        line-height: 1.5;
        margin-bottom: 24rpx;
    }

    /* 底部回复栏（形态本身在 forum-markdown-input，本页只留外壳与发送按钮） */
    .reply-bar {
        flex-direction: column;
        padding: 12rpx 24rpx;
        background-color: #ffffff;
        border-top: 1rpx solid #eeeeee;
    }

    /* 半屏浮层（⑪-1）：全屏遮罩阻断阅读（列表滚不动）；面板贴键盘上沿（bottom 由 :style 动态给）。
       形状照仓内先例 pages/practice/practice-do.uvue 的 .answer-card-mask / .answer-card-sheet。 */
    .reply-panel-mask {
        position: fixed;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        justify-content: flex-end;
    }

    /* 面板是遮罩的普通 flex 子（**不做 fixed**），靠 mask 的 flex-end 落到底、用 margin-bottom 抬到
       键盘上沿 —— 照 practice-do .answer-card-sheet 的可用形态。旧写法把面板也做成 fixed，会被
       fixed 遮罩在 z 序上盖住 ⇒ 点输入先命中遮罩而收起（①a 真机抓获）。 */
    .reply-panel {
        background-color: #ffffff;
        border-radius: 24rpx 24rpx 0 0;
        padding: 24rpx;
        flex-direction: column;
    }

    .reply-actions {
        flex-direction: row;
        justify-content: flex-end;
        align-items: center;
        margin-top: 8rpx;
    }

    .reply-btn {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        border-radius: 36rpx;
        align-items: center;
        justify-content: center;
    }

    .reply-btn.disabled {
        background-color: #cccccc;
    }

    .reply-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    /* 收起态：极简触发条（复刻输入行的胶囊形态，占位远小于展开态） */
    .reply-trigger {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        height: 72rpx;
        background-color: #f5f5f5;
        border-radius: 36rpx;
        padding: 0 28rpx;
    }

    .reply-trigger-ph {
        font-size: 28rpx;
        color: #999999;
    }

    .reply-trigger-act {
        font-size: 28rpx;
        color: #2979ff;
        font-weight: bold;
    }

    /* 展开态：发送按钮左侧的「收起」 */
    .reply-collapse {
        padding: 16rpx 8rpx;
        margin-right: 24rpx;
        align-items: center;
        justify-content: center;
    }

    .reply-collapse-text {
        font-size: 28rpx;
        color: #666666;
    }
</style>
