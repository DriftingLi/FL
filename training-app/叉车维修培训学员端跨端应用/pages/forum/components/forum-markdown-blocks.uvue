<template>
    <!-- 论坛面的正文壳件（#2356）。块怎么排一律交给四面共用的
         `components/markdown/markdown-blocks.uvue` —— 本文件只剩三件：

         ① **能力位** `FORUM_CAPS`：论坛档声明 heading / list / quote / code / divider 五个块成员 + 段落地板。
            论坛**不持** image / table 两条分支（图文分离：正文内嵌图片与 Web 同口径展开成 alt 文本、图片走
            `images` 数组；表格退回逐行原始文本）—— 这两条由「能力位里没有那一位」表达，不再是
            「本文件没有那条分支」（ADR-0025 P2 + #2356 决议 D3）。
         ② **行内轴** `inline-axis="forum"`：论坛档声明了 `inline`，块内 `text` 存的是**行内源串**，
            必须经格式轴切 runs 再出字（否则 `**粗**` 会原样上屏）。
         ③ **对外接口** 仍是 `:blocks` —— 三个消费方（帖子正文 / 楼层回复 / 发帖预览）一行不改。

         为什么保留这一层而不是让三处直连公共件：三个消费方共用同一个渲染器，壳件让「本面开哪几条分支、
         走哪条行内轴」这**两条本面决策**有唯一的家（与 `pages/courses/components/chapter-markdown.uvue`
         同形），消费方因此不需要各自持有能力位常量。 -->
    <MarkdownBlocks :blocks="blocks" :caps="FORUM_CAPS" inline-axis="forum" @link-click="onRunLink" />
</template>

<script setup lang="uts">
    import type { MarkdownBlock } from '../../../types/index'
    import MarkdownBlocks from '../../../components/markdown/markdown-blocks.uvue'
    import { dispatchExternalLinkTap } from '../../../utils/externalLinkDispatch'

    /**
     * 论坛面的能力位：论坛档声明的五个块成员 + **段落地板**。
     *
     * - 段落为什么在：它从来不在子集声明表里（它是不可关闭的地板），但公共件的 paragraph 分支靠
     *   `cap('paragraph')` 开 —— 不传这一位，正文段落会整段消失。
     * - `inline` 为什么不在：它是**块内文本语义**（决定解析器留不留记号），不是块分支，公共件没有它的
     *   分支位；行内与否由 `inline-axis` 表达（#2356 决议 D3）。
     */
    const FORUM_CAPS : string[] = ['heading', 'paragraph', 'code', 'list', 'quote', 'divider']

    const props = withDefaults(defineProps<{
        blocks? : MarkdownBlock[]
    }>(), {
        blocks: () => [] as MarkdownBlock[]
    })

    /**
     * 句中链接（⑩-8）：公共件只把 url 交回壳层（#2355 决议 D3 的接线定式），确认弹窗与按端分叉
     * 住 `utils/externalLinkDispatch.uts` —— 与 `featured-detail` 的 `onRunLink` 同形。
     */
    function onRunLink(url : string) : void {
        dispatchExternalLinkTap(url)
    }
</script>
