<template>
    <!-- 备考经验筛选行（票 2765 docx P14「标签放右边」）：左「全部帖 / ★精选」、右「默认 / 最多赞 / 最新」合并成一行 -->
    <view class="exp-filter-row">
        <view class="exp-filter-group">
            <view class="exp-chip" :class="{ active: featured === '' }" @click="onFeatured('')">
                <text class="exp-chip-text" :class="{ active: featured === '' }">全部帖</text>
            </view>
            <view class="exp-chip exp-chip-last" :class="{ active: featured === 'true' }" @click="onFeatured('true')">
                <text class="exp-chip-text" :class="{ active: featured === 'true' }">★ 精选</text>
            </view>
        </view>
        <view class="exp-filter-group">
            <view class="exp-chip" :class="{ active: expSort === 'default' }" @click="onSort('default')">
                <text class="exp-chip-text" :class="{ active: expSort === 'default' }">默认</text>
            </view>
            <view class="exp-chip" :class="{ active: expSort === 'hot' }" @click="onSort('hot')">
                <text class="exp-chip-text" :class="{ active: expSort === 'hot' }">最多赞</text>
            </view>
            <view class="exp-chip exp-chip-last" :class="{ active: expSort === 'latest' }" @click="onSort('latest')">
                <text class="exp-chip-text" :class="{ active: expSort === 'latest' }">最新</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    withDefaults(defineProps<{
        featured? : string
        expSort? : string
    }>(), {
        featured: '',
        expSort: 'default'
    })

    const emit = defineEmits(['featuredChange', 'sortChange'])

    function onFeatured(val : string) : void {
        emit('featuredChange', val)
    }

    function onSort(val : string) : void {
        emit('sortChange', val)
    }
</script>

<style lang="scss">
    /* 一行两组：左筛选、右排序（对齐广场 tab 的「左 + 右」模式）。
       5 个 chip 在 26rpx 字号 + 20rpx 内距下合计约 610rpx，可用宽 702rpx */
    .exp-filter-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 4rpx 24rpx 12rpx;
    }

    .exp-filter-group {
        flex-direction: row;
        align-items: center;
    }

    .exp-chip {
        padding: 8rpx 20rpx;
        border-radius: 32rpx;
        background-color: #f0f1f5;
        border: 2rpx solid transparent;
        margin-right: 10rpx;
    }

    .exp-chip-last {
        margin-right: 0;
    }

    .exp-chip.active {
        background-color: #e8f3ff;
        border-color: $primary-color;
    }

    .exp-chip-text {
        font-size: 26rpx;
        color: #666666;
    }

    .exp-chip-text.active {
        color: $primary-color;
        font-weight: bold;
    }
</style>
