    .ask-bar {
        margin: 16rpx 24rpx;
        padding: 20rpx 24rpx;
        background-color: #ffffff;
        border-radius: 16rpx;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }
    .ask-bar-text {
        font-size: 30rpx;
        color: #1a1a1a;
        font-weight: 600;
    }
    .ask-bar-btn {
        width: 52rpx;
        height: 52rpx;
        border-radius: 26rpx;
        background-color: #2979ff;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .ask-bar-btn-icon {
        color: #ffffff;
        font-size: 36rpx;
        line-height: 36rpx;
    }

    /* ===== 知识问答：筛选 chips ===== */
    .qa-filter-bar {
        flex-direction: row;
        align-items: center;
        padding: 4rpx 24rpx 16rpx;
    }

    .qa-chip {
        padding: 10rpx 32rpx;
        border-radius: 32rpx;
        background-color: #f0f1f5;
        border: 2rpx solid transparent;
        margin-right: 20rpx;
    }

    .qa-chip.active {
        background-color: #e8f3ff;
        border-color: #2979ff;
    }

    .qa-chip-text {
        font-size: 26rpx;
        color: #666666;
    }

    .qa-chip-text.active {
        color: #2979ff;
        font-weight: bold;
    }
</style>
