<template>
    <view class="qa-header-wrap">
        <!-- 知识问答：发一个问题 -->
        <view class="ask-bar" @click="onAsk">
            <text class="ask-bar-text">发一个问题</text>
            <view class="ask-bar-btn">
                <text class="ask-bar-btn-icon">+</text>
            </view>
        </view>

        <!-- 知识问答：推荐/最热/最新（推荐为热度 mock，后端暂无推荐算法） -->
        <view class="qa-filter-bar">
            <view class="qa-chip" :class="{ active: qaSort === 'recommend' }" @click="onSort('recommend')">
                <text class="qa-chip-text" :class="{ active: qaSort === 'recommend' }">推荐</text>
            </view>
            <view class="qa-chip" :class="{ active: qaSort === 'hot' }" @click="onSort('hot')">
                <text class="qa-chip-text" :class="{ active: qaSort === 'hot' }">最热</text>
            </view>
            <view class="qa-chip" :class="{ active: qaSort === 'latest' }" @click="onSort('latest')">
                <text class="qa-chip-text" :class="{ active: qaSort === 'latest' }">最新</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    withDefaults(defineProps<{
        qaSort? : string
    }>(), {
        qaSort: 'recommend'
    })

    const emit = defineEmits(['ask', 'sortChange'])

    function onAsk() : void {
        emit('ask')
    }

    function onSort(val : string) : void {
        emit('sortChange', val)
    }
</script>

