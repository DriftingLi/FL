<template>
    <!-- 打卡活动卡片 -->
    <view class="checkin-card" @click="onClick">
        <view class="checkin-card-left">
            <text class="checkin-card-title">8月学习打卡</text>
            <text class="checkin-card-date">2026.08.01</text>
            <text class="checkin-card-players">{{ playersText }}</text>
        </view>
        <view class="checkin-card-btn">
            <text class="checkin-card-btn-text">开始打卡</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import { formatCountCompact } from '../../../utils/format'

    const props = withDefaults(defineProps<{
        players? : number
    }>(), {
        players: 0
    })

    const emit = defineEmits(['click'])

    const playersText = computed<string>(() : string => formatCountCompact(props.players) + '人已参与打卡')

    function onClick() : void {
        emit('click')
    }
</script>

