<template>
    <view class="topic-info">
        <view class="author-avatar" :style="{ backgroundColor: avatarColor }">
            <image v-if="authorAvatar.length > 0" class="author-avatar-img"
                :src="authorAvatar" mode="aspectFill" />
            <text v-else class="author-avatar-text">{{ authorInitial }}</text>
        </view>
        <view class="author-info">
            <text class="author-name">{{ authorName }}</text>
            <view class="author-meta">
                <text class="post-time">{{ createdAtText }}</text>
                <!-- 属地（ADR-0045）：与作者名 / 时间同一行；为空即整段不渲染 -->
                <text v-if="regionText.length > 0" class="post-region">· {{ regionText }}</text>
            </view>
        </view>
        <view class="topic-stats">
            <view :class="liked ? 'stat-like stat-like-liked' : 'stat-like'" @click="onLike">
                <text :class="liked ? 'stat-like-icon stat-like-icon-liked' : 'stat-like-icon'">{{ liked ? '♥' : '♡' }}</text>
                <text :class="liked ? 'stat-like-count stat-like-count-liked' : 'stat-like-count'">{{ likesCount }}</text>
            </view>
            <view :class="favorited ? 'stat-like stat-like-favorited' : 'stat-like'" @click="onFavorite">
                <text :class="favorited ? 'stat-like-icon stat-like-icon-favorited' : 'stat-like-icon'">{{ favorited ? '★' : '☆' }}</text>
                <text :class="favorited ? 'stat-like-count stat-like-count-favorited' : 'stat-like-count'">收藏</text>
            </view>
            <view class="stat-like stat-plain">
                <text class="stat-like-icon">💬</text>
                <text class="stat-like-count">{{ repliesCount }}</text>
            </view>
            <text class="stat-text">👁 {{ viewsCount }}</text>
        </view>
        <view v-if="canDelete" class="topic-delete" @click="onDelete">
            <text class="topic-delete-text">删除</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    // 扁平原始类型 props（全仓先例）；展示文案与权限位由壳层预解析下发
    withDefaults(defineProps<{
        authorName? : string
        authorInitial? : string
        authorAvatar? : string
        avatarColor? : string
        createdAtText? : string
        /** 属地文案（ADR-0045，市优先退省）；空串 = 无属地，不渲染 */
        regionText? : string
        likesCount? : number
        liked? : boolean
        favorited? : boolean
        /** 回复数（只读统计，与卡片侧 💬 对齐；#1071 真机复核裁定 A） */
        repliesCount? : number
        viewsCount? : number
        canDelete? : boolean
    }>(), {
        authorName: '匿名学员',
        authorInitial: '学',
        authorAvatar: '',
        avatarColor: '#2979ff',
        createdAtText: '',
        regionText: '',
        likesCount: 0,
        liked: false,
        favorited: false,
        repliesCount: 0,
        viewsCount: 0,
        canDelete: false
    })

    const emit = defineEmits(['toggleLike', 'toggleFavorite', 'delete'])

    function onLike() : void {
        emit('toggleLike')
    }

    function onFavorite() : void {
        emit('toggleFavorite')
    }

    function onDelete() : void {
        emit('delete')
    }
</script>

<style>
    .topic-info {
        flex-direction: row;
        align-items: center;
        margin-bottom: 24rpx;
        padding-bottom: 24rpx;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .author-avatar {
        width: 64rpx;
        height: 64rpx;
        border-radius: 32rpx;
        background-color: #2979ff;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .author-avatar-text {
        font-size: 28rpx;
        color: #ffffff;
        font-weight: bold;
    }

    .author-avatar-img {
        width: 64rpx;
        height: 64rpx;
        border-radius: 32rpx;
    }

    .author-info {
        flex: 1;
        flex-direction: column;
    }

    .author-name {
        font-size: 28rpx;
        color: #333333;
        font-weight: bold;
        margin-bottom: 4rpx;
    }

    .post-time {
        font-size: 22rpx;
        color: #999999;
    }

    /* 作者行第二行：时间 + 属地同一行（ADR-0045，属地空则不渲染） */
    .author-meta {
        flex-direction: row;
        align-items: center;
    }

    .post-region {
        font-size: 22rpx;
        color: #999999;
        margin-left: 8rpx;
    }

    .topic-stats {
        flex-direction: row;
        align-items: center;
    }

    .stat-like {
        flex-direction: row;
        align-items: center;
        margin-right: 16rpx;
        padding: 8rpx 16rpx;
        border-radius: 24rpx;
        background-color: #f5f5f5;
        border: 1px solid #eeeeee;
    }

    .stat-like-liked {
        background-color: #f44336;
        border: 1px solid #f44336;
    }

    .stat-like-favorited {
        background-color: #ff8f00;
        border: 1px solid #ff8f00;
    }

    .stat-like-icon {
        font-size: 28rpx;
        margin-right: 6rpx;
        color: #999999;
    }

    .stat-like-icon-liked {
        color: #ffffff;
    }

    .stat-like-icon-favorited {
        color: #ffffff;
    }

    .stat-like-count {
        font-size: 24rpx;
        color: #999999;
    }

    .stat-like-count-liked {
        color: #ffffff;
        font-weight: bold;
    }

    .stat-like-count-favorited {
        color: #ffffff;
        font-weight: bold;
    }

    /* 只读统计项（回复数）：与 👁 浏览量同属「只读数字」，故去掉 .stat-like 的胶囊底/边框/内边距，
       只留图标+数字的横向排布 —— 与卡片侧 💬/👁 的只读统计口径一致（#1071 真机复核裁定 A）。
       注意 uvue 只支持 class 选择器、且本文件无 `gap`，故间距沿用 .stat-like 的 margin-right。 */
    .stat-plain {
        padding: 0;
        background-color: transparent;
        border-width: 0;
    }

    .stat-text {
        font-size: 24rpx;
        color: #999999;
    }

    /* 删除帖子按钮（贴主可见，位于卡片头部右上角） */
    .topic-delete {
        padding: 8rpx 0 8rpx 20rpx;
    }

    .topic-delete-text {
        font-size: 24rpx;
        color: #f44336;
    }
</style>
