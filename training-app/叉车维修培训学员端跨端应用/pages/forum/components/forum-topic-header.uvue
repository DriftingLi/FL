<template>
    <view class="topic-info">
        <view class="author-avatar" :style="{ backgroundColor: avatarColor }">
            <image v-if="authorAvatar.length > 0" class="author-avatar-img"
                :src="authorAvatar" mode="aspectFill" :webp="true" />
            <image v-else class="author-avatar-img" src="/static/icons/avatar/avatar-default-worker.png" mode="aspectFill" />
        </view>
        <view class="author-info">
            <text class="author-name">{{ authorName }}</text>
            <view class="author-meta">
                <text class="post-time">{{ createdAtText }}</text>
                <!-- 属地（ADR-0045）：与作者名 / 时间同一行；为空即整段不渲染 -->
                <text v-if="regionText.length > 0" class="post-region">· {{ regionText }}</text>
            </view>
        </view>
        <text class="stat-text">👁 {{ viewsCount }}</text>
        <view v-if="canDelete" class="topic-delete" @click="onDelete">
            <text class="topic-delete-text">删除</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    // 扁平原始类型 props（全仓先例）；展示文案与权限位由壳层预解析下发
    // 2026-11-19（#2690）：点赞 / 收藏 / 回复数已移到正文下方互动行，作者行只留身份与浏览数
    withDefaults(defineProps<{
        authorName? : string
        authorAvatar? : string
        avatarColor? : string
        createdAtText? : string
        /** 属地文案（ADR-0045，市优先退省）；空串 = 无属地，不渲染 */
        regionText? : string
        viewsCount? : number
        canDelete? : boolean
    }>(), {
        authorName: '匿名学员',
        authorAvatar: '',
        avatarColor: '#239EDD',
        createdAtText: '',
        regionText: '',
        viewsCount: 0,
        canDelete: false
    })

    const emit = defineEmits(['delete'])

    function onDelete() : void {
        emit('delete')
    }
</script>

<style lang="scss">
    .topic-info {
        flex-direction: row;
        align-items: center;
        margin-bottom: 24rpx;
        padding-bottom: 24rpx;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .author-avatar {
        width: 64rpx;
        height: 64rpx;
        border-radius: 32rpx;
        background-color: $primary-color;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .author-avatar-img {
        width: 64rpx;
        height: 64rpx;
        border-radius: 32rpx;
    }

    .author-info {
        flex: 1;
        flex-direction: column;
    }

    .author-name {
        font-size: 28rpx;
        color: #333333;
        font-weight: bold;
        margin-bottom: 4rpx;
    }

    .post-time {
        font-size: 22rpx;
        color: #999999;
    }

    .author-meta {
        flex-direction: row;
        align-items: center;
    }

    .post-region {
        font-size: 22rpx;
        color: #999999;
        margin-left: 8rpx;
    }

    .stat-text {
        font-size: 24rpx;
        color: #999999;
    }

    .topic-delete {
        padding: 8rpx 0 8rpx 20rpx;
    }

    .topic-delete-text {
        font-size: 24rpx;
        color: #f44336;
    }
</style>
