<template>
    <!-- 顶部Tab栏 -->
    <!-- 票 2730 docx ⑤⑨：下划线宽度跟 tab 文字走（原画在等宽 tab 容器上 ⇒「广场」与「知识问答」下划线一样宽） -->
    <view class="tab-bar">
        <view class="tab-item" :class="{ active: currentTab === 'square' }" @click="onSwitch('square')">
            <view class="tab-inner">
                <text class="tab-text">广场</text>
                <view class="tab-underline"></view>
            </view>
        </view>
        <view class="tab-item" :class="{ active: currentTab === 'resource' }" @click="onSwitch('resource')">
            <view class="tab-inner">
                <text class="tab-text">资源</text>
                <view class="tab-underline"></view>
            </view>
        </view>
        <view class="tab-item" :class="{ active: currentTab === 'hot' }" @click="onSwitch('hot')">
            <view class="tab-inner">
                <text class="tab-text">知识问答</text>
                <view class="tab-underline"></view>
            </view>
        </view>
        <view class="tab-item" :class="{ active: currentTab === 'experience' }" @click="onSwitch('experience')">
            <view class="tab-inner">
                <text class="tab-text">备考经验</text>
                <view class="tab-underline"></view>
            </view>
        </view>
        <view class="tab-icon-btn" @click="onAvatarClick">
            <image v-if="avatarUrl.length > 0" class="tab-avatar" :src="avatarUrl" mode="aspectFill" :webp="true" />
            <image v-else class="tab-avatar" src="/static/icons/avatar/avatar-default-worker.png" mode="aspectFill" />
        </view>
    </view>
</template>

<script setup lang="uts">
    withDefaults(defineProps<{
        currentTab? : string
        avatarUrl? : string
    }>(), {
        currentTab: 'square',
        avatarUrl: ''
    })

    const emit = defineEmits(['switchTab', 'personalActivity'])

    function onSwitch(tab : string) : void {
        emit('switchTab', tab)
    }

    function onAvatarClick() : void {
        emit('personalActivity')
    }
</script>

<style lang="scss">
    /* 顶部Tab栏 */
    .tab-bar {
        flex-direction: row;
        background-color: transparent;
        border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
        align-items: center;
    }

    .tab-item {
        flex: 1;
        height: 88rpx;
        align-items: center;
        justify-content: center;
    }

    /* 由文字撑开的列容器：下划线 width:100% 即「该 tab 文字宽」 */
    .tab-inner {
        flex-direction: column;
        align-items: center;
    }

    .tab-underline {
        width: 100%;
        height: 4rpx;
        border-radius: 2rpx;
        margin-top: 6rpx;
        background-color: transparent;
    }

    .tab-item.active .tab-underline {
        background-color: $primary-color;
    }

    .tab-text {
        font-size: 30rpx;
        color: #666666;
    }

    .tab-item.active .tab-text {
        color: $text-strong;
        font-weight: bold;
    }

    /* Tab栏右侧图标按钮 */
    /* 票 2730 第 1 项：命中区宽 80→88rpx；头像 56rpx 不变。 */
    .tab-icon-btn {
        width: 88rpx;
        height: 88rpx;
        align-items: center;
        justify-content: center;
        margin-left: 8rpx;
    }

    .tab-avatar {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        border: 2rpx solid #eeeeee;
    }

</style>
