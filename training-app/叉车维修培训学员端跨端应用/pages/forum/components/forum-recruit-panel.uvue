<template>
    <view class="recruit-panel">
        <!-- 招聘子Tab：公告 / 职位 -->
        <view class="recruit-sub-bar">
            <view class="recruit-sub-item" @click="onRecruitSubChange('notice')">
                <text class="recruit-sub-text" :class="{ active: recruitSubTab === 'notice' }">公告</text>
            </view>
            <view class="recruit-sub-item" @click="onRecruitSubChange('job')">
                <text class="recruit-sub-text" :class="{ active: recruitSubTab === 'job' }">职位</text>
            </view>
        </view>

        <!-- 招聘职位 Tab 内容（专属卡片） -->
        <scroll-view v-if="recruitSubTab == 'job'" class="content-scroll" scroll-y="true">
            <view v-if="mockJobs.length == 0" class="empty-tip">
                <text class="empty-icon">💼</text>
                <text class="empty-text">暂无职位信息</text>
            </view>
            <view class="job-list">
                <view v-for="job in mockJobs" :key="job.id" class="job-card">
                    <view class="job-card-header">
                        <text class="job-company">{{ job.company }}</text>
                        <view class="job-type-tag">
                            <text class="job-type-text">{{ job.jobType }}</text>
                        </view>
                    </view>
                    <text class="job-title">{{ job.title }}</text>
                    <view class="job-info-row">
                        <text class="job-salary">{{ job.salary }}</text>
                        <text class="job-location">📍 {{ job.location }}</text>
                    </view>
                    <text class="job-desc">{{ job.description }}</text>
                    <view class="job-divider"></view>
                    <view class="job-actions">
                        <view class="job-action-btn job-action-detail" @click="onJobDetail(job.id)">
                            <text class="job-action-text job-action-detail-text">查看详情</text>
                        </view>
                        <view class="job-action-btn job-action-apply" @click="onJobApply(job.id)">
                            <text class="job-action-text job-action-apply-text">立即投递</text>
                        </view>
                    </view>
                </view>
            </view>
        </scroll-view>

        <!-- 招聘公告 Tab 内容 -->
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <view class="empty-tip">
                <text class="empty-icon">📢</text>
                <text class="empty-text">暂无公告</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { useRecruitFeed } from '../../../composables/useRecruitFeed'

    // 招聘区数据自持（数据所有权单一：谁消费谁持有；#705 招聘退场时整组件摘除）
    const { mockJobs, recruitSubTab, onRecruitSubChange, onJobDetail, onJobApply } = useRecruitFeed()
</script>

