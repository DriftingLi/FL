<template>
    <view class="topic-card" @click="onCardClick">
        <view class="topic-title-row">
            <text class="topic-title">{{ title }}</text>
            <view v-if="variant === 'qa'" class="status-badge" :class="{ 'status-resolved': status === 'resolved' }">
                <text class="status-badge-text" :class="{ 'status-badge-text-resolved': status === 'resolved' }">{{ statusText }}</text>
            </view>
        </view>
        <text class="topic-content-preview">{{ contentPreview }}</text>
        <view v-if="images.length > 0" class="topic-images">
            <view v-for="(img, i) in firstImages" :key="i" class="topic-image-cell">
                <image class="topic-image" :src="imgUrl(img)" mode="aspectFill" />
            </view>
            <view v-if="images.length > 3" class="topic-image-cell">
                <image class="topic-image" :src="moreImageUrl" mode="aspectFill" />
                <view class="topic-image-more">
                    <text class="topic-image-more-text">+{{ moreCount }}</text>
                </view>
            </view>
        </view>
        <!-- 知识问答底部：左作者（头像+昵称/日期） 右浏览/评论/点赞，单行布局 -->
        <view v-if="variant === 'qa'" class="qa-footer">
            <view class="qa-author">
                <view class="author-avatar" :style="{ backgroundColor: avatarColor }">
                    <image v-if="authorAvatar.length > 0" class="author-avatar-img" :src="authorAvatarUrl" mode="aspectFill" />
                    <text v-else class="author-avatar-text">{{ authorInitial }}</text>
                </view>
                <view class="qa-author-text">
                    <text class="author-name">{{ displayName }}</text>
                    <text class="qa-date">{{ dateText }}</text>
                </view>
            </view>
            <view class="qa-stats">
                <view class="qa-stat">
                    <text class="qa-stat-icon">👁</text>
                    <text class="qa-stat-text">{{ viewsText }}</text>
                </view>
                <view class="qa-stat" @click.stop="onReplyClick">
                    <text class="qa-stat-icon">💬</text>
                    <text class="qa-stat-text">{{ repliesText }}</text>
                </view>
                <view class="qa-stat">
                    <text class="qa-stat-icon">👍</text>
                    <text class="qa-stat-text">{{ likesText }}</text>
                </view>
            </view>
        </view>
        <template v-else>
        <!-- 作者行：头像 + 昵称 + 时间 -->
        <view class="topic-author-row">
            <view class="author-avatar" :style="{ backgroundColor: avatarColor }">
                <image v-if="authorAvatar.length > 0" class="author-avatar-img" :src="authorAvatarUrl" mode="aspectFill" />
                <text v-else class="author-avatar-text">{{ authorInitial }}</text>
            </view>
            <text class="author-name">{{ displayName }}</text>
            <text class="topic-time">{{ dateText }}</text>
        </view>
        <!-- 操作栏：点赞数（只读） + 评论 + 浏览；点赞/收藏仅详情页支持 -->
        <view class="topic-action-bar">
            <view class="action-item">
                <text class="action-icon">👍</text>
                <text class="action-text">{{ likesText }}</text>
            </view>
            <view class="action-item" @click.stop="onReplyClick">
                <text class="action-icon"></text>
                <text class="action-text">{{ repliesText }}</text>
            </view>
            <view class="action-item">
                <text class="action-icon"></text>
                <text class="action-text">{{ viewsText }}</text>
            </view>
        </view>
        </template>
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import {
        getContentPreview,
        getFirstImages,
        resolveFileUrl,
        getAuthorInitial,
        getAvatarColor,
        formatDateStr,
        formatCountCompact,
    } from '../../../utils/forumDisplay'

    // 扁平原始类型 props 下发（全仓先例：可选对象 prop 成员直读 Kotlin error18）
    const props = withDefaults(defineProps<{
        topicId? : number
        title? : string
        content? : string
        images? : string[]
        authorId? : number
        authorName? : string
        authorAvatar? : string
        createdAt? : string
        viewsCount? : number
        repliesCount? : number
        likesCount? : number
        variant? : string // 'square' | 'qa'
        status? : string // resolved | open（#736）
    }>(), {
        topicId: 0,
        title: '',
        content: '',
        images: () => [] as string[],
        authorId: 0,
        authorName: '',
        authorAvatar: '',
        createdAt: '',
        viewsCount: 0,
        repliesCount: 0,
        likesCount: 0,
        variant: 'square',
        status: 'open'
    })

    const emit = defineEmits(['click', 'reply'])

    const contentPreview = computed<string>(() : string => getContentPreview(props.content))
    const firstImages = computed<string[]>(() : string[] => getFirstImages(props.images))
    const moreImageUrl = computed<string>(() : string => props.images.length > 3 ? resolveFileUrl(props.images[3]) : '')
    const moreCount = computed<number>(() : number => props.images.length > 3 ? props.images.length - 3 : 0)
    const displayName = computed<string>(() : string => props.authorName.length > 0 ? props.authorName : '匿名学员')
    const authorInitial = computed<string>(() : string => getAuthorInitial(props.authorName))
    const avatarColor = computed<string>(() : string => getAvatarColor(props.authorId))
    const dateText = computed<string>(() : string => formatDateStr(props.createdAt))
    const authorAvatarUrl = computed<string>(() : string => resolveFileUrl(props.authorAvatar))
    const viewsText = computed<string>(() : string => formatCountCompact(props.viewsCount))
    const repliesText = computed<string>(() : string => formatCountCompact(props.repliesCount))
    const likesText = computed<string>(() : string => formatCountCompact(props.likesCount))
    /** 状态徽章文本（#740，两态按父票 #707 裁定，标签与 web 一致） */
    const statusText = computed<string>(() : string => props.status === 'resolved' ? '已解决' : '求助')

    function imgUrl(url : string) : string {
        return resolveFileUrl(url)
    }

    function onCardClick() : void {
        emit('click', props.topicId)
    }

    function onReplyClick() : void {
        emit('reply', props.topicId)
    }
</script>

<style>
    .topic-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        border: 1px solid #eeeeee;
        flex-direction: column;
    }

    .topic-title-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 12rpx;
    }

    .topic-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
        line-height: 1.4;
        flex: 1;
    }

    /* 状态徽章（#736 #739）：open=蓝，resolved=绿 */
    .status-badge {
        margin-left: 12rpx;
        padding: 4rpx 16rpx;
        border-radius: 16rpx;
        background-color: #e3f2fd;
        flex-shrink: 0;
    }

    .status-badge.status-resolved {
        background-color: #e8f5e9;
    }

    .status-badge-text {
        font-size: 20rpx;
        color: #2196f3;
        font-weight: 500;
    }

    .status-badge-text.status-badge-text-resolved {
        color: #4caf50;
    }

    .topic-content-preview {
        font-size: 26rpx;
        color: #666666;
        line-height: 1.5;
        margin-bottom: 16rpx;
    }

    /* 列表图片缩略图 */
    .topic-images {
        flex-direction: row;
        margin-bottom: 16rpx;
    }

    .topic-image-cell {
        width: 160rpx;
        height: 160rpx;
        margin-right: 12rpx;
        border-radius: 12rpx;
        overflow: hidden;
        position: relative;
    }

    .topic-image {
        width: 160rpx;
        height: 160rpx;
        border-radius: 12rpx;
        background-color: #f0f0f0;
    }

    .topic-image-more {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        align-items: center;
        justify-content: center;
    }

    .topic-image-more-text {
        font-size: 36rpx;
        color: #ffffff;
        font-weight: bold;
    }

    /* 作者行 */
    .topic-author-row {
        flex-direction: row;
        align-items: center;
        padding-top: 12rpx;
        border-top: 1rpx solid #f5f5f5;
        margin-top: 12rpx;
    }

    .author-avatar {
        width: 44rpx;
        height: 44rpx;
        border-radius: 22rpx;
        background-color: #2979ff;
        align-items: center;
        justify-content: center;
        margin-right: 12rpx;
    }

    .author-avatar-text {
        font-size: 22rpx;
        color: #ffffff;
        font-weight: bold;
    }

    .author-avatar-img {
        width: 44rpx;
        height: 44rpx;
        border-radius: 22rpx;
    }

    .author-name {
        flex: 1;
        font-size: 24rpx;
        color: #666666;
    }

    .topic-time {
        font-size: 22rpx;
        color: #cccccc;
    }

    /* 操作栏 */
    .topic-action-bar {
        flex-direction: row;
        align-items: center;
        justify-content: space-around;
        padding: 16rpx 0 0;
    }

    .action-item {
        flex-direction: row;
        align-items: center;
        padding: 8rpx 16rpx;
        border-radius: 24rpx;
        margin-right: 8rpx;
    }

    .action-icon {
        font-size: 28rpx;
        margin-right: 6rpx;
        color: #999999;
    }

    .action-text {
        font-size: 24rpx;
        color: #999999;
    }

    /* 问答变体 footer */
    .qa-footer {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 8rpx;
    }

    .qa-author {
        flex-direction: row;
        align-items: center;
        flex: 1;
    }

    .qa-author-text {
        flex-direction: column;
        margin-left: 12rpx;
    }

    .qa-date {
        font-size: 22rpx;
        color: #bbbbbb;
        margin-top: 4rpx;
    }

    .qa-stats {
        flex-direction: row;
        align-items: center;
    }

    .qa-stat {
        flex-direction: row;
        align-items: center;
        margin-left: 28rpx;
    }

    .qa-stat-icon {
        font-size: 26rpx;
        margin-right: 6rpx;
    }

    .qa-stat-text {
        font-size: 24rpx;
        color: #999999;
    }
</style>
