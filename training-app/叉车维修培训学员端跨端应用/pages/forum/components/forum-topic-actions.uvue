<template>
    <view class="topic-actions">
        <view :class="liked ? 'stat-like stat-like-liked' : 'stat-like'" @click="onLike">
            <text :class="liked ? 'stat-like-icon stat-like-icon-liked' : 'stat-like-icon'">{{ liked ? '♥' : '♡' }}</text>
            <text :class="liked ? 'stat-like-count stat-like-count-liked' : 'stat-like-count'">{{ likesCount }}</text>
        </view>
        <view :class="favorited ? 'stat-like stat-like-favorited' : 'stat-like'" @click="onFavorite">
            <text :class="favorited ? 'stat-like-icon stat-like-icon-favorited' : 'stat-like-icon'">{{ favorited ? '★' : '☆' }}</text>
            <text :class="favorited ? 'stat-like-count stat-like-count-favorited' : 'stat-like-count'">收藏</text>
        </view>
        <view class="stat-like stat-plain">
            <text class="stat-like-icon">💬</text>
            <text class="stat-like-count">{{ repliesCount }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
/**
 * 帖子互动行（2026-11-19 #2690）：点赞 / 收藏 / 回复数从作者行下移到正文下方。
 * 浏览数留在作者行（forum-topic-header），这里不重复计数。
 */
withDefaults(defineProps<{
    likesCount?: number
    liked?: boolean
    favorited?: boolean
    repliesCount?: number
}>(), {
    likesCount: 0,
    liked: false,
    favorited: false,
    repliesCount: 0,
})

const emit = defineEmits(['toggleLike', 'toggleFavorite'])

function onLike() : void {
    emit('toggleLike')
}

function onFavorite() : void {
    emit('toggleFavorite')
}
</script>

<style lang="scss">
    .topic-actions {
        flex-direction: row;
        align-items: center;
        margin-top: 24rpx;
    }

    .stat-like {
        flex-direction: row;
        align-items: center;
        margin-right: 16rpx;
        padding: 8rpx 16rpx;
        border-radius: 24rpx;
        background-color: #f5f5f5;
        border: 1px solid #eeeeee;
    }

    .stat-like-liked {
        background-color: #f44336;
        border: 1px solid #f44336;
    }

    .stat-like-favorited {
        background-color: #ff8f00;
        border: 1px solid #ff8f00;
    }

    .stat-like-icon {
        font-size: 28rpx;
        color: #999999;
        margin-right: 6rpx;
    }

    .stat-like-icon-liked {
        color: #ffffff;
    }

    .stat-like-icon-favorited {
        color: #ffffff;
    }

    .stat-like-count {
        font-size: 24rpx;
        color: #999999;
    }

    .stat-like-count-liked {
        color: #ffffff;
        font-weight: bold;
    }

    .stat-like-count-favorited {
        color: #ffffff;
        font-weight: bold;
    }

    /* uvue 只支持 class 选择器，本文件无 gap：只读项间距沿用 .stat-like 的 margin-right */
    .stat-plain {
        padding: 0;
        background-color: transparent;
        border-width: 0;
    }
</style>
