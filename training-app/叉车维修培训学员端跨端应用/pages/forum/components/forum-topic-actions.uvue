<template>
    <!-- 统计行（票 2767）：浏览 / 评论 / 点赞 + 文字标签，位于正文下方、作者行之后。
         点赞仍可点（唯一可交互项）；收藏已移入标题行右侧「···」菜单，本组件不再持有。 -->
    <view class="topic-stats">
        <view class="stat-item">
            <image class="stat-icon" src="/static/icons/forum/view.png" mode="aspectFit"></image>
            <text class="stat-text">{{ viewsCount }} 浏览</text>
        </view>
        <view class="stat-item">
            <image class="stat-icon" src="/static/icons/forum/comment.png" mode="aspectFit"></image>
            <text class="stat-text">{{ repliesCount }} 评论</text>
        </view>
        <view class="stat-item" @click="onLike">
            <image class="stat-icon" src="/static/icons/forum/like.png" mode="aspectFit"></image>
            <text :class="liked ? 'stat-text stat-text-liked' : 'stat-text'">{{ likesCount }} 点赞</text>
        </view>
    </view>
</template>

<script setup lang="uts">
/**
 * 帖子统计行（票 2767）：浏览 / 评论 / 点赞三项单行，顺序与列表卡底部一致。
 * 2026-11-19（#2690）起本行在正文下方；2026-11-22（票 2767）由「点赞/收藏/回复数」三块
 * 改为「浏览/评论/点赞 + 文字标签」，收藏移入标题行右侧「···」菜单。
 */
withDefaults(defineProps<{
    viewsCount?: number
    repliesCount?: number
    likesCount?: number
    liked?: boolean
}>(), {
    viewsCount: 0,
    repliesCount: 0,
    likesCount: 0,
    liked: false,
})

const emit = defineEmits(['toggleLike'])

function onLike() : void {
    emit('toggleLike')
}
</script>

<style lang="scss">
    .topic-stats {
        flex-direction: row;
        align-items: center;
        margin-top: 24rpx;
        padding-top: 20rpx;
        border-top: 1rpx solid $border-color-light;
    }

    .stat-item {
        flex-direction: row;
        align-items: center;
        margin-right: 40rpx;
        min-height: 44rpx;
    }

    .stat-icon {
        width: 26rpx;
        height: 26rpx;
        margin-right: 8rpx;
    }

    .stat-text {
        font-size: 24rpx;
        color: $text-color-placeholder;
    }

    /* 已点赞：文字转主色加粗（图标只有一份切图，不做双态换图） */
    .stat-text-liked {
        color: $primary-color;
        font-weight: bold;
    }
</style>
