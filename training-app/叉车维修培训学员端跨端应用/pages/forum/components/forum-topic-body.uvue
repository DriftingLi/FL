<template>
    <view class="topic-content">
        <!-- 纯文本档（`text`）：直出原串 —— 后端存的就是纯文本，没有可解析的语义（ADR-0025 决策②/⑧） -->
        <text v-if="!isMarkdown" class="content-text">{{ content }}</text>
        <!-- Markdown 档：按**论坛子集**解析后的块；渲染分支在 forum-markdown-blocks，本组件不持 -->
        <ForumMarkdownBlocks v-else :blocks="blocks" />
        <!-- 单图（#2690）：原比例不裁切，宽占满正文区；浅底 16:9 起高缓解加载后下跳 -->
        <view v-if="imageUrls.length == 1" class="img-single" @click="onPreview(0)">
            <image class="img-single-thumb" :src="imageUrls[0]" mode="widthFix" :webp="true" />
        </view>
        <!-- 多图（#2690）：3 列 1:1 裁切，点开进原图预览（起始索引 = 点击位） -->
        <view v-else-if="imageUrls.length > 1" class="img-grid">
            <view v-for="(img, idx) in imageUrls" :key="idx" class="img-cell"
                @click="onPreview(idx)">
                <image class="img-thumb" :src="img" mode="aspectFill" :webp="true" />
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import { previewImages } from '../../../utils/forumDetailDisplay'
    import { forumContentBlocks, isMarkdownFormat } from '../../../utils/forumBody'
    import ForumMarkdownBlocks from './forum-markdown-blocks.uvue'
    import type { MarkdownBlock } from '../../../types/index'

    // imageUrls 由壳层预解析（resolveFileUrl 幂等，预览传已解析列表与原行为一致）
    const props = withDefaults(defineProps<{
        content? : string
        /** 正文格式：`content_format` 归一后的取值（`markdown` / `text`）；缺省 = 不解析（与 DTO 归一同向） */
        format? : string
        imageUrls? : string[]
    }>(), {
        content: '',
        format: '',
        imageUrls: () => [] as string[]
    })

    /** 渲染档位的二选一闸门：看**格式声明**，不看块数组长度（空正文的 Markdown 帖不该变成「没正文」） */
    const isMarkdown = computed<boolean>(() : boolean => isMarkdownFormat(props.format))

    /** 论坛子集的渲染块：格式 → 档位的唯一点在 `utils/forumBody`（真执行守护见 forumBodyBehavior） */
    const blocks = computed<MarkdownBlock[]>(() : MarkdownBlock[] => forumContentBlocks(props.content, props.format))

    function onPreview(index : number) : void {
        previewImages(props.imageUrls, index)
    }
</script>

<style>
    .topic-content {
        flex-direction: column;
    }

    .content-text {
        font-size: 30rpx;
        color: #333333;
        line-height: 1.8;
    }

    /* 图片墙（帖子/回复展示） */
    /* 单图（#2690）：widthFix 原比例；壳层浅底 16:9 起高，缓解加载后的一次下跳 */
    .img-single {
        margin-top: 24rpx;
        border-radius: 12rpx;
        background-color: #f0f0f0;
        min-height: 386rpx;
    }

    .img-single-thumb {
        width: 100%;
        border-radius: 12rpx;
    }

    /* 多图（#2690）：3 列 1:1 —— 单元格 210rpx + 16rpx 间距 ×3 = 678rpx，正文区宽 686rpx */
    .img-grid {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 24rpx;
    }

    .img-cell {
        width: 210rpx;
        height: 210rpx;
        margin-right: 16rpx;
        margin-bottom: 16rpx;
    }

    .img-thumb {
        width: 210rpx;
        height: 210rpx;
        border-radius: 12rpx;
        background-color: #f0f0f0;
    }
</style>
