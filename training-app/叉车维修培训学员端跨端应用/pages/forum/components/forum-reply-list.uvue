<template>
    <view class="replies-section">
        <view class="replies-header">
            <text class="replies-title">全部回复（{{ countText }}）</text>
            <view class="replies-sort-bar">
                <view class="reply-sort-chip" :class="{ active: sortField === 'latest' }" @click="onField('latest')">
                    <text class="reply-sort-text" :class="{ active: sortField === 'latest' }">最新</text>
                </view>
                <view class="reply-sort-chip" :class="{ active: sortField === 'hot' }" @click="onField('hot')">
                    <text class="reply-sort-text" :class="{ active: sortField === 'hot' }">热门</text>
                </view>
                <view class="reply-sort-chip" :class="{ active: sortOrder === 'desc' }" @click="onOrder('desc')">
                    <text class="reply-sort-text" :class="{ active: sortOrder === 'desc' }">逆序</text>
                </view>
                <view class="reply-sort-chip" :class="{ active: sortOrder === 'asc' }" @click="onOrder('asc')">
                    <text class="reply-sort-text" :class="{ active: sortOrder === 'asc' }">正序</text>
                </view>
            </view>
        </view>

        <view v-if="items.length == 0" class="empty-replies">
            <text class="empty-replies-text">暂无回复，来说两句吧</text>
        </view>

        <view v-for="(item, idx) in items" :key="idx" class="reply-card">
            <view class="reply-header">
                <view class="reply-avatar" :style="{ backgroundColor: item.avatarColor }">
                    <image v-if="item.authorAvatar.length > 0" class="reply-avatar-img"
                        :src="item.authorAvatar" mode="aspectFill" />
                    <text v-else class="reply-avatar-text">{{ item.authorInitial }}</text>
                </view>
                <view class="reply-info">
                    <text
                        class="reply-author">{{ item.authorName }}</text>
                    <!-- 已采纳徽章 -->
                    <text v-if="item.isAccepted" class="reply-accepted-badge">✓ 已采纳</text>
                    <text class="reply-time">{{ item.createdAtText }}</text>
                </view>
                <view v-if="item.canDelete" class="reply-delete" @click="onDelete(item.id)">
                    <text class="reply-delete-text">删除</text>
                </view>
                <view v-else class="reply-more" @click="onReport(item.id)">
                    <text class="reply-more-text">举报</text>
                </view>
            </view>
            <!-- 正文：纯文本档直出原串；Markdown 档走**论坛子集**解析后的块（ADR-0025 P2）——
                 样式与图墙保持原状，只有 Markdown 档多出一层块渲染 -->
            <text v-if="!isMarkdownReply(item)" class="reply-content">{{ item.content }}</text>
            <view v-else class="reply-md-body">
                <ForumMarkdownBlocks :blocks="replyBlocks(item)" />
            </view>
            <view v-if="item.imageUrls.length > 0" class="img-grid">
                <view v-for="(img, i) in item.imageUrls" :key="i" class="img-cell small"
                    @click="onPreview(item, i)">
                    <image class="img-thumb" :src="img" mode="aspectFill" />
                </view>
            </view>
            <!-- 采纳按钮（问答帖 + 楼主 + 非自己回复 + 未采纳）；判定已由壳层下发，模板零求值 -->
            <view v-if="item.canAcceptReply" class="reply-accept-row">
                <view class="reply-accept-btn" @click="onAccept(item.id)">
                    <text class="reply-accept-btn-text">采纳此回答</text>
                </view>
            </view>
            <!-- 取消采纳按钮（楼主 + 已采纳；已采纳帖必为问答帖，见迁移 000026 的 CHECK） -->
            <view v-else-if="isTopicOwner && item.isAccepted" class="reply-accept-row">
                <view class="reply-cancel-accept-btn" @click="onCancelAccept">
                    <text class="reply-cancel-accept-btn-text">取消采纳</text>
                </view>
            </view>
            <view class="reply-action-row">
                <view class="reply-action-left">
                    <text class="reply-action-time">{{ item.createdAtText }}</text>
                    <!-- 属地（ADR-0045）：接在相对时间之后（「18 小时前 · 上海」）。
                         为空即整段不渲染 —— 连分隔符也不出现（历史回复看起来与今天一样）。 -->
                    <text v-if="item.regionText.length > 0" class="reply-region">· {{ item.regionText }}</text>
                </view>
                <view class="reply-action-right">
                    <view :class="item.liked ? 'reply-like reply-like-liked' : 'reply-like'" @click="onLike(item.id)">
                        <text :class="item.liked ? 'reply-like-icon reply-like-icon-liked' : 'reply-like-icon'">{{ item.liked ? '♥' : '♡' }}</text>
                        <text :class="item.liked ? 'reply-like-count reply-like-count-liked' : 'reply-like-count'">{{ item.likesCount }}</text>
                    </view>
                    <view class="reply-action-btn" @click="onReplyTo(item.id)">
                        <text class="reply-action-text"> 回复</text>
                    </view>
                </view>
            </view>
        </view>

        <!-- 加载更多（ADR-0042 分页）：入口只在还有下一页时渲染，点击**追加**下一页而非替换；
             到底显示结束态，否则用户会把「按钮消失」读成加载失败。 -->
        <view v-if="items.length > 0 && hasMore" class="replies-more">
            <view class="replies-more-btn" @click="onLoadMore">
                <text class="replies-more-text">{{ loadMoreText }}</text>
            </view>
        </view>
        <view v-else-if="items.length > 0" class="replies-end">
            <text class="replies-end-text">没有更多回复了</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { computed } from 'vue'
    import { previewImages } from '../../../utils/forumDetailDisplay'
    import type { ForumReplyDisplay } from '../../../utils/forumDetailDisplay'
    import { forumContentBlocks, isMarkdownFormat } from '../../../utils/forumBody'
    import ForumMarkdownBlocks from './forum-markdown-blocks.uvue'
    import type { MarkdownBlock } from '../../../types/index'

    // 展示模型数组由壳层映射（扁平下发：权限位/点赞态/URL 预解析全部完成于壳层）
    const props = withDefaults(defineProps<{
        items? : ForumReplyDisplay[]
        sortField? : string
        sortOrder? : string
        /** 保留供「取消采纳」判定；「采纳」判定改由 item.canAcceptReply 下发（#816 后续） */
        isTopicOwner? : boolean
        /** 是否还有未加载的回复页（ADR-0042 分页）：false ⇒ 加载更多入口消失 */
        hasMore? : boolean
        /** 加载更多进行中（入口文案 + 防重复点击） */
        loadingMore? : boolean
        /** 回复总条数（分页后 items.length 只是**已加载**条数，标题计数须读 total） */
        totalCount? : number
        /** 尚未加载的回复条数（入口文案上的剩余量） */
        remaining? : number
    }>(), {
        items: () => [] as ForumReplyDisplay[],
        sortField: 'latest',
        sortOrder: 'asc',
        isTopicOwner: false,
        hasMore: false,
        loadingMore: false,
        totalCount: 0,
        remaining: 0,
    })

    const emit = defineEmits(['sortFieldChange', 'sortOrderChange', 'deleteReply', 'reportReply', 'toggleReplyLike', 'replyToUser', 'acceptReply', 'cancelAccept', 'loadMore'])

    /** 标题计数：优先 total（分页后已加载条数 ≠ 总条数），total 未知时退回已加载条数 */
    const countText = computed<string>(() : string => props.totalCount > 0 ? props.totalCount.toString() : props.items.length.toString())

    /** 加载更多入口文案（模板零拼接：格式化收在脚本层，uvue 模板表达式能力有限） */
    const loadMoreText = computed<string>(() : string => props.loadingMore ? '加载中...' : '加载更多回复（剩余 ' + props.remaining.toString() + ' 条）')

    function onLoadMore() : void {
        emit('loadMore')
    }

    function onField(field : string) : void {
        emit('sortFieldChange', field)
    }

    function onOrder(order : string) : void {
        emit('sortOrderChange', order)
    }

    function onDelete(id : number) : void {
        emit('deleteReply', id)
    }

    function onReport(id : number) : void {
        emit('reportReply', id)
    }

    function onLike(id : number) : void {
        emit('toggleReplyLike', id)
    }

    function onReplyTo(id : number) : void {
        emit('replyToUser', id)
    }

    function onAccept(id : number) : void {
        emit('acceptReply', id)
    }

    function onCancelAccept() : void {
        emit('cancelAccept')
    }

    /**
     * 回复正文的渲染档位（ADR-0025 P2）：本地薄包装，uvue 模板禁直调 import 函数（error18 先例）。
     * 判据与帖子正文同源 —— 格式 → 档位的唯一点在 `utils/forumBody`（真执行守护见 forumBodyBehavior）。
     */
    function isMarkdownReply(item : ForumReplyDisplay) : boolean {
        return isMarkdownFormat(item.contentFormat)
    }

    function replyBlocks(item : ForumReplyDisplay) : MarkdownBlock[] {
        return forumContentBlocks(item.content, item.contentFormat)
    }

    function onPreview(item : ForumReplyDisplay, index : number) : void {
        previewImages(item.imageUrls, index)
    }
</script>

<style>
    /* 回复列表 */
    .replies-section {
        background-color: #ffffff;
        padding: 32rpx;
        flex-direction: column;
    }

    .replies-header {
        padding-bottom: 24rpx;
        border-bottom: 1rpx solid #f0f0f0;
        margin-bottom: 16rpx;
        flex-direction: column;
    }

    .replies-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 16rpx;
    }

    .replies-sort-bar {
        flex-direction: row;
        align-items: center;
        flex-wrap: wrap;
    }

    .reply-sort-chip {
        padding: 6rpx 20rpx;
        border-radius: 20rpx;
        background-color: #f5f5f5;
        border: 1rpx solid #e0e0e0;
        margin-right: 12rpx;
        margin-bottom: 4rpx;
    }

    .reply-sort-chip.active {
        background-color: #e8f0fe;
        border: 1rpx solid #2979ff;
    }

    .reply-sort-text {
        font-size: 22rpx;
        color: #666666;
    }

    .reply-sort-text.active {
        color: #2979ff;
        font-weight: bold;
    }

    .empty-replies {
        align-items: center;
        padding: 60rpx 0;
    }

    .empty-replies-text {
        font-size: 26rpx;
        color: #999999;
    }

    .reply-card {
        flex-direction: column;
        padding: 24rpx 0;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .reply-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 12rpx;
    }

    .reply-avatar {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: #4caf50;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .reply-avatar-text {
        font-size: 24rpx;
        color: #ffffff;
        font-weight: bold;
    }

    .reply-avatar-img {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
    }

    .reply-info {
        flex: 1;
        flex-direction: column;
    }

    .reply-author {
        font-size: 26rpx;
        color: #333333;
        font-weight: bold;
        margin-bottom: 4rpx;
    }

    .reply-time {
        font-size: 22rpx;
        color: #999999;
    }

    .reply-delete {
        padding: 8rpx 16rpx;
    }

    .reply-delete-text {
        font-size: 24rpx;
        color: #f44336;
    }

    .reply-content {
        font-size: 28rpx;
        color: #333333;
        line-height: 1.6;
        padding-left: 72rpx;
    }

    /* Markdown 档回复的块渲染容器：与 .reply-content 同缩进（署名行对齐），块样式由组件自持 */
    .reply-md-body {
        padding-left: 72rpx;
    }

    /* 图片墙（帖子/回复展示） */
    .img-grid {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 24rpx;
    }

    .img-cell {
        width: 200rpx;
        height: 200rpx;
        margin-right: 16rpx;
        margin-bottom: 16rpx;
    }

    .img-cell.small {
        width: 160rpx;
        height: 160rpx;
    }

    .img-thumb {
        width: 200rpx;
        height: 200rpx;
        border-radius: 12rpx;
        background-color: #f0f0f0;
    }

    .img-cell.small .img-thumb {
        width: 160rpx;
        height: 160rpx;
    }

    .reply-more {
        padding: 8rpx 16rpx;
    }

    .reply-more-text {
        font-size: 24rpx;
        color: #999999;
    }

    /* 回复操作行 */
    .reply-action-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding-left: 72rpx;
        margin-top: 12rpx;
    }

    .reply-action-time {
        font-size: 22rpx;
        color: #cccccc;
    }

    /* 署名行左侧：相对时间 + 属地（ADR-0045，属地单独成节，空则不渲染） */
    .reply-action-left {
        flex-direction: row;
        align-items: center;
    }

    .reply-region {
        font-size: 22rpx;
        color: #cccccc;
        margin-left: 8rpx;
    }

    .reply-action-btn {
        padding: 6rpx 16rpx;
    }

    .reply-action-text {
        font-size: 24rpx;
        color: #2979ff;
    }

    .reply-action-right {
        flex-direction: row;
        align-items: center;
    }

    .reply-like {
        flex-direction: row;
        align-items: center;
        padding: 6rpx 16rpx;
        border-radius: 24rpx;
        background-color: #f5f5f5;
        border: 1px solid #eeeeee;
        margin-right: 12rpx;
    }

    .reply-like-liked {
        background-color: #f44336;
        border: 1px solid #f44336;
    }

    .reply-like-icon {
        font-size: 26rpx;
        color: #999999;
        margin-right: 6rpx;
    }

    .reply-like-icon-liked {
        color: #ffffff;
    }

    .reply-like-count {
        font-size: 22rpx;
        color: #999999;
    }

    .reply-like-count-liked {
        color: #ffffff;
        font-weight: bold;
    }

    /* 采纳徽章 */
    .reply-accepted-badge {
        font-size: 20rpx;
        color: #4caf50;
        background-color: #e8f5e9;
        padding: 2rpx 12rpx;
        border-radius: 12rpx;
        margin-left: 12rpx;
        font-weight: bold;
    }

    /* 采纳按钮行 */
    .reply-accept-row {
        padding-left: 72rpx;
        margin-top: 12rpx;
    }

    .reply-accept-btn {
        background-color: #e8f5e9;
        padding: 8rpx 24rpx;
        border-radius: 24rpx;
        border: 1rpx solid #4caf50;
        align-items: center;
        justify-content: center;
        flex-direction: row;
    }

    .reply-accept-btn-text {
        font-size: 24rpx;
        color: #4caf50;
        font-weight: bold;
    }

    .reply-cancel-accept-btn {
        background-color: #f5f5f5;
        padding: 8rpx 24rpx;
        border-radius: 24rpx;
        border: 1rpx solid #cccccc;
        align-items: center;
        justify-content: center;
        flex-direction: row;
    }

    .reply-cancel-accept-btn-text {
        font-size: 24rpx;
        color: #666666;
    }

    /* 加载更多 / 到底（ADR-0042 分页） */
    .replies-more {
        align-items: center;
        padding: 24rpx 0 8rpx;
    }

    .replies-more-btn {
        background-color: #e8f0fe;
        border: 1rpx solid #2979ff;
        border-radius: 32rpx;
        padding: 14rpx 40rpx;
        align-items: center;
        justify-content: center;
    }

    .replies-more-text {
        font-size: 26rpx;
        color: #2979ff;
        font-weight: bold;
    }

    .replies-end {
        align-items: center;
        padding: 24rpx 0 8rpx;
    }

    .replies-end-text {
        font-size: 24rpx;
        color: #999999;
    }
</style>
