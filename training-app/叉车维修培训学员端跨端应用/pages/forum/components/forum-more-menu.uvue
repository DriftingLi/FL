<template>
    <!-- 「···」菜单（票 2767；#2771 收编页头动作）：收藏 / 删除 / 编辑 / 举报。
         触发按钮在详情页标题行右侧（导航栏右槽是小程序胶囊区，不放内容）；
         本件只渲染遮罩与浮层，展开态与浮层顶边自持，宿主经 expose 的 open() 唤起。 -->
    <view class="more-root">
        <view v-if="visible" class="more-mask" @click="onClose"></view>
        <view v-if="visible" class="more-menu" :style="{ top: menuTop + 'px' }">
            <view class="more-item" @click="onToggleFavorite">
                <text :class="favorited ? 'more-item-text more-item-text-favorited' : 'more-item-text'">{{ favorited ? '取消收藏' : '收藏' }}</text>
            </view>
            <!-- 三态互斥与页头旧工具栏逐字同源（#2771）：作者见删除，其余见举报 -->
            <view v-if="canDelete" class="more-item" @click="onDelete">
                <text class="more-item-text more-item-text-danger">删除</text>
            </view>
            <view v-if="canEdit && !canDelete" class="more-item" @click="onEdit">
                <text class="more-item-text">编辑</text>
            </view>
            <view v-if="!canDelete && !canEdit" class="more-item" @click="onReport">
                <text class="more-item-text">举报</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { computed, ref } from 'vue'
    import { useSafeArea } from '../../../utils/system'

    withDefaults(defineProps<{
        /** 当前帖子是否已收藏（决定菜单项文案与强调色） */
        favorited? : boolean
        /** 可删除（作者本人或后端 can_delete）：菜单出「删除」 */
        canDelete? : boolean
        /** 可编辑（作者本人）：菜单出「编辑」 */
        canEdit? : boolean
    }>(), {
        favorited: false,
        canDelete: false,
        canEdit: false
    })

    const emit = defineEmits(['toggleFavorite', 'deleteTopic', 'editTopic', 'reportTopic'])

    const visible = ref<boolean>(false)
    const safeArea = useSafeArea()
    const windowWidth = uni.getSystemInfoSync().windowWidth
    /**
     * 浮层顶边 = 状态栏 + 页头标题行 88rpx + 内容区上内距 32rpx + 标题行触发按钮高度 56rpx，
     * 与 app-nav-bar 同源换算（#2771 起页头只剩标题行，工具栏整行删除）。
     */
    const menuTop = computed<number>(() : number => {
        return safeArea.value.statusBarHeight + Math.round(176 * windowWidth / 750)
    })

    function open() : void {
        visible.value = true
    }

    function onClose() : void {
        visible.value = false
    }

    function onToggleFavorite() : void {
        visible.value = false
        emit('toggleFavorite')
    }

    function onDelete() : void {
        visible.value = false
        emit('deleteTopic')
    }

    function onEdit() : void {
        visible.value = false
        emit('editTopic')
    }

    function onReport() : void {
        visible.value = false
        emit('reportTopic')
    }

    defineExpose({ open })
</script>

<style lang="scss">
    /* 零尺寸锚点：两个子节点都是 fixed，不参与页面布局 */
    .more-root {
        width: 0;
        height: 0;
    }

    /* 全屏透明遮罩：点空白处收起 */
    .more-mask {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 90;
    }

    /* #2771：单条目不再撑出大块白卡 —— 最小宽 220 → 176rpx，行高仍守 88rpx（44px 触摸目标） */
    .more-menu {
        position: fixed;
        right: 32rpx;
        z-index: 91;
        min-width: 176rpx;
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 8rpx 0;
        box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
    }

    .more-item {
        padding: 24rpx 28rpx;
        align-items: center;
    }

    .more-item-text {
        font-size: 26rpx;
        color: #333333;
    }

    /* 已收藏：沿用收藏橙（§1.6 白名单 #FF8F00 的承载点，自 forum-topic-actions 迁来） */
    .more-item-text-favorited {
        color: #ff8f00;
        font-weight: bold;
    }

    /* 删除：白卡上走危险色 token（原页头蓝底用 #FFCDD2 浅红，随工具栏一并退役） */
    .more-item-text-danger {
        color: $danger-color;
    }
</style>
