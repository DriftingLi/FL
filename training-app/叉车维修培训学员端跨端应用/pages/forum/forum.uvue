<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left">
                <view class="msg-icon-wrap" @click="onMsgClick">
                    <text class="msg-icon">✉️</text>
                    <view v-if="unreadCount > 0" class="msg-badge">
                        <text class="msg-badge-text">{{ unreadCount > 99 ? '99+' : unreadCount.toString() }}</text>
                    </view>
                </view>
            </view>
            <text class="header-title">学员论坛</text>
            <view class="header-right" @click="onCreate">
                <text class="header-action" @click="onCreate">发帖</text>
            </view>
        </view>
        <ForumTabBar :current-tab="currentTab" :avatar-url="avatarUrl" @switch-tab="onSwitchTab" @personal-activity="onPersonalActivity" />
        <!-- 搜索栏 -->
        <view class="res-search-bar" @click="onCreate">
            <view class="res-search-input-wrap">
                <text class="res-search-placeholder">写下你此刻的想法</text>
                <text class="res-search-icon">🔍</text>
            </view>
        </view>
        <!-- 精选筛选（#742 批次三）：三 Tab 通用轴，资源 Tab 不显示 -->
        <ForumFeaturedFilter v-if="currentTab === 'square' || currentTab === 'hot' || currentTab === 'experience'" :featured="featuredFilter" @featured-change="onFeaturedChange" />
        <!-- 排序栏（广场 Tab 显示） -->
        <ForumSquareSortBar v-if="currentTab === 'square'" :sort-field="sortField" :sort-order="sortOrder"
            @field-change="onSortFieldChange" @order-change="onSortOrderChange" />
        <!-- 知识问答：发一个问题 + 筛选（问答 Tab 显示） -->
        <ForumQaHeader v-if="currentTab === 'hot'" :qa-sort="qaSort" :qa-status="qaStatus" @ask="onCreate" @sort-change="onQaSortChange" @status-change="onQaStatusChange" />
        <!-- 备考经验：默认/最多赞/最新 chips（#706） -->
        <ForumExperienceSortBar v-if="currentTab === 'experience'" :exp-sort="expSort" @sort-change="onExpSortChange" />

        <!-- 广场/知识问答/备考经验 Tab 内容 -->
        <scroll-view v-if="currentTab == 'square' || currentTab == 'hot' || currentTab == 'experience'" class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <ForumCheckinCard v-if="currentTab === 'square'" :players="checkinPlayers" @click="onCheckInClick" />
            <view v-if="topics.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon"></text>
                <text class="empty-text">{{ emptyText }}</text>
                <view v-if="currentTab !== 'experience'" class="empty-btn" @click="onCreate">
                    <text class="empty-btn-text">发布新帖</text>
                </view>
            </view>
            <view class="topic-list">
                <ForumTopicCard v-for="(item, idx) in topics" :key="idx"
                    :topic-id="item.id" :title="item.title" :content="item.content" :images="item.images"
                    :author-id="item.author_id" :author-name="item.author_name" :author-avatar="item.author_avatar"
                    :created-at="item.created_at" :views-count="item.views_count" :replies-count="item.replies_count"
                    :likes-count="item.likes_count" :variant="currentTab === 'hot' ? 'qa' : 'square'"
                    :status="item.status" :is-featured="item.is_featured"
                    :is-experience="item.is_experience"
                    @click="onTopicClick" @reply="onReply" />
            </view>
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && topics.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>

        <!-- 资源 Tab 内容 -->
        <ForumResourcePanel v-if="currentTab === 'resource'" />

        <!-- 悬浮发帖按钮（非资源Tab时显示） -->
        <view v-if="currentTab === 'square'" class="fab-btn" @click="onCreate">
            <text class="fab-icon">+</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import ForumTabBar from './components/forum-tab-bar.uvue'
    import ForumSquareSortBar from './components/forum-square-sort-bar.uvue'
    import ForumQaHeader from './components/forum-qa-header.uvue'
    import ForumExperienceSortBar from './components/forum-experience-sort-bar.uvue'
    import ForumFeaturedFilter from './components/forum-featured-filter.uvue'
    import ForumCheckinCard from './components/forum-checkin-card.uvue'
    import ForumTopicCard from './components/forum-topic-card.uvue'
    import ForumResourcePanel from './components/forum-resource-panel.uvue'
    import { useTopicFeed } from '../../composables/useTopicFeed'
    import { useAuthStore } from '../../stores/auth'
    import { useStatusBarHeight } from '../../utils/system'
    import { getCheckInCalendarApi } from '../../api/checkin'
    import { getUnreadCountApi } from '../../api/notification'

    const authStore = useAuthStore()
    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- tab 态（壳层唯一持有的视图状态）----
    const currentTab = ref<string>('square') // square | resource | hot | experience

    // ---- 帖子流（列表域下沉 useTopicFeed）----
    const {
        topics, loading, noMore, sortField, sortOrder, qaSort, qaStatus, expSort, featuredFilter,
        loadTopics, onLoadMore, onSortFieldChange, onSortOrderChange, onQaSortChange, onQaStatusChange, onExpSortChange, onFeaturedChange,
    } = useTopicFeed(currentTab)

    const unreadCount = ref<number>(0)

    // ---- 用户头像 ----
    const avatarUrl = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })

    // ---- 打卡相关 ----
    const checkinPlayers = ref<number>(0)

    async function loadCheckInStatus() : Promise<void> {
        try {
            const now = new Date()
            const result = await getCheckInCalendarApi(now.getFullYear(), now.getMonth() + 1)
            // 统计已签到人数（简化：用连续签到天数近似参与热度）
            checkinPlayers.value = result.days.length > 0 ? result.streak * 3 + 7 : 10
        } catch (e) {
            checkinPlayers.value = 10
        }
    }

    function onCheckInClick() : void {
        uni.navigateTo({ url: '/pages/forum/check-in' })
    }

    // 空态文案（ADR-0040）：备考经验 tab 是管理端认定的只读策展流，不引导发布（对齐 Web）
    const emptyText = computed<string>(() : string => currentTab.value === 'experience' ? '还没有备考经验帖' : '还没有帖子，来发第一帖吧')

    function onSwitchTab(tab : string) : void {
        if (currentTab.value === tab) return
        currentTab.value = tab
        // 精选筛选跨 Tab 不延续（#742 批次三，对齐 Web）：切 Tab 回到全部帖
        featuredFilter.value = ''
        if (tab === 'resource') {
            // 资源区数据由 ForumResourcePanel 挂载时自拉
            return
        }
        loadTopics(true)
    }

    function onPersonalActivity() : void {
        // 招聘 tab 已退场（#705），头像统一进个人动态；简历入口重挂留 #705 后续
        uni.navigateTo({ url: '/pages/profile/personal-activity' })
    }

    function onTopicClick(topicId : number) : void {
        uni.navigateTo({ url: '/pages/forum/forum-detail?id=' + topicId })
    }

    function onReply(topicId : number) : void {
        uni.navigateTo({ url: '/pages/forum/forum-detail?id=' + topicId })
    }

    function onCreate() : void {
        // 统一发布页（#760）：资源 tab 走 forum-create?scope=resource（该页资源模式承载投稿表单，
        // 发帖接口永不收到 resource 类别）；其余 tab 只传后端合法类别
        if (currentTab.value === 'resource') {
            uni.navigateTo({ url: '/pages/forum/forum-create?scope=resource' })
            return
        }
        // 发布口只传学员可自述的意图（ADR-0040，后端只认 discussion/question）：
        // square 归 discussion，hot 归 question；经验 tab 是只读策展流，同样落 discussion
        let scope = 'discussion'
        if (currentTab.value === 'hot') {
            scope = 'question'
        }
        uni.navigateTo({ url: '/pages/forum/forum-create?scope=' + scope })
    }

    // ===== 消息通知 =====

    /** 点击消息图标 → 跳转通知页 */
    function onMsgClick() : void {
        uni.navigateTo({ url: '/pages/notifications/notifications' })
    }

    /** 加载未读数（角标） */
    async function loadUnreadCount() : Promise<void> {
        try {
            unreadCount.value = await getUnreadCountApi()
        } catch (e) {
            console.error('[forum] loadUnreadCount failed:', e)
        }
    }

    onShow(() => {
        loadUnreadCount()
        loadCheckInStatus()
        if (currentTab.value !== 'resource') {
            loadTopics(true)
        }
    })
</script>

<style>
    .container {
        display: flex;
        background: linear-gradient(180deg, #CFE9FB 1%, #D0EBFD 16%, #F5F5F5 100%);
        flex-direction: column;
    }

    .status-bar {
        background-color: transparent;
    }

    .header {
        background-color: transparent;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 100rpx;
        align-items: center;
        justify-content: center;
    }

    /* 消息图标 */
    .msg-icon-wrap {
        position: relative;
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
    }

    .msg-icon {
        font-size: 40rpx;
    }

    /* 未读角标 */
    .msg-badge {
        position: absolute;
        top: -4rpx;
        right: -8rpx;
        min-width: 32rpx;
        height: 32rpx;
        border-radius: 16rpx;
        background-color: #ff3b30;
        align-items: center;
        justify-content: center;
        padding: 0 8rpx;
    }

    .msg-badge-text {
        font-size: 20rpx;
        color: #ffffff;
        font-weight: bold;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
        text-align: center;
    }

    .header-right {
        /* 固定宽度避免被 flex:1 的标题挤压消失 */
        width: 120rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: rgba(41, 121, 255, 0.12);
        align-items: center;
        justify-content: center;
    }

    .header-action {
        font-size: 28rpx;
        color: #2979ff;
        font-weight: bold;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 搜索栏 */
    .res-search-bar {
        background-color: transparent;
        padding: 16rpx 32rpx 20rpx;
    }

    .res-search-input-wrap {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        background-color: #ffffff;
        border-radius: 36rpx;
        padding: 16rpx 24rpx;
    }

    .res-search-icon {
        font-size: 28rpx;
        color: #999999;
    }

    .res-search-placeholder {
        font-size: 28rpx;
        color: #999999;
        flex: 1;
    }

    /* 帖子列表 */
    .topic-list {
        flex-direction: column;
        padding: 16rpx 24rpx;
    }

    /* 空状态 */
    .empty-tip {
        align-items: center;
        padding: 120rpx 0 80rpx;
        flex-direction: column;
    }

    .empty-icon {
        font-size: 96rpx;
        margin-bottom: 24rpx;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
        margin-bottom: 32rpx;
    }

    .empty-btn {
        background-color: #2979ff;
        padding: 16rpx 48rpx;
        border-radius: 32rpx;
    }

    .empty-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    /* 加载更多 */
    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    /* 悬浮发帖按钮（避开底部 tab-bar） */
    .fab-btn {
        position: fixed;
        right: 32rpx;
        bottom: 180rpx;
        width: 96rpx;
        height: 96rpx;
        border-radius: 48rpx;
        background-color: #2979ff;
        align-items: center;
        justify-content: center;
        box-shadow: 0rpx 4rpx 8rpx rgba(0, 0, 0, 0.3);
    }

    .fab-icon {
        font-size: 56rpx;
        color: #ffffff;
        font-weight: bold;
    }
</style>
