<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="验收历史" @left-click="onBack" />

        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="loading" class="state-tip">
                <text class="state-text">加载中...</text>
            </view>

            <view v-if="!loading && failed" class="state-tip" @click="onRetry">
                <text class="state-icon">📡</text>
                <text class="state-text">验收历史加载失败，点此重试</text>
            </view>

            <view v-if="!loading && !failed && items.length == 0" class="state-tip">
                <text class="state-icon">🗂</text>
                <text class="state-text">还没有提交过验收</text>
            </view>

            <view v-for="it in items" :key="it.id" class="history-card" @click="onOpenTask(it.id)">
                <view class="history-head">
                    <text class="history-title">{{ it.title }}</text>
                    <text class="history-status"
                        :class="{ 'history-status-fail': it.status == 'rejected' }">{{ statusText(it.status) }}</text>
                </view>
                <text class="history-code">{{ it.code }} · {{ it.course_name }}</text>
                <text class="history-result">自检结论：{{ resultText(it.result) }}</text>
                <view class="history-foot">
                    <text class="history-meta">{{ it.item_count }} 项 · 异常 {{ it.failed_count }} 项</text>
                    <text class="history-time">{{ it.submitted_at }}</text>
                </view>
            </view>

            <view class="bottom-gap"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { goBack } from '../../utils/navigation'
    import { useAcceptanceHistory } from './composables/useAcceptanceHistory'

    const windowHeight = uni.getSystemInfoSync().windowHeight

    const { items, loading, failed, load, onOpenTask, statusText, resultText } = useAcceptanceHistory()

    function onBack() : void {
        goBack()
    }

    function onRetry() : void {
        load()
    }

    onShow(() => {
        load()
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        flex-direction: column;
        background-color: $bg-color;
    }

    .content-scroll {
        flex: 1;
    }

    .state-tip {
        align-items: center;
        padding: 80rpx 24rpx;
    }

    .state-icon {
        font-size: 64rpx;
        margin-bottom: 16rpx;
    }

    .state-text {
        font-size: 28rpx;
        color: $text-color-secondary;
        text-align: center;
    }

    .history-card {
        background-color: $card-bg;
        border-radius: $radius-card;
        margin: 20rpx 24rpx 0 24rpx;
        padding: 24rpx;
    }

    .history-head {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .history-title {
        flex: 1;
        font-size: 30rpx;
        font-weight: bold;
        color: $text-color;
        margin-right: 16rpx;
    }

    .history-status {
        font-size: 24rpx;
        color: $success-color;
    }

    .history-status-fail {
        color: $danger-color;
    }

    .history-code {
        font-size: 24rpx;
        color: $text-color-placeholder;
        margin-top: 8rpx;
    }

    .history-result {
        font-size: 24rpx;
        color: $text-color-secondary;
        margin-top: 10rpx;
    }

    .history-foot {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 14rpx;
    }

    .history-meta {
        font-size: 24rpx;
        color: $text-color-secondary;
    }

    .history-time {
        font-size: 24rpx;
        color: $text-color-placeholder;
    }

    .bottom-gap {
        height: 40rpx;
    }
</style>
