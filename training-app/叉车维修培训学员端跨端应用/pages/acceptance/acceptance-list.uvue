        height: 88rpx;
        padding: 0 28rpx;
        border-radius: $radius-pill;
        background-color: $card-bg;
        align-items: center;
        justify-content: center;
    }

    .history-entry-text {
        font-size: 26rpx;
        color: $primary-color;
    }

    .filter-bar {
        flex-direction: row;
        padding: 0 24rpx 8rpx 24rpx;
        flex-shrink: 0;
    }

    .filter-item {
        height: 88rpx;
        padding: 0 24rpx;
        border-radius: $radius-pill;
        background-color: $card-bg;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .filter-item-active {
        background-color: $primary-color;
    }

    .filter-text {
        font-size: 26rpx;
        color: $text-color-secondary;
    }

    .filter-text-active {
        color: #FFFFFF;
    }

    .content-scroll {
        flex: 1;
    }

    .state-tip {
        align-items: center;
        padding: 80rpx 24rpx;
    }

    .state-icon {
        font-size: 64rpx;
        margin-bottom: 16rpx;
    }

    .state-text {
        font-size: 28rpx;
        color: $text-color-secondary;
        text-align: center;
    }

    .task-card {
        background-color: $card-bg;
        border-radius: $radius-card;
        margin: 20rpx 24rpx 0 24rpx;
        padding: 24rpx;
    }

    .task-head {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .task-title {
        flex: 1;
        font-size: 30rpx;
        font-weight: bold;
        color: $text-color;
        margin-right: 16rpx;
    }

    .task-status {
        font-size: 24rpx;
        color: $primary-color;
    }

    .task-code {
        font-size: 24rpx;
        color: $text-color-placeholder;
        margin-top: 8rpx;
    }

    .task-course {
        font-size: 26rpx;
        color: $text-color-secondary;
        margin-top: 12rpx;
    }

    .task-foot {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 18rpx;
    }

    .task-meta {
        font-size: 24rpx;
        color: $text-color-secondary;
    }

    .task-deadline {
        font-size: 24rpx;
        color: $text-color-placeholder;
    }

    .bottom-gap {
        height: 40rpx;
    }
</style>
