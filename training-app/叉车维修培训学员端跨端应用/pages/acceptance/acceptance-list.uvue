<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="验收中心" @left-click="onBack" />

        <view class="top-bar">
            <text class="top-count">{{ countLabel }}</text>
            <view class="history-entry" @click="onOpenHistory">
                <text class="history-entry-text">验收历史</text>
            </view>
        </view>

        <view class="filter-bar">
            <view v-for="f in filterOptions" :key="f.value" class="filter-item"
                :class="{ 'filter-item-active': filter == f.value }" @click="onChangeFilter(f.value)">
                <text class="filter-text" :class="{ 'filter-text-active': filter == f.value }">{{ f.label }}</text>
            </view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="loading" class="state-tip">
                <text class="state-text">加载中...</text>
            </view>

            <view v-if="!loading && failed" class="state-tip" @click="onRetry">
                <text class="state-icon">📡</text>
                <text class="state-text">验收列表加载失败，点此重试</text>
            </view>

            <view v-if="!loading && !failed && tasks.length == 0" class="state-tip">
                <text class="state-icon">✅</text>
                <text class="state-text">{{ emptyText }}</text>
            </view>

            <view v-for="t in tasks" :key="t.id" class="task-card" @click="onOpenTask(t.id)">
                <view class="task-head">
                    <text class="task-title">{{ t.title }}</text>
                    <text class="task-status">{{ statusText(t.status) }}</text>
                </view>
                <text class="task-code">{{ t.code }}</text>
                <text class="task-course">{{ t.course_name }} · {{ t.instructor }}</text>
                <view class="task-foot">
                    <text class="task-meta">{{ t.item_count }} 个验收项</text>
                    <text class="task-deadline">截止 {{ t.deadline }}</text>
                </view>
            </view>

            <view class="bottom-gap"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { goBack } from '../../utils/navigation'
    import { useAcceptanceList } from './composables/useAcceptanceList'

    const windowHeight = uni.getSystemInfoSync().windowHeight

    const {
        tasks, loading, failed, filter, filterOptions, countLabel, emptyText,
        load, onChangeFilter, onOpenTask, onOpenHistory, statusText,
    } = useAcceptanceList()

    function onBack() : void {
        goBack()
    }

    function onRetry() : void {
        load()
    }

    onShow(() => {
        load()
    })
</script>

<style lang="scss">
