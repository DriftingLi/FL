        color: $danger-color;
    }

    .bottom-gap {
        height: 24rpx;
    }

    .action-bar {
        padding: 16rpx 24rpx;
        background-color: $card-bg;
        flex-shrink: 0;
    }

    .action-btn {
        height: 88rpx;
        border-radius: $radius-pill;
        background-color: $primary-color;
        align-items: center;
        justify-content: center;
    }

    .action-btn-disabled {
        background-color: $text-disabled;
    }

    .action-btn-text {
        font-size: 30rpx;
        font-weight: bold;
        color: #FFFFFF;
    }
</style>
