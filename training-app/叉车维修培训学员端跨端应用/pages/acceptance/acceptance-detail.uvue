        color: $text-color-secondary;
        text-align: center;
    }

    .head-card {
        background-color: $card-bg;
        border-radius: $radius-card;
        margin: 20rpx 24rpx 0 24rpx;
        padding: 24rpx;
    }

    .head-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .head-row-gap {
        margin-top: 16rpx;
    }

    .head-title {
        flex: 1;
        font-size: 32rpx;
        font-weight: bold;
        color: $text-color;
        margin-right: 16rpx;
    }

    .head-status {
        font-size: 24rpx;
        color: $primary-color;
    }

    .head-code {
        font-size: 24rpx;
        color: $text-color-placeholder;
        margin-top: 8rpx;
    }

    .head-course {
        font-size: 26rpx;
        color: $text-color-secondary;
        margin-top: 12rpx;
    }

    .head-meta {
        font-size: 24rpx;
        color: $text-color-secondary;
    }

    .head-result {
        font-size: 26rpx;
        color: $primary-color;
        margin-top: 16rpx;
    }

    .head-remark {
        font-size: 24rpx;
        color: $text-color;
        margin-top: 8rpx;
    }

    .head-submitted {
        font-size: 24rpx;
        color: $text-color-placeholder;
        margin-top: 8rpx;
    }

    .item-card {
        background-color: $card-bg;
        border-radius: $radius-card;
        margin: 20rpx 24rpx 0 24rpx;
        padding: 24rpx;
    }

    .item-head {
        flex-direction: row;
        align-items: center;
    }

    .item-index {
        width: 40rpx;
        height: 40rpx;
        border-radius: 20rpx;
        background-color: $primary-color;
        align-items: center;
        justify-content: center;
        margin-right: 12rpx;
    }

    .item-index-text {
        font-size: 22rpx;
        color: #FFFFFF;
        text-align: center;
    }

    .item-name {
        flex: 1;
        font-size: 28rpx;
        font-weight: bold;
        color: $text-color;
        margin-right: 16rpx;
    }

    .item-result {
        font-size: 24rpx;
        color: $success-color;
    }

    .item-result-fail {
        color: $danger-color;
    }

    .item-requirement {
        font-size: 24rpx;
        color: $text-color-secondary;
        margin-top: 12rpx;
    }

    .item-remark {
        font-size: 24rpx;
        color: $text-color;
        margin-top: 8rpx;
    }

    .item-proofs {
        font-size: 24rpx;
        color: $text-color-placeholder;
        margin-top: 8rpx;
    }

    .bottom-gap {
        height: 24rpx;
    }

    .action-bar {
        padding: 16rpx 24rpx;
        background-color: $card-bg;
        flex-shrink: 0;
    }

    .action-btn {
        height: 88rpx;
        border-radius: $radius-pill;
        background-color: $primary-color;
        align-items: center;
        justify-content: center;
    }

    .action-btn-text {
        font-size: 30rpx;
        font-weight: bold;
        color: #FFFFFF;
    }
</style>
