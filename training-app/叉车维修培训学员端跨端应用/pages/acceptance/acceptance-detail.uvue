<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="验收详情" @left-click="onBack" />

        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="loading" class="state-tip">
                <text class="state-text">加载中...</text>
            </view>

            <view v-if="!loading && failed" class="state-tip" @click="reload">
                <text class="state-icon">📡</text>
                <text class="state-text">验收详情加载失败，点此重试</text>
            </view>

            <view v-if="!loading && !failed && !hasDetail" class="state-tip">
                <text class="state-text">验收单不存在</text>
            </view>

            <view v-if="!loading && !failed && hasDetail" class="body">
                <view class="head-card">
                    <view class="head-row">
                        <text class="head-title">{{ title }}</text>
                        <text class="head-status">{{ statusLabel }}</text>
                    </view>
                    <text class="head-code">{{ code }}</text>
                    <text class="head-course">{{ courseLine }}</text>
                    <view class="head-row head-row-gap">
                        <text class="head-meta">{{ deadlineText }}</text>
                        <text class="head-meta">{{ progressLabel }}</text>
                    </view>
                    <text v-if="resultLabel.length > 0" class="head-result">{{ resultLabel }}</text>
                    <text v-if="overallRemark.length > 0" class="head-remark">整体备注：{{ overallRemark }}</text>
                    <text v-if="submittedLabel.length > 0" class="head-submitted">{{ submittedLabel }}</text>
                </view>

                <view v-for="(item, idx) in items" :key="item.id" class="item-card">
                    <view class="item-head">
                        <view class="item-index">
                            <text class="item-index-text">{{ idx + 1 }}</text>
                        </view>
                        <text class="item-name">{{ item.name }}</text>
                        <text class="item-result"
                            :class="{ 'item-result-fail': item.result == 'fail' || item.result == 'rectify' }">{{ itemResultLabel(item.result) }}</text>
                    </view>
                    <text class="item-requirement">要求：{{ item.requirement }}</text>
                    <text v-if="item.remark.length > 0" class="item-remark">备注：{{ item.remark }}</text>
                    <text v-if="item.proofs.length > 0" class="item-proofs">凭证 {{ item.proofs.length }} 份</text>
                </view>

                <view class="bottom-gap"></view>
            </view>
        </scroll-view>

        <view v-if="!loading && !failed && hasDetail && isPending" class="action-bar">
            <view class="action-btn" @click="onStartSubmit">
                <text class="action-btn-text">开始验收</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { goBack } from '../../utils/navigation'
    import { useAcceptanceDetail } from './composables/useAcceptanceDetail'

    const windowHeight = uni.getSystemInfoSync().windowHeight

    const {
        loading, failed, hasDetail, title, code, courseLine, deadlineText,
        statusLabel, resultLabel, overallRemark, progressLabel, submittedLabel, isPending,
        items, load, reload, onStartSubmit, itemResultLabel,
    } = useAcceptanceDetail()

    function onBack() : void {
        goBack()
    }

    onLoad((_options : any) : void => {
        const opts = _options as UTSJSONObject | null
        const raw = opts != null ? opts['id'] : null
        if (raw == null) return
        load(parseInt(raw as string))
    })

    // 从提交页返回时刷新单据状态（首次 show 时 taskId 还是 0，reload 自己会跳过）
    onShow(() => {
        reload()
    })
</script>

<style lang="scss">
