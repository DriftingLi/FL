        flex: 1;
        flex-direction: column;
        background-color: $bg-color;
    }

    .content-scroll {
        flex: 1;
    }

    .body {
        padding-bottom: 24rpx;
    }

    .state-tip {
        align-items: center;
        padding: 80rpx 24rpx;
    }

    .state-icon {
        font-size: 64rpx;
        margin-bottom: 16rpx;
    }

