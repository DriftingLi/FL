<!-- PROTOTYPE（#1467 方向验证，throwaway，勿直接进主干）：
     开屏欢迎页 → 改「一键登录/注册」页；拿掉开屏动画/倒计时；点按钮保留到登录。
     目的：在 App 与微信小程序两端验证这套布局渲染是否正确。吉祥物暂用 logo.png 占位（真机/小程序图片资产两端一致）。 -->
<template>
    <view class="login-page">
        <view class="glow glow-top"></view>
        <view class="glow glow-bottom"></view>

        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部返回（原型示意；小程序端右上角胶囊由系统提供） -->
        <view class="nav-row">
            <text class="nav-back" @click="onBack">‹</text>
        </view>

        <view class="hero">
            <text class="hi">Hi，您好！</text>
            <text class="welcome">欢迎使用叉车维修培训系统</text>
            <view class="mascot-box">
                <image class="mascot" src="/static/logo.png" mode="aspectFit"></image>
            </view>
        </view>

        <view class="actions">
            <view class="oneclick-btn" @click="onOneClickLogin">
                <text class="oneclick-text">一键登录/注册</text>
            </view>
            <view class="agreement" @click="toggleAgree">
                <text class="checkbox">{{ agreed ? '☑' : '☐' }}</text>
                <text class="agree-text">我已阅读并同意</text>
                <text class="agree-link">《用户协议》</text>
                <text class="agree-text">和</text>
                <text class="agree-link">《隐私协议》</text>
            </view>
        </view>
    </view>
</template>

<script>
    export default {
        data() {
            return {
                statusBarHeight: 20,
                agreed: false
            }
        },
        onLoad() {
            const sysInfo = uni.getSystemInfoSync()
            this.statusBarHeight = sysInfo.statusBarHeight
        },
        methods: {
            toggleAgree() {
                this.agreed = !this.agreed
            },
            onOneClickLogin() {
                if (!this.agreed) {
                    uni.showToast({ title: '请先阅读并同意用户协议', icon: 'none' })
                    return
                }
                // 原型 stub：一键登录真实实现待接（保留到登录页）。
                uni.navigateTo({ url: '/pages/login/login' })
            },
            onBack() {
                uni.navigateBack()
            }
        }
    }
</script>

