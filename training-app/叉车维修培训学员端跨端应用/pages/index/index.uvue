<template>
    <!-- 未登录着陆页（#1478）：已登录仍无条件落 dashboard（下方 onLoad 里那条 reLaunch 是全应用
         唯一的已登录冷启动落地路由，不得删改、不得条件化）；未登录按「微信登录能力」分叉出
         主 CTA 或次级入口——分叉由运行期探测件 composables/useLoginProviders 决定，
         本文件不新增任何条件编译指令行（② 门触发面，口径见 ADR-0008）。 -->
    <view class="landing-page">
        <!-- 背景光晕装饰 -->
        <view class="glow glow-top"></view>
        <view class="glow glow-bottom"></view>

        <!-- 状态栏占位 -->
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部标签 -->
        <view class="page-tag">
            <text class="page-tag-text">欢迎页</text>
        </view>

        <!-- 品牌区：吉祥物改 logo 占位（原整组纯 view 手绘已删，#1478 判据 6） -->
        <view class="hero">
            <text class="hi">Hi，您好！</text>
            <text class="welcome">欢迎使用叉车维修培训系统</text>
            <view class="mascot-box">
                <image class="mascot-logo" src="/static/logo.png" mode="aspectFit"></image>
            </view>
        </view>

        <!-- 登录入口区 -->
        <view class="actions">
            <!-- loginByWechat 失败原因可见（判据 5：不得被吞成静默） -->
            <view class="error-box" v-if="errorHint.length > 0">
                <text class="error-text">{{ errorHint }}</text>
            </view>

            <!-- 展示面：两端（小程序 / App）一律直出主 CTA；点击链的可达性另由接通面门禁
                 （#1487 ①a 真机口径 2026-10-03 ⇒ 原「探测到可用（小程序端）」表述已作废） -->
            <button class="cta-wechat" v-if="wechatAvailable" :disabled="loading" @click="onWechatLogin">微信一键登录</button>

            <!-- 协议行与登录页同源同文案（共享件，判据 7）；它只门禁微信登录，故随主 CTA 同进同退 -->
            <LoginAgreement v-if="wechatAvailable" :channel="'wechat'" :agreed="agreed" @toggle="toggleAgree" @agreement="showAgreement" @register="goRegister" />

            <!-- 次级入口：通往独立登录页的路（登录页保留、降级为次级落点，不退役 #1483）
                 两端都在位，不受探测门禁 -->
            <view class="cta-secondary" @click="goOtherLogin">
                <text class="cta-secondary-text">其他登录方式</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { useLoginProviders } from '../../composables/useLoginProviders'
    import { useLandingLogin } from './composables/useLandingLogin'
    import LoginAgreement from '../../components/login-agreement/login-agreement.uvue'

    const auth = useAuthStore()

    // 探测件与登录页引用**同一符号**（判据：两页共享，不是两份实现）
    // 两个面：#1487 ①a 真机口径（2026-10-03）—— 移动端**也展示**该入口（`wechatAvailable`），
    // 但真实链路尚未接通（`wechatLoginReady`），点击只给友好提示、不发请求
    const { wechatAvailable, wechatLoginReady } = useLoginProviders()

    const {
        statusBarHeight,
        agreed,
        loading,
        errorHint,
        toggleAgree,
        showAgreement,
        goRegister,
        goOtherLogin,
        onWechatLogin,
    } = useLandingLogin(wechatLoginReady.value)

    onLoad((_options : OnLoadOptions) => {
        const sysInfo = uni.getSystemInfoSync()
        statusBarHeight.value = sysInfo.statusBarHeight

        const restored = auth.restoreFromStorage()
        console.log('[welcome] restored=', restored, 'isLoggedIn=', auth.isLoggedIn.value)
        if (auth.isLoggedIn.value) {
            console.log('[welcome] redirect to dashboard')
            uni.reLaunch({
                url: '/pages/dashboard/dashboard',
                fail: (err) => {
                    console.error('[welcome] reLaunch to dashboard failed:', err)
                }
            })
        }

        // 未登录：停留在本着陆页，由上方探测分支决定给出哪个入口
    })
</script>

<style>
    .landing-page {
        flex: 1;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        background: linear-gradient(to bottom, #0066FF, #00CC99);
        background-color: #00CC99;
    }

    /* 背景光晕装饰 */
    .glow {
        position: absolute;
        border-radius: 50%;
    }

    .glow-top {
        width: 360rpx;
        height: 360rpx;
        top: -120rpx;
        right: -110rpx;
        background-color: rgba(255, 255, 255, 0.14);
    }

    .glow-bottom {
        width: 400rpx;
        height: 400rpx;
        bottom: -150rpx;
        left: -130rpx;
        background-color: rgba(255, 255, 255, 0.10);
    }

    .status-bar {
        background-color: transparent;
    }

    /* 顶部标签 */
    .page-tag {
        align-self: flex-start;
        margin: 20rpx 0 0 40rpx;
        padding: 10rpx 28rpx;
        border-radius: 999rpx;
        background-color: rgba(255, 255, 255, 0.20);
        align-items: center;
        justify-content: center;
    }

    .page-tag-text {
        font-size: 24rpx;
        color: rgba(255, 255, 255, 0.95);
        text-align: center;
    }

    /* 品牌区（布局与配色取自 throwaway 原型 23409956，行为面未取） */
    .hero {
        flex: 1;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 56rpx;
    }

    .hi {
        font-size: 60rpx;
        font-weight: bold;
        color: #FFFFFF;
        text-align: center;
    }

    .welcome {
        margin-top: 20rpx;
        font-size: 32rpx;
        color: rgba(255, 255, 255, 0.95);
        text-align: center;
    }

    /* 吉祥物槽位：白底圆角盒 + logo 占位 */
    .mascot-box {
        margin-top: 60rpx;
        width: 360rpx;
        height: 360rpx;
        border-radius: 40rpx;
        background-color: #ffffff;
        align-items: center;
        justify-content: center;
        box-shadow: 0 16rpx 40rpx rgba(8, 90, 120, 0.35);
    }

    .mascot-logo {
        width: 320rpx;
        height: 320rpx;
    }

    /* 入口区白底卡片：让共享协议件的配色与登录页完全一致（同件同视觉，不给件加「深浅色」变体 prop） */
    .actions {
        flex-direction: column;
        align-items: center;
        margin: 0 24rpx 24rpx 24rpx;
        padding: 32rpx 40rpx 40rpx 40rpx;
        border-radius: 40rpx;
        background-color: #ffffff;
        box-shadow: 0 12rpx 30rpx rgba(8, 90, 120, 0.28);
    }

    .error-box {
        margin-bottom: 20rpx;
        padding: 12rpx 20rpx;
        border-radius: 16rpx;
        background-color: #FFF1F0;
    }

    .error-text {
        font-size: 26rpx;
        color: #D93025;
        text-align: center;
    }

    /* 主 CTA：小程序端微信一键登录 */
    .cta-wechat {
        width: 560rpx;
        height: 96rpx;
        line-height: 96rpx;
        border-radius: 999rpx;
        background-color: #22C55E;
        color: #FFFFFF;
        font-size: 34rpx;
        font-weight: bold;
        text-align: center;
        border: none;
    }

    /* 次级入口：通往独立登录页的路，两端都在位 */
    .cta-secondary {
        margin-top: 28rpx;
        width: 560rpx;
        height: 88rpx;
        border-radius: 999rpx;
        background-color: #F2F4F7;
        align-items: center;
        justify-content: center;
    }

    .cta-secondary-text {
        font-size: 30rpx;
        color: #1E9FFF;
        text-align: center;
    }
</style>
