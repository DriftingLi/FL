<template>
    <!-- 未登录着陆页（#1478）：已登录仍无条件落 dashboard（下方 onLoad 里那条 reLaunch 是全应用
         唯一的已登录冷启动落地路由，不得删改、不得条件化）；未登录按「微信登录能力」分叉出
         主 CTA 或次级入口——分叉由运行期探测件 composables/useLoginProviders 决定，
         本文件不新增任何条件编译指令行（② 门触发面，口径见 ADR-0008）。 -->
    <view class="landing-page">
        <!-- 背景光晕装饰 -->
        <view class="glow glow-top"></view>
        <view class="glow glow-bottom"></view>

        <!-- 状态栏占位（N06 自垫：高度取自 utils/system.uts 唯一真源，#1602/#1609） -->
        <view class="status-bar" :style="{ height: safeArea.statusBarHeight + 'px' }"></view>

        <!-- 品牌区：吉祥物改 logo 占位（原整组纯 view 手绘已删，#1478 判据 6） -->
        <view class="hero">
            <text class="hi">Hi，您好！</text>
            <text class="welcome">欢迎使用叉车维修培训系统</text>
            <view class="mascot-box">
                <image class="mascot-logo" src="/static/ailogin.png" mode="aspectFit"></image>
            </view>
        </view>

        <!-- 登录入口区 -->
        <view class="actions">
            <!-- loginByWechat 失败原因可见（判据 5：不得被吞成静默） -->
            <view class="error-box" v-if="errorHint.length > 0">
                <text class="error-text">{{ errorHint }}</text>
            </view>

            <!-- 展示面：两端（小程序 / App）一律直出主 CTA；点击链的可达性另由接通面门禁
                 （#1487 ①a 真机口径 2026-10-03 ⇒ 原「探测到可用（小程序端）」表述已作废） -->
            <button class="cta-wechat" v-if="wechatAvailable" :disabled="loading" @click="onWechatLogin">微信一键登录</button>

            <!-- 协议行与登录页同源同文案（共享件，判据 7）；它只门禁微信登录，故随主 CTA 同进同退 -->
            <LoginAgreement v-if="wechatAvailable" :channel="'wechat'" :agreed="agreed" @toggle="toggleAgree"
                @agreement="showAgreement" @register="goRegister" />

            <!-- 次级入口：通往独立登录页的路（登录页保留、降级为次级落点，不退役 #1483）
                 两端都在位，不受探测门禁 -->
            <view class="cta-secondary" @click="goOtherLogin">
                <text class="cta-secondary-text">其他登录方式</text>
            </view>
        </view>

        <!-- 启动闪屏态（#2535，设计稿 307_6152.png）：首帧品牌图，1.5s 后淡出到上面这块着陆页内容。
             叠在最后、绝对定位铺满，故不参与 .landing-page 的纵向排布；已登录冷启动在 onLoad 里
             直接 reLaunch dashboard，本层不会上屏。 -->
        <view class="splash" v-if="splashVisible" :style="{ opacity: splashOpacity }">
            <view class="splash-tint"></view>
            <view class="splash-brand">
                <view class="splash-logo-box">
                    <image class="splash-logo" src="/static/logo.png" mode="aspectFit"></image>
                </view>
                <text class="splash-title">叉车维修培训系统</text>
                <text class="splash-subtitle">专业维修技能成长平台</text>
            </view>
            <view class="splash-mascot-box">
                <image class="splash-mascot" src="/static/splash-mascot.png" mode="aspectFit"></image>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad, onUnload } from '@dcloudio/uni-app'
    import { useAuthStore } from '../../stores/auth'
    import { useLoginProviders } from '../../composables/useLoginProviders'
    import { useLandingLogin } from './composables/useLandingLogin'
    import { useLandingSplash } from './composables/useLandingSplash'
    import { useSafeArea } from '../../utils/system'
    import LoginAgreement from '../../components/login-agreement/login-agreement.uvue'

    const auth = useAuthStore()
    const safeArea = useSafeArea()

    // 探测件与登录页引用**同一符号**（判据：两页共享，不是两份实现）
    // 两个面：#1487 ①a 真机口径（2026-10-03）—— 移动端**也展示**该入口（`wechatAvailable`），
    // 但真实链路尚未接通（`wechatLoginReady`），点击只给友好提示、不发请求
    const { wechatAvailable, wechatLoginReady } = useLoginProviders()

    const {
        agreed,
        loading,
        errorHint,
        toggleAgree,
        showAgreement,
        goRegister,
        goOtherLogin,
        onWechatLogin,
    } = useLandingLogin(wechatLoginReady.value)

    // 启动闪屏态（#2535）：初值即上屏，未登录才起计时；已登录那条 reLaunch 在 onLoad 里先走，
    // 页面不会绘制，故不必为「已登录不闪」再写分支。
    const { splashVisible, splashOpacity, start: startSplash, dispose: disposeSplash } = useLandingSplash()

    onLoad((_options : OnLoadOptions) => {
        const restored = auth.restoreFromStorage()
        console.log('[welcome] restored=', restored, 'isLoggedIn=', auth.isLoggedIn.value)
        if (auth.isLoggedIn.value) {
            console.log('[welcome] redirect to dashboard')
            uni.reLaunch({
                url: '/pages/dashboard/dashboard',
                fail: (err) => {
                    console.error('[welcome] reLaunch to dashboard failed:', err)
                }
            })
        } else {
            // 未登录：先放 1.5s 品牌图，再淡出到本着陆页
            startSplash()
        }

        // 未登录：停留在本着陆页，由上方探测分支决定给出哪个入口
    })

    onUnload(() : void => {
        disposeSplash()
    })
</script>

<style lang="scss">
    .landing-page {
        flex: 1;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        background: linear-gradient(to bottom, #0066FF, #00CC99);
        background-color: #00CC99;
    }

    /* 背景光晕装饰 */
    .glow {
        position: absolute;
        border-radius: 50%;
    }

    .glow-top {
        width: 360rpx;
        height: 360rpx;
        top: -120rpx;
        right: -110rpx;
        background-color: rgba(255, 255, 255, 0.14);
    }

    .glow-bottom {
        width: 400rpx;
        height: 400rpx;
        bottom: -150rpx;
        left: -130rpx;
        background-color: rgba(255, 255, 255, 0.10);
    }

    .status-bar {
        background-color: transparent;
    }

    /* 品牌区：文案左对齐、吉祥物居中。字号与左边距按设计稿 781_75.png 实测反推
       （780px 渲染：文字左边距 152px ⇒ 146rpx；Hi 字高 34px cap ⇒ 44rpx；副标题 12 字跨
       475px ⇒ 38rpx；两行盒间距 19px ⇒ margin-top 13rpx）。故 hero 交叉轴 stretch
       让文案左起，吉祥物靠 mascot-box 的 align-self 单独居中。
       左边距取 144rpx 而非 146rpx：副标题 12 字 × 38rpx = 456rpx，146rpx 下内容宽只剩
       458rpx（余 2rpx），换端换字体就可能折行；144rpx 留 6rpx 余量，视觉差 2rpx 不可见。 */
    .hero {
        flex: 1;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        padding: 0 144rpx;
    }

    .hi {
        font-size: 44rpx;
        font-weight: bold;
        color: #FFFFFF;
        text-align: left;
    }

    .welcome {
        margin-top: 13rpx;
        font-size: 38rpx;
        color: rgba(255, 255, 255, 0.95);
        text-align: left;
    }

    /* 吉祥物槽位：设计稿位图直接坐在渐变上（原型 781_75.png），无白底盒、无投影。
       尺寸按原型实测反推：原型 780px 渲染里吉祥物内容框 344x439px（占屏宽 44.1%）
       ⇒ 750rpx 下内容约 331x422rpx；图自身带透明留白（画布 392x502、内容 363x452、填充 92.6%x90.0%），
       故槽位取 360x460rpx，aspectFit 后内容约 333x415rpx，与原型齐平。 */
    .mascot-box {
        align-self: center;
        margin-top: 60rpx;
        width: 360rpx;
        height: 460rpx;
        align-items: center;
        justify-content: center;
    }

    .mascot-logo {
        width: 360rpx;
        height: 460rpx;
    }

    /* 入口区白底通栏（原型 781_75.png）：白底从渐变下沿直通屏底，无圆角、无投影、无左右留白。
       高度按原型实测反推：白区 454px / 屏高 1688px = 26.9% ⇒ 844pt 屏上 227pt = 436rpx；
       内容顶对齐（原型按钮距白区上沿 41px ⇒ 40rpx），故用 min-height 而非 height——登录失败
       多出 error-box 时白区可自行长高，不会被裁。底边距 40rpx 只在内容超高时兜底。
       共享协议件的配色仍与登录页完全一致（同件同视觉，不给件加「深浅色」变体 prop）。 */
    .actions {
        flex-direction: column;
        align-items: center;
        min-height: 436rpx;
        padding: 40rpx 40rpx 40rpx 40rpx;
        background-color: #ffffff;
    }

    .error-box {
        margin-bottom: 20rpx;
        padding: 12rpx 20rpx;
        border-radius: 16rpx;
        background-color: #FFF1F0;
    }

    .error-text {
        font-size: 26rpx;
        color: #D93025;
        text-align: center;
    }

    /* 主 CTA：小程序端微信一键登录。宽度撑满通栏内宽（原型按钮左右各留 39px ⇒ 40rpx） */
    .cta-wechat {
        width: 100%;
        height: 96rpx;
        line-height: 96rpx;
        border-radius: 999rpx;
        background-color: #22C55E;
        color: #FFFFFF;
        font-size: 34rpx;
        font-weight: bold;
        text-align: center;
        border: none;
    }

    /* 次级入口：通往独立登录页的路，两端都在位 */
    .cta-secondary {
        margin-top: 28rpx;
        width: 100%;
        height: 88rpx;
        border-radius: 999rpx;
        background-color: #F2F4F7;
        align-items: center;
        justify-content: center;
    }

    .cta-secondary-text {
        font-size: 30rpx;
        color: #1E9FFF;
        text-align: center;
    }

    /* ── 启动闪屏态（#2535，设计稿 307_6152.png） ─────────────────────────────
       原型实测（780×1688 渲染，换算 750rpx 屏）：主色实心到 64% 屏高后转成功色；
       白方块 180×180px ⇒ 173rpx、顶距 292rpx；标题 8 字跨 473px ⇒ 56rpx、顶距 524rpx；
       副标题 10 字跨 316px ⇒ 30rpx、顶距 610rpx；吉祥物内容 340×480px ⇒ 327×462rpx、底距 133rpx。
       渐变用「实底 + 底部渐变带」两层而不是三停 linear-gradient：uvue 原生端对百分比色标
       支持不稳（不生效也不报错），两层是两端都确定成立的做法。 */
    .splash {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: $primary-color;
    }

    /* 底部渐变带：原型里渐变从 64% 屏高起（1623rpx × 36% ≈ 584rpx），首色与实底同色故无缝 */
    .splash-tint {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 584rpx;
        background: linear-gradient(to bottom, $primary-color, $success-color);
    }

    .splash-brand {
        position: absolute;
        top: 292rpx;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: center;
    }

    /* 白方块：原型 180×180px、圆角约 40px ⇒ 173rpx / 40rpx；内嵌叉车图标 133×103px ⇒ 128×99rpx */
    .splash-logo-box {
        width: 173rpx;
        height: 173rpx;
        border-radius: 40rpx;
        background-color: #FFFFFF;
        align-items: center;
        justify-content: center;
    }

    .splash-logo {
        width: 128rpx;
        height: 99rpx;
    }

    .splash-title {
        margin-top: 48rpx;
        font-size: 56rpx;
        font-weight: bold;
        color: #FFFFFF;
        text-align: center;
    }

    .splash-subtitle {
        margin-top: 16rpx;
        font-size: 30rpx;
        color: #FFFFFF;
        text-align: center;
    }

    .splash-mascot-box {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 133rpx;
        align-items: center;
    }

    .splash-mascot {
        width: 327rpx;
        height: 462rpx;
    }
</style>