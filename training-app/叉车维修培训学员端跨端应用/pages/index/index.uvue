        height: 66rpx;
        border-radius: 22rpx;
        background-color: #FFFFFF;
        box-shadow: 0 4rpx 14rpx rgba(8, 90, 120, 0.22);
    }

    .m-chest {
        position: absolute;
        left: 76rpx;
        top: 110rpx;
        width: 38rpx;
        height: 38rpx;
        border-radius: 50%;
        background-color: #FFFFFF;
        align-items: center;
        justify-content: center;
