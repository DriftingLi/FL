        border-radius: 50%;
        background-color: #4ADE80;
    }

    .m-head {
        position: absolute;
        left: 55rpx;
        top: 30rpx;
        width: 80rpx;
        height: 64rpx;
        border-radius: 32rpx;
        background-color: #FFFFFF;
        box-shadow: 0 4rpx 14rpx rgba(8, 90, 120, 0.28);
    }

    /* 脸部显示屏（深蓝屏幕，置于白色圆头内底部） */
    .m-face {
        position: absolute;
        left: 63rpx;
        top: 44rpx;
        width: 64rpx;
        height: 40rpx;
        border-radius: 22rpx;
        background-color: #1E3A8A;
    }

    .m-ear {
        position: absolute;
        top: 46rpx;
        width: 12rpx;
        height: 28rpx;
        border-radius: 6rpx;
        background-color: #3B82F6;
    }

    .m-ear-l {
        left: 43rpx;
    }

    .m-ear-r {
        left: 135rpx;
    }

    /* 眼：青色发光圆形 */
    .m-eye {
        position: absolute;
        top: 56rpx;
        width: 13rpx;
        height: 13rpx;
        border-radius: 50%;
        background-color: #22D3EE;
        box-shadow: 0 0 10rpx #67E8F9;
    }

    .m-eye-l {
        left: 76rpx;
    }

    .m-eye-r {
        left: 101rpx;
    }

    /* 微笑嘴：浅蓝弧（#1467：四值混单位 border-radius 全项目仅此一处、uvue 支持存疑 → 收敛为单值） */
    .m-mouth {
        position: absolute;
        left: 85rpx;
        top: 80rpx;
        width: 18rpx;
        height: 8rpx;
        border-radius: 8rpx;
        background-color: #93C5FD;
    }

    .m-body {
        position: absolute;
        left: 62rpx;
        top: 98rpx;
