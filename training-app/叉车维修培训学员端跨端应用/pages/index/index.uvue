        border-radius: 9rpx;
        background-color: #2563EB;
    }

    .m-leg-l {
        left: 76rpx;
    }

    .m-leg-r {
        left: 96rpx;
    }

    /* 进入按钮 */
    .enter-btn {
        margin-top: 56rpx;
        width: 420rpx;
        height: 92rpx;
        line-height: 92rpx;
        border-radius: 999rpx;
        background-color: #ffffff;
        color: #1E9FFF;
        font-size: 32rpx;
        font-weight: bold;
