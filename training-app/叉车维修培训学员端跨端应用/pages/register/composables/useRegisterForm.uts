/**
 * 注册页状态 composable（T11 register 手术，parent #649 / ADR-0007）
 *
 * 逐段搬自 pages/register/register.uvue 的 `<script setup>`，行为逐字保持：
 * 图形验证码加载（失败 → 点击重试占位）→ 手机号 / 邮箱双通道校验 → 发送验证码
 * （60s 倒计时、失败即刷新图形验证码）→ 注册（验证码通过后自动登录，refresh_token 一并落地）。
 *
 * uni 生命周期钩子留在页面壳层：已登录跳仪表盘的门控（onLoad）与离页清倒计时（onUnload）
 * 由壳层调用 `loadCaptcha` / `clearCountdownTimer` 驱动 —— 照 T06/T07/T08 先例：
 * composable 不注册 uni 生命周期。
 *
 * **两个形态决定（写给后来的会话）**：
 * ① 表单态从页面的 `reactive` 改成 `ref<RegisterForm>`：模块 composable 家族 12/12 用 ref，
 *    且 ref 的 `.value` 在模板里是**显式**的 —— 「忘写 .value ⇒ 条件恒真」这类静默失效
 *    才有判据面（`utils/registerContract.test.js` 机检「模板里凡 reg.<成员> 必跟 .value」）。
 * ② 输入事件 handler 在本 composable 里**收字符串**而不是 `InputEvent`：本仓 `.uts` 侧
 *    没有任何 `InputEvent` 先例（它是 uvue 页面的全局事件类型），改用「页面薄包装取
 *    `e.detail.value` → 本 composable 的 setXxx(value)」把 uvue 事件类型留在 .uvue 一侧。
 *
 * 内部态（`captchaId` / `captchaLoading` / `wrongAttempts`）页面不消费，故不进返回面
 * （T05 死代码消费面核对口径：返回面只暴露真实被消费的符号）。
 */
import { ref, computed } from 'vue'
import type { Ref, ComputedRef } from 'vue'
import { useAuthStore } from '../../../stores/auth'
import { registerApi, emailRegisterApi, sendPhoneCodeApi, sendCodeApi, getCaptchaApi } from '../../../api/auth'
import type { RegisterParams, EmailRegisterParams, LoginResult } from '../../../types/index'

/** 注册表单数据类型（UTS 必须显式声明，否则字段会被推断为 Any?） */
export type RegisterForm = {
    nickname : string
    phone : string
    email : string
    code : string
    password : string
    confirmPassword : string
}

/** 本 composable 的显式返回类型（Kotlin error18 规避，先例 useResumeEdit / useChapterStudy / useMockExamSession） */
export type UseRegisterFormResult = {
    mode : Ref<string>
    subtitle : ComputedRef<string>
    form : Ref<RegisterForm>
    captchaImage : Ref<string>
    captchaValue : Ref<string>
    captchaFailed : Ref<boolean>
    countdown : Ref<number>
    codeHint : ComputedRef<string>
    agreed : Ref<boolean>
    passwordVisible : Ref<boolean>
    confirmVisible : Ref<boolean>
    loading : Ref<boolean>
    sendingCode : Ref<boolean>
    loadCaptcha : () => Promise<void>
    clearCountdownTimer : () => void
    switchMode : (m : string) => void
    toggleAgree : () => void
    togglePasswordVisible : () => void
    toggleConfirmVisible : () => void
    showAgreement : (name : string) => void
    refreshCaptcha : () => void
    onSendCode : () => Promise<void>
    onSubmit : () => Promise<void>
    goLogin : () => void
    setNickname : (value : string) => void
    setPhone : (value : string) => void
    setEmail : (value : string) => void
    setCode : (value : string) => void
    setPassword : (value : string) => void
    setConfirmPassword : (value : string) => void
    setCaptchaValue : (value : string) => void
}

export function useRegisterForm() : UseRegisterFormResult {
    const auth = useAuthStore()

    // 注册方式：phone（手机号注册，默认） | email（邮箱注册）
    const mode = ref<string>('phone')

    // 页面副标题随注册方式切换
    const subtitle = computed<string>(() : string =>
        mode.value == 'email' ? '邮箱注册，验证码通过后自动登录' : '手机号注册，验证码通过后自动登录'
    )

    // ---- 注册表单 ----
    const form = ref<RegisterForm>({
        nickname: '',
        phone: '',
        email: '',
        code: '',
        password: '',
        confirmPassword: '',
    } as RegisterForm)

    // ---- 图形验证码 ----
    const captchaId = ref<string>('')
    const captchaImage = ref<string>('')
    const captchaValue = ref<string>('')
    const captchaLoading = ref<boolean>(false)
    const captchaFailed = ref<boolean>(false)

    // ---- 验证码倒计时 / 连续输错 ----
    const countdown = ref<number>(0)
    let countdownTimer : number | null = null
    const wrongAttempts = ref<number>(0)

    /** 加载图形验证码（进入页面/点击图片刷新）；失败展示"点击重试"占位 */
    async function loadCaptcha() : Promise<void> {
        if (captchaLoading.value) return
        captchaLoading.value = true
        try {
            const data = await getCaptchaApi()
            captchaId.value = data['id'] as string
            captchaImage.value = data['image'] as string
            captchaValue.value = ''
            captchaFailed.value = false
        } catch (e) {
            console.error('[register] load captcha failed:', e)
            captchaFailed.value = true
        } finally {
            captchaLoading.value = false
        }
    }

    /** 清理倒计时定时器（局部副本承接：Kotlin 禁止对闭包中修改的 var 智能转换） */
    function clearCountdownTimer() : void {
        const timer = countdownTimer
        if (timer != null) {
            clearInterval(timer)
            countdownTimer = null
        }
    }

    /** 切换注册方式：清空已收验证码（通道间不通用）、重置倒计时并刷新图形验证码 */
    function switchMode(m : string) : void {
        if (m == mode.value) return
        mode.value = m
        clearCountdownTimer()
        countdown.value = 0
        wrongAttempts.value = 0
        form.value.code = ''
        loadCaptcha()
    }

    // 协议勾选
    const agreed = ref<boolean>(false)

    // 密码明文切换
    const passwordVisible = ref<boolean>(false)
    const confirmVisible = ref<boolean>(false)

    function toggleAgree() : void {
        agreed.value = !agreed.value
    }

    function togglePasswordVisible() : void {
        passwordVisible.value = !passwordVisible.value
    }

    function toggleConfirmVisible() : void {
        confirmVisible.value = !confirmVisible.value
    }

    function showAgreement(name : string) : void {
        uni.showToast({ title: name + '详情页建设中', icon: 'none' })
    }

    function refreshCaptcha() : void {
        loadCaptcha()
    }

    const loading = ref<boolean>(false)
    const sendingCode = ref<boolean>(false)

    function validatePhone() : string {
        const phone : string = form.value.phone
        if (phone.length != 11) return '请输入 11 位手机号'
        if (!phone.startsWith('1')) return '手机号格式不正确'
        if (!/^\d{11}$/.test(phone)) return '手机号必须为数字'
        return ''
    }

    function validateEmail() : string {
        const t = form.value.email.trim()
        if (t.length == 0) return '请输入邮箱'
        if (!/^[\w.%+-]+@[\w-]+(\.[\w-]+)+$/.test(t)) return '邮箱格式不正确'
        return ''
    }

    function startCountdown() : void {
        countdown.value = 60
        clearCountdownTimer()
        countdownTimer = setInterval(() => {
            countdown.value -= 1
            if (countdown.value <= 0) {
                clearCountdownTimer()
            }
        }, 1000) as number
    }

    async function onSendCode() : Promise<void> {
        if (sendingCode.value || countdown.value > 0) return
        if (captchaId.value.length == 0 || captchaValue.value.length == 0) {
            uni.showToast({ title: '请先输入图形验证码', icon: 'none' })
            return
        }
        const err = mode.value == 'email' ? validateEmail() : validatePhone()
        if (err.length > 0) {
            uni.showToast({ title: err, icon: 'none' })
            return
        }
        sendingCode.value = true
        uni.showLoading({ title: '发送中...', mask: true })
        try {
            if (mode.value == 'email') {
                await sendCodeApi(form.value.email.trim(), 'email', 'register', captchaId.value, captchaValue.value)
            } else {
                await sendPhoneCodeApi(form.value.phone, captchaId.value, captchaValue.value)
            }
            // 发送成功后刷新图形验证码（答案用后即焚，防止重放）
            loadCaptcha()
            // 新验证码下发后重置本地连续输错计数（对齐后端错误上限）
            wrongAttempts.value = 0
            uni.hideLoading()
            uni.showToast({ title: mode.value == 'email' ? '验证码已发送，请查收邮箱' : '验证码已发送，请查收短信', icon: 'none' })
            startCountdown()
        } catch (e) {
            uni.hideLoading()
            console.error('[register] send code failed:', e)
            let msg = '验证码发送失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
            // 失败后刷新图形验证码：后端校验即消费（无论对错都会删除答案），
            // 不做刷新会留下已失效的旧图，重试必报"图形验证码错误或已过期"
            loadCaptcha()
        } finally {
            sendingCode.value = false
        }
    }

    function validate() : string {
        const nickname : string = form.value.nickname
        const code : string = form.value.code
        const password : string = form.value.password
        const confirmPassword : string = form.value.confirmPassword
        if (agreed.value == false) return '请先同意用户协议和隐私政策'
        if (nickname.length == 0) return '请输入昵称'
        if (mode.value == 'email') {
            const err = validateEmail()
            if (err.length > 0) return err
        } else {
            const err = validatePhone()
            if (err.length > 0) return err
        }
        if (code.length == 0) return '请输入验证码'
        if (code.length != 6) return '请输入 6 位验证码'
        if (password.length < 6 || password.length > 20) return '密码长度需为 6-20 位'
        if (password != confirmPassword) return '两次输入的密码不一致'
        return ''
    }

    async function onSubmit() : Promise<void> {
        if (loading.value) return
        const errMsg = validate()
        if (errMsg.length > 0) {
            uni.showToast({ title: errMsg, icon: 'none' })
            return
        }

        loading.value = true
        uni.showLoading({ title: '注册中...', mask: true })

        try {
            // 验证码通过后自动登录
            let result : LoginResult
            if (mode.value == 'email') {
                const params : EmailRegisterParams = {
                    email: form.value.email.trim(),
                    code: form.value.code,
                    nickname: form.value.nickname,
                    password: form.value.password,
                }
                result = await emailRegisterApi(params)
            } else {
                const params : RegisterParams = {
                    phone: form.value.phone,
                    code: form.value.code,
                    nickname: form.value.nickname,
                    password: form.value.password,
                }
                result = await registerApi(params)
            }
            // refresh_token 必须一并落地：缺失时 access 过期无法自动续期，会被直接踢回登录页
            auth.setAuthData(result.token, result.user, result.refresh_token)
            uni.hideLoading()
            uni.showToast({ title: '注册成功', icon: 'success', duration: 1000 })
            setTimeout(() => {
                uni.reLaunch({ url: '/pages/guide/choose-cert' })
            }, 1100)
        } catch (e) {
            uni.hideLoading()
            console.error('[register] failed:', e)
            // 验证码错误时累计连续输错次数（后端上限 5 次，到达后需重新获取）
            const m = e instanceof Error ? (e as Error).message : ''
            if (m.indexOf('验证码') >= 0) {
                wrongAttempts.value += 1
            }
            let msg = '注册失败，请重试'
            if (e instanceof Error) {
                const err = e as Error
                const mm = err.message
                if (mm != null && mm.length > 0) {
                    msg = mm
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // 验证码提示：说明后端规则 + 实时展示连续输错次数
    const codeHint = computed<string>(() : string => {
        if (wrongAttempts.value >= 5) {
            return '验证码错误次数过多，请点击获取验证码重新发送'
        }
        if (wrongAttempts.value > 0) {
            return '验证码错误，还可再试 ' + (5 - wrongAttempts.value) + ' 次'
        }
        return '6 位数字验证码，5 分钟内有效'
    })

    function goLogin() : void {
        uni.redirectTo({ url: '/pages/login/login' })
    }

    // ---- 输入面：uvue 的 InputEvent 留在页面壳层，这里只收值（见文件头形态决定 ②） ----
    function setNickname(value : string) : void {
        form.value.nickname = value
    }

    function setPhone(value : string) : void {
        form.value.phone = value
    }

    function setEmail(value : string) : void {
        form.value.email = value
    }

    function setCode(value : string) : void {
        form.value.code = value
    }

    function setPassword(value : string) : void {
        form.value.password = value
    }

    function setConfirmPassword(value : string) : void {
        form.value.confirmPassword = value
    }

    function setCaptchaValue(value : string) : void {
        captchaValue.value = value
    }

    return {
        mode,
        subtitle,
        form,
        captchaImage,
        captchaValue,
        captchaFailed,
        countdown,
        codeHint,
        agreed,
        passwordVisible,
        confirmVisible,
        loading,
        sendingCode,
        loadCaptcha: () => loadCaptcha(),
        clearCountdownTimer: () => clearCountdownTimer(),
        switchMode: (m : string) => switchMode(m),
        toggleAgree: () => toggleAgree(),
        togglePasswordVisible: () => togglePasswordVisible(),
        toggleConfirmVisible: () => toggleConfirmVisible(),
        showAgreement: (name : string) => showAgreement(name),
        refreshCaptcha: () => refreshCaptcha(),
        onSendCode: () => onSendCode(),
        onSubmit: () => onSubmit(),
        goLogin: () => goLogin(),
        setNickname: (value : string) => setNickname(value),
        setPhone: (value : string) => setPhone(value),
        setEmail: (value : string) => setEmail(value),
        setCode: (value : string) => setCode(value),
        setPassword: (value : string) => setPassword(value),
        setConfirmPassword: (value : string) => setConfirmPassword(value),
        setCaptchaValue: (value : string) => setCaptchaValue(value),
    } as UseRegisterFormResult
}
