<template>
	<scroll-view scroll-y class="register-page">
		<!-- 顶部品牌区 -->
		<view class="header">
			<view class="logo-box">
				<image src="/static/logo.png" mode="aspectFit" style="width: 140rpx; height: 140rpx;"></image>
			</view>
			<text class="page-title">注册账号</text>
			<text class="page-subtitle">{{ reg.subtitle.value }}</text>
		</view>

		<!-- 注册方式切换：手机号 / 邮箱 -->
		<view class="mode-tabs">
			<view class="mode-tab" :class="{ 'mode-tab-active': reg.mode.value == 'phone' }" @click="reg.switchMode('phone')">
				<text class="mode-tab-text" :class="{ 'mode-tab-text-active': reg.mode.value == 'phone' }">手机号注册</text>
			</view>
			<view class="mode-tab" :class="{ 'mode-tab-active': reg.mode.value == 'email' }" @click="reg.switchMode('email')">
				<text class="mode-tab-text" :class="{ 'mode-tab-text-active': reg.mode.value == 'email' }">邮箱注册</text>
			</view>
		</view>

		<view class="form">
			<!-- ===== 手机号注册（默认） ===== -->
			<template v-if="reg.mode.value == 'phone'">
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入昵称" :maxlength="20"
							:value="reg.form.value.nickname" @input="onNicknameInput" @confirm="onConfirm" />
					</view>
				</view>
				<view class="form-item">
					<view class="input-wrap">
						<text class="input-prefix">+86</text>
						<input class="input-base" type="number" placeholder="请输入 11 位手机号" :maxlength="11"
							:value="reg.form.value.phone" @input="onPhoneInput" @confirm="onConfirm" />
					</view>
				</view>
				<view class="form-item code-row">
					<view class="code-input-wrap">
						<view class="input-wrap">
							<input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
								:value="reg.form.value.code" @input="onCodeInput" @confirm="onConfirm" />
						</view>
					</view>
					<button class="code-btn" :class="{ 'code-btn-disabled': reg.sendingCode.value || reg.countdown.value > 0 }" :disabled="reg.sendingCode.value || reg.countdown.value > 0" @click="reg.onSendCode()">
						{{ reg.countdown.value > 0 ? reg.countdown.value + 's' : '获取验证码' }}
					</button>
				</view>
				<view class="form-item captcha-row">
					<view class="input-wrap captcha-input-wrap">
						<input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
							:value="reg.captchaValue.value" @input="onCaptchaInput" />
					</view>
					<view class="captcha-img captcha-fail-box" v-if="reg.captchaFailed.value" @click="reg.refreshCaptcha()">
						<text class="captcha-fail-text">加载失败 点击重试</text>
					</view>
					<image class="captcha-img" v-else :src="reg.captchaImage.value" mode="aspectFit" @click="reg.refreshCaptcha()" />
				</view>
				<view class="form-item hint" v-if="reg.codeHint.value.length > 0">
					<text class="hint-text">{{ reg.codeHint.value }}</text>
				</view>
			</template>

			<!-- ===== 邮箱注册 ===== -->
			<template v-else>
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入昵称" :maxlength="20"
							:value="reg.form.value.nickname" @input="onNicknameInput" @confirm="onConfirm" />
					</view>
				</view>
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入邮箱" :maxlength="50"
							:value="reg.form.value.email" @input="onEmailInput" @confirm="onConfirm" />
					</view>
				</view>
				<view class="form-item code-row">
					<view class="code-input-wrap">
						<view class="input-wrap">
							<input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
								:value="reg.form.value.code" @input="onCodeInput" @confirm="onConfirm" />
						</view>
					</view>
					<button class="code-btn" :class="{ 'code-btn-disabled': reg.sendingCode.value || reg.countdown.value > 0 }" :disabled="reg.sendingCode.value || reg.countdown.value > 0" @click="reg.onSendCode()">
						{{ reg.countdown.value > 0 ? reg.countdown.value + 's' : '获取验证码' }}
					</button>
				</view>
				<view class="form-item captcha-row">
					<view class="input-wrap captcha-input-wrap">
						<input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
							:value="reg.captchaValue.value" @input="onCaptchaInput" />
					</view>
					<view class="captcha-img captcha-fail-box" v-if="reg.captchaFailed.value" @click="reg.refreshCaptcha()">
						<text class="captcha-fail-text">加载失败 点击重试</text>
					</view>
					<image class="captcha-img" v-else :src="reg.captchaImage.value" mode="aspectFit" @click="reg.refreshCaptcha()" />
				</view>
				<view class="form-item hint" v-if="reg.codeHint.value.length > 0">
					<text class="hint-text">{{ reg.codeHint.value }}</text>
				</view>
			</template>

			<!-- 密码设置（两种方式共用） -->
			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="!reg.passwordVisible.value" placeholder="设置密码（6-20 位）" :maxlength="20"
						:value="reg.form.value.password" @input="onPasswordInput" @confirm="onConfirm" />
					<text class="pwd-toggle" @click="reg.togglePasswordVisible()">{{ reg.passwordVisible.value ? '隐藏' : '显示' }}</text>
				</view>
			</view>
			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="!reg.confirmVisible.value" placeholder="请再次输入密码" :maxlength="20"
						:value="reg.form.value.confirmPassword" @input="onConfirmPasswordInput" @confirm="onConfirm" />
					<text class="pwd-toggle" @click="reg.toggleConfirmVisible()">{{ reg.confirmVisible.value ? '隐藏' : '显示' }}</text>
				</view>
			</view>

			<!-- 协议勾选 -->
			<view class="form-item agree-row" @click="reg.toggleAgree()">
				<view class="checkbox" :class="{ 'checkbox-checked': reg.agreed.value }">
					<text v-if="reg.agreed.value" class="check-mark">✓</text>
				</view>
				<text class="agree-text">同意</text>
				<text class="agree-link" @click.stop="reg.showAgreement('用户协议')">《用户协议》</text>
				<text class="agree-text">和</text>
				<text class="agree-link" @click.stop="reg.showAgreement('用户隐私')">《用户隐私》</text>
			</view>

			<button class="btn-primary submit-btn" :class="{ 'btn-primary-disabled': reg.loading.value }" :disabled="reg.loading.value" @click="reg.onSubmit()">
				{{ reg.loading.value ? '注册中...' : '注 册' }}
			</button>

			<view class="footer">
				<text class="footer-text">已有账号？</text>
				<text class="footer-link" @click="reg.goLogin()">返回登录</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useAuthStore } from '../../stores/auth'
	import { useRegisterForm } from './composables/useRegisterForm'

	const auth = useAuthStore()

	// 注册态与全部动作下沉模块私有 composable；页面只保留模板、生命周期与薄包装 handler（T06–T09 先例）
	const reg = useRegisterForm()

	// 输入面：uvue 的 InputEvent 留在壳层，只把值转交 composable（理由见 composable 文件头形态决定 ②）
	function onNicknameInput(e : InputEvent) : void { reg.setNickname(e.detail.value) }
	function onPhoneInput(e : InputEvent) : void { reg.setPhone(e.detail.value) }
	function onEmailInput(e : InputEvent) : void { reg.setEmail(e.detail.value) }
	function onCodeInput(e : InputEvent) : void { reg.setCode(e.detail.value) }
	function onPasswordInput(e : InputEvent) : void { reg.setPassword(e.detail.value) }
	function onConfirmPasswordInput(e : InputEvent) : void { reg.setConfirmPassword(e.detail.value) }
	function onCaptchaInput(e : InputEvent) : void { reg.setCaptchaValue(e.detail.value) }

	// 键盘「完成」等价于点注册（原 `onConfirm()` → `onSubmit()` 的调用逐字保持）
	function onConfirm() : void { reg.onSubmit() }

	onLoad((options : OnLoadOptions) => {
		// 已登录则跳转仪表盘
		auth.restoreFromStorage()
		if (auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/dashboard/dashboard' })
			return
		}
		reg.loadCaptcha()
	})

	// 页面卸载时清理倒计时定时器
	onUnload(() => {
		reg.clearCountdownTimer()
	})
</script>

<style>
	.register-page {
		flex: 1;
		background-color: #ffffff;
	}

	/* ===== 顶部品牌区 ===== */
	.header {
		align-items: center;
		padding: 60rpx 0 48rpx 0;
	}

	.logo-box {
		position: relative;
		width: 140rpx;
		height: 140rpx;
	}

	.page-title {
		margin-top: 24rpx;
		font-size: 40rpx;
		font-weight: bold;
		color: #333333;
		text-align: center;
	}

	.page-subtitle {
		margin-top: 12rpx;
		font-size: 24rpx;
		color: #999999;
		text-align: center;
	}

	/* ===== 注册方式切换（手机号 / 邮箱） ===== */
	.mode-tabs {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		margin: 8rpx 0 40rpx 0;
	}

	/* 容器与文字分成两位：原生端只把 font-size/color/font-weight 认给 <text>，落在 <view> 上会被判错并忽略（#1269） */
	.mode-tab {
		padding: 14rpx 44rpx;
		margin: 0 12rpx;
		background-color: #F0F1F5;
		border-radius: 48rpx;
		border: 2rpx solid transparent;
	}

	.mode-tab-active {
		background-color: #E8F3FF;
		border-color: #2979ff;
	}

	.mode-tab-text {
		font-size: 28rpx;
		color: #666666;
	}

	.mode-tab-text-active {
		color: #2979ff;
		font-weight: bold;
	}

	/* ===== 表单区 ===== */
	.form {
		padding: 0 56rpx;
	}

	.form-item {
		margin-bottom: 28rpx;
	}

	/* 灰底圆角输入框 */
	.input-wrap {
		flex-direction: row;
		align-items: center;
		background-color: #F5F6FA;
		border-radius: 16rpx;
		height: 96rpx;
		padding: 0 28rpx;
	}

	.input-prefix {
		font-size: 32rpx;
		color: #333333;
		font-weight: bold;
		margin-right: 16rpx;
		border-right: 2rpx solid #E0E2EA;
		padding-right: 16rpx;
	}

	.input-base {
		flex: 1;
		height: 96rpx;
		border: none;
		background-color: transparent;
		padding: 0;
		font-size: 30rpx;
		color: #333333;
	}

	/* 密码显隐切换 */
	.pwd-toggle {
		font-size: 26rpx;
		color: #999999;
		padding-left: 16rpx;
	}

	/* 验证码行 */
	.code-row {
		flex-direction: row;
		align-items: center;
	}

	.code-input-wrap {
		flex: 1;
		margin-right: 20rpx;
	}

	.code-btn {
		width: 200rpx;
		height: 96rpx;
		line-height: 96rpx;
		padding: 0;
		font-size: 26rpx;
		color: #2979ff;
		background-color: #ffffff;
		border: 2rpx solid #2979ff;
		border-radius: 48rpx;
		text-align: center;
	}

	.code-btn-disabled {
		opacity: 0.5;
	}

	/* 图形验证码行：输入框 + 图片 */
	.captcha-row {
		flex-direction: row;
		align-items: center;
	}

	.captcha-input-wrap {
		flex: 1;
		margin-right: 20rpx;
	}

	.captcha-input {
		font-size: 26rpx;
	}

	.captcha-img {
		width: 180rpx;
		height: 96rpx;
		border-radius: 16rpx;
		background-color: #F5F6FA;
	}

	/* 图形验证码加载失败占位 */
	.captcha-fail-box {
		align-items: center;
		justify-content: center;
	}

	.captcha-fail-text {
		font-size: 22rpx;
		color: #999999;
		text-align: center;
	}

	/* 验证码规则提示 */
	.hint {
		margin-top: -16rpx;
		margin-bottom: 16rpx;
	}

	.hint-text {
		font-size: 22rpx;
		color: #999999;
	}

	/* 协议行 */
	.agree-row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		margin-top: 8rpx;
	}

	.checkbox {
		width: 34rpx;
		height: 34rpx;
		border-radius: 50%;
		border: 2rpx solid #C8CDD8;
		align-items: center;
		justify-content: center;
		background-color: #ffffff;
		margin-right: 12rpx;
	}

	.checkbox-checked {
		background-color: #2979ff;
		border-color: #2979ff;
	}

	.check-mark {
		font-size: 24rpx;
		color: #ffffff;
	}

	.agree-text {
		font-size: 25rpx;
		color: #666666;
	}

	.agree-link {
		color: #2979ff;
	}

	/* 注册按钮 */
	.submit-btn {
		margin-top: 16rpx;
		width: 100%;
		height: 96rpx;
		line-height: 96rpx;
		border-radius: 48rpx;
		background-color: #2979ff;
		color: #ffffff;
		font-size: 34rpx;
		font-weight: bold;
		text-align: center;
		border: none;
	}

	.btn-primary-disabled {
		opacity: 0.6;
	}

	.footer {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		padding: 48rpx 0 60rpx 0;
	}

	.footer-text {
		font-size: 26rpx;
		color: #666666;
	}

	.footer-link {
		font-size: 26rpx;
		color: #2979ff;
		margin-left: 8rpx;
	}
</style>
