<template>
	<view class="register-page">
		<!-- 顶部品牌区 -->
		<view class="header">
			<view class="logo-box">
				<image src="/static/logo.png" mode="aspectFit" style="width: 140rpx; height: 140rpx;"></image>
			</view>
			<text class="page-title">注册账号</text>
			<text class="page-subtitle">{{ subtitle }}</text>
		</view>

		<!-- 注册方式切换：手机号 / 邮箱 -->
		<view class="mode-tabs">
			<view class="mode-tab" :class="{ 'mode-tab-active': mode == 'phone' }" @click="switchMode('phone')">手机号注册</view>
			<view class="mode-tab" :class="{ 'mode-tab-active': mode == 'email' }" @click="switchMode('email')">邮箱注册</view>
		</view>

		<view class="form">
			<!-- ===== 手机号注册（默认） ===== -->
			<template v-if="mode == 'phone'">
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入昵称" :maxlength="20"
							:value="form.nickname" @input="onNicknameInput" />
					</view>
				</view>
				<view class="form-item">
					<view class="input-wrap">
						<text class="input-prefix">+86</text>
						<input class="input-base" type="number" placeholder="请输入 11 位手机号" :maxlength="11"
							:value="form.phone" @input="onPhoneInput" />
					</view>
				</view>
				<view class="form-item code-row">
					<view class="code-input-wrap">
						<view class="input-wrap">
							<input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
								:value="form.code" @input="onCodeInput" />
						</view>
					</view>
					<button class="code-btn" :class="{ 'code-btn-disabled': sendingCode || countdown > 0 }" :disabled="sendingCode || countdown > 0" @click="onSendCode">
						{{ countdown > 0 ? countdown + 's' : '获取验证码' }}
					</button>
				</view>
				<view class="form-item captcha-row">
					<view class="input-wrap captcha-input-wrap">
						<input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
							:value="captchaValue" @input="onCaptchaInput" />
					</view>
					<image class="captcha-img" :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
				</view>
				<view class="form-item hint" v-if="codeHint.length > 0">
					<text class="hint-text">{{ codeHint }}</text>
				</view>
			</template>

			<!-- ===== 邮箱注册 ===== -->
			<template v-else>
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入昵称" :maxlength="20"
							:value="form.nickname" @input="onNicknameInput" />
					</view>
				</view>
				<view class="form-item">
					<view class="input-wrap">
						<input class="input-base" type="text" placeholder="请输入邮箱" :maxlength="50"
							:value="form.email" @input="onEmailInput" />
					</view>
				</view>
				<view class="form-item code-row">
					<view class="code-input-wrap">
						<view class="input-wrap">
							<input class="input-base" type="number" placeholder="请输入验证码" :maxlength="6"
								:value="form.code" @input="onCodeInput" />
						</view>
					</view>
					<button class="code-btn" :class="{ 'code-btn-disabled': sendingCode || countdown > 0 }" :disabled="sendingCode || countdown > 0" @click="onSendCode">
						{{ countdown > 0 ? countdown + 's' : '获取验证码' }}
					</button>
				</view>
				<view class="form-item captcha-row">
					<view class="input-wrap captcha-input-wrap">
						<input class="input-base captcha-input" type="text" placeholder="图形验证码" :maxlength="4"
							:value="captchaValue" @input="onCaptchaInput" />
					</view>
					<image class="captcha-img" :src="captchaImage" mode="aspectFit" @click="refreshCaptcha" />
				</view>
				<view class="form-item hint" v-if="codeHint.length > 0">
					<text class="hint-text">{{ codeHint }}</text>
				</view>
			</template>
			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="true" placeholder="设置密码（至少 6 位）" :maxlength="32"
						:value="form.password" @input="onPasswordInput" />
				</view>
			</view>
			<view class="form-item">
				<view class="input-wrap">
					<input class="input-base" :password="true" placeholder="请再次输入密码" :maxlength="32"
						:value="form.confirmPassword" @input="onConfirmPasswordInput" />
				</view>
			</view>

			<!-- 协议勾选 -->
			<view class="form-item agree-row" @click="toggleAgree">
				<view class="checkbox" :class="{ 'checkbox-checked': agreed }">
					<text v-if="agreed" class="check-mark">✓</text>
				</view>
				<text class="agree-text">同意</text>
				<text class="agree-link" @click.stop="showAgreement('用户协议')">《用户协议》</text>
				<text class="agree-text">和</text>
				<text class="agree-link" @click.stop="showAgreement('用户隐私')">《用户隐私》</text>
			</view>

			<button class="btn-primary submit-btn" :class="{ 'btn-primary-disabled': loading }" :disabled="loading" @click="onSubmit">
				{{ loading ? '注册中...' : '注 册' }}
			</button>

			<view class="footer">
				<text class="footer-text">已有账号？</text>
				<text class="footer-link" @click="goLogin">返回登录</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { reactive, ref, computed } from 'vue'
	import { useAuthStore } from '../../stores/auth'
	import { registerApi, emailRegisterApi, sendPhoneCodeApi, sendCodeApi, getCaptchaApi } from '../../api/auth'
	import type { RegisterParams, EmailRegisterParams, LoginResult } from '../../types/index'

	// 注册表单数据类型（UTS 必须显式声明，否则 reactive 字段会被推断为 Any?）
	type RegisterForm = {
		nickname : string
		phone : string
		email : string
		code : string
		password : string
		confirmPassword : string
	}

	const auth = useAuthStore()

	// 注册方式：phone（手机号注册，默认） | email（邮箱注册）
	const mode = ref<string>('phone')

	// 页面副标题随注册方式切换
	const subtitle = computed<string>(() : string =>
		mode.value == 'email' ? '邮箱注册，验证码通过后自动登录' : '手机号注册，验证码通过后自动登录'
	)

	/** 切换注册方式：重置验证码倒计时并刷新图形验证码（对应用侧验证码规则互不影响） */
	function switchMode(m : string) : void {
		if (m == mode.value) return
		mode.value = m
		clearCountdownTimer()
		countdown.value = 0
		wrongAttempts.value = 0
		loadCaptcha()
	}

	const form = reactive({
		nickname: '',
		phone: '',
		email: '',
		code: '',
		password: '',
		confirmPassword: '',
	} as RegisterForm)

	// 协议勾选
	const agreed = ref<boolean>(false)

	function toggleAgree() : void {
		agreed.value = !agreed.value
	}

	function showAgreement(name : string) : void {
		uni.showToast({ title: name + '详情页建设中', icon: 'none' })
	}

	// 图形验证码（人机验证，生产环境发送短信验证码前必填）
	const captchaId = ref<string>('')
	const captchaImage = ref<string>('')
	const captchaValue = ref<string>('')
	const captchaLoading = ref<boolean>(false)

	/** 加载图形验证码（进入页面/点击图片刷新） */
	async function loadCaptcha() : Promise<void> {
		if (captchaLoading.value) return
		captchaLoading.value = true
		try {
			const data = await getCaptchaApi()
			captchaId.value = data['id'] as string
			captchaImage.value = data['image'] as string
			captchaValue.value = ''
		} catch (e) {
			console.error('[register] load captcha failed:', e)
		} finally {
			captchaLoading.value = false
		}
	}

	function refreshCaptcha() : void {
		loadCaptcha()
	}

	const loading = ref<boolean>(false)
	const sendingCode = ref<boolean>(false)
	// 验证码倒计时（秒）
	const countdown = ref<number>(0)
	let countdownTimer : number | null = null
	/** 清理倒计时定时器（局部副本承接：Kotlin 禁止对闭包中修改的 var 智能转换） */
	function clearCountdownTimer() : void {
		const timer = countdownTimer
		if (timer != null) {
			clearInterval(timer)
			countdownTimer = null
		}
	}
	// 连续输错次数（对齐后端：错误上限 5 次，发新码或重新输入时清零）
	const wrongAttempts = ref<number>(0)

	onLoad((options : OnLoadOptions) => {
		// 已登录则跳转仪表盘
		auth.restoreFromStorage()
		if (auth.isLoggedIn.value) {
			uni.reLaunch({ url: '/pages/dashboard/dashboard' })
			return
		}
		loadCaptcha()
	})

	// 页面卸载时清理倒计时定时器
	onUnload(() => {
		clearCountdownTimer()
	})

	function validatePhone() : string {
		const phone : string = form.phone
		if (phone.length != 11) return '请输入 11 位手机号'
		if (!phone.startsWith('1')) return '手机号格式不正确'
		if (!/^\d{11}$/.test(phone)) return '手机号必须为数字'
		return ''
	}

	function validateEmail() : string {
		const t = form.email.trim()
		if (t.length == 0) return '请输入邮箱'
		if (t.indexOf('@') <= 0 || t.indexOf('.') <= 0) return '邮箱格式不正确'
		return ''
	}

	function startCountdown() : void {
		countdown.value = 60
		clearCountdownTimer()
		countdownTimer = setInterval(() => {
			countdown.value -= 1
			if (countdown.value <= 0) {
				clearCountdownTimer()
			}
		}, 1000) as number
	}

	async function onSendCode() : Promise<void> {
		if (sendingCode.value || countdown.value > 0) return
		if (captchaId.value.length == 0 || captchaValue.value.length == 0) {
			uni.showToast({ title: '请先输入图形验证码', icon: 'none' })
			return
		}
		const err = mode.value == 'email' ? validateEmail() : validatePhone()
		if (err.length > 0) {
			uni.showToast({ title: err, icon: 'none' })
			return
		}
		sendingCode.value = true
		uni.showLoading({ title: '发送中...', mask: true })
		try {
			if (mode.value == 'email') {
				await sendCodeApi(form.email.trim(), 'email', 'register', captchaId.value, captchaValue.value)
			} else {
				await sendPhoneCodeApi(form.phone, captchaId.value, captchaValue.value)
			}
			// 发送成功后刷新图形验证码（答案用后即焚，防止重放）
			loadCaptcha()
			// 新验证码下发后重置本地连续输错计数（对齐后端错误上限）
			wrongAttempts.value = 0
			uni.hideLoading()
			uni.showToast({ title: mode.value == 'email' ? '验证码已发送，请查收邮箱' : '验证码已发送，请查收短信', icon: 'none' })
			startCountdown()
		} catch (e) {
			uni.hideLoading()
			console.error('[register] send code failed:', e)
			let msg = '验证码发送失败'
			if (e instanceof Error) {
				const errObj = e as Error
				const m = errObj.message
				if (m != null && m.length > 0) {
					msg = m
				}
			}
			uni.showToast({ title: msg, icon: 'none' })
			// 失败后刷新图形验证码：后端校验即消费（无论对错都会删除答案），
			// 不做刷新会留下已失效的旧图，重试必报"图形验证码错误或已过期"
			loadCaptcha()
		} finally {
			sendingCode.value = false
		}
	}

	function validate() : string {
		const nickname : string = form.nickname
		const code : string = form.code
		const password : string = form.password
		const confirmPassword : string = form.confirmPassword
		if (agreed.value == false) return '请先同意用户协议和隐私政策'
		if (nickname.length == 0) return '请输入昵称'
		if (mode.value == 'email') {
			const err = validateEmail()
			if (err.length > 0) return err
		} else {
			const phone : string = form.phone
			if (phone.length != 11) return '请输入 11 位手机号'
			if (!phone.startsWith('1')) return '手机号格式不正确'
			if (!/^\d{11}$/.test(phone)) return '手机号必须为数字'
		}
		if (code.length == 0) return '请输入验证码'
		if (code.length != 6) return '请输入 6 位验证码'
		if (password.length < 6) return '密码至少 6 位'
		if (password != confirmPassword) return '两次输入的密码不一致'
		return ''
	}

	async function onSubmit() : Promise<void> {
		const errMsg = validate()
		if (errMsg.length > 0) {
			uni.showToast({ title: errMsg, icon: 'none' })
			return
		}

		loading.value = true
		uni.showLoading({ title: '注册中...', mask: true })

		try {
			// 验证码通过后自动登录
			let result : LoginResult
			if (mode.value == 'email') {
				const params : EmailRegisterParams = {
					email: form.email.trim(),
					code: form.code,
					nickname: form.nickname,
					password: form.password,
				}
				result = await emailRegisterApi(params)
			} else {
				const params : RegisterParams = {
					phone: form.phone,
					code: form.code,
					nickname: form.nickname,
					password: form.password,
				}
				result = await registerApi(params)
			}
			auth.setAuthData(result.token, result.user)
			uni.hideLoading()
			uni.showToast({ title: '注册成功', icon: 'success', duration: 1500 })
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/guide/choose-cert' })
			}, 1000)
		} catch (e) {
			uni.hideLoading()
			console.error('[register] failed:', e)
			// 验证码错误时累计连续输错次数（后端上限 5 次，到达后需重新获取）
			const m = e instanceof Error ? (e as Error).message : ''
			if (m.indexOf('验证码') >= 0) {
				wrongAttempts.value += 1
			}
			let msg = '注册失败，请重试'
			if (e instanceof Error) {
				const err = e as Error
				const mm = err.message
				if (mm != null && mm.length > 0) {
					msg = mm
				}
			}
			uni.showToast({ title: msg, icon: 'none' })
		} finally {
			loading.value = false
		}
	}

	// 验证码提示：说明后端规则 + 实时展示连续输错次数
	const codeHint = computed<string>(() : string => {
		if (wrongAttempts.value >= 5) {
			return '验证码错误次数过多，请点击获取验证码重新发送'
		}
		if (wrongAttempts.value > 0) {
			return '验证码错误，还可再试 ' + (5 - wrongAttempts.value) + ' 次'
		}
		return '6 位数字验证码，5 分钟内有效'
	})

	function goLogin() : void {
		uni.redirectTo({ url: '/pages/login/login' })
	}

	function onNicknameInput(e : InputEvent) : void {
		form.nickname = e.detail.value
	}

	function onPhoneInput(e : InputEvent) : void {
		form.phone = e.detail.value
	}

	function onEmailInput(e : InputEvent) : void {
		form.email = e.detail.value
	}

	function onCodeInput(e : InputEvent) : void {
		form.code = e.detail.value
	}

	function onPasswordInput(e : InputEvent) : void {
		form.password = e.detail.value
	}

	function onConfirmPasswordInput(e : InputEvent) : void {
		form.confirmPassword = e.detail.value
	}

	function onCaptchaInput(e : InputEvent) : void {
		captchaValue.value = e.detail.value
	}

</script>

<style>
	.register-page {
		flex: 1;
		background-color: #ffffff;
	}

	/* ===== 顶部品牌区 ===== */
	.header {
		align-items: center;
		padding: 60rpx 0 48rpx 0;
	}

	.logo-box {
		position: relative;
		width: 140rpx;
		height: 140rpx;
	}

	/* 叉车小 logo（坐标系 0-140rpx） */
	.mast-l {
		position: absolute;
		left: 73rpx;
		top: 22rpx;
		width: 9rpx;
		height: 74rpx;
		border-radius: 4rpx;
		background-color: #16A34A;
	}

	.mast-r {
		position: absolute;
		left: 86rpx;
		top: 22rpx;
		width: 9rpx;
		height: 74rpx;
		border-radius: 4rpx;
		background-color: #22C55E;
	}

	.fork-v {
		position: absolute;
		left: 73rpx;
		top: 62rpx;
		width: 9rpx;
		height: 36rpx;
		background-color: #15803D;
	}

	.fork-h {
		position: absolute;
		left: 73rpx;
		top: 93rpx;
		width: 50rpx;
		height: 9rpx;
		border-radius: 4rpx;
		background-color: #15803D;
	}

	.f-body {
		position: absolute;
		left: 12rpx;
		top: 46rpx;
		width: 58rpx;
		height: 30rpx;
		border-radius: 8rpx;
		background-color: #22C55E;
	}

	.f-cab {
		position: absolute;
		left: 24rpx;
		top: 22rpx;
		width: 34rpx;
		height: 30rpx;
		border-radius: 8rpx;
		background-color: #16A34A;
	}

	.f-window {
		position: absolute;
		left: 30rpx;
		top: 28rpx;
		width: 18rpx;
		height: 18rpx;
		border-radius: 6rpx;
		background-color: rgba(255, 255, 255, 0.45);
	}

	.f-wheel {
		position: absolute;
		width: 22rpx;
		height: 22rpx;
		border-radius: 50%;
		background-color: #14532D;
	}

	.f-wheel-back {
		left: 20rpx;
		top: 74rpx;
	}

	.f-wheel-front {
		left: 48rpx;
		top: 74rpx;
	}

	.f-hub {
		position: absolute;
		width: 9rpx;
		height: 9rpx;
		border-radius: 50%;
		background-color: #86EFAC;
	}

	.f-hub-back {
		left: 26rpx;
		top: 80rpx;
	}

	.f-hub-front {
		left: 54rpx;
		top: 80rpx;
	}

	/* 扳手（叉车右侧） */
	.f-wrench-ring {
		position: absolute;
		left: 103rpx;
		top: 18rpx;
		width: 19rpx;
		height: 19rpx;
		border-radius: 50%;
		border: 4rpx solid #16A34A;
	}

	.f-wrench-handle {
		position: absolute;
		left: 107rpx;
		top: 31rpx;
		width: 9rpx;
		height: 15rpx;
		border-radius: 4rpx;
		background-color: #16A34A;
	}

	.page-title {
		margin-top: 24rpx;
		font-size: 40rpx;
		font-weight: bold;
		color: #333333;
		text-align: center;
	}

	.page-subtitle {
		margin-top: 12rpx;
		font-size: 24rpx;
		color: #999999;
		text-align: center;
	}

	/* ===== 注册方式切换（手机号 / 邮箱） ===== */
	.mode-tabs {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		margin: 8rpx 0 40rpx 0;
	}

	.mode-tab {
		padding: 14rpx 44rpx;
		margin: 0 12rpx;
		font-size: 28rpx;
		color: #666666;
		background-color: #F0F1F5;
		border-radius: 48rpx;
		border: 2rpx solid transparent;
	}

	.mode-tab-active {
		background-color: #E8F3FF;
		color: #2979ff;
		border-color: #2979ff;
		font-weight: bold;
	}

	/* ===== 表单区 ===== */
	.form {
		padding: 0 56rpx;
	}

	.form-item {
		margin-bottom: 28rpx;
	}

	/* 灰底圆角输入框 */
	.input-wrap {
		flex-direction: row;
		align-items: center;
		background-color: #F5F6FA;
		border-radius: 16rpx;
		height: 96rpx;
		padding: 0 28rpx;
	}

	.input-prefix {
		font-size: 32rpx;
		color: #333333;
		font-weight: bold;
		margin-right: 16rpx;
		border-right: 2rpx solid #E0E2EA;
		padding-right: 16rpx;
	}

	.input-base {
		flex: 1;
		height: 96rpx;
		border: none;
		background-color: transparent;
		padding: 0;
		font-size: 30rpx;
		color: #333333;
	}

	/* 验证码行 */
	.code-row {
		flex-direction: row;
		align-items: center;
	}

	.code-input-wrap {
		flex: 1;
		margin-right: 20rpx;
	}

	.code-btn {
		width: 200rpx;
		height: 96rpx;
		line-height: 96rpx;
		padding: 0;
		font-size: 26rpx;
		color: #2979ff;
		background-color: #ffffff;
