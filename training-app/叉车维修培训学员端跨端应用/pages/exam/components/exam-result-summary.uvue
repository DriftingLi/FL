<template>
    <!-- 成绩汇总卡片 —— T07 手术自 pages/exam/mock-exam-result.uvue 逐段搬出，类名与结构逐字不变 -->
    <view class="summary-card" :class="passed ? 'summary-passed' : 'summary-failed'">
        <view class="summary-status">
            <text class="summary-status-text">{{ passed ? '恭喜通过' : '未通过' }}</text>
        </view>
        <view class="summary-score">
            <text class="summary-score-num">{{ scoreText }}</text>
            <text class="summary-score-total">/ {{ totalScoreText }} 分</text>
        </view>
        <view class="summary-meta">
            <view class="summary-meta-item">
                <text class="summary-meta-num">{{ correctCount }}</text>
                <text class="summary-meta-label">答对</text>
            </view>
            <view class="summary-meta-divider"></view>
            <view class="summary-meta-item">
                <text class="summary-meta-num">{{ totalQuestions - correctCount }}</text>
                <text class="summary-meta-label">答错</text>
            </view>
            <view class="summary-meta-divider"></view>
            <view class="summary-meta-item">
                <text class="summary-meta-num">{{ accuracy }}%</text>
                <text class="summary-meta-label">正确率</text>
            </view>
            <view class="summary-meta-divider"></view>
            <view class="summary-meta-item">
                <text class="summary-meta-num">{{ usedTimeText }}</text>
                <text class="summary-meta-label">用时</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    // 对象 prop 扁平化为原始 props（ADR-0007 规则 P，全仓先例 practice-stats-bar）
    // 分数/用时/正确率文案由 composable 派生后下发，组件不做展示计算（展示纯函数唯一实现）
    const props = withDefaults(defineProps<{
        passed? : boolean
        scoreText? : string
        totalScoreText? : string
        correctCount? : number
        totalQuestions? : number
        accuracy? : number
        usedTimeText? : string
    }>(), {
        passed: false,
        scoreText: '0',
        totalScoreText: '0',
        correctCount: 0,
        totalQuestions: 0,
        accuracy: 0,
        usedTimeText: '--'
    })
</script>

