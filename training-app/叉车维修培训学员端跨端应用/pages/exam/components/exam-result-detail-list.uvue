            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import type { ExamResultDetailRow } from '../composables/useMockExamResult'

    // 数组型 prop（行数据已在 composable 内派生为扁平视图模型，组件只渲染）
    const props = withDefaults(defineProps<{
        rows? : ExamResultDetailRow[]
    }>(), {
        rows: () => [] as ExamResultDetailRow[]
    })
</script>

