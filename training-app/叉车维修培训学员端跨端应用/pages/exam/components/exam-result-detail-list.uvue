<template>
    <!-- 题目详情列表 —— T07 手术自 pages/exam/mock-exam-result.uvue 逐段搬出，类名与结构逐字不变 -->
    <view class="detail-list">
        <view v-for="(row, idx) in rows" :key="idx" class="detail-card">
            <view class="detail-header">
                <text class="detail-type-tag">{{ row.typeName }}</text>
                <text class="detail-status" :class="row.isCorrect ? 'status-correct' : 'status-wrong'">
                    {{ row.statusText }}
