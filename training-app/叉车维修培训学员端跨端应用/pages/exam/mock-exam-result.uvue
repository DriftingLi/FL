        align-items: center;
        padding: 4rpx 0;
    }

    .detail-answer-label {
        font-size: 24rpx;
        color: #999999;
        margin-right: 8rpx;
    }

    .detail-answer-value {
        font-size: 24rpx;
        font-weight: bold;
    }

    .answer-correct {
        color: #4caf50;
    }

    .answer-wrong {
        color: #f44336;
    }

    /* 底部操作 */
    .bottom-actions {
        flex-direction: row;
        padding: 24rpx;
    }

    .bottom-btn {
        flex: 1;
        align-items: center;
        padding: 24rpx 0;
        border-radius: 48rpx;
        margin: 0 12rpx;
    }

    .bottom-btn-secondary {
        background-color: #f5f5f5;
        border: 1px solid #e0e0e0;
    }

    .bottom-btn-primary {
        background-color: #2979ff;
    }

    .bottom-btn-text {
        font-size: 30rpx;
        font-weight: bold;
        color: #ffffff;
    }

    .bottom-btn-text-secondary {
        color: #666666;
    }

    /* 加载/错误状态 */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .error-wrap {
        flex: 1;
