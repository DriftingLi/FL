        color: #ffffff;
    }

    .summary-score-total {
        font-size: 28rpx;
        color: #ffffff;
        opacity: 0.9;
        margin-left: 12rpx;
    }

    .summary-meta {
        flex-direction: row;
        justify-content: space-around;
        align-self: stretch;
        padding-top: 24rpx;
        border-top: 1rpx solid rgba(255, 255, 255, 0.3);
    }

    .summary-meta-item {
        flex: 1;
        flex-direction: column;
        align-items: center;
    }

    .summary-meta-num {
        font-size: 36rpx;
