<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">考试成绩</text>
            <view class="header-right"></view>
        </view>

        <!-- 加载中 -->
        <view v-if="result.loading.value" class="loading-wrap">
            <text class="loading-text">正在加载成绩...</text>
        </view>

        <scroll-view v-else-if="!result.hasError.value" class="content-scroll" scroll-y="true">
            <!-- 成绩汇总卡片 -->
            <ExamResultSummary
                :passed="result.summary.value.passed"
                :score-text="result.summary.value.scoreText"
                :total-score-text="result.summary.value.totalScoreText"
                :correct-count="result.summary.value.correctCount"
                :total-questions="result.summary.value.totalQuestions"
                :accuracy="result.summary.value.accuracy"
                :used-time-text="result.summary.value.usedTimeText" />

            <!-- 题目详情列表 -->
            <view class="section-header">
                <text class="section-title">题目详情</text>
            </view>
            <ExamResultDetailList :rows="result.details.value" />

            <!-- 底部操作 -->
            <view class="bottom-actions">
                <view class="bottom-btn bottom-btn-secondary" @click="onBack">
                    <text class="bottom-btn-text bottom-btn-text-secondary">返回</text>
                </view>
                <view class="bottom-btn bottom-btn-primary" @click="onViewHistory">
                    <text class="bottom-btn-text">查看历史</text>
                </view>
            </view>
        </scroll-view>

        <!-- 错误态 -->
        <view v-else class="error-wrap">
            <text class="error-text">{{ result.errorMsg.value }}</text>
            <view class="retry-btn" @click="onRetry">
                <text class="retry-btn-text">重试</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useMockExamResult } from './composables/useMockExamResult'
    import ExamResultSummary from './components/exam-result-summary.uvue'
    import ExamResultDetailList from './components/exam-result-detail-list.uvue'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 成绩拉取与展示派生（汇总/逐题行）下沉 composable，页面只保留模板与薄包装
    const result = useMockExamResult()

    function onBack() : void {
        goBack()
    }

    function onViewHistory() : void {
        uni.navigateTo({ url: '/pages/profile/mock-exam-records' })
    }

    function onRetry() : void { result.loadResult() }

    onLoad((options : UTSJSONObject) => {
        result.applyOptions(options)
        result.loadResult()
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 区块标题 */
    .section-header {
        padding: 0 24rpx 16rpx;
    }

    .section-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
    }

    /* 底部操作 */
    .bottom-actions {
        flex-direction: row;
        padding: 24rpx;
    }

    .bottom-btn {
        flex: 1;
        align-items: center;
        padding: 24rpx 0;
        border-radius: 48rpx;
        margin: 0 12rpx;
    }

    .bottom-btn-secondary {
        background-color: #f5f5f5;
        border: 1px solid #e0e0e0;
    }

    .bottom-btn-primary {
        background-color: #2979ff;
    }

    .bottom-btn-text {
        font-size: 30rpx;
        font-weight: bold;
        color: #ffffff;
    }

    .bottom-btn-text-secondary {
        color: #666666;
    }

    /* 加载/错误状态 */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .error-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .error-text {
        font-size: 28rpx;
        color: #999999;
        margin-bottom: 24rpx;
    }

    .retry-btn {
        padding: 16rpx 48rpx;
        background-color: #2979ff;
        border-radius: 32rpx;
    }

    .retry-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }
</style>
