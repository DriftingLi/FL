<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">考试成绩</text>
            <view class="header-right"></view>
        </view>

        <!-- 加载中 -->
        <view v-if="loading" class="loading-wrap">
            <text class="loading-text">正在加载成绩...</text>
        </view>

        <scroll-view v-else-if="!hasError" class="content-scroll" scroll-y="true">
            <!-- 成绩汇总卡片 -->
            <view class="summary-card" :class="result.passed ? 'summary-passed' : 'summary-failed'">
                <view class="summary-status">
                    <text class="summary-status-text">{{ result.passed ? '恭喜通过' : '未通过' }}</text>
                </view>
                <view class="summary-score">
                    <text class="summary-score-num">{{ formatScore(result.score) }}</text>
                    <text class="summary-score-total">/ {{ formatScore(result.total_score) }} 分</text>
                </view>
                <view class="summary-meta">
                    <view class="summary-meta-item">
                        <text class="summary-meta-num">{{ result.correct_count }}</text>
                        <text class="summary-meta-label">答对</text>
                    </view>
                    <view class="summary-meta-divider"></view>
                    <view class="summary-meta-item">
                        <text class="summary-meta-num">{{ result.total_questions - result.correct_count }}</text>
                        <text class="summary-meta-label">答错</text>
                    </view>
                    <view class="summary-meta-divider"></view>
                    <view class="summary-meta-item">
                        <text class="summary-meta-num">{{ accuracy }}%</text>
                        <text class="summary-meta-label">正确率</text>
                    </view>
                    <view class="summary-meta-divider"></view>
                    <view class="summary-meta-item">
                        <text class="summary-meta-num">{{ usedTimeDisplay }}</text>
                        <text class="summary-meta-label">用时</text>
                    </view>
                </view>
            </view>

            <!-- 题目详情列表 -->
            <view class="section-header">
                <text class="section-title">题目详情</text>
            </view>
            <view class="detail-list">
                <view v-for="(detail, idx) in result.details" :key="idx" class="detail-card">
                    <view class="detail-header">
                        <text class="detail-type-tag">{{ getTypeName(detail.type) }}</text>
                        <text class="detail-status" :class="detail.is_correct ? 'status-correct' : 'status-wrong'">
                            {{ detail.is_correct ? '✓ 正确' : '✗ 错误' }}
                        </text>
                    </view>
                    <text class="detail-title">{{ idx + 1 }}. {{ detail.title }}</text>
                    <view class="detail-answers">
                        <view class="detail-answer-row">
                            <text class="detail-answer-label">你的答案：</text>
                            <text class="detail-answer-value" :class="detail.is_correct ? 'answer-correct' : 'answer-wrong'">
                                {{ detail.user_answer.length > 0 ? detail.user_answer : '未作答' }}
                            </text>
                        </view>
                        <view v-if="!detail.is_correct" class="detail-answer-row">
                            <text class="detail-answer-label">正确答案：</text>
                            <text class="detail-answer-value answer-correct">{{ detail.correct_answer }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 底部操作 -->
            <view class="bottom-actions">
                <view class="bottom-btn bottom-btn-secondary" @click="onBack">
                    <text class="bottom-btn-text bottom-btn-text-secondary">返回</text>
                </view>
                <view class="bottom-btn bottom-btn-primary" @click="onViewHistory">
                    <text class="bottom-btn-text">查看历史</text>
                </view>
            </view>
        </scroll-view>

        <!-- 错误态 -->
        <view v-else class="error-wrap">
            <text class="error-text">{{ errorMsg }}</text>
            <view class="retry-btn" @click="loadResult">
                <text class="retry-btn-text">重试</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getMockExamResultApi } from '../../api/mockExam'
    import type { MockExamResult, MockExamResultDetail } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const mockExamId = ref<number>(0)
    const loading = ref<boolean>(false)
    const hasError = ref<boolean>(false)
    const errorMsg = ref<string>('加载成绩失败')

    const result = ref<MockExamResult>({
        mock_exam_id: 0,
        score: 0,
        total_score: 0,
        passed: false,
        correct_count: 0,
        total_questions: 0,
        used_time: 0,
        details: [] as MockExamResultDetail[],
    } as MockExamResult)

    /** 正确率 */
    const accuracy = computed<number>(() : number => {
        if (result.value.total_questions == 0) return 0
        return Math.floor(result.value.correct_count * 100 / result.value.total_questions)
    })

    /** 用时显示 */
    const usedTimeDisplay = computed<string>(() : string => {
        const sec = result.value.used_time
        if (sec <= 0) return '--'
        const m = Math.floor(sec / 60)
        const s = sec % 60
        if (m > 0) return m + '分' + s + '秒'
        return s + '秒'
    })

    /** 格式化分数（整数显示整数，小数显示 1 位） */
    function formatScore(score : number) : string {
        if (score == Math.floor(score)) {
            return '' + Math.floor(score)
        }
        return score.toFixed(1)
    }

    /** 题型名称 */
    function getTypeName(type : string) : string {
        if (type == 'single' || type == 'single_choice') return '单选题'
        if (type == 'multi' || type == 'multiple_choice' || type == 'multi_choice') return '多选题'
        if (type == 'judge' || type == 'true_false') return '判断题'
        return '其他'
    }

    async function loadResult() : Promise<void> {
        if (mockExamId.value == 0) {
            hasError.value = true
            errorMsg.value = '考试 ID 无效'
            return
        }
        loading.value = true
        hasError.value = false
        try {
            const data = await getMockExamResultApi(mockExamId.value)
            result.value = data
            console.log('[mock-exam-result] loaded, score:', data.score, '/', data.total_score)
        } catch (e) {
            console.error('[mock-exam-result] load failed:', e)
            hasError.value = true
            errorMsg.value = '加载成绩失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    errorMsg.value = errorMsg.value + ': ' + m
                }
            }
        } finally {
            loading.value = false
        }
    }

    function onBack() : void {
        goBack()
    }

    function onViewHistory() : void {
        uni.navigateTo({ url: '/pages/profile/mock-exam-records' })
    }

    onLoad((options : UTSJSONObject) => {
        const id = options['mock_exam_id']
        if (id != null) {
            mockExamId.value = parseInt(`${id}`)
        }
        loadResult()
    })
</script>

<style>
