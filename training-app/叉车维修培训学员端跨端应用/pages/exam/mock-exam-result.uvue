        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 80rpx;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 成绩汇总卡片 */
    .summary-card {
        margin: 24rpx;
        border-radius: 24rpx;
        padding: 48rpx 32rpx;
        align-items: center;
        border: 1px solid #eeeeee;
    }

    .summary-passed {
        background: linear-gradient(135deg, #4caf50, #66bb6a);
    }

    .summary-failed {
        background: linear-gradient(135deg, #f44336, #ef5350);
    }

