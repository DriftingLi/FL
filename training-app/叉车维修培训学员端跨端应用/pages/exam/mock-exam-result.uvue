        margin-bottom: 24rpx;
    }

    .summary-status-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #ffffff;
    }

    .summary-score {
        flex-direction: row;
        align-items: flex-end;
        margin-bottom: 32rpx;
    }

    .summary-score-num {
        font-size: 96rpx;
