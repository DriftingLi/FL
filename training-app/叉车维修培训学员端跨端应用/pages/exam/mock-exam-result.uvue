    .detail-card {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 24rpx;
        margin-bottom: 16rpx;
        border: 1px solid #eeeeee;
        flex-direction: column;
    }

    .detail-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 16rpx;
    }

    .detail-type-tag {
        font-size: 20rpx;
        color: #ffffff;
        background-color: #2979ff;
        padding: 4rpx 12rpx;
        border-radius: 6rpx;
        margin-right: 12rpx;
    }

    .detail-status {
        font-size: 22rpx;
        padding: 4rpx 12rpx;
        border-radius: 6rpx;
    }

    .status-correct {
        color: #4caf50;
        background-color: #e8f5e9;
    }

    .status-wrong {
        color: #f44336;
        background-color: #ffebee;
    }

    .detail-title {
        font-size: 28rpx;
        color: #333333;
        line-height: 44rpx;
        margin-bottom: 16rpx;
    }

    .detail-answers {
        flex-direction: column;
        background-color: #fafafa;
        padding: 16rpx;
        border-radius: 8rpx;
    }

    .detail-answer-row {
