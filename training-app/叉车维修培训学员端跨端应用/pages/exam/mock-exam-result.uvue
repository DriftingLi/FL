        color: #ffffff;
        margin-bottom: 4rpx;
    }

    .summary-meta-label {
        font-size: 22rpx;
        color: #ffffff;
        opacity: 0.9;
    }

    .summary-meta-divider {
        width: 1rpx;
        background-color: rgba(255, 255, 255, 0.3);
    }

    /* 区块标题 */
    .section-header {
