<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">模拟考试</text>
            <view class="header-right">
                <text class="timer-text" :class="{ warning: isTimeWarning, danger: isTimeDanger }">{{ timerDisplay }}</text>
            </view>
        </view>

        <!-- 加载中 -->
        <view v-if="loading && questions.length == 0" class="loading-wrap">
            <text class="loading-text">正在加载题目...</text>
        </view>

        <!-- 空数据 -->
        <view v-else-if="questions.length == 0" class="empty-wrap">
            <text class="empty-text">暂无题目</text>
        </view>

        <!-- 答题区域 -->
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <!-- 进度条 -->
            <view class="progress-section">
                <view class="progress-bar-wrap">
                    <view class="progress-bar" :style="{ width: progressPercent + '%' }"></view>
                </view>
                <text class="progress-text">{{ currentIndex + 1 }} / {{ questions.length }}</text>
            </view>

            <!-- 题号导航条 -->
            <scroll-view class="palette-scroll" scroll-x="true">
                <view class="palette-list">
                    <view v-for="(q, idx) in questions" :key="idx"
                        class="palette-chip"
                        :class="getPaletteClass(idx)"
                        @click="onJumpTo(idx)">
                        <text class="palette-chip-text" :class="getPaletteTextClass(idx)">{{ idx + 1 }}</text>
                    </view>
                </view>
            </scroll-view>

            <!-- 已答统计 -->
            <view class="answer-summary">
                <text class="answer-summary-text">已答 {{ answeredCount }} / {{ questions.length }}</text>
            </view>

            <!-- 题目卡片 -->
            <view class="question-card">
                <view class="question-header">
                    <text class="question-type-tag">{{ getTypeName(currentQuestion.type) }}</text>
                    <text class="question-score">{{ currentQuestion.score }}分</text>
                </view>
                <text class="question-title">{{ currentQuestion.title }}</text>

                <!-- 选项列表 -->
                <view class="option-list">
                    <view v-for="(opt, idx) in currentQuestion.options" :key="idx"
                        class="option-item"
                        :class="isSelected(opt.key) ? 'option-selected' : ''"
                        @click="onOptionClick(opt.key)">
                        <view class="option-key" :class="isSelected(opt.key) ? 'option-key-selected' : ''">
                            <text class="option-key-text">{{ opt.key }}</text>
                        </view>
                        <text class="option-text">{{ opt.text }}</text>
                    </view>
                </view>
            </view>

            <!-- 操作按钮 -->
            <view class="action-bar">
                <view class="action-btn action-btn-secondary" @click="onPrev">
                    <text class="action-btn-text action-btn-text-secondary">上一题</text>
                </view>
                <view v-if="currentIndex < questions.length - 1" class="action-btn action-btn-primary" @click="onNext">
                    <text class="action-btn-text">下一题</text>
                </view>
                <view v-else class="action-btn action-btn-submit" @click="onSubmitClick">
                    <text class="action-btn-text">交卷</text>
                </view>
            </view>

            <!-- 底部交卷按钮 -->
            <view class="submit-section">
                <view class="submit-btn" @click="onSubmitClick">
                    <text class="submit-btn-text">交卷</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onUnload } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import {
        startMockExamApi,
        resumeMockExamApi,
        saveMockExamApi,
        submitMockExamApi,
    } from '../../api/mockExam'
    import type { MockExamInfo, ExamQuestion, QuestionOption } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 页面参数
    const mode = ref<string>('new')           // new / resume
    const mockExamId = ref<number>(0)
    const initDuration = ref<number>(90)      // 新考试默认时长（分钟）

    // 题目与状态
    const questions = ref<ExamQuestion[]>([])
    const currentIndex = ref<number>(0)
    const loading = ref<boolean>(false)
    const submitting = ref<boolean>(false)

    // 答案存储：{ question_id_string: answer_string }
    // UTSJSONObject 属性变更不会自动触发响应式，用 answersVersion 强制更新依赖
    const answers = ref<UTSJSONObject>({} as UTSJSONObject)
    const answersVersion = ref<number>(0)
    // 当前题选中的 key 列表（单选为单元素，多选可多元素）
    const selectedKeys = ref<string[]>([])

    // 剩余时间（秒）
    const remainingTime = ref<number>(0)
    let timerId : number = 0
    let lastSaveTime : number = 0

    const currentQuestion = computed<ExamQuestion>(() : ExamQuestion => {
        if (questions.value.length == 0) {
            return { question_id: 0, type: '', title: '', options: [] as QuestionOption[], score: 0 } as ExamQuestion
        }
        return questions.value[currentIndex.value]
    })

    const progressPercent = computed<number>(() : number => {
        if (questions.value.length == 0) return 0
        return Math.floor((currentIndex.value + 1) * 100 / questions.value.length)
    })

    /** 已答题数 */
    const answeredCount = computed<number>(() : number => {
        answersVersion.value  // 依赖 answers 变更
        let cnt = 0
        for (let i = 0; i < questions.value.length; i++) {
            const qid = questions.value[i].question_id.toString()
            const ans = answers.value[qid]
            if (ans != null) {
                const ansStr = `${ans}`
                if (ansStr.length > 0) cnt++
            }
        }
        return cnt
    })

    /** 时间显示 MM:SS */
    const timerDisplay = computed<string>(() : string => {
        const total = remainingTime.value
        if (total <= 0) return '00:00'
        const m = Math.floor(total / 60)
        const s = total % 60
        const mm = m < 10 ? '0' + m : '' + m
        const ss = s < 10 ? '0' + s : '' + s
        return mm + ':' + ss
    })

    /** 剩余时间 < 5 分钟，警告 */
    const isTimeWarning = computed<boolean>(() : boolean => {
        return remainingTime.value > 0 && remainingTime.value <= 300 && remainingTime.value > 60
    })

    /** 剩余时间 < 1 分钟，危险 */
    const isTimeDanger = computed<boolean>(() : boolean => {
        return remainingTime.value > 0 && remainingTime.value <= 60
    })

    /** 题型名称 */
    function getTypeName(type : string) : string {
        if (type == 'single' || type == 'single_choice') return '单选题'
        if (type == 'multi' || type == 'multiple_choice' || type == 'multi_choice') return '多选题'
        if (type == 'judge' || type == 'true_false') return '判断题'
        return '其他'
    }

    /** 是否多选题 */
    function isMultiChoice() : boolean {
        const t = currentQuestion.value.type
        return t == 'multi' || t == 'multiple_choice' || t == 'multi_choice'
    }

    /** 选项是否已选中 */
    function isSelected(key : string) : boolean {
        return selectedKeys.value.indexOf(key) >= 0
    }

    /** 题号导航条样式：当前题/已答/未答 */
    function getPaletteClass(idx : number) : string {
        answersVersion.value  // 依赖 answers 变更
        if (idx == currentIndex.value) return 'palette-current'
        const qid = questions.value[idx].question_id.toString()
        const ans = answers.value[qid]
        if (ans != null) {
            const ansStr = `${ans}`
            if (ansStr.length > 0) return 'palette-answered'
        }
        return 'palette-unanswered'
    }

    function getPaletteTextClass(idx : number) : string {
        answersVersion.value  // 依赖 answers 变更
        if (idx == currentIndex.value) return 'palette-text-current'
        const qid = questions.value[idx].question_id.toString()
        const ans = answers.value[qid]
        if (ans != null) {
            const ansStr = `${ans}`
            if (ansStr.length > 0) return 'palette-text-answered'
        }
        return 'palette-text-unanswered'
    }

    /** 点击选项 */
    function onOptionClick(key : string) : void {
        if (isMultiChoice()) {
            const idx = selectedKeys.value.indexOf(key)
            if (idx >= 0) {
                selectedKeys.value.splice(idx, 1)
            } else {
                selectedKeys.value.push(key)
            }
        } else {
            // 单选/判断：替换为单元素数组
            const arr : string[] = [key]
            selectedKeys.value = arr
        }
        // 同步到 answers
        saveCurrentAnswer()
    }

    /** 将当前题选中答案同步到 answers */
    function saveCurrentAnswer() : void {
        const qid = currentQuestion.value.question_id.toString()
        if (selectedKeys.value.length == 0) {
            // 未选或已取消：移除答案
            answers.value[qid] = ''
        } else {
            let ans = ''
            if (isMultiChoice()) {
                // 多选：拷贝并排序后拼接
                const sorted : string[] = []
                for (let i = 0; i < selectedKeys.value.length; i++) {
                    sorted.push(selectedKeys.value[i])
                }
                sorted.sort()
                ans = sorted.join(',')
            } else {
                ans = selectedKeys.value[0]
            }
            answers.value[qid] = ans
        }
        // 触发 answeredCount / palette 重新计算
        answersVersion.value = answersVersion.value + 1
    }

    /** 跳转到指定题号 */
    function onJumpTo(idx : number) : void {
        if (idx == currentIndex.value) return
        // 保存当前题答案
        saveCurrentAnswer()
        currentIndex.value = idx
        loadSelectedKeys()
    }

    /** 从 answers 中加载当前题已选答案到 selectedKeys */
    function loadSelectedKeys() : void {
        selectedKeys.value = [] as string[]
        const qid = currentQuestion.value.question_id.toString()
        const ans = answers.value[qid]
        if (ans == null) return
        const ansStr = `${ans}`
        if (ansStr.length == 0) return
        // 与当前题选项匹配：判断答案是否包含某选项 key
        // 支持 single_choice(A)、multiple_choice(ABC)、true_false(true/false)
        const opts = currentQuestion.value.options
        const arr : string[] = []
        for (let i = 0; i < opts.length; i++) {
            if (ansStr.indexOf(opts[i].key) >= 0) {
                arr.push(opts[i].key)
            }
        }
        selectedKeys.value = arr
    }

    function onPrev() : void {
        if (currentIndex.value <= 0) {
            uni.showToast({ title: '已是第一题', icon: 'none' })
            return
        }
        saveCurrentAnswer()
        currentIndex.value = currentIndex.value - 1
        loadSelectedKeys()
    }

    function onNext() : void {
        if (currentIndex.value >= questions.value.length - 1) return
        saveCurrentAnswer()
        currentIndex.value = currentIndex.value + 1
        loadSelectedKeys()
    }

    /** 启动倒计时 */
    function startTimer() : void {
        stopTimer()
        timerId = setInterval(() : void => {
            if (remainingTime.value > 0) {
                remainingTime.value = remainingTime.value - 1
                // 每 30 秒自动保存
                const now = Date.now()
                if (now - lastSaveTime > 30000) {
                    lastSaveTime = now
                    doSaveProgress(false)
                }
            } else {
                // 时间到，自动交卷
                stopTimer()
                uni.showToast({ title: '考试时间已到，自动交卷', icon: 'none' })
                doSubmit(true)
            }
        }, 1000) as number
    }

    function stopTimer() : void {
        if (timerId != 0) {
            clearInterval(timerId)
            timerId = 0
        }
    }

    /** 保存进度（6.2） */
    async function doSaveProgress(showTip : boolean) : Promise<void> {
        if (mockExamId.value == 0) return
        // 确保当前题答案已同步
        saveCurrentAnswer()
        try {
            await saveMockExamApi(mockExamId.value, answers.value, remainingTime.value)
            lastSaveTime = Date.now()
            if (showTip) {
                uni.showToast({ title: '已保存进度', icon: 'success' })
            }
            console.log('[mock-exam] progress saved, remaining:', remainingTime.value)
        } catch (e) {
            console.warn('[mock-exam] save progress failed:', e)
            if (showTip) {
                uni.showToast({ title: '保存进度失败', icon: 'none' })
            }
        }
    }

    /** 加载题目（开始新考试 6.1 或恢复考试 6.3） */
    async function loadExam() : Promise<void> {
        loading.value = true
        try {
            let info : MockExamInfo
            if (mode.value == 'resume' && mockExamId.value > 0) {
                info = await resumeMockExamApi(mockExamId.value)
            } else {
                info = await startMockExamApi(0, initDuration.value)
            }
            mockExamId.value = info.mock_exam_id
            questions.value = info.questions
            remainingTime.value = info.remaining_time
            console.log('[mock-exam] loaded, mock_exam_id:', info.mock_exam_id, 'questions:', info.questions.length, 'remaining:', info.remaining_time)
            if (questions.value.length == 0) {
                uni.showToast({ title: '暂无题目', icon: 'none' })
            } else {
                startTimer()
            }
        } catch (e) {
            console.error('[mock-exam] load failed:', e)
            let msg = '加载考试失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = msg + ': ' + m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    /** 点击交卷 */
    function onSubmitClick() : void {
        const unanswered = questions.value.length - answeredCount.value
        const content = unanswered > 0
            ? '还有 ' + unanswered + ' 题未作答，确定交卷吗？'
            : '确定要交卷吗？'
        uni.showModal({
            title: '交卷确认',
            content: content,
            success: (res) => {
                if (res.confirm) {
                    doSubmit(false)
                }
            }
        })
    }

    /** 交卷（6.4） */
    async function doSubmit(auto : boolean) : Promise<void> {
        if (submitting.value) return
        if (mockExamId.value == 0) {
            uni.showToast({ title: '考试未开始', icon: 'none' })
            return
        }
        submitting.value = true
        stopTimer()
        // 保存当前题答案
        saveCurrentAnswer()
        uni.showLoading({ title: '正在交卷...', mask: true })
        try {
            // 先保存一次进度，确保后端拿到最新答案
            try {
                await saveMockExamApi(mockExamId.value, answers.value, remainingTime.value)
            } catch (e) {
                console.warn('[mock-exam] save before submit failed:', e)
            }
            // 交卷
            await submitMockExamApi(mockExamId.value)
            uni.hideLoading()
            uni.showToast({ title: '交卷成功', icon: 'success' })
            const examId = mockExamId.value
            // 跳转到成绩页
            setTimeout(() : void => {
                uni.redirectTo({
                    url: '/pages/exam/mock-exam-result?mock_exam_id=' + examId
                })
            }, 800)
        } catch (e) {
            uni.hideLoading()
            console.error('[mock-exam] submit failed:', e)
            let msg = '交卷失败'
            if (e instanceof Error) {
                const errObj = e as Error
                const m = errObj.message
                if (m != null && m.length > 0) {
                    msg = msg + ': ' + m
                }
            }
            uni.showToast({ title: msg, icon: 'none' })
            // 交卷失败，恢复计时
            if (!auto) {
                startTimer()
            }
        } finally {
            submitting.value = false
        }
    }

    function onBack() : void {
        uni.showModal({
            title: '提示',
            content: '退出考试将自动保存进度，下次可继续。确定退出吗？',
            confirmText: '保存并退出',
            success: (res) => {
                if (res.confirm) {
                    doSaveProgress(false).then(() : void => {
                        stopTimer()
                        uni.navigateBack()
                    })
                }
            }
        })
    }

    onLoad((options : UTSJSONObject) => {
        const m = options['mode']
        if (m != null) mode.value = `${m}`
        const id = options['mock_exam_id']
        if (id != null) mockExamId.value = parseInt(`${id}`)
        const dur = options['duration']
        if (dur != null) initDuration.value = parseInt(`${dur}`)
        loadExam()
    })

    onUnload(() : void => {
        stopTimer()
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 120rpx;
        align-items: flex-end;
    }

    .timer-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #ffffff;
        font-family: monospace;
    }

    .timer-text.warning {
        color: #fff3a0;
    }

    .timer-text.danger {
        color: #ff6b6b;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 进度条 */
    .progress-section {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 24rpx 0;
    }

    .progress-bar-wrap {
        flex: 1;
        height: 12rpx;
        background-color: #e0e0e0;
        border-radius: 6rpx;
        overflow: hidden;
        margin-right: 20rpx;
    }

    .progress-bar {
        height: 12rpx;
        background-color: #2979ff;
        border-radius: 6rpx;
    }

    .progress-text {
        font-size: 24rpx;
        color: #666666;
        min-width: 80rpx;
        text-align: right;
    }

    /* 题号导航条 */
    .palette-scroll {
        white-space: nowrap;
        padding: 16rpx 0;
    }

    .palette-list {
        flex-direction: row;
        padding: 0 24rpx;
    }

    .palette-chip {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: #ffffff;
        border: 2rpx solid #e0e0e0;
        align-items: center;
        justify-content: center;
        margin-right: 12rpx;
    }

    .palette-chip.palette-current {
        background-color: #2979ff;
        border-color: #2979ff;
    }

    .palette-chip.palette-answered {
        background-color: #e8f5e9;
        border-color: #4caf50;
    }

    .palette-chip.palette-unanswered {
        background-color: #ffffff;
        border-color: #e0e0e0;
    }

    .palette-chip-text {
        font-size: 24rpx;
        color: #666666;
    }

    .palette-text-current {
        color: #ffffff;
        font-weight: bold;
    }

    .palette-text-answered {
        color: #4caf50;
    }

    .palette-text-unanswered {
        color: #999999;
    }

    /* 已答统计 */
    .answer-summary {
        padding: 0 24rpx 12rpx;
    }

    .answer-summary-text {
        font-size: 24rpx;
        color: #999999;
    }

    /* 题目卡片 */
    .question-card {
        background-color: #ffffff;
        margin: 0 24rpx 24rpx;
        border-radius: 16rpx;
        padding: 32rpx;
        border: 1px solid #eeeeee;
    }

    .question-header {
        flex-direction: row;
        align-items: center;
        margin-bottom: 24rpx;
    }

    .question-type-tag {
        font-size: 22rpx;
        color: #ffffff;
        background-color: #2979ff;
        padding: 6rpx 16rpx;
        border-radius: 8rpx;
        margin-right: 16rpx;
    }

    .question-score {
        font-size: 22rpx;
        color: #ff9800;
        background-color: #fff3e0;
        padding: 6rpx 16rpx;
        border-radius: 8rpx;
    }

    .question-title {
        font-size: 32rpx;
        color: #333333;
        line-height: 48rpx;
        margin-bottom: 32rpx;
    }

    /* 选项列表 */
    .option-list {
        flex-direction: column;
    }

    .option-item {
        flex-direction: row;
        align-items: center;
        padding: 24rpx;
        background-color: #f8f9fa;
        border-radius: 12rpx;
        margin-bottom: 16rpx;
        border: 2rpx solid transparent;
    }

    .option-selected {
        background-color: #e3f2fd;
        border-color: #2979ff;
    }

    .option-key {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: #e0e0e0;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
    }

    .option-key-selected {
        background-color: #2979ff;
    }

    .option-key-text {
        font-size: 28rpx;
        font-weight: bold;
        color: #666666;
    }

    .option-key-selected .option-key-text {
        color: #ffffff;
    }

    .option-text {
        flex: 1;
        font-size: 28rpx;
        color: #333333;
    }

    /* 操作按钮 */
    .action-bar {
        flex-direction: row;
        padding: 0 24rpx 24rpx;
    }

    .action-btn {
        flex: 1;
        align-items: center;
        padding: 24rpx 0;
        border-radius: 48rpx;
        margin: 0 12rpx;
    }

    .action-btn-secondary {
        background-color: #f5f5f5;
        border: 1px solid #e0e0e0;
    }

    .action-btn-primary {
        background-color: #2979ff;
    }

    .action-btn-submit {
        background-color: #4caf50;
    }

    .action-btn-text {
        font-size: 30rpx;
        font-weight: bold;
        color: #ffffff;
    }

    .action-btn-text-secondary {
        color: #666666;
    }

    /* 底部交卷按钮 */
    .submit-section {
        padding: 0 24rpx 48rpx;
    }

    .submit-btn {
        align-items: center;
        padding: 24rpx 0;
        border-radius: 48rpx;
        background-color: #ff5722;
    }

    .submit-btn-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #ffffff;
    }

    /* 加载/空状态 */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
