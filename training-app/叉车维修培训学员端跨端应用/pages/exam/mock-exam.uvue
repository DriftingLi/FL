<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">模拟考试</text>
            <view class="header-right">
                <text class="timer-text" :class="{ warning: session.isTimeWarning.value, danger: session.isTimeDanger.value }">{{ session.timerDisplay.value }}</text>
            </view>
        </view>

        <!-- 加载中 -->
        <view v-if="session.loading.value && session.questions.value.length == 0" class="loading-wrap">
            <text class="loading-text">正在加载题目...</text>
        </view>

        <!-- 加载失败（组卷/续考失败不再回退假题，直接重试） -->
        <view v-else-if="session.questions.value.length == 0 && session.loadError.value.length > 0" class="empty-wrap">
            <text class="empty-text">{{ session.loadError.value }}</text>
            <view class="retry-btn" @click="onRetry">
                <text class="retry-btn-text">点击重试</text>
            </view>
        </view>

        <!-- 空数据 -->
        <view v-else-if="session.questions.value.length == 0" class="empty-wrap">
            <text class="empty-text">暂无题目</text>
        </view>

        <!-- 答题区域 -->
        <scroll-view v-else class="content-scroll" scroll-y="true">
            <!-- 进度条 -->
            <view class="progress-section">
                <view class="progress-bar-wrap">
                    <view class="progress-bar" :style="{ width: session.progressPercent.value + '%' }"></view>
                </view>
                <text class="progress-text">{{ session.currentIndex.value + 1 }} / {{ session.questions.value.length }}</text>
            </view>

            <!-- 题号导航条 -->
            <scroll-view class="palette-scroll" scroll-x="true">
                <view v-for="(q, idx) in session.questions.value" :key="idx"
                    class="palette-chip"
                    :class="session.getPaletteClass(idx)"
                    @click="onJumpTo(idx)">
                    <text class="palette-chip-text" :class="session.getPaletteTextClass(idx)">{{ idx + 1 }}</text>
                </view>
            </scroll-view>

            <!-- 已答统计 -->
            <view class="answer-summary">
                <text class="answer-summary-text">已答 {{ session.answeredCount.value }} / {{ session.questions.value.length }}</text>
            </view>

            <!-- 题目卡片 + 选项列表 -->
            <ExamQuestionCard
                :type-name="session.currentTypeName.value"
                :score="session.currentQuestion.value.score"
                :title="session.currentQuestion.value.title"
                :options="session.currentQuestion.value.options"
                :selected-keys="session.selectedKeys.value"
                @option-click="onOptionClick" />

            <!-- 操作按钮 + 底部交卷 -->
            <ExamActionBar
                :is-last="session.currentIndex.value >= session.questions.value.length - 1"
                @prev="onPrev"
                @next="onNext"
                @submit-click="onSubmitClick" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { onLoad, onUnload } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { useMockExamSession } from './composables/useMockExamSession'
    import ExamQuestionCard from './components/exam-question-card.uvue'
    import ExamActionBar from './components/exam-action-bar.uvue'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 会话状态机（组卷/计时/答题态/存进度/交卷）全部下沉 composable，页面只保留模板与薄包装
    const session = useMockExamSession()

    function onBack() : void {
        uni.showModal({
            title: '提示',
            content: '退出考试将自动保存进度，下次可继续。确定退出吗？',
            confirmText: '保存并退出',
            success: (res) => {
                if (res.confirm) {
                    session.doSaveProgress(false).then(() : void => {
                        session.stopTimer()
                        goBack()
                    })
                }
            }
        })
    }

    function onRetry() : void { session.loadExam() }
    function onOptionClick(key : string) : void { session.onOptionClick(key) }
    function onJumpTo(idx : number) : void { session.onJumpTo(idx) }
    function onPrev() : void { session.onPrev() }
    function onNext() : void { session.onNext() }
    function onSubmitClick() : void { session.onSubmitClick() }

    onLoad((options : UTSJSONObject) => {
        session.applyOptions(options)
        session.boot()
    })

    onUnload(() : void => {
        session.stopTimer()
    })
</script>

<style>
    .container {
        display: flex;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #2979ff;
    }

    .header {
        background-color: #2979ff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 80rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #ffffff;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #ffffff;
        text-align: center;
    }

    .header-right {
        width: 120rpx;
        align-items: flex-end;
    }

    .timer-text {
        font-size: 32rpx;
        font-weight: bold;
        color: #ffffff;
        font-family: monospace;
    }

    .timer-text.warning {
        color: #fff3a0;
    }

    .timer-text.danger {
        color: #ff6b6b;
    }

    .content-scroll {
        flex: 1;
        height: 0;
    }

    /* 进度条 */
    .progress-section {
        flex-direction: row;
        align-items: center;
        padding: 24rpx 24rpx 0;
    }

    .progress-bar-wrap {
        flex: 1;
        height: 12rpx;
        background-color: #e0e0e0;
        border-radius: 6rpx;
        overflow: hidden;
        margin-right: 20rpx;
    }

    .progress-bar {
        height: 12rpx;
        background-color: #2979ff;
        border-radius: 6rpx;
    }

    .progress-text {
        font-size: 24rpx;
        color: #666666;
        min-width: 80rpx;
        text-align: right;
    }

    /* 题号导航条 */
    .palette-scroll {
        white-space: nowrap;
        flex-direction: row;
        align-items: center;
        padding: 16rpx 24rpx;
    }

    .palette-chip {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: #ffffff;
        border: 2rpx solid #e0e0e0;
        align-items: center;
        justify-content: center;
        margin-right: 12rpx;
        flex-shrink: 0;
    }

    .palette-chip.palette-current {
        background-color: #2979ff;
        border-color: #2979ff;
    }

    .palette-chip.palette-answered {
        background-color: #e8f5e9;
        border-color: #4caf50;
    }

    .palette-chip.palette-unanswered {
        background-color: #ffffff;
        border-color: #e0e0e0;
    }

    .palette-chip-text {
        font-size: 24rpx;
        color: #666666;
    }

    .palette-text-current {
        color: #ffffff;
        font-weight: bold;
    }

    .palette-text-answered {
        color: #4caf50;
    }

    .palette-text-unanswered {
        color: #999999;
    }

    /* 已答统计 */
    .answer-summary {
        padding: 0 24rpx 12rpx;
    }

    .answer-summary-text {
        font-size: 24rpx;
        color: #999999;
    }

    /* 加载/空状态 */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .empty-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .loading-text {
        font-size: 28rpx;
        color: #999999;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .retry-btn {
        margin-top: 24rpx;
        padding: 16rpx 48rpx;
        background-color: #2979ff;
        border-radius: 40rpx;
    }

    .retry-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }
</style>
