<template>
    <!-- #810：等级考试两段已随后端 #284/#285 退役摘除，本页仅保留模拟考试段 -->
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">考试中心</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true">

            <!-- 模拟考试入口 -->
            <view class="section">
                <view class="section-header">
                    <text class="section-title">模拟考试</text>
                    <text class="section-link" @click="onViewMockHistory">模考历史 ›</text>
                </view>
                <view class="mock-exam-card" @click="onStartMockExam">
                    <view class="mock-exam-info">
                        <text class="mock-exam-title">随机模拟考试</text>
                        <text class="mock-exam-desc">从题库随机抽题，模拟真实考试环境</text>
                    </view>
                    <view class="mock-exam-action">
                        <text class="action-btn">开始模考</text>
                    </view>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ===== 入口 =====

    function onStartMockExam() : void {
        uni.showModal({
            title: '模拟考试',
            content: '即将开始随机模拟考试，确认开始？',
            success: (res) => {
                if (res.confirm) {
                    uni.navigateTo({
                        url: '/pages/exam/mock-exam?mode=new&duration=90'
                    })
                }
            }
        })
    }

    function onViewMockHistory() : void {
        uni.navigateTo({ url: '/pages/profile/mock-exam-records' })
    }

    function onBack() : void {
        goBack()
    }
</script>

