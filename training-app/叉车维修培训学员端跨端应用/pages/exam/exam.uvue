	}

	.action-btn {
		font-size: 26rpx;
		color: #ffffff;
		background-color: #2979ff;
		padding: 12rpx 32rpx;
		border-radius: 24rpx;
	}

	.action-btn-secondary {
		font-size: 26rpx;
		color: #666666;
		background-color: #f5f5f5;
		padding: 12rpx 32rpx;
		border-radius: 24rpx;
	}

	.empty-tip {
		align-items: center;
