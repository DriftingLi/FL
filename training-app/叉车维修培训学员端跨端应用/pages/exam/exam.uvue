	.header {
		background-color: #2979ff;
		padding: 16rpx 32rpx;
		align-items: center;
	}

	.header-title {
		font-size: 36rpx;
		font-weight: bold;
		color: #ffffff;
	}

	.content-scroll {
		flex: 1;
	}

	.stats-section {
		background-color: #ffffff;
		padding: 24rpx;
	}

	.stats-row {
		flex-direction: row;
		justify-content: space-around;
	}

	.stat-box {
		flex-direction: column;
		align-items: center;
		flex: 1;
	}

	.stat-num {
		font-size: 44rpx;
		font-weight: bold;
		color: #2979ff;
		margin-bottom: 8rpx;
	}

	.stat-label {
		font-size: 24rpx;
		color: #999999;
	}

	.section {
		background-color: #ffffff;
		margin-top: 16rpx;
		padding: 24rpx;
	}

	.section-header {
		margin-bottom: 20rpx;
	}

	.section-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
	}

	.mock-exam-card {
		flex-direction: row;
		align-items: center;
		padding: 24rpx;
		background-color: #f0f7ff;
		border-radius: 12rpx;
	}

	.mock-exam-info {
		flex: 1;
		flex-direction: column;
	}

	.mock-exam-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
		margin-bottom: 8rpx;
	}

	.mock-exam-desc {
		font-size: 24rpx;
		color: #666666;
	}

	.mock-exam-action {
		margin-left: 20rpx;
	}

	.exam-list {
		flex-direction: column;
	}

	.exam-item {
		flex-direction: row;
		align-items: center;
		padding: 24rpx 0;
		border-bottom: 1rpx solid #f5f5f5;
	}

	.exam-item:last-child {
		border-bottom: none;
	}

	.exam-info {
		flex: 1;
		flex-direction: column;
	}

	.exam-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
		margin-bottom: 8rpx;
	}

	.exam-desc {
		font-size: 24rpx;
		color: #999999;
		margin-bottom: 12rpx;
	}

	.exam-meta {
		flex-direction: row;
		align-items: center;
	}

	.exam-tag {
		font-size: 20rpx;
		color: #ffffff;
		background-color: #ff9800;
		padding: 4rpx 16rpx;
		border-radius: 8rpx;
		margin-right: 16rpx;
	}

	.exam-tag.passed {
		background-color: #4caf50;
	}

	.exam-time {
		font-size: 22rpx;
