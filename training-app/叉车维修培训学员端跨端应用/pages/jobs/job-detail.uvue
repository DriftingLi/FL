<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="职位详情" @left-click="onBack" divider>
            <template #right>
                <view class="nav-action" @click="toggleFavorite">
                    <text class="favorite-icon">{{ isFavorited ? '♥' : '♡' }}</text>
                </view>
                <text v-if="!hasReported" class="report-btn" @click="onOpenReport">举报</text>
            </template>
        </app-nav-bar>

        <!-- 加载中 -->
        <view v-if="loading" class="loading-wrap">
            <text class="loading-text">加载中...</text>
        </view>

        <!-- 职位详情 -->
        <scroll-view v-else-if="job != null" class="content-scroll" scroll-y="true">
            <!-- 职位基本信息 -->
            <view class="job-section">
                <text class="job-title">{{ job!.title }}</text>
                <text class="job-company">{{ job!.company_name }}</text>
            </view>

            <!-- 薪资与信息 -->
            <view class="info-section">
                <view class="info-row">
                    <text class="info-icon">💰</text>
                    <text class="info-value info-salary">{{ formatSalary() }}</text>
                </view>
                <view class="info-row">
                    <text class="info-icon">📍</text>
                    <text class="info-value">{{ job!.region.length > 0 ? job!.region : '未填写' }}</text>
                </view>
                <view class="info-row">
                    <text class="info-icon">📋</text>
                    <text class="info-value">{{ job!.experience_req.length > 0 ? job!.experience_req : '不限' }}</text>
                </view>
                <view class="info-row">
                    <text class="info-icon">🕐</text>
                    <text class="info-value">{{ formatDate(job!.published_at) }}</text>
                </view>
            </view>

            <!-- 职位描述 -->
            <view class="desc-section">
                <text class="desc-title">职位描述</text>
                <text class="desc-content">{{ job!.description.length > 0 ? job!.description : '暂无描述' }}</text>
            </view>
        </scroll-view>

        <!-- 底部投递按钮：三态由服务端 apply_state 决定（#1199） -->
        <view v-if="job != null && !loading" class="bottom-bar">
            <view v-if="applyState() == 'none'" class="apply-btn" @click="onApply">
                <text class="apply-btn-text">立即投递</text>
            </view>
            <view v-else-if="applyState() == 'applied'" class="apply-btn-disabled">
                <text class="apply-btn-text-disabled">已投递</text>
            </view>
            <view v-else class="apply-btn-disabled">
                <text class="apply-btn-text-disabled">{{ cooldownText() }}</text>
            </view>
        </view>

        <!-- 举报弹窗 -->
        <view v-if="showReportModal" class="report-modal-mask" @click="onCloseReport">
            <view class="report-modal" @click.stop>
                <text class="report-modal-title">举报职位</text>

                <!-- 预设原因选项 -->
                <view class="report-options">
                    <view v-for="(option, idx) in reportReasons" :key="idx" class="report-option"
                        @click="onSelectReason(option.key)">
                        <view class="report-radio" :class="{ 'report-radio-active': selectedReason === option.key }">
                            <view v-if="selectedReason === option.key" class="report-radio-dot"></view>
                        </view>
                        <text class="report-option-text">{{ option.label }}</text>
                    </view>
                </view>

                <!-- 自定义原因输入（选择「其他」时显示） -->
                <view v-if="selectedReason === 'other'" class="report-custom-wrap">
                    <textarea class="report-textarea" placeholder="请输入举报原因（1-500字）" maxlength="500"
                        v-model="customReason" />
                    <text class="report-counter">{{ customReason.length }}/500</text>
                </view>

                <!-- 操作按钮 -->
                <view class="report-actions">
                    <view class="report-cancel" @click="onCloseReport">
                        <text class="report-cancel-text">取消</text>
                    </view>
                    <view class="report-confirm"
                        :class="{ disabled: !canSubmitReport || submittingReport }" @click="onSubmitReport">
                        <text class="report-confirm-text">{{ submittingReport ? '提交中...' : '提交' }}</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { getJobDetailApi, reportJobApi, applyJobApi, REPORT_REASONS } from '../../api/job'
    import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../../api/favorite'
    import type { JobPosting, ReportReason } from '../../types/index'
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 职位数据 ----
    const job = ref<JobPosting | null>(null)
    const loading = ref<boolean>(true)
    const jobId = ref<number>(0)

    // ---- 收藏（#1946）----
    // 与 course-detail 同形：isFavorited 只是**服务端态的回显**，真值来自 GET /favorites/check；
    // favoriteId 是取消收藏的句柄（DELETE /favorites/:id 只认它，不是 target_id）。
    const isFavorited = ref<boolean>(false)
    const favoriteId = ref<number>(0)

    // ---- 举报相关 ----
    const showReportModal = ref<boolean>(false)
    const reportReasons = REPORT_REASONS
    const selectedReason = ref<string>('')
    const customReason = ref<string>('')
    const submittingReport = ref<boolean>(false)
    const hasReported = ref<boolean>(false)

    // ---- 投递相关 ----
    // #1199：投递态来自服务端的 apply_state（'' 可投 / applied 已投递 / not_hired 冷却中 + cooldown_days），
    // **不再用页面本地布尔量**——本地量在页面重建后归零，会让投过的职位按钮复活、点了吃 400。
    // justApplied 只覆盖"投递成功后还没离开本页"这一瞬间；重进页面由 loadJobDetail() 重新取服务端状态。
    const justApplied = ref<boolean>(false)

    /** 当前投递态：'applied' / 'not_hired' / 'none' */
    function applyState() : string {
        if (justApplied.value) return 'applied'
        const j = job.value
        if (j == null) return 'none'
        if (j.apply_state != null && j.apply_state!.length > 0) return j.apply_state!
        return 'none'
    }

    /** 冷却中文案：'not_hired' 时带剩余天数 */
    function cooldownText() : string {
        const j = job.value
        if (j == null) return '暂不可投递'
        // 可空字段参与比较/运算必须 ?? 兜底（AGENTS.md「Kotlin 编译期常见错误」：nullable receiver）
        const days = j.cooldown_days ?? 0
        return days > 0 ? (days.toString() + ' 天后可再次投递') : '暂不可投递'
    }

    async function loadJobDetail() : Promise<void> {
        loading.value = true
        try {
            const detail = await getJobDetailApi(jobId.value)
            job.value = detail
        } catch (e) {
            console.error('[job-detail] load failed:', e)
            uni.showToast({ title: '加载失败', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1500)
        } finally {
            loading.value = false
        }
    }

    /**
     * 拉取收藏态（#1946）。
     *
     * 失败**不弹提示**：收藏是详情页的次动作，静默降级成「未收藏」比给一个加载失败 toast 更合理
     * （与 course-detail 的 loadFavoriteStatus 同口径）；真出错时下一次点击会走 add 分支、
     * 由收藏接口自己报错。
     */
    async function loadFavoriteStatus() : Promise<void> {
        if (jobId.value <= 0) return
        try {
            const result = await checkFavoriteApi('job', jobId.value)
            isFavorited.value = result.favorited
            favoriteId.value = result.favorite_id
        } catch (e) {
            console.warn('[job-detail] checkFavorite failed:', e)
        }
    }

    /**
     * 收藏 ↔ 取消收藏往返（#1946 AC 第一条：即时生效）。
     *
     * 两条分支都**先落本地态再等网络**是不行的——收藏接口幂等但取消只认 favoriteId，
     * 失败后本地态与库里不一致就再也对不回来。故一律「先成功、后改本地态」。
     */
    async function toggleFavorite() : Promise<void> {
        if (jobId.value <= 0) return
        try {
            if (isFavorited.value) {
                await removeFavoriteApi(favoriteId.value)
                isFavorited.value = false
                favoriteId.value = 0
                uni.showToast({ title: '已取消收藏', icon: 'none' })
            } else {
                const result = await addFavoriteApi('job', jobId.value)
                isFavorited.value = true
                favoriteId.value = result.favorite_id
                uni.showToast({ title: '收藏成功', icon: 'none' })
            }
        } catch (e) {
            console.error('[job-detail] toggleFavorite failed:', e)
        }
    }

    // ---- 页面加载 ----
    onLoad((_options : any) => {
        const opts = _options as UTSJSONObject | null
        const id = opts != null ? opts['id'] : null
        if (id != null && (id as string).length > 0) {
            jobId.value = parseInt(id as string)
            loadJobDetail()
            loadFavoriteStatus()
        } else {
            uni.showToast({ title: '职位不存在', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1500)
        }
    })

    // ---- 薪资格式化 ----
    function formatSalary() : string {
        if (job.value == null) return ''
        const j = job.value!
        if (j.salary_text.length > 0) return j.salary_text
        if (j.salary_min != null && j.salary_max != null) {
            return j.salary_min!.toString() + '-' + j.salary_max!.toString() + ' 元/月'
        }
        if (j.salary_min != null) return j.salary_min!.toString() + ' 元/月起'
        return '面议'
    }

    // ---- 日期格式化 ----
    function formatDate(dateStr : string) : string {
        if (dateStr.length == 0) return ''
        try {
            const d = new Date(dateStr)
            const y = d.getFullYear()
            const m = (d.getMonth() + 1).toString().padStart(2, '0')
            const day = d.getDate().toString().padStart(2, '0')
            return y + '-' + m + '-' + day + ' 发布'
        } catch (e) {
            return dateStr
        }
    }

    // ---- 返回 ----
    function onBack() : void {
        uni.navigateBack()
    }

    // ---- 举报弹窗 ----
    function onOpenReport() : void {
        selectedReason.value = ''
        customReason.value = ''
        showReportModal.value = true
    }

    function onCloseReport() : void {
        showReportModal.value = false
        selectedReason.value = ''
        customReason.value = ''
    }

    function onSelectReason(key : string) : void {
        selectedReason.value = key
    }

    const canSubmitReport = computed<boolean>(() : boolean => {
        if (selectedReason.value.length == 0) return false
        if (selectedReason.value == 'other') return customReason.value.trim().length > 0
        return true
    })

    async function onSubmitReport() : Promise<void> {
        if (!canSubmitReport.value || submittingReport.value) return
        submittingReport.value = true
        try {
            const reason = selectedReason.value === 'other'
                ? customReason.value.trim()
                : reportReasons.find((r : ReportReason) => r.key === selectedReason.value)?.label ?? selectedReason.value
            await reportJobApi(jobId.value, reason)
            uni.showToast({ title: '举报已提交，感谢你的反馈', icon: 'none' })
            hasReported.value = true
            showReportModal.value = false
        } catch (e) {
            console.error('[job-detail] report failed:', e)
            uni.showToast({ title: '举报失败，请稍后重试', icon: 'none' })
        } finally {
            submittingReport.value = false
        }
    }

    // ---- 投递 ----
    async function onApply() : Promise<void> {
        // 只有可投态才发请求：本地守卫用服务端态判断，避免"按钮复活 → 点了吃 400"（#1199）
        if (applyState() != 'none') return
        try {
            await applyJobApi(jobId.value)
            uni.showToast({ title: '投递成功', icon: 'none' })
            justApplied.value = true
        } catch (e) {
            console.error('[job-detail] apply failed:', e)
            // 错误信息已由 request 层 toast
        }
    }
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: $bg-color;
        flex-direction: column;
    }

    .content-scroll {
        flex: 1;
    }

    /* 顶部导航栏 */
    .report-btn {
        font-size: 28rpx;
        color: $danger-color;
    }

    .report-btn-disabled {
        font-size: 28rpx;
        color: $text-disabled;
    }

    /* 收藏按钮（#1946）：右槽是 .nav-bar-side（flex-direction: row）⇒ 与「举报」并排。
       两态都渲染字形（♥ 已收藏 / ♡ 未收藏），靠实心/空心区分 —— 与 course-detail 同一套先例
       （未收藏态渲染空串 = 点击区在、却看不见，观感等同没有该功能，#1140 教训）。 */
    .nav-action {
        width: 64rpx;
        height: 64rpx;
        align-items: center;
        justify-content: center;
        margin-right: 8rpx;
    }

    .favorite-icon {
        font-size: 40rpx;
        color: $text-color;
    }

    /* 加载中 */
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }

    .loading-text {
        font-size: 28rpx;
        color: $text-color-placeholder;
    }

    /* 职位基本信息 */
    .job-section {
        background-color: $card-bg;
        padding: 32rpx 24rpx;
        margin-bottom: 16rpx;
    }

    .job-title {
        font-size: 40rpx;
        font-weight: bold;
        color: $text-color;
        margin-bottom: 12rpx;
    }

    .job-company {
        font-size: 28rpx;
        color: $text-color-secondary;
    }

    /* 信息行 */
    .info-section {
        background-color: $card-bg;
        padding: 24rpx;
        margin-bottom: 16rpx;
    }

    .info-row {
        flex-direction: row;
        align-items: center;
        padding: 16rpx 0;
    }

    .info-icon {
        font-size: 32rpx;
        margin-right: 16rpx;
        width: 48rpx;
    }

    .info-value {
        font-size: 28rpx;
        color: $text-color;
        flex: 1;
    }

    .info-salary {
        font-size: 32rpx;
        font-weight: bold;
        color: #ff6b35;
    }

    /* 职位描述 */
    .desc-section {
        background-color: $card-bg;
        padding: 24rpx;
    }

    .desc-title {
        font-size: 32rpx;
        font-weight: bold;
        color: $text-color;
        margin-bottom: 16rpx;
    }

    .desc-content {
        font-size: 28rpx;
        color: $text-color-secondary;
        line-height: 1.6;
    }

    /* 底部投递按钮 */
    .bottom-bar {
        padding: 16rpx 24rpx;
        padding-bottom: 16rpx;
        background-color: $card-bg;
        border-top: 1rpx solid $border-color-light;
    }

    .apply-btn {
        height: 88rpx;
        background-color: #2979ff;
        border-radius: 44rpx;
        align-items: center;
        justify-content: center;
    }

    .apply-btn-text {
        font-size: 32rpx;
        font-weight: bold;
        color: $text-color-inverse;
    }

    .apply-btn-disabled {
        height: 88rpx;
        background-color: $bg-color;
        border-radius: 44rpx;
        align-items: center;
        justify-content: center;
    }

    .apply-btn-text-disabled {
        font-size: 32rpx;
        color: $text-color-placeholder;
    }

    /* 举报弹窗 */
    .report-modal-mask {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

    .report-modal {
        width: 600rpx;
        background-color: $card-bg;
        border-radius: 24rpx;
        padding: 40rpx;
        flex-direction: column;
    }

    .report-modal-title {
        font-size: 32rpx;
        font-weight: bold;
        color: $text-color;
        text-align: center;
        margin-bottom: 32rpx;
    }

    /* 预设选项 */
    .report-options {
        flex-direction: column;
        margin-bottom: 24rpx;
    }

    .report-option {
        flex-direction: row;
        align-items: center;
        padding: 20rpx 0;
    }

    .report-radio {
        width: 40rpx;
        height: 40rpx;
        border-radius: 20rpx;
        border: 2rpx solid $text-disabled;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .report-radio-active {
        border-color: #2979ff;
    }

    .report-radio-dot {
        width: 20rpx;
        height: 20rpx;
        border-radius: 10rpx;
        background-color: #2979ff;
    }

    .report-option-text {
        font-size: 28rpx;
        color: $text-color;
    }

    /* 自定义原因 */
    .report-custom-wrap {
        margin-bottom: 16rpx;
    }

    .report-textarea {
        width: 100%;
        height: 200rpx;
        background-color: $bg-color;
        border-radius: 12rpx;
        padding: 20rpx;
        font-size: 28rpx;
        color: $text-color;
        margin-bottom: 8rpx;
    }

    .report-counter {
        font-size: 22rpx;
        color: $text-color-placeholder;
        text-align: right;
    }

    /* 操作按钮 */
    .report-actions {
        flex-direction: row;
        justify-content: space-between;
    }

    .report-cancel {
        flex: 1;
        height: 80rpx;
        border-radius: 40rpx;
        background-color: $bg-color;
        align-items: center;
        justify-content: center;
        margin-right: 16rpx;
    }

    .report-cancel-text {
        font-size: 28rpx;
        color: $text-color-secondary;
    }

    .report-confirm {
        flex: 1;
        height: 80rpx;
        border-radius: 40rpx;
        background-color: #2979ff;
        align-items: center;
        justify-content: center;
    }

    .report-confirm.disabled {
        background-color: $text-disabled;
    }

    .report-confirm-text {
        font-size: 28rpx;
        color: $text-color-inverse;
        font-weight: 500;
    }
</style>
