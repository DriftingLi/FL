<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">职位广场</text>
            <view class="header-right"></view>
        </view>

        <!-- 筛选标签 -->
        <view class="filter-row">
            <view v-for="(tag, idx) in filterTags" :key="idx"
                :class="{ 'filter-tag': true, 'ml-16': idx > 0, 'filter-tag-active': activeFilter == idx }" @click="onFilterChange(idx)">
                <text class="filter-tag-text" :class="{ 'filter-tag-text-active': activeFilter == idx }">{{ tag.label }}</text>
            </view>
        </view>

        <!-- 职位列表 -->
        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 我的简历入口（#705 重挂，B 定稿：真实 ResumeData 字段算完善度，后端零改动；人口学字段/Lv/收藏统计不做） -->
            <view class="mine-section">
                <view class="mine-card" @click="onResume">
                    <image v-if="avatarUrl.length > 0" class="mine-avatar" :src="avatarUrl" mode="aspectFill" />
                    <view v-else class="mine-avatar-placeholder">
                        <text class="mine-avatar-icon">👷</text>
                    </view>
                    <view class="mine-info">
                        <text class="mine-name">{{ displayName }}</text>
                    </view>
                </view>
                <view class="mine-resume-card" @click="onResume">
                    <view class="mine-resume-head">
                        <text class="mine-resume-title">简历完善度 {{ resumePct }}%</text>
                        <view class="mine-resume-btn">
                            <text class="mine-resume-btn-text">去完善</text>
                        </view>
                    </view>
                    <view class="mine-prog-wrap">
                        <view class="mine-prog-bar" :style="{ width: resumePct + '%' }"></view>
                    </view>
                    <text class="mine-resume-sub">{{ resumeFilledCount }}/8 项已填写</text>
                </view>
                <view class="mine-func-row">
                    <view class="mine-func-card" @click="onResumeEdit">
                        <text class="mine-func-icon">📝</text>
                        <text class="mine-func-title">在线简历</text>
                        <text class="mine-func-hint">优化增加推荐</text>
                    </view>
                    <view class="mine-func-card ml-16" @click="onResumeAttach">
                        <text class="mine-func-icon">📁</text>
                        <text class="mine-func-title">附件简历</text>
                        <text class="mine-func-hint">制作/上传</text>
                    </view>
                </view>
            </view>
            <view v-if="jobs.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon">💼</text>
                <text class="empty-text">暂无职位信息</text>
            </view>
            <view class="job-list">
                <view v-for="job in jobs" :key="job.id" class="job-card" @click="onJobDetail(job.id)">
                    <view class="job-card-header">
                        <text class="job-company">{{ job.company_name }}</text>
                    </view>
                    <text class="job-title">{{ job.title }}</text>
                    <view class="job-info-row">
                        <text class="job-salary">{{ formatSalary(job) }}</text>
                        <text class="job-location">{{ job.region.length > 0 ? job.region : '未填写' }}</text>
                    </view>
                    <text class="job-desc" numberOfLines="2">{{ job.description.length > 0 ? job.description : '暂无描述' }}</text>
                    <view class="job-divider"></view>
                    <view class="job-actions">
                        <view class="job-action-btn job-action-detail" @click.stop="onJobDetail(job.id)">
                            <text class="job-action-text job-action-detail-text">查看详情</text>
                        </view>
                        <view class="job-action-btn job-action-apply" @click.stop="onJobApply(job.id)">
                            <text class="job-action-text job-action-apply-text">立即投递</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 加载更多 -->
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="noMore && jobs.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad, onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { getJobListApi } from '../../api/job'
    import { getCatalogTreeSpecialties } from '../../api/course'
    import { getResumeApi } from '../../api/resume'
    import { useAuthStore } from '../../stores/auth'
    import type { JobPosting } from '../../api/job'
    import type { ResumeData } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 我的简历入口（#705 重挂：真实登录态，不引假数据）----
    const authStore = useAuthStore()
    const avatarUrl = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })
    const displayName = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.username != null && u.username.length > 0) {
            return u.username
        }
        return '学员'
    })

    // ---- 简历完善度（B 定稿：真实 ResumeData 八项字段计算，GET /resume 现有契约）----
    const RESUME_FIELD_TOTAL = 8
    const resumeFilledCount = ref<number>(0)
    const resumePct = computed<number>(() : number => {
        return Math.floor(resumeFilledCount.value * 100 / RESUME_FIELD_TOTAL)
    })

    function countResumeFilled(r : ResumeData) : number {
        let n = 0
        if (r.real_name.length > 0) n = n + 1
        if (r.contact_phone.length > 0) n = n + 1
        if (r.wechat.length > 0) n = n + 1
        if (r.region.length > 0) n = n + 1
        if (r.expected_position_extra.length > 0) n = n + 1
        if (r.salary_min > 0 || r.salary_max > 0 || r.salary_negotiable) n = n + 1
        if (r.experience_years > 0) n = n + 1
        if (r.self_intro.length > 0) n = n + 1
        return n
    }

    function loadResumeStatus() : void {
        getResumeApi().then((r : ResumeData) : void => {
            resumeFilledCount.value = countResumeFilled(r)
        }).catch(() : void => {
            // 未建简历（404）或加载失败：按 0% 呈现，卡片本身即引导，不打断职位浏览
            resumeFilledCount.value = 0
        })
    }

    // ---- 筛选标签 ----
    type FilterTag = { label : string, id : number }
    const filterTags = ref<FilterTag[]>([{ label: '全部', id: 0 }])
    const activeFilter = ref<number>(0)

    // ---- 职位数据 ----
    const jobs = ref<JobPosting[]>([])
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const page = ref<number>(1)
    const PAGE_SIZE = 20

    // ---- 筛选标签加载 ----
    async function loadFilters() : Promise<void> {
        try {
            const specialties = await getCatalogTreeSpecialties()
            const tags : FilterTag[] = [{ label: '全部', id: 0 }]
            for (const s of specialties) {
                tags.push({ label: s.name, id: s.specialty_id })
            }
            filterTags.value = tags
        } catch (e) {
            // 降级：仅显示「全部」
        }
    }

    // ---- 职位列表加载 ----
    async function loadJobs(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
            jobs.value = []
        }
        if (noMore.value) return
        loading.value = true
        try {
            const activeTag = filterTags.value[activeFilter.value]
            const specialtyId = activeTag != null ? activeTag.id : 0
            const result = await getJobListApi({
                page: page.value,
                page_size: PAGE_SIZE,
                specialty_id: specialtyId > 0 ? specialtyId : null,
            })
            if (reset) {
                jobs.value = result.items
            } else {
                jobs.value = jobs.value.concat(result.items)
            }
            if (result.items.length < PAGE_SIZE || jobs.value.length >= result.total) {
                noMore.value = true
            }
            page.value++
        } catch (e) {
            uni.showToast({ title: '加载失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // ---- 生命周期 ----
    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17
    onLoad((options : OnLoadOptions) => {
        loadFilters()
        loadJobs(true)
    })

    // 首次进入与编辑简历返回时都刷新完善度（onShow 覆盖 onLoad 后首触发）
    onShow(() => {
        loadResumeStatus()
    })

    function onFilterChange(idx : number) : void {
        activeFilter.value = idx
        loadJobs(true)
    }

    // ---- 薪资格式化 ----
    function formatSalary(job : JobPosting) : string {
        if (job.salary_text.length > 0) return job.salary_text
        if (job.salary_min != null && job.salary_max != null) {
            return job.salary_min!.toString() + '-' + job.salary_max!.toString() + ' 元/月'
        }
        if (job.salary_min != null) return job.salary_min!.toString() + ' 元/月起'
        return '面议'
    }

    // ---- 导航 ----
    function onBack() : void {
        uni.navigateBack()
    }

    function onJobDetail(jobId : number) : void {
        uni.navigateTo({ url: '/pages/jobs/job-detail?id=' + jobId })
    }

    function onJobApply(jobId : number) : void {
        uni.navigateTo({ url: '/pages/jobs/job-detail?id=' + jobId })
    }

    // ---- 简历入口导航（#705：资料卡→总览，两功能卡直跳编辑/附件）----
    function onResume() : void {
        uni.navigateTo({ url: '/pages/resume/resume' })
    }

    function onResumeEdit() : void {
        uni.navigateTo({ url: '/pages/resume/resume-edit' })
    }

    function onResumeAttach() : void {
        uni.navigateTo({ url: '/pages/resume/resume-attach' })
    }

    function onLoadMore() : void {
        loadJobs(false)
    }
</script>

