    }

    .job-action-detail-text {
        color: #666666;
    }

    .job-action-apply-text {
        color: #ffffff;
    }

    /* 我的简历入口（#705） */
    .mine-section {
        flex-direction: column;
        padding: 16rpx 24rpx 0;
    }

    .mine-card {
        flex-direction: row;
