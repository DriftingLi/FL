<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="招聘" @left-click="onBack" />

        <!-- 公告/职位双 tab；头像放 tab 行最右端（避开胶囊遮挡区），点入「我的」 -->
        <view class="tab-row">
            <view class="tab-item" :class="{ active: recruitTab === 'notice' }" @click="onTabChange('notice')">
                <text class="tab-text" :class="{ active: recruitTab === 'notice' }">公告</text>
            </view>
            <view class="tab-item" :class="{ active: recruitTab === 'job' }" @click="onTabChange('job')">
                <text class="tab-text" :class="{ active: recruitTab === 'job' }">职位</text>
            </view>
            <view class="tab-avatar-btn" @click="onMine">
                <image v-if="avatarUrl.length > 0" class="tab-avatar" :src="avatarUrl" mode="aspectFill" />
                <view v-else class="tab-avatar-placeholder">
                    <text class="tab-avatar-icon">👷</text>
                </view>
            </view>
        </view>

        <!-- 筛选标签（职位 tab） -->
        <view class="filter-row" v-if="recruitTab === 'job'">
            <view v-for="(tag, idx) in filterTags" :key="idx"
                :class="{ 'filter-tag': true, 'ml-16': idx > 0, 'filter-tag-active': activeFilter == idx }" @click="onFilterChange(idx)">
                <text class="filter-tag-text" :class="{ 'filter-tag-text-active': activeFilter == idx }">{{ tag.label }}</text>
            </view>
        </view>

        <!-- 证件筛选组（#1945）：选项=证件字典；「全部证件」即清除，选具体证件走列表 credential_id -->
        <view class="filter-row filter-row-tight" v-if="recruitTab === 'job' && credentialFilterTags.length > 1">
            <view v-for="(tag, idx) in credentialFilterTags" :key="tag.credential_id"
                :class="{ 'filter-tag': true, 'ml-16': idx > 0, 'filter-tag-active': activeCredentialFilter == idx }"
                @click="onCredentialFilterChange(idx)">
                <text class="filter-tag-text" :class="{ 'filter-tag-text-active': activeCredentialFilter == idx }">{{ tag.name }}</text>
            </view>
        </view>

        <!-- 职位/公告 Tab 内容 -->
        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 公告 tab：后端公告接口未建，空态占位（与旧招聘面板同语义，不放假数据） -->
            <view v-if="recruitTab === 'notice'" class="empty-tip">
                <text class="empty-icon">📢</text>
                <text class="empty-text">暂无公告</text>
            </view>
            <view v-if="recruitTab === 'job' && jobs.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon">💼</text>
                <text class="empty-text">暂无职位信息</text>
            </view>
            <view v-if="recruitTab === 'job'" class="job-list">
                <view v-for="job in jobs" :key="job.id" class="job-card" @click="onJobDetail(job.id)">
                    <view class="job-card-header">
                        <text class="job-company">{{ job.company_name }}</text>
                    </view>
                    <text class="job-title">{{ job.title }}</text>
                    <!-- 「需持 X 证」（#1945）：单一档语义、无「优先」；多证折叠成「前 N 个 + 等 N 证」，无要求整行不渲染 -->
                    <view v-if="credentialNoticeOf(job).length > 0" class="job-credential-row">
                        <view class="job-credential-chip">
                            <text class="job-credential-text">{{ credentialNoticeOf(job) }}</text>
                        </view>
                    </view>
                    <view class="job-info-row">
                        <text class="job-salary">{{ formatSalary(job) }}</text>
                        <text class="job-location">{{ job.region.length > 0 ? job.region : '未填写' }}</text>
                    </view>
                    <text class="job-desc" numberOfLines="2">{{ job.description.length > 0 ? job.description : '暂无描述' }}</text>
                    <view class="job-divider"></view>
                    <view class="job-actions">
                        <view class="job-action-btn job-action-detail" @click.stop="onJobDetail(job.id)">
                            <text class="job-action-text job-action-detail-text">查看详情</text>
                        </view>
                        <view v-if="applyStateOf(job) == 'none'" class="job-action-btn job-action-apply" @click.stop="onJobApply(job.id)">
                            <text class="job-action-text job-action-apply-text">立即投递</text>
                        </view>
                        <view v-else class="job-action-btn job-action-disabled">
                            <text class="job-action-text job-action-disabled-text">{{ applyLabelOf(job) }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 加载更多 -->
            <view v-if="recruitTab === 'job' && loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="recruitTab === 'job' && noMore && jobs.length > 0" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { getJobListApi } from '../../api/job'
    import { getAllCredentialsApi } from '../../api/credential'
    import { getCatalogTreeSpecialties } from '../../api/course'
    import { useAuthStore } from '../../stores/auth'
    import { jobCredentialNotice, buildCredentialFilterOptions, credentialFilterParam } from '../../utils/jobCredentialDisplay'
    import type { JobPosting, JobRequiredCredential } from '../../types/index'

    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 顶栏头像（真实登录态，点入「我的」；不引假数据）----
    const authStore = useAuthStore()
    const avatarUrl = computed<string>(() : string => {
        const u = authStore.user.value
        if (u != null && u.avatar_url != null && u.avatar_url.length > 0) {
            return u.avatar_url
        }
        return ''
    })

    // ---- 公告/职位 Tab 态（公告暂无后端，职位为默认真实内容）----
    const recruitTab = ref<string>('job') // notice | job

    function onTabChange(tab : string) : void {
        if (recruitTab.value === tab) return
        recruitTab.value = tab
    }

    // ---- 筛选标签 ----
    type FilterTag = { label : string, id : number }
    const filterTags = ref<FilterTag[]>([{ label: '全部', id: 0 }])
    const activeFilter = ref<number>(0)

    // ---- 证件筛选组（#1945）：选项来自后端证件字典；首项「全部证件」（id=0）即清除筛选 ----
    // 选项构造与「选中→查询参数」折算都在 utils/jobCredentialDisplay 里（行为腿真跑那份单点）
    const credentialFilterTags = ref<JobRequiredCredential[]>([])
    const activeCredentialFilter = ref<number>(0)

    // ---- 职位数据 ----
    const jobs = ref<JobPosting[]>([])
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const page = ref<number>(1)
    const PAGE_SIZE = 20

    // ---- 筛选标签加载 ----
    async function loadFilters() : Promise<void> {
        try {
            const specialties = await getCatalogTreeSpecialties()
            const tags : FilterTag[] = [{ label: '全部', id: 0 }]
            for (const s of specialties) {
                tags.push({ label: s.name, id: s.specialty_id })
            }
            filterTags.value = tags
        } catch (e) {
            // 降级：仅显示「全部」
        }
    }

    // ---- 证件筛选组加载（字典分组拍平后交给单点，不在这里造第二份证件清单）----
    async function loadCredentialFilters() : Promise<void> {
        try {
            const groups = await getAllCredentialsApi()
            const dict : JobRequiredCredential[] = []
            for (const group of groups) {
                for (const item of group.items) {
                    dict.push({ credential_id: item.id, name: item.name } as JobRequiredCredential)
                }
            }
            credentialFilterTags.value = buildCredentialFilterOptions(dict)
        } catch (e) {
            // 降级：只剩「全部证件」（筛选组不消失、不清空已有结果）
            credentialFilterTags.value = buildCredentialFilterOptions([])
        }
    }

    /** 卡面「需持 X 证」一行：无证件要求返回空串 ⇒ 模板据此不渲染该行 */
    function credentialNoticeOf(job : JobPosting) : string {
        return jobCredentialNotice(job.required_credentials)
    }

    // ---- 职位列表加载 ----
    async function loadJobs(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
            jobs.value = []
        }
        if (noMore.value) return
        loading.value = true
        try {
            const activeTag = filterTags.value[activeFilter.value]
            const specialtyId = activeTag != null ? activeTag.id : 0
            const activeCredTag = credentialFilterTags.value[activeCredentialFilter.value]
            const credentialId = activeCredTag != null ? activeCredTag.credential_id : 0
            const result = await getJobListApi({
                page: page.value,
                page_size: PAGE_SIZE,
                specialty_id: specialtyId > 0 ? specialtyId : null,
                credential_id: credentialFilterParam(credentialId),
            })
            if (reset) {
                jobs.value = result.items
            } else {
                jobs.value = jobs.value.concat(result.items)
            }
            if (result.items.length < PAGE_SIZE || jobs.value.length >= result.total) {
                noMore.value = true
            }
            page.value++
        } catch (e) {
            uni.showToast({ title: '加载失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    // 证件筛选切换：定义在 loadJobs 之后（script setup 顶层函数不允许前向引用，
    // 机检见 utils/utsAndroidCompile.test.js「A：无 script setup 顶层函数前向引用」）
    function onCredentialFilterChange(idx : number) : void {
        if (activeCredentialFilter.value == idx) return
        activeCredentialFilter.value = idx
        loadJobs(true)
    }

    // ---- 生命周期 ----
    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17
    onLoad((options : OnLoadOptions) => {
        loadFilters()
        loadCredentialFilters()
        loadJobs(true)
    })

    function onFilterChange(idx : number) : void {
        activeFilter.value = idx
        loadJobs(true)
    }

    // ---- 薪资格式化 ----
    function formatSalary(job : JobPosting) : string {
        if (job.salary_text.length > 0) return job.salary_text
        if (job.salary_min != null && job.salary_max != null) {
            return job.salary_min!.toString() + '-' + job.salary_max!.toString() + ' 元/月'
        }
        if (job.salary_min != null) return job.salary_min!.toString() + ' 元/月起'
        return '面议'
    }

    // ---- 导航 ----
    function onBack() : void {
        uni.navigateBack()
    }

    // ---- 投递态（#1199）----
    // 列表项也按服务端 apply_state 收敛：可投才给「立即投递」，否则显示状态标签（不再是可点的伪按钮）。
    // justAppliedIds 只覆盖"本页刚投递成功"的即时反馈；重进页面（或切筛选后重载）以服务端状态为准。
    const justAppliedIds = ref<number[]>([])

    /** 该职位当前投递态：'applied' / 'not_hired' / 'none' */
    function applyStateOf(job : JobPosting) : string {
        if (justAppliedIds.value.indexOf(job.id) >= 0) return 'applied'
        if (job.apply_state != null && job.apply_state!.length > 0) return job.apply_state!
        return 'none'
    }

    /** 不可投时的状态文案（冷却中带剩余天数） */
    function applyLabelOf(job : JobPosting) : string {
        if (applyStateOf(job) == 'applied') return '已投递'
        // 可空字段参与比较/运算必须 ?? 兜底（AGENTS.md「Kotlin 编译期常见错误」：nullable receiver）
        const days = job.cooldown_days ?? 0
        return days > 0 ? (days.toString() + ' 天后可投') : '暂不可投递'
    }

    function onJobDetail(jobId : number) : void {
        uni.navigateTo({ url: '/pages/jobs/job-detail?id=' + jobId })
    }

    function onJobApply(jobId : number) : void {
        uni.navigateTo({ url: '/pages/jobs/job-detail?id=' + jobId })
    }

    // ---- 头像导航（#724 单页合并：直入「我的」= 简历总览页 resume.uvue，不再经中间页）----
    function onMine() : void {
        uni.navigateTo({ url: '/pages/resume/resume' })
    }

    function onLoadMore() : void {
        if (recruitTab.value !== 'job') return
        loadJobs(false)
    }
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: $bg-color;
        flex-direction: column;
    }

    .content-scroll {
        flex: 1;
    }

    /* 公告/职位双 tab；头像在行最右端（避开小程序胶囊遮挡区） */
    .tab-row {
        flex-direction: row;
        align-items: center;
        background-color: $bg-header;
        border-bottom: 1rpx solid $border-color-light;
        padding: 0 $spacing-md;
    }

    .tab-item {
        flex: 1;
        height: 88rpx;
        align-items: center;
        justify-content: center;
        border-bottom: 4rpx solid transparent;
    }

    .tab-item.active {
        border-bottom-color: $primary-color;
    }

    .tab-text {
        font-size: 30rpx;
        color: $text-color-secondary;
    }

    .tab-text.active {
        color: #1a1a1a;
        font-weight: bold;
    }

    .tab-avatar-btn {
        width: 72rpx;
        height: 88rpx;
        align-items: center;
        justify-content: center;
    }

    .tab-avatar {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        border: 2rpx solid #eeeeee;
    }

    .tab-avatar-placeholder {
        width: 56rpx;
        height: 56rpx;
        border-radius: 28rpx;
        background-color: #f0f5ff;
        align-items: center;
        justify-content: center;
    }

    .tab-avatar-icon {
        font-size: 30rpx;
    }

    /* 筛选标签 */
    .filter-row {
        flex-direction: row;
        padding: $spacing-sm $spacing-md;
        background-color: $bg-header;
        border-bottom: 1rpx solid $border-color-light;
    }

    .filter-tag {
        padding: $spacing-xs $spacing-md;
        border-radius: $radius-sm;
        background-color: #f5f5f5;
        border: 1rpx solid #e0e0e0;
    }

    .filter-tag-active {
        background-color: #e8f0fe;
        border-color: $primary-color;
    }

    .filter-tag-text {
        font-size: $font-size-xs;
        color: $text-color-secondary;
    }

    .filter-tag-text-active {
        color: $primary-color;
    }

    /* 第二组筛选（证件，票 1945）：证件条目可能多于一行 ⇒ 允许折行。
       票号只写「票 1945」：样式块里的「井号 + 四位十六进制」会被 batch2UiContract 的裸 hex 机检当成颜色值。 */
    .filter-row-tight {
        flex-wrap: wrap;
        border-bottom: 1rpx solid $border-color-light;
    }

    /* 职位列表 */
    .job-list {
        flex-direction: column;
        padding: $spacing-sm $spacing-md;
    }

    .job-card {
        background-color: $bg-header;
        border-radius: $radius-md;
        padding: $spacing-md;
        margin-bottom: $spacing-sm;
        border: 1rpx solid #eeeeee;
        flex-direction: column;
    }

    .job-card-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12rpx;
    }

    .job-company {
        font-size: $font-size-xs;
        color: $text-color-secondary;
        flex: 1;
    }

    .job-title {
        font-size: $font-size-lg;
        font-weight: bold;
        color: $text-color;
        margin-bottom: 12rpx;
    }

    .job-info-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12rpx;
    }

    /* 「需持 X 证」行：外行只管布局，底色落在内层 chip（uvue 里文字类样式只上 text） */
    .job-credential-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 12rpx;
    }

    .job-credential-chip {
        flex-direction: row;
        background-color: #e8f0fe;
        border-radius: $radius-sm;
        padding: 4rpx 12rpx;
    }

    .job-credential-text {
        font-size: 22rpx;
        color: $primary-color;
    }

    .job-salary {
        font-size: 30rpx;
        font-weight: bold;
        color: #ff6b35;
    }

    .job-location {
        font-size: $font-size-xs;
        color: $text-color-placeholder;
    }

    .job-desc {
        font-size: 26rpx;
        color: $text-color-secondary;
        line-height: 1.5;
        margin-bottom: $spacing-sm;
    }

    .job-divider {
        height: 1rpx;
        background-color: $border-color-light;
        margin-bottom: $spacing-sm;
    }

    .job-actions {
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
    }

    .job-action-btn {
        padding: 12rpx 32rpx;
        border-radius: $radius-md;
        margin-left: $spacing-sm;
    }

    .job-action-detail {
        background-color: #f5f5f5;
    }

    .job-action-apply {
        background-color: $primary-color;
    }

    /* 不可投递时的状态标签（不是按钮，无点击；状态由 dispatch-control 票管） */
    .job-action-disabled {
        background-color: $border-color-light;
    }

    .job-action-disabled-text {
        color: $text-color-placeholder;
    }

    .job-action-text {
        font-size: 26rpx;
        font-weight: 500;
    }

    .job-action-detail-text {
        color: $text-color-secondary;
    }

    .job-action-apply-text {
        color: $text-color-inverse;
    }

    /* 空状态 */
    .empty-tip {
        flex-direction: column;
        align-items: center;
        padding: 80rpx 0;
    }

    .empty-icon {
        font-size: 80rpx;
        margin-bottom: $spacing-md;
    }

    .empty-text {
        font-size: $font-size-md;
        color: $text-color-placeholder;
    }

    /* 加载更多 */
    .loading-more {
        align-items: center;
        padding: $spacing-md 0;
    }

    .loading-text {
        font-size: $font-size-xs;
        color: $text-color-placeholder;
    }

    .ml-16 { margin-left: $spacing-sm; }
</style>
