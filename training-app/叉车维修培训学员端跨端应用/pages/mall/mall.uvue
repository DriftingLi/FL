<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

        <!-- 顶部导航栏 -->
        <view class="header">
            <view class="header-left" @click="toback()">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">商城</text>
            <view class="header-right">
                <navigator class="header-avatar" target="miniProgram" app-id="wx56ce2775c2b3aea8" version="release">
                    <image class="avatar-icon" src="/static/icons/易拉宝-006 1-1.png"></image>
                </navigator>
            </view>
        </view>

        <!-- 排序栏 -->
        <MallSortBar :active-sort="activeSort" @sort-change="onSortChange" @search="onSearch" />

        <!-- 双栏主体 -->
        <view class="main-body">
            <!-- 左侧分类栏 -->
            <MallCategorySidebar :active-category="activeCategory" @category-change="onCategoryChange" />

            <!-- 右侧商品列表 -->
            <scroll-view class="product-list" scroll-y="true" @scrolltolower="onLoadMore">
                <!-- 必买清单区域（热门分类时显示） -->
                <view v-if="activeCategory === 0 && mustBuyList.length > 0" class="must-buy-section">
                    <text class="section-title">必买清单</text>
                    <view class="must-buy-grid">
                        <view v-for="(item, idx) in mustBuyList" :key="idx" class="must-buy-card"
                            @click="onProductClick(item)">
                            <view class="must-buy-img-wrap">
                                <image v-if="item.cover_url" :src="item.cover_url" class="must-buy-img"
                                    mode="aspectFill" />
                                <view v-else class="must-buy-img-placeholder"></view>
                            </view>
                            <text class="must-buy-title">{{ item.title }}</text>
                        </view>
                    </view>
                </view>

                <!-- 商品列表 -->
                <!-- #1331/#816：失败态与「暂无商品」分开 —— 5xx/断网不伪装成空货架，给可见错误 + 重试位 -->
                <view v-if="loadError && products.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">商品加载失败，请检查网络后重试</text>
                    <view class="retry-btn" @click="loadProducts(true)">
                        <text class="retry-btn-text">重试</text>
                    </view>
                </view>
                <view v-else-if="products.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">暂无商品</text>
                </view>
                <view v-for="(item, idx) in products" :key="idx" class="product-item" @click="onProductClick(item)">
                    <view class="product-img-wrap">
                        <image v-if="item.cover_url" :src="item.cover_url" class="product-img" mode="aspectFill" />
                        <view v-else class="product-img-placeholder"></view>
                    </view>
                    <view class="product-info">
                        <text class="product-name">{{ item.title }}</text>
                        <view class="product-meta-row">
                            <!-- #1421（移动端 ADR-0031）：价格行吃单点渲染 —— 「N 积分 / 免费」，
                                 不再有 ¥ 金额与恒假「免费」；原「已有 N 人参与学习」行随接线清退
                                 （学员端列表后端根本不发 student_count，恒 0 是假信号）。
                                 经本地包装函数转发（模板直调 import 函数会被 Kotlin 判炸，规则 S）。 -->
                            <text class="product-price">{{ coursePriceText(item) }}</text>
                        </view>
                    </view>
                </view>
                <view v-if="loading" class="loading-more">
                    <text class="loading-text">加载中...</text>
                </view>
                <view v-if="noMore && products.length > 0" class="loading-more">
                    <text class="loading-text">没有更多了</text>
                </view>
            </scroll-view>
        </view>

        <!-- 悬浮按钮组 -->
        <MallFloatActions @search="onSearch" />
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onLoad } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getCourseListApi } from '../../api/course'
    import { getCurrentCredentialApi } from '../../api/credential'
    import { renderCoursePrice } from '../../utils/coursePointsCta'
    import type { CourseItem, CourseListResult } from '../../types/index'
    import MallSortBar from './components/mall-sort-bar.uvue'
    import MallCategorySidebar from './components/mall-category-sidebar.uvue'
    import MallFloatActions from './components/mall-float-actions.uvue'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ---- 排序 ----
    const activeSort = ref<number>(0)

    // ---- 左侧分类 ----
    const activeCategory = ref<number>(0)

    // ---- 商品列表 ----
    // `/courses` 是公开路由：服务端 CredentialScoped 兜底永不生效（见 api/course.uts 文件头、
    // docs/agents/credential-scope.md）⇒ 必须显式下发当前证件，否则货架是全证件课程。
    // 本页是 pushed 页（每次进入重新 onLoad），故在 onLoad 取一次证件、不在 onShow 跟切换。
    const products = ref<CourseItem[]>([])
    const mustBuyList = ref<CourseItem[]>([])
    const page = ref<number>(1)
    const pageSize = 12
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    /** #1331：首屏失败标记 —— 失败与「暂无商品」分开（#816 口径），5xx/断网不伪装成空货架，给可见错误 + 重试位 */
    const loadError = ref<boolean>(false)
    /** 「浏览指定」证件：随请求下发的分区参数（自解释名，与 Web api/client 半边同口径 #1106） */
    const browseCredentialId = ref<number>(0)

    async function loadBrowseCredential() : Promise<void> {
        try {
            const cred = await getCurrentCredentialApi()
            if (cred != null) {
                browseCredentialId.value = cred!.id
            }
        } catch (e) {
            console.warn('[mall] load credential failed:', e)
        }
    }

    async function loadProducts(reset : boolean = false) : Promise<void> {
        if (loading.value) return
        if (reset) {
            page.value = 1
            noMore.value = false
        }
        if (noMore.value && !reset) return

        loading.value = true
        try {
            const result : CourseListResult = await getCourseListApi(page.value, pageSize, 0, 0, browseCredentialId.value)
            loadError.value = false
            if (reset) {
                products.value = result.items
            } else {
                products.value = products.value.concat(result.items)
            }
            // 热门分类时加载必买清单
            if (activeCategory.value === 0 && reset) {
                mustBuyList.value = result.items.slice(0, 4)
            }
            if (products.value.length >= result.total || result.items.length == 0) {
                noMore.value = true
            } else {
                page.value = page.value + 1
            }
        } catch (e) {
            console.error('[mall] load failed:', e)
            loadError.value = true
        } finally {
            loading.value = false
        }
    }

    function onSortChange(idx : number) : void {
        activeSort.value = idx
        loadProducts(true)
    }

    function onCategoryChange(idx : number) : void {
        activeCategory.value = idx
        loadProducts(true)
    }

    function onLoadMore() : void {
        loadProducts(false)
    }

    function onProductClick(item : CourseItem) : void {
        uni.navigateTo({ url: '/pages/courses/course-detail?id=' + item.course_id })
    }

    function onSearch() : void {
        uni.navigateTo({ url: '/pages/search/search' })
    }

    function toback() : void {
        goBack()
    }

    /**
     * 价格行单点包装（#1421）：模板不能直调 import 函数（Kotlin 判炸，同 utsAndroidCompile 规则 S），
     * 这里只做转发 —— 价格语义仍单点在 utils/coursePointsCta.uts 的 renderCoursePrice。
     */
    function coursePriceText(item : CourseItem) : string {
        return renderCoursePrice(item.points_price)
    }

    // onLoad 必须带 options 形参：Kotlin Function1<OnLoadOptions, Unit>，零参即 error17
    // 回到调必须是 Unit（非 Promise）⇒ 用 .then 串证件解析，不写 async 回调
    onLoad((options : OnLoadOptions) => {
        loadBrowseCredential().then(() : void => {
            loadProducts(true)
        })
    })
</script>

<style>
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    /* ===== 顶部导航栏 ===== */
    .header {
        background-color: #ffffff;
        padding: 16rpx 24rpx;
        height: 88rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1rpx solid #f0f0f0;
        overflow: visible;
    }

    .header-left {
        width: 72rpx;
        height: 72rpx;
        align-items: center;
        justify-content: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        flex: 1;
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
        text-align: center;
    }

    .header-right {
        flex-direction: row;
        align-items: center;
    }

    .header-avatar {
        width: 64rpx;
        height: 64rpx;
        overflow: hidden;
    }

    .avatar-icon {
        width: 64rpx;
        height: 64rpx;
        border-radius: 32rpx;
    }

    /* ===== 双栏主体 ===== */
    .main-body {
        flex: 1;
        flex-direction: row;
    }

    /* ===== 右侧商品列表 ===== */
    .product-list {
        flex: 1;
        background-color: #ffffff;
    }

    /* ===== 必买清单区域 ===== */
    .must-buy-section {
        padding: 20rpx;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .section-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
        margin-bottom: 20rpx;
    }

    .must-buy-grid {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    .must-buy-card {
        width: 48%;
        margin-bottom: 20rpx;
    }

    .must-buy-img-wrap {
        width: 100%;
        height: 160rpx;
        border-radius: 12rpx;
        background-color: #f5f5f5;
        overflow: hidden;
    }

    .must-buy-img {
        width: 100%;
        height: 100%;
    }

    .must-buy-img-placeholder {
        width: 100%;
        height: 100%;
        background-color: #e8e8e8;
    }

    .must-buy-title {
        font-size: 24rpx;
        color: #333333;
        margin-top: 12rpx;
        lines: 2;
        text-overflow: ellipsis;
    }

    /* ===== 商品卡片 ===== */
    .product-item {
        padding: 24rpx;
        flex-direction: row;
        border-bottom: 1rpx solid #f5f5f5;
    }

    .product-img-wrap {
        width: 140rpx;
        height: 140rpx;
        border-radius: 12rpx;
        background-color: #f5f5f5;
        overflow: hidden;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .product-img {
        width: 100%;
        height: 100%;
    }

    .product-img-placeholder {
        width: 100%;
        height: 100%;
        background-color: #e8e8e8;
    }

    .product-info {
        flex: 1;
        flex-direction: column;
        justify-content: space-between;
    }

    .product-name {
        font-size: 28rpx;
        color: #333333;
        font-weight: 500;
        lines: 2;
        text-overflow: ellipsis;
    }

    .product-meta-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 12rpx;
    }

    .product-price {
        font-size: 32rpx;
        font-weight: bold;
        color: #ff4d4f;
    }

    /* ===== 空状态 ===== */
    .empty-tip {
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    /* #1331：失败态重试位（与 course-detail / chapter-view 的 retry-btn 同款形态） */
    .retry-btn {
        background-color: #2979ff;
        border-radius: 32rpx;
        padding: 16rpx 48rpx;
        margin-top: 24rpx;
    }

    .retry-btn-text {
        font-size: 28rpx;
        color: #ffffff;
    }

    /* ===== 加载更多 ===== */
    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }
</style>
