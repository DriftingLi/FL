<template>
	<!-- 右下角悬浮搜索（#2618 验收 ⑤）：旧三钮胶囊（首页 / 分享 / 搜索）收敛成单搜索按钮 ——
	     首页与分享在合并货架页各有正经入口（首页 tab、导航栏），胶囊里那两个是重复入口。
	     搜首页槽外部小程序头像不在这里，它在导航栏 #right 槽，保留不动。 -->
	<view class="float-search" @click="onSearch()">
		<image class="float-search-img" src="/static/icons/mall/search.png" mode="aspectFit" />
		<text class="float-search-label">搜索</text>
	</view>
</template>

<script setup lang="uts">
	const emit = defineEmits(['search'])

	function onSearch() : void {
		emit('search')
	}
</script>

<style lang="scss">
	/* ===== 悬浮搜索按钮 ===== */
	.float-search {
		position: fixed;
		right: 40rpx;
		bottom: 200rpx;
		width: 106rpx;
		flex-direction: column;
		align-items: center;
		background-color: $card-bg;
		border-radius: 53rpx;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
		padding-top: 16rpx;
