<template>
    <!-- 必买清单（热门分区；原型只画了「图书系列」激活态，本区保持现网形态）——#2617 T1 自 mall.uvue 搬出 -->
    <view v-if="items.length > 0" class="must-buy-section">
        <text class="section-title">必买清单</text>
        <view class="must-buy-grid">
            <view v-for="(item, idx) in items" :key="idx" class="must-buy-card" @click="onCardClick(item)">
                <view class="must-buy-img-wrap">
                    <image v-if="item.cover_url" :src="item.cover_url" class="must-buy-img"
                        mode="aspectFill" :webp="true" />
                    <view v-else class="must-buy-img-placeholder"></view>
                </view>
                <text class="must-buy-title">{{ item.title }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import type { CourseItem } from '../../../types/index'

    defineProps<{ items : CourseItem[] }>()
    const emit = defineEmits(['productClick'])

    function onCardClick(item : CourseItem) : void {
        emit('productClick', item)
    }
</script>

