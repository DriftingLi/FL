<template>
	<!-- 积分商品卡（#2618 T2 只读呈现 → #2619 T3 页内兑换）：图书系列与积分兑换两个分区用。
	     在售项的可点性只由服务端事实决定（已拥有 / 售罄），按钮文案与配色由 useMall 的映射函数
	     算好后流入（btnLabel / btnClass / btnTextClass），卡不自判、不直连 api；
	     兑换动作按事件回抛，确认弹窗与余额预判都在状态层（卡只管呈现）。 -->
	<view class="shop-card">
		<view class="shop-cover-wrap">
			<image v-if="coverUrl.length > 0" class="shop-cover" :src="coverUrl" :webp="true" mode="aspectFill" />
			<!-- image_url 为 NULL 是数据现实（000057 只加列不填值）⇒ 落详情页同一张吉祥物，
			     不再给 #e8e8e8 灰块；静态 src 不挂 :webp（包内 PNG 不吃 webp 属性，ADR-0066 ①） -->
			<image v-else class="shop-cover" mode="aspectFit"
				src="/static/icons/points-goods/goods-default.png" />
		</view>
		<view class="shop-body">
			<text class="shop-name">{{ title }}</text>
			<view class="shop-meta-row">
				<view class="shop-info">
					<text class="shop-price">{{ price }} 积分</text>
					<text v-if="stockLabel.length > 0" class="shop-stock">{{ stockLabel }}</text>
				</view>
				<view class="shop-btn-hit" @click="onRedeem">
					<view :class="['shop-btn', btnClass]">
						<text :class="['shop-btn-text', btnTextClass]">{{ btnLabel }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 标量 props（裸对象类型挂 defineProps 会被 uvue 编译成 Any，见 mall-course-card 头注）
	defineProps<{
		title : string
		coverUrl : string
		price : number
		stockLabel : string
		btnLabel : string
		btnClass : string
		btnTextClass : string
	}>()
	const emit = defineEmits(['redeem'])

	function onRedeem() : void {
		emit('redeem')
	}
</script>

<style lang="scss">
	/* ===== 积分商品卡 ===== */
	.shop-card {
		flex-direction: row;
		padding: 20rpx;
		background-color: $card-bg;
		margin-bottom: 20rpx;
	}

	.shop-cover-wrap {
		width: 135rpx;
		height: 135rpx;
		background-color: $bg-color;
		overflow: hidden;
		margin-right: 24rpx;
		flex-shrink: 0;
	}

	.shop-cover {
		width: 135rpx;
		height: 135rpx;
	}

	.shop-body {
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
	}

	.shop-name {
		font-size: 28rpx;
		color: $text-color;
		lines: 2;
		text-overflow: ellipsis;
	}

	.shop-meta-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-top: 12rpx;
	}

	.shop-info {
		flex-direction: column;
	}

	.shop-price {
		font-size: 28rpx;
		color: $color-price;
	}

	.shop-stock {
		font-size: 24rpx;
		color: $text-color-placeholder;
	}

	/* 兑换三态的视觉：可点 = 主色实心；兑换中 / 已拥有 / 已售罄 = 淡底灰字。
	   命中区（.shop-btn-hit）撑到 88rpx，视觉胶囊 60rpx —— 同 docs/ui-spec.md §5.11 口径 */
	.shop-btn-hit {
		height: 88rpx;
		align-items: center;
		justify-content: center;
	}

	.shop-btn {
		height: 60rpx;
		min-width: 132rpx;
		padding-left: 28rpx;
		padding-right: 28rpx;
		border-radius: 30rpx;
		align-items: center;
		justify-content: center;
	}

	.shop-btn-active {
		background-color: $primary-color;
	}

	.shop-btn-busy {
		background-color: $bg-color;
	}

	.shop-btn-disabled {
		background-color: $bg-color;
	}

	.shop-btn-text {
		font-size: 26rpx;
	}

	.shop-btn-text-active {
		color: $text-color-inverse;
	}

	.shop-btn-text-disabled {
		color: $text-color-placeholder;
	}
</style>
