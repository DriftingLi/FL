<template>
    <!-- 课程卡（#2617 T1 自 mall.uvue 搬出）：整卡点进课程详情（跳转归页面，卡只回抛） -->
    <view class="product-item" @click="onCardClick">
        <view class="product-img-wrap">
            <image v-if="item.cover_url" :src="item.cover_url" class="product-img" mode="aspectFill" :webp="true" />
            <!-- cover_url 为空时的默认书封（第 4 刀）：路径字面量进表达式（过 imageWebpAttrContract 豁免），
                 文件名按商品名称关键词对号（DTO 无商品类型字段），原型 824:6971 五种书封 -->
            <image v-else class="product-img" mode="aspectFill"
                :src="'/static/icons/mall/cover-' + defaultCoverName(item) + '.png'" />
        </view>
        <view class="product-info">
            <text class="product-name">{{ item.title }}</text>
            <view class="product-meta-row">
                <!-- #1421（移动端 ADR-0031）：价格行吃单点渲染 —— 「N 积分 / 免费」，
                     不再有 ¥ 金额与恒假「免费」；原「已有 N 人参与学习」行随接线清退
                     （学员端列表后端根本不发 student_count，恒 0 是假信号）。
                     色随文案走（原型两态：免费红 / 付费深灰），判定与文案同一单点 priceIsFree。
                     经本地包装函数转发（模板直调 import 函数会被 Kotlin 判炸，规则 S）。 -->
                <text :class="priceIsFree(item) ? 'product-price-free' : 'product-price-paid'">{{ coursePriceText(item) }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { renderCoursePrice } from '../../../utils/coursePointsCta'
    import type { CourseItem } from '../../../types/index'

    defineProps<{ item : CourseItem }>()
    const emit = defineEmits(['productClick'])

    function onCardClick() : void {
        emit('productClick')
    }

    /**
     * 价格行单点包装（#1421）：模板不能直调 import 函数（Kotlin 判炸，同 utsAndroidCompile 规则 S），
     * 这里只做转发 —— 价格语义仍单点在 utils/coursePointsCta.uts 的 renderCoursePrice。
     */
    function coursePriceText(item : CourseItem) : string {
        return renderCoursePrice(item.points_price)
    }

    /** 免费判定与价格文案同一单点（文案 == '免费'），色随文案走：免费红 / 付费深灰（原型两态） */
    function priceIsFree(item : CourseItem) : boolean {
        return coursePriceText(item) == '免费'
    }

    /**
     * 默认书封名（第 4 刀）：cover_url 为空时的兜底封面，按商品名称关键词对号入座；
     * 列表 DTO 无商品类型字段 ⇒ 名称匹配 + 「教材」兜底（原型 824:6971 五种书封，
     * 素材 = 判定 CSV「课程商城」目录 5 张 PLACEHOLDER，出图 = 容器 CSS×2 = 142×200）。
     */
    function defaultCoverName(item : CourseItem) : string {
        const t = item.title
        if (t.indexOf('电子图书') >= 0) return 'ebook'
        if (t.indexOf('专业技术') >= 0) return 'material-pro'
        if (t.indexOf('技能') >= 0) return 'material-skill'
        if (t.indexOf('辅助') >= 0) return 'material-aux'
        return 'textbook'
    }
</script>

<style lang="scss">
    /* ===== 商品卡片（原型实测：白卡通栏、内边距 20rpx、无圆角、卡距 20rpx）===== */
    .product-item {
        padding: 20rpx;
        flex-direction: row;
        background-color: $card-bg;
        margin-bottom: 20rpx;
    }

    /* 书封容器（原型 71×100 CSS ≈ 135×192rpx，方角；封面素材自带书脊与角标） */
    .product-img-wrap {
        width: 135rpx;
        height: 192rpx;
        background-color: $bg-color;
        overflow: hidden;
        margin-right: 24rpx;
        flex-shrink: 0;
    }

    .product-img {
        width: 100%;
        height: 100%;
    }

    .product-info {
        flex: 1;
        flex-direction: column;
        justify-content: space-between;
    }

    .product-name {
        font-size: 28rpx;
        color: $text-color;
        lines: 2;
        text-overflow: ellipsis;
    }

    .product-meta-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 12rpx;
    }

    /* 价格两态（原型 824:6971：免费红 / 付费深灰；免费红实测核心值 #FF2424 = 既有 $color-price token，走 token） */
    .product-price-free {
        font-size: 32rpx;
        font-weight: bold;
        color: $color-price;
    }

    .product-price-paid {
        font-size: 32rpx;
        font-weight: bold;
        color: $text-color;
    }
</style>
