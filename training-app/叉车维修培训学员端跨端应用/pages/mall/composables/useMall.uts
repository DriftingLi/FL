/**
 * 商城页状态（#2617 T1 预重构；#2621 T5 起本页是唯一货架页）
 *
 * 来路：T1 把「分区 + 两路列表 + 余额 + 筛选 + 三态」从两个页面壳层（合并页 + 旧积分商城页）
 * 搬进这里，页面只解构消费（#2617 验收 ①）；T2 起两页合成单一货架页（反转 #2518 Q8），
 * 旧页与旧路由已在 T5 下线 ⇒ 今天只有一个消费者。两路装载都是显式动作（loadCourses / loadItems），
 * 创建 composable 不发任何请求 —— 打开商城不多打一次没问过的请求。两路状态刻意不同名：合并页要同时
 * 持有课程与积分商品两份列表，同名 ref 会把「哪一路在加载」变成隐性约定。
 *
 * #2618 T2 起 mall 页是四态货架（热门 0 / 课程 1 / 图书系列 2 / 积分兑换 3，ADR-0072 决策 2）：
 * 左栏页内切换只改 activeCategory，不再跳转积分商城；初始分区由 onLoad 的 tab 决定
 * （tab=points → 积分兑换，缺省/未知 → 热门）。热门用的是两路列表的前 6 条（hotCourses / hotItems），
 * 图书系列走 category=book 的筛选动词，积分兑换 = points_price 非空课程 + 积分商品全量。
 *
 * #2619 T3 起筛选只剩「积分范围」一个控件（ADR-0072 决策 7-8）：它只作用于积分商品，
 * 故只在图书系列 / 积分兑换两分区可见，档位变化即按 points_min / points_max 重取两路积分商品
 * （「不限」档也重取，只是回到全量取源）；排序四档与「商品分类」五档一并退役——前者无后端参数、
 * 后者与左栏分区职责重复。热门段取的是**未筛**全量的前 6（它没有可见控件，不能让筛选在这里变成
 * 一个用户清不掉的隐藏状态）。
 *
 * 课程路（mall 页）：`/courses` 是公开路由，服务端 CredentialScoped 兜底永不生效
 * （见 api/course.uts 文件头、docs/agents/credential-scope.md）⇒ 必须显式下发当前证件；
 * mall 是 pushed 页（每次进入重新 onLoad），故只在 startCourses 取一次证件、不在 onShow 跟切换。
 */
import { ref } from 'vue'
import type { Ref } from 'vue'
import { getCourseListApi } from '../../../api/course'
import { getCurrentCredentialApi } from '../../../api/credential'
import { getPointsBalanceApi, getShopItemsApi, getShopItemsFilteredApi, redeemShopItemApi } from '../../../api/points'
import { errMsg } from '../../../api/helpers'
import { AI_PRO_SKU } from '../../../composables/useAiPro'
import type { CourseItem, ShopItem, ShopItemsResult } from '../../../types/index'
import type { Page } from '../../../api/envelope'

/** 单个筛选选项（label 进胶囊；积分范围档只用 min/max，value 只作 v-for key） */
export type MallFilterOption = {
    label : string
    value : string
    min : number
    max : number
}

/** 本 composable 的显式返回类型（Kotlin error18 规避，先例 usePointsExchangeRecords） */
export type UseMallResult = {
    /** 课程路 */
    courses : Ref<CourseItem[]>
    hotCourses : Ref<CourseItem[]>
    activeCategory : Ref<number>
    coursesLoading : Ref<boolean>
    coursesNoMore : Ref<boolean>
    coursesLoadError : Ref<boolean>
    loadCourses : (reset : boolean) => void
    loadMoreCourses : () => void
    setCategory : (idx : number) => void
    /** 四态首屏（tab 决定初始分区；两源各一次装载） */
    startMall : (tab : string) => void
    /** 四态分区的切片/派生 */
    hotItems : Ref<ShopItem[]>
    redeemableCourses : Ref<CourseItem[]>
    /** 积分商品路 */
    pointsBalance : Ref<number>
    items : Ref<ShopItem[]>
    loading : Ref<boolean>
    loadFailed : Ref<boolean>
    bookItems : Ref<ShopItem[]>
    bookLoading : Ref<boolean>
    /** 图书系列一路的失败标记（与积分商品路分开：两路各自失败，错误态不能互相冒充） */
    bookLoadFailed : Ref<boolean>
    shopCoverUrl : (item : ShopItem) => string
    /** 筛选槽在热门 / 课程两分区的替代内容（#2723：槽位常驻，这两分区没有筛选控件） */
    slotTitle : (idx : number) => string
    slotHint : (idx : number) => string
    /** 单筛选控件：「积分范围」三档 + 「不限」复位（只作用于积分商品） */
    rangeOptions : MallFilterOption[]
    activeRangeIdx : Ref<number>
    stockText : (item : ShopItem) => string
    blocked : (item : ShopItem) => boolean
    btnText : (item : ShopItem) => string
    btnClass : (item : ShopItem) => string
    btnTextClass : (item : ShopItem) => string
    loadBalance : () => void
    loadItems : () => void
    /** 图书系列一路的装载（重试位与档位变化共用；两路各自独立失败） */
    loadBookItems : () => void
    onRedeem : (item : ShopItem) => void
    onPickRange : (idx : number) => void
    onEarnPoints : () => void
}

export function useMall() : UseMallResult {
    // ===== 课程路状态（声明先于引用它的函数：UTS 无提升，后置声明即 Kotlin 编译错）=====
    // 四态（ADR-0072 决策 2 的 MECE 分区）：0 热门 / 1 课程 / 2 图书系列 / 3 积分兑换 —— 全是本页态
    const activeCategory = ref<number>(0)
    const courses = ref<CourseItem[]>([]) as Ref<CourseItem[]>
    const page = ref<number>(1)
    const pageSize = 12
    const coursesLoading = ref<boolean>(false)
    const coursesNoMore = ref<boolean>(false)
    /** #1331：首屏失败标记 —— 失败与「暂无商品」分开（#816 口径），5xx/断网不伪装成空货架，给可见错误 + 重试位 */
    const coursesLoadError = ref<boolean>(false)
    /** 「浏览指定」证件：随请求下发的分区参数（自解释名，与 Web api/client 半边同口径 #1106） */
    const browseCredentialId = ref<number>(0)

    // ===== 积分商品路状态 =====
    const pointsBalance = ref<number>(0)
    const items = ref<ShopItem[]>([]) as Ref<ShopItem[]>
    const loading = ref<boolean>(false)
    const loadFailed = ref<boolean>(false)
    /** 图书系列分区（#2618 T2 按类型取源：category=book）；T3 再在它上面接筛选与兑换三态 */
    const bookItems = ref<ShopItem[]>([]) as Ref<ShopItem[]>
    const bookLoading = ref<boolean>(false)
    const bookLoadFailed = ref<boolean>(false)

    // ===== 四态分区的切片/派生（都在装载处更新一次，模板只读 ref，不在渲染里算）=====
    /** 热门课程段 = 课程前 6（固定条数，无「查看更多」翻页态） */
    const hotCourses = ref<CourseItem[]>([]) as Ref<CourseItem[]>
    /** 热门积分商品段 = 积分商品前 6 */
    const hotItems = ref<ShopItem[]>([]) as Ref<ShopItem[]>
    /** 积分兑换分区的课程段 = points_price 非空的课程（分区按商品类型切，不按数据源表切） */
    const redeemableCourses = ref<CourseItem[]>([]) as Ref<CourseItem[]>
    /** 正在兑换的 sku（空串表示无进行中请求，兼作防重入闸门） */
    const redeemingSku = ref<string>('')

    // ===== 单筛选控件（#2619 T3；后端参数已上线：#2548 形状 category / points_min / points_max）=====
    /**
     * 积分范围档位（票面给定 ≤500 / 500-1000 / >1000）：标签按闭区间读，实际下发为
     * price ≤ 500 / 500 ≤ price ≤ 1000 / price ≥ 1001；边界值 500 两侧都算 —— 档位是「在预算内挑」，
     * 重叠不会给出歧义，反倒是把 500 只算进一侧会让「500-1000」这个标签少一档。
     * min/max = 0 表示该侧不下发。「不限」是复位档不是第四档——没有它，选完区间就没有回头路
     * （控件只在两个积分商品分区可见，去别的分区也清不掉）。value 只作 v-for key，不进请求。
     */
    const rangeOptions : MallFilterOption[] = [
        { label: '不限', value: 'all', min: 0, max: 0 },
        { label: '≤500', value: 'le500', min: 0, max: 500 },
        { label: '500-1000', value: '500-1000', min: 500, max: 1000 },
        { label: '>1000', value: 'gt1000', min: 1001, max: 0 },
    ]

    const activeRangeIdx = ref<number>(0)

    // ===== 纯映射（须先于调用它们的函数声明，守护规则 A）=====

    /** 库存文案：null = 不限库存（后端 x-nullable，null ≠ 0；0 才是售罄） */
    function stockText(item : ShopItem) : string {
        const s = item.stock
        if (s == null) return ''
        if (s == 0) return '已售罄'
        return '仅剩 ' + s.toString() + ' 件'
    }

    /** 不可点：已拥有（服务端判据）或售罄 */
    function blocked(item : ShopItem) : boolean {
        if (item.owned) return true
        const s = item.stock
        if (s != null && s == 0) return true
        return false
    }

    function btnText(item : ShopItem) : string {
        if (item.owned) return '已拥有'
        const s = item.stock
        if (s != null && s == 0) return '已售罄'
        if (redeemingSku.value == item.sku) return '兑换中'
        return '兑换'
    }

    function btnClass(item : ShopItem) : string {
        if (blocked(item)) return 'shop-btn-disabled'
        if (redeemingSku.value == item.sku) return 'shop-btn-busy'
        return 'shop-btn-active'
    }

    function btnTextClass(item : ShopItem) : string {
        if (blocked(item)) return 'shop-btn-text-disabled'
        return 'shop-btn-text-active'
    }

    /** 积分兑换分区的课程段：points_price 非空（可空槽是非空引用判不了的，显式比 null） */
    function redeemableList(list : CourseItem[]) : CourseItem[] {
        const out : CourseItem[] = []
        for (let i = 0; i < list.length; i++) {
            const it = list[i]
            if (it.points_price != null) {
                out.push(it)
            }
        }
        return out
    }

    /** 积分商品封面：image_url 可空，拍平成标量给卡片（裸对象挂 defineProps 会被编译成 Any） */
    function shopCoverUrl(item : ShopItem) : string {
        const u = item.image_url
        if (u == null) return ''
        return u
    }

    /**
     * 筛选槽在热门 / 课程两分区的替代内容（#2723）：槽位常驻定高（#2619 验收 ③ 切分区不跳），
     * 但这两分区没有筛选控件 —— 空着就露出 88rpx 的 $bg-color 灰带，与图书系列 / 积分兑换的
     * 白条对不上。分区名 + 一句说明由这里给（页面壳层零自持状态，模板只读）。
     */
    function slotTitle(idx : number) : string {
        return idx == 0 ? '热门' : '课程'
    }

    function slotHint(idx : number) : string {
        return idx == 0 ? '课程与积分商品精选' : '全部课程'
    }

    // ===== 课程路装载 =====

    async function loadBrowseCredential() : Promise<void> {
        try {
            const cred = await getCurrentCredentialApi()
            if (cred != null) {
                browseCredentialId.value = cred!.id
            }
        } catch (e) {
            console.warn('[mall] load credential failed:', e)
        }
    }

    async function loadCourses(reset : boolean = false) : Promise<void> {
        if (coursesLoading.value) return
        if (reset) {
            page.value = 1
            coursesNoMore.value = false
        }
        if (coursesNoMore.value && !reset) return

        coursesLoading.value = true
        try {
            // ADR-0037 信封归一（PR-B）：`getCourseListApi` 返回 `Page<CourseItem>`（items/total/hasMore），
            // 本路只消费 items/total，装载行为不变；旧 DTO 名 `CourseListResult` 由 PR-F 清尾删除。
            const result : Page<CourseItem> = await getCourseListApi(page.value, pageSize, 0, 0, browseCredentialId.value)
            coursesLoadError.value = false
            if (reset) {
                courses.value = result.items
            } else {
                courses.value = courses.value.concat(result.items)
            }
            // 四态切片随装载更新（热门段固定前 6；积分兑换课程段按 points_price 过滤）
            hotCourses.value = courses.value.slice(0, 6)
            redeemableCourses.value = redeemableList(courses.value)
            if (courses.value.length >= result.total || result.items.length == 0) {
                coursesNoMore.value = true
            } else {
                page.value = page.value + 1
            }
        } catch (e) {
            console.error('[mall] load failed:', e)
            coursesLoadError.value = true
        } finally {
            coursesLoading.value = false
        }
    }

    /** 只有课程分区有「加载更多」：热门是固定条数（#2618 验收 ③），其余分区是只读全量 */
    function loadMoreCourses() : void {
        if (activeCategory.value != 1) return
        loadCourses(false)
    }

    /** 左栏四态：只换内容区，不跳转、不重发请求（两路列表在 startMall 已装载；#2618 验收 ①） */
    function setCategory(idx : number) : void {
        activeCategory.value = idx
    }

    /**
     * 首屏装载：onLoad 必须带 options 形参（Kotlin Function1<OnLoadOptions, Unit>，零参即 error17），
     * 回到调必须是 Unit（非 Promise）⇒ 用 .then 串证件解析，不写 async 回调。
     */
    function startCourses() : void {
        loadBrowseCredential().then(() : void => {
            loadCourses(true)
        })
    }

    // ===== 积分商品路装载与兑换 =====

    /** 余额读失败不挡列表（装饰性提示不该制造一次用户没触发的报错，ADR-0031 决策 3） */
    async function loadBalance() : Promise<void> {
        try {
            const bal = await getPointsBalanceApi(true)
            pointsBalance.value = bal.balance
        } catch (e) {
            console.warn('[mall] balance failed:', errMsg(e, '余额读取失败'))
        }
    }

    async function loadItems() : Promise<void> {
        loading.value = true
        loadFailed.value = false
        const range = rangeOptions[activeRangeIdx.value]
        try {
            // 无范围档走原动词（既有契约钉死调用形状）；带档走 N1 #2548 形状骨架
            //（getShopItemsFilteredApi：category / points_min / points_max）。
            // 积分兑换分区的商品段是「全量」，故 category 传空串（api 层空串即不下发该参）
            let res : ShopItemsResult
            if (range.min == 0 && range.max == 0) {
                res = await getShopItemsApi()
                // 热门段只吃未筛全量的前 6：它没有可见控件，不能留一个用户清不掉的隐藏筛选
                hotItems.value = res.items.slice(0, 6)
            } else {
                res = await getShopItemsFilteredApi('', range.min, range.max)
            }
            items.value = res.items
        } catch (e) {
            loadFailed.value = true
            console.warn('[mall] items failed:', errMsg(e, '商品加载失败'))
        }
        loading.value = false
    }

    /** 图书系列分区装载（按类型取源 category=book，外加「积分范围」两档；失败只留空列表 + 空态，不挡其他分区） */
    async function loadBookItems() : Promise<void> {
        bookLoading.value = true
        bookLoadFailed.value = false
        const range = rangeOptions[activeRangeIdx.value]
        try {
            const res : ShopItemsResult = await getShopItemsFilteredApi('book', range.min, range.max)
            bookItems.value = res.items
        } catch (e) {
            bookLoadFailed.value = true
            console.warn('[mall] book items failed:', errMsg(e, '图书加载失败'))
        }
        bookLoading.value = false
    }

    /**
     * 四态首屏装载：tab 决定初始分区（tab=points → 积分兑换，缺省/未知 → 热门，ADR-0072 决策 2）。
     * 课程与积分商品两源各打一次，余额与图书系列随首屏一起拿。
     */
    function startMall(tab : string) : void {
        activeCategory.value = tab == 'points' ? 3 : 0
        loadBalance()
        loadItems()
        loadBookItems()
        startCourses()
    }

    function onEarnPoints() : void {
        uni.navigateTo({ url: '/pages/points/task-center' })
    }

    /**
     * 「积分范围」档位变化：按新档重取两路积分商品（min/max 进 N1 #2548 的 points_min / points_max）。
     * 两路都重取而不是只重取当前分区那份：图书系列与积分兑换共用同一档位，只刷一路会让另一路
     * 停在旧档上（切回去才发现的错数据比多一次请求糟）。
     */
    function onPickRange(idx : number) : void {
        if (activeRangeIdx.value == idx) return
        activeRangeIdx.value = idx
        loadItems()
        loadBookItems()
    }

    /** 兑换成功后的落点（#1942 验收：权益即时生效、落点可达）：当前唯一可兑权益是 AI 专业版 */
    function goEntitlementLanding(sku : string) : void {
        if (sku == AI_PRO_SKU) {
            uni.switchTab({ url: '/pages/ai-assistant/ai-assistant' })
        }
    }

    /** 真正发起兑换：守卫全在服务端（余额 / 已拥有 / 在售），客户端不预扣、不本地写「已解锁」 */
    async function doRedeem(item : ShopItem) : Promise<void> {
        if (redeemingSku.value.length > 0) return
        redeemingSku.value = item.sku
        try {
            const res = await redeemShopItemApi(item.sku)
            redeemingSku.value = ''
            pointsBalance.value = res.balance
            uni.showToast({ title: '兑换成功', icon: 'success' })
            await loadItems()
            await loadBookItems()
            goEntitlementLanding(item.sku)
        } catch (e) {
            redeemingSku.value = ''
            uni.showToast({ title: errMsg(e, '兑换失败'), icon: 'none' })
            // 失败后按服务端事实重拉：已拥有 / 售罄 / 下架都在这一步被纠正
            await loadItems()
            await loadBookItems()
        }
    }

    /**
     * 兑换前提示：把「要扣多少 / 手里有多少」摆进同一句；余额不足时明说会被服务端拒，
     * 并给「去赚积分」的出路——但**不代替服务端裁定**（预判不拦截 CTA，ADR-0031 决策 3）。
     */
    function onRedeem(item : ShopItem) : void {
        if (blocked(item) || redeemingSku.value.length > 0) return
        const short = pointsBalance.value < item.price
        const content = '该商品需 ' + item.price.toString() + ' 积分，当前可用 ' +
            pointsBalance.value.toString() + ' 积分。' +
            (short ? '余额不足，继续兑换会被服务端拒绝。' : '确认兑换？')
        uni.showModal({
            title: short ? '积分不足' : '积分兑换',
            content: content,
            confirmText: short ? '继续兑换' : '确认兑换',
            cancelText: short ? '去赚积分' : '取消',
            // showModal 的 success 回调不可为 async（Kotlin error17），异步动作转独立函数
            success: (res) => {
                if (res.confirm) {
                    doRedeem(item)
                    return
                }
                if (short) {
                    onEarnPoints()
                }
            }
        })
    }

    return {
        courses: courses,
        hotCourses: hotCourses,
        activeCategory: activeCategory,
        coursesLoading: coursesLoading,
        coursesNoMore: coursesNoMore,
        coursesLoadError: coursesLoadError,
        loadCourses: (reset : boolean) : void => { loadCourses(reset) },
        loadMoreCourses: () : void => loadMoreCourses(),
        setCategory: (idx : number) : void => setCategory(idx),
        startMall: (tab : string) : void => startMall(tab),
        hotItems: hotItems,
        redeemableCourses: redeemableCourses,
        pointsBalance: pointsBalance,
        items: items,
        loading: loading,
        loadFailed: loadFailed,
        bookItems: bookItems,
        bookLoading: bookLoading,
        bookLoadFailed: bookLoadFailed,
        shopCoverUrl: (item : ShopItem) : string => shopCoverUrl(item),
        slotTitle: (idx : number) : string => slotTitle(idx),
        slotHint: (idx : number) : string => slotHint(idx),
        rangeOptions: rangeOptions,
        activeRangeIdx: activeRangeIdx,
        stockText: (item : ShopItem) : string => stockText(item),
        blocked: (item : ShopItem) : boolean => blocked(item),
        btnText: (item : ShopItem) : string => btnText(item),
        btnClass: (item : ShopItem) : string => btnClass(item),
        btnTextClass: (item : ShopItem) : string => btnTextClass(item),
        loadBalance: () : void => { loadBalance() },
        loadItems: () : void => { loadItems() },
        loadBookItems: () : void => { loadBookItems() },
        onRedeem: (item : ShopItem) : void => onRedeem(item),
        onPickRange: (idx : number) : void => onPickRange(idx),
        onEarnPoints: () : void => onEarnPoints(),
    } as UseMallResult
}
