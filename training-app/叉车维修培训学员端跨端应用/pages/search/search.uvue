<template>
	<view class="search-page">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

		<!-- 搜索栏：主色区 + 白色胶囊输入（对齐 course-detail / featured-list 等非 tabBar 页的既有写法） -->
		<view class="search-header">
			<view class="search-input-wrap">
				<text class="search-icon">🔍</text>
				<input class="search-input" type="text" v-model="keyword" placeholder="搜索课程、章节、题目、精选、帖子"
					confirm-type="search" @confirm="onSearch" />
				<view v-if="keyword.length > 0" class="search-clear" @click="onClear">
					<text class="search-clear-text">✕</text>
				</view>
			</view>
			<text class="search-cancel" @click="onCancel">取消</text>
		</view>

		<!-- 类型筛选：全部 + 五分区（章节分区见 ADR-0049 决策 3） -->
		<scroll-view v-if="hasSearched" class="type-tabs-scroll" scroll-x="true">
			<view class="type-tabs">
				<view v-for="(tab, idx) in typeTabs" :key="idx" class="type-tab-item"
					:class="{ 'type-tab-item--lead': idx == 0 }">
					<AppChip :text="tab.label" :active="activeTypeIdx == idx" @click="onTypeChange(idx)" />
				</view>
			</view>
		</scroll-view>

		<!-- 搜索结果 -->
		<scroll-view v-if="hasSearched" class="result-scroll" scroll-y="true" @scrolltolower="onLoadMore">
			<!-- 全部结果（各分区 top 5，区内已由后端排好序） -->
			<view v-if="activeTypeIdx == 0">
				<view v-for="(section, sIdx) in sections" :key="section.key" class="result-section">
					<view class="section-header">
						<view class="section-accent"></view>
						<text class="section-title">{{ section.label }}</text>
						<text class="section-total">{{ section.total }} 条</text>
						<text v-if="section.total > section.items.length" class="section-more"
							@click="onSectionMore(section.key)">查看全部</text>
					</view>
					<view v-if="section.items.length > 0">
						<view v-for="(item, idx) in section.items" :key="idx" class="result-item"
							:class="{ 'result-item--last': idx == section.items.length - 1 }" @click="onItemClick(item)">
							<image v-if="item.cover.length > 0" class="item-cover" :src="item.cover" mode="aspectFill" />
							<view class="item-content">
								<text class="item-title">
									<text v-for="(seg, tIdx) in itemTitleSegments(item)" :key="tIdx"
										:class="seg.hit ? 'item-hl' : 'item-title-plain'">{{ seg.text }}</text>
								</text>
								<text v-if="showSnippet(item)" class="item-summary">
									<text v-for="(seg, pIdx) in itemSnippetSegments(item)" :key="pIdx"
										:class="seg.hit ? 'item-hl' : 'item-summary-plain'">{{ seg.text }}</text>
								</text>
								<text v-if="itemHitLabel(item).length > 0" class="item-hit">{{ itemHitLabel(item) }}</text>
							</view>
							<text class="item-arrow">›</text>
						</view>
					</view>
					<text v-else class="section-empty">无匹配结果</text>
				</view>

				<view v-if="isAllEmpty" class="empty-wrap">
					<AppEmptyState icon="🔍" text="未找到相关内容" />
				</view>
			</view>

			<!-- 指定类型结果（分页） -->
			<view v-else>
				<view class="typed-card">
					<view v-for="(item, idx) in typedResult.items" :key="idx" class="result-item"
						:class="{ 'result-item--last': idx == typedResult.items.length - 1 }" @click="onItemClick(item)">
						<image v-if="item.cover.length > 0" class="item-cover" :src="item.cover" mode="aspectFill" />
						<view class="item-content">
							<text class="item-title">
								<text v-for="(seg, tIdx) in itemTitleSegments(item)" :key="tIdx"
									:class="seg.hit ? 'item-hl' : 'item-title-plain'">{{ seg.text }}</text>
							</text>
							<text v-if="showSnippet(item)" class="item-summary">
								<text v-for="(seg, pIdx) in itemSnippetSegments(item)" :key="pIdx"
									:class="seg.hit ? 'item-hl' : 'item-summary-plain'">{{ seg.text }}</text>
							</text>
							<text v-if="itemHitLabel(item).length > 0" class="item-hit">{{ itemHitLabel(item) }}</text>
						</view>
						<text class="item-arrow">›</text>
					</view>
				</view>

				<view v-if="typedResult.items.length == 0 && !loading" class="empty-wrap">
					<AppEmptyState icon="🔍" text="未找到相关内容" />
				</view>

				<view v-if="loading" class="loading-wrap">
					<text class="loading-text">加载中…</text>
				</view>

				<view v-if="!loading && !hasMore && typedResult.items.length > 0" class="no-more-wrap">
					<text class="no-more-text">没有更多了</text>
				</view>
			</view>
		</scroll-view>

		<!-- 初始态：搜索历史（只留端上，ADR-0049 决策 7；与 Web searchHistory 同口径） -->
		<view v-if="!hasSearched && searchHistory.length > 0" class="history-section">
			<view class="history-header">
				<view class="section-accent"></view>
				<text class="history-title">搜索历史</text>
				<text class="history-clear" @click="onClearHistory">清空</text>
			</view>
			<view class="history-tags">
				<view v-for="(kw, idx) in searchHistory" :key="idx" class="history-tag mr-16-mb-16">
					<text class="history-tag-text" @click="onHistoryClick(kw)">{{ kw }}</text>
					<text class="history-tag-delete" @click="onRemoveHistory(kw)">✕</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import { useStatusBarHeight } from '../../utils/system'
	import { getCurrentCredentialApi } from '../../api/credential'
	import { searchAllApi, searchByTypeApi } from '../../api/search'
	import { splitHighlight, searchItemPath, hitLabel, displaySnippet, sectionLabel, itemPrimaryText, shouldShowSnippet } from '../../utils/searchDisplay'
	import AppChip from '../../components/app-chip/app-chip.uvue'
	import AppEmptyState from '../../components/app-empty-state/app-empty-state.uvue'
	import type { SearchItem, SearchCategoryResult, SearchResult, SearchPagedResult, HighlightSegment } from '../../types/index'

	const statusBarHeight = useStatusBarHeight()

	type TypeTab = { label: string; value: string }
	const typeTabs: TypeTab[] = [
		{ label: '全部', value: '' },
		{ label: '课程', value: 'course' },
		{ label: '章节', value: 'chapter' },
		{ label: '题目', value: 'question' },
		{ label: '精选', value: 'content' },
		{ label: '帖子', value: 'topic' },
	]
	const activeTypeIdx = ref<number>(0)

	const keyword = ref<string>('')
	const loading = ref<boolean>(false)
	const hasSearched = ref<boolean>(false)
	/** 已**成功**加载的页码：只在成功后前进，失败不推进（#979 M5「失败静默丢一页」） */
	const page = ref<number>(1)
	const pageSize = ref<number>(20)

	/** 当前证件（>0 才随请求下发）：搜索是公开路由，证件必须由客户端显式声明（#979 M6） */
	const credentialId = ref<number>(0)
	let credentialRefresh : Promise<void> | null = null

	const emptySection: SearchCategoryResult = { items: [] as SearchItem[], total: 0 } as SearchCategoryResult

	/** 空的分页结果（切换类型 / 重新搜索时先清空，避免旧关键词的结果留在屏上） */
	function emptyPagedResult() : SearchPagedResult {
		return {
			keyword: '',
			type: '',
			total: 0,
			page: 1,
			pages: 0,
			items: [] as SearchItem[],
		} as SearchPagedResult
	}

	const allResult = ref<SearchResult>({
		keyword: '',
		courses: { ...emptySection },
		chapters: { ...emptySection },
		questions: { ...emptySection },
		contents: { ...emptySection },
		topics: { ...emptySection },
	} as SearchResult)

	const typedResult = ref<SearchPagedResult>(emptyPagedResult())

	type SectionView = { key: string; label: string; items: SearchItem[]; total: number }
	const sections = computed<SectionView[]>(() : SectionView[] => {
		const r = allResult.value
		return [
			{ key: 'course', label: sectionLabel('course'), items: r.courses.items, total: r.courses.total } as SectionView,
			{ key: 'chapter', label: sectionLabel('chapter'), items: r.chapters.items, total: r.chapters.total } as SectionView,
			{ key: 'question', label: sectionLabel('question'), items: r.questions.items, total: r.questions.total } as SectionView,
			{ key: 'content', label: sectionLabel('content'), items: r.contents.items, total: r.contents.total } as SectionView,
			{ key: 'topic', label: sectionLabel('topic'), items: r.topics.items, total: r.topics.total } as SectionView,
		] as SectionView[]
	})

	const isAllEmpty = computed<boolean>(() : boolean => {
		const r = allResult.value
		return r.courses.items.length == 0
			&& r.chapters.items.length == 0
			&& r.questions.items.length == 0
			&& r.contents.items.length == 0
			&& r.topics.items.length == 0
	})

	const hasMore = computed<boolean>(() : boolean => {
		return page.value < typedResult.value.pages
	})

	// ===== 展示包装（uvue 模板不能直调 import 的函数，先例 featured-detail 的 displayTime） =====

	/** 主行 = 结果行的「身份」文案；题目分区的主行是命中窗口（见 searchDisplay.itemPrimaryText） */
	function itemTitleSegments(item : SearchItem) : HighlightSegment[] {
		return splitHighlight(itemPrimaryText(item), keyword.value)
	}

	function itemSnippetText(item : SearchItem) : string {
		return displaySnippet(item)
	}

	function itemSnippetSegments(item : SearchItem) : HighlightSegment[] {
		return splitHighlight(itemSnippetText(item), keyword.value)
	}

	/** 片段行是否该出现：题目只留一行；片段与标题属同一段文本时也不重复渲染 */
	function showSnippet(item : SearchItem) : boolean {
		if (!shouldShowSnippet(item)) return false
		return itemSnippetText(item).length > 0
	}

	function itemHitLabel(item : SearchItem) : string {
		return hitLabel(item.hit_field)
	}

	// ===== 搜索历史（上限 10 / 去重前置 / 单条删除 / 清空，与 Web searchHistory.ts 同口径） =====

	const HISTORY_KEY = 'search_history'
	const HISTORY_MAX = 10

	function loadHistory() : string[] {
		const raw = uni.getStorageSync(HISTORY_KEY) as string
		if (raw.length == 0) return [] as string[]
		try {
			return JSON.parse(raw) as string[]
		} catch (e) {
			return [] as string[]
		}
	}

	const searchHistory = ref<string[]>(loadHistory())

	function persistHistory(list : string[]) : void {
		searchHistory.value = list
		uni.setStorageSync(HISTORY_KEY, JSON.stringify(list))
	}

	function saveHistory(kw : string) : void {
		if (kw.length == 0) return
		let list = searchHistory.value.filter((s : string) : boolean => s != kw)
		list.unshift(kw)
		if (list.length > HISTORY_MAX) {
			list = list.slice(0, HISTORY_MAX)
		}
		persistHistory(list)
	}

	// ===== 证件 =====

	function loadCredential() : Promise<void> {
		return getCurrentCredentialApi().then((cred) : void => {
			credentialId.value = cred != null ? cred.id : 0
		}).catch(() : void => {
			credentialId.value = 0
		})
	}

	/** 首次搜索前确认证件已解析；onShow 会把它置空以便跟随证件切换 */
	function ensureCredential() : Promise<void> {
		if (credentialRefresh == null) {
			credentialRefresh = loadCredential()
		}
		return credentialRefresh!
	}

	onShow(() : void => {
		credentialRefresh = loadCredential()
	})

	// ===== 检索（请求序号 + 成功才推进页码） =====

	/** 请求序号：旧响应回来时序号已变 ⇒ 直接丢弃，不覆盖新结果（#979 M5 竞态） */
	let searchSeq = 0

	async function runSearch(requestPage : number, append : boolean) : Promise<void> {
		const kw = keyword.value.trim()
		if (kw.length == 0) return
		const tab = typeTabs[activeTypeIdx.value]
		const seq = searchSeq + 1
		searchSeq = seq
		loading.value = true
		try {
			await ensureCredential()
			if (tab.value.length == 0) {
				const result = await searchAllApi(kw, credentialId.value)
				if (seq != searchSeq) return
				allResult.value = result
			} else {
				const result = await searchByTypeApi(kw, tab.value, requestPage, pageSize.value, credentialId.value)
				if (seq != searchSeq) return
				if (append && requestPage > 1) {
					const prev = typedResult.value
					const merged : SearchPagedResult = {
						keyword: result.keyword,
						type: result.type,
						total: result.total,
						page: result.page,
						pages: result.pages,
						items: prev.items.concat(result.items),
					} as SearchPagedResult
					typedResult.value = merged
				} else {
					typedResult.value = result
				}
				page.value = requestPage
			}
		} catch (e) {
			if (seq != searchSeq) return
			console.warn('[search] doSearch failed:', e)
			uni.showToast({ title: '搜索失败，请重试', icon: 'none' })
		} finally {
			if (seq == searchSeq) loading.value = false
		}
	}

	async function onSearch() : Promise<void> {
		const kw = keyword.value.trim()
		if (kw.length == 0) {
			uni.showToast({ title: '请输入搜索关键词', icon: 'none' })
			return
		}
		saveHistory(kw)
		page.value = 1
		activeTypeIdx.value = 0
		typedResult.value = emptyPagedResult()
		hasSearched.value = true
		await runSearch(1, false)
	}

	function onLoadMore() : void {
		if (loading.value) return
		if (activeTypeIdx.value == 0) return
		if (!hasMore.value) return
		runSearch(page.value + 1, true)
	}

	async function onTypeChange(idx : number) : Promise<void> {
		if (activeTypeIdx.value == idx) return
		activeTypeIdx.value = idx
		page.value = 1
		typedResult.value = emptyPagedResult()
		await runSearch(1, false)
	}

	/** 分区「查看全部」→ 切到对应类型 tab */
	function onSectionMore(key : string) : void {
		for (let i = 0; i < typeTabs.length; i++) {
			if (typeTabs[i].value == key) {
				onTypeChange(i)
				return
			}
		}
	}

	function onClear() : void {
		keyword.value = ''
		hasSearched.value = false
		activeTypeIdx.value = 0
		page.value = 1
	}

	function onCancel() : void {
		const pages = getCurrentPages()
		if (pages != null && pages.length > 1) {
			uni.navigateBack({})
		} else {
			uni.reLaunch({ url: '/pages/dashboard/dashboard' })
		}
	}

	/** 落点由 utils/searchDisplay.searchItemPath 单点给出（ADR-0049 决策 2：搜到必须能打开） */
	function onItemClick(item : SearchItem) : void {
		const url = searchItemPath(item)
		if (url.length == 0) {
			uni.showToast({ title: '该结果暂无详情页', icon: 'none' })
			return
		}
		uni.navigateTo({ url: url })
	}

	function onHistoryClick(kw : string) : void {
		keyword.value = kw
		onSearch()
	}

	function onRemoveHistory(kw : string) : void {
		persistHistory(searchHistory.value.filter((s : string) : boolean => s != kw))
	}

	function onClearHistory() : void {
		searchHistory.value = [] as string[]
		uni.removeStorageSync(HISTORY_KEY)
	}
</script>

<style lang="scss">
	/* 画布：淡蓝调（$bg-tint）——白卡浮在其上，整页不再是一片纯白/纯灰 */
	.search-page {
		flex: 1;
		background-color: $bg-tint;
		flex-direction: column;
	}

	/* 主色区（对齐 course-detail / featured-list / chapter-view 等非 tabBar 页的既有写法） */
	.status-bar {
		background-color: $primary-color;
	}

	.search-header {
		flex-direction: row;
		align-items: center;
		padding: 16rpx 24rpx;
		background-color: $primary-color;
	}

	.search-input-wrap {
		flex: 1;
		flex-direction: row;
		align-items: center;
		height: 88rpx;
		background-color: $card-bg;
		border-radius: $radius-pill;
		padding: 0 8rpx 0 24rpx;
	}

	.search-icon {
		font-size: 28rpx;
		margin-right: 12rpx;
	}

	.search-input {
		flex: 1;
		font-size: $font-size-md;
		color: $text-color;
	}

	/* 清空：无底色裸 ✕，命中区 88rpx（44px，满足 AGENTS 的触摸区下限） */
	.search-clear {
		width: 88rpx;
		height: 88rpx;
		align-items: center;
		justify-content: center;
	}

	.search-clear-text {
		font-size: 30rpx;
		color: $text-color-placeholder;
	}

	.search-cancel {
		font-size: $font-size-md;
		color: $text-color-inverse;
		padding: 24rpx 8rpx 24rpx 24rpx;
		margin-left: 8rpx;
	}

	/* 筛选条：白底 + 细分隔线；选中档位由 AppChip 的主色实底承担 */
	.type-tabs-scroll {
		background-color: $card-bg;
		border-bottom-width: 1rpx;
		border-bottom-color: $border-color-light;
	}

	.type-tabs {
		flex-direction: row;
		align-items: center;
		padding: 16rpx 24rpx;
	}

	.type-tab-item {
		margin-left: 16rpx;
	}

	.type-tab-item--lead {
		margin-left: 0;
	}

	.result-scroll {
		flex: 1;
	}

	/* 分区卡片（全部态）：白卡 + 主色浅底标题带 + 主色小竖条 */
	.result-section {
		background-color: $card-bg;
		margin: 16rpx 24rpx;
		border-radius: $radius-md;
		padding: 16rpx 24rpx 8rpx;
	}

	.typed-card {
		background-color: $card-bg;
		margin: 16rpx 24rpx;
		border-radius: $radius-md;
		padding: 8rpx 24rpx;
	}

	.section-header {
		flex-direction: row;
		align-items: center;
		background-color: $primary-tint;
		border-radius: $radius-sm;
		padding: 12rpx 16rpx;
		margin-bottom: 8rpx;
	}

	.section-accent {
		width: 6rpx;
		height: 28rpx;
		border-radius: 3rpx;
		background-color: $primary-color;
	}

	.section-title {
		font-size: 30rpx;
		font-weight: bold;
		color: $text-color;
		margin-left: 14rpx;
	}

	.section-total {
		font-size: $font-size-sm;
		color: $text-color-placeholder;
		margin-left: 12rpx;
		flex: 1;
	}

	.section-more {
		font-size: $font-size-sm;
		color: $primary-color;
	}

	.section-empty {
		font-size: $font-size-sm;
		color: $text-color-placeholder;
		padding: 20rpx 0;
	}

	.result-item {
		flex-direction: row;
		align-items: center;
		padding: 24rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-color: $border-color-light;
	}

	/* uvue 不支持 :last-child ⇒ 由模板给末行加类去分隔线 */
	.result-item--last {
		border-bottom-width: 0;
	}

	.item-cover {
		width: 120rpx;
		height: 80rpx;
		border-radius: $radius-sm;
		margin-right: 20rpx;
	}

	.item-content {
		flex: 1;
		flex-direction: column;
	}

	.item-title {
		font-size: $font-size-md;
		color: $text-color;
		lines: 2;
		text-overflow: ellipsis;
	}

	.item-summary {
		font-size: $font-size-sm;
		color: $text-color-secondary;
		margin-top: 8rpx;
		lines: 2;
		text-overflow: ellipsis;
	}

	.item-hit {
		font-size: 22rpx;
		color: $primary-color;
		margin-top: 6rpx;
	}

	/* 命中：主色 + 加粗；普通段各自沿用所在行的字号与字色（两套类，避免用一套把层级压平） */
	.item-hl {
		color: $primary-color;
		font-weight: 600;
	}

	.item-title-plain {
		color: $text-color;
	}

	.item-summary-plain {
		color: $text-color-secondary;
	}

	.item-arrow {
		font-size: $font-size-lg;
		color: $text-disabled;
		margin-left: 12rpx;
	}

	.empty-wrap {
		padding: 40rpx 0;
	}

	.loading-wrap {
		padding: 40rpx 0;
		align-items: center;
	}

	.loading-text {
		font-size: 26rpx;
		color: $text-color-placeholder;
	}

	.no-more-wrap {
		padding: 40rpx 0;
		align-items: center;
	}

	.no-more-text {
		font-size: $font-size-sm;
		color: $text-color-placeholder;
	}

	/* 搜索历史：白卡 + 主色浅底胶囊（每条带单删） */
	.history-section {
		background-color: $card-bg;
		margin: 16rpx 24rpx;
		border-radius: $radius-md;
		padding: 16rpx 24rpx 24rpx;
	}

	.history-header {
		flex-direction: row;
		align-items: center;
		background-color: $primary-tint;
		border-radius: $radius-sm;
		padding: 12rpx 16rpx;
		margin-bottom: 20rpx;
	}

	.history-title {
		font-size: $font-size-md;
		font-weight: bold;
		color: $text-color;
		margin-left: 14rpx;
		flex: 1;
	}

	.history-clear {
