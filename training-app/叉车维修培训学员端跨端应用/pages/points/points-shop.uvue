<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="积分商城" @left-click="onBack" divider />

        <!-- 单筛选控件（#2619 T3）：只剩「积分范围」三档 + 「不限」复位，通栏放在双栏主体之上
             （胶囊一行放不进 180rpx 侧栏右侧的内容列）。分类五档面板、它的快捷入口「可换商品」、
             点蒙层回主态三件一并退役 —— 分区本身按商品类型切之后，面板里的分类划分与左栏重复
             （ADR-0072 决策 7） -->
        <MallRangeFilter :range-options="rangeOptions" :active-range-idx="activeRangeIdx"
            @pick-range="onPickRange" />

        <view class="main-body">
            <!-- 左栏三态（821:6396）：积分兑换 = 本页态；图书系列 → 商城路由
                 （821:6678「图书系列」→ 824:6971 边，Q8 两路由不合并，mall 路由已存在；
                 热门在原型无出边（NAV_FLOW 裁定 9：不发明落点），只陈列不接线。
                 #2619 T3 起本页是合并页的过渡形态：入口收敛（tab=points）与整页下线分别在 T4 / T5） -->
            <view class="shop-sidebar">
                <view class="side-item">
                    <text class="side-text">热门</text>
                </view>
                <view class="side-item" @click="onGoMall">
                    <text class="side-text">图书系列</text>
                </view>
                <view class="side-item side-item-active">
                    <text class="side-text side-text-active">积分兑换</text>
                </view>
            </view>

            <view class="content-col">
                <scroll-view class="content-scroll" scroll-y="true">
                    <!-- 余额条：与任务中心同一套卡片语言，兑换前先让用户看清手里有多少分
                         （#2617 T1 起是独立组件） -->
                    <points-balance-card :points="pointsBalance" @earn="onEarnPoints" />

                    <!-- 三态分离（#408/#409 口径）：失败给重试，空态如实说「暂无可兑换商品」 -->
                    <view v-if="loadFailed && items.length == 0" class="error-tip">
                        <text class="error-text">商品加载失败</text>
                        <view class="retry-btn" @click="loadItems">
                            <text class="retry-text">重试</text>
                        </view>
                    </view>
                    <view v-else-if="loading && items.length == 0" class="loading-tip">
                        <text class="loading-text">加载中...</text>
                    </view>
                    <view v-else-if="items.length == 0" class="empty-tip">
                        <text class="empty-text">暂无可兑换商品</text>
                    </view>

                    <!-- 在售项：可点性只由服务端事实决定（已拥有 / 售罄）；行样式在商品卡组件里 -->
                    <view v-if="items.length > 0" class="shop-card">
                        <points-shop-card v-for="(item, i) in items" :key="item.sku" :title="item.title"
                            :price="item.price" :last="i == items.length - 1" :stock-label="stockText(item)"
                            :btn-label="btnText(item)" :btn-class="btnClass(item)"
                            :btn-text-class="btnTextClass(item)" @redeem="onRedeem(item)" />
                    </view>

                    <view class="bottom-spacer"></view>
                </scroll-view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { onShow } from '@dcloudio/uni-app'
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import pointsBalanceCard from './components/points-balance-card.uvue'
    import pointsShopCard from './components/points-shop-card.uvue'
    import MallRangeFilter from '../mall/components/mall-range-filter.uvue'
    import { goBack } from '../../utils/navigation'
    import { useMall } from '../mall/composables/useMall.uts'

    const windowHeight = uni.getSystemInfoSync().windowHeight

    // #2617 T1：余额 / 列表 / 筛选 / 三态与全部动作都在 useMall，页面只解构消费（页面壳层零自持状态）
    const {
        pointsBalance, items, loading, loadFailed, rangeOptions, activeRangeIdx,
        stockText, btnText, btnClass, btnTextClass,
        loadBalance, loadItems, onRedeem, onPickRange, onEarnPoints,
    } = useMall()

    function onBack() : void {
        goBack()
    }

    /**
     * 左栏「图书系列」→ 商城路由（821:6678 → 824:6971 边；Q8 两路由不合并，合并页改造在 T2-T5）。
     * #2619 T3 起本页不再有「课程兑换」导流卡，它依赖的一次性跨页意图机制随之整体退役。
     */
    function onGoMall() : void {
        uni.navigateTo({ url: '/pages/mall/mall' })
    }

    onShow(() => {
        loadBalance()
        loadItems()
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: $bg-color;
        flex-direction: column;
    }

    /* 双栏主体：左栏三态 + 右侧内容 */
    .main-body {
        flex: 1;
        flex-direction: row;
    }

    /* 左栏三态（821:6396）：白底栏，激活档灰底蓝字、与内容区连片 */
    .shop-sidebar {
        width: 180rpx;
        background-color: $card-bg;
    }

    .side-item {
        padding: 32rpx 0;
        align-items: center;
        justify-content: center;
        background-color: $card-bg;
    }

    .side-item-active {
        background-color: $bg-color;
    }

    .side-text {
        font-size: 26rpx;
        color: $text-color;
    }

    .side-text-active {
        font-size: 26rpx;
        font-weight: bold;
        color: $primary-color;
    }

    .content-col {
        flex: 1;
        flex-direction: column;
    }

    /* 筛选栏样式在 pages/mall/components/mall-range-filter.uvue（#2619 T3 起两页共用一个控件） */

    .content-scroll {
        flex: 1;
    }

    /* 余额卡样式随 #2617 T1 迁入 pages/points/components/points-balance-card.uvue */

    /* 错误态 / 加载态 / 空态 */
    .error-tip {
        margin: 24rpx;
        padding: 40rpx 32rpx;
        border-radius: 16rpx;
        background-color: $card-bg;
        align-items: center;
        flex-direction: column;
    }

    .error-text {
        font-size: 26rpx;
        color: $text-color-secondary;
    }

    .retry-btn {
        margin-top: 20rpx;
        padding: 12rpx 40rpx;
        border-radius: 32rpx;
        background-color: $bg-color;
    }

    .retry-text {
        font-size: 26rpx;
        color: $primary-color;
    }

    .loading-tip {
        padding: 60rpx 0;
        align-items: center;
    }

    .loading-text {
        font-size: 26rpx;
        color: $text-color-placeholder;
    }

    .empty-tip {
        padding: 120rpx 0;
        align-items: center;
    }

    .empty-text {
        font-size: 26rpx;
        color: $text-color-placeholder;
    }

    /* 商品列表（行样式随 #2617 T1 迁入 pages/points/components/points-shop-card.uvue） */
    .shop-card {
        margin: 0 24rpx;
        padding: 0 24rpx;
        border-radius: 16rpx;
        background-color: $card-bg;
        flex-direction: column;
    }

    .bottom-spacer {
        height: 40rpx;
    }
</style>
