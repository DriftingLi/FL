<template>
    <!-- 筛选栏两态（贴片 807:2035 分类态 / 807:2190 积分范围态）：一次只展开一套。
         #2617 T1 自 points-shop.uvue 搬出 —— 展开状态（filterPanel）仍由 useMall 持有，
         组件只回抛选中事件，故模板里的判定变量名与页面态同名 -->
    <view>
        <view class="filter-bar">
            <view class="filter-trigger" @click="onToggle('category')">
                <text :class="['filter-trigger-text', { 'filter-trigger-text-on': filterPanel == 'category' }]">商品分类</text>
                <text class="filter-arrow">{{ filterPanel == 'category' ? '∧' : '∨' }}</text>
            </view>
            <view class="filter-trigger" @click="onToggle('range')">
                <text :class="['filter-trigger-text', { 'filter-trigger-text-on': filterPanel == 'range' }]">积分范围</text>
                <text class="filter-arrow">{{ filterPanel == 'range' ? '∧' : '∨' }}</text>
            </view>
            <view class="filter-hot" @click="onHot">
                <text class="filter-hot-text">可换商品</text>
            </view>
        </view>

        <!-- 展开面板（815:5332 筛选态）：分类五档 enum 按 N1 #2548；积分范围档位按票面
             给定 ≤500 / 500-1000 / >1000（贴片 807:2190 的 1-1000/1001-5000/… 五档不采用，
             与 N1 points_min/points_max 形状对齐） -->
        <view v-if="filterPanel == 'category'" class="filter-panel">
            <view v-for="(opt, i) in categoryOptions" :key="opt.value" class="pill"
                :class="{ 'pill-active': activeCategoryIdx == i }" @click="onPickCategory(i)">
                <text :class="['pill-text', { 'pill-text-active': activeCategoryIdx == i }]">{{ opt.label }}</text>
            </view>
        </view>
        <view v-if="filterPanel == 'range'" class="filter-panel">
            <view v-for="(opt, i) in rangeOptions" :key="opt.value" class="pill"
                :class="{ 'pill-active': activeRangeIdx == i }" @click="onPickRange(i)">
                <text :class="['pill-text', { 'pill-text-active': activeRangeIdx == i }]">{{ opt.label }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import type { MallFilterOption } from '../../mall/composables/useMall.uts'

    defineProps<{
        filterPanel : string
        activeCategoryIdx : number
        activeRangeIdx : number
        categoryOptions : MallFilterOption[]
        rangeOptions : MallFilterOption[]
    }>()
    const emit = defineEmits(['toggle', 'pickCategory', 'pickRange', 'hot'])

    function onToggle(panel : string) : void {
        emit('toggle', panel)
    }

    function onPickCategory(idx : number) : void {
        emit('pickCategory', idx)
    }

    function onPickRange(idx : number) : void {
        emit('pickRange', idx)
    }

    function onHot() : void {
        emit('hot')
    }
</script>

<style lang="scss">
    /* 筛选栏（贴片 807:2035 / 807:2190 顶行）：分类 / 积分范围居左，可换商品靠右 */
    .filter-bar {
        background-color: $card-bg;
        padding: 20rpx 24rpx;
        flex-direction: row;
        align-items: center;
    }

    .filter-trigger {
        flex: 1;
        flex-direction: row;
        align-items: center;
    }

    .filter-trigger-text {
        font-size: 26rpx;
        color: $text-color-secondary;
    }

    .filter-trigger-text-on {
        font-size: 26rpx;
        font-weight: bold;
        color: $text-color;
    }

    .filter-arrow {
        margin-left: 6rpx;
        font-size: 24rpx;
        color: $text-color-secondary;
    }

    .filter-hot {
        padding: 12rpx 28rpx;
        border-radius: 32rpx;
        background-color: $bg-color;
        align-items: center;
        justify-content: center;
    }

    .filter-hot-text {
        font-size: 26rpx;
        color: $text-color;
    }

    /* 展开面板（815:5332）：白底胶囊组；换行排列 → 每颗胶囊自带右/下 margin（uvue 无 gap） */
    .filter-panel {
        background-color: $card-bg;
        padding: 8rpx 24rpx 24rpx 24rpx;
        flex-direction: row;
        flex-wrap: wrap;
    }

    .pill {
        padding: 14rpx 40rpx;
        border-radius: 32rpx;
        background-color: $bg-color;
        margin-right: 24rpx;
        margin-bottom: 20rpx;
        align-items: center;
        justify-content: center;
    }

    .pill-active {
        background-color: $card-bg;
        border-width: 1rpx;
        border-style: solid;
        border-color: $border-color;
    }

    .pill-text {
        font-size: 26rpx;
        color: $text-color-secondary;
    }

    .pill-text-active {
        font-size: 26rpx;
        font-weight: bold;
        color: $text-color;
    }
</style>
