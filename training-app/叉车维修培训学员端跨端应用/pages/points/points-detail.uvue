        font-weight: bold;
        color: #333333;
        text-align: center;
    }

    .expire-tip {
        padding: 22rpx 24rpx;
        border-radius: 12rpx;
        background-color: #fdf6dd;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8rpx;
    }

    .expire-text {
        font-size: 24rpx;
        color: #333333;
        flex: 1;
    }

    .expire-arrow {
        font-size: 28rpx;
        color: #666666;
        margin-left: 16rpx;
    }

    .tab-card {
        margin: 24rpx 24rpx 0;
        border-radius: 16rpx;
        background-color: #ffffff;
        flex-direction: column;
    }

    .tab-bar {
        flex-direction: row;
        padding-top: 24rpx;
    }

    .tab-item {
        flex: 1;
        align-items: center;
    }

    .tab-text {
        font-size: 30rpx;
        color: #666666;
    }

    .tab-text-active {
        color: #333333;
        font-weight: bold;
    }

    .tab-underline {
        width: 56rpx;
        height: 8rpx;
        border-radius: 4rpx;
        margin-top: 12rpx;
        background-color: transparent;
    }

    .tab-underline-active {
        background-color: #22a7f0;
    }

    .filter-bar {
        padding: 8rpx 0 0;
    }

    .filter-scroll {
        flex: 1;
        width: 100%;
    }

    .filter-row {
        flex-direction: row;
        align-items: center;
        padding: 20rpx 24rpx;
    }

    .filter-chip {
        padding: 10rpx 32rpx;
        border-radius: 30rpx;
        border: 2rpx solid transparent;
        margin-right: 24rpx;
        flex-shrink: 0;
    }

    .filter-chip-active {
        border-color: #22a7f0;
    }

    .filter-chip-text {
        font-size: 26rpx;
        color: #666666;
    }

    .filter-chip-text-active {
        color: #22a7f0;
    }

    .detail-scroll-inner {
        padding: 24rpx;
    }

    .detail-list {
        flex-direction: column;
    }

    .detail-item {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 28rpx 24rpx;
        margin-bottom: 20rpx;
