        font-size: 26rpx;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 12rpx;
    }

    .balance-value {
        font-size: 56rpx;
        font-weight: bold;
        color: #ffffff;
        margin-bottom: 16rpx;
    }

    .balance-right {
        flex-direction: row;
        align-items: center;
        background-color: rgba(255, 255, 255, 0.2);
        padding: 8rpx 16rpx;
        border-radius: 16rpx;
    }

