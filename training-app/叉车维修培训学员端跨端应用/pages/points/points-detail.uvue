        background-color: #ffffff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        width: 60rpx;
    }

    .content-scroll {
        flex: 1;
    }

    .balance-card {
        margin: 24rpx 24rpx 0;
        padding: 24rpx 24rpx;
        border-radius: 16rpx;
        background-color: #ffffff;
        flex-direction: column;
    }

