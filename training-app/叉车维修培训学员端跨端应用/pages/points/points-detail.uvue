    }

    .empty-tip {
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    .bottom-button {
        padding: 24rpx 32rpx;
        background-color: #ffffff;
        border-top: 1rpx solid #f0f0f0;
    }

    .earn-button {
        width: 100%;
