<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <app-nav-bar title="积分明细" @left-click="onBack" divider />

        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 积分余额卡片 -->
            <view class="balance-card">
                <text class="balance-title">我的积分</text>
                <text class="balance-value">{{ pointsBalance }}</text>
                <view class="balance-right" @click="onRulesClick">
                    <text class="balance-label">积分规则 ›</text>
                </view>
            </view>

            <!-- 商城入口条（#1942 口径 B）：设计稿的「去积分商城」，落点为商城页 -->
            <view class="shop-entry" @click="onGoShop">
                <text class="shop-entry-text">去积分商城挑好物</text>
                <text class="shop-entry-arrow">›</text>
            </view>

            <!-- Tab 切换：收支方向走后端 direction 查询（#512） -->
            <view class="tab-bar">
                <view :class="['tab-item', { active: currentTab == 'all' }]" @click="onTabClick('all')">
                    <text class="tab-text">全部</text>
                </view>
                <view :class="['tab-item', { active: currentTab == 'in' }]" @click="onTabClick('in')">
                    <text class="tab-text">积分收入</text>
                </view>
                <view :class="['tab-item', { active: currentTab == 'out' }]" @click="onTabClick('out')">
                    <text class="tab-text">积分支出</text>
                </view>
            </view>

            <!-- 积分流水列表 -->
            <view class="detail-scroll-inner">
                <view v-if="loadFailed && items.length == 0" class="error-tip">
                    <text class="error-text">积分流水加载失败</text>
                    <view class="retry-btn" @click="onRetry">
                        <text class="retry-text">重试</text>
                    </view>
                </view>
                <view v-else-if="items.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">暂无积分记录</text>
                </view>
                <view class="detail-list">
                    <view v-for="item in items" :key="item.id" class="detail-item">
                        <view :class="['detail-icon-wrap', itemIconClass(item.ref_type)]">
                            <text class="detail-icon">{{ itemIconText(item.ref_type) }}</text>
                        </view>
                        <view class="detail-content">
                            <view class="detail-row">
                                <text class="detail-action">{{ itemTitle(item.reason, item.delta) }}</text>
                                <text :class="['detail-points', itemDeltaClass(item.delta)]">{{ itemDeltaText(item.delta) }}</text>
                            </view>
                            <view class="detail-row">
                                <text class="detail-source">{{ itemSourceText(item.ref_type) }}</text>
                                <text class="detail-date">{{ itemDateText(item.created_at) }}</text>
                            </view>
                        </view>
                    </view>
                </view>
                <view v-if="loading" class="loading-more">
                    <text class="loading-text">加载中...</text>
                </view>
                <!-- 已有数据时的翻页失败：页脚提示 + 点击续翻（回到当前页重试，已加载部分不丢） -->
                <view v-else-if="loadFailed && items.length > 0" class="loading-more" @click="onRetryMore">
                    <text class="loading-text">加载失败，点击重试</text>
                </view>
                <view v-else-if="noMore && items.length > 0" class="loading-more">
                    <text class="loading-text">没有更多了</text>
                </view>
            </view>
        </scroll-view>

        <!-- 底部按钮 -->
        <view class="bottom-button">
            <button class="earn-button" @click="onEarnPoints">赚更多积分</button>
        </view>
    </view>
</template>

<script setup lang="uts">
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { goBack } from '../../utils/navigation'
    import { getPointsBalanceApi, getPointsLedgerApi } from '../../api/points'
    import { ledgerReasonLabel, ledgerRefTypeText, ledgerIconClass, ledgerIconGlyph, deltaText, deltaKind } from '../../utils/pointsDisplay'
    import { formatDateTimeStr } from '../../utils/format'
    import type { PointsBalance, PointsLedgerItem } from '../../types/index'
    import type { Page } from '../../api/envelope'
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const pointsBalance = ref<number>(0)
    /** 收支方向 tab：all 全部 / in 收入 / out 支出（透传后端 direction） */
    const currentTab = ref<string>('all')
    const items = ref<PointsLedgerItem[]>([])
    const page = ref<number>(1)
    const pageSize : number = 20
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const loadFailed = ref<boolean>(false)
    /**
     * 请求代次：切 tab / 下拉刷新会立刻发起新一轮请求，旧请求的回包必须按代次丢弃，
     * 否则「上一 tab 的数据落在新 tab 上」这种串数据会稳定复现（loading 闸门挡不住刷新）。
     */
    let reqSeq = 0

    // ===== 模板侧本地薄包装（uvue 模板不可直调 import 函数，守护规则 S）=====

    function itemTitle(reason : string, delta : number) : string {
        return ledgerReasonLabel(reason, delta)
    }

    function itemSourceText(refType : string) : string {
        return ledgerRefTypeText(refType)
    }

    function itemIconClass(refType : string) : string {
        return ledgerIconClass(refType)
    }

    function itemIconText(refType : string) : string {
        return ledgerIconGlyph(refType)
    }

    function itemDeltaText(delta : number) : string {
        return deltaText(delta)
    }

    function itemDeltaClass(delta : number) : string {
        if (deltaKind(delta) == 'in') return 'points-in'
        return 'points-out'
    }

    function itemDateText(createdAt : string) : string {
        return formatDateTimeStr(createdAt)
    }

    /** 商城入口：与任务中心「去兑换」同落点（#1942） */
    function onGoShop() : void {
        uni.navigateTo({ url: '/pages/points/points-shop' })
    }

    /** tab → 后端 direction 查询值（全部不传） */
    function directionOf(tab : string) : string {
        if (tab == 'in') return 'in'
        if (tab == 'out') return 'out'
        return ''
    }

    /** 加载积分余额（失败由 request 层提示，卡片保持 0 不回填占位数） */
    function loadBalance() : void {
        getPointsBalanceApi().then((data : PointsBalance) => {
            pointsBalance.value = data.balance
        }).catch((e) => {
            console.warn('[points-detail] load balance failed:', e)
        })
    }

    /** 加载积分流水（GET /points/ledger）：isRefresh=true 重置到第 1 页（切 tab / 重试 / 进页） */
    function loadLedger(isRefresh : boolean) : void {
        if (!isRefresh) {
            // 追加翻页不并发、不越过终点
            if (loading.value || noMore.value) return
        }
        reqSeq = reqSeq + 1
        const seq = reqSeq
        const startPage = isRefresh ? 1 : page.value
        if (isRefresh) {
            noMore.value = false
            items.value = [] as PointsLedgerItem[]
            loadFailed.value = false
        }

        loading.value = true
        getPointsLedgerApi(startPage, pageSize, directionOf(currentTab.value)).then((data : Page<PointsLedgerItem>) => {
            if (seq != reqSeq) return // 已被更新的请求取代，回包作废（防串数据）
            loadFailed.value = false
            if (isRefresh) {
                items.value = data.items
            } else {
                items.value = items.value.concat(data.items)
            }
            if (!data.hasMore) {
                noMore.value = true
            }
            page.value = startPage + 1
        }).catch((e) => {
            if (seq != reqSeq) return
            // 失败可见：不再回落占位流水（#662 幻影 404 就是这么被盖住的）
            loadFailed.value = true
            console.warn('[points-detail] load ledger failed:', e)
        }).finally(() => {
            if (seq == reqSeq) loading.value = false
        })
    }

    function onTabClick(tab : string) : void {
        if (currentTab.value == tab) return
        currentTab.value = tab
        loadLedger(true)
    }

    /** 整屏失败重试：回到第 1 页重取 */
    function onRetry() : void {
        loadLedger(true)
    }

    /** 翻页失败重试：停在失败的那一页续取，已加载的部分不丢（页脚入口） */
    function onRetryMore() : void {
        loadLedger(false)
    }

    function onLoadMore() : void {
        loadLedger(false)
    }

    function onBack() : void {
        goBack()
    }

    function onEarnPoints() : void {
        uni.navigateTo({ url: '/pages/points/task-center' })
    }

    /** 「积分规则」标签跳静态规则页（#1943：原为死标签） */
    function onRulesClick() : void {
        uni.navigateTo({ url: '/pages/points/points-rules' })
    }

    onShow(() => {
        loadBalance()
        loadLedger(true)
    })
</script>

<style lang="scss">
    .container {
        flex: 1;
        background-color: $bg-color;
        flex-direction: column;
    }

    .content-scroll {
        flex: 1;
    }

    .balance-card {
        margin: 24rpx;
        padding: 32rpx;
        border-radius: 16rpx;
        background: linear-gradient(to bottom right, #2979ff, #1565c0);
        background-color: #1565c0;
        flex-direction: column;
        align-items: flex-start;
    }

    .balance-title {
        font-size: 26rpx;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 12rpx;
    }

    .balance-value {
        font-size: 56rpx;
        font-weight: bold;
        color: $text-color-inverse;
        margin-bottom: 16rpx;
    }

    .balance-right {
        flex-direction: row;
        align-items: center;
        background-color: rgba(255, 255, 255, 0.2);
        padding: 16rpx 24rpx;
        border-radius: 16rpx;
    }

    .balance-label {
        font-size: 24rpx;
        color: $text-color-inverse;
    }

    /* 商城入口条（#1942） */
    .shop-entry {
        margin: 24rpx;
        padding: 26rpx 32rpx;
        border-radius: 16rpx;
        background-color: $card-bg;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .shop-entry-text {
        font-size: 26rpx;
        color: $text-color;
    }

    .shop-entry-arrow {
        font-size: 34rpx;
        color: $text-color-placeholder;
    }

    .tab-bar {
        background-color: $card-bg;
        flex-direction: row;
        border-bottom: 1rpx solid $border-color-light;
    }

    .tab-item {
        flex: 1;
        padding: 28rpx 0;
        align-items: center;
        justify-content: center;
        border-bottom: 4rpx solid transparent;
    }

    .tab-item.active {
        border-bottom-color: #2979ff;
    }

    .tab-text {
        font-size: 30rpx;
        color: $text-color-secondary;
    }

    .tab-item.active .tab-text {
        color: #2979ff;
        font-weight: bold;
        font-size: 30rpx;
    }

    .detail-scroll-inner {
        padding: 24rpx;
    }

    .detail-list {
        flex-direction: column;
    }

    .detail-item {
        background-color: $card-bg;
        border-radius: 16rpx;
        padding: 32rpx;
        margin-bottom: 16rpx;
        flex-direction: row;
        align-items: flex-start;
    }

    .detail-icon-wrap {
        width: 72rpx;
        height: 72rpx;
        border-radius: 12rpx;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .icon-task {
        background-color: $success-tint;
    }

    .icon-checkin {
        background-color: $success-tint;
    }

    .icon-redeem {
        background-color: $warning-tint;
    }

    .icon-community {
        background-color: #e3f2fd;
    }

    .icon-admin {
        background-color: #fbe9e7;
    }

    .icon-default {
        background-color: $bg-color;
    }

    .detail-icon {
        font-size: 32rpx;
        color: $text-color-secondary;
    }

    .detail-content {
        flex: 1;
        flex-direction: column;
    }

    .detail-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8rpx;
    }

    .detail-action {
        font-size: 30rpx;
        font-weight: bold;
        color: $text-color;
    }

    .detail-points {
        font-size: 32rpx;
        font-weight: bold;
    }

    .points-in {
        color: #2979ff;
    }

    .points-out {
        color: #ee0a24;
    }

    .detail-source {
        font-size: 22rpx;
        color: $text-color-placeholder;
        background-color: $bg-color;
        padding: 4rpx 12rpx;
        border-radius: 6rpx;
    }

    .detail-date {
        font-size: 22rpx;
        color: $text-color-placeholder;
    }

    .empty-tip {
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: $text-color-placeholder;
    }

    .error-tip {
        align-items: center;
        padding: 60rpx 0;
        flex-direction: column;
    }

    .error-text {
        font-size: 28rpx;
        color: $text-color-secondary;
        margin-bottom: 20rpx;
    }

    .retry-btn {
        padding: 12rpx 40rpx;
        border-radius: 32rpx;
        background-color: #2979ff;
    }

    .retry-text {
        font-size: 26rpx;
        color: $text-color-inverse;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: $text-color-placeholder;
    }

    .bottom-button {
        padding: 24rpx 32rpx;
        background-color: $card-bg;
        border-top: 1rpx solid $border-color-light;
    }

    .earn-button {
        width: 100%;
        height: 96rpx;
        border-radius: 48rpx;
        background: linear-gradient(to bottom right, #2979ff, #1565c0);
        background-color: #1565c0;
        color: $text-color-inverse;
        font-size: 34rpx;
        font-weight: bold;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4rpx 16rpx rgba(41, 121, 255, 0.3);
    }
</style>
