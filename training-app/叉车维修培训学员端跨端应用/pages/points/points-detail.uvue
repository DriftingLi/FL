        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        background-color: #ffffff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

