<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">积分明细</text>
            <view class="header-right"></view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 积分余额卡片 -->
            <view class="balance-card">
                <text class="balance-title">我的积分</text>
                <text class="balance-value">{{ pointsBalance }}</text>
                <view class="balance-right">
                    <text class="balance-label">积分规则</text>
                </view>
            </view>

            <!-- Tab 切换 -->
            <view class="tab-bar">
                <view :class="['tab-item', { active: currentTab == 'income' }]" @click="onTabClick('income')">
                    <text class="tab-text">积分收入</text>
                </view>
                <view :class="['tab-item', { active: currentTab == 'expense' }]" @click="onTabClick('expense')">
                    <text class="tab-text">积分支出</text>
                </view>
            </view>

            <!-- 筛选条件 -->
            <view class="filter-bar">
                <scroll-view class="filter-scroll" scroll-x="true">
                    <view v-for="(opt, idx) in filterOptions" :key="idx"
                        :class="['filter-chip', { active: currentFilter == opt.value }]"
                        @click="onFilterClick(opt.value)">
                        <text class="filter-chip-text">{{ opt.label }}</text>
                    </view>
                </scroll-view>
            </view>

            <!-- 积分明细列表 -->
            <view class="detail-scroll-inner">
                <view v-if="pointsList.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">暂无积分记录</text>
                </view>
                <view class="detail-list">
                    <view v-for="(item, idx) in pointsList" :key="idx" class="detail-item">
                        <view class="detail-icon-wrap" :class="'icon-' + item.source_type">
                            <text class="detail-icon">{{ getSourceTypeIcon(item.source_type) }}</text>
                        </view>
                        <view class="detail-content">
                            <view class="detail-row">
                                <text class="detail-action">{{ item.action }}</text>
                                <text class="detail-points">{{ item.points > 0 ? '+' : '' }}{{ item.points }}</text>
                            </view>
                            <view class="detail-row">
                                <text class="detail-desc">{{ item.description }}</text>
                            </view>
                            <view class="detail-row">
                                <text class="detail-source">{{ getSourceTypeText(item.source_type) }}</text>
                                <text class="detail-date">{{ item.created_at }}</text>
                            </view>
                        </view>
                    </view>
                </view>
                <view v-if="loading" class="loading-more">
                    <text class="loading-text">加载中...</text>
                </view>
                <view v-if="noMore && pointsList.length > 0" class="loading-more">
                    <text class="loading-text">没有更多了</text>
                </view>
            </view>
        </scroll-view>

        <!-- 底部按钮 -->
        <view class="bottom-button">
            <button class="earn-button" @click="onEarnPoints">赚更多积分</button>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getPointsBalanceApi, getPointsRecordListApi } from '../../api/points'
    import type { PointsBalance, PointsRecord } from '../../types/index'

    type FilterOption = {
        label : string
        value : string
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const pointsBalance = ref<number>(0)
    const currentTab = ref<string>('income')
    const currentFilter = ref<string>('all')
    const pointsList = ref<PointsRecord[]>([])
    const page = ref<number>(1)
    const pageSize = 20
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const loadingBalance = ref<boolean>(false)

    const filterOptions : FilterOption[] = [
        { label: '全部', value: 'all' },
        { label: '签到', value: 'check_in' },
        { label: '浏览课程', value: 'course_view' },
    ]

    /** 根据当前 Tab 计算查询类型 */
    const queryType = computed<string>(() : string => {
        if (currentTab.value == 'income') return 'income'
        if (currentTab.value == 'expense') return 'expense'
        return 'all'
    })

    /** 加载积分余额 */
    function loadBalance() : void {
        loadingBalance.value = true
        getPointsBalanceApi().then((data : PointsBalance) => {
            pointsBalance.value = data.total_points
        }).catch((e) => {
            console.warn('[points-detail] load balance failed:', e)
        }).finally(() => {
            loadingBalance.value = false
        })
    }

    /** 加载积分明细列表 */
    function loadRecords(isRefresh : boolean = false) : void {
        if (loading.value) return
        if (isRefresh) {
            page.value = 1
            noMore.value = false
            pointsList.value = [] as PointsRecord[]
        }
        if (noMore.value) return

        loading.value = true
        getPointsRecordListApi(page.value, pageSize, queryType.value, currentFilter.value).then((data) => {
            if (isRefresh) {
                pointsList.value = data.records
            } else {
                pointsList.value = pointsList.value.concat(data.records)
            }
            if (pointsList.value.length >= data.total || data.records.length < pageSize) {
                noMore.value = true
            }
            page.value++
        }).catch((e) => {
            console.warn('[points-detail] load records failed:', e)
        }).finally(() => {
            loading.value = false
        })
    }

    function onTabClick(tab : string) : void {
        if (currentTab.value == tab) return
        currentTab.value = tab
        loadRecords(true)
    }

    function onFilterClick(filter : string) : void {
        if (currentFilter.value == filter) return
        currentFilter.value = filter
        loadRecords(true)
    }

    function onBack() : void {
        goBack()
    }

    function onEarnPoints() : void {
        uni.navigateTo({ url: '/pages/points/task-center' })
    }

    /** 获取来源类型显示文本 */
    function getSourceTypeText(sourceType : string) : string {
        if (sourceType == 'check_in') return '签到'
        if (sourceType == 'course_view') return '浏览课程'
        if (sourceType == 'exam_pass') return '通过考试'
        if (sourceType == 'course_complete') return '完成课程'
        return '其他'
    }

    /** 获取来源类型图标 */
    function getSourceTypeIcon(sourceType : string) : string {
        if (sourceType == 'check_in') return ''
        if (sourceType == 'course_view') return ''
        if (sourceType == 'exam_pass') return ''
        if (sourceType == 'course_complete') return ''
        return ''
    }

    onShow(() => {
        loadBalance()
        loadRecords(true)
    })
</script>

