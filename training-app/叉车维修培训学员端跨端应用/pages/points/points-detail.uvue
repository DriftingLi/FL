    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        width: 60rpx;
    }

    .content-scroll {
        flex: 1;
    }

    .balance-card {
        margin: 24rpx;
        padding: 28rpx 32rpx;
        border-radius: 16rpx;
        background-color: #ffffff;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .balance-value {
        font-size: 48rpx;
        font-weight: bold;
        color: #333333;
    }

