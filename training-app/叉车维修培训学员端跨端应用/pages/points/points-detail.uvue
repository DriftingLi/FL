    }

    .detail-icon-wrap {
        width: 72rpx;
        height: 72rpx;
        border-radius: 12rpx;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .icon-check_in {
        background-color: #e8f5e9;
    }

    .icon-course_view {
        background-color: #e3f2fd;
    }

    .icon-exam_pass {
        background-color: #fff3e0;
    }

    .icon-course_complete {
        background-color: #fce4ec;
    }

    .detail-icon {
        font-size: 36rpx;
    }

    .detail-content {
        flex: 1;
        flex-direction: column;
    }

    .detail-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8rpx;
    }

    .detail-action {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
    }

    .detail-points {
