<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">积分明细</text>
            <view class="header-right"></view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <!-- 积分余额卡片 -->
            <view class="balance-card">
                <text class="balance-title">我的积分</text>
                <text class="balance-value">{{ pointsBalance }}</text>
                <view class="balance-right">
                    <text class="balance-label">积分规则</text>
                </view>
            </view>

            <!-- Tab 切换：收支方向走后端 direction 查询（#512） -->
            <view class="tab-bar">
                <view :class="['tab-item', { active: currentTab == 'all' }]" @click="onTabClick('all')">
                    <text class="tab-text">全部</text>
                </view>
                <view :class="['tab-item', { active: currentTab == 'in' }]" @click="onTabClick('in')">
                    <text class="tab-text">积分收入</text>
                </view>
                <view :class="['tab-item', { active: currentTab == 'out' }]" @click="onTabClick('out')">
                    <text class="tab-text">积分支出</text>
                </view>
            </view>

            <!-- 二级筛选：过期维度后端未支持，按条目 expires_at 客户端筛（#709 待后端清单） -->
            <view class="filter-bar">
                <view :class="['filter-chip', { active: currentExpireFilter == 'expiring' }]"
                    @click="onExpireFilterClick()">
                    <text class="filter-chip-text">只看即将过期</text>
                </view>
            </view>

            <!-- 积分流水列表 -->
            <view class="detail-scroll-inner">
                <view v-if="loadFailed && items.length == 0" class="error-tip">
                    <text class="error-text">积分流水加载失败</text>
                    <view class="retry-btn" @click="onRetry">
                        <text class="retry-text">重试</text>
                    </view>
                </view>
                <view v-else-if="displayItems.length == 0 && !loading" class="empty-tip">
                    <text class="empty-text">{{ emptyText }}</text>
                </view>
                <view class="detail-list">
                    <view v-for="(item, idx) in displayItems" :key="item.id" class="detail-item">
                        <view :class="['detail-icon-wrap', itemIconClass(item.ref_type)]">
                            <text class="detail-icon">{{ itemIconText(item.ref_type) }}</text>
                        </view>
                        <view class="detail-content">
                            <view class="detail-row">
                                <text class="detail-action">{{ itemTitle(item.reason, item.delta) }}</text>
                                <text :class="['detail-points', itemDeltaClass(item.delta)]">{{ itemDeltaText(item.delta) }}</text>
                            </view>
                            <view class="detail-row">
                                <text class="detail-source">{{ itemSourceText(item.ref_type) }}</text>
                                <text class="detail-date">{{ itemDateText(item.created_at) }}</text>
                            </view>
                        </view>
                    </view>
                </view>
                <view v-if="loading" class="loading-more">
                    <text class="loading-text">加载中...</text>
                </view>
                <!-- 已有数据时的翻页失败：页脚提示 + 点击重试，不吞掉已加载部分 -->
                <view v-else-if="loadFailed && items.length > 0" class="loading-more" @click="onRetry">
                    <text class="loading-text">加载失败，点击重试</text>
                </view>
                <view v-else-if="noMore && displayItems.length > 0" class="loading-more">
                    <text class="loading-text">没有更多了</text>
                </view>
            </view>
        </scroll-view>

        <!-- 底部按钮 -->
        <view class="bottom-button">
            <button class="earn-button" @click="onEarnPoints">赚更多积分</button>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getPointsBalanceApi, getPointsLedgerApi } from '../../api/points'
    import { ledgerReasonLabel, ledgerRefTypeText, ledgerIconClass, deltaText, expiringWithinDays, todayDateStr } from '../../utils/pointsDisplay'
    import { formatDateTimeStr } from '../../utils/format'
    import type { PointsBalance, PointsLedgerItem, PointsLedgerResult } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    /** 「即将过期」窗口天数（与积分规则文案「到期前 30 天提醒」同口径） */
    const EXPIRE_WINDOW_DAYS : number = 30

    const pointsBalance = ref<number>(0)
    /** 收支方向 tab：all 全部 / in 收入 / out 支出（透传后端 direction） */
    const currentTab = ref<string>('all')
    /** 过期维度客户端筛选：all / expiring */
    const currentExpireFilter = ref<string>('all')
    const items = ref<PointsLedgerItem[]>([])
    const page = ref<number>(1)
    const pageSize : number = 20
    const loading = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const loadFailed = ref<boolean>(false)
    /**
     * 请求代次：切 tab / 下拉刷新会立刻发起新一轮请求，旧请求的回包必须按代次丢弃，
     * 否则「上一 tab 的数据落在新 tab 上」这种串数据会稳定复现（loading 闸门挡不住刷新）。
     */
    let reqSeq = 0

    // ===== 模板侧本地薄包装（uvue 模板不可直调 import 函数，守护规则 S）=====

    function itemTitle(reason : string, delta : number) : string {
        return ledgerReasonLabel(reason, delta)
    }

    function itemSourceText(refType : string) : string {
        return ledgerRefTypeText(refType)
    }

    function itemIconClass(refType : string) : string {
        return ledgerIconClass(refType)
    }

    function itemIconText(refType : string) : string {
        if (refType == 'task') return '◆'
        if (refType == 'checkin') return '✓'
        if (refType == 'course' || refType == 'real_paper' || refType == 'shop') return '★'
        if (refType == 'forum_topic' || refType == 'contribution') return '✎'
        if (refType == 'admin') return '!'
        return '·'
    }

    function itemDeltaText(delta : number) : string {
        return deltaText(delta)
    }

    function itemDeltaClass(delta : number) : string {
        if (delta >= 0) return 'points-in'
        return 'points-out'
    }

    function itemDateText(createdAt : string) : string {
        return formatDateTimeStr(createdAt)
    }

    /** tab → 后端 direction 查询值（全部不传） */
    function directionOf(tab : string) : string {
        if (tab == 'in') return 'in'
        if (tab == 'out') return 'out'
        return ''
    }

    /**
     * 展示列表：过期维度按条目 expires_at 客户端筛。
     * 边界（诚实呈现）：后端 ledger 无过期查询参数，客户端只能筛「已加载条目」，
     * 继续下拉翻页会纳入更多条目；首版 expires_at 恒 null → 该筛选恒空列表。
     * 真正的过期维度见 #709 待后端清单。
     */
    const displayItems = computed<PointsLedgerItem[]>(() : PointsLedgerItem[] => {
        if (currentExpireFilter.value != 'expiring') return items.value
        const today = todayDateStr()
        const out : PointsLedgerItem[] = []
        for (let i = 0; i < items.value.length; i++) {
            if (expiringWithinDays(items.value[i].expires_at, today, EXPIRE_WINDOW_DAYS)) {
                out.push(items.value[i])
            }
        }
        return out
    })

    const emptyText = computed<string>(() : string => {
        if (currentExpireFilter.value == 'expiring') return '暂无即将过期积分，当前积分永久有效'
        return '暂无积分记录'
    })

    /** 加载积分余额（失败由 request 层提示，卡片保持 0 不回填占位数） */
    function loadBalance() : void {
        getPointsBalanceApi().then((data : PointsBalance) => {
            pointsBalance.value = data.balance
        }).catch((e) => {
            console.warn('[points-detail] load balance failed:', e)
        })
    }

    /** 加载积分流水（GET /points/ledger）：isRefresh=true 重置到第 1 页（切 tab / 重试 / 进页） */
    function loadLedger(isRefresh : boolean) : void {
        if (!isRefresh) {
            // 追加翻页不并发、不越过终点
            if (loading.value || noMore.value) return
        }
        reqSeq = reqSeq + 1
        const seq = reqSeq
        const startPage = isRefresh ? 1 : page.value
        if (isRefresh) {
            noMore.value = false
            items.value = [] as PointsLedgerItem[]
            loadFailed.value = false
        }

        loading.value = true
        getPointsLedgerApi(startPage, pageSize, directionOf(currentTab.value)).then((data : PointsLedgerResult) => {
            if (seq != reqSeq) return // 已被更新的请求取代，回包作废（防串数据）
            loadFailed.value = false
            if (isRefresh) {
                items.value = data.items
            } else {
                items.value = items.value.concat(data.items)
            }
            if (items.value.length >= data.total || data.items.length < pageSize) {
                noMore.value = true
            }
            page.value = startPage + 1
        }).catch((e) => {
            if (seq != reqSeq) return
            // 失败可见：不再回落占位流水（#662 幻影 404 就是这么被盖住的）
            loadFailed.value = true
            console.warn('[points-detail] load ledger failed:', e)
        }).finally(() => {
            if (seq == reqSeq) loading.value = false
        })
    }

    function onTabClick(tab : string) : void {
        if (currentTab.value == tab) return
        currentTab.value = tab
        loadLedger(true)
    }

    function onExpireFilterClick() : void {
        currentExpireFilter.value = currentExpireFilter.value == 'expiring' ? 'all' : 'expiring'
    }

    function onRetry() : void {
        loadLedger(true)
    }

    function onLoadMore() : void {
        loadLedger(false)
    }

    function onBack() : void {
        goBack()
    }

    function onEarnPoints() : void {
        uni.navigateTo({ url: '/pages/points/task-center' })
    }

    onShow(() => {
        loadBalance()
        loadLedger(true)
    })
</script>

<style>
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        background-color: #ffffff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        width: 60rpx;
    }

    .content-scroll {
        flex: 1;
    }

    .balance-card {
        margin: 24rpx;
        padding: 32rpx;
        border-radius: 16rpx;
        background: linear-gradient(135deg, #2979ff, #1565c0);
        flex-direction: column;
        align-items: flex-start;
    }

    .balance-title {
        font-size: 26rpx;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 12rpx;
    }

    .balance-value {
        font-size: 56rpx;
        font-weight: bold;
        color: #ffffff;
        margin-bottom: 16rpx;
    }

    .balance-right {
        flex-direction: row;
        align-items: center;
        background-color: rgba(255, 255, 255, 0.2);
        padding: 8rpx 16rpx;
        border-radius: 16rpx;
    }

    .balance-label {
        font-size: 24rpx;
        color: #ffffff;
    }

    .tab-bar {
        background-color: #ffffff;
        flex-direction: row;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .tab-item {
        flex: 1;
        padding: 28rpx 0;
        align-items: center;
        justify-content: center;
        border-bottom: 4rpx solid transparent;
    }

    .tab-item.active {
        border-bottom-color: #2979ff;
    }

    .tab-text {
        font-size: 30rpx;
        color: #666666;
    }

    .tab-item.active .tab-text {
        color: #2979ff;
        font-weight: bold;
        font-size: 30rpx;
    }

    .filter-bar {
        background-color: #ffffff;
        border-bottom: 1rpx solid #f0f0f0;
        flex-direction: row;
        align-items: center;
        padding: 20rpx 24rpx;
    }

    .filter-chip {
        padding: 12rpx 28rpx;
        border-radius: 32rpx;
        background-color: #f5f5f5;
        flex-shrink: 0;
    }

    .filter-chip.active {
        background-color: #2979ff;
    }

    .filter-chip-text {
        font-size: 26rpx;
        color: #666666;
    }

    .filter-chip.active .filter-chip-text {
        color: #ffffff;
        font-weight: 500;
    }

    .detail-scroll-inner {
        padding: 24rpx;
    }

    .detail-list {
        flex-direction: column;
    }

    .detail-item {
        background-color: #ffffff;
        border-radius: 16rpx;
        padding: 32rpx;
        margin-bottom: 16rpx;
        flex-direction: row;
        align-items: flex-start;
    }

    .detail-icon-wrap {
        width: 72rpx;
        height: 72rpx;
        border-radius: 12rpx;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
        flex-shrink: 0;
    }

    .icon-task {
        background-color: #e8f5e9;
    }

    .icon-checkin {
        background-color: #e8f5e9;
    }

    .icon-redeem {
        background-color: #fff3e0;
    }

    .icon-community {
        background-color: #e3f2fd;
    }

    .icon-admin {
        background-color: #fbe9e7;
    }

    .icon-default {
        background-color: #f5f5f5;
    }

    .detail-icon {
        font-size: 32rpx;
        color: #666666;
    }

    .detail-content {
        flex: 1;
        flex-direction: column;
    }

    .detail-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8rpx;
    }

    .detail-action {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
    }

    .detail-points {
        font-size: 32rpx;
        font-weight: bold;
    }

    .points-in {
        color: #2979ff;
    }

    .points-out {
        color: #ee0a24;
    }

    .detail-source {
        font-size: 22rpx;
        color: #999999;
        background-color: #f5f5f5;
        padding: 4rpx 12rpx;
        border-radius: 6rpx;
    }

    .detail-date {
        font-size: 22rpx;
        color: #999999;
    }

    .empty-tip {
        align-items: center;
        padding: 120rpx 0;
    }

    .empty-text {
        font-size: 28rpx;
        color: #999999;
    }

    .error-tip {
        align-items: center;
        padding: 60rpx 0;
        flex-direction: column;
    }

    .error-text {
        font-size: 28rpx;
        color: #666666;
        margin-bottom: 20rpx;
    }

    .retry-btn {
        padding: 12rpx 40rpx;
        border-radius: 32rpx;
        background-color: #2979ff;
    }

    .retry-text {
        font-size: 26rpx;
        color: #ffffff;
    }

    .loading-more {
        align-items: center;
        padding: 24rpx 0;
    }

    .loading-text {
        font-size: 24rpx;
        color: #999999;
    }

    .bottom-button {
        padding: 24rpx 32rpx;
        background-color: #ffffff;
        border-top: 1rpx solid #f0f0f0;
    }

    .earn-button {
        width: 100%;
        height: 96rpx;
        border-radius: 48rpx;
        background: linear-gradient(135deg, #2979ff, #1565c0);
        color: #ffffff;
        font-size: 34rpx;
        font-weight: bold;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4rpx 16rpx rgba(41, 121, 255, 0.3);
    }
</style>
