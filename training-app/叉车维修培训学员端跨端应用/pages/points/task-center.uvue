<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">任务中心</text>
            <view class="header-right"></view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 积分卡片（余额 / 累计来自 GET /points/balance，今日可得按未领任务算） -->
            <view class="balance-card">
                <view class="balance-top">
                    <view class="balance-coin">
                        <text class="coin-icon">🪙</text>
                    </view>
                    <view class="balance-info">
                        <text class="balance-label">可用积分</text>
                        <text class="balance-value">{{ pointsBalance }}</text>
                    </view>
                    <view class="balance-exchange" @click="goExchange">
                        <text class="exchange-text">去兑换</text>
                    </view>
                </view>
                <view class="balance-bottom">
                    <text class="balance-stats">今日可得  +{{ todayEarnable }}，累计获得 {{ totalEarned }}</text>
                </view>
            </view>

            <!-- 错误态：任务加载失败要可见（旧版整页硬编码占位任务，后端异常无人发现） -->
            <view v-if="loadFailed" class="error-tip">
                <text class="error-text">任务加载失败</text>
                <view class="retry-btn" @click="onRetry">
                    <text class="retry-text">重试</text>
                </view>
            </view>

            <view v-else-if="loading && tasks.length == 0" class="loading-tip">
                <text class="loading-text">加载中...</text>
            </view>

            <!-- 任务分组：daily / newbie / growth 由后端 group 直分 -->
            <view v-for="(g, gi) in grouped" :key="gi" class="section">
                <view class="section-header">
                    <text class="section-title">{{ g.label }}</text>
                    <view class="section-underline"></view>
                    <text class="section-desc">{{ g.desc }}</text>
                </view>
                <view class="task-card">
                    <view v-for="(task, ti) in g.tasks" :key="task.code"
                        :class="['task-item', { 'task-item-last': ti == g.tasks.length - 1 }]">
                        <view :class="['task-icon-wrap', groupIconClass(task.group)]">
                            <text class="task-icon">{{ taskIconText(task.code, task.group) }}</text>
                        </view>
                        <view class="task-content">
                            <view class="task-title-row">
                                <text class="task-title">{{ task.title }}</text>
                                <text v-if="task.total > 1" class="task-progress">（{{ task.progress }}/{{ task.total }}）</text>
                            </view>
                            <text class="task-desc">{{ task.desc }}</text>
                        </view>
                        <text class="task-points">+{{ task.points }}</text>
                        <view :class="['task-btn', taskBtnClass(task.status)]" @click="onTaskBtn(task)">
                            <text :class="['task-btn-text', taskBtnTextClass(task.status)]">{{ taskBtnText(task.status, task.code) }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <view class="bottom-spacer"></view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getPointsBalanceApi, getPointsTasksApi, claimPointsTaskApi } from '../../api/points'
    import { earnablePoints } from '../../utils/pointsDisplay'
    import type { PointsBalance, PointsTaskItem, PointsTasksResult, PointsClaimResult } from '../../types/index'

    /** 分组视图（后端 group → 端上展示的一段任务清单） */
    type TaskGroupView = {
        key : string
        label : string
        desc : string
        tasks : PointsTaskItem[]
    }

    /** 任务跳转目标（tab 页要走 switchTab，navigateTo 打不开 tabBar 页） */
    type TaskRoute = {
        url : string
        tab : boolean
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // ===== 状态（声明先于一切引用它的函数：UTS 无提升，后置声明即 Kotlin 编译错）=====

    const pointsBalance = ref<number>(0)
    const totalEarned = ref<number>(0)
    const tasks = ref<PointsTaskItem[]>([])
    const loading = ref<boolean>(false)
    const loadFailed = ref<boolean>(false)
    /** 正在领取的任务 code（空串表示无进行中请求，兼作防重入闸门） */
    const claimingCode = ref<string>('')

    // ===== 纯映射函数（须先于调用它们的 computed / 事件函数定义，守护规则 A）=====

    function groupLabelOf(group : string) : string {
        if (group == 'daily') return '每日任务'
        if (group == 'newbie') return '新手任务'
        if (group == 'growth') return '成长任务'
        return '其他任务'
    }

    /** 分组口径文案与后端配置同源（daily/growth 同为当日达成当日领，#410） */
    function groupDescOf(group : string) : string {
        if (group == 'daily') return '每日 0 点重置，当日达成当日领'
        if (group == 'newbie') return '一次性任务，完成后不再出现'
        if (group == 'growth') return '每日达成每日领，当日 0 点重置'
        return ''
    }

    function groupIconClass(group : string) : string {
        if (group == 'daily') return 'icon-daily'
        if (group == 'newbie') return 'icon-newbie'
        if (group == 'growth') return 'icon-growth'
        return 'icon-other'
    }

    function taskIconText(code : string, group : string) : string {
        if (code == 'daily_login') return '👆'
        if (code == 'daily_quiz') return '📝'
        if (code == 'daily_browse') return '📖'
        if (code == 'growth_post') return '📋'
        if (code == 'growth_reply') return '💬'
        if (code == 'growth_mock') return '📊'
        if (code == 'growth_first_experience') return '✍️'
        if (code == 'newbie_profile_basic') return '👤'
        if (code == 'newbie_profile_contact') return '📱'
        if (code == 'newbie_credential') return '🎯'
        if (code == 'newbie_first_course') return '🎬'
        if (group == 'newbie') return '🎁'
        return '⭐'
    }

    /** 「去完成」落点：任务 code → 页面路由（无前置动作的任务返回空 url） */
    function taskRoute(code : string) : TaskRoute {
        if (code == 'daily_quiz' || code == 'growth_mock') return { url: '/pages/practice/practice', tab: false } as TaskRoute
        if (code == 'daily_browse' || code == 'growth_reply') return { url: '/pages/forum/forum', tab: true } as TaskRoute
        if (code == 'growth_post' || code == 'growth_first_experience') return { url: '/pages/forum/forum-create', tab: false } as TaskRoute
        if (code == 'newbie_profile_basic' || code == 'newbie_profile_contact') return { url: '/pages/profile/personal-info', tab: false } as TaskRoute
        if (code == 'newbie_credential') return { url: '/pages/profile-setup/profile-setup', tab: false } as TaskRoute
        if (code == 'newbie_first_course') return { url: '/pages/courses/courses', tab: true } as TaskRoute
        return { url: '', tab: false } as TaskRoute
    }

    /** 按后端 group 分组（口径同 Web TaskCenter groupLabelMap，不另造端上分组） */
    function buildGroups(list : PointsTaskItem[]) : TaskGroupView[] {
        const order : string[] = ['daily', 'newbie', 'growth']
        const out : TaskGroupView[] = []
        for (let i = 0; i < order.length; i++) {
            const bucket : PointsTaskItem[] = []
            for (let j = 0; j < list.length; j++) {
                if (list[j].group == order[i]) bucket.push(list[j])
            }
            if (bucket.length > 0) {
                out.push({ key: order[i], label: groupLabelOf(order[i]), desc: groupDescOf(order[i]), tasks: bucket } as TaskGroupView)
            }
        }
        // 后端新增分组时兜底成段，避免任务在端上凭空消失
        const rest : PointsTaskItem[] = []
        for (let j = 0; j < list.length; j++) {
            if (order.indexOf(list[j].group) < 0) rest.push(list[j])
        }
        if (rest.length > 0) {
            out.push({ key: 'other', label: '其他任务', desc: '', tasks: rest } as TaskGroupView)
        }
        return out
    }

    function taskBtnText(status : string, code : string) : string {
        if (claimingCode.value == code) return '领取中'
        if (status == 'claimable') return '领取'
        if (status == 'claimed') return '已领取'
        return '去完成'
    }

    function taskBtnClass(status : string) : string {
        if (status == 'claimed') return 'task-btn-done'
        if (status == 'todo') return 'task-btn-todo'
        return 'task-btn-claim'
    }

    function taskBtnTextClass(status : string) : string {
        if (status == 'claimed') return 'text-done'
        if (status == 'todo') return 'text-todo'
        return 'text-claim'
    }

    // ===== 派生视图 =====

    const grouped = computed<TaskGroupView[]>(() : TaskGroupView[] => buildGroups(tasks.value))

    /** 今日可得：未领取任务的奖励之和（后端无 today_earned 字段，口径同 Web） */
    const todayEarnable = computed<number>(() : number => earnablePoints(tasks.value))

    // ===== 数据加载 =====

    function loadBalance() : void {
        getPointsBalanceApi().then((data : PointsBalance) => {
            pointsBalance.value = data.balance
            totalEarned.value = data.total_earned
        }).catch((e) => {
            console.warn('[task-center] load balance failed:', e)
        })
    }

    function loadTasks() : void {
        loading.value = true
        getPointsTasksApi().then((data : PointsTasksResult) => {
            loadFailed.value = false
            tasks.value = data.tasks
        }).catch((e) => {
            loadFailed.value = true
            console.warn('[task-center] load tasks failed:', e)
        }).finally(() => {
            loading.value = false
        })
    }

    function onRetry() : void {
        loadBalance()
        loadTasks()
    }

    // ===== 交互 =====

    /** 领取：成功用返回的余额即时刷新；失败（含「今日已领」幂等）一律回读服务端状态 */
    function onClaim(task : PointsTaskItem) : void {
        if (claimingCode.value.length > 0) return
        claimingCode.value = task.code
        claimPointsTaskApi(task.code).then((res : PointsClaimResult) => {
            pointsBalance.value = res.balance
            totalEarned.value = res.total_earned
            uni.showToast({ title: '已领取 +' + task.points.toString() + ' 积分', icon: 'none' })
            loadTasks()
        }).catch((e) => {
            console.warn('[task-center] claim failed:', e)
            loadTasks()
        }).finally(() => {
            claimingCode.value = ''
        })
    }

    function onGo(task : PointsTaskItem) : void {
        const route = taskRoute(task.code)
        if (route.url.length == 0) {
            uni.showToast({ title: '完成对应学习后即可领取', icon: 'none' })
            return
        }
        if (route.tab) {
            uni.switchTab({ url: route.url })
            return
        }
        uni.navigateTo({ url: route.url })
    }

    function onTaskBtn(task : PointsTaskItem) : void {
        if (task.status == 'claimed') return
        if (task.status == 'claimable') {
            onClaim(task)
            return
        }
        onGo(task)
    }

    function onBack() : void {
        goBack()
    }

    function goExchange() : void {
        uni.showToast({ title: '功能开发中', icon: 'none' })
    }

    onShow(() => {
        loadBalance()
        loadTasks()
    })
</script>

<style>
    .container {
        flex: 1;
        background-color: #f5f5f5;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        background-color: #ffffff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1rpx solid #f0f0f0;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        width: 60rpx;
    }

    .content-scroll {
        flex: 1;
    }

    /* 积分卡片 */
    .balance-card {
        margin: 24rpx;
        padding: 32rpx;
        border-radius: 16rpx;
        background-color: #ffffff;
        flex-direction: column;
    }

    .balance-top {
        flex-direction: row;
        align-items: center;
    }

    .balance-coin {
        width: 80rpx;
        height: 80rpx;
        border-radius: 40rpx;
        background: linear-gradient(135deg, #FFD700, #FFA000);
        align-items: center;
        justify-content: center;
        margin-right: 24rpx;
    }

    .coin-icon {
        font-size: 48rpx;
    }

    .balance-info {
        flex: 1;
        flex-direction: column;
    }

    .balance-label {
        font-size: 24rpx;
        color: #999999;
    }

    .balance-value {
        font-size: 56rpx;
        font-weight: bold;
        color: #333333;
        margin-top: 4rpx;
    }

    .balance-exchange {
        padding: 16rpx 32rpx;
        border-radius: 32rpx;
        background-color: #f5f5f5;
    }

    .exchange-text {
        font-size: 26rpx;
        color: #666666;
    }

    .balance-bottom {
        margin-top: 20rpx;
        padding-top: 20rpx;
        border-top: 1rpx solid #f0f0f0;
        align-items: center;
    }

    .balance-stats {
        font-size: 24rpx;
        color: #999999;
    }

    /* 分组 */
    .section {
        margin-bottom: 16rpx;
    }

    .section-header {
        padding: 16rpx 32rpx 12rpx;
        flex-direction: column;
    }

    .section-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .section-underline {
        width: 64rpx;
        height: 8rpx;
        border-radius: 4rpx;
        background-color: #2979ff;
        margin-top: 8rpx;
    }

    .section-desc {
        font-size: 22rpx;
        color: #999999;
        margin-top: 8rpx;
    }

    /* 任务卡片 */
    .task-card {
        margin: 0 24rpx;
        padding: 0 24rpx;
        border-radius: 16rpx;
        background-color: #ffffff;
        flex-direction: column;
    }

    .task-item {
        padding: 24rpx 0;
        border-bottom: 1rpx solid #f0f0f0;
        flex-direction: row;
        align-items: center;
    }

    .task-item-last {
        border-bottom-width: 0;
    }

    .task-icon-wrap {
        width: 72rpx;
        height: 72rpx;
        border-radius: 16rpx;
        align-items: center;
        justify-content: center;
        margin-right: 20rpx;
    }

    .icon-daily {
        background-color: #FFF3E0;
    }

    .icon-newbie {
        background-color: #E8F5E9;
    }

    .icon-growth {
        background-color: #E3F2FD;
    }

    .icon-other {
        background-color: #F5F5F5;
    }

    .task-icon {
        font-size: 36rpx;
    }

    .task-content {
        flex: 1;
        flex-direction: column;
        margin-right: 16rpx;
    }

    .task-title-row {
        flex-direction: row;
        align-items: center;
    }

    .task-title {
        font-size: 30rpx;
        font-weight: 500;
        color: #333333;
    }

    .task-progress {
        font-size: 24rpx;
        color: #2979ff;
        margin-left: 8rpx;
    }

    .task-desc {
        font-size: 24rpx;
        color: #999999;
        margin-top: 8rpx;
        lines: 1;
        text-overflow: ellipsis;
    }

    .task-points {
        font-size: 26rpx;
        font-weight: bold;
        color: #FF8F00;
        margin-right: 16rpx;
    }

    .task-btn {
        padding: 12rpx 28rpx;
        border-radius: 28rpx;
        background-color: #2979ff;
        flex-shrink: 0;
    }

    /* 可领取是主操作：与 +N 奖励同色系，从「去完成」的灰与「已领取」的灰字里跳出来 */
    .task-btn-claim {
        background-color: #FF8F00;
    }

    .task-btn-todo {
        background-color: #f5f5f5;
    }

    .task-btn-done {
        background-color: #f5f5f5;
    }

    .task-btn-text {
        font-size: 24rpx;
        color: #ffffff;
    }

    .text-todo {
        color: #666666;
    }

    .text-done {
        color: #999999;
    }

    .text-claim {
        color: #ffffff;
    }

    /* 状态位 */
    .loading-tip {
        align-items: center;
        padding: 80rpx 0;
    }

    .loading-text {
        font-size: 26rpx;
        color: #999999;
    }

    .error-tip {
        align-items: center;
        padding: 60rpx 0;
        flex-direction: column;
    }

    .error-text {
        font-size: 28rpx;
        color: #666666;
        margin-bottom: 20rpx;
    }

    .retry-btn {
        padding: 12rpx 40rpx;
        border-radius: 32rpx;
        background-color: #2979ff;
    }

    .retry-text {
        font-size: 26rpx;
        color: #ffffff;
    }

    .bottom-spacer {
        height: 48rpx;
    }
</style>
