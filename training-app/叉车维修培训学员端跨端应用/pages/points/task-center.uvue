<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">任务中心</text>
            <view class="header-right"></view>
        </view>

        <view class="page-body">
            <view class="banner"></view>
            <scroll-view class="content-scroll" scroll-y="true">
                <!-- 每日任务卡片 -->
                <view class="task-card">
                    <view class="section-title-row">
                        <text class="section-title">每日任务</text>
                        <view class="section-title-underline"></view>
                    </view>
                    <view v-for="(task, idx) in dailyTasks" :key="idx"
                        :class="['task-item', { 'task-item-last': idx == dailyTasks.length - 1 }]">
                        <view class="task-main">
                            <text class="task-icon">{{ task.icon }}</text>
                            <view class="task-left">
                                <view class="task-title-row">
                                    <text class="task-title">{{ task.title }}</text>
                                    <text v-if="task.total > 0" class="task-progress">（{{ task.done }}/{{ task.total }}）</text>
                                </view>
                                <text class="task-desc">{{ task.desc }}</text>
                            </view>
                            <view :class="['task-button', { 'task-button-gray': task.status == 'done' }]"
                                @click="onTaskAction(task)">
                                <text :class="['task-button-text', { 'task-button-text-gray': task.status == 'done' }]">{{ task.buttonText }}</text>
                            </view>
                        </view>
                    </view>
                </view>

                <!-- 福利任务卡片 -->
                <view class="task-card">
                    <view class="section-title-row">
                        <text class="section-title">福利任务</text>
                        <view class="section-title-underline"></view>
                    </view>
                    <view v-for="(task, idx) in welfareTasks" :key="idx"
                        :class="['task-item', { 'task-item-last': idx == welfareTasks.length - 1 }]">
                        <view class="task-main">
                            <text class="task-icon">{{ task.icon }}</text>
                            <view class="task-left">
                                <view class="task-title-row">
                                    <text class="task-title">{{ task.title }}</text>
                                    <text v-if="task.total > 0" class="task-progress">（{{ task.done }}/{{ task.total }}）</text>
                                </view>
                                <text class="task-desc">{{ task.desc }}</text>
                            </view>
                            <view :class="['task-button', { 'task-button-gray': task.status == 'done' }]"
                                @click="onTaskAction(task)">
                                <text :class="['task-button-text', { 'task-button-text-gray': task.status == 'done' }]">{{ task.buttonText }}</text>
                            </view>
                        </view>
                    </view>
                </view>

                <view class="bottom-space"></view>
            </scroll-view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'

    type TaskItem = {
        icon : string
        title : string
        desc : string
        done : number
        total : number
        buttonText : string
        status : string
        action : string
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const dailyTasks = ref<TaskItem[]>([
        { icon: '👆', title: '每日登录', desc: '登录小程序获得', done: 1, total: 1, buttonText: '已完成', status: 'done', action: '' },
        { icon: '📝', title: '每日答题', desc: '完成容易题库练习', done: 0, total: 1, buttonText: '已完成', status: 'done', action: 'practice' },
        { icon: '📤', title: '发布帖子', desc: '完成一次打卡签到', done: 1, total: 1, buttonText: '已完成', status: 'done', action: 'create' },
        { icon: '🖥️', title: '游览帖子', desc: '去广场游览3篇帖子，立得任务奖励', done: 1, total: 3, buttonText: '去完成', status: 'todo', action: 'forum' },
        { icon: '↪️', title: '发表评论', desc: '在广场发布不少于10字的评论', done: 0, total: 3, buttonText: '去完成', status: 'todo', action: 'forum' },
        { icon: '↪️', title: '转发帖子', desc: '转发帖子、文章、招聘等内容，转发字数不少于10字', done: 0, total: 2, buttonText: '去完成', status: 'todo', action: 'forum' },
        { icon: '↪️', title: '完成1次模拟考试', desc: '转发帖子、文章、招聘等内容，转发字数不少于10字', done: 0, total: 1, buttonText: '去完成', status: 'todo', action: 'exam' },
    ])

    const welfareTasks = ref<TaskItem[]>([
        { icon: '↪️', title: '完善个人信息', desc: '上传头像并完善昵称', done: 0, total: 0, buttonText: '已领取', status: 'claim', action: '' },
        { icon: '↪️', title: '选定考试目标证件', desc: '转发帖子、文章、招聘等内容，转发字数不少于10字', done: 0, total: 0, buttonText: '去完成', status: 'todo', action: 'exam-info' },
        { icon: '↪️', title: '完成首节课程', desc: '观看任意课程首节并完成', done: 0, total: 0, buttonText: '去完成', status: 'todo', action: 'courses' },
        { icon: '↪️', title: '完成积分兑礼', desc: '去商城兑换好礼', done: 0, total: 0, buttonText: '去完成', status: 'todo', action: 'mall' },
    ])

    function onBack() : void {
        goBack()
    }

    function onTaskAction(task : TaskItem) : void {
        if (task.status != 'todo') {
            return
        }
        if (task.action == 'create') {
            uni.navigateTo({ url: '/pages/forum/forum-create' })
        } else if (task.action == 'practice') {
            uni.navigateTo({ url: '/pages/practice/practice' })
        } else if (task.action == 'exam') {
            uni.navigateTo({ url: '/pages/exam/mock-exam' })
        } else if (task.action == 'exam-info') {
            uni.navigateTo({ url: '/pages/exam/exam' })
        } else if (task.action == 'courses') {
            uni.navigateTo({ url: '/pages/courses/courses' })
        } else if (task.action == 'mall') {
            uni.navigateTo({ url: '/pages/mall/mall' })
        } else {
            uni.navigateTo({ url: '/pages/forum/forum' })
        }
    }
</script>

<style>
    .container {
        flex: 1;
        background-color: #f4f5f7;
        flex-direction: column;
    }

    .status-bar {
        background-color: #ffffff;
    }

    .header {
        background-color: #ffffff;
        padding: 16rpx 32rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        width: 60rpx;
        align-items: center;
    }

    .back-icon {
        font-size: 48rpx;
        color: #333333;
    }

    .header-title {
        font-size: 36rpx;
        font-weight: bold;
        color: #333333;
    }

    .header-right {
        width: 60rpx;
    }

    .page-body {
        flex: 1;
        position: relative;
    }

    .banner {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 780rpx;
        z-index: 0;
        background: linear-gradient(180deg, #41adef 0%, #a6e1fd 100%);
    }

    .content-scroll {
        flex: 1;
        position: relative;
        z-index: 1;
    }

    .task-card {
        margin: 30rpx 24rpx 0;
        padding: 8rpx 24rpx;
        border-radius: 16rpx;
        background-color: #ffffff;
        flex-direction: column;
    }

    .section-title-row {
        flex-direction: column;
        align-items: center;
        padding-top: 24rpx;
        padding-bottom: 8rpx;
    }

    .section-title {
        font-size: 32rpx;
        font-weight: bold;
        color: #333333;
    }

    .section-title-underline {
        width: 56rpx;
        height: 8rpx;
        border-radius: 4rpx;
        background-color: #22a7f0;
        margin-top: 10rpx;
    }

    .task-item {
        padding: 26rpx 0;
        border-bottom: 1rpx solid #f0f2f5;
    }

    .task-item-last {
        border-bottom-width: 0;
    }

    .task-main {
        flex-direction: row;
        align-items: center;
    }

    .task-icon {
        width: 84rpx;
        font-size: 52rpx;
        text-align: center;
        margin-right: 4rpx;
    }

    .task-left {
        flex: 1;
        flex-direction: column;
        margin-right: 16rpx;
    }

    .task-title-row {
        flex-direction: row;
        align-items: center;
    }

    .task-title {
        font-size: 30rpx;
        font-weight: bold;
        color: #333333;
    }

    .task-progress {
        font-size: 28rpx;
        color: #22a7f0;
        margin-left: 8rpx;
    }

    .task-desc {
        font-size: 24rpx;
        color: #999999;
        line-height: 36rpx;
        margin-top: 8rpx;
    }

    .task-button {
        padding: 0 30rpx;
        height: 60rpx;
        border-radius: 30rpx;
        background-color: #22a7f0;
        align-items: center;
        justify-content: center;
    }

    .task-button-gray {
        background-color: #f0f1f3;
    }

    .task-button-text {
        font-size: 26rpx;
        color: #ffffff;
    }

    .task-button-text-gray {
        color: #b4b8be;
    }

    .bottom-space {
        height: 40rpx;
    }
</style>
