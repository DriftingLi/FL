<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">任务中心</text>
            <view class="header-right"></view>
        </view>

        <scroll-view class="content-scroll" scroll-y="true">
            <!-- 积分余额卡片 -->
            <view class="balance-card">
                <view class="balance-side">
                    <text class="balance-rule">积分规则</text>
                </view>
                <text class="balance-value">{{ pointsBalance }}</text>
                <view class="balance-side"></view>
            </view>

            <!-- 过期积分提示 -->
            <view class="expire-tip">
                <text class="expire-text">本月暂无过期积分，去积分商城挑选心仪商品</text>
                <text class="expire-arrow">></text>
            </view>

            <!-- 重点任务卡片 -->
            <view class="task-card">
                <view class="task-main">
                    <view class="task-left">
                        <view class="task-title-row">
                            <text class="task-title">任务奖励</text>
                            <view class="task-title-underline"></view>
                        </view>
                        <text class="task-desc">在广场发布帖数不少于10字的帖子</text>
                    </view>
                        <view class="task-button" @click="goForumCreate">
                            <text class="task-button-text">去发表</text>
                        </view>
                </view>
            </view>

            <!-- 任务列表卡片 -->
            <view class="task-card">
                <view v-for="(task, idx) in taskList" :key="idx"
                    :class="['task-item', { 'task-item-last': idx == taskList.length - 1 }]">
                    <view class="task-main">
                        <view class="task-left">
                            <text class="task-title">{{ task.title }}</text>
                            <view class="task-desc-row">
                                <text class="task-desc">{{ task.desc }}</text>
                                <text class="task-progress">（{{ task.done }}/{{ task.total }}）</text>
                            </view>
                        </view>
                        <view class="task-button" @click="onTaskAction(task.action)">
                            <text class="task-button-text">{{ task.buttonText }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 知识问答任务卡片 -->
            <view class="task-card">
                <view class="task-item task-item-last">
                    <view class="task-main">
                        <view class="task-left">
                            <text class="task-title">{{ qaTask.title }}</text>
                            <view class="task-desc-row">
                                <text class="task-desc">{{ qaTask.desc }}</text>
                                <text class="task-progress">（{{ qaTask.done }}/{{ qaTask.total }}）</text>
                            </view>
                        </view>
                        <view class="task-button" @click="onTaskAction(qaTask.action)">
                            <text class="task-button-text">{{ qaTask.buttonText }}</text>
                        </view>
                    </view>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'

    type TaskItem = {
        title : string
        desc : string
        done : number
        total : number
        buttonText : string
        action : string
    }

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const pointsBalance = ref<number>(42)

    const taskList = ref<TaskItem[]>([
        { title: '发布帖子', desc: '在广场发布帖数不少于10字的帖子', done: 0, total: 1, buttonText: '去发表', action: 'create' },
        { title: '发布评论', desc: '在广场发布不少于10字的评论', done: 0, total: 1, buttonText: '去评论', action: 'comment' },
        { title: '转发帖子', desc: '转发帖子、文章、招聘等内容，转发字数不少于10字', done: 0, total: 2, buttonText: '去转发', action: 'forward' },
    ])

    const qaTask = ref<TaskItem>({ title: '去参与知识问答', desc: '去提问或回复信息，立得任务奖励', done: 0, total: 1, buttonText: '去参与', action: 'qa' })

    function onBack() : void {
        goBack()
    }

    function goForumCreate() : void {
        uni.navigateTo({ url: '/pages/forum/forum-create' })
    }

    function onTaskAction(action : string) : void {
        if (action == 'create') {
            uni.navigateTo({ url: '/pages/forum/forum-create' })
        } else {
            uni.navigateTo({ url: '/pages/forum/forum' })
        }
    }
</script>

