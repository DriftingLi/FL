<script setup lang="uts">
    import appNavBar from '../../components/app-nav-bar/app-nav-bar.uvue'
    import { ref } from 'vue'
    import { goBack } from '../../utils/navigation'

    /**
     * 积分规则静态页（#1943 起；#2523 按原型 787:497 / 845:719 / 845:751 收口为三 Tab）。
     *
     * 文案事实源（改动先核对这三处，再同步本页）：
     * - 任务分值：backend/migrations 000002 种子 + 000021/000034 调整（现行 10 项任务）
     * - 消耗口径：backend 兑换链路（课程 points_price / 真题 / 商城 SKU / AI 按用量）
     * - FAQ 口径：backend/migrations/000036_faq.up.sql points 类条目
     * 有效期口径：根 ADR-0082「积分暂不过期」——不写「即将过期」类文案、不写返点条款。
     *
     * 已知漂移风险：后端票 03（浏览课程任务三件套）尚未落地；若该任务合入，
     * 本页「每日任务」清单需同步补一行。
     */
    const windowHeight = uni.getSystemInfoSync().windowHeight
    /** 三 Tab 页内态：basic 基础规则 / consume 消费积分详解 / tasks 任务中心 */
    const activeTab = ref<string>('basic')

    function onTab(tab : string) : void {
        if (activeTab.value == tab) return
        activeTab.value = tab
    }

    function onBack() : void {
        goBack()
    }
</script>

