<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">上传资源</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true">
            <view class="form-section">
                <view class="form-item">
                    <text class="form-label">资源标题</text>
                    <input class="form-input" placeholder="请输入资源标题" v-model="title" maxlength="120" />
                </view>
                <view class="form-item">
                    <text class="form-label">资源简介</text>
                    <textarea class="form-textarea" placeholder="介绍这份资料的内容与用途" v-model="intro" maxlength="2000" />
                </view>
                <view class="form-item">
                    <text class="form-label">投稿证件</text>
                    <text class="credential-name">{{ credentialName.length > 0 ? credentialName : '未选定证件' }}</text>
                </view>
                <view class="form-item">
                    <text class="form-label">选择文件</text>
                    <view v-for="(item, idx) in files" :key="idx" class="file-item">
                        <view class="file-item-info">
                            <text class="file-item-name">{{ item.name }}</text>
                            <text class="file-item-size">{{ fmtSize(item.size) }}</text>
                        </view>
                        <text class="file-item-remove" @click="onRemoveFile(idx)">移除</text>
                    </view>
                    <view v-if="files.length < maxFiles" class="upload-area" @click="onChooseFile">
                        <text class="upload-area-text">{{ files.length > 0 ? '继续添加文件（最多 5 个）' : '点击选择文件' }}</text>
                    </view>
                    <text v-if="files.length > 0" class="upload-total">共 {{ files.length }} 个文件，合计 {{ fmtSize(totalSize) }}</text>
                </view>
                <view class="submit-btn" :class="{ 'submit-btn-disabled': uploading }" @click="onSubmit">
                    <text class="submit-btn-text">{{ uploading ? '提交中...' : '提交上传' }}</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref, computed } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getCurrentCredentialApi } from '../../api/credential'
    import { uploadContributionFileApi, createContributionApi } from '../../api/contribution'
    import type { ContributionFileItem } from '../../api/contribution'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    // 投稿硬约束（单一事实源=后端 contribution_service.go，前端只做前置拦截）
    const maxFiles = 5
    const maxFileSize = 20 * 1024 * 1024
    const maxTotalSize = 50 * 1024 * 1024
    const allowedExt = ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx', 'zip', 'mp4']

    type ChosenFile = { path : string; name : string; size : number }

    const title = ref<string>('')
    const intro = ref<string>('')
    const files = ref<ChosenFile[]>([])
    const uploading = ref<boolean>(false)
    const credentialId = ref<number>(0)
    const credentialName = ref<string>('')

    const totalSize = computed<number>(() : number => {
        let sum = 0
        for (let i = 0; i < files.value.length; i++) {
            sum += files.value[i].size
        }
        return sum
    })

    /** 文件大小展示 */
    function fmtSize(size : number) : string {
        if (size >= 1024 * 1024) {
            return (size / (1024.0 * 1024.0)).toFixed(1) + 'MB'
        }
        if (size >= 1024) {
            return Math.round(size / 1024.0).toString() + 'KB'
        }
        return size.toString() + 'B'
    }

    /** 取扩展名（小写，无点返回空串） */
    function extOf(name : string) : string {
        const idx = name.lastIndexOf('.')
        if (idx < 0 || idx >= name.length - 1) return ''
        return name.substring(idx + 1).toLowerCase()
    }

    function isAllowedExt(ext : string) : boolean {
        for (let i = 0; i < allowedExt.length; i++) {
            if (allowedExt[i] == ext) return true
        }
        return false
    }

    /** 加载当前证件（投稿目标；onShow 刷新以跟随证件切换） */
    async function loadCredential() : Promise<void> {
        try {
            const cred = await getCurrentCredentialApi()
            credentialId.value = cred != null ? cred.id : 0
            credentialName.value = cred != null ? cred.name : ''
        } catch (e) {
            credentialId.value = 0
            credentialName.value = ''
        }
    }

    /** 前置校验并加入文件列表（逐条提示不合规项） */
    function addFiles(candidates : ChosenFile[]) : void {
        for (let i = 0; i < candidates.length; i++) {
            const c = candidates[i]
            if (!isAllowedExt(extOf(c.name))) {
                uni.showToast({ title: '仅支持 pdf/doc/docx/ppt/pptx/xls/xlsx/zip/mp4', icon: 'none' })
                continue
            }
            if (c.size > maxFileSize) {
                uni.showToast({ title: '单个文件不能超过 20MB', icon: 'none' })
                continue
            }
            if (files.value.length >= maxFiles) {
                uni.showToast({ title: '一份投稿最多 5 个文件', icon: 'none' })
                break
            }
            if (totalSize.value + c.size > maxTotalSize) {
                uni.showToast({ title: '文件合计不能超过 50MB', icon: 'none' })
                break
            }
            let dup = false
            for (let j = 0; j < files.value.length; j++) {
                if (files.value[j].path == c.path) {
                    dup = true
                    break
                }
            }
            if (dup) continue
            files.value.push(c)
        }
    }

    function onChooseFile() : void {
        if (uploading.value) return
        // #ifdef MP-WEIXIN
        uni.chooseMessageFile({
            count: maxFiles,
            type: 'file',
            success: (res) => {
                const picked : ChosenFile[] = []
                for (let i = 0; i < res.tempFiles.length; i++) {
                    const f = res.tempFiles[i]
                    picked.push({ path: f.path, name: f.name, size: f.size } as ChosenFile)
                }
                addFiles(picked)
            }
        })
        // #endif
        // #ifndef MP-WEIXIN
        uni.chooseFile({
            count: maxFiles,
            extension: allowedExt,
            success: (res) => {
                const picked : ChosenFile[] = []
                for (let i = 0; i < res.tempFiles.length; i++) {
                    const f = res.tempFiles[i]
                    picked.push({ path: f.path, name: f.name, size: f.size } as ChosenFile)
                }
                addFiles(picked)
            }
        })
        // #endif
    }

    function onRemoveFile(idx : number) : void {
        if (uploading.value) return
        files.value.splice(idx, 1)
    }

    /** 提交：逐个上传暂存 → 创建投稿（pending） */
    async function onSubmit() : Promise<void> {
        if (uploading.value) return
        const t = title.value.trim()
        if (t.length == 0) { uni.showToast({ title: '请输入资源标题', icon: 'none' }); return }
        if (t.length > 120) { uni.showToast({ title: '标题不能超过 120 字', icon: 'none' }); return }
        const it = intro.value.trim()
        if (it.length == 0) { uni.showToast({ title: '请输入资源简介', icon: 'none' }); return }
        if (it.length > 2000) { uni.showToast({ title: '简介不能超过 2000 字', icon: 'none' }); return }
        if (credentialId.value <= 0) { uni.showToast({ title: '请先选定证件后再投稿', icon: 'none' }); return }
        if (files.value.length == 0) { uni.showToast({ title: '请至少选择 1 个文件', icon: 'none' }); return }

        uploading.value = true
        try {
            const uploaded : ContributionFileItem[] = []
            for (let i = 0; i < files.value.length; i++) {
                uni.showLoading({ title: '上传文件 ' + (i + 1).toString() + '/' + files.value.length.toString(), mask: true })
                const fi = await uploadContributionFileApi(files.value[i].path)
                uploaded.push(fi)
            }
            uni.showLoading({ title: '提交投稿...', mask: true })
            await createContributionApi(credentialId.value, t, it, uploaded, false)
            uni.hideLoading()
            uni.showToast({ title: '已提交，审核通过后上架', icon: 'success', duration: 1500 })
            setTimeout(() => { goBack() }, 1200)
        } catch (e) {
            uni.hideLoading()
            console.error('[upload-resource] submit failed:', e)
            // 校验/网络错误文案由 request 层统一 toast，此处不重复弹
        } finally {
            uploading.value = false
        }
    }

    function onBack() : void { goBack() }

    onShow(() => { loadCredential() })
</script>

<style>
    .container { flex: 1; background-color: #f5f5f5; flex-direction: column; }
    .status-bar { background-color: #2979ff; }
    .header { background-color: #2979ff; padding: 16rpx 32rpx; flex-direction: row; align-items: center; justify-content: space-between; }
    .header-left { width: 80rpx; align-items: center; }
    .back-icon { font-size: 48rpx; color: #ffffff; }
    .header-title { flex: 1; font-size: 36rpx; font-weight: bold; color: #ffffff; text-align: center; }
    .header-right { width: 80rpx; }
    .content-scroll { flex: 1; }
    .form-section { padding: 32rpx; }
    .form-item { background-color: #ffffff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
    .form-label { font-size: 28rpx; font-weight: 500; color: #333333; margin-bottom: 16rpx; }
    .form-input { font-size: 28rpx; color: #333333; padding: 16rpx; background-color: #f5f5f5; border-radius: 8rpx; }
    .form-textarea { font-size: 28rpx; color: #333333; padding: 16rpx; background-color: #f5f5f5; border-radius: 8rpx; height: 200rpx; }
    .credential-name { font-size: 28rpx; color: #333333; }
    .file-item { background-color: #f5f5f5; border-radius: 8rpx; padding: 16rpx; flex-direction: row; align-items: center; margin-bottom: 12rpx; }
    .file-item-info { flex: 1; flex-direction: column; }
    .file-item-name { font-size: 26rpx; color: #333333; }
    .file-item-size { font-size: 22rpx; color: #999999; margin-top: 4rpx; }
    .file-item-remove { font-size: 26rpx; color: #e5484d; padding: 8rpx 0 8rpx 24rpx; }
    .upload-area { padding: 40rpx; border: 2rpx dashed #cccccc; border-radius: 12rpx; align-items: center; justify-content: center; background-color: #fafafa; }
    .upload-area-text { font-size: 28rpx; color: #999999; }
    .upload-total { font-size: 24rpx; color: #999999; margin-top: 12rpx; }
    .submit-btn { background-color: #2979ff; border-radius: 44rpx; height: 88rpx; align-items: center; justify-content: center; margin-top: 32rpx; }
    .submit-btn-disabled { opacity: 0.6; }
    .submit-btn-text { font-size: 32rpx; font-weight: bold; color: #ffffff; }
</style>
