<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">学习资料</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true" @scrolltolower="onLoadMore">
            <view v-if="materials.length == 0 && !loading && !failed" class="empty-tip">
                <text class="empty-icon">📚</text>
                <text class="empty-text">暂无学习资料</text>
            </view>
            <view v-if="materials.length == 0 && !loading && failed" class="empty-tip">
                <text class="empty-icon">📡</text>
                <text class="empty-text">资料加载失败</text>
                <view class="empty-btn" @click="reload">
                    <text class="empty-btn-text">重试</text>
                </view>
            </view>
            <view class="material-list">
                <view v-for="(item, idx) in materials" :key="idx" class="material-item">
                    <view class="material-icon-box">
                        <text class="material-icon">{{ fileIcon(item) }}</text>
                    </view>
                    <view class="material-info">
                        <text class="material-title">{{ item.file_name }}</text>
                        <text class="material-meta">{{ item.course_name }} · {{ item.chapter_title }}</text>
                        <text class="material-size">{{ fileSizeText(item.file_size) }}</text>
                    </view>
                    <view class="material-action" :class="{ 'material-action--busy': downloadingId == item.file_id }"
                        @click="onDownload(item)">
                        <text class="material-action-text">{{ downloadingId == item.file_id ? '下载中' : '下载' }}</text>
                    </view>
                </view>
            </view>
            <view v-if="loading" class="loading-more">
                <text class="loading-text">加载中...</text>
            </view>
            <view v-if="!loading && materials.length > 0 && noMore" class="loading-more">
                <text class="loading-text">没有更多了</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getMaterialsApi, downloadAndOpenMaterialApi } from '../../api/material'
    import type { MaterialItem } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    const materials = ref<MaterialItem[]>([])
    const loading = ref<boolean>(false)
    const failed = ref<boolean>(false)
    const noMore = ref<boolean>(false)
    const page = ref<number>(1)
    const pageSize = 20
    /** 正在下载的资料 ID（0 = 无） */
    const downloadingId = ref<number>(0)

    /** 文件类型图标（按 content_type 关键字判定） */
    function fileIcon(item : MaterialItem) : string {
        const type = item.content_type
        if (type.indexOf('pdf') >= 0) return '📕'
        if (type.indexOf('word') >= 0 || type.indexOf('document') >= 0) return '📘'
        if (type.indexOf('excel') >= 0 || type.indexOf('sheet') >= 0) return '📗'
        if (type.indexOf('presentation') >= 0 || type.indexOf('powerpoint') >= 0) return '📙'
        if (type.indexOf('image') >= 0) return '🖼'
        if (type.indexOf('video') >= 0) return '🎬'
        return '📄'
    }

    /** 字节数 → 人类可读体积（B / KB / MB） */
    function fileSizeText(size : number) : string {
        if (size <= 0) return ''
        if (size < 1024) return size.toString() + ' B'
        if (size < 1024 * 1024) return (size / 1024).toFixed(1) + ' KB'
        return (size / 1024 / 1024).toFixed(1) + ' MB'
    }

    async function loadMaterials() : Promise<void> {
        if (loading.value) return
        loading.value = true
        try {
            const data = await getMaterialsApi(0, page.value, pageSize)
            if (page.value <= 1) {
                materials.value = data.materials
            } else {
                for (let i = 0; i < data.materials.length; i++) {
                    materials.value.push(data.materials[i])
                }
            }
            noMore.value = materials.value.length >= data.total || data.materials.length == 0
            failed.value = false
        } catch (e) {
            console.error('[materials] load failed:', e)
            failed.value = true
        } finally {
            loading.value = false
        }
    }

    function reload() : void {
        page.value = 1
        noMore.value = false
        loadMaterials()
    }

    function onLoadMore() : void {
        if (loading.value || noMore.value) return
        page.value += 1
        loadMaterials()
    }

    async function onDownload(item : MaterialItem) : Promise<void> {
        if (downloadingId.value > 0) return
        if (item.file_url.length == 0) {
            uni.showToast({ title: '资料地址无效', icon: 'none' })
            return
        }
        downloadingId.value = item.file_id
        uni.showLoading({ title: '下载中...' })
        const errMsg = await downloadAndOpenMaterialApi(item.file_id)
        uni.hideLoading()
        downloadingId.value = 0
        if (errMsg.length > 0) {
            uni.showToast({ title: errMsg, icon: 'none' })
        }
    }

    function onBack() : void { goBack() }

    onShow(() => { reload() })
</script>

<style>
    .container { flex: 1; background-color: #f5f5f5; flex-direction: column; }
    .status-bar { background-color: #2979ff; }
    .header { background-color: #2979ff; padding: 16rpx 32rpx; flex-direction: row; align-items: center; justify-content: space-between; }
    .header-left { width: 80rpx; align-items: center; }
    .back-icon { font-size: 48rpx; color: #ffffff; }
    .header-title { flex: 1; font-size: 36rpx; font-weight: bold; color: #ffffff; text-align: center; }
    .header-right { width: 80rpx; }
    .content-scroll { flex: 1; }
    .empty-tip { align-items: center; padding: 160rpx 0; flex-direction: column; }
    .empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
    .empty-text { font-size: 28rpx; color: #999999; margin-bottom: 32rpx; }
    .empty-btn { background-color: #2979ff; padding: 16rpx 48rpx; border-radius: 32rpx; }
    .empty-btn-text { font-size: 28rpx; color: #ffffff; }
    .material-list { padding: 24rpx; }
    .material-item { background-color: #ffffff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; flex-direction: row; align-items: center; }
    .material-icon-box { width: 80rpx; height: 80rpx; border-radius: 16rpx; background-color: #eef4ff; align-items: center; justify-content: center; margin-right: 20rpx; }
    .material-icon { font-size: 40rpx; }
    .material-info { flex: 1; flex-direction: column; }
    .material-title { font-size: 28rpx; font-weight: 500; color: #333333; }
    .material-meta { font-size: 22rpx; color: #999999; margin-top: 6rpx; }
    .material-size { font-size: 22rpx; color: #bbbbbb; margin-top: 4rpx; }
    .material-action { border-radius: 28rpx; padding: 10rpx 28rpx; margin-left: 16rpx; background-color: #2979ff; }
    .material-action--busy { background-color: #a8c4ff; }
    .material-action-text { font-size: 24rpx; color: #ffffff; }
    .loading-more { align-items: center; padding: 24rpx 0; }
    .loading-text { font-size: 24rpx; color: #999999; }
</style>
