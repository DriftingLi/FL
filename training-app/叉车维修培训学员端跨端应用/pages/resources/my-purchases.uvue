<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">我的已购</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="courses.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon"></text>
                <text class="empty-text">暂无已购课程</text>
            </view>
            <view class="course-list">
                <view v-for="(item, idx) in courses" :key="idx" class="course-item" @click="onCourseClick(item.course_id)">
                    <view class="course-item-left">
                        <text class="course-item-title">{{ item.course_name }}</text>
                        <view class="progress-bar-bg">
                            <view class="progress-bar-fill" :style="{ width: item.progress + '%' }"></view>
                        </view>
                    </view>
                    <text class="course-item-pct">{{ Math.round(item.progress) }}%</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getProfileApi } from '../../api/student'
    import type { StudentProfile, CourseProgressItem } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const courses = ref<CourseProgressItem[]>([])
    const loading = ref<boolean>(false)

    async function loadPurchases() : Promise<void> {
        loading.value = true
        try {
            const data : StudentProfile = await getProfileApi()
            courses.value = data.course_progress
        } catch (e) {
            console.error('[my-purchases] load failed:', e)
        } finally {
            loading.value = false
        }
    }

    function onCourseClick(courseId : number) : void {
        uni.navigateTo({ url: '/pages/courses/course-detail?id=' + courseId })
    }

    function onBack() : void { goBack() }

    onShow(() => { loadPurchases() })
</script>

<style>
    .container { flex: 1; background-color: #f5f5f5; flex-direction: column; }
    .status-bar { background-color: #2979ff; }
    .header { background-color: #2979ff; padding: 16rpx 32rpx; flex-direction: row; align-items: center; justify-content: space-between; }
    .header-left { width: 80rpx; align-items: center; }
    .back-icon { font-size: 48rpx; color: #ffffff; }
    .header-title { flex: 1; font-size: 36rpx; font-weight: bold; color: #ffffff; text-align: center; }
    .header-right { width: 80rpx; }
    .content-scroll { flex: 1; }
    .empty-tip { align-items: center; padding: 160rpx 0; flex-direction: column; }
    .empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
    .empty-text { font-size: 28rpx; color: #999999; }
    .course-list { padding: 24rpx; }
    .course-item { background-color: #ffffff; border-radius: 16rpx; padding: 28rpx 24rpx; margin-bottom: 16rpx; flex-direction: row; align-items: center; border: 1rpx solid #eeeeee; }
    .course-item-left { flex: 1; flex-direction: column; }
    .course-item-title { font-size: 30rpx; font-weight: 500; color: #333333; margin-bottom: 12rpx; }
    .progress-bar-bg { height: 12rpx; background-color: #f0f0f0; border-radius: 6rpx; overflow: hidden; }
    .progress-bar-fill { height: 12rpx; background-color: #2979ff; border-radius: 6rpx; }
    .course-item-pct { font-size: 26rpx; color: #2979ff; font-weight: bold; margin-left: 20rpx; }
</style>