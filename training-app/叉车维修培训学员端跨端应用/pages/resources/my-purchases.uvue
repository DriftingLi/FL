<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">我的已购</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="courses.length == 0 && !loading" class="empty-tip">
                <text class="empty-icon">📚</text>
                <text class="empty-text">暂无已购课程</text>
                <view class="empty-btn" @click="onGoMall">
                    <text class="empty-btn-text">去商城逛逛</text>
                </view>
            </view>
            <view class="course-list">
                <view v-for="(item, idx) in courses" :key="idx" class="course-item" @click="onCourseClick(item.course_id)">
                    <view class="course-item-icon-box"><text class="course-item-icon">📚</text></view>
                    <view class="course-item-info">
                        <text class="course-item-title">{{ item.course_name }}</text>
                        <view class="course-item-progress-row">
                            <view class="progress-bar-bg">
                                <view class="progress-bar-fill" :style="{ width: item.progress + '%' }"></view>
                            </view>
                            <text class="course-item-pct">{{ Math.round(item.progress) }}%</text>
                        </view>
                    </view>
                    <text class="course-item-arrow">›</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { onShow } from '@dcloudio/uni-app'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'
    import { getStudentCoursesApi } from '../../api/student'
    import type { StudentCourse } from '../../types/index'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight
    const courses = ref<StudentCourse[]>([])
    const loading = ref<boolean>(false)

    // 已购课程数据源：GET /student/courses（ADR-0017「我的课程」，#710 修正——
    // 原先拿 profile.course_progress 假充已购；后端无购买概念，真实口径即我的课程）
    async function loadPurchases() : Promise<void> {
        loading.value = true
        try {
            const data = await getStudentCoursesApi()
            courses.value = data.courses
        } catch (e) {
            console.error('[my-purchases] load failed:', e)
        } finally {
            loading.value = false
        }
    }

    function onCourseClick(courseId : number) : void {
        uni.navigateTo({ url: '/pages/courses/course-detail?id=' + courseId })
    }

    function onGoMall() : void {
        uni.reLaunch({ url: '/pages/courses/courses' })
    }

    function onBack() : void { goBack() }

    onShow(() => { loadPurchases() })
</script>

<style>
    .container { flex: 1; background-color: #f5f5f5; flex-direction: column; }
    .status-bar { background-color: #2979ff; }
    .header { background-color: #2979ff; padding: 16rpx 32rpx; flex-direction: row; align-items: center; justify-content: space-between; }
    .header-left { width: 80rpx; align-items: center; }
    .back-icon { font-size: 48rpx; color: #ffffff; }
    .header-title { flex: 1; font-size: 36rpx; font-weight: bold; color: #ffffff; text-align: center; }
    .header-right { width: 80rpx; }
    .content-scroll { flex: 1; }
    .empty-tip { align-items: center; padding: 160rpx 0; flex-direction: column; }
    .empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
    .empty-text { font-size: 28rpx; color: #999999; margin-bottom: 32rpx; }
    .empty-btn { background-color: #2979ff; padding: 16rpx 48rpx; border-radius: 32rpx; }
    .empty-btn-text { font-size: 28rpx; color: #ffffff; }
    .course-list { padding: 24rpx; }
    .course-item { background-color: #ffffff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; flex-direction: row; align-items: center; }
    .course-item-icon-box { width: 80rpx; height: 80rpx; border-radius: 40rpx; background-color: #e8f0fe; align-items: center; justify-content: center; margin-right: 20rpx; }
    .course-item-icon { font-size: 36rpx; }
    .course-item-info { flex: 1; flex-direction: column; }
    .course-item-title { font-size: 28rpx; font-weight: 500; color: #333333; }
    .course-item-progress-row { flex-direction: row; align-items: center; margin-top: 12rpx; }
    .progress-bar-bg { flex: 1; height: 12rpx; background-color: #f0f0f0; border-radius: 6rpx; overflow: hidden; }
    .progress-bar-fill { height: 12rpx; background-color: #2979ff; border-radius: 6rpx; }
    .course-item-pct { font-size: 22rpx; color: #2979ff; font-weight: bold; margin-left: 16rpx; }
    .course-item-arrow { font-size: 40rpx; color: #cccccc; margin-left: 16rpx; }
</style>
