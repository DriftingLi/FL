<template>
    <view class="container" :style="{ height: windowHeight + 'px' }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="header">
            <view class="header-left" @click="onBack">
                <text class="back-icon">‹</text>
            </view>
            <text class="header-title">我的上传</text>
            <view class="header-right"></view>
        </view>
        <scroll-view class="content-scroll" scroll-y="true">
            <view v-if="uploads.length == 0" class="empty-tip">
                <text class="empty-icon">📤</text>
                <text class="empty-text">暂无上传资源</text>
                <view class="empty-btn" @click="onUpload">
                    <text class="empty-btn-text">去上传</text>
                </view>
            </view>
            <view class="upload-list">
                <view v-for="(item, idx) in uploads" :key="idx" class="upload-item">
                    <view class="upload-item-icon-box" :style="{ backgroundColor: item.color }">
                        <text class="upload-item-icon">{{ item.icon }}</text>
                    </view>
                    <view class="upload-item-info">
                        <text class="upload-item-title">{{ item.title }}</text>
                        <text class="upload-item-meta">{{ item.time }}</text>
                    </view>
                    <text class="upload-item-status">{{ item.status }}</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { ref } from 'vue'
    import { useStatusBarHeight } from '../../utils/system'
    import { goBack } from '../../utils/navigation'

    const statusBarHeight = useStatusBarHeight()
    const windowHeight = uni.getSystemInfoSync().windowHeight

    type UploadItem = { title : string; time : string; status : string; icon : string; color : string }
    const uploads = ref<UploadItem[]>([])

    function onUpload() : void {
        uni.navigateTo({ url: '/pages/resources/upload-resource' })
    }

    function onBack() : void { goBack() }
</script>

<style>
    .container { flex: 1; background-color: #f5f5f5; flex-direction: column; }
    .status-bar { background-color: #2979ff; }
    .header { background-color: #2979ff; padding: 16rpx 32rpx; flex-direction: row; align-items: center; justify-content: space-between; }
    .header-left { width: 80rpx; align-items: center; }
    .back-icon { font-size: 48rpx; color: #ffffff; }
    .header-title { flex: 1; font-size: 36rpx; font-weight: bold; color: #ffffff; text-align: center; }
    .header-right { width: 80rpx; }
    .content-scroll { flex: 1; }
    .empty-tip { align-items: center; padding: 160rpx 0; flex-direction: column; }
    .empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
    .empty-text { font-size: 28rpx; color: #999999; margin-bottom: 32rpx; }
    .empty-btn { background-color: #2979ff; padding: 16rpx 48rpx; border-radius: 32rpx; }
    .empty-btn-text { font-size: 28rpx; color: #ffffff; }
    .upload-list { padding: 24rpx; }
    .upload-item { background-color: #ffffff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; flex-direction: row; align-items: center; border: 1rpx solid #eeeeee; }
    .upload-item-icon-box { width: 80rpx; height: 80rpx; border-radius: 16rpx; align-items: center; justify-content: center; margin-right: 20rpx; }
    .upload-item-icon { font-size: 40rpx; }
    .upload-item-info { flex: 1; flex-direction: column; }
    .upload-item-title { font-size: 28rpx; font-weight: 500; color: #333333; }
    .upload-item-meta { font-size: 22rpx; color: #999999; margin-top: 6rpx; }
    .upload-item-status { font-size: 24rpx; color: #999999; }
</style>