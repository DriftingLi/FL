/**
 * 认证状态管理（基于 Vue 3 响应式单例，无需 pinia）
 * - token / user / refresh_token 持久化到 uni.setStorageSync
 * - 启动时调用 validateToken() 校验
 * - 401 由 request 层自动清空并跳转登录页
 * - token 过期时通过 refresh_token 自动刷新（回调注册，避免循环依赖）
 **/
import { ref } from 'vue'
import { loginApi, phoneLoginApi, emailLoginApi, mpWechatLoginApi, logoutApi, getUserInfoApi, refreshTokenApi, recruiterLoginApi } from '../api/auth'
import { registerRefreshTokenHandler } from '../api/request'
import { setStorage, setStorageJSON, getStorage, getStorageJSON, removeStorage } from '../utils/storage'
import { updateSecureToken } from '../utils/secureStorage'
import { setActiveRole, clearActiveRole } from '../utils/authRole'
import { errMsg } from '../api/helpers'
import { STORAGE_KEY_TOKEN, STORAGE_KEY_REFRESH_TOKEN, STORAGE_KEY_USER, STORAGE_KEY_LOGIN_PROVIDER, STORAGE_KEY_CREDENTIALS, ACTIVE_ROLE_RECRUITER } from '../constants/app'
import type { LoginParams, CodeLoginParams, UserInfo, AuthStore, UpdateProfileParams, WechatLoginResult } from '../types/index'

const token = ref<string>('')
const user = ref<UserInfo | null>(null)
const isInitializing = ref<boolean>(true)
const isLoggedIn = ref<boolean>(false)
const displayName = ref<string>('同学')
const loginProvider = ref<string>('')

// 派生状态：token / user 变化时调用，同步 isLoggedIn 与 displayName
// 说明：uni-app x 的 .uts 纯逻辑模块不支持 computed()（需组件响应式作用域），改用 ref + 手动同步
function syncDerived() : void {
    isLoggedIn.value = token.value.length > 0 && user.value != null
    if (user.value == null) {
        displayName.value = '同学'
        return
    }
    const u = user.value as UserInfo
    if (u.name != null && u.name.length > 0) {
        displayName.value = u.name
    } else if (u.username != null && u.username.length > 0) {
        displayName.value = u.username
    } else {
        displayName.value = '同学'
    }
}

function setAuthData(t : string, u : UserInfo, refreshToken : string = '', provider : string = '') : void {
    token.value = t
    user.value = u
    setStorage(STORAGE_KEY_TOKEN, t)
    setStorageJSON(STORAGE_KEY_USER, u)
    syncDerived()
    if (refreshToken.length > 0) {
        setStorage(STORAGE_KEY_REFRESH_TOKEN, refreshToken)
    }
    if (provider.length > 0) {
        loginProvider.value = provider
        setStorage(STORAGE_KEY_LOGIN_PROVIDER, provider)
    }
}

function getRefreshToken() : string {
    return getStorage(STORAGE_KEY_REFRESH_TOKEN)
}

/**
 * 重置内存登录态（storage 清理由调用方决定）
 * 单一重置点：`clearAuthData()`（登出）与 `restoreFromStorage()`（storage 判为不可用）共用，
 * 避免两处各写一份而漂移 —— 漂移的后果就是 #1124 的二阶循环：
 * `handleUnauthorized()` 只清了 storage，内存 `isLoggedIn` 仍为 true，
 * 登录页 `onLoad` 随即把用户 reLaunch 回首页。
 */
function resetAuthState() : void {
    token.value = ''
    user.value = null
    loginProvider.value = ''
    syncDerived()
}

function clearAuthData() : void {
    resetAuthState()
    removeStorage(STORAGE_KEY_TOKEN)
    removeStorage(STORAGE_KEY_REFRESH_TOKEN)
    removeStorage(STORAGE_KEY_USER)
    removeStorage(STORAGE_KEY_LOGIN_PROVIDER)

    // 安全凭据（STORAGE_KEY_CREDENTIALS）故意不移除：
    // 生物识别门控回填，退出登录不清理，下次登录时可通过生物识别恢复。
}

/**
 * 身份互斥清槽（**专用函数，不复用 `clearAuthData()`** —— ADR-0022 ③）
 *
 * 为什么另立：`clearAuthData()` 讲的是「**同一身份**的退出」，它**故意保留**
 * `auth_secure_credentials`（ADR-0004 生物识别快捷登录）与 `auth_refresh_token`（登出后仍可快捷续登）。
 * 身份切换是另一件事：ADR-0021 ② 否掉的是**并存**身份，「复用单槽」意味着该槽不能同时留着
 * 另一方的凭据 —— 学员的 refresh_token 与安全凭据在招聘者态下**必须一并清掉**，
 * 否则登出后遗留的学员 refresh_token 会被 `/auth/refresh` 拿去**悄悄复活一个学员会话**
 * （`tryRefreshToken` 只在内存 user 为空时拒绝，而招聘者态的内存 user 非空）。
 *
 * ⚠️ **不要**把这段逻辑并进 `clearAuthData()`：那会改动三条既有锁的语义
 * （`utils/concurrent401RefreshContract.test.js` 的 C3、`loginGating`、`personalInfoContract`），
 * 而 ADR-0022 ⑤ 要求学员路径行为逐条不变。
 */
function clearIdentityForSwitch() : void {
    // 内存登录态归零（与 clearAuthData 共用单一重置点，防两处漂移）
    resetAuthState()
    // 学员三键（token / refresh_token / user）
    removeStorage(STORAGE_KEY_TOKEN)
    removeStorage(STORAGE_KEY_REFRESH_TOKEN)
    removeStorage(STORAGE_KEY_USER)
    // 上一重身份的登录来源与生物识别安全凭据：身份切换必须清
    removeStorage(STORAGE_KEY_LOGIN_PROVIDER)
    removeStorage(STORAGE_KEY_CREDENTIALS)
    // 角色标记先清空，由调用方在落新凭据后显式重设（避免中途出现「新 token + 旧角色」）
    clearActiveRole()
}

/**
 * 招聘者登录（ADR-0022 ④ 步骤 P1）
 *
 * 顺序即语义：**先互斥清槽 → 再落凭据 → 最后设角色标记**。
 * 若先落 token 再清槽，清槽会把刚拿到的招聘者 token 一起清掉。
 */
async function loginAsRecruiter(params : LoginParams) : Promise<void> {
    try {
        const result = await recruiterLoginApi(params)
        if (result == null) {
            throw new Error('登录响应为空')
        }
        clearIdentityForSwitch()
        setAuthData(result.token, result.user, result.refresh_token, 'recruiter')
        setActiveRole(ACTIVE_ROLE_RECRUITER)
    } catch (e) {
        console.error('[auth] loginAsRecruiter exception:', e)
        const msg = errMsg(e, '登录失败（响应解析错误）')
        throw new Error(msg)
    }
}

function restoreFromStorage() : boolean {
    const t = getStorage(STORAGE_KEY_TOKEN)
    if (t.length == 0) {
        // storage 已无 access token ⇒ 内存登录态**同步归零**（#1124 根因 2）：
        // 否则调用方会拿到陈旧的 isLoggedIn=true（登录页据此弹回首页）。
        // 只重置内存、**不动 storage**：refresh_token 按 ADR-0004 保留给生物识别快捷登录。
        resetAuthState()
        return false
    }
    const uObj = getStorageJSON(STORAGE_KEY_USER)
    if (uObj == null) {
        // token 在但 user 读不出来：同样不可判为已登录，内存态一并归零
        resetAuthState()
        return false
    }
    const user_id = uObj['user_id'] as number
    const username = uObj['username'] as string
    const name = uObj['name'] as string
    const role = uObj['role'] as string
    const u : UserInfo = {
        user_id: user_id,
        username: username,
        name: name,
        role: role,
        avatar_url: '',
    } as UserInfo
    const avatar_url = uObj['avatar_url']
    if (avatar_url != null) {
        u.avatar_url = avatar_url as string
    }
    // 扩展可选字段（buildUserInfo 落地时一并写入缓存）
    const account = uObj['account']
    if (account != null) {
        u.account = account as string
    }
    const phone = uObj['phone']
    if (phone != null) {
        u.phone = phone as string
    }
    const email = uObj['email']
    if (email != null) {
        u.email = email as string
    }
    const company = uObj['company']
    if (company != null) {
        u.company = company as string
    }
    const has_password = uObj['has_password']
    if (has_password != null) {
        u.has_password = has_password as boolean
    }
    const has_pending_change = uObj['has_pending_change']
    if (has_pending_change != null) {
        u.has_pending_change = has_pending_change as boolean
    }
    token.value = t
    user.value = u
    loginProvider.value = getStorage(STORAGE_KEY_LOGIN_PROVIDER)
    syncDerived()
    return true
}

async function validateToken() : Promise<void> {
    isInitializing.value = true
    const restored = restoreFromStorage()
    if (!restored) {
        clearAuthData()
        isInitializing.value = false
        return
    }
    try {
        const u = await getUserInfoApi()
        if (u != null && u.user_id > 0) {
            user.value = u
            setStorageJSON(STORAGE_KEY_USER, u)
            syncDerived()
        } else {
            clearAuthData()
        }
    } catch (e) {
        const stillHasToken = getStorage(STORAGE_KEY_TOKEN).length > 0
        if (stillHasToken) {
            console.warn('[auth] validateToken network error, keeping existing auth:', e)
        } else {
            clearAuthData()
        }
    } finally {
        isInitializing.value = false
    }
}

async function login(params : LoginParams) : Promise<void> {
    try {
        const result = await loginApi(params)
        if (result == null) {
            throw new Error('登录响应为空')
        }
        setAuthData(result.token, result.user, result.refresh_token, 'password')
    } catch (e) {
        console.error('[auth] login exception:', e)
        const msg = errMsg(e, '登录失败（响应解析错误）')
        throw new Error(msg)
    }
}

async function loginByCode(params : CodeLoginParams) : Promise<void> {
    try {
        const result = params.channel == 'email'
            ? await emailLoginApi(params.target, params.code)
            : await phoneLoginApi(params.target, params.code)
        if (result == null) {
            throw new Error('登录响应为空')
        }
        setAuthData(result.token, result.user, result.refresh_token, params.channel)
    } catch (e) {
        console.error('[auth] loginByCode exception:', e)
        const msg = errMsg(e, '登录失败（响应解析错误）')
        throw new Error(msg)
    }
}

async function loginByWechat() : Promise<WechatLoginResult> {
    const loginRes = await new Promise<UTSJSONObject>((resolve, reject) => {
        uni.login({
            provider: 'weixin',
            success: (res) => resolve(res as UTSJSONObject),
            fail: (err) => reject(err),
        })
    })
    const code = loginRes['code'] as string
    if (code == null || code.length == 0) {
        throw new Error('微信授权失败：未获取到 code')
    }
    console.log('[auth] wechat login code obtained, len=', code.length)
    try {
        const result = await mpWechatLoginApi(code)
        if (result == null) {
            throw new Error('登录响应为空')
        }
        setAuthData(result.token, result.user, result.refresh_token, 'wechat')
        return result
    } catch (e) {
        console.error('[auth] loginByWechat exception:', e)
        const msg = errMsg(e, '微信登录失败（响应解析错误）')
        throw new Error(msg)
    }
}

async function logout() : Promise<void> {
    const savedToken = token.value
    if (savedToken.length > 0) {
        try {
            await logoutApi()
        } catch (e) {
            console.warn('[auth] logout backend failed (ignored):', e)
        }
    }
    clearAuthData()
    uni.reLaunch({ url: '/pages/login/login' })
}

function updateUser(patch : UpdateProfileParams) : void {
    const current = user.value
    if (current == null) {
        console.warn('[auth] updateUser skipped: no current user')
        return
    }
    const updated : UserInfo = {
        user_id: current.user_id,
        username: current.username,
        name: current.name,
        role: current.role,
        avatar_url: '',
    } as UserInfo
    const currentavatar_url = current.avatar_url
    if (currentavatar_url != null && currentavatar_url.length > 0) {
        updated.avatar_url = currentavatar_url
    }
    // 保留扩展可选字段（account/phone/email/company/has_password/pending），避免重建缓存时丢失
    const curAccount = current.account
    if (curAccount != null) {
        updated.account = curAccount
    }
    const curPhone = current.phone
    if (curPhone != null) {
        updated.phone = curPhone
    }
    const curEmail = current.email
    if (curEmail != null) {
        updated.email = curEmail
    }
    const curCompany = current.company
    if (curCompany != null) {
        updated.company = curCompany
    }
    const curHasPwd = current.has_password
    if (curHasPwd != null) {
        updated.has_password = curHasPwd
    }
    const curPending = current.has_pending_change
    if (curPending != null) {
        updated.has_pending_change = curPending
    }
    const nickname = patch.nickname
    if (nickname != null && nickname.length > 0) {
        updated.name = nickname
    }
    user.value = updated
    setStorageJSON(STORAGE_KEY_USER, updated)
    syncDerived()
}

async function tryRefreshToken() : Promise<boolean> {
    // 内存 user 为空 ⇒ 本地已不是登录态（登出 / 401 清态后 `restoreFromStorage()` 已归零），
    // 此处**不刷新**。refresh 只续「已有会话」的 access token；否则会拿留下的 refresh_token 把
    // 会话**悄悄复活**，而 `setAuthData` 需要非空 user —— Kotlin 侧 `user.value!` 是 `!!`，
    // 空值直接 NPE ⇒ 折成「刷新失败」再弹一次「登录已过期」，正是本票要消灭的那句文案。
    if (user.value == null) return false
    const rt = getRefreshToken()
    if (rt.length == 0) return false
    try {
        const result = await refreshTokenApi(rt)
        if (result != null && result.token.length > 0) {
            setAuthData(result.token, user.value!, result.refresh_token)
            // 轮换即旧令牌失效：同步回写加密凭据包络，否则包内 rt 立即过期，
            // 下次快捷登录必 401 降级（ADR-0004 滑动续期依赖此回写）
            updateSecureToken(result.refresh_token)
            return true
        }
    } catch (e) {
        console.warn('[auth] tryRefreshToken failed:', e)
    }
    return false
}

/**
 * 快捷登录：用生物门控解锁的 refresh_token 静默续登（ADR-0004 增补）
 *
 * 与 tryRefreshToken 的区别：接受外部传入的令牌（来自加密凭据包络而非常规会话存储）。
 * 到达登录页的路径均执行过 clearAuthData（登出/401），本地 user 必为空，
 * 故 refresh 成功后经 /auth/me 拉取用户信息，不以"本地已有 user"为前提。
 *
 * @returns 轮换出的新 refresh_token（供调用方回写加密凭据包络，维持跨登出滑动续期）；
 *          失败返回空串，调用方降级回填
 */
async function quickLogin(rt : string) : Promise<string> {
    if (rt.length == 0) return ''
    try {
        const result = await refreshTokenApi(rt)
        if (result == null || result.token.length == 0) return ''
        // 先落新 access token：/auth/me 经 request 层从 STORAGE_KEY_TOKEN 取凭据
        setStorage(STORAGE_KEY_TOKEN, result.token)
        let u = user.value
        if (u == null) {
            try {
                u = await getUserInfoApi()
            } catch (e) {
                // 用户信息拉取失败：回滚 token，避免残留"有 token 无 user"的脏状态
                removeStorage(STORAGE_KEY_TOKEN)
                console.warn('[auth] quickLogin fetchUser failed:', e)
                return ''
            }
        }
        setAuthData(result.token, u, result.refresh_token)
        // 轮换令牌同步回写加密包络（与 tryRefreshToken 同一套同步点）
        updateSecureToken(result.refresh_token)
        return result.refresh_token
    } catch (e) {
        console.warn('[auth] quickLogin failed:', e)
        return ''
    }
}

let _refreshRegistered = false

export function useAuthStore() : AuthStore {
    // 惰性注册 token 刷新回调（首次调用 useAuthStore 时执行一次），避免在 .uts 模块顶层执行 async 副作用
    if (!_refreshRegistered) {
        _refreshRegistered = true
        registerRefreshTokenHandler(() : Promise<boolean> => {
            return tryRefreshToken()
        })
    }
    return {
        token,
        user,
        isInitializing,
        isLoggedIn,
        displayName,
        loginProvider,
        getRefreshToken: () : string => getRefreshToken(),
        tryRefreshToken: () : Promise<boolean> => tryRefreshToken(),
        quickLogin: (rt : string) : Promise<string> => quickLogin(rt),
        setAuthData: (t : string, u : UserInfo, rt : string) : void => setAuthData(t, u, rt),
        clearAuthData: () : void => clearAuthData(),
        restoreFromStorage: () : boolean => restoreFromStorage(),
        validateToken: () : Promise<void> => validateToken(),
        login: (params : LoginParams) : Promise<void> => login(params),
        loginByCode: (params : CodeLoginParams) : Promise<void> => loginByCode(params),
        loginByWechat: () : Promise<WechatLoginResult> => loginByWechat(),
        loginAsRecruiter: (params : LoginParams) : Promise<void> => loginAsRecruiter(params),
        logout: () : Promise<void> => logout(),
        updateUser: (patch : UpdateProfileParams) : void => updateUser(patch),
    } as AuthStore
}