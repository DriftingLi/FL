<script>
	import { useAuthStore } from './stores/auth'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	export default {
		onLaunch: function() {
			console.log('App Launch')
			// [probe1389] ADR-0030 ④-4 取证探针（throwaway，不入主线）：
			// 第一步让服务端下发一枚 cookie，第二步只看「服务端收到的」——
			// 若第二步响应体里还有 probe=jar1389，说明容器维持 jar 并在后续请求自动带 Cookie:。
			uni.request({
				url: 'https://httpbin.org/cookies/set?probe=jar1389',
				success: (res) => {
					console.log('[probe1389] step1 status=', res.statusCode, 'res.cookies=', res.cookies, 'body=', JSON.stringify(res.data))
					uni.request({
						url: 'https://httpbin.org/cookies',
						success: (res2) => {
							console.log('[probe1389] step2 status=', res2.statusCode, 'body=', JSON.stringify(res2.data))
						},
						fail: (err2) => {
							console.log('[probe1389] step2 fail=', err2.errMsg)
						}
					})
				},
				fail: (err) => {
					console.log('[probe1389] step1 fail=', err.errMsg)
				}
			})
			// 启动时异步校验 token（不阻塞渲染）
			const auth = useAuthStore()
			// 使用 async/await + try/catch 避免 UTSPromise.catch 类型推断问题
			;(async () : Promise<void> => {
				try {
					await auth.validateToken()
					console.log('Token validated, isLoggedIn=', auth.isLoggedIn.value)
				} catch (e) {
					console.error('Token validate failed:', e)
				}
			})()
		},
		onShow: function() {
			console.log('App Show')
		},
		onHide: function() {
			console.log('App Hide')
		},
		// #ifdef APP-ANDROID || APP-HARMONY
		onLastPageBackPress: function() : void {
			console.log('App LastPageBackPress')
			if (firstBackTime == 0) {
				uni.showToast({
					title: '再按一次退出应用',
					position: 'bottom',
				})
				firstBackTime = Date.now()
				setTimeout(() => {
					firstBackTime = 0
				}, 2000)
			} else if (Date.now() - firstBackTime < 2000) {
				firstBackTime = Date.now()
				uni.exit()
			}
		},
		onExit: function() {
			console.log('App Exit')
		}
		// #endif
	}
</script>

<style lang="scss">
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}

	/* 全局公共样式 */
	.page-base {
		background-color: $bg-color;
		font-size: $font-size-md;
		color: $text-color;
	}

	/* 通用卡片 */
	.card {
		background-color: $card-bg;
		border-radius: $radius-lg;
		padding: $spacing-md;
		margin: $spacing-md;
	}

	/* 通用按钮 */
	.btn-primary {
		background-color: $primary-color;
		color: $text-color-inverse;
		border-radius: $radius-pill;
		height: 88rpx;
		line-height: 88rpx;
		text-align: center;
		font-size: $font-size-lg;
		font-weight: bold;
	}

	.btn-primary-disabled {
		opacity: 0.5;
	}

	/* 通用输入框 */
	.input-base {
		height: 88rpx;
		border: 1rpx solid $input-border;
		border-radius: $radius-sm;
		padding: 0 $spacing-md;
		font-size: $font-size-md;
		background-color: $card-bg;
	}
</style>
