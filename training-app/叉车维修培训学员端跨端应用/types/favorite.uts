/**
 * 收藏模块类型
 */

/** 收藏条目 */
export type FavoriteItem = {
    favorite_id : number
    target_type : string            // course / chapter / question / featured / topic / job
    target_id : number
    /**
     * 所属课程 ID（#1089）。
     *
     * **只对 `target_type == 'chapter'` 有意义** —— 章节页落点要两个键（ADR-0014），
     * 而收藏表本身只存 `target_type` + `target_id`，故该值由后端按 target_type 补齐
     * （PR #1133 已生产落地）。**非可空**：后端契约是「键恒在、非 null，其余类型恒 0」
     * —— 用 `0` 哨兵而非 `number | null`，是为了避开 Kotlin 侧可空比较的坑
     * （`<=`/`>` 对可空接收者会编译报错，见移动端 AGENTS.md 的 UTS 类型限制表）。
     */
    course_id : number
    title : string
    /**
     * 企业名 / 地区（#1946 职位收藏）——**只对 `target_type == 'job'` 有意义**。
     *
     * 后端按 target_type 补齐这两键、其余类型省略（x-optional），故装载侧走 `toStr` 缺省空串。
     * 收藏面据此给职位条目补「企业 · 地区」第二行，口径与职位卡最小字段一致。
     * **非可空**：与 `course_id` 同式用空串哨兵，避开 Kotlin 侧可空比较的坑。
     */
    company : string
    region : string
    cover : string
    created_at : string
}

/** 收藏列表结果 */
export type FavoriteListResult = {
    items : FavoriteItem[]
    total : number
}

/** 收藏检查结果 */
export type FavoriteCheckResult = {
    favorited : boolean
    favorite_id : number
}
