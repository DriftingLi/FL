/**
 * 课程模块类型
 * 含：课程、章节、专业方向、课程等级、学习资料、标签
 */

/** 课程列表项 */
export type CourseItem = {
    course_id : number
    title : string
    description : string
    cover_url : string
    duration : number
    chapter_count : number
    /** 专业方向 ID（0 表示未设置） */
    specialty_id : number
    /** 课程等级 ID（0 表示未设置） */
    level_id : number
    /**
     * 积分价格（后端 course.points_price，*int）：null / 0 = 免费。
     * #1421（移动端 ADR-0031）逐字段迁出 —— 原 `price`（金额）与「后端暂未返回」注释都是谎言：
     * 后端从不下发金额字段，而 points_price 一直在列表 DTO 上（omitempty：免费课缺省）。
     * 价格文案渲染单点在 `utils/coursePointsCta.uts` 的 renderCoursePrice，消费页不得各写一份。
     */
    points_price ? : number | null
    /**
     * 热门标（后端 course.is_hot，bool）：列表 DTO **恒发、不 omitempty** ⇒ 非空槽位，
     * 可空性不得凭空发明。#1422 迁出：dashboard 课程区「热销」标吃这一格，
     * 不再吃本地假数据（值来自后端 course 表 is_hot 列，管理端课程维护面设置）。
     */
    is_hot : boolean
}

/** 专业方向（筛选项） */
export type SpecialtyItem = {
    specialty_id : number
    name : string
}

/** 课程等级（筛选项） */
export type LevelItem = {
    level_id : number
    name : string
}

/** 课程列表响应 */
export type CourseListResult = {
    items : CourseItem[]
    total : number
    page : number
    page_size : number
}

/** 章节项 */
export type ChapterItem = {
    chapter_id : number
    title : string
    order_num : number
    duration : number
}

/** 章节附件文件 */
export type ChapterFile = {
    file_id : number
    file_name : string
    file_url : string
    content_type : string  // video / document / ppt / image
}

/** 章节详情 */
export type ChapterDetail = {
    chapter_id : number
    title : string
    content : string               // 图文内容（markdown/html）
    files : ChapterFile[]          // 附件列表
    previous_chapter_id : number   // 上一章节 ID（0 表示无）
    next_chapter_id : number       // 下一章节 ID（0 表示无）
    study_status : string          // 学习状态：completed / studying / ''
    duration : number              // 章节时长（秒）
}

/** 课程详情 */
export type CourseDetail = {
    course_id : number
    title : string
    description : string
    cover_url : string
    duration : number
    chapters : ChapterItem[]
    progress_pct : number
    /** 专业方向 ID（0 表示未设置） */
    specialty_id : number
    /** 课程等级 ID（0 表示未设置） */
    level_id : number
    /** 专业方向名称 */
    specialty_name : string
    /** 课程等级名称 */
    level_name : string
    /** 理论学时 */
    theory_hours : number
    /** 实操学时 */
    practice_hours : number
    /** 关联证书名称 */
    certificate_name : string
    /** 证书有效期（天） */
    certificate_validity_days : number
    /** 是否已报名 */
    is_enrolled : boolean
    /** 已完成章节数 */
    completed_chapters : number
    /** 前置课程列表 */
    prerequisites : CoursePrereq[]
    /**
     * 积分价格（后端 course.points_price，*int）：null / 0 = 免费。#1421 逐字段迁出，
     * 判价与判权渲染单点在 `utils/coursePointsCta.uts`。
     */
    points_price ? : number | null
    /**
     * 权益投影（移动端 ADR-0031 决策 4 的判据源；根仓库 ADR-0062 决策 3 的服务端产物）：
     * 该学员是否已持有本课程的读取资格。**可空语义必须显式** —— 后端只在**有主体**的读路径填
     * （登录态详情），未登录/读不到 = null（缺省省略而非 false）；null 与 false 在 CTA 单点里
     * 同按「未拥有」面渲染，但语义不同（没登录 ≠ 没解锁），不得压成同一个值。
     */
    entitled ? : boolean | null
}

/** 前置课程 */
export type CoursePrereq = {
    course_id : number
    name : string
}

// ========== 学习资料（GET /materials） ==========
/** 学习资料条目 */
export type MaterialItem = {
    file_id : number
    chapter_id : number
    chapter_title : string
    course_id : number
    course_name : string
    file_name : string
    file_url : string
    content_type : string
    file_size : number
    created_at : string
}

/** 学习资料列表结果 */
export type MaterialListResult = {
    materials : MaterialItem[]
    total : number
    page : number
    pages : number
}

/** 学习资料下载信息 */
export type MaterialDownloadInfo = {
    file_url : string
    file_name : string
}

// ========== 标签（GET /tags） ==========
/** 题库标签条目 */
export type TagItem = {
    id : number
    code : string
    name : string
    description : string
    sort_order : number
    status : number
    question_count : number
}
