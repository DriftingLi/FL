    job_nature : string
    experience_years : number
    self_intro : string
    resume_experiences : ResumeExperience[]
    resume_certifications : ResumeCertification[]
    resume_file_url : string
    photos : string[]
    visibility : string
}

/** 岗位字典项（GET /positions 返回） */
