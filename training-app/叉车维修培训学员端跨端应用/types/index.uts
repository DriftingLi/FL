/**
 * 全局类型定义
 */
import { Ref, ComputedRef } from 'vue'

/** 后端通用 JSON 响应格式 */
export type ApiResponse<T> = {
	code : number
	message : string
	data : T
}

/**
 * 用户角色
 * @note UTS 中联合字面量类型（如 'student' | 'tutor' | 'admin'）编译到 Kotlin 后
 *       无法用 as 从 string 强转（会抛 ClassCastException），因此 role 统一用 string 类型
 */
export type UserRole = string

/** 用户信息 */
export type UserInfo = {
	user_id : number
	username : string
	name : string
	role : string
	avatar ?: string
}

/** 登录参数 */
export type LoginParams = {
	username : string  // 用户名或手机号
	password : string
}

/** 登录响应数据 */
export type LoginResult = {
	token : string
	user : UserInfo
}

/** 注册参数 */
export type RegisterParams = {
	phone : string
	password : string
	name : string
}

/** 学习统计单日数据 */
export type StudyStatsItem = {
	date : string       // YYYY-MM-DD
	minutes : number    // 学习分钟数
}

/** 学习统计响应 */
export type StudyStats = {
	days : number
	labels : string[]
	data : number[]
	total_minutes : number
	active_days : number
}

/** 课程进度项 */
export type CourseProgressItem = {
	course_id : number
	course_name : string
	progress : number
	study_date ?: string
}

/** 学员档案 */
export type StudentProfile = {
	student_id : number
	username : string
	name : string
	phone : string
	email ?: string
	company ?: string
	total_study_duration : number
	total_courses : number
	completed_courses : number
	course_progress : CourseProgressItem[]
}

/** 学习记录条目 */
export type StudyRecord = {
	record_id : number
	course_id : number
	course_name : string
	chapter_id : number
	chapter_title : string
	study_duration : number
	study_date : string
}

/** 学习记录分页响应 */
export type StudyRecordsResult = {
	records : StudyRecord[]
	total : number
	page : number
	page_size : number
}

/** 九宫格入口配置项 */
export type GridItem = {
	key : string
	title : string
	icon : string        // emoji 或字符
	color : string       // 卡片主题色（hex）
	path : string        // 跳转路径，空字符串表示占位
	available : boolean  // 是否已开发
}

/** 认证 store 实例类型（useAuthStore 返回值） */
export type AuthStore = {
	token : Ref<string>
	user : Ref<UserInfo | null>
	isInitializing : Ref<boolean>
	isLoggedIn : ComputedRef<boolean>
	displayName : ComputedRef<string>
	setAuthData : (t : string, u : UserInfo) => void
	clearAuthData : () => void
	restoreFromStorage : () => boolean
	validateToken : () => Promise<void>
	login : (params : LoginParams) => Promise<void>
	logout : () => Promise<void>
}

/** 题目选项 */
export type QuestionOption = {
	key : string
	text : string
}

/** 考核题目 */
export type ExamQuestion = {
	question_id : number
	type : string          // 题型：single_choice / multiple_choice / true_false
	title : string
	options : QuestionOption[]
	score : number
}

/** 考核提交参数 */
export type ExamSubmitParams = {
	course_id : number
	answers : UTSJSONObject   // { 题号: 答案 }
}

/** 考核结果 */
export type ExamResult = {
	score : number
	total_score : number
	passed : boolean
	details : UTSJSONObject[]
}

/** 模拟考试开始参数 */
export type MockExamStartParams = {
	count : number
	duration : number
}

/** 模拟考试信息 */
export type MockExamInfo = {
	mock_exam_id : number
	questions : ExamQuestion[]
	duration : number          // 考试时长（分钟）
	remaining_time : number    // 剩余时间（秒）
}

/** 模拟考试保存参数 */
export type MockExamSaveParams = {
	mock_exam_id : number
	answers : UTSJSONObject
	remaining_time : number
}

/** 错题项 */
export type WrongQuestionItem = {
	question_id : number
	type : string
	title : string
	options : QuestionOption[]
	correct_answer : string
	user_answer : string
	wrong_count : number
	created_at : string
}

/** 错题列表结果 */
export type WrongQuestionListResult = {
	items : WrongQuestionItem[]
	total : number
	page : number
	page_size : number
}

/** 错题统计 */
export type WrongQuestionStats = {
	total : number
	by_type : UTSJSONObject               // { 题型: 数量 }
	by_knowledge_point : UTSJSONObject    // { 知识点: 数量 }
}

// ===== 课程模块类型 =====

/** 课程列表项 */
export type CourseItem = {
	course_id : number
	title : string
	category : string
	description : string
	cover_url : string
	duration : number
	chapter_count : number
}

/** 课程列表响应 */
export type CourseListResult = {
	items : CourseItem[]
	total : number
	page : number
	page_size : number
}

/** 章节项 */
export type ChapterItem = {
	chapter_id : number
	title : string
	order_num : number
	duration : number
}

/** 章节附件文件 */
export type ChapterFile = {
	file_id : number
	file_name : string
	file_url : string
	content_type : string  // video / document / ppt / image
}

/** 章节详情 */
export type ChapterDetail = {
	chapter_id : number
	title : string
	content : string               // 图文内容（markdown/html）
	files : ChapterFile[]          // 附件列表
	previous_chapter_id : number   // 上一章节 ID（0 表示无）
	next_chapter_id : number       // 下一章节 ID（0 表示无）
	study_status : string          // 学习状态：completed / studying / ''
	duration : number              // 章节时长（秒）
}

/** Markdown 解析后的块类型 */
export type MarkdownBlock = {
	type : string      // heading / paragraph / code / list / quote / divider / image
	level : number     // 标题层级 1-6（非标题为 0）
	text : string      // 文本内容
	items : string[]   // 列表项（仅 list 类型）
}

/** 课程详情 */
export type CourseDetail = {
	course_id : number
	title : string
	description : string
	category : string
	cover_url : string
	duration : number
	chapters : ChapterItem[]
	progress_pct : number
}

// ===== 题库练习模块类型 =====

/** 练习题目 */
export type Question = {
	question_id : number
	type : string
	title : string
	options : QuestionOption[]
	correct_answer : string
	explanation : string
	knowledge_point ?: string
}

/** 提交答案参数 */
export type SubmitAnswerParams = {
	question_id : number
	user_answer : string
	practice_type : string
}

/** 提交答案响应 */
export type SubmitAnswerResult = {
	correct : boolean
	correct_answer : string
	explanation : string
}

/** 题库课程分类 */
export type QuestionCategory = {
	code : string          // 分类编码，如 CATEGORY_01
	name : string          // 分类名称
	question_count : number // 题目数量
}

/** 知识点 */
export type KnowledgePoint = {
	id : number
	name : string
	parent_id : number
	category : string
	question_count : number
}

/** 练习统计 */
export type PracticeStats = {
	total_practiced : number   // 总练习题数
	correct_count : number     // 答对题数
	accuracy : number          // 正确率（0-100）
	today_count : number       // 今日练习数
	streak_days : number       // 连续练习天数
}

/** 练习历史记录项 */
export type PracticeHistoryItem = {
	record_id : number
	question_id : number
	question_title : string
	type : string
	user_answer : string
	correct_answer : string
	is_correct : boolean
	practice_type : string
	created_at : string
}

/** 练习历史结果 */
export type PracticeHistoryResult = {
	items : PracticeHistoryItem[]
	total : number
	page : number
	page_size : number
}

/** 练习进度 */
export type PracticeProgress = {
	index : number             // 当前题序号
	practice_mode : string     // 练习模式
	total : number             // 总题量
	answers_state : UTSJSONObject // 已答题状态
}

/** 答题状态（用于做题页面跟踪每题作答情况） */
export type AnswerState = {
	question_id : number
	user_answer : string
	is_correct : boolean
	correct_answer : string
	submitted : boolean
}

