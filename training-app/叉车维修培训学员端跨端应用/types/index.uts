/**
 * 全局类型定义
 */
import type { Ref, ComputedRef } from 'vue'

/** 后端通用 JSON 响应格式 */
export type ApiResponse<T> = {
    code : number
    message : string
    data : T
}

/**
 * 用户角色
 * @note UTS 中联合字面量类型（如 'student' | 'tutor' | 'admin'）编译到 Kotlin 后
 *       无法用 as 从 string 强转（会抛 ClassCastException），因此 role 统一用 string 类型
 */
/** 用户信息 */
export type UserInfo = {
    user_id : number
    username : string
    name : string
    role : string
    avatar_url : string
    account ?: string            // 登录账号（GET /auth/me 返回）
    phone ?: string              // 已绑手机号（后端已脱敏，如 137****1234）
    email ?: string              // 已绑邮箱
    company ?: string            // 单位（PUT /auth/profile 直接生效）
    has_password ?: boolean      // 是否已设密码（微信注册用户可能未设）
    has_pending_change ?: boolean // 是否有待审核的资料修改（昵称/头像）
}

/** 登录参数 */
export type LoginParams = {
    username : string  // 用户名或手机号
    password : string
}

/** 邮箱/手机号验证码登录参数 */
export type CodeLoginParams = {
    target : string   // 手机号或邮箱
    channel : string  // phone / email
    code : string     // 验证码
}

/** 登录响应数据 */
export type LoginResult = {
    token : string
    user : UserInfo
    refresh_token : string
}

/**
 * 刷新令牌响应数据（POST /auth/refresh）
 * @note UTS 不支持内联匿名对象类型（如 Promise<{...}>），必须用具名 type
 */
export type RefreshTokenResult = {
    token : string
    refresh_token : string
}

/**
 * 小程序微信一键登录响应（POST /auth/wx-login）
 * @note 老用户与新用户共用同一形状；新用户 isNew=true 用于前端弹"已为您自动注册"提示
 */
export type WechatLoginResult = LoginResult & {
    isNew ?: boolean
}

/** 注册参数（验证码制，POST /auth/phone/register） */
export type RegisterParams = {
    phone : string      // 手机号
    code : string       // 短信验证码（send-code 下发）
    nickname : string   // 昵称（后端字段名 nickname）
    password : string   // 密码
}

/** 邮箱注册参数（验证码制，POST /auth/email/register） */
export type EmailRegisterParams = {
    email : string      // 邮箱
    code : string       // 邮箱验证码（send-code 下发）
    nickname : string   // 昵称（后端字段名 nickname）
    password : string   // 密码
    company ?: string   // 公司（选填，后端字段名 company）
}

/** 忘记密码重置参数（验证码制，POST /auth/{email|phone}/reset-password） */
/**
 * 更新个人资料参数（昵称走审核；单位直接更新）
 * @note 后端 PUT /auth/profile：nickname 提交审核流，company 直接生效
 */
export type UpdateProfileParams = {
    nickname ?: string   // 昵称（提交审核用）
    company ?: string    // 单位（直接更新）
}

/** 资料修改审核请求（后端返回，status 为 pending 表示待审） */
export type ProfileChangeRequest = {
    id : number
    user_id : number
    username : string
    avatar_url : string
    field_type : string   // nickname / avatar
    old_value : string
    new_value : string
    status : string       // pending / approved / rejected
    reject_reason : string
    created_at : string
}

/**
 * 上传头像响应
 * @note 后端 POST /auth/avatar 的 multipart 上传字段名为 file，返回头像修改审核请求（审核通过后生效）
 */
export type UploadAvatarResult = {
    request : ProfileChangeRequest   // 头像修改审核请求（pending）
}

/** 学习统计单日数据 */
/** 学习统计响应 */
export type StudyStats = {
    days : number
    labels : string[]
    data : number[]
    total_minutes : number
    active_days : number
}

/** 课程进度项 */
export type CourseProgressItem = {
    course_id : number
    course_name : string
    progress : number
    study_date ?: string
}

/** 学员档案 */
export type StudentProfile = {
    student_id : number
    username : string
    name : string
    phone : string
    email ?: string
    company ?: string
    total_study_duration : number
    total_courses : number
    completed_courses : number
    course_progress : CourseProgressItem[]
}

/** 学习记录条目 */
export type StudyRecord = {
    record_id : number
    course_id : number
    course_name : string
    chapter_id : number
    chapter_title : string
    study_duration : number
    study_date : string
}

/** 学习记录分页响应 */
export type StudyRecordsResult = {
    records : StudyRecord[]
    total : number
    page : number
    page_size : number
}

/** 九宫格入口配置项 */
export type GridItem = {
    key : string
    title : string
    icon : string        // emoji 或字符
    color : string       // 卡片主题色（hex）
    path : string        // 跳转路径，空字符串表示占位
    available : boolean  // 是否已开发
}

/** 认证 store 实例类型（useAuthStore 返回值） */
export type AuthStore = {
    token : Ref<string>
    user : Ref<UserInfo | null>
    isInitializing : Ref<boolean>
    isLoggedIn : Ref<boolean>
    displayName : Ref<string>
    /** 登录来源：wechat / phone / email / password */
    loginProvider : Ref<string>
    getRefreshToken : () => string
    tryRefreshToken : () => Promise<boolean>
    setAuthData : (t : string, u : UserInfo, rt : string) => void
    clearAuthData : () => void
    restoreFromStorage : () => boolean
    validateToken : () => Promise<void>
    login : (params : LoginParams) => Promise<void>
    /** 邮箱/手机号验证码登录 */
    loginByCode : (params : CodeLoginParams) => Promise<void>
    /**
     * 小程序微信一键登录
     * @returns WechatLoginResult（含 isNew 提示字段）
     */
    loginByWechat : () => Promise<WechatLoginResult>
    logout : () => Promise<void>
    /** 更新本地用户信息（昵称/头像），并持久化到 storage */
    updateUser : (patch : UpdateProfileParams) => void
}

/** 题目选项 */
export type QuestionOption = {
    key : string
    text : string
}

/** 考核题目 */
export type ExamQuestion = {
    question_id : number
    type : string          // 题型：single_choice / multiple_choice / true_false
    title : string
    options : QuestionOption[]
    score : number
}

/** 考核提交参数 */
/** 考核结果 */
/** 模拟考试开始参数 */
export type MockExamStartParams = {
    count : number
    duration : number
}

/** 模拟考试信息 */
export type MockExamInfo = {
    mock_exam_id : number
    questions : ExamQuestion[]
    duration : number          // 考试时长（分钟）
    remaining_time : number    // 剩余时间（秒）
    answers ?: UTSJSONObject   // 续考时后端返回的已存答案 { 题目ID字符串: 答案 }
}

/** 模拟考试保存参数 */
export type MockExamSaveParams = {
    mock_exam_id : number
    answers : UTSJSONObject
    remaining_time : number
}

/** 模拟考试结果详情（单题） */
export type MockExamResultDetail = {
    question_id : number
    title : string
    type : string
    user_answer : string
    correct_answer : string
    is_correct : boolean
}

/** 模拟考试结果 */
export type MockExamResult = {
    mock_exam_id : number
    score : number
    total_score : number
    passed : boolean
    correct_count : number
    total_questions : number
    used_time : number          // 用时（秒）
    details : MockExamResultDetail[]
}

/** 模拟考试历史项 */
export type MockExamHistoryItem = {
    mock_exam_id : number
    score : number
    total_score : number
    passed : boolean
    correct_count : number
    total_questions : number
    duration : number            // 考试时长（分钟）
    used_time : number           // 用时（秒）
    status : string             // completed / in_progress
    created_at : string
    completed_at : string
}

/** 模拟考试历史结果 */
export type MockExamHistoryResult = {
    items : MockExamHistoryItem[]
    total : number
    page : number
    page_size : number
}

/** 错题项 */
export type WrongQuestionItem = {
    question_id : number
    type : string
    title : string
    options : QuestionOption[]
    correct_answer : string
    user_answer : string
    wrong_count : number
    created_at : string
    favorited : boolean      // 是否已收藏（后端 JOIN favorite 回填）
}

/** 错题列表结果 */
export type WrongQuestionListResult = {
    items : WrongQuestionItem[]
    total : number
    page : number
    page_size : number
}

/** 错题统计 */
export type WrongQuestionStats = {
    total : number
    by_type : UTSJSONObject               // { 题型: 数量 }
    by_knowledge_point : UTSJSONObject    // { 知识点: 数量 }
}

// ===== 论坛模块类型 =====

/** 论坛帖子 */
export type ForumTopic = {
    id : number
    title : string
    content : string
    images : string[]
    author_id : number
    author_name : string
    author_avatar : string
    replies_count : number
    views_count : number
    likes_count : number
    liked : boolean
    favorited : boolean
    created_at : string
    /** 帖子分类：general / resource / video / exam */
    scope : string
}

/** 帖子列表响应 */
export type ForumTopicListResult = {
    items : ForumTopic[]
    total : number
    page : number
    page_size : number
}

/** 帖子回复 */
export type ForumReply = {
    id : number
    topic_id : number
    topic_title : string
    content : string
    images : string[]
    author_id : number
    author_name : string
    author_avatar : string
    created_at : string
    /** 是否可删除（后端返回，贴主本人为 true） */
    can_delete : boolean
    likes_count : number
    liked : boolean
}

/** 帖子详情（含回复列表） */
export type ForumTopicDetail = {
    id : number
    title : string
    content : string
    images : string[]
    author_id : number
    author_name : string
    author_avatar : string
    replies_count : number
    views_count : number
    likes_count : number
    liked : boolean
    favorited : boolean
    created_at : string
    /** 是否可删除（后端返回，贴主本人为 true） */
    can_delete : boolean
    replies : ForumReply[]
    /** 帖子分类：general / resource / video / exam */
    scope : string
}

/**
 * 帖子点赞/取消点赞响应（POST/DELETE /forum/topics/:id/like）
 * @note UTS 不支持内联匿名对象类型，必须用具名 type
 */
export type LikeTopicResult = {
    liked : boolean
    likes_count : number
}

/** 我的回复列表响应（GET /forum/my-replies） */
export type MyRepliesResult = {
    items : ForumReply[]
    total : number
    page : number
    page_size : number
}

// ===== 课程模块类型 =====

/** 课程列表项 */
export type CourseItem = {
    course_id : number
    title : string
    category : string
    description : string
    cover_url : string
    duration : number
    chapter_count : number
    /** 专业方向 ID（0 表示未设置） */
    specialty_id : number
    /** 课程等级 ID（0 表示未设置） */
    level_id : number
}

/** 专业方向（筛选项） */
export type SpecialtyItem = {
    specialty_id : number
    name : string
}

/** 课程等级（筛选项） */
export type LevelItem = {
    level_id : number
    name : string
}

/** 课程分类（兼容旧接口，value 为专业方向 ID 字符串） */
export type CourseCategory = {
    id : number
    name : string
    value : string
}

/** 课程列表响应 */
export type CourseListResult = {
    items : CourseItem[]
    total : number
    page : number
    page_size : number
}

/** 章节项 */
export type ChapterItem = {
    chapter_id : number
    title : string
    order_num : number
    duration : number
}

/** 章节附件文件 */
export type ChapterFile = {
    file_id : number
    file_name : string
    file_url : string
    content_type : string  // video / document / ppt / image
}

/** 章节详情 */
export type ChapterDetail = {
    chapter_id : number
    title : string
    content : string               // 图文内容（markdown/html）
    files : ChapterFile[]          // 附件列表
    previous_chapter_id : number   // 上一章节 ID（0 表示无）
    next_chapter_id : number       // 下一章节 ID（0 表示无）
    study_status : string          // 学习状态：completed / studying / ''
    duration : number              // 章节时长（秒）
}

/** Markdown 解析后的块类型 */
export type MarkdownBlock = {
    type : string      // heading / paragraph / code / list / quote / divider / image
    level : number     // 标题层级 1-6（非标题为 0）
    text : string      // 文本内容
    items : string[]   // 列表项（仅 list 类型）
}

/** 课程详情 */
export type CourseDetail = {
    course_id : number
    title : string
    description : string
    category : string
    cover_url : string
    duration : number
    chapters : ChapterItem[]
    progress_pct : number
    /** 专业方向 ID（0 表示未设置） */
    specialty_id : number
    /** 课程等级 ID（0 表示未设置） */
    level_id : number
    /** 专业方向名称 */
    specialty_name : string
    /** 课程等级名称 */
    level_name : string
    /** 理论学时 */
    theory_hours : number
    /** 实操学时 */
    practice_hours : number
    /** 关联证书名称 */
    certificate_name : string
    /** 证书有效期（天） */
    certificate_validity_days : number
    /** 是否已报名 */
    is_enrolled : boolean
    /** 已完成章节数 */
    completed_chapters : number
    /** 前置课程列表 */
    prerequisites : CoursePrereq[]
}

/** 前置课程 */
export type CoursePrereq = {
    course_id : number
    name : string
}

// ===== 等级考试模块类型 =====

/** 等级考试场次（可参加考试列表项） */
export type LevelExamSession = {
    id : number
    name : string
    start_time : string      // ISO 时间
    end_time : string
    duration : number        // 考试时长（分钟）
    status : string          // upcoming / ongoing / finished
    total_score : number
    pass_score : number
    has_participated : boolean
    participant_status : string   // '' 表示未参加，否则 in_progress / submitted
    participant_id : number       // 0 表示未参加
    can_enter : boolean
}

/** 等级考试历史项 */
export type LevelExamHistoryItem = {
    id : number              // participant_id
    exam_session_id : number
    session_name : string
    status : string          // in_progress / submitted / timeout
    start_time : string
    submit_time : string
    score : number           // 未出分时为 0
    objective_score : number
    subjective_score : number
    is_passed : boolean
}

/** 等级考试历史分页响应 */
export type LevelExamHistoryResult = {
    records : LevelExamHistoryItem[]
    total : number
    page : number
    page_size : number
}

/** 进入等级考试返回的信息 */
export type LevelExamInfo = {
    participant_id : number
    session : LevelExamSession
    questions : ExamQuestion[]
    answers : UTSJSONObject   // 已保存的答案快照 { 题目ID: 答案 }
    remaining_time : number   // 剩余时间（秒）
    start_time : string
}

/** 等级考试结果明细（单题） */
export type LevelExamResultDetail = {
    id : number
    question_id : number
    title : string
    type : string
    user_answer : string
    is_correct : boolean      // null 表示未判定（简答题/未阅卷）
    score : number
    correct_answer : string
    explanation : string
}

/** 等级考试结果 */
export type LevelExamResult = {
    participant : UTSJSONObject   // participantToDict（含 score/is_passed 等）
    answers : LevelExamResultDetail[]
}

// ===== 题库练习模块类型 =====

/** 练习题目 */
export type Question = {
    question_id : number
    type : string
    title : string
    options : QuestionOption[]
    correct_answer : string
    explanation : string
    knowledge_point ?: string
}

/** 提交答案参数 */
export type SubmitAnswerParams = {
    question_id : number
    user_answer : string
    practice_type : string
}

/** 提交答案响应 */
export type SubmitAnswerResult = {
    correct : boolean
    correct_answer : string
    explanation : string
}

/** 题库课程分类 */
/** 知识点 */
/** 练习统计 */
export type PracticeStats = {
    total_practiced : number   // 总练习题数
    correct_count : number     // 答对题数
    accuracy : number          // 正确率（0-100）
    today_count : number       // 今日练习数
    streak_days : number       // 连续练习天数
}

/** 练习历史记录项 */
export type PracticeHistoryItem = {
    record_id : number
    question_id : number
    question_title : string
    type : string
    user_answer : string
    correct_answer : string
    is_correct : boolean
    practice_type : string
    created_at : string
}

/** 练习历史结果 */
export type PracticeHistoryResult = {
    items : PracticeHistoryItem[]
    total : number
    page : number
    page_size : number
}

/** 练习进度 */
export type PracticeProgress = {
    index : number             // 当前题序号（后端 current_index）
    completed : number         // 已完成题数（后端 completed）
    practice_mode : string     // 练习模式（sequential / tag:<id> / paper:<id>）
    total : number             // 总题量
    answers_state : UTSJSONObject // 已答题状态
}

/** 刷题数据统计（GET /practice-mode/practice-stats，按证件分区聚合） */
export type PracticeOverview = {
    today_count : number   // 今日做题
    total_count : number   // 累计做题
    total_days : number    // 累计做题天数
}

/** 答题状态（用于做题页面跟踪每题作答情况） */
export type AnswerState = {
    question_id : number
    user_answer : string
    is_correct : boolean
    correct_answer : string
    submitted : boolean
}

// ===== AI 助手模块类型 =====

/** AI 对话消息 */
export type AiChatMessage = {
    role : string       // user | assistant | system
    content : string
}

/** 平台可用模型 */
export type AiModel = {
    id : number
    name : string
    model : string
    source : string     // admin / system 等
    description : string
}

/** 用户自定义模型 */
export type AiUserModel = {
    id : number
    name : string
    base_url : string
    model : string
    api_key : string
    created_at : string
}

/** AI 会话 */
export type AiSession = {
    id : number
    title : string
    model_source : string
    model_id : number
    created_at : string
    updated_at : string
}

/** AI 会话消息（含 id） */
export type AiSessionMessage = {
    id : number
    role : string
    content : string
    created_at : string
}

/** 对话设置（本地缓存） */
export type AiChatSettings = {
    model_source : string   // admin | user | custom
    model_id : number       // 用户模型 id，0 表示未选
    model_name : string     // 展示名
    base_url : string
    model : string
    api_key : string
}

/** AI 模型下拉选项（平台 + 用户自定义统一展示） */
export type AIModelOption = {
    id : number
    name : string
    model : string
    source ?: string        // admin | user | custom
    description ?: string
    base_url ?: string
    api_key ?: string
}

/** AI 功能快捷入口 */
export type AIFunctionItem = {
    key : string
    title : string
    icon : string
    prompt : string
}

// ===== 通知模块类型 =====

/** 通知项 */
export type NotificationItem = {
    id : number
    type : string       // system | profile_review | forum_reply | forum_report | forum_topic_deleted | forum_reply_deleted
    title : string
    content : string
    link : string       // 跳转路径，如 /training/forum/:topic_id；帖子已删除时为空
    payload : UTSJSONObject
    is_read : boolean
    read_at : string
    created_at : string
}

/** 通知列表响应 */
export type NotificationListResult = {
    items : NotificationItem[]
    total : number
    page : number
    page_size : number
    unread_count : number
}

// ===== 打卡模块类型 =====

/** 打卡结果（POST /forum/check-in 返回） */
export type CheckInResult = {
    checked_in : boolean       // 是否打卡成功
    consecutive_days : number  // 连续签到天数
    points_earned : number     // 本次获得积分
    total_points : number      // 累计积分
}

/** 打卡日历单日状态 */
export type CheckInCalendarDay = {
    date : string              // YYYY-MM-DD
    checked : boolean          // 是否已签到
    points : number            // 该日获得积分（0 表示未签）
}

/** 打卡日历响应（GET /forum/check-in/calendar） */
export type CheckInCalendarResult = {
    year : number
    month : number
    consecutive_days : number  // 连续签到天数
    total_points : number      // 累计积分
    points_per_day : number    // 每日签到积分
    days : CheckInCalendarDay[] // 当月每日签到状态
}

/** 打卡排行榜条目（GET /forum/check-in/rank） */
// ========== 学员课程（GET /student/courses） ==========
/** 学员课程条目 */
export type StudentCourse = {
    course_id : number
    course_name : string
    cover : string
    specialty_id : number
    level_id : number
    progress : number               // 0-100
    completed_chapters : number
    total_chapters : number
    study_duration : number         // 分钟
    last_chapter_id : number
    last_chapter_title : string
    last_position : number          // 秒
    last_studied_at : string
}

/** 学员课程列表结果 */
export type StudentCourseListResult = {
    courses : StudentCourse[]
    continue_learning : StudentCourse | null
}

/** 学员单课程章节进度 */
export type StudentCourseChapterProgress = {
    chapter_id : number
    title : string
    progress : number               // 0-100
    video_position : number         // 秒
    completed : boolean
}

/** 学员单课程学习详情（GET /student/courses/:course_id） */
export type StudentCourseDetail = StudentCourse & {
    chapters : StudentCourseChapterProgress[]
}

// ========== 内容精选（GET /featured-contents） ==========
/** 精选内容条目 */
export type FeaturedContentItem = {
    content_id : number
    title : string
    category : string
    category_label : string
    summary : string
    cover_image : string
    source : string
    status : string
    sort_order : number
    view_count : number
    published_at : string
    created_at : string
}

/** 精选内容列表结果 */
export type FeaturedContentListResult = {
    items : FeaturedContentItem[]
    total : number
    page : number
    pages : number
}

/** 精选内容详情 */
export type FeaturedContentDetail = FeaturedContentItem & {
    content : string
    related : FeaturedContentItem[]
    prev : FeaturedContentItem | null
    next : FeaturedContentItem | null
}

// ========== 收藏（GET /favorites） ==========
/** 收藏条目 */
export type FavoriteItem = {
    favorite_id : number
    target_type : string            // course / chapter / question / featured / topic
    target_id : number
    title : string
    cover : string
    created_at : string
}

/** 收藏列表结果 */
export type FavoriteListResult = {
    items : FavoriteItem[]
    total : number
    page : number
    page_size : number
}

/** 收藏检查结果 */
export type FavoriteCheckResult = {
    favorited : boolean
    favorite_id : number
}

// ========== 全局搜索（GET /search） ==========
/** 搜索结果条目 */
export type SearchItem = {
    type : string                   // course / question / content / topic
    id : number
    title : string
    cover : string
    summary : string
}

/** 搜索分类结果 */
export type SearchCategoryResult = {
    items : SearchItem[]
    total : number
}

/** 全部搜索结果 */
export type SearchResult = {
    keyword : string
    courses : SearchCategoryResult
    questions : SearchCategoryResult
    contents : SearchCategoryResult
    topics : SearchCategoryResult
}

/** 指定类型搜索分页结果 */
export type SearchPagedResult = {
    keyword : string
    type : string
    total : number
    page : number
    pages : number
    items : SearchItem[]
}

// ========== 学习资料（GET /materials） ==========
/** 学习资料条目 */
export type MaterialItem = {
    file_id : number
    chapter_id : number
    chapter_title : string
    course_id : number
    course_name : string
    file_name : string
    file_url : string
    content_type : string
    file_size : number
    created_at : string
}

/** 学习资料列表结果 */
export type MaterialListResult = {
    materials : MaterialItem[]
    total : number
    page : number
    pages : number
}

/** 学习资料下载信息 */
export type MaterialDownloadInfo = {
    file_url : string
    file_name : string
}

// ========== 标签（GET /tags） ==========
/** 题库标签条目 */
export type TagItem = {
    id : number
    code : string
    name : string
    description : string
    sort_order : number
    status : number
    question_count : number
}

// ========== 题目互动（评论 / 笔记 / 考点） ==========

/** 题目评论 */
export type QuestionComment = {
    id : number
    question_id : number
    user_id : number
    username : string
    avatar_url : string
    content : string
    created_at : string
    can_delete : boolean
}

/** 评论列表结果 */
export type CommentListResult = {
    items : QuestionComment[]
    total : number
}

/** 个人笔记 */
export type QuestionNote = {
    id : number | null
    question_id : number
    content : string
    updated_at : string
}

/** 考点标签 */
export type KnowledgeTag = {
    id : number
    code : string
    name : string
}

// ========== 证件模块（GET/PUT /me/credential） ==========

/** 证件项（后端返回的实际字段） */
export type CredentialItem = {
    id : number                // 证件数字 ID
    code : string              // 证件编码，如 forklift_n1、low_voltage_electrician
    name : string              // 证件名称，如 叉车司机N1证
    category : string          // 分类：special_operation / skill_level
    description : string       // 证件描述
    level : number | null      // 等级（仅技能等级证，如 5=五级，1=一级）
    sort_order : number        // 排序权重
    status : number            // 状态：1=启用
    created_at : string        // 创建时间
    updated_at : string        // 更新时间
}

/** 证件分组（前端展示用，按 category 分组） */
export type CredentialGroup = {
    group_name : string       // 分组标题
    icon : string             // 分组图标 emoji
    category : string         // 分类标识
    items : CredentialItem[]  // 该分组下的证件列表
}

/** 证件切换结果（PATCH /me/credential） */
export type CredentialSwitchResult = {
    success : boolean
    credential : CredentialItem | null  // 切换后的当前证件
}

// ========== 积分模块类型 ======

/** 积分余额 */
export type PointsBalance = {
    total_points : number      // 总积分
    today_earned : number      // 今日获得积分
    level : string             // 积分等级代码
    level_name : string        // 积分等级名称
    next_level_points : number // 升级到下一等级所需积分
}

/** 积分明细记录 */
export type PointsRecord = {
    record_id : number         // 记录 ID
    action : string            // 行为描述（签到、浏览课程等）
    points : number            // 获得的积分（正数为获得，负数为消耗）
    description : string       // 详细描述
    created_at : string        // 创建时间
    source_type : string       // 来源类型：check_in, course_view, exam_pass 等
    source_id : number         // 来源 ID（课程 ID、考试 ID 等）
}

/** 积分明细列表结果 */
export type PointsRecordListResult = {
    records : PointsRecord[]   // 记录列表
    total : number             // 总记录数
    page : number              // 当前页码
    page_size : number         // 每页条数
}

// ========== 简历模块（GET/PUT /resume，对齐后端 JobCardDTO / JobCardInput） ==========

