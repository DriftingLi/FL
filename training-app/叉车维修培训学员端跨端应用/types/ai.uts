/**
 * AI 助手模块类型
 */

/** AI 对话消息 */
export type AiChatMessage = {
    role : string       // user | assistant | system
    content : string
    images ?: string[]  // 用户消息附带的图片 URL（仅最后一条用户消息生效，后端 StreamChatReq.Messages[].Images）
}

/** 平台可用模型 */
export type AiModel = {
    id : number
    name : string
    model : string
    source : string     // admin / system 等
    description : string
}

/** 用户自定义模型 */
export type AiUserModel = {
    id : number
    name : string
    base_url : string
    model : string
    api_key : string
    created_at : string
}

/** AI 会话 */
export type AiSession = {
    id : number
    title : string
    model_source : string
    model_id : number
    created_at : string
    updated_at : string
}

/** AI 会话消息（含 id） */
export type AiSessionMessage = {
    id : number
    role : string
    content : string
    created_at : string
    images ?: string[]  // 用户消息附带图片 URL（仅最后一条用户消息生效）
}

/** 对话设置（本地缓存） */
export type AiChatSettings = {
    model_source : string   // admin | user | custom
    model_id : number       // 用户模型 id，0 表示未选
    model_name : string     // 展示名
    base_url : string
    model : string
    api_key : string
}

/** AI 模型下拉选项（平台 + 用户自定义统一展示） */
export type AIModelOption = {
    id : number
    name : string
    model : string
    source ?: string        // admin | user | custom
    description ?: string
    base_url ?: string
    api_key ?: string
}

/** AI 功能快捷入口 */
export type AIFunctionItem = {
    key : string
    title : string
    icon : string          // emoji 字符（专业版当前使用）
    prompt : string
    iconPath ?: string     // 图片路径（基础版原型使用自定义图标）
}
