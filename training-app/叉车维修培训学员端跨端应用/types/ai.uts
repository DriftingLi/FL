/**
 * AI 助手模块类型
 */

/** AI 对话消息 */
export type AiChatMessage = {
    role : string       // user | assistant | system
    content : string
    images ?: string[]  // 用户消息附带的图片 URL（仅最后一条用户消息生效，后端 StreamChatReq.Messages[].Images）
}

/** 平台可用模型 */
export type AiModel = {
    id : number
    name : string
    model : string
    source : string     // admin / system 等
    description : string
}

/** 用户自定义模型 */
export type AiUserModel = {
    id : number
    name : string
    base_url : string
    model : string
    api_key : string
    created_at : string
}

/** AI 会话 */
export type AiSession = {
    id : number
    title : string
    model_source : string
    model_id : number
    created_at : string
    updated_at : string
}

/**
 * 诊断来源资料条目（对齐后端 `DiagnosisSource` 与 web 生成类型，见根仓库 ADR-0033）。
 *
 * `metadata` 在线上是嵌套对象（`{page_start, page_end, source_url}`），这里**展平**成可选顶层字段：
 * UTS 编译到 Kotlin 后嵌套可空对象的空值检查很难过（见移动端 AGENTS.md 的 UTS 类型限制表），
 * 展平后每个字段都是「可空标量」，取值一律走 `toStr` / `toNumber` 兜底。
 * 三字段全部可选：后端 `metadata` 允许为空对象（#988 取证的 web 单测即用 `metadata: {}`）。
 */
export type AiDiagnosisSource = {
    id : string
    text : string               // 来源正文，含内嵌 `<<IMAGE:/assistant/static/manual/...>>` 标记
    page_start ?: number        // 来源手册起始页（缺省不显示页码）
    page_end ?: number
    source_url ?: string        // 来源 PDF 的内网路径（本票不渲染，留作后续外链）
}

/** AI 会话消息（含 id） */
export type AiSessionMessage = {
    id : number
    role : string
    content : string
    created_at : string
    images ?: string[]  // 用户消息附带图片 URL（仅最后一条用户消息生效）
    // 诊断来源资料（#988）：仅诊断通道的**助手**消息会有；SSE `sources` 事件与回看 DTO 两条路都落到此字段。
    sources ?: AiDiagnosisSource[]
}

/** 对话设置（本地缓存） */
export type AiChatSettings = {
    model_source : string   // admin | user | custom
    model_id : number       // 用户模型 id，0 表示未选
    model_name : string     // 展示名
    base_url : string
    model : string
    api_key : string
}

/** AI 模型下拉选项（平台 + 用户自定义统一展示） */
export type AIModelOption = {
    id : number
    name : string
    model : string
    source ?: string        // admin | user | custom
    description ?: string
    base_url ?: string
    api_key ?: string
}

/**
 * AI 功能快捷入口（AI 助手宫格项）。
 *
 * **每一项都必须带后端功能键**（`featureKey` 必填）：宫格点击 = 跳转参数化专项页
 * （`pages/ai-assistant/ai-feature`），没有键的格子就是「点了走通用对话」的伪入口 ——
 * ADR-0009 2026-09-15 修订 ② 正是据此下线了「故障代码查询」。故字段设为**必填**，
 * 让「新增一格却没接线」在类型层就写不出来（旧形态是可选的 `featureKey ?: string`）。
 *
 * `key` 是本地 UI 标识（图标 / 引用），与 `featureKey` 是两回事。
 * `freePreview` 是注册表的**限免声明位**镜像（键集合 / 展示名 / 限免位与后端注册表全等，
 * 由 `utils/aiFeatureRegistryParityContract.test.js` 锁住），同样必填 —— 漏声明即测试红。
 *
 * 已删除 `prompt`：点击不再「就发那句预设话」，专项页由用户自己输入 ⇒ 该字段无消费者。
 */
export type AIFunctionItem = {
    key : string
    title : string
    icon : string          // emoji 字符（无 iconPath 时的兜底）
    iconPath ?: string     // 图片路径（自定义图标）
    featureKey : string    // 后端 AI 功能注册表的功能键（根仓库 ADR-0030 / ADR-0047）
    freePreview : boolean  // 限免声明位（注册表镜像）
    /**
     * 传输适配器（注册表 `adapter` 的镜像，根仓库 ADR-0047 §7）—— `'llm' | 'diagnosis'`。
     *
     * **「专用 UI」一律读它，不允许比较功能键字符串**（如 `featureKey == 'fault_diagnosis'`）：
     * 键是「走哪条后端通道」的标识、适配器是「哪一套客户端 UI」的标识，二者不是同一个维度
     * （web 侧先例 `frontend/src/config/aiFeatures.ts` 的 `isDiagnosisFeature` 同此口径）。
     * 移动端清单是**手写**的，故该位与后端注册表等值由 `aiFeatureRegistryParityContract.test.js` 锁住。
     */
    adapter : string
}

/** 诊断品牌选项（GET /ai-assistant/diagnosis/brands）：`value` 是过滤值，`value == 'all'` 表示全部品牌。 */
export type AiDiagnosisBrandOption = {
    value : string
    label : string
}

/** 诊断故障码条目（GET /ai-assistant/diagnosis/fault-codes 的 `items[]`，字段与外部助手一致）。 */
export type AiDiagnosisFaultCodeItem = {
    id : number
    brand : string
    brand_cn : string
    model_series : string
    fault_code : string
    fault_name : string
    symptom : string
    causes : string
    sop_steps : string
    safety_warning : string
    part_numbers : string
    source_file : string
    page_num : number
}

/** 诊断故障码分页（`items` + `total`）。 */
export type AiDiagnosisFaultCodePage = {
    items : AiDiagnosisFaultCodeItem[]
    total : number
}
