/**
 * 打卡日历三态计算（纯函数，无 uni API 依赖）
 *
 * 三态对齐 Web 端规范（根仓库 ADR-0028 / spec #599）：
 * - 'streak'：当前连续打卡段（主色实心）
 * - 'past'  ：已断开的历史打卡（同色系浅底）
 * - 'none'  ：未打卡 / 未来日期（灰底）
 *
 * 定段基准（spec #599）：连续段事实源在后端打卡服务，客户端不自行回溯判定连续——
 * 段尾 = 今日（已签）或昨日（今日未签），起点 = 段尾 −(streak−1)；streak<=0 无连续段。
 * 与 Web 端 frontend/src/utils/checkinCalendar.ts 同名同签名，三态用例集两份测试互为镜像（改口径两份同改）。
 */
import type { CheckInCalendarDay } from '../types/index'

/** 不足两位补零 */
export function padZero(n : number) : string {
    if (n < 10) return '0' + n
    return '' + n
}

/** 日期规范化：截取 YYYY-MM-DD（兼容 RFC3339 带时间后缀的返回） */
export function normalizeDate(date : string) : string {
    if (date.length > 10) return date.substring(0, 10)
    return date
}

/** 解析结果：年 / 月 / 日 */
export type DateParts = {
    y : number
    m : number
    d : number
}

/** 解析 YYYY-MM-DD，非法返回 null */
export function parseDate(date : string) : DateParts | null {
    const parts = date.split('-')
    if (parts.length != 3) return null
    const y = parseInt(parts[0])
    const m = parseInt(parts[1])
    const d = parseInt(parts[2])
    if (isNaN(y) || isNaN(m) || isNaN(d)) return null
    if (m < 1 || m > 12 || d < 1 || d > 31) return null
    return { y: y, m: m, d: d } as DateParts
}

/** 前推/后推 n 天（本地时区日历运算），date 非法时原样返回 */
export function shiftDate(date : string, deltaDays : number) : string {
    const p = parseDate(date)
    if (p == null) return date
    const dt = new Date(p.y, p.m - 1, p.d + deltaDays)
    return padZero(dt.getFullYear()) + '-' + padZero(dt.getMonth() + 1) + '-' + padZero(dt.getDate())
}

/** 取某日实发积分（未打卡/不存在为 0），date 兼容带时间后缀 */
export function getDayPoints(days : CheckInCalendarDay[], date : string) : number {
    const key = normalizeDate(date)
    for (let i = 0; i < days.length; i++) {
        if (normalizeDate(days[i].date) == key) return days[i].points
    }
    return 0
}

/** 今日实发积分（概览区「今日得分」） */
export function getTodayPoints(days : CheckInCalendarDay[], today : string) : number {
    return getDayPoints(days, today)
}

/**
 * YYYY-MM-DD → y*10000+m*100+d 的可比较数值（Kotlin 端无 String 序比较，与 Web 端统一数值定序）
 * 导出位（#709）：积分流水「即将过期」窗口比较复用同一份日历数学，不再各处重抄。
 */
export function dateOrder(date : string) : number {
    const p = parseDate(date)
    if (p == null) return 0
    return p.y * 10000 + p.m * 100 + p.d
}

/**
 * 三态计算：返回与 days 等长的状态数组（'streak' | 'past' | 'none'）
 *
 * 段区间由入参 streak 派生：今日已签段尾=今日，今日未签段尾退到昨日（昨日也未签时后端 streak 应为 0），
 * 起点 = 段尾 −(streak−1)，跨月段天然正确；段成员 = 已打卡且落在段区间内。
 */
export function computeDayStates(days : CheckInCalendarDay[], today : string, streak : number) : string[] {
    const states : string[] = []
    const checkedSet = new Map<string, boolean>()
    for (let i = 0; i < days.length; i++) {
        if (days[i].checked) {
            checkedSet.set(normalizeDate(days[i].date), true)
        }
    }
    let end = normalizeDate(today)
    if (streak > 0 && !checkedSet.has(end)) {
        // 今日未签：段尾退到昨日
        end = shiftDate(end, -1)
    }
    const active = streak > 0
    const endOrder = dateOrder(end)
    const startOrder = active ? dateOrder(shiftDate(end, -(streak - 1))) : 0
    for (let i = 0; i < days.length; i++) {
        if (!days[i].checked) {
            states.push('none')
            continue
        }
        const keyOrder = dateOrder(normalizeDate(days[i].date))
        const inSegment = active && keyOrder >= startOrder && keyOrder <= endOrder
        states.push(inSegment ? 'streak' : 'past')
    }
    return states
}
