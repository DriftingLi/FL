/**
 * 职位「需持证件」的展示与筛选判定单点（#1945 / spec #1935 草稿 19）
 *
 * 本票只有三件事需要判定，全部收在这里，页面只做投影：
 *   ① 职位卡「需持 X 证」这一行文案 —— **单一档语义**（表达「需持有」，没有「优先证件」），
 *      无要求时返回空串（页面据此不渲染该行，而不是渲染一条空标签）；
 *   ② 证件筛选组的选项构造 —— 首项「全部证件」，其余按传入顺序，**去重且剔除非法 id**；
 *      条目来源是 `collectRequiredCredentials` 聚合出的「当前职位实际要求的证件」（#2422）；
 *   ③ 选中项 → 列表查询参数 —— 「全部证件」与非法值一律折成「不过滤」。
 *
 * ## 为什么「多证折叠」在这里做
 *
 * 职位卡一行放不下全部证件名（后端最多允许十来个），但也不能只显示第一个 —— 学员会以为
 * 只需第一个证。折叠口径固定为「前 N 个具名 + 等 N 证」，N 由调用方给默认值，
 * 于是「卡面显示几个名字」是**可测的行为**，不是样式巧合。
 *
 * @note 本模块**零运行期依赖**（只有 `import type`）：既能被页面消费，也能被
 *       `utils/utsHarness.js` 的 `loadUts` 直接执行（先例 `utils/recruitDisplay.uts`）。
 */
import type { JobPosting, JobRequiredCredential } from '../types/index'

/** 卡面「需持 X 证」最多具名几个证件（其余折叠成「等 N 证」）：一行放得下、又不丢信息 */
export const JOB_CREDENTIAL_MAX_NAMES : number = 2

/** 「全部证件」在筛选组里的固定 id（后端证件 id 恒为正，0 不可能与之撞车） */
export const JOB_CREDENTIAL_ALL_ID : number = 0

/**
 * 职位卡「需持 X 证」文案。
 * - 无证件要求（或全部条目无名称）⇒ `''`（页面不渲染该行）
 * - 1..maxNames 个 ⇒ `需持 A、B`
 * - 超过 maxNames 个 ⇒ `需持 A、B 等 N 证`（N = 真实证件总数，不是可见数）
 */
export function jobCredentialNotice(creds : JobRequiredCredential[], maxNames : number = JOB_CREDENTIAL_MAX_NAMES) : string {
    const names : string[] = []
    for (let i = 0; i < creds.length; i++) {
        const name = creds[i].name.trim()
        if (name.length > 0) names.push(name)
    }
    if (names.length == 0) return ''
    const limit = maxNames > 0 ? maxNames : names.length
    const visibleCount = names.length > limit ? limit : names.length
    const visible : string[] = []
    for (let i = 0; i < visibleCount; i++) visible.push(names[i])
    let out = '需持 ' + visible.join('、')
    if (names.length > limit) out = out + ' 等 ' + names.length.toString() + ' 证'
    return out
}

/**
 * 证件筛选组的数据来源（#2422）：从**当前职位列表**聚合实际要求的证件，不再拉全量字典。
 * - 按职位顺序 + 职位内顺序拍平，按 `credential_id` 去重（名称以首次出现为准）；
 * - 剔除非法 id（`<= 0`）与空名条目（空标签点不动，也没有筛选意义）；
 * - 页面把返回结果累积后再交给 `buildCredentialFilterOptions`，字典里没人要的证件不再占位。
 */
export function collectRequiredCredentials(jobs : JobPosting[]) : JobRequiredCredential[] {
    const out : JobRequiredCredential[] = []
    const seen : number[] = []
    for (let i = 0; i < jobs.length; i++) {
        const creds = jobs[i].required_credentials
        for (let j = 0; j < creds.length; j++) {
            const c = creds[j]
            if (c.credential_id <= JOB_CREDENTIAL_ALL_ID) continue
            if (seen.indexOf(c.credential_id) >= 0) continue
            if (c.name.trim().length == 0) continue
            seen.push(c.credential_id)
            out.push({ credential_id: c.credential_id, name: c.name } as JobRequiredCredential)
        }
    }
    return out
}

/**
 * 证件筛选组选项：首项「全部证件」+ 传入的证件（保持传入顺序、按 id 去重、剔除非法 id）。
 * 选项来自调用方给的证件集合（职位聚合结果），**不在这里造第二份证件清单**。
 */
export function buildCredentialFilterOptions(creds : JobRequiredCredential[]) : JobRequiredCredential[] {
    const options : JobRequiredCredential[] = [{ credential_id: JOB_CREDENTIAL_ALL_ID, name: '全部证件' } as JobRequiredCredential]
    const seen : number[] = []
    for (let i = 0; i < creds.length; i++) {
        const c = creds[i]
        if (c.credential_id <= JOB_CREDENTIAL_ALL_ID) continue
        if (seen.indexOf(c.credential_id) >= 0) continue
        seen.push(c.credential_id)
        options.push({ credential_id: c.credential_id, name: c.name } as JobRequiredCredential)
    }
    return options
}

/**
 * 选中的证件 → 列表查询参数：`> 0` 才筛选，「全部证件」与非法值折成 null（不过滤）。
 * 与后端口径同义：不传 `credential_id` = 不限证件（含「无证件要求」的职位）。
 */
export function credentialFilterParam(selectedId : number) : number | null {
    return selectedId > JOB_CREDENTIAL_ALL_ID ? selectedId : null
}
