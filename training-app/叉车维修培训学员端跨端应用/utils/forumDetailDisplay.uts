/**
 * forum 详情页纯助手（T04 手术自 forum-detail.uvue 逐字抽出，行为不变）
 * 扁平下发先例：壳层预解析 URL 与权限位，组件模板只读展示模型字段。
 */
import { resolveFileUrl } from './forumDisplay'

/** 回复卡展示模型（壳层由 ForumReply + 点赞本地态 + 权限位映射而来） */
export type ForumReplyDisplay = {
    id : number
    authorId : number
    authorName : string
    authorInitial : string
    authorAvatar : string
    avatarColor : string
    createdAtText : string
    content : string
    /** 正文格式（ADR-0025 P2）：`content_format` 归一后的取值 —— 回复卡的渲染档位由它决定 */
    contentFormat : string
    imageUrls : string[]
    canDelete : boolean
    liked : boolean
    likesCount : number
    /** 是否被楼主采纳（仅问答帖有效） */
    isAccepted : boolean
    /** 该条能否被当前用户采纳（问答帖 + 楼主本人 + 非自己回复 + 尚未采纳） */
    canAcceptReply : boolean
    /** 属地文案（ADR-0045，市优先退省）；空串 = 无属地，署名行那段整段不渲染 */
    regionText : string
}

/** 预览一组图片（帖子/回复共用；URL 解析幂等，传入已解析列表与原始列表结果一致） */
export function previewImages(all : string[], index : number) : void {
    const urls : string[] = []
    for (let i = 0; i < all.length; i++) {
        urls.push(resolveFileUrl(all[i]))
    }
    uni.previewImage({
        urls: urls,
        current: index,
    })
}
