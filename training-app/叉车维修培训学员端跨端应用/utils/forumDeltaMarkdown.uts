/**
 * Delta → Markdown 序列化管线（#2638，Parent #2631）
 *
 * WYSIWYG 编辑器（Quill 内核）与论坛档之间唯一的可测 seam。
 * 三层状态模型里它守「编辑模型 → 存储格式」这一段：编辑器给 getContents 的 delta（JSON 串），
 * 本模块出论坛档 SUBSET_FORUM 能表达的 Markdown 源串 + 保真检查差集。
 *
 * 第一性原理（为什么载体是 delta 不是 HTML）：
 * - HTML 会把普通空格写成实体、字号/颜色写成 inline style、把不支持的块静默拉平；
 *   delta 保留普通空格与语义 attributes，序列化可按论坛档显式降级并记账。
 * - 宁可「降级 + 上报」也不静默丢内容：凡论坛档表达不了的格式（下划线/对齐/缩进/字号/颜色/
 *   上下标/背景色）一律保留文本、丢样式；图片 op 丢弃并记一条 issue（R3 禁静默丢失）。
 * - 编辑器 statuschange 的 link:true 是布尔、URL 不可恢复 ⇒ 不从 delta 造链接；
 *   链接一律走字面记号 [文字](url)，由记号构造器产出、序列化原样穿过。
 *
 * 本文件为纯函数、不依赖 DOM / uni API，Node 侧经 utils/utsHarness.js 真执行。
 */

export const MARKER_QUOTE = 'quote'
export const MARKER_CODE_BLOCK = 'code-block'
export const MARKER_CODE_INLINE = 'code-inline'
export const MARKER_LINK = 'link'

export const MARKER_KINDS : string[] = [MARKER_QUOTE, MARKER_CODE_BLOCK, MARKER_CODE_INLINE, MARKER_LINK]

export function markerLabel(kind : string) : string {
    if (kind == MARKER_QUOTE) return '> 引用'
    if (kind == MARKER_CODE_BLOCK) return '代码块'
    if (kind == MARKER_CODE_INLINE) return '行内代码'
    if (kind == MARKER_LINK) return '链接'
    return kind
}

/**
 * 有选区 ⇒ 包裹选中文字；无选区 ⇒ 插入可替换模板。
 *
 * 注意（#2659 真机取证）：把返回值交给 editorContext.insertText **并不会**替换选区 ——
 * 实测 insertText 只在光标处写入（"abc" 全选 → 点引用 → "> abcabc"，计数 +5 而非 +2），
 * 编辑器也没有删除选区 / 查询选区偏移的 API。故调用方必须在写完之后用
 * reconcileMarkerInsert 把文档收敛到唯一正确形态；本函数只负责「记号长什么样」。
 */
export function buildMarker(kind : string, selected : string) : string {
    const has = selected.length > 0
    if (kind == MARKER_QUOTE) {
        if (!has) return '> 引用内容'
        const lines = selected.split('\n')
        const out : string[] = []
        for (let i = 0; i < lines.length; i++) out.push('> ' + lines[i])
        return out.join('\n')
    }
    if (kind == MARKER_CODE_BLOCK) {
        if (!has) return '```\n代码块\n```'
        return '```\n' + selected + '\n```'
    }
    if (kind == MARKER_CODE_INLINE) {
        if (!has) return '`行内代码`'
        return '`' + selected + '`'
    }
    if (kind == MARKER_LINK) {
        if (!has) return '[链接文字](https://example.com)'
        return '[' + selected + '](https://example.com)'
    }
    return ''
}

const HASHES : string[] = ['', '#', '##', '###', '####', '#####', '######']

const ISSUE_IMAGE = 'image-dropped'
const ISSUE_UNSUPPORTED = 'style-dropped'

function attr(attrs : UTSJSONObject | null, key : string) : any | null {
    if (attrs == null) return null
    return attrs[key]
}

function isTrue(v : any | null) : boolean {
    return v != null && v != false
}

function asText(v : any | null) : string {
    if (v == null) return ''
    if (typeof v == 'string') return v as string
    return v.toString()
}

function asObj(raw : any | null) : UTSJSONObject | null {
    if (raw == null) return null
    return raw as UTSJSONObject
}

function asObjectArray(raw : any | null) : Array<UTSJSONObject> {
    if (raw == null) return [] as Array<UTSJSONObject>
    return raw as Array<UTSJSONObject>
}

function applyInline(text : string, attrs : UTSJSONObject | null, issues : string[]) : string {
    if (text.length == 0) return text
    if (isTrue(attr(attrs, 'code'))) return '`' + text + '`'
    let s = text
    if (isTrue(attr(attrs, 'strike'))) s = '~~' + s + '~~'
    if (isTrue(attr(attrs, 'italic'))) s = '*' + s + '*'
    if (isTrue(attr(attrs, 'bold'))) s = '**' + s + '**'
    const unsupported : string[] = ['underline', 'background', 'color', 'size', 'script', 'align', 'indent']
    for (let i = 0; i < unsupported.length; i++) {
        if (isTrue(attr(attrs, unsupported[i]))) {
            issues.push(ISSUE_UNSUPPORTED + ':' + unsupported[i])
        }
    }
    return s
}

function blockPrefix(attrs : UTSJSONObject | null) : string {
    const header = attr(attrs, 'header')
    if (header != null) {
        const n = parseInt(asText(header))
        if (n >= 1 && n <= 6) return HASHES[n] + ' '
    }
    const list = asText(attr(attrs, 'list'))
    if (list == 'bullet') return '- '
    if (list == 'ordered') return '1. '
    if (list == 'checked' || list == 'unchecked') return '- '
    if (isTrue(attr(attrs, 'blockquote'))) return '> '
    return ''
}

function blockKind(attrs : UTSJSONObject | null) : string {
    if (attr(attrs, 'header') != null) return 'header'
    if (asText(attr(attrs, 'list')).length > 0) return 'list'
    if (isTrue(attr(attrs, 'blockquote'))) return 'quote'
    return ''
}

export type DeltaSerializeResult = {
    markdown : string,
    issues : string[],
    isEmpty : boolean,
}

export function serializeDelta(deltaJson : string) : DeltaSerializeResult {
    const issues : string[] = []
    let root : UTSJSONObject | null = null
    try {
        root = asObj(JSON.parse(deltaJson))
    } catch (_e) {
        root = null
    }
    if (root == null) {
        return { markdown: '', issues: issues, isEmpty: true }
    }
    const ops = asObjectArray(root['ops'])
    const lines : string[] = []
    let inline = ''
    let lastKind = ''
    let inFence = false
    function push(line : string, kind : string) : void {
        if (line.length == 0 && kind.length == 0) return
        const fence = line.indexOf('```') == 0
        if (fence) inFence = !inFence
        if (fence || inFence) kind = 'code'
        if (kind.length > 0 && lastKind.length > 0 && kind != lastKind) lines.push('')
        if (kind.length == 0 && lastKind.length > 0) lines.push('')
        lines.push(line)
        lastKind = kind
    }
    for (let i = 0; i < ops.length; i++) {
        const op = ops[i]
        const attrs = asObj(op['attributes'])
        const insert = op['insert']
        if (insert == null) continue
        if (typeof insert == 'string') {
            // 不换行空格（U+00A0）归一成普通空格：粘贴 / 输入法都可能带进来，
            // 论坛档只认普通空格，产物里出现它等于把 HTML 的 &nbsp; 换了个壳带进正文。
            const text = (insert as string).split('\u00a0').join(' ')
            const parts = text.split('\n')
            for (let p = 0; p < parts.length; p++) {
                if (p > 0) {
                    push(blockPrefix(attrs) + inline, blockKind(attrs))
                    inline = ''
                }
                inline += applyInline(parts[p], attrs, issues)
            }
        } else {
            const obj = asObj(insert)
            if (obj == null) continue
            if (isTrue(obj['divider'])) {
                if (inline.length > 0) { push(inline, ''); inline = '' }
                push('---', 'divider')
            }
            const image = obj['image']
            if (image != null) {
                if (inline.length > 0) { push(inline, ''); inline = '' }
                issues.push(ISSUE_IMAGE)
            }
        }
    }
    if (inline.length > 0) push(inline, '')
    while (lines.length > 0 && lines[lines.length - 1].length == 0) lines.pop()
    const markdown = lines.join('\n')
    return { markdown: markdown, issues: issues, isEmpty: markdown.trim().length == 0 }
}

export function deltaToMarkdown(deltaJson : string) : string {
    return serializeDelta(deltaJson).markdown
}

/**
 * delta 的纯文本投影（只累加字符串 insert；图片/分割线等原子 op 不计长度）。
 *
 * 记号拼合要在**字符坐标**上比对前后两份文档，故必须有这个投影；它也是落点定位的唯一口径
 * （编辑器给的选区信息只有文本、没有偏移）。
 */
export function deltaPlainText(deltaJson : string) : string {
    let root : UTSJSONObject | null = null
    try {
        root = asObj(JSON.parse(deltaJson))
    } catch (_e) {
        root = null
    }
    if (root == null) return ''
    const ops = asObjectArray(root['ops'])
    let out = ''
    for (let i = 0; i < ops.length; i++) {
        const insert = ops[i]['insert']
        if (insert != null && typeof insert == 'string') out += insert as string
    }
    return out
}

function opJson(text : string, attrs : any | null) : string {
    if (attrs == null) return '{"insert":' + JSON.stringify(text) + '}'
    return '{"insert":' + JSON.stringify(text) + ',"attributes":' + JSON.stringify(attrs) + '}'
}

function clampPos(v : number) : number {
    return v > 0 ? v : 0
}

/** 在 pre 的字符坐标 [start, start+removeLen) 上删掉一段，并在 start 处插入 marker 纯文本 op */
function spliceDelta(preDeltaJson : string, start : number, removeLen : number, marker : string) : string {
    let root : UTSJSONObject | null = null
    try {
        root = asObj(JSON.parse(preDeltaJson))
    } catch (_e) {
        root = null
    }
    if (root == null) return ''
    const ops = asObjectArray(root['ops'])
    const pieces : string[] = []
    const cut = start + removeLen
    let pos = 0
    let inserted = false
    for (let i = 0; i < ops.length; i++) {
        const op = ops[i]
        const insert = op['insert']
        if (insert == null) continue
        if (typeof insert != 'string') {
            // 图片 / 分割线是零宽度原子：原样留在原位，不参与字符区间
            pieces.push(JSON.stringify(op))
            continue
        }
        const text = insert as string
        const opStart = pos
        const opEnd = pos + text.length
        pos = opEnd
        const attrs = op['attributes']
        if (opEnd <= start) {
            pieces.push(opJson(text, attrs))
            continue
        }
        if (opStart >= cut) {
            if (!inserted) {
                pieces.push(opJson(marker, null))
                inserted = true
            }
            pieces.push(opJson(text, attrs))
            continue
        }
        const keepBefore = text.substring(0, clampPos(start - opStart))
        const keepAfter = text.substring(clampPos(cut - opStart))
        if (keepBefore.length > 0) pieces.push(opJson(keepBefore, attrs))
        if (!inserted) {
            pieces.push(opJson(marker, null))
            inserted = true
        }
        if (keepAfter.length > 0) pieces.push(opJson(keepAfter, attrs))
    }
    if (!inserted) pieces.push(opJson(marker, null))
    return '{"ops":[' + pieces.join(',') + ']}'
}

function occurrencesOf(text : string, needle : string) : number[] {
    const out : number[] = []
    if (needle.length == 0) return out
    let from = text.indexOf(needle)
    while (from >= 0) {
        out.push(from)
        from = text.indexOf(needle, from + 1)
    }
    return out
}

/**
 * 把「记号已写入、但选区没被替换」的文档收敛成唯一正确形态（#2659）。
 *
 * 第一性原理：编辑器只给了两件事实 —— 选区文本（无偏移）与写入后的整份 delta；
 * 它不给「删除选区」，也不给「设置选区」。所以「替换选区」这件事只能由调用方自己兑现：
 * 先让 insertText 写，再**用写入结果反推落点**（结构比对：post 去掉 marker 是否还原成 pre），
 * 最后用 setContents 把 pre 在 [落点, 落点+选区长度) 这一段的原文换成 marker。
 *
 * 安全底线（本节是判据，不是说明）：
 * - 形状只认两种：已正确（post == pre[:s] + marker + pre[s+len:]）⇒ 返回 null 什么都不做；
 *   实测缺陷形（post == pre[:s] + marker + pre[s:]）⇒ 返回修复后的 delta。
 * - 其余任何形状一律返回 null —— **宁可不修，不可误删**。平台哪天把 insertText 改对，本函数自动退化成 no-op。
 * - 落点 s 优先取「选区文本在原文中唯一出现」的位置；不唯一时退回结构比对（写在前缀是否恰好还原成 pre）。
 */
export function reconcileMarkerInsert(preDeltaJson : string, selected : string, marker : string, postDeltaJson : string) : string | null {
    if (selected.length == 0 || marker.length == 0) return null
    const preText = deltaPlainText(preDeltaJson)
    const postText = deltaPlainText(postDeltaJson)
    if (preText.length == 0) return null

    let start = -1
    const seen = occurrencesOf(preText, selected)
    if (seen.length == 1) {
        start = seen[0]
    } else {
        // 选区在原文里出现 0 次或多次：只能靠「写在哪里」反推 —— 去掉 marker 后必须还原成 pre
        const marks = occurrencesOf(postText, marker)
        for (let i = 0; i < marks.length; i++) {
            const p = marks[i]
            const restored = postText.substring(0, p) + postText.substring(p + marker.length)
            if (restored == preText && preText.length >= p + selected.length
                && preText.substring(p, p + selected.length) == selected) {
                start = p
                break
            }
        }
    }
    if (start < 0) return null
    if (preText.length < start + selected.length) return null
    if (preText.substring(start, start + selected.length) != selected) return null

    const replaced = preText.substring(0, start) + marker + preText.substring(start + selected.length)
    if (postText == replaced) return null
    const inserted = preText.substring(0, start) + marker + preText.substring(start)
    if (postText != inserted) return null
    return spliceDelta(preDeltaJson, start, selected.length, marker)
}
