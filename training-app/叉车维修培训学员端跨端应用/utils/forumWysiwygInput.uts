/**
 * WYSIWYG 输入区的**按钮集 / 回显判据 / 保真提示**（#2640，Parent #2631）
 *
 * 本模块是 T2 唯一的可测 seam：组件（`components/forum-wysiwyg-input.uvue`）只做接线，
 * 所有「哪些按钮存在」「点亮判据是什么」「降级怎么告诉作者」都落在这里，Node 侧经 utils/utsHarness.js 真执行。
 *
 * 第一性原理（为什么按钮集是数据、不是模板里的硬编码）：
 * - 格式边界由**三处共守**（ADR-0073）：自家按钮集 / 序列化器 / 发布前保真检查。按钮集是其中**唯一**
 *   面向作者的那一处 —— 它一旦多出一枚论坛档渲染不出的按钮，作者就会「点了白点」。
 *   把它做成可执行的数据，才能用一条断言钉住「按钮集 ⊆ 论坛档可表达格式」。
 * - 回显判据一律取 `getContents` 的 delta，不取 `@statuschange` 的 detail：statuschange 是**累积快照**
 *   （一次事件带全部生效格式），且「没收到事件」不等于「没生效」—— 事件是通知，不是事实源。
 * - 记号四件（引用 / 代码块 / 行内代码 / 链接）**不是格式**，是字面 Markdown 记号：它们走
 *   `insertText` 逃生舱（editor 的 link 属性会丢 URL、code 属性是 no-op），故 kind 记 `marker`，
 *   id 与 T1 的 `MARKER_KINDS` 同值，序列化时原样穿过。
 */

import { PASTE_LABEL } from './forumPaste'

/** 触摸目标下限（R2）。88rpx ≈ 44px @2x，与移动端 AGENTS.md 的 44×44 同源，本票按 88rpx 写死。 */
export const RICH_TOUCH_TARGET_RPX = 88

/** 常驻三键（下划线永久退出、行内代码不作常驻 —— 票面判据） */
export const RICH_ACTION_BOLD = 'bold'
export const RICH_ACTION_ITALIC = 'italic'
export const RICH_ACTION_STRIKE = 'strike'

/** 二级面板「格式」组：走 editor 的 format / insertDivider */
export const RICH_ACTION_HEADER = 'header'
export const RICH_ACTION_LIST = 'list'
export const RICH_ACTION_DIVIDER = 'divider'

/** 二级面板「记号」组：走 insertText 逃生舱，id 与 T1 的 MARKER_KINDS 同值 */
export const RICH_ACTION_QUOTE = 'quote'
export const RICH_ACTION_CODE_BLOCK = 'code-block'
export const RICH_ACTION_CODE_INLINE = 'code-inline'
export const RICH_ACTION_LINK = 'link'

/**
 * 面板「操作」组的粘贴项（#2967 决策⑤）：从模板硬编码移进数据层 ——
 * 「有哪些按钮」只有本模块一处，模板不再自己拼操作组。
 */
export const PASTE_ACTION_ID = 'paste'

/**
 * 常驻入口键（#2967 决策⑤）：回复浮层的常驻行收成**它一枚**，点它 = 开合面板，**不是**格式动作。
 * 它不参与 active 点亮（没有「格式面板已应用」这种状态）。
 */
export const RICH_ENTRY_ID = 'entry'
/** 入口键文案（模板不硬编码中文，入口文案同样单点在这里） */
export const RICH_ENTRY_LABEL : string = '格式'

/** 两种工具条形态（#2967）：回复浮层 = entry（单入口 + 4 组面板），发帖页 = full（常驻四键 + ⋯，行为不变） */
export const RICH_VARIANT_FULL = 'full'
export const RICH_VARIANT_ENTRY = 'entry'

/** 动作的落地方式：format（editor.format）/ divider（insertDivider）/ marker（getSelectionText + insertText）/ entry（开合面板）/ paste（读剪贴板 → insertText） */
export const RICH_KIND_FORMAT = 'format'
export const RICH_KIND_DIVIDER = 'divider'
export const RICH_KIND_MARKER = 'marker'
export const RICH_KIND_ENTRY = 'entry'
export const RICH_KIND_PASTE = 'paste'

/**
 * 常驻键字形的**真样式**（#2689 决策 2）：B 真加粗、I 真斜体、S 真删除线（细线模拟）、≡ 纯字形。
 * 字形是文字不是图片 —— 图片字形在弱网/深色下会糊，且无法随点亮态换色。
 */
export const RICH_GLYPH_STYLE_BOLD = 'bold'
export const RICH_GLYPH_STYLE_ITALIC = 'italic'
export const RICH_GLYPH_STYLE_STRIKE = 'strike'
export const RICH_GLYPH_STYLE_PLAIN = 'plain'

/** 正文图片被丢弃时的**持续可见**提示（R3：非一闪而过的 toast） */
export const RICH_IMAGE_NOTICE = '正文图片已忽略，请用下方＋添加'

/**
 * 工具态（面板展开期）内**选区不可用**时的提示（#2962 拍板规则 5）。
 * 提示必须持续可见、且与「这次操作被取消」绑定 —— 不能让作者以为格式已经生效。
 */
export const RICH_SELECTION_LOST_NOTICE = '选区未保留，已取消这次操作'

export type RichAction = {
    id : string,
    label : string,
    kind : string,
    /** kind == format 时交给 editor.format 的属性名；其余 kind 为空串 */
    formatName : string,
    /** kind == format 时交给 editor.format 的值；null = 切换语义（已应用则取消） */
    formatValue : string | null,
    /** 常驻键的字形（B / I / S / ≡）；面板项为空串（面板用 icon） */
    glyph : string,
    /** 常驻键字形的真样式，取 RICH_GLYPH_STYLE_*；面板项为 plain */
    glyphStyle : string,
    /** 面板项的图标字形（H / ≡ / — / ❝ / </> / ` / 🔗）；常驻键为空串 */
    icon : string,
}

export type RichPanelGroup = {
    id : string,
    label : string,
    actions : RichAction[],
}

function richAction(id : string, label : string, kind : string, formatName : string,
    glyph : string, glyphStyle : string, icon : string) : RichAction {
    return {
        id: id, label: label, kind: kind, formatName: formatName, formatValue: null,
        glyph: glyph, glyphStyle: glyphStyle, icon: icon,
    } as RichAction
}

function formatAction(id : string, label : string, glyph : string, glyphStyle : string, icon : string) : RichAction {
    return richAction(id, label, RICH_KIND_FORMAT, id, glyph, glyphStyle, icon)
}

function markerAction(id : string, label : string, icon : string) : RichAction {
    return richAction(id, label, RICH_KIND_MARKER, '', '', RICH_GLYPH_STYLE_PLAIN, icon)
}

/**
 * 字重三枚（粗体 / 斜体 / 删除线）—— 发帖页的常驻键与 entry 面板「字重」组**共用同一份定义**，
 * 避免 B/I/S 的字形、样式、文案在两处各写一遍而漂移。
 * 下划线永久退出（论坛档渲染不出，且序列化器会记 style-dropped:underline）；
 * 行内代码不作常驻（它是记号，落在面板的「记号」组）。
 * icon 只在面板渲染（B / I / S 纯字形）；常驻行渲染的是 glyph，不吃 icon。
 */
function weightActions() : RichAction[] {
    return [
        formatAction(RICH_ACTION_BOLD, '粗体', 'B', RICH_GLYPH_STYLE_BOLD, 'B'),
        formatAction(RICH_ACTION_ITALIC, '斜体', 'I', RICH_GLYPH_STYLE_ITALIC, 'I'),
        formatAction(RICH_ACTION_STRIKE, '删除线', 'S', RICH_GLYPH_STYLE_STRIKE, 'S'),
    ]
}

/** 入口键（#2967）：kind = entry ⇒ 点了开合面板，不是格式动作；不参与点亮。 */
function entryAction() : RichAction {
    return richAction(RICH_ENTRY_ID, RICH_ENTRY_LABEL, RICH_KIND_ENTRY, '', '', RICH_GLYPH_STYLE_PLAIN, '')
}

/** 粘贴项（#2967）：kind = paste ⇒ 输入区读剪贴板 → insertText（⑦ 的逃生舱），文案取 utils/forumPaste。 */
function pasteAction() : RichAction {
    return richAction(PASTE_ACTION_ID, PASTE_LABEL, RICH_KIND_PASTE, '', '', RICH_GLYPH_STYLE_PLAIN, '📋')
}

/**
 * 常驻行随形态而变（#2967 决策⑤）：
 *   · full（发帖页）= 粗体 / 斜体 / 删除线 / 列表 四枚数据动作 + 「更多」开关，行为与 #2689 一致；
 *   · entry（回复浮层）= **恰好一枚**入口键 —— 常驻行不再有五个触摸目标，面板头就是这枚入口。
 * 列表同时留在面板「结构」组：常驻是快捷入口、面板是全菜单，重复是刻意的（entry 下只出现在面板一次）。
 */
export function richPrimaryActions(variant : string = RICH_VARIANT_FULL) : RichAction[] {
    if (variant == RICH_VARIANT_ENTRY) {
        return [entryAction()]
    }
    const items = weightActions()
    items.push(formatAction(RICH_ACTION_LIST, '列表', '≡', RICH_GLYPH_STYLE_PLAIN, ''))
    return items
}

/**
 * 二级面板随形态而变（#2967 决策⑤）：
 *   · entry = 4 组 11 项：字重（B/I/S）· 结构（标题/列表/分割线）· 记号（引用/代码块/行内代码/链接）· 操作（粘贴）；
 *   · full = 3 组：结构 / 记号 / 操作 —— 不加「字重」组，因为发帖页的常驻四键已经承担了它（验收③「发帖页行为不变」）。
 * 容量余量 = 0（R1）：组内不留空位，也不为塞按钮缩小触摸目标。
 * 每项带中文名 + 图标字形（#2689 决策 2：面板项不能只有符号）。
 */
export function richPanelGroups(variant : string = RICH_VARIANT_FULL) : RichPanelGroup[] {
    const groups : RichPanelGroup[] = []
    if (variant == RICH_VARIANT_ENTRY) {
        const weight : RichPanelGroup = { id: 'weight', label: '字重', actions: weightActions() }
        groups.push(weight)
    }
    const structure : RichPanelGroup = {
        id: 'structure',
        label: '结构',
        actions: [
            formatAction(RICH_ACTION_HEADER, '标题', '', RICH_GLYPH_STYLE_PLAIN, 'H'),
            formatAction(RICH_ACTION_LIST, '列表', '', RICH_GLYPH_STYLE_PLAIN, '≡'),
            richAction(RICH_ACTION_DIVIDER, '分割线', RICH_KIND_DIVIDER, '', '', RICH_GLYPH_STYLE_PLAIN, '—'),
        ],
    }
    groups.push(structure)
    const marker : RichPanelGroup = {
        id: 'marker',
        label: '记号',
        actions: [
            markerAction(RICH_ACTION_QUOTE, '引用', '❝'),
            markerAction(RICH_ACTION_CODE_BLOCK, '代码块', '</>'),
            markerAction(RICH_ACTION_CODE_INLINE, '行内代码', '`'),
            markerAction(RICH_ACTION_LINK, '链接', '🔗'),
        ],
    }
    groups.push(marker)
    const action : RichPanelGroup = { id: 'action', label: '操作', actions: [pasteAction()] }
    groups.push(action)
    return groups
}

/**
 * 按 id 取动作（常驻 + 面板全表）。未知 id 返回 null —— 模板不自己拼动作对象。
 * 入口键**不**可解析（它走开合面板，不是动作）：即便按 entry 形态查也返回 null。
 * 两种形态都查：entry 下 B/I/S 落在「字重」组，full 下落在常驻行 —— 调用方（composable）不传形态也得取到。
 */
export function richActionById(id : string, variant : string = RICH_VARIANT_FULL) : RichAction | null {
    if (id == RICH_ENTRY_ID) return null
    const primary = richPrimaryActions(variant)
    for (let i = 0; i < primary.length; i++) {
        if (primary[i].id == id) return primary[i]
    }
    const groups = richPanelGroups(variant)
    for (let g = 0; g < groups.length; g++) {
        const actions = groups[g].actions
        for (let a = 0; a < actions.length; a++) {
            if (actions[a].id == id) return actions[a]
        }
    }
    const other = variant == RICH_VARIANT_ENTRY ? RICH_VARIANT_FULL : RICH_VARIANT_ENTRY
    const fallback = richPanelGroups(other)
    for (let g = 0; g < fallback.length; g++) {
        const actions = fallback[g].actions
        for (let a = 0; a < actions.length; a++) {
            if (actions[a].id == id) return actions[a]
        }
    }
    return null
}

function asObj(raw : any | null) : UTSJSONObject | null {
    if (raw == null) return null
    return raw as UTSJSONObject
}

function asObjectArray(raw : any | null) : Array<UTSJSONObject> {
    if (raw == null) return [] as Array<UTSJSONObject>
    return raw as Array<UTSJSONObject>
}

function isTrue(v : any | null) : boolean {
    return v != null && v != false
}

function asText(v : any | null) : string {
    if (v == null) return ''
    if (typeof v == 'string') return v as string
    return v.toString()
}

/**
 * 回显判据：从 delta 推导「此刻点亮哪些按钮」。
 *
 * 取**最后一个文本 op** 的行内属性 + **最后一个 op**（含换行 op）的块级属性：
 * Quill 的 delta 把行内格式挂在文字 op 上、把块级格式（header / list）挂在换行 op 上，
 * 只看最后一个 op 会丢掉行内格式，只看文字 op 会丢掉块级格式。
 *
 * 累积语义：一个 op 的 attributes 是**该处全部生效格式**的快照（bold + italic 同时为 true），
 * 故逐键读、不取「第一个命中的键」。
 */
export function richActiveFromDelta(deltaJson : string) : string[] {
    const out : string[] = []
    let root : UTSJSONObject | null = null
    try {
        root = asObj(JSON.parse(deltaJson))
    } catch (_e) {
        root = null
    }
    if (root == null) return out
    const ops = asObjectArray(root['ops'])
    let inlineAttrs : UTSJSONObject | null = null
    let blockAttrs : UTSJSONObject | null = null
    for (let i = 0; i < ops.length; i++) {
        const insert = ops[i]['insert']
        if (insert == null) continue
        if (typeof insert != 'string') continue
        const text = insert as string
        if (text.length == 0) continue
        const attrs = asObj(ops[i]['attributes'])
        if (text == '\n') {
            blockAttrs = attrs
            continue
        }
        inlineAttrs = attrs
        blockAttrs = attrs
    }
    if (inlineAttrs != null) {
        if (isTrue(inlineAttrs['bold'])) out.push(RICH_ACTION_BOLD)
        if (isTrue(inlineAttrs['italic'])) out.push(RICH_ACTION_ITALIC)
        if (isTrue(inlineAttrs['strike'])) out.push(RICH_ACTION_STRIKE)
        if (isTrue(inlineAttrs['code'])) out.push(RICH_ACTION_CODE_INLINE)
    }
    if (blockAttrs != null) {
        if (blockAttrs['header'] != null) out.push(RICH_ACTION_HEADER)
        if (asText(blockAttrs['list']).length > 0) out.push(RICH_ACTION_LIST)
        if (isTrue(blockAttrs['blockquote'])) out.push(RICH_ACTION_QUOTE)
    }
    return out
}

/** 论坛档表达不了的属性 → 作者看得懂的名字（与 T1 的 style-dropped:<attr> 取值一一对应） */
function styleLabel(attr : string) : string {
    if (attr == 'underline') return '下划线'
    if (attr == 'align') return '对齐'
    if (attr == 'size') return '字号'
    if (attr == 'color') return '颜色'
    if (attr == 'background') return '背景色'
    if (attr == 'script') return '上下标'
    if (attr == 'indent') return '缩进'
    return attr
}

/**
 * 保真检查提示：把 T1 的 issues 翻成**持续可见**的一行文案（空 issues ⇒ 空串，组件据此不渲染该行）。
 *
 * 为什么是「序列化时降级 + 提示」而不是「粘贴时清洗」：uni-app x 的 editor 没有 paste 钩子
 * （票面已认这条兜底路径）。降级发生在序列化，提示必须跟着同一次序列化出现，否则作者永远不知道
 * 自己写的下划线/字号没进正文。
 */
export function richFidelityNotice(issues : string[]) : string {
    const styles : string[] = []
    let hasImage = false
    for (let i = 0; i < issues.length; i++) {
        const issue = issues[i]
        if (issue == 'image-dropped') {
            hasImage = true
            continue
        }
        const prefix = 'style-dropped:'
        if (issue.indexOf(prefix) == 0) {
            const label = styleLabel(issue.substring(prefix.length))
            if (styles.indexOf(label) < 0) styles.push(label)
        }
    }
    const parts : string[] = []
    if (styles.length > 0) parts.push(styles.join('、') + '已降级为纯文本')
    if (hasImage) parts.push(RICH_IMAGE_NOTICE)
    return parts.join('；')
}

/**
 * 工具态内一次动作的**执行前闸门**（#2962 交付二，父规格 #2961 拍板规则 5）。
 *
 * 第一性原理：平台只有 `getSelectionText`（回文本、无偏移），没有 `setSelection` —— 不可能把选区
 * 「恢复」回去。于是选区的唯一保障是**它自始至终没丢**：工具态内保持只读、不开键盘。
 * 但「没丢」是假设不是事实，故每次执行前**现场核对**：
 *   · 打开工具时本就没有选区（快照为空）⇒ 不拦，动作按「无选区」语义走（如插入模板）；
 *   · 快照有选区而当前选区已变（空，或另一段文字）⇒ 取消、正文不动、提示作者。
 * 为什么不「尽量应用到当前选区」：那会把作者针对 A 段的格式悄悄落到 B 段，属于「选区丢失导致正文
 * 被错误修改」—— 票面判据明令禁止，宁可不做。
 */
export function shouldCancelToolAction(snapshotText : string, currentText : string) : boolean {
    if (snapshotText.length == 0) return false
    return currentText != snapshotText
}
