/**
 * 诊断引导的四步状态机（#2296）—— 纯函数，可被 `utils/utsHarness.js` **真执行**。
 *
 * 为什么是纯函数：票面判据是「四步状态机与拼句逻辑有**真执行**的行为测试（不是读源码字面量）」。
 * 源码文本契约只能证明「某个字面量还在」，证明不了「换品牌后旧现象真的失效」这类推进语义 ——
 * 后者只有把状态往前推一遍才看得见（判据见 `docs/agents/guards.md`）。
 *
 * 四步：0 品牌 → 1 系统/型号 → 2 现象/主题 → 3 确认。
 *
 * **两档第二层都取 `systems?brand=`**（#2310）：中力给 14 个系统（带 icon），
 * 林德给 87 个型号（无 icon、要能搜）。`picker` 只决定「要不要搜索框」与第三层标题，
 * **不决定端点** —— 与 Web 侧 `DiagnosisGuide.vue` 的一致。
 * `faults?brand=` 不带 `second` 是「品牌根层」（中力 6 条 / 林德 3 条），**不是型号列表**；
 * 选错层会拿到另一份词表（比对即误判，2026-11-05 生产实测）。
 *
 * 状态迁移一律**返回新对象、不改入参**：面板「关闭即丢弃」时只需要丢掉那个对象，
 * 不存在「某个字段忘了清」的残留（票面判据：点选到一半关闭再进入不残留上次预选）。
 */

import type { DiagnosisIntentBrand } from '../types/index'
import type { DiagnosisSelection } from './diagnosisCompose'
import { emptyDiagnosisSelection } from './diagnosisCompose'

/** 四步序号（不导出枚举：UTS 侧枚举是编译期风险，用数字常量最稳） */
export const GUIDE_STEP_BRAND : number = 0
export const GUIDE_STEP_SECOND : number = 1
export const GUIDE_STEP_FAULT : number = 2
export const GUIDE_STEP_CONFIRM : number = 3

/** 引导面板的完整状态（一个对象装完 ⇒ 关闭面板 = 丢掉它） */
export type DiagnosisGuideState = {
	/** 当前步（0..3） */
	step : number
	/** 已选品牌 id；空串 = 未选 */
	brandId : string
	/** 第二层选中项 id / 名字（系统档 = 系统，型号档 = 型号） */
	secondId : string
	secondName : string
	/** 已选现象 / 主题名 */
	selection : DiagnosisSelection
	/** 第二层列表的搜索词（型号档 87 个型号时用来过滤；系统档忽略） */
	secondFilter : string
	/** 等待兑现的预选现象（从欢迎区诉求卡带进来，等品牌与第二层选好后再落进 selection） */
	pendingFault : string
}

/** 初始状态：每次进面板都从它开始 */
export function initialGuideState() : DiagnosisGuideState {
	const s : DiagnosisGuideState = {
		step: GUIDE_STEP_BRAND,
		brandId: '',
		secondId: '',
		secondName: '',
		selection: emptyDiagnosisSelection(),
		secondFilter: '',
		pendingFault: '',
	}
	return s
}

/** 复制一份状态（内部工具：保持「不改入参」） */
function copyState(s : DiagnosisGuideState) : DiagnosisGuideState {
	const out : DiagnosisGuideState = {
		step: s.step,
		brandId: s.brandId,
		secondId: s.secondId,
		secondName: s.secondName,
		selection: {
			brandId: s.selection.brandId,
			secondId: s.selection.secondId,
			faultName: s.selection.faultName,
			extra: s.selection.extra,
		},
		secondFilter: s.secondFilter,
		pendingFault: s.pendingFault,
	}
	return out
}

/**
 * 第二层该走哪个取数：**恒为 `'systems'`**（#2310）。
 *
 * 曾经按 `pickerKindOf(brand)` 把型号档分到 `'faults-root'`，那是把
 * `faults?brand=`（不带 second）的品牌根层当成了型号列表：林德只回 3 条故障项，
 * 87 个型号实际在 `systems?brand=linde`。Web 侧不分档统一调 systems，行为是对的。
 * 保留这个纯函数（而不是在 composable 里直接写死字符串）是为了让「两档同端点」
 * 有**真执行**的行为用例守住，防止再按 picker 分支回去。
 *
 * 品牌未定时返回 `''`（还没有可取的列表）。
 */
export function secondSourceOf(brand : DiagnosisIntentBrand | null) : string {
	if (brand == null || brand.id.length == 0) return ''
	return 'systems'
}

/**
 * 第三层该带不带 `second`：第二层已选 ⇒ 带（现象词表）；未选 ⇒ 不带（根层）。
 */
export function faultQuerySecondOf(s : DiagnosisGuideState) : string {
	return s.secondId
}

/** 进入面板：带品牌预选时直接从第二层开始（品牌已定，无需再问一遍） */
export function openWithBrand(state : DiagnosisGuideState, brandId : string) : DiagnosisGuideState {
	const next = initialGuideState()
	next.brandId = brandId
	next.selection.brandId = brandId
	next.step = brandId.length > 0 ? GUIDE_STEP_SECOND : GUIDE_STEP_BRAND
	return next
}

/**
 * 进入面板：带现象预选（欢迎区诉求卡）时，现象先存进 `pendingFault`。
 *
 * 为什么不当场写进 `selection.faultName` 就完事：品牌一变，第二层与现象都必须失效
 * （否则会拿 A 品牌的现象去查 B 品牌的词表）—— 那条清空是**对的**，但会把这个预选一起抹掉。
 * 故它先寄存，由 `applySecond` 在清空之后兑现（web 侧 #2280 缺陷一同款）。
 */
export function openWithFault(state : DiagnosisGuideState, brandId : string, faultName : string) : DiagnosisGuideState {
	const next = initialGuideState()
	next.pendingFault = faultName
	next.brandId = brandId
	next.selection.brandId = brandId
	next.step = brandId.length > 0 ? GUIDE_STEP_SECOND : GUIDE_STEP_BRAND
	return next
}

/** 选品牌：清掉第二层与现象（换品牌后旧选择必须失效），落到第二步 */
export function selectBrand(state : DiagnosisGuideState, brandId : string) : DiagnosisGuideState {
	const next = copyState(state)
	next.brandId = brandId
	next.secondId = ''
	next.secondName = ''
	next.secondFilter = ''
	next.selection.brandId = brandId
	next.selection.secondId = ''
	next.selection.faultName = ''
	next.step = GUIDE_STEP_SECOND
	return next
}

/**
 * 选第二层（系统 / 型号）：清掉现象，落到第三步。
 *
 * `faultInList` = 该现象名**在第三层词表里**（调用方取数后告知）。预选若在其中，
 * 直接把它兑现成已选并跳到确认步 —— 那是诉求卡的完整路径（点卡 → 选品牌 → 选系统 → 确认），
 * 中间不该再要人点一次自己刚在欢迎区点过的现象。
 */
export function applySecond(state : DiagnosisGuideState, id : string, name : string, faultInList : boolean) : DiagnosisGuideState {
	const next = copyState(state)
	next.secondId = id
	next.secondName = name
	next.selection.secondId = id
	next.selection.faultName = ''
	next.step = GUIDE_STEP_FAULT
	if (state.pendingFault.length > 0 && faultInList) {
		next.selection.faultName = state.pendingFault
		next.pendingFault = ''
		next.step = GUIDE_STEP_CONFIRM
	}
	return next
}

/** 选现象（或自由描述写了现象）：预选到此为止被覆盖，落到确认步 */
export function selectFault(state : DiagnosisGuideState, faultName : string) : DiagnosisGuideState {
	const next = copyState(state)
	next.selection.faultName = faultName
	next.pendingFault = ''
	next.step = GUIDE_STEP_CONFIRM
	return next
}

/** 改补充说明（故障码 / 时机 / 部位）：不改步、不动其它字段 */
export function setExtra(state : DiagnosisGuideState, extra : string) : DiagnosisGuideState {
	const next = copyState(state)
	next.selection.extra = extra
	return next
}

/** 第二层搜索词（只影响渲染时的过滤，不改选择） */
export function setSecondFilter(state : DiagnosisGuideState, filter : string) : DiagnosisGuideState {
	const next = copyState(state)
	next.secondFilter = filter
	return next
}

/**
 * 能跳到第 i 步吗：未选品牌不能跳到第二步（`faults` 的 brand 必填），
 * 未选第二层不能跳到第三步（会取回根层列表，让人以为词表空了）。
 */
export function canJumpTo(state : DiagnosisGuideState, i : number) : boolean {
	if (i == state.step) return true
	if (i == GUIDE_STEP_BRAND) return true
	if (i == GUIDE_STEP_SECOND) return state.brandId.length > 0
	if (i == GUIDE_STEP_FAULT) return state.brandId.length > 0 && state.secondId.length > 0
	return state.selection.faultName.length > 0
}

/** 回退到第 i 步（越界/不允许则原样返回 —— 不抛，面板上点错不该炸） */
export function jumpTo(state : DiagnosisGuideState, i : number) : DiagnosisGuideState {
	if (i < 0 || i > GUIDE_STEP_CONFIRM) return copyState(state)
	if (!canJumpTo(state, i)) return copyState(state)
	const next = copyState(state)
	next.step = i
	return next
}

/**
 * 第二层列表的显示子集：`filter` 为空即全量；否则按名字**小写包含**过滤。
 * 判据用名字而不是 id：学员搜的是「E-322」这种他在车上看到的字。
 */
export function filterSecondItems(names : string[], filter : string) : string[] {
	const q = filter.trim().toLowerCase()
	if (q.length == 0) return names
	const out : string[] = []
	for (let i = 0; i < names.length; i++) {
		if (names[i].toLowerCase().indexOf(q) >= 0) out.push(names[i])
	}
	return out
}
