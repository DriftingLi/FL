/**
 * 笔记展示纯函数（标题 / 摘要 / 题目徽标 / 独立笔记判定 / 空态文案）
 *
 * 页面与 jest 镜像测试共用同一份口径；先例 utils/pointsDisplay.uts / utils/searchDisplay.uts
 * （模块内纯函数 + jest 镜像测试 + 文末「镜像同步」用例逐字对齐）。
 *
 * 三条口径来自 ADR-0055 决策 3（**不给笔记加 title 列**）：
 * - 正文首行即标题，首行之外折叠成单行摘要，两处都截断 ⇒ 卡片高度可预期；
 * - 题目笔记的徽标带题干摘要（后端 LEFT JOIN 带回 question_content），点它跳题；
 * - 独立笔记（question_id 为空）没有跳题目标，徽标退化为纯标签。
 *
 * 截断长度与 Web 侧 `frontend/src/pages/student/Notebook.vue` 的 noteTitle / noteExcerpt
 * 逐字对齐（40 / 80 / 18）——两端同一列表观感，改一处必须同改。
 */

/**
 * 正文首行即标题（截断 40）。
 * @param content 笔记正文（纯文本，允许空串）
 */
export function noteTitle(content : string) : string {
	const first = content.split('\n')[0].trim()
	if (first.length > 40) return first.substring(0, 40) + '…'
	return first
}

/**
 * 首行之后的摘要（多行折叠成一行、超长截断 80）；只有一行时返回空串。
 * @param content 笔记正文（纯文本，允许空串）
 */
export function noteExcerpt(content : string) : string {
	const lines = content.split('\n')
	if (lines.length <= 1) return ''
	const rest = lines.slice(1).join(' ').trim()
	if (rest.length > 80) return rest.substring(0, 80) + '…'
	return rest
}

/**
 * 题目徽标文案：带回题干摘要时显示摘要，缺摘要时退回通用文案。
 * @param questionContent 后端带回的题干摘要（可能为空）
 */
export function noteBadgeText(questionContent : string) : string {
	const t = questionContent.trim()
	if (t.length == 0) return '题目笔记'
	if (t.length > 18) return '题目：' + t.substring(0, 18) + '…'
	return '题目：' + t
}

/**
 * 独立笔记判定：question_id 为空（null）或非正数即与题目无关。
 * 后端用 NULL 表达「不挂题」，但契约漂移时零值也会出现 ⇒ 两者都按独立笔记处理。
 */
export function isStandaloneNote(questionId : number | null) : boolean {
	if (questionId == null) return true
	return questionId <= 0
}

/**
 * 空态文案按当前筛选项分档（scope 三态与后端 /api/notes 参数同名）。
 * @param scope 'all' | 'question' | 'standalone'
 */
export function noteEmptyText(scope : string) : string {
	if (scope == 'question') return '还没有题目笔记'
	if (scope == 'standalone') return '还没有独立笔记'
	return '还没有笔记'
}

/**
 * 「分类」视图的分组行（B3 #2519，原型 769:1625 笔记本分类态）。
 *
 * 原型分组标签是章节名（叉车基础知识），但后端知识点域已退役（错题本同因）、笔记又没有
 * 章节/标签维度 —— 可用的真实维度只剩「挂在哪道题」。故分组 = 题目笔记按 question_id 聚簇，
 * 标签文案复用 noteBadgeText（题干摘要）；独立笔记（question_id 为空）聚成一组放最后。
 *
 * 顺序 = 首次出现序（不做客户端重排：列表排序真源是后端 updated_at DESC，组序随数据走）。
 * 分页下的诚实代价：组与计数只在**已加载页**内统计，触底翻页后组会继续长大 —— 不假装全量。
 */

/** 分组输入的最小面（NoteItem 的两字段；.uts 不 import types，调用方传轻量切片） */
export type NoteGroupItem = {
	question_id : number | null
	question_content : string
}

export type NotebookGroup = {
	key : string          // v-for key：题目笔记 'q<id>'，独立笔记固定 'standalone'
	question_id : number  // 0 = 独立笔记组（不可跳题）
	label : string
	count : number
}

export function notebookGroups(items : NoteGroupItem[]) : NotebookGroup[] {
	const groups : NotebookGroup[] = []
	for (let i = 0; i < items.length; i++) {
		const item = items[i]
		if (isStandaloneNote(item.question_id)) {
			// 独立笔记聚成一组（首条建组，其余只累加计数）
			let standalone : NotebookGroup | null = null
			for (let j = 0; j < groups.length; j++) {
				if (groups[j].question_id == 0) { standalone = groups[j]; break }
			}
			if (standalone == null) {
				groups.push({ key: 'standalone', question_id: 0, label: '独立笔记', count: 1 } as NotebookGroup)
			} else {
				standalone.count = standalone.count + 1
			}
			continue
		}
		const qid = item.question_id != null ? item.question_id! : 0
		const label = noteBadgeText(item.question_content)
		let found : NotebookGroup | null = null
		for (let j = 0; j < groups.length; j++) {
			if (groups[j].question_id == qid) { found = groups[j]; break }
		}
		if (found == null) {
			groups.push({ key: 'q' + qid.toString(), question_id: qid, label: label, count: 1 } as NotebookGroup)
		} else {
			found.count = found.count + 1
		}
	}
	return groups
}
