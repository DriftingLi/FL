/**
 * 论坛正文的**格式轴**：把作者声明的 `content_format` 翻成「走哪一档渲染」（ADR-0025 P2）。
 *
 * 为什么单独成模块而不是写在 `.uvue` 里：这条**决策**落在模板里就只能靠读源码文本的接线守护去守，
 * 而 `docs/agents/guards.md` 明说接线守护**不构成 ③ 门证据**（算法被改坏而字面量还在时不会红）。
 * 抽到 `utils/` 后它可被 `utils/utsHarness.js` 的 `loadUts` **真执行**：`forumBodyBehavior.test.js`
 * 断言的是**跑起来的产出物**（块数组 / 空数组），不是字面量（先例：`markdownSubsetBehavior.test.js`）。
 *
 * 口径（与 `api/forumDto.normalizeContentFormat` **同向**，但**不重复归一**）：
 * - `markdown` ⇒ `parseMarkdown(content, SUBSET_FORUM)` —— 走 ADR-0025 的第三档；
 * - **其余一切取值**（含 `text` 与契约外脏值）⇒ 返回**空数组**，壳层直出原串（`text` 档不解析）。
 *
 * 空数组是**哨兵**而不是「正文为空」：渲染层的二选一闸门是 {@link isMarkdownFormat}，
 * 不看数组长度 —— 否则一个只有空行的 Markdown 帖会被渲染成「没有正文」。
 *
 * 归一单点在 DTO 层（`forumDto.normalizeContentFormat`，缺省与脏值都落 `text`）；
 * 本模块只消费归一后的值，脏值在这里同样落「不解析」一侧 —— 两处的方向一致，缺省即纯文本。
 *
 * @note 不依赖 DOM API，跨端通用（App / 小程序 / H5）
 */
import { parseMarkdown, SUBSET_FORUM } from './markdown'
import { splitInlineRuns, inlineRunsPlainText, inlineLinkDomain } from './markdownInline'
import type { MarkdownInlineRun } from './markdownInline'
import type { MarkdownBlock } from '../types/index'

/**
 * 正文格式：**纯文本**（缺省档）。归一后只会是它或 `markdown` 两者之一。
 *
 * 它在 P3 之前只是「归一后的另一个取值」，没有常量名；输入区形态落地后**作者侧**也需要这两个
 * 取值（数据档位控件 + `utils/forumFormatPreference.uts` 的记忆位），故在此立名 ——
 * 格式词汇表仍然只有这一处（别在页面里再写字面量 `'markdown'` / `'text'`）。
 */
export const FORMAT_TEXT = 'text'
/** 正文格式：作者声明的 Markdown —— 唯一会走解析的取值（归一后只会是它或 `text`） */
export const FORMAT_MARKDOWN = 'markdown'

/** 该帖 / 该回复是否走 Markdown 解析（渲染层的二选一闸门：文本档直出原串） */
export function isMarkdownFormat(format : string) : boolean {
    return format == FORMAT_MARKDOWN
}

/**
 * 正文的渲染块：Markdown 档按**论坛子集**解析，其余档返回空数组（壳层直出原串）。
 *
 * @param content 正文原文（后端 `content` 字段，未做任何预处理）
 * @param format  `content_format` 归一后的取值（`markdown` / `text`）
 */
export function forumContentBlocks(content : string, format : string) : MarkdownBlock[] {
    const empty : MarkdownBlock[] = []
    if (!isMarkdownFormat(format)) return empty
    return parseMarkdown(content, SUBSET_FORUM)
}

/**
 * 一段行内源串 → run 序列（渲染层拿样式的**唯一**入口，ADR-0025 ⑩-2）。
 *
 * 渲染层**不**直引 `utils/markdownInline`：与「档位决策收在格式轴」同一条接线口径
 * （页面/组件自查会看到 `forumContentBlocks` 与 `forumInlineRuns` 成对出现，
 * 而 `utils/markdown*` 只出现在本文件 —— `markdownContract` 的论坛面组钉这条）。
 */
export function forumInlineRuns(src : string) : MarkdownInlineRun[] {
    return splitInlineRuns(src)
}

/**
 * 链接的**目标域名**（⑩-8 确认弹窗用）：与 {@link forumInlineRuns} 同一条格式轴接线口径 ——
 * 渲染组件**不直引** `utils/markdownInline` 的运行期函数，一律经本模块转发（`markdownContract`
 * 的论坛面组钉这条）。输入是某个 run 已过协议闸的 `link`（只可能 http(s)）。
 */
export function forumLinkDomain(url : string) : string {
    return inlineLinkDomain(url)
}

/**
 * 正文的**纯文本投影**：格式轴的第二条消费路径（列表摘要 —— 只要文字、不要记号）。
 *
 * - `text` 档 ⇒ **原样返回**（零回归：存量帖的预览一个字节都不变）；
 * - `markdown` 档 ⇒ 取 {@link forumContentBlocks} 的块，**每块再经 {@link forumInlineRuns}
 *   取叶子**（⑩-5：摘要与渲染**共用同一次分词**）。这条不是「顺手复用」：分叉后块 `text`
 *   存的是行内源串，不剥就会把 `**故障码**` 直接送进列表；而「另写一份剥记号的正则」
 *   则是第二套规则 —— 两处分道正是 ADR 反复要防的漂移（根 ADR-0044 明把正则列为被否决做法）。
 *
 * 逐块的形状：`list` 走 `items`（每项各自分词）、divider 两者皆空 ⇒ 不贡献字符，其余走 `text`
 * —— 这一句**不是**抄渲染器的类型词汇表（#1273 立的那条「按块形状投影、不写 `type` 分支」仍成立）。
 * 唯一的例外是 `code`：它是**语义**豁免而不是形状分支 —— 围栏里的 `**` 是代码内容，
 * 剥它等于把代码读破（根 ADR-0044 拒绝正则剥离的理由正落在这格），所以代码块**不过分词器**，
 * 与改动前「代码块 text 原样进摘要」逐字一致。
 */
export function forumContentPlainText(content : string, format : string) : string {
    if (!isMarkdownFormat(format)) return content
    const blocks = forumContentBlocks(content, format)
    const pieces : string[] = []
    for (let i = 0; i < blocks.length; i++) {
        const block = blocks[i]
        let piece = ''
        if (block.type == 'code') {
            piece = block.text
        } else if (block.type == 'list') {
            piece = inlineRunsPlainText(forumInlineRuns(block.items.join(' ')))
        } else {
            piece = inlineRunsPlainText(forumInlineRuns(block.text))
        }
        if (piece.length > 0) pieces.push(piece)
    }
    return pieces.join(' ')
}
