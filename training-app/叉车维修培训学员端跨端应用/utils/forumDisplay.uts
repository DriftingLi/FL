/**
 * forum 域纯展示助手（T04 手术自 forum.uvue 逐字抽出，行为不变）
 * 组件经 computed/局部函数包装后在模板使用；模板直调 import 函数被守护规则 S 禁止。
 */

/** ISO 日期字符串 → YYYY-MM-DD */
export function formatDateStr(dateStr : string) : string {
    if (dateStr == null || dateStr.length < 10) return dateStr
    return dateStr.substring(0, 10)
}

/** 补全后端返回的相对文件 URL */
export function resolveFileUrl(url : string) : string {
    if (url.length == 0) return ''
    if (url.startsWith('http://') || url.startsWith('https://')) {
        return url
    }
    return url
}

/** 数字紧凑格式 */
export function formatCountCompact(n : number) : string {
    if (n < 100) return n.toString()
    if (n < 1000) return '99+'
    if (n < 10000) return '999+'
    return '9999+'
}

/** 获取内容预览（截取前 80 字，去掉换行） */
export function getContentPreview(content : string) : string {
    const single = content.replace('\n', ' ')
    if (single.length <= 80) return single
    return single.substring(0, 80) + '...'
}

/** 取前 3 张图片用于列表缩略图 */
export function getFirstImages(images : string[]) : string[] {
    const result : string[] = []
    const max = images.length > 3 ? 3 : images.length
    for (let i = 0; i < max; i++) {
        result.push(images[i])
    }
    return result
}

/** 取作者昵称首字作头像文字 */
export function getAuthorInitial(name : string) : string {
    if (name.length == 0) return '学'
    return name.substring(0, 1)
}

/** 基于 author_id 稳定生成头像背景色 */
export function getAvatarColor(authorId : number) : string {
    const colors : string[] = ['#2979ff', '#4caf50', '#ff9800', '#9c27b0', '#e91e63', '#009688', '#795548', '#607d8b']
    if (authorId <= 0) return colors[0]
    return colors[authorId % colors.length]
}
