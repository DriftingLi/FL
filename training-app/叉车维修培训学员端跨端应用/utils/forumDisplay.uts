/**
 * forum 域纯展示助手（T04 手术自 forum.uvue 逐字抽出，行为不变）
 * 组件经 computed/局部函数包装后在模板使用；模板直调 import 函数被守护规则 S 禁止。
 * 泛型格式化（formatDateStr / formatCountCompact / formatDateTimeStr）唯一实现在 utils/format，
 * 本文件不再持有第二实现（T03 口径；引用方直接 import utils/format）。
 */

/** 补全后端返回的相对文件 URL */
export function resolveFileUrl(url : string) : string {
    if (url.length == 0) return ''
    if (url.startsWith('http://') || url.startsWith('https://')) {
        return url
    }
    return url
}

/** 获取内容预览（截取前 80 字，去掉换行） */
export function getContentPreview(content : string) : string {
    const single = content.replace('\n', ' ')
    if (single.length <= 80) return single
    return single.substring(0, 80) + '...'
}

/** 取前 3 张图片用于列表缩略图 */
export function getFirstImages(images : string[]) : string[] {
    const result : string[] = []
    const max = images.length > 3 ? 3 : images.length
    for (let i = 0; i < max; i++) {
        result.push(images[i])
    }
    return result
}

/** 取作者昵称首字作头像文字 */
export function getAuthorInitial(name : string) : string {
    if (name.length == 0) return '学'
    return name.substring(0, 1)
}

/**
 * 属地展示文案（ADR-0045）：**市优先、市为空退到省**，两者都空返回空串。
 *
 * 为什么只显示一级：署名行是窄的（时间 · 属地 · 采纳徽章），两级叠加会互相挤压；
 * 数据仍按两级存（ip_province / ip_city），日后想改成「省 · 市」不必回填。
 * 空串是展示侧的**唯一**「没有属地」信号——调用方据此整段不渲染
 * （不显示「未知」、不留占位、不出现悬空的分隔符），存量帖因此看起来与今天完全一样。
 */
export function regionLabel(province : string, city : string) : string {
    if (city.length > 0) return city
    return province
}

/**
 * 发布前的属地披露文案（ADR-0045）。
 *
 * ⚠️ 这一行是 `docs/agents/ui-conventions.md`「不写说明性 hint 文本」的**明确例外**：
 * 属地是发布那一刻才产生的事实，事前告知比事后解释便宜——它是功能性提示，不是装饰。
 * 约定文件已登记该例外，按约定清理 hint 文案时**跳过它**。
 */
export const FORUM_REGION_NOTICE : string = '发布内容会显示 IP 属地'

/**
 * Markdown 档的**能力与边界提示**（ADR-0025 ⑥-5）。
 *
 * ⚠️ 这一行同样是「不写说明性 hint 文本」的**明确例外**（与上面那条并列登记在移动端 `AGENTS.md`
 * 的「前端 UI 约定」里）—— 依据是 ADR-0046 自己的判据「判据放在作者看得见的地方」，
 * 按约定清理 hint 时**跳过它**。
 *
 * 它**只讲边界、不讲能力清单**（ADR-0025 ⑥-5 的原话）：能力清单会随子集漂移、变成假话，
 * 而这里的每条边界都是**本档当前的事实** —— 表格与 mermaid 退回原文、行内标记被剥离、
 * 图片走独立入口。`forumMarkdownInputContract.test.js` 会核「这几条边界与成员声明表一致」，
 * 声明表一变这条文案就必须同批改。
 */
export const FORUM_MARKDOWN_BOUNDARY_NOTICE : string = '表格与图表显示原文；粗体、链接不出样式；图片用下方入口'

/** 基于 author_id 稳定生成头像背景色 */
export function getAvatarColor(authorId : number) : string {
    const colors : string[] = ['#2979ff', '#4caf50', '#ff9800', '#9c27b0', '#e91e63', '#009688', '#795548', '#607d8b']
    if (authorId <= 0) return colors[0]
    return colors[authorId % colors.length]
}
