/**
 * 生物认证封装 composable
 *
 * 统一封装 uni.checkIsSupportSoterAuthentication / uni.startSoterAuthentication，
 * 在 H5 端用 showModal 模拟，保证浏览器也能跑通 demo。
 *
 * @note startSoterAuthentication 的 requestAuthModes 支持：
 *       - 'fingerPrint'  (Android / iOS / 微信小程序)
 *       - 'facial'       (Android 指纹 / iOS 面容 / 微信小程序)
 *       - 'speech'       (暂不使用)
 */
import { ref, type Ref } from 'vue'

export type UseBiometricResult = {
    isSupported : Ref<boolean>
    checkSupport : () => Promise<void>
    authenticate : (content : string) => Promise<boolean>
}

export function useBiometric() {
    const isSupported = ref<boolean>(false)

    /** 检测设备是否支持生物认证（SOTER） */
    async function checkSupport() : Promise<void> {
        // #ifdef H5
        isSupported.value = true
        return
        // #endif

        // #ifdef APP || MP-WEIXIN
        // 原生端该 API 为回调式，await 返回值得到 kotlin.Unit（无法强转 UTSJSONObject），
        // 必须通过 success/fail 回调取结果
        uni.checkIsSupportSoterAuthentication({
            success: (res) => {
                console.log('[useBiometric] 设备支持的生物认证模式:', res.supportMode)
                console.log('[useBiometric] 含面容:', res.supportMode.indexOf('facial') >= 0)
                console.log('[useBiometric] 含指纹:', res.supportMode.indexOf('fingerPrint') >= 0)
                isSupported.value = res.supportMode.length > 0
            },
            fail: (err) => {
                console.warn('[useBiometric] checkSupport failed:', err)
                isSupported.value = false
            },
        })
        // #endif
    }

    /**
     * 触发生物认证
     * @param content 提示文案（H5 模拟弹窗用）
     * @returns 认证结果
     */
    async function authenticate(content : string) : Promise<boolean> {
        // #ifdef H5
        return new Promise<boolean>((resolve) => {
            uni.showModal({
                title: '生物认证（模拟）',
                content: content + '\n点击"确定"模拟认证成功',
                confirmText: '确定',
                cancelText: '取消',
                success: (res) => {
                    if (res.confirm) {
                        resolve(true)
                    } else {
                        resolve(false)
                    }
                },
                fail: () => {
                    resolve(false)
                },
            })
        })
        // #endif

        // #ifdef APP || MP-WEIXIN
        return new Promise<boolean>((resolve) => {
            uni.startSoterAuthentication({
                requestAuthModes: ['fingerPrint', 'facial'],
                challenge: '123456',
                authContent: content,
                success: (res) => {
                    const authMode = res.authMode
                    console.log('[useBiometric] 认证成功，使用模式:', authMode)
                    if (authMode == 'fingerPrint' || authMode == 'facial') {
                        resolve(true)
                    } else {
                        resolve(false)
                    }
                },
                fail: (err) => {
                    console.warn('[useBiometric] authenticate failed:', err)
                    resolve(false)
                },
            })
        })
        // #endif

        // #ifndef H5 || APP || MP-WEIXIN
        return false
        // #endif
    }

    return {
        isSupported: isSupported,
        checkSupport: () => checkSupport(),
        authenticate: (content : string) => authenticate(content),
    } as UseBiometricResult
}
