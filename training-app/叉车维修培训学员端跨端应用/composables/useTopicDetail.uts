/**
 * forum 详情核心态（T04 手术：forum-detail.uvue script 详情域下沉）
 * 持有 topic/replies 与其全部交叉变更（点赞/收藏/删除/回复点赞本地态）——数据所有权单一。
 * 函数字段箭头包裹返回（UTS error18 先例，同 useAiChat）。
 */
import { ref, computed } from 'vue'
import type { Ref, ComputedRef } from 'vue'
import { useAuthStore } from '../stores/auth'
import { goBack } from '../utils/navigation'
import {
    getForumTopicDetailApi,
    deleteForumTopicApi,
    deleteForumReplyApi,
    likeTopicApi,
    unlikeTopicApi,
    likeReplyApi,
    unlikeReplyApi,
    acceptReplyApi,
    cancelAcceptApi,
} from '../api/forum'
import { checkFavoriteApi, addFavoriteApi, removeFavoriteApi } from '../api/favorite'
import { getStorageJSON, setStorageJSON } from '../utils/storage'
import type { ForumTopicDetail, ForumReply } from '../types/index'

export type UseTopicDetailResult = {
    topicId : Ref<number>
    topic : Ref<ForumTopicDetail | null>
    replies : Ref<ForumReply[]>
    loading : Ref<boolean>
    replySortField : Ref<string>
    replySortOrder : Ref<string>
    /** 已加载的回复页码（ADR-0042 分页态；首页 = 1） */
    replyPage : Ref<number>
    /** 回复总条数（响应 total，含置顶条；「剩余 N 条」与它同源，不读 topic.replies_count） */
    replyTotal : Ref<number>
    /** 是否还有下一页（page < pages）——加载更多入口的唯一判据 */
    hasMoreReplies : ComputedRef<boolean>
    /** 加载更多进行中（防重复点击） */
    loadingMore : Ref<boolean>
    /** 尚未加载的回复条数（加载更多入口上的剩余量） */
    remainingReplies : ComputedRef<number>
    loadMoreReplies : () => Promise<void>
    canDelete : ComputedRef<boolean>
    canEdit : ComputedRef<boolean>
    currentUserId : ComputedRef<number>
    loadDetail : () => Promise<void>
    onReplySortFieldChange : (field : string) => void
    onReplySortOrderChange : (order : string) => void
    onToggleLike : () => Promise<void>
    onToggleFavorite : () => Promise<void>
    onDelete : () => void
    onEditTopic : () => void
    canDeleteReply : (reply : ForumReply) => boolean
    isReplyLiked : (reply : ForumReply) => boolean
    getReplyLikesCount : (reply : ForumReply) => number
    onToggleReplyLike : (reply : ForumReply) => Promise<void>
    onDeleteReply : (replyId : number) => void
    afterReplyPosted : (reply : ForumReply) => void
    isTopicOwner : ComputedRef<boolean>
    onAcceptReply : (replyId : number) => Promise<void>
    onCancelAccept : () => Promise<void>
}

export function useTopicDetail() : UseTopicDetailResult {
    const authStore = useAuthStore()

    const topicId = ref<number>(0)
    const topic = ref<ForumTopicDetail | null>(null)
    const replySortField = ref<string>('latest') // latest | hot
    const replySortOrder = ref<string>('asc')    // asc | desc
    const replies = ref<ForumReply[]>([])
    const loading = ref<boolean>(false)
    // ===== 回复分页态（ADR-0042）=====
    // 分页是回复列表的**唯一读取形态**（不存在「不传参数 = 全量」）；被采纳回复由**后端**
    // 保证占首页第一条，本层不做任何置顶派生——分页后前端只拿得到一页，派生必然失效。
    const REPLY_PAGE_SIZE = 20
    const replyPage = ref<number>(1)
    const replyPages = ref<number>(1)
    const replyTotal = ref<number>(0)
    const loadingMore = ref<boolean>(false)
    const topicFavoriteId = ref<number>(0)
    // 回复点赞本地态：key 为 reply.id 字符串，value 为 { liked: boolean, likes_count: number }，持久化到本地存储防止刷新丢失（后端暂未在 GetTopic 下发 replies[].liked/likes_count）
    const replyLikeState = ref<UTSJSONObject>({} as UTSJSONObject)

    function replyLikeStorageKey() : string {
        return 'forum_reply_like_' + topicId.value.toString()
    }

    function persistReplyLikeState() : void {
        try {
            if (topicId.value > 0) setStorageJSON(replyLikeStorageKey(), replyLikeState.value as object)
        } catch (e) { console.warn('[forum-detail] persistReplyLikeState failed:', e) }
    }

    function restoreReplyLikeState() : void {
        if (topicId.value <= 0) return
        try {
            const saved = getStorageJSON(replyLikeStorageKey())
            if (saved != null) {
                // 合并到当前态（保留内存中更新的优先）
                const merged : UTSJSONObject = {} as UTSJSONObject
                for (const k in saved) merged[k] = saved[k]
                for (const k in replyLikeState.value) merged[k] = replyLikeState.value[k]
                replyLikeState.value = merged
            }
        } catch (e) { console.warn('[forum-detail] restoreReplyLikeState failed:', e) }
    }

    function hydrateReplyLikesFromReplies() : void {
        restoreReplyLikeState()
        // 若后端已下发 liked/likes_count（未来实现），以后端为权威回填到本地态，避免刷新后样式因后端 0 被覆盖则仅在本地无记录时写入
        for (let i = 0; i < replies.value.length; i++) {
            const r = replies.value[i]
            const hasBackend = (r.liked == true) || (r.likes_count > 0)
            if (!hasBackend) continue
            const key = r.id.toString()
            const existing = replyLikeState.value[key] as UTSJSONObject | null
            if (existing == null) {
                const next : UTSJSONObject = {} as UTSJSONObject
                for (const k in replyLikeState.value) next[k] = replyLikeState.value[k]
                next[key] = { liked: r.liked, likes_count: r.likes_count } as UTSJSONObject
                replyLikeState.value = next
            }
        }
        // 首次回填后即持久化，保证刷新后数据不丢
        persistReplyLikeState()
    }

    /** 是否还有未加载的回复页：以响应 pages 为唯一判据（不读 topic.replies_count，
     *  那是列表页消费的反范式列，两者漂移会让「剩余 N 条」与翻页行为自相矛盾） */
    const hasMoreReplies = computed<boolean>(() : boolean => replyPage.value < replyPages.value)

    /** 尚未加载的回复条数（加载更多入口上的剩余量），与 total 同源 */
    const remainingReplies = computed<number>(() : number => {
        const left = replyTotal.value - replies.value.length
        return left > 0 ? left : 0
    })

    /** 当前用户 ID */
    const currentUserId = computed<number>(() : number => {
        const u = authStore.user.value
        if (u != null) return u.user_id
        return 0
    })

    /** 是否可删除帖子（后端 can_delete 或作者本人） */
    const canDelete = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        if (t.can_delete) return true
        return t.author_id == currentUserId.value && currentUserId.value > 0
    })

    /** 是否可编辑帖子（作者本人） */
    const canEdit = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.author_id == currentUserId.value && currentUserId.value > 0
    })

    /** 是否为帖子作者（楼主，采纳操作前提） */
    const isTopicOwner = computed<boolean>(() : boolean => {
        const t = topic.value
        if (t == null) return false
        return t.author_id == currentUserId.value && currentUserId.value > 0
    })

    /** 是否可删除回复（后端 can_delete 或作者本人） */
    function canDeleteReply(reply : ForumReply) : boolean {
        if (reply.can_delete) return true
        return reply.author_id == currentUserId.value && currentUserId.value > 0
    }

    // ===== 收藏（声明在 loadDetail 之前，避免 Kotlin 局部函数前向引用） =====
    async function loadTopicFavorite() : Promise<void> {
        const t = topic.value
        if (t == null || t.id <= 0) return
        try {
            const result = await checkFavoriteApi('topic', t.id)
            t.favorited = result.favorited
            topicFavoriteId.value = result.favorite_id
        } catch (e) {
            console.warn('[forum-detail] loadTopicFavorite failed:', e)
        }
    }

    async function onToggleFavorite() : Promise<void> {
        const t = topic.value
        if (t == null) return
        const wasFavorited = t.favorited
        // 乐观更新
        t.favorited = !wasFavorited
        try {
            if (wasFavorited) {
                await removeFavoriteApi(topicFavoriteId.value)
                topicFavoriteId.value = 0
            } else {
                const result = await addFavoriteApi('topic', t.id)
                topicFavoriteId.value = result.favorite_id
            }
        } catch (e) {
            // 回滚
            t.favorited = wasFavorited
            console.error('[forum-detail] toggleFavorite failed:', e)
            uni.showToast({ title: '操作失败', icon: 'none' })
        }
    }

    async function loadDetail() : Promise<void> {
        if (topicId.value == 0) return
        loading.value = true
        try {
            // 首次进入 / 切排序维度 / 重试：一律回到第 1 页并**替换**列表（分页语义，不是追加）
            const data = await getForumTopicDetailApi(topicId.value, replySortField.value, replySortOrder.value, 1, REPLY_PAGE_SIZE)
            topic.value = data
            replies.value = data.replies
            replyPage.value = data.page > 0 ? data.page : 1
            replyPages.value = data.pages > 0 ? data.pages : 1
            replyTotal.value = data.total
            console.log('[forum-detail] DIAG can_delete=', data.can_delete, 'author_id=', data.author_id, 'currentUserId=', currentUserId.value, 'user=', JSON.stringify(authStore.user.value), 'canDelete=', canDelete.value)
            // 回填回复点赞态（后端暂未下发时靠本地存储恢复，避免刷新后数据/样式丢失）
            hydrateReplyLikesFromReplies()
            // 刷新收藏状态（获取 favorite_id 供取消收藏使用）
            loadTopicFavorite()
        } catch (e) {
            console.error('[forum-detail] load failed:', e)
            uni.showToast({ title: '加载帖子失败', icon: 'none' })
        } finally {
            loading.value = false
        }
    }

    /**
     * 加载更多回复（ADR-0042）：**追加**下一页，不替换已渲染内容；到底后由 pages 判定入口消失。
     * 追加前按 id 去重——删回复 / 本地新回复会让本地窗口相对服务端页码漂移（第 N 页不再逐条对齐），
     * 不去重就会在页码边界渲染出重复行。
     */
    async function loadMoreReplies() : Promise<void> {
        if (loadingMore.value || !hasMoreReplies.value) return
        if (topicId.value == 0) return
        loadingMore.value = true
        try {
            const next = replyPage.value + 1
            const data = await getForumTopicDetailApi(topicId.value, replySortField.value, replySortOrder.value, next, REPLY_PAGE_SIZE)
            const merged : ForumReply[] = []
            for (let i = 0; i < replies.value.length; i++) {
                merged.push(replies.value[i])
            }
            for (let j = 0; j < data.replies.length; j++) {
                const incoming = data.replies[j]
                let seen = false
                for (let k = 0; k < merged.length; k++) {
                    if (merged[k].id == incoming.id) {
                        seen = true
                        break
                    }
                }
                if (!seen) merged.push(incoming)
            }
            replies.value = merged
            replyPage.value = data.page > 0 ? data.page : next
            replyPages.value = data.pages > 0 ? data.pages : replyPages.value
            if (data.total > 0) replyTotal.value = data.total
            // 回填新加载页的点赞态（后端未下发时靠本地存储恢复）
            hydrateReplyLikesFromReplies()
        } catch (e) {
            console.error('[forum-detail] load more replies failed:', e)
            uni.showToast({ title: '加载更多失败', icon: 'none' })
        } finally {
            loadingMore.value = false
        }
    }

    /** 执行删除帖子（声明在 onDelete 之前，避免 Kotlin 局部函数前向引用） */
    async function doDeleteTopic() : Promise<void> {
        uni.showLoading({ title: '删除中...' })
        try {
            await deleteForumTopicApi(topicId.value)
            uni.showToast({ title: '已删除', icon: 'success' })
            setTimeout(() => {
                goBack()
            }, 1000)
        } catch (e) {
            console.error('[forum-detail] delete topic failed:', e)
            uni.showToast({ title: '删除失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 删除帖子 */
    function onDelete() : void {
        uni.showModal({
            title: '提示',
            content: '确定删除这篇帖子吗？删除后不可恢复。',
            success: (res) => {
                if (res.confirm) {
                    doDeleteTopic()
                }
            }
        })
    }

    /** 执行删除回复（声明在 onDeleteReply 之前，避免 Kotlin 局部函数前向引用） */
    async function doDeleteReply(replyId : number) : Promise<void> {
        uni.showLoading({ title: '删除中...' })
        try {
            await deleteForumReplyApi(replyId)
            // 从列表中移除
            const newReplies : ForumReply[] = []
            for (let i = 0; i < replies.value.length; i++) {
                if (replies.value[i].id != replyId) {
                    newReplies.push(replies.value[i])
                }
            }
            replies.value = newReplies
            // 更新回复数（total 同步：分页后「剩余 N 条」读的是响应 total，
            // 本地位移一条却不减 total 会让剩余量与可加载内容自相矛盾）
            replyTotal.value = Math.max(0, replyTotal.value - 1)
            const t = topic.value
            if (t != null) {
                t.replies_count = Math.max(0, t.replies_count - 1)
            }
            uni.showToast({ title: '已删除', icon: 'success' })
        } catch (e) {
            console.error('[forum-detail] delete reply failed:', e)
            uni.showToast({ title: '删除失败', icon: 'none' })
        } finally {
            uni.hideLoading()
        }
    }

    /** 删除回复 */
    function onDeleteReply(replyId : number) : void {
        uni.showModal({
            title: '提示',
            content: '确定删除这条回复吗？',
            success: (res) => {
                if (res.confirm) {
                    doDeleteReply(replyId)
                }
            }
        })
    }

    // ===== 回复点赞本地态 helpers（后端 GET /forum/topics/{id} 暂未返回 replies[].liked/likes_count，靠本地态 + POST/DELETE /forum/replies/{id}/like 同步） =====
    function getReplyLikeRecord(replyId : number) : UTSJSONObject | null {
        const key = replyId.toString()
        const v = replyLikeState.value[key]
        if (v == null) return null
        return v as UTSJSONObject
    }

    function isReplyLiked(reply : ForumReply) : boolean {
        const rec = getReplyLikeRecord(reply.id)
        if (rec != null) return rec['liked'] == true
        // 兼容后端未来在 reply 上直接返回 liked / liked_by_me（字段在类型上为可选，直接读，无需 cast）
        if (reply.liked == true) return true
        if (reply.liked_by_me == true) return true
        return false
    }

    function getReplyLikesCount(reply : ForumReply) : number {
        const rec = getReplyLikeRecord(reply.id)
        if (rec != null) {
            const n = rec['likes_count'] as number
            if (n != null) return n as number
        }
        if (reply.likes_count >= 0) return reply.likes_count
        const lc = reply.like_count
        if (lc != null && (lc as number) >= 0) return lc as number
        return 0
    }

    function setReplyLikeState(replyId : number, liked : boolean, likesCount : number) : void {
        const key = replyId.toString()
        const next : UTSJSONObject = {} as UTSJSONObject
        for (const k in replyLikeState.value) {
            next[k] = replyLikeState.value[k]
        }
        next[key] = { liked: liked, likes_count: likesCount } as UTSJSONObject
        replyLikeState.value = next
        persistReplyLikeState()
    }

    async function onToggleReplyLike(reply : ForumReply) : Promise<void> {
        const wasLiked = isReplyLiked(reply)
        const oldCount = getReplyLikesCount(reply)
        const nextLiked = !wasLiked
        const nextCount = wasLiked ? Math.max(0, oldCount - 1) : oldCount + 1
        setReplyLikeState(reply.id, nextLiked, nextCount)
        try {
            if (wasLiked) {
                const result = await unlikeReplyApi(reply.id)
                setReplyLikeState(reply.id, result.liked, result.likes_count)
            } else {
                const result = await likeReplyApi(reply.id)
                setReplyLikeState(reply.id, result.liked, result.likes_count)
            }
        } catch (e) {
            setReplyLikeState(reply.id, wasLiked, oldCount)
            console.error('[forum-detail] toggle reply like failed:', e)
            let msg = '操作失败'
            if (e instanceof Error) {
                const m = (e as Error).message
                if (m != null && m.length > 0) msg = m
            }
            // 后端若尚未实现该接口会 404，提示更友好
            if (msg.indexOf('404') >= 0 || msg.indexOf('不存在') >= 0) {
                msg = '点赞回复功能后端暂未实现'
            }
            uni.showToast({ title: msg, icon: 'none' })
        }
    }

    // ===== 点赞 =====
    async function onToggleLike() : Promise<void> {
        const t = topic.value
        if (t == null) return
        const wasLiked = t.liked
        const oldCount = t.likes_count
        t.liked = !wasLiked
        t.likes_count = wasLiked ? oldCount - 1 : oldCount + 1
        if (t.likes_count < 0) t.likes_count = 0
        try {
            if (wasLiked) {
                const result = await unlikeTopicApi(t.id)
                t.liked = result.liked
                t.likes_count = result.likes_count
            } else {
                const result = await likeTopicApi(t.id)
                t.liked = result.liked
                t.likes_count = result.likes_count
            }
        } catch (e) {
            t.liked = wasLiked
            t.likes_count = oldCount
            console.error('[forum-detail] toggle like failed:', e)
        }
    }

    /** 回复提交成功后的列表侧变更（composer 经回调注入，避免反向下钻）
     *  分页后（ADR-0042）本地新回复不在服务端任何一页的窗口里，故本地追加并同步 total；
     *  loadMoreReplies 的 id 去重保证翻页时不会把同一条再渲染一次。 */
    function afterReplyPosted(reply : ForumReply) : void {
        replies.value.push(reply)
        replyTotal.value = replyTotal.value + 1
        const t = topic.value
        if (t != null) {
            t.replies_count = t.replies_count + 1
        }
    }

    // ===== 编辑帖子 =====
    function onEditTopic() : void {
        const t = topic.value
        if (t == null) return
        uni.navigateTo({ url: '/pages/forum/forum-create?id=' + t.id })
    }

    // ===== 采纳（#747）=====
    async function onAcceptReply(replyId : number) : Promise<void> {
        const t = topic.value
        if (t == null) return
        // 乐观更新：立即标记该回复为已采纳
        const oldReplies = replies.value.slice()
        for (let i = 0; i < replies.value.length; i++) {
            if (replies.value[i].id == replyId) {
                replies.value[i].is_accepted = true
            } else {
                replies.value[i].is_accepted = false
            }
        }
        t.status = 'resolved'
        try {
            const result = await acceptReplyApi(t.id, replyId)
            // 以服务端返回为准回填
            t.accepted_reply_id = result.accepted_reply_id
            t.status = result.status
            // 置顶是**后端事实**（ADR-0042）：本地翻 is_accepted 改不了位置，会让「已采纳」
            // 停在原位、与「恒占首页第一条」自相矛盾 ⇒ 重载第 1 页取回服务端顺序（对齐 Web）
            await loadDetail()
        } catch (e) {
            // 回滚
            replies.value = oldReplies
            t.status = (t.accepted_reply_id != null && t.accepted_reply_id! > 0) ? 'resolved' : 'open'
            console.error('[forum-detail] accept reply failed:', e)
            let msg = '操作失败'
            if (e instanceof Error) {
                const m = (e as Error).message
                if (m != null && m.length > 0) msg = m
            }
            uni.showToast({ title: msg, icon: 'none' })
        }
    }

    async function onCancelAccept() : Promise<void> {
        const t = topic.value
        if (t == null) return
        // 乐观更新
        const oldReplies = replies.value.slice()
        const oldStatus = t.status
        for (let i = 0; i < replies.value.length; i++) {
            replies.value[i].is_accepted = false
        }
        t.status = 'open'
        try {
            const result = await cancelAcceptApi(t.id)
            t.accepted_reply_id = result.accepted_reply_id
            t.status = result.status
            // 同 onAcceptReply：取消采纳后该条回到自然排序位置，只能由后端重排 ⇒ 重载第 1 页
            await loadDetail()
        } catch (e) {
            // 回滚
            replies.value = oldReplies
            t.status = oldStatus
            console.error('[forum-detail] cancel accept failed:', e)
            uni.showToast({ title: '操作失败', icon: 'none' })
        }
    }

    // ===== 回复排序 =====
    // 切维度一律经 loadDetail()：它把页码重置回第 1 页并替换列表（沿用列表页既有惯例，ADR-0042）
    function onReplySortFieldChange(field : string) : void {
        if (replySortField.value === field) return
        replySortField.value = field
        loadDetail()
    }

    function onReplySortOrderChange(order : string) : void {
        if (replySortOrder.value === order) return
        replySortOrder.value = order
        loadDetail()
    }

    return {
        topicId: topicId,
        topic: topic,
        replies: replies,
        loading: loading,
        replySortField: replySortField,
        replySortOrder: replySortOrder,
        replyPage: replyPage,
        replyTotal: replyTotal,
        hasMoreReplies: hasMoreReplies,
        loadingMore: loadingMore,
        remainingReplies: remainingReplies,
        loadMoreReplies: () => loadMoreReplies(),
        canDelete: canDelete,
        canEdit: canEdit,
        currentUserId: currentUserId,
        loadDetail: () => loadDetail(),
        onReplySortFieldChange: (field : string) => onReplySortFieldChange(field),
        onReplySortOrderChange: (order : string) => onReplySortOrderChange(order),
        onToggleLike: () => onToggleLike(),
        onToggleFavorite: () => onToggleFavorite(),
        onDelete: () => onDelete(),
        onEditTopic: () => onEditTopic(),
        canDeleteReply: (reply : ForumReply) => canDeleteReply(reply),
        isReplyLiked: (reply : ForumReply) => isReplyLiked(reply),
        getReplyLikesCount: (reply : ForumReply) => getReplyLikesCount(reply),
        onToggleReplyLike: (reply : ForumReply) => onToggleReplyLike(reply),
        onDeleteReply: (replyId : number) => onDeleteReply(replyId),
        afterReplyPosted: (reply : ForumReply) => afterReplyPosted(reply),
        isTopicOwner: isTopicOwner,
        onAcceptReply: (replyId : number) => onAcceptReply(replyId),
        onCancelAccept: () => onCancelAccept(),
    } as UseTopicDetailResult
}
