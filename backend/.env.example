# ===== 后端环境变量示例（复制为 .env 后按需修改）=====
# 注意：.env 已被 gitignore，禁止提交真实密钥；R2 / AI Key 请勿填真实值

# 运行环境：development / production
APP_ENV=development

# 服务端口
PORT=8080

# 应用密钥与统一 JWT 密钥（生产环境必须改为随机强密钥）
SECRET_KEY=dev-secret-key
JWT_SECRET_KEY=jwt-secret-key
JWT_EXPIRES_HOURS=24

# PostgreSQL（与 backend/docker-compose.yml 本地容器一致）
DATABASE_URL=postgres://forklift:forklift123@localhost:5432/forklift_training?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_KEY_PREFIX=fl:

# CORS 允许的来源（逗号分隔；生产环境不得包含 localhost）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://training.localhost:5173,http://valuation.localhost:5173,http://mentor.localhost:5173,http://manage.localhost:5173

# 上传目录与数据卷挂载路径（生产环境通常由 compose 注入）
UPLOAD_FOLDER=static/uploads
VOLUME_MOUNT_PATH=
MAX_CONTENT_LENGTH_MB=250

# 默认账号密码（生产环境必须修改）
ADMIN_DEFAULT_PASSWORD=admin123
TUTOR_DEFAULT_PASSWORD=tutor123
STUDENT_DEFAULT_PASSWORD=student123

# 按 IP 限流（production 默认开启；development 默认关闭）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# AI 供应商（OpenAI 兼容格式，支持链式回退：
# AI_API_KEY > DEEPSEEK_API_KEY > ZHIPU_API_KEY > OPENAI_API_KEY）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# LibreOffice sidecar（本地 docker compose 已包含；为空则降级本地 exec）
LIBREOFFICE_SIDECAR_URL=http://localhost:8000

# 文件存储：local 本地磁盘 / r2 Cloudflare R2 对象存储
STORAGE_DRIVER=local
# 启用 r2 时必填以下五项：
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# 残值评估 PDF 输出目录与日志
VALUATION_PDF_OUTPUT_DIR=storage/reports
VALUATION_LOG_LEVEL=info
VALUATION_LOG_FORMAT=console
VALUATION_LOG_OUTPUT=stdout

# 残值评估子模块 pgx 连接池
VALUATION_DB_MAX_OPEN_CONNS=20
VALUATION_DB_MAX_IDLE_CONNS=5
VALUATION_DB_CONN_MAX_LIFETIME=3600
