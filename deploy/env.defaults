# 生成文件，勿手改（ADR-0047 §5 / spec #932）。
# 唯一事实源：backend/internal/deploy/topology.go。
# 再生成：cd backend && go run ./cmd/gen-deploy
# 同步契约：backend/internal/deploy/topology_test.go 与本文件全等比对，
# 并由漂移锁断言 cd.yml / deploy-remote.sh / docker-compose.prod.yml 的默认值一致。
# 登录态 Cookie 名（学员侧；招聘侧另见 config）
export AUTH_COOKIE_NAME='hrwai_token'
# Cookie 是否仅 HTTPS
export AUTH_COOKIE_SECURE='true'
# 后端对外发布端口
export BACKEND_HOST_PORT='8080'
# 后端镜像
export BACKEND_IMAGE='forklift-backend:latest'
# Postgres 用户
export DB_USER='forklift'
# 外部诊断 RAG 服务地址（ADR-0032）
export DIAGNOSIS_ASSISTANT_URL='http://172.17.1.23:8000'
# 主域名
export DOMAIN='localhost'
# 前端镜像
export FRONTEND_IMAGE='forklift-frontend:latest'
# access token 有效期（小时，ADR-0016）
export JWT_EXPIRES_HOURS='2'
# refresh token 有效期（天，ADR-0016）
export JWT_REFRESH_EXPIRES_DAYS='7'
# PPT 转图 sidecar 镜像
export LIBREOFFICE_IMAGE='forklift-libreoffice:latest'
# 日志卷
export LOGS_VOLUME='logs-data'
# 日志轮转压缩
export LOG_COMPRESS='true'
# 日志目录
export LOG_DIR='/data/logs'
# 日志格式（console | json）
export LOG_FORMAT='console'
# 日志级别
export LOG_LEVEL='info'
# 日志保留天数
export LOG_MAX_AGE_DAYS='30'
# 日志备份份数
export LOG_MAX_BACKUPS='7'
# 单日志文件上限（MB）
export LOG_MAX_SIZE_MB='100'
# Postgres 数据卷
export PG_VOLUME='pgdata-prod'
# 门户对外发布端口
export PORTAL_HOST_PORT='3000'
# Redis 逻辑库
export REDIS_DB='0'
# Redis 键前缀
export REDIS_KEY_PREFIX='fl:'
# Redis 连接池大小
export REDIS_POOL_SIZE='20'
# Redis 数据卷
export REDIS_VOLUME='redisdata-prod'
# 报告卷
export REPORTS_VOLUME='reports-data'
# 发件人显示名
export SMTP_FROM_NAME='和润天下'
# SMTP 端口
export SMTP_PORT='465'
# 证书目录
export SSL_CERT_DIR='./nginx/ssl'
# 存储驱动（local | r2）
export STORAGE_DRIVER='local'
# 是否开启 Swagger
export SWAGGER_ENABLED='false'
# 腾讯云短信区域
export TENCENT_SMS_REGION='ap-guangzhou'
# 受信反代网段（可信取 IP，ADR-0045）
export TRUSTED_PROXIES='127.0.0.1/32,172.19.0.1/32,192.168.240.1/32'
# 上传目录卷
export UPLOADS_VOLUME='uploads-data'
